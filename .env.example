# Copie para .env e preencha NO SEU EDITOR. O .env nunca vai para o git e o Claude não precisa ver os valores.
SITE_URL=https://melolabs.net
# DEV: https://dev.to/settings/extensions -> "DEV Community API Keys"
DEVTO_API_KEY=
# Hashnode: https://hashnode.com/settings/developer -> Personal Access Token
HASHNODE_TOKEN=
# Hashnode: ID da publicação (Dashboard -> Settings -> General)
HASHNODE_PUBLICATION_ID=
