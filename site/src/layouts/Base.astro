---
import { T, type Lang } from '../i18n';
interface Props { title: string; lang: Lang; description?: string; altHref?: string; canonical?: string }
const { title, lang, description, altHref, canonical } = Astro.props;
const t = T[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const pageTitle = title === 'Melo Labs' ? title : `${title} · Melo Labs`;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.tagline} />
    <link rel="canonical" href={url} />
    {altHref && <link rel="alternate" hreflang={other} href={new URL(altHref, Astro.site).href} />}
    <link rel="alternate" type="application/rss+xml" title="Melo Labs" href={`/${lang}/rss.xml`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Public+Sans:wght@400;600;800&display=swap" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={`/${lang}/`}>Melo Labs</a>
      <nav aria-label="Principal">
        <a href={`/${lang}/`}>{t.posts}</a>
        <a href={`/${lang}/about/`}>{t.about}</a>
        <a class="lang" href={altHref ?? `/${other}/`} hreflang={other} lang={other}>{t.other}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>{t.aiNote}</p>
      <p><a href={`/${lang}/rss.xml`}>RSS</a></p>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --bg:#f2f5f6; --panel:#ffffff; --ink:#13232b; --muted:#566872; --line:#d3dde1; --accent:#0d7a6b; --accent-soft:#d9efeb;
    --font-body:"Public Sans",system-ui,"Segoe UI",sans-serif; --font-mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --bg:#0f1a1f; --panel:#16252c; --ink:#e4edf0; --muted:#93a8b1; --line:#2a3d46; --accent:#4cc9b4; --accent-soft:#17403a; color-scheme: dark; }
  }
  :root[data-theme="dark"] { --bg:#0f1a1f; --panel:#16252c; --ink:#e4edf0; --muted:#93a8b1; --line:#2a3d46; --accent:#4cc9b4; --accent-soft:#17403a; color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:17px/1.65 var(--font-body);
    padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px)); }
  .top, main, footer { max-width: 760px; margin: 0 auto; }
  .top { display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap; padding-block:22px 10px; border-bottom:1px solid var(--line); }
  .brand { font:800 20px var(--font-body); color:var(--ink); text-decoration:none; }
  .top nav { display:flex; gap:18px; flex-wrap:wrap; font-size:15px; }
  .top nav a { color:var(--muted); text-decoration:none; }
  .top nav a:hover, .top nav a.lang { color:var(--accent); }
  main { padding-block: 32px 56px; }
  h1 { font-size:clamp(28px,6vw,38px); line-height:1.15; text-wrap:balance; margin:0 0 12px; }
  h2 { font-size:24px; margin:40px 0 8px; text-wrap:balance; }
  h3 { font-size:19px; margin:28px 0 6px; }
  p, li { max-width:68ch; }
  a { color:var(--accent); }
  :focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
  .lead { font-size:19px; color:var(--muted); }
  .post-list { list-style:none; padding:0; margin:24px 0; display:grid; gap:12px; }
  .post-list li { background:var(--panel); border:1px solid var(--line); border-radius:6px; padding:14px 18px; }
  .post-list a { font-weight:600; text-decoration:none; }
  .meta { font:12px var(--font-mono); color:var(--muted); letter-spacing:.04em; }
  .tag { font:600 11px var(--font-mono); text-transform:uppercase; letter-spacing:.05em; background:var(--accent-soft); color:var(--accent); padding:3px 7px; border-radius:3px; margin-right:6px; }
  article table { border-collapse:collapse; width:100%; display:block; overflow-x:auto; font-size:15px; }
  article th, article td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  article pre { overflow-x:auto; background:var(--panel); border:1px solid var(--line); padding:14px; border-radius:6px; font:14px var(--font-mono); }
  article code { font-family:var(--font-mono); font-size:.9em; }
  article img { max-width:100%; height:auto; }
  footer { border-top:1px solid var(--line); padding-block:20px 40px; color:var(--muted); font-size:14px; }
  @media (prefers-reduced-motion: reduce) { * { transition:none !important; animation:none !important; } }
</style>
