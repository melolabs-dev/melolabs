new file mode 100644
index 0000000..78f3c87
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,207 @@
+import { beforeEach, vi } from "vitest";
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  (globalThis.console.error as any) = vi.fn();
+
+  beforeEach(() => {
+    t.app.config.debug = false;
+  });
+
+  const json = async (res: Response) => JSON.parse(await res.text());
+  const problemType = /^application\/problem\+json/;
+
+  describe("RF-01: option off", () => {
+    for (const value of [undefined, false]) {
+      it(`keeps the legacy format with problemDetails=${value}`, async () => {
+        t.app.config.problemDetails = value;
+        t.app.get("/x", () => {
+          throw new HTTPError({ status: 400, statusText: "Ruim", message: "ruim" });
+        });
+        const res = await t.fetch("/x");
+        expect(res.headers.get("content-type")).toMatch(/^application\/json/);
+        const body = await json(res);
+        expect(body).toMatchObject({ status: 400, message: "ruim" });
+        expect(body).toHaveProperty("statusText");
+        for (const key of ["type", "title", "detail", "instance"]) {
+          expect(body).not.toHaveProperty(key);
+        }
+      });
+    }
+  });
+
+  describe("RF-02: content-type and headers", () => {
+    it("HTTPError.status(404)", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", (event) => {
+        event.res.errHeaders.set("x-err", "prepared");
+        throw HTTPError.status(404);
+      });
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(problemType);
+      expect(res.headers.get("x-err")).toBe("prepared");
+    });
+
+    it("merges error.headers", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400, headers: { "x-custom": "1" } });
+      });
+      const res = await t.fetch("/x");
+      expect(res.headers.get("x-custom")).toBe("1");
+      expect(res.headers.get("content-type")).toMatch(problemType);
+    });
+
+    it("kNotFound route", async () => {
+      t.app.config.problemDetails = true;
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(problemType);
+    });
+
+    it("HEAD has no body", async () => {
+      t.app.config.problemDetails = true;
+      const res = await t.fetch("/missing", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(await res.text()).toBe("");
+    });
+  });
+
+  describe("RF-03: standard members", () => {
+    it("full 422 case", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", () => {
+        throw new HTTPError({
+          status: 422,
+          statusText: "Entidade inválida",
+          message: "campo 'email' ausente",
+          type: "https://exemplo.com/erros/validacao",
+          instance: "/pedidos/42",
+        });
+      });
+      const body = await json(await t.fetch("/x"));
+      expect(body).toEqual({
+        type: "https://exemplo.com/erros/validacao",
+        title: "Entidade inválida",
+        status: 422,
+        detail: "campo 'email' ausente",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("default title and type", async () => {
+      t.app.config.problemDetails = true;
+      const body = await json(await t.fetch("/missing"));
+      expect(body.type).toBe("about:blank");
+      expect(body.title).toBe("Not Found");
+      expect(body.status).toBe(404);
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("omits title for unknown status", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 599, message: "m" });
+      });
+      const body = await json(await t.fetch("/x"));
+      expect(body).not.toHaveProperty("title");
+      expect(body.detail).toBe("m");
+    });
+  });
+
+  describe("RF-05: extensions", () => {
+    it("keeps data/body but not standard member overrides", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "m",
+          data: { campo: "email" },
+          body: { codigo: "E42", title: "malicioso", status: 1, type: "x" },
+        });
+      });
+      const body = await json(await t.fetch("/x"));
+      expect(body.data).toEqual({ campo: "email" });
+      expect(body.codigo).toBe("E42");
+      expect(body.title).toBe("Bad Request");
+      expect(body.status).toBe(400);
+      expect(body.type).toBe("about:blank");
+    });
+  });
+
+  describe("RF-06: unhandled", () => {
+    it("masks internals", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", () => {
+        throw new Error("segredo interno");
+      });
+      const res = await t.fetch("/x");
+      const text = await res.text();
+      t.errors = [];
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toMatch(problemType);
+      expect(text).not.toContain("segredo interno");
+      expect(JSON.parse(text)).toEqual({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        detail: "HTTPError",
+      });
+    });
+  });
+
+  describe("RF-07: debug and onError", () => {
+    it("debug adds stack and indentation", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = true;
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const res = await t.fetch("/x");
+      const text = await res.text();
+      expect(res.headers.get("content-type")).toMatch(problemType);
+      expect(text).toContain('\n  "');
+      const body = JSON.parse(text);
+      expect(body.detail).toBe("x");
+      expect(Array.isArray(body.stack)).toBe(true);
+    });
+
+    it("onError Response prevails", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => new Response("custom", { status: 418 });
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(418);
+      expect(await res.text()).toBe("custom");
+    });
+
+    it("onError throwing HTTPError renders problem details", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => {
+        throw new HTTPError({ status: 403, message: "nope" });
+      };
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toMatch(problemType);
+      expect(await json(res)).toMatchObject({ status: 403, detail: "nope" });
+    });
+
+    it("onError observing does not alter", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => {};
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400, message: "m" });
+      });
+      const res = await t.fetch("/x");
+      expect(res.headers.get("content-type")).toMatch(problemType);
+      expect(await json(res)).toMatchObject({ status: 400, detail: "m" });
+    });
+  });
+});
