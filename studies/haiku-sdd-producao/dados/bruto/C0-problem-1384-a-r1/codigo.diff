@@ -0,0 +1,42 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+
+describe("HTTPError type/instance", () => {
+  it("via constructor", () => {
+    const err = new HTTPError({ status: 409, type: "urn:erro:conflito", instance: "/r/1" });
+    expect(err.type).toBe("urn:erro:conflito");
+    expect(err.instance).toBe("/r/1");
+  });
+
+  it("undefined by default", () => {
+    const err = new HTTPError({ status: 409 });
+    expect(err.type).toBeUndefined();
+    expect(err.instance).toBeUndefined();
+  });
+
+  it("via HTTPError.status", () => {
+    const err = HTTPError.status(409, "Conflict", { type: "urn:x", instance: "/i" } as any);
+    expect(err.type).toBe("urn:x");
+    expect(err.instance).toBe("/i");
+  });
+
+  it("inherited from cause", () => {
+    const err = new HTTPError({ cause: { status: 400, type: "urn:c", instance: "/c" } });
+    expect(err.type).toBe("urn:c");
+    expect(err.instance).toBe("/c");
+  });
+
+  it("ignores non-string values", () => {
+    const err = new HTTPError({ status: 400, type: 1 as any, instance: {} as any });
+    expect(err.type).toBeUndefined();
+    expect(err.instance).toBeUndefined();
+  });
+
+  it("toJSON does not include type/instance or ~title", () => {
+    const err = new HTTPError({ status: 400, statusText: "Ruim", type: "urn:x", instance: "/i" });
+    const json = err.toJSON();
+    expect(json).not.toHaveProperty("type");
+    expect(json).not.toHaveProperty("instance");
+    expect(Object.keys(err)).not.toContain("~title");
+  });
+});
