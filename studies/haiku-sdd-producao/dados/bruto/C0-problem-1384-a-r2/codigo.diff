diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..74a0747
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,49 @@
+import type { HTTPError } from "../../error.ts";
+
+// Minimal map (no `http.STATUS_CODES`: multi-runtime and bundle size); other statuses omit `title`.
+// prettier-ignore
+const statusTitles: Record<number, string> = {
+  400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
+  405: "Method Not Allowed", 409: "Conflict", 413: "Content Too Large",
+  415: "Unsupported Media Type", 422: "Unprocessable Entity", 429: "Too Many Requests",
+  500: "Internal Server Error", 502: "Bad Gateway", 503: "Service Unavailable",
+  504: "Gateway Timeout",
+};
+
+const reservedKeys = new Set(["type", "title", "status", "detail", "instance"]);
+
+/**
+ * Build an RFC 9457 problem details body from an `HTTPError`.
+ */
+export function toProblemBody(error: HTTPError, debug?: boolean): Record<string, unknown> {
+  const { status, unhandled } = error;
+  const title = (!unhandled && error.statusText) || statusTitles[status];
+  const detail =
+    !unhandled && error.message !== title && error.message !== `HTTPError ${status}`
+      ? error.message
+      : undefined;
+
+  const problem: Record<string, unknown> = {
+    type: unhandled ? undefined : error.type,
+    title,
+    status,
+    detail,
+    instance: unhandled ? undefined : error.instance,
+  };
+
+  if (!unhandled) {
+    if (error.body) {
+      for (const key of Object.keys(error.body)) {
+        if (!reservedKeys.has(key)) {
+          problem[key] = error.body[key];
+        }
+      }
+    }
+    if (error.data !== undefined) {
+      problem.data = error.data;
+    }
+  }
+
+  problem.stack = debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined;
+  return problem;
+}
