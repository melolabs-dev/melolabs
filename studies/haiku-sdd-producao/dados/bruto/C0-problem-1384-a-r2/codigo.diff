diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..e45292d
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,231 @@
+import { describeMatrix } from "./_setup.ts";
+import { HTTPError, bodyLimit, readBody, readValidatedBody } from "../src/index.ts";
+
+const PROBLEM = "application/problem+json;charset=UTF-8";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  describe("disabled", () => {
+    it("keeps legacy format when option is absent or false", async () => {
+      for (const value of [undefined, false]) {
+        t.app.config.problemDetails = value;
+        t.app.get("/x", () => {
+          throw new HTTPError({ status: 404, type: "urn:x", instance: "/i" });
+        });
+        const res = await t.fetch("/x");
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        const body = await res.json();
+        expect(body.status).toBe(404);
+        expect(body).not.toHaveProperty("title");
+        expect(body).not.toHaveProperty("type");
+        expect(body).not.toHaveProperty("instance");
+      }
+    });
+  });
+
+  describe("enabled", () => {
+    it("uses application/problem+json", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400, message: "inválido" });
+      });
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+    });
+
+    it("renders standard members", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.get("/full", () => {
+        throw new HTTPError({
+          status: 403,
+          statusText: "Forbidden",
+          message: "Sem permissão",
+          type: "https://exemplo.com/erros/permissao",
+          instance: "/pedidos/42",
+        });
+      });
+      t.app.get("/plain", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      expect(await (await t.fetch("/full")).json()).toEqual({
+        type: "https://exemplo.com/erros/permissao",
+        title: "Forbidden",
+        status: 403,
+        detail: "Sem permissão",
+        instance: "/pedidos/42",
+      });
+      const plain = await (await t.fetch("/plain")).json();
+      expect(plain).toEqual({ title: "Not Found", status: 404 });
+    });
+
+    it("preserves extensions without overriding reserved members", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.get("/x", () => {
+        throw new HTTPError({
+          status: 422,
+          message: "x",
+          data: { campo: "nome" },
+          body: {
+            codigo: "E42",
+            status: 200,
+            title: "t",
+            type: "u",
+            detail: "d",
+            instance: "i",
+          },
+        });
+      });
+      const body = await (await t.fetch("/x")).json();
+      expect(body).toEqual({
+        title: "Unprocessable Entity",
+        status: 422,
+        detail: "x",
+        codigo: "E42",
+        data: { campo: "nome" },
+      });
+    });
+
+    it("does not leak unhandled errors", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.get("/x", () => {
+        throw new Error("segredo interno", {
+          cause: { statusMessage: "interno", type: "entity.too.large" },
+        });
+      });
+      const res = await t.fetch("/x");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(text).not.toContain("segredo");
+      expect(text).not.toContain("interno");
+      expect(text).not.toContain("stack");
+      expect(JSON.parse(text)).toEqual({ title: "Internal Server Error", status: 500 });
+      t.errors.length = 0;
+    });
+
+    it("includes indented stack in debug mode", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = true;
+      t.app.config.silent = true;
+      t.app.get("/x", () => {
+        throw new Error("segredo interno");
+      });
+      const text = await (await t.fetch("/x")).text();
+      expect(text).toContain('\n  "title"');
+      expect(Array.isArray(JSON.parse(text).stack)).toBe(true);
+      expect(text).not.toContain("segredo interno\\n");
+      t.errors.length = 0;
+    });
+
+    it("applies to framework-generated errors", async () => {
+      t.app.config.problemDetails = true;
+      t.app.post("/limit", (event) => readBody(event), { middleware: [bodyLimit(4)] });
+      t.app.post("/validate", (event) => readValidatedBody(event, () => false));
+      t.app.get("/ok", () => "ok");
+
+      const notFound = await t.fetch("/nope");
+      expect(notFound.status).toBe(404);
+      expect(notFound.headers.get("content-type")).toBe(PROBLEM);
+      const nf = await notFound.json();
+      expect(nf.title).toBe("Not Found");
+      expect(nf.detail).toContain("Cannot find any route matching [GET]");
+
+      const big = await t.fetch("/limit", { method: "POST", body: "too large body" });
+      expect(big.status).toBe(413);
+      expect(big.headers.get("content-type")).toBe(PROBLEM);
+
+      const invalid = await t.fetch("/validate", {
+        method: "POST",
+        body: "{}",
+        headers: { "content-type": "application/json" },
+      });
+      expect(invalid.status).toBe(400);
+      expect(invalid.headers.get("content-type")).toBe(PROBLEM);
+    });
+
+    it("rejects malformed path with problem details", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/foo", () => "ok");
+      const res = await t.fetch("/foo%");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+    });
+
+    it("merges headers", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/h", () => {
+        throw new HTTPError({ status: 400, headers: { "x-id": "1" } });
+      });
+      t.app.get("/ct", () => {
+        throw new HTTPError({ status: 400, headers: { "content-type": "text/plain" } });
+      });
+      t.app.get("/err", (event) => {
+        event.res.headers.set("x-ignored", "1");
+        event.res.errHeaders.set("x-err", "2");
+        event.res.errHeaders.append("set-cookie", "a=1");
+        throw new HTTPError({ status: 400 });
+      });
+      const h = await t.fetch("/h");
+      expect(h.headers.get("x-id")).toBe("1");
+      expect(h.headers.get("content-type")).toBe(PROBLEM);
+      expect((await t.fetch("/ct")).headers.get("content-type")).toBe("text/plain");
+      const err = await t.fetch("/err");
+      expect(err.headers.get("x-err")).toBe("2");
+      expect(err.headers.getSetCookie()).toEqual(["a=1"]);
+    });
+
+    it("keeps custom onError response", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => Response.json({ custom: true }, { status: 418 });
+      t.app.get("/x", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(418);
+      expect(await res.json()).toEqual({ custom: true });
+    });
+
+    it("turns circular data into a bare 500", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/x", () => {
+        const data: any = {};
+        data.self = data;
+        throw new HTTPError({ status: 400, data });
+      });
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(500);
+      t.errors.length = 0;
+    });
+  });
+});
+
+describeMatrix("problem details: HTTPError fields", (t, { it, expect }) => {
+  it("exposes type and instance", () => {
+    const err = new HTTPError({ status: 409, type: "urn:erro:conflito", instance: "/x/1" });
+    expect(err.type).toBe("urn:erro:conflito");
+    expect(err.instance).toBe("/x/1");
+    const none = new HTTPError({ status: 409 });
+    expect(none.type).toBeUndefined();
+    expect(none.instance).toBeUndefined();
+  });
+
+  it("supports HTTPError.status details and drops non-strings", () => {
+    const err = HTTPError.status(409, undefined, { type: "urn:a", instance: "/b" });
+    expect(err.type).toBe("urn:a");
+    expect(err.instance).toBe("/b");
+    const bad = new HTTPError({ status: 400, type: 1 as any, instance: {} as any });
+    expect(bad.type).toBeUndefined();
+    expect(bad.instance).toBeUndefined();
+  });
+
+  it("does not add type/instance to toJSON", () => {
+    const json = new HTTPError({ status: 409, type: "urn:a", instance: "/b" }).toJSON();
+    expect(json).not.toHaveProperty("type");
+    expect(json).not.toHaveProperty("instance");
+  });
+});
