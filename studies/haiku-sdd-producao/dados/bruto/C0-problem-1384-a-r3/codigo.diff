diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..3bf8998
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,169 @@
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem\\+json";
+
+describeMatrix("problem details", (t, { it, expect }) => {
+  const enable = (debug = false) => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = debug;
+    t.app.config.silent = true;
+  };
+
+  describe_unit();
+
+  it("keeps the legacy format when the option is absent or false", async () => {
+    t.app.get("/x", () => {
+      throw HTTPError.status(404, "Not Found", { message: "gone" });
+    });
+    for (const value of [undefined, false]) {
+      t.app.config.problemDetails = value;
+      const res = await t.fetch("/x");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(body).toMatchObject({ status: 404, statusText: "Not Found", message: "gone" });
+      expect(body).not.toHaveProperty("title");
+      expect(body).not.toHaveProperty("type");
+      expect(body).not.toHaveProperty("detail");
+    }
+  });
+
+  it("renders thrown errors as problem details", async () => {
+    enable();
+    t.app.get("/u", () => {
+      throw new HTTPError({
+        status: 404,
+        statusText: "Not Found",
+        message: "Usuário não existe",
+        type: "https://exemplo.com/erros/nao-encontrado",
+        instance: "/usuarios/7",
+      });
+    });
+    const res = await t.fetch("/u");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toMatch(new RegExp(`^${PROBLEM}`));
+    expect(await res.json()).toEqual({
+      type: "https://exemplo.com/erros/nao-encontrado",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário não existe",
+      instance: "/usuarios/7",
+    });
+  });
+
+  it("renders returned errors and unmatched routes", async () => {
+    enable();
+    t.app.get("/r", () => new HTTPError({ status: 400, message: "bad" }));
+    const res = await t.fetch("/r");
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-type")).toMatch(new RegExp(`^${PROBLEM}`));
+    expect(await res.json()).toMatchObject({ status: 400, detail: "bad" });
+
+    const nf = await t.fetch("/nothing");
+    expect(nf.status).toBe(404);
+    expect(nf.headers.get("content-type")).toMatch(new RegExp(`^${PROBLEM}`));
+    const nfBody = await nf.json();
+    expect(nfBody).toMatchObject({ type: "about:blank", status: 404, title: "Not Found" });
+    expect(nfBody.detail).toContain("Cannot find any route");
+  });
+
+  it("applies defaults for type, title, detail and instance", async () => {
+    enable();
+    t.app.get("/d", () => {
+      throw HTTPError.status(404);
+    });
+    t.app.get("/odd", () => {
+      throw HTTPError.status(499);
+    });
+    const body = await (await t.fetch("/d")).json();
+    expect(body).toEqual({ type: "about:blank", title: "Not Found", status: 404 });
+
+    const odd = await (await t.fetch("/odd")).json();
+    expect(odd.status).toBe(499);
+    expect(odd.title).toBeTruthy();
+  });
+
+  it("keeps extensions and protects standard members", async () => {
+    enable();
+    t.app.get("/e", () => {
+      throw new HTTPError({
+        status: 404,
+        body: { codigo: "E42", status: 999, title: "x" },
+        data: { campo: "nome" },
+      });
+    });
+    const body = await (await t.fetch("/e")).json();
+    expect(body.codigo).toBe("E42");
+    expect(body.data).toEqual({ campo: "nome" });
+    expect(body.status).toBe(404);
+    expect(body.title).toBe("Not Found");
+  });
+
+  it("does not leak unhandled errors", async () => {
+    enable();
+    t.app.get("/boom", () => {
+      throw new Error("segredo interno");
+    });
+    const res = await t.fetch("/boom");
+    const text = await res.text();
+    expect(res.status).toBe(500);
+    expect(res.headers.get("content-type")).toMatch(new RegExp(`^${PROBLEM}`));
+    expect(text).not.toContain("segredo interno");
+    expect(JSON.parse(text)).not.toHaveProperty("stack");
+    t.errors.length = 0;
+  });
+
+  it("does not leak input of unhandled HTTPError", async () => {
+    enable();
+    t.app.get("/u", () => {
+      throw new HTTPError({
+        status: 500,
+        unhandled: true,
+        type: "https://x/y",
+        instance: "/secret",
+        data: { s: 1 },
+        body: { b: 1 },
+        message: "hidden",
+      });
+    });
+    const res = await t.fetch("/u");
+    const text = await res.text();
+    expect(JSON.parse(text)).toEqual({
+      type: "about:blank",
+      title: "Internal Server Error",
+      status: 500,
+    });
+    t.errors.length = 0;
+  });
+
+  it("merges headers and includes stack in debug", async () => {
+    enable(true);
+    t.app.get("/h", (event) => {
+      event.res.errHeaders.set("x-err", "1");
+      event.res.errHeaders.append("set-cookie", "a=b");
+      throw new HTTPError({ status: 400, headers: { "x-id": "1" } });
+    });
+    const res = await t.fetch("/h");
+    expect(res.headers.get("x-id")).toBe("1");
+    expect(res.headers.get("x-err")).toBe("1");
+    expect(res.headers.getSetCookie()).toEqual(["a=b"]);
+    expect(res.headers.get("content-type")).toMatch(new RegExp(`^${PROBLEM}`));
+    expect(Array.isArray((await res.json()).stack)).toBe(true);
+  });
+
+  function describe_unit() {
+    it("exposes type and instance on HTTPError", () => {
+      const err = new HTTPError({ status: 400, type: "t:x", instance: "/i" });
+      expect(err.type).toBe("t:x");
+      expect(err.instance).toBe("/i");
+      const plain = new HTTPError({ status: 400 });
+      expect(plain.type).toBeUndefined();
+      expect(plain.instance).toBeUndefined();
+      expect(Object.keys(err.toJSON())).not.toContain("type");
+      expect(Object.keys(err.toJSON())).not.toContain("instance");
+      expect(HTTPError.status(400, undefined, { type: "t:y" }).type).toBe("t:y");
+      expect(new HTTPError({ status: 400, cause: { type: "foreign" } }).type).toBeUndefined();
+    });
+  }
+});
