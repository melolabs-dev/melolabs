diff --git a/src/utils/internal/problem-details.ts b/src/utils/internal/problem-details.ts
new file mode 100644
index 0000000..90db9f6
--- /dev/null
+++ b/src/utils/internal/problem-details.ts
@@ -0,0 +1,38 @@
+import type { HTTPError } from "../../error.ts";
+
+// prettier-ignore
+const reasons: Record<number, string> = {
+  400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
+  405: "Method Not Allowed", 408: "Request Timeout", 409: "Conflict", 410: "Gone",
+  413: "Payload Too Large", 415: "Unsupported Media Type", 418: "I'm a Teapot",
+  422: "Unprocessable Entity", 429: "Too Many Requests", 500: "Internal Server Error",
+  501: "Not Implemented", 502: "Bad Gateway", 503: "Service Unavailable", 504: "Gateway Timeout",
+};
+
+/**
+ * Build an RFC 9457 problem details body from an error.
+ *
+ * Later keys win: `body` extensions, then `data`, then standard members, then `stack`.
+ */
+export function problemDetailsBody(error: HTTPError, debug?: boolean): Record<string, unknown> {
+  const { status, unhandled } = error;
+  const phrase =
+    reasons[status] || (status >= 500 ? "Server Error" : status >= 400 ? "Client Error" : "Error");
+
+  // Message generated by the HTTPError constructor itself carries no information.
+  const defaultMessages = [
+    ["HTTPError", status, error.statusText].filter(Boolean).join(" "),
+    error.statusText,
+  ];
+
+  return {
+    ...(unhandled ? undefined : error.body),
+    data: unhandled ? undefined : error.data,
+    type: (!unhandled && error.type) || "about:blank",
+    title: (!unhandled && error.statusText) || phrase,
+    status,
+    detail: unhandled || defaultMessages.includes(error.message) ? undefined : error.message,
+    instance: unhandled ? undefined : error.instance,
+    stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
+  };
+}
