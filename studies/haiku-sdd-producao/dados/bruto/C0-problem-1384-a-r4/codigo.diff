new file mode 100644
index 0000000..b02e48b
--- /dev/null
+++ b/test/unit/error.test.ts
@@ -0,0 +1,49 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+
+describe("HTTPError type/instance", () => {
+  it("exposes provided values", () => {
+    const error = new HTTPError({
+      status: 409,
+      type: "https://example.com/probs/conflito",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://example.com/probs/conflito");
+    expect(error.instance).toBe("/pedidos/42");
+  });
+
+  it("is undefined when absent", () => {
+    const error = new HTTPError({ status: 400 });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("inherits from cause HTTPError and plain object", () => {
+    const fromHTTPError = new HTTPError({
+      cause: new HTTPError({ status: 409, type: "urn:a", instance: "/a" }),
+    });
+    expect(fromHTTPError.type).toBe("urn:a");
+    expect(fromHTTPError.instance).toBe("/a");
+    const fromObject = new HTTPError({ cause: { type: "urn:b", instance: "/b" } as any });
+    expect(fromObject.type).toBe("urn:b");
+    expect(fromObject.instance).toBe("/b");
+  });
+
+  it("ignores foreign Error type", () => {
+    const foreign = Object.assign(new Error("bad json"), { type: "entity.parse.failed" });
+    expect(new HTTPError(foreign).type).toBeUndefined();
+    expect(new HTTPError({ cause: foreign }).type).toBeUndefined();
+  });
+
+  it("ignores non-string values", () => {
+    const error = new HTTPError({ type: 1, instance: {} } as any);
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("toJSON does not include type/instance", () => {
+    const json = new HTTPError({ status: 409, type: "urn:a", instance: "/a" }).toJSON();
+    expect("type" in json).toBe(false);
+    expect("instance" in json).toBe(false);
+  });
+});
