+// Reads a string member from `details`, then from `details.cause`. Foreign `Error`s are ignored
+// (libraries use `type` for their own codes, e.g. "entity.parse.failed").
+function inheritString(
+  details: ErrorDetails | undefined,
+  key: "type" | "instance",
+): string | undefined {
+  for (const source of [details, details?.cause]) {
+    if (!source || (source instanceof Error && !HTTPError.isError(source))) {
+      continue;
+    }
+    const value = (source as Record<string, unknown>)[key];
+    if (typeof value === "string" && value) {
+      return value;
+    }
+  }
+}
