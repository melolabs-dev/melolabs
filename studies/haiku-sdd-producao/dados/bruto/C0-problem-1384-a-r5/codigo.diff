diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..ff45e75
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,287 @@
+import { beforeEach } from "vitest";
+import { HTTPError, readValidatedBody, type H3Event } from "../src/index.ts";
+import { onResponse } from "../src/utils/middleware.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix(
+  "problem details",
+  (t, { it, describe, expect }) => {
+    beforeEach(() => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+    });
+
+    describe("disabled", () => {
+      for (const value of [undefined, false]) {
+        it(`keeps legacy body and content-type (problemDetails: ${value})`, async () => {
+          t.app.config.problemDetails = value;
+          t.app.get("/", () => {
+            throw new HTTPError("Nope", { status: 404, statusText: "Not Found", type: "x" });
+          });
+          const res = await t.fetch("/");
+          expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+          const body = await res.json();
+          expect(body).toMatchObject({ status: 404, statusText: "Not Found", message: "Nope" });
+          for (const key of ["title", "detail", "instance", "type"]) {
+            expect(body).not.toHaveProperty(key);
+          }
+        });
+      }
+    });
+
+    it("responds with problem+json (RF-02)", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404);
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    });
+
+    describe("members", () => {
+      it("title, detail, status without type/instance", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError("Usuário não encontrado", { status: 404, statusText: "Not Found" });
+        });
+        const res = await t.fetch("/");
+        expect(await res.json()).toEqual({
+          title: "Not Found",
+          status: 404,
+          detail: "Usuário não encontrado",
+        });
+      });
+
+      it("omits detail when message equals title", async () => {
+        t.app.get("/", () => {
+          throw HTTPError.status(403, "Forbidden");
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({ title: "Forbidden", status: 403 });
+      });
+
+      it("uses the default status text as title", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError("Too fast", { status: 429 });
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({
+          title: "Too Many Requests",
+          status: 429,
+          detail: "Too fast",
+        });
+      });
+
+      it("exposes the generated message as detail (current behavior)", async () => {
+        t.app.get("/", () => {
+          throw HTTPError.status(404);
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({
+          title: "Not Found",
+          status: 404,
+          detail: "HTTPError 404",
+        });
+      });
+
+      it("omits title for unknown status", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError("Odd", { status: 499 });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body).toEqual({ status: 499, detail: "Odd" });
+      });
+    });
+
+    describe("type and instance", () => {
+      it("are undefined by default and exposed when set", () => {
+        const plain = new HTTPError({ status: 403 });
+        expect(plain.type).toBeUndefined();
+        expect(plain.instance).toBeUndefined();
+        const err = new HTTPError({
+          status: 403,
+          type: "https://exemplo.com/erros/sem-saldo",
+          instance: "/contas/12/saques/9",
+        });
+        expect(err.type).toBe("https://exemplo.com/erros/sem-saldo");
+        expect(err.instance).toBe("/contas/12/saques/9");
+        expect(err.toJSON()).not.toHaveProperty("type");
+        expect(err.toJSON()).not.toHaveProperty("instance");
+      });
+
+      it("appear in the body", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 403,
+            type: "https://exemplo.com/erros/sem-saldo",
+            instance: "/contas/12/saques/9",
+          });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body.type).toBe("https://exemplo.com/erros/sem-saldo");
+        expect(body.instance).toBe("/contas/12/saques/9");
+      });
+
+      it("error fields win over body", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 400,
+            type: "own",
+            instance: "own-i",
+            body: { type: "body", instance: "body-i" },
+          });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body).toMatchObject({ type: "own", instance: "own-i" });
+      });
+    });
+
+    it("keeps extensions without overriding standard members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 422,
+          body: { campo: "email", status: 200, title: "x" },
+          data: { x: 1 },
+        });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(res.status).toBe(422);
+      expect(body).toMatchObject({
+        campo: "email",
+        data: { x: 1 },
+        status: 422,
+        title: "Unprocessable Content",
+      });
+    });
+
+    describe("unhandled", () => {
+      it("masks the error", async () => {
+        t.app.config.silent = true;
+        t.app.get("/", () => {
+          throw new Error("segredo interno");
+        });
+        const res = await t.fetch("/");
+        const text = await res.text();
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+        expect(text).not.toContain("segredo interno");
+        expect(JSON.parse(text)).toEqual({ title: "Internal Server Error", status: 500 });
+      });
+
+      it("does not leak type of third-party errors", async () => {
+        t.app.config.silent = true;
+        t.app.get("/", () => {
+          throw Object.assign(new Error("x"), { type: "entity.too.large", instance: "/secret" });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body).not.toHaveProperty("type");
+        expect(body).not.toHaveProperty("instance");
+        expect(body).not.toHaveProperty("detail");
+      });
+    });
+
+    it("includes an indented stack in debug", async () => {
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw new HTTPError("boom", { status: 400, body: { stack: "fake" } });
+      });
+      const res = await t.fetch("/");
+      const text = await res.text();
+      const body = JSON.parse(text);
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(body).toMatchObject({ title: "Bad Request", status: 400, detail: "boom" });
+      expect(text).toContain('\n  "title"');
+    });
+
+    describe("headers", () => {
+      it("keeps status, statusText and error headers", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 401,
+            statusText: "Nope",
+            headers: { "x-trace": "abc" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(401);
+        expect(res.headers.get("x-trace")).toBe("abc");
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+        if (t.target === "web") expect(res.statusText).toBe("Nope");
+      });
+
+      it("keeps event.res.errHeaders", async () => {
+        t.app.get("/", (event: H3Event) => {
+          event.res.errHeaders.set("x-err", "1");
+          throw HTTPError.status(400);
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("x-err")).toBe("1");
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      });
+    });
+
+    describe("error paths", () => {
+      const expectProblem = async (res: Response, status: number) => {
+        expect(res.status).toBe(status);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+        const body = await res.json();
+        expect(body.status).toBe(status);
+        expect(typeof body.title).toBe("string");
+        return body;
+      };
+
+      for (const withOnError of [false, true]) {
+        const suffix = withOnError ? "with onError" : "without onError";
+
+        it(`unknown route ${suffix}`, async () => {
+          if (!withOnError) t.app.config.onError = undefined;
+          await expectProblem(await t.fetch("/nada"), 404);
+        });
+
+        it(`middleware error ${suffix}`, async () => {
+          if (!withOnError) t.app.config.onError = undefined;
+          t.app.use(() => {
+            throw HTTPError.status(403);
+          });
+          await expectProblem(await t.fetch("/"), 403);
+        });
+      }
+
+      it("validation error", async () => {
+        t.app.post("/", async (event) => {
+          await readValidatedBody(event, () => false);
+        });
+        const res = await t.fetch("/", { method: "POST", body: "{}" });
+        await expectProblem(res, 400);
+      });
+
+      it("onError returning its own value takes precedence", async () => {
+        t.app.config.onError = () => "custom";
+        t.app.get("/", () => {
+          throw HTTPError.status(400);
+        });
+        const res = await t.fetch("/");
+        expect(await res.text()).toBe("custom");
+        expect(res.headers.get("content-type")).not.toMatch(/problem/);
+      });
+
+      it("onError returning an HTTPError", async () => {
+        t.app.config.onError = () => new HTTPError("replaced", { status: 409, type: "t" });
+        t.app.get("/", () => {
+          throw HTTPError.status(400);
+        });
+        const body = await expectProblem(await t.fetch("/"), 409);
+        expect(body).toMatchObject({ type: "t", detail: "replaced" });
+      });
+
+      it("onResponse middleware receives kNotFound", async () => {
+        t.app.use(onResponse(() => {}));
+        await expectProblem(await t.fetch("/nada"), 404);
+      });
+
+      it("HEAD has no body", async () => {
+        const res = await t.fetch("/nada", { method: "HEAD" });
+        expect(res.status).toBe(404);
+        expect(await res.text()).toBe("");
+      });
+    });
+  },
+  { allowUnhandledErrors: true },
+);
