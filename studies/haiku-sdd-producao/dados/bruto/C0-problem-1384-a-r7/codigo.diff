diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..b1d99d1
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,158 @@
+import { beforeEach } from "vitest";
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  describe("disabled (default)", () => {
+    it("keeps the legacy format", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404);
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/json/);
+      const body = await res.json();
+      expect(body.status).toBe(404);
+      expect("message" in body).toBe(true);
+      expect("title" in body).toBe(false);
+      expect("type" in body).toBe(false);
+    });
+  });
+
+  describe("enabled", () => {
+    beforeEach(() => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+    });
+
+    it("renders RFC 9457 members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 403, statusText: "Forbidden", message: "Sem permissão" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Forbidden",
+        status: 403,
+        detail: "Sem permissão",
+      });
+    });
+
+    it("falls back to the standard status phrase for title", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 422, message: "bad" });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.title).toBe("Unprocessable Content");
+    });
+
+    it("uses application/problem+json and merges headers", async () => {
+      t.app.get("/", (event) => {
+        event.res.headers.set("x-res", "2");
+        throw new HTTPError({ status: 400, headers: { "x-custom": "1" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(res.headers.get("x-custom")).toBe("1");
+    });
+
+    it("includes type and instance", async () => {
+      t.app.get("/a", () => {
+        throw new HTTPError({
+          status: 422,
+          type: "https://example.com/probs/validacao",
+          instance: "/pedidos/42",
+        });
+      });
+      t.app.get("/b", () => {
+        throw new HTTPError({ status: 422 });
+      });
+      const a = await (await t.fetch("/a")).json();
+      expect(a.type).toBe("https://example.com/probs/validacao");
+      expect(a.instance).toBe("/pedidos/42");
+      const b = await (await t.fetch("/b")).json();
+      expect(b.type).toBe("about:blank");
+      expect("instance" in b).toBe(false);
+    });
+
+    it("keeps data and body extensions; standard members win", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "m",
+          data: { campo: "email" },
+          body: { code: "E_VAL", type: "x", title: "y", status: 1, detail: "z", instance: "w" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.data).toEqual({ campo: "email" });
+      expect(body.code).toBe("E_VAL");
+      expect(body.type).toBe("about:blank");
+      expect(body.title).toBe("Bad Request");
+      expect(body.status).toBe(400);
+      expect(body.detail).toBe("m");
+      expect("instance" in body).toBe(false);
+    });
+
+    it("does not leak unhandled errors", async () => {
+      t.app.get("/", () => {
+        throw new Error("segredo interno");
+      });
+      t.app.get("/cause", () => {
+        throw new Error("segredo interno", {
+          cause: { type: "vazado", instance: "/vazado", statusText: "Vazado" },
+        });
+      });
+      for (const path of ["/", "/cause"]) {
+        const res = await t.fetch(path);
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+        const text = await res.text();
+        expect(text).not.toContain("segredo interno");
+        expect(text).not.toContain("vazado");
+        expect(text).not.toContain("Vazado");
+        expect(text).not.toContain("stack");
+        expect(JSON.parse(text).title).toBe("Internal Server Error");
+      }
+      // Unhandled errors are expected here
+      t.errors.length = 0;
+    });
+
+    it("404 includes stack only in debug", async () => {
+      let res = await t.fetch("/missing");
+      let body = await res.json();
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(body.title).toBe("Not Found");
+      expect("stack" in body).toBe(false);
+
+      t.app.config.debug = true;
+      res = await t.fetch("/missing");
+      body = await res.json();
+      expect(body.title).toBe("Not Found");
+      expect(Array.isArray(body.stack)).toBe(true);
+    });
+
+    it("onError returning a Response takes precedence", async () => {
+      t.app.config.onError = () => new Response("custom", { status: 418 });
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(await res.text()).toBe("custom");
+    });
+
+    it("onError returning an HTTPError is rendered as problem details", async () => {
+      t.app.config.onError = () => new HTTPError({ status: 409, message: "conflito" });
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect((await res.json()).detail).toBe("conflito");
+    });
+  });
+});
diff --git a/test/unit/error.test.ts b/test/unit/error.test.ts
new file mode 100644
index 0000000..9a881ac
--- /dev/null
+++ b/test/unit/error.test.ts
@@ -0,0 +1,39 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+
+describe("HTTPError type and instance", () => {
+  it("reads type and instance from input", () => {
+    const error = new HTTPError({
+      status: 400,
+      type: "https://example.com/probs/invalido",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://example.com/probs/invalido");
+    expect(error.instance).toBe("/pedidos/42");
+  });
+
+  it("is undefined when absent", () => {
+    const error = new HTTPError({ status: 400 });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("inherits from cause", () => {
+    const cause = Object.assign(new Error("x"), { type: "t", instance: "i" });
+    const error = new HTTPError({ cause });
+    expect(error.type).toBe("t");
+    expect(error.instance).toBe("i");
+  });
+
+  it("ignores non string values", () => {
+    const error = new HTTPError({ status: 400, type: 1, instance: {} } as any);
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("does not add type and instance to toJSON()", () => {
+    const json = new HTTPError({ status: 400, type: "t", instance: "i" }).toJSON();
+    expect("type" in json).toBe(false);
+    expect("instance" in json).toBe(false);
+  });
+});
