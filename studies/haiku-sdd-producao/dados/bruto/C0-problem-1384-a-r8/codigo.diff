diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..19a618d
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,231 @@
+import { H3, HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json;charset=UTF-8";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  describe("disabled", () => {
+    for (const value of [undefined, false]) {
+      it(`keeps the legacy format when problemDetails is ${value}`, async () => {
+        t.app.config.debug = false;
+        t.app.config.problemDetails = value;
+        t.app.use(() => {
+          throw new HTTPError({
+            status: 422,
+            statusText: "Unprocessable",
+            message: "bad",
+            type: "https://example.com/err",
+            instance: "/x/1",
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        expect(await res.text()).toBe(
+          JSON.stringify({ status: 422, statusText: "Unprocessable", message: "bad" }),
+        );
+      });
+    }
+  });
+
+  describe("enabled", () => {
+    it("uses application/problem+json for thrown errors", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use(() => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    });
+
+    it("renders the exact RFC 9457 body", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 422,
+          statusText: "Invalid entity",
+          message: "campo x ausente",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Invalid entity",
+        status: 422,
+        detail: "campo x ausente",
+      });
+    });
+
+    it("falls back to the default phrase for title", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.get("/known", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      t.app.get("/unknown", () => {
+        throw new HTTPError({ status: 499 });
+      });
+      expect((await (await t.fetch("/known")).json()).title).toBe("Not Found");
+      expect((await (await t.fetch("/unknown")).json()).title).toBe("Error");
+    });
+
+    it("reads type and instance from property, cause and HTTPError.status", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.get("/prop", () => {
+        throw new HTTPError({ status: 403, type: "https://e.com/a", instance: "/p/1" });
+      });
+      t.app.get("/cause", () => {
+        throw new HTTPError({
+          status: 403,
+          cause: { type: "https://e.com/b", instance: "/p/2" },
+        });
+      });
+      t.app.get("/static", () => {
+        throw HTTPError.status(403, undefined, { type: "https://e.com/c", instance: "/p/3" });
+      });
+      t.app.get("/nonstring", () => {
+        throw new HTTPError({ status: 403, type: 42 as any, instance: {} as any });
+      });
+      expect(await (await t.fetch("/prop")).json()).toMatchObject({
+        type: "https://e.com/a",
+        instance: "/p/1",
+      });
+      expect(await (await t.fetch("/cause")).json()).toMatchObject({
+        type: "https://e.com/b",
+        instance: "/p/2",
+      });
+      expect(await (await t.fetch("/static")).json()).toMatchObject({
+        type: "https://e.com/c",
+        instance: "/p/3",
+      });
+      const body = await (await t.fetch("/nonstring")).json();
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("spreads body, nests data and protects reserved members", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 400,
+          message: "msg",
+          data: { a: 1 },
+          body: JSON.parse(
+            '{"extra":true,"status":999,"type":"x","title":"y","detail":"z","instance":"w","data":"loser","__proto__":{"polluted":true}}',
+          ),
+        });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      // `__proto__` from JSON.parse is an own key: it must stay data, never the prototype
+      expect(Object.getPrototypeOf(body)).toBe(Object.prototype);
+      expect(body.polluted).toBeUndefined();
+      delete body["__proto__"];
+      expect(body).toEqual({
+        type: "about:blank",
+        title: "Bad Request",
+        status: 400,
+        detail: "msg",
+        extra: true,
+        data: { a: 1 },
+      });
+      expect(({} as any).polluted).toBeUndefined();
+    });
+
+    it("hides details of unhandled errors", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.use(() => {
+        const error: any = new Error("segredo interno");
+        error.type = "https://e.com/leak";
+        error.instance = "/leak";
+        error.data = { secret: 1 };
+        throw error;
+      });
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(text).not.toContain("segredo");
+      expect(JSON.parse(text)).toEqual({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        detail: "HTTPError",
+      });
+      t.errors = [];
+    });
+
+    it("merges headers, adds stack in debug and honors onError", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use((event) => {
+        event.res.errHeaders.set("x-err", "prepared");
+        throw new HTTPError({ status: 409, message: "dup", headers: { "x-id": "7" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("x-id")).toBe("7");
+      expect(res.headers.get("x-err")).toBe("prepared");
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      const body = await res.json();
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+      expect(t.hooks.onError.mock.calls[0]![0]).toBeInstanceOf(HTTPError);
+    });
+
+    it("lets an explicit content-type win", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use(() => {
+        throw new HTTPError({ status: 400, headers: { "content-type": "text/plain" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("text/plain");
+    });
+
+    it("uses the Response returned from onError", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => new Response("custom", { status: 418 });
+      t.app.use(() => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(await res.text()).toBe("custom");
+    });
+
+    it("renders framework 404 as problem details", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      const res = await t.fetch("/nada");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect((await res.json()).detail).toContain("Cannot find any route matching");
+    });
+
+    it("sends no body for HEAD", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use(() => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.text()).toBe("");
+    });
+  });
+
+  describe("HTTPError", () => {
+    it("exposes type and instance without changing toJSON()", () => {
+      const error = new HTTPError({ status: 403, type: "https://e.com/t", instance: "/i" });
+      expect(error.type).toBe("https://e.com/t");
+      expect(error.instance).toBe("/i");
+      const json = error.toJSON();
+      expect(json).not.toHaveProperty("type");
+      expect(json).not.toHaveProperty("instance");
+      expect(new H3({ problemDetails: true }).config.problemDetails).toBe(true);
+    });
+  });
+});
