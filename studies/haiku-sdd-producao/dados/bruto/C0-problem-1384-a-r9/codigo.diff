+++ b/test/problem-details.test.ts
@@ -0,0 +1,305 @@
+import { vi } from "vitest";
+import { HTTPError, onResponse } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json;charset=UTF-8";
+const JSON_TYPE = "application/json;charset=UTF-8";
+
+describeMatrix(
+  "problem details",
+  (t, { it, expect, describe }) => {
+    (globalThis.console.error as any) = vi.fn();
+
+    const enable = (debug = false) => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = debug;
+    };
+
+    describe("disabled (RF-01)", () => {
+      for (const value of [undefined, false]) {
+        it(`keeps the legacy format with problemDetails=${value}`, async () => {
+          t.app.config.problemDetails = value;
+          t.app.config.debug = false;
+          t.app.get("/", () => {
+            throw new HTTPError({ status: 403, message: "nope", data: { a: 1 } });
+          });
+          const res = await t.fetch("/");
+          expect(res.status).toBe(403);
+          expect(res.headers.get("content-type")).toBe(JSON_TYPE);
+          expect(await res.json()).toEqual({
+            status: 403,
+            message: "nope",
+            data: { a: 1 },
+          });
+        });
+      }
+
+      it("toJSON has no type/instance", () => {
+        const error = new HTTPError({ status: 400, type: "x", instance: "y" });
+        expect(Object.keys(error.toJSON())).not.toContain("type");
+        expect(Object.keys(error.toJSON())).not.toContain("instance");
+      });
+    });
+
+    describe("content type (RF-02)", () => {
+      it("HTTPError", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 404 });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("thrown status number", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw 404;
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        t.errors = [];
+      });
+
+      it("missing route", async () => {
+        enable();
+        const res = await t.fetch("/missing");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+    });
+
+    describe("members (RF-03)", () => {
+      it("full example", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 403,
+            statusText: "Forbidden",
+            message: "Sem permissão",
+            type: "https://example.com/probs/forbidden",
+            instance: "/contas/42",
+          });
+        });
+        const res = await t.fetch("/");
+        expect(await res.json()).toEqual({
+          type: "https://example.com/probs/forbidden",
+          title: "Forbidden",
+          status: 403,
+          detail: "Sem permissão",
+          instance: "/contas/42",
+        });
+      });
+
+      it("defaults", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 404 });
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({
+          type: "about:blank",
+          title: "Not Found",
+          status: 404,
+        });
+      });
+
+      it("custom statusText without message has no detail", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 422, statusText: "Unprocessable" });
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({
+          type: "about:blank",
+          title: "Unprocessable",
+          status: 422,
+        });
+      });
+
+      it("explicit message becomes detail", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError("Bad thing", { status: 400 });
+        });
+        expect(await (await t.fetch("/")).json()).toMatchObject({
+          title: "Bad Request",
+          detail: "Bad thing",
+        });
+      });
+    });
+
+    describe("extensions (RF-05)", () => {
+      it("body and data", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 422,
+            body: { errors: ["x"], status: 200 },
+            data: { campo: "y" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(422);
+        expect(await res.json()).toMatchObject({
+          errors: ["x"],
+          data: { campo: "y" },
+          status: 422,
+        });
+      });
+
+      it("body cannot override standard members", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 400,
+            message: "real",
+            instance: "/real",
+            body: { type: "t", title: "T", detail: "D", instance: "I", status: 1 },
+          });
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({
+          type: "about:blank",
+          title: "Bad Request",
+          status: 400,
+          detail: "real",
+          instance: "/real",
+        });
+      });
+
+      it("body.data wins over data", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, data: { a: 1 }, body: { data: { b: 2 } } });
+        });
+        expect((await (await t.fetch("/")).json()).data).toEqual({ b: 2 });
+      });
+    });
+
+    describe("unhandled (RF-06)", () => {
+      it("Error does not leak message", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new Error("segredo interno");
+        });
+        const res = await t.fetch("/");
+        const text = await res.text();
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(text).not.toContain("segredo interno");
+        expect(JSON.parse(text)).toEqual({
+          type: "about:blank",
+          title: "Internal Server Error",
+          status: 500,
+        });
+        t.errors = [];
+      });
+
+      it("thrown object does not leak", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw { secret: "db-password", message: "segredo" };
+        });
+        const res = await t.fetch("/");
+        const text = await res.text();
+        expect(res.status).toBe(500);
+        expect(text).not.toContain("db-password");
+        expect(text).not.toContain("segredo");
+        t.errors = [];
+      });
+
+      it("debug adds stack but not message", async () => {
+        enable(true);
+        t.app.get("/", () => {
+          throw new Error("segredo interno");
+        });
+        const res = await t.fetch("/");
+        const body = await res.json();
+        expect(Array.isArray(body.stack)).toBe(true);
+        expect(body.detail).toBeUndefined();
+        expect(body.message).toBeUndefined();
+        t.errors = [];
+      });
+    });
+
+    describe("debug, headers, statusText (RF-07)", () => {
+      it("stack and headers", async () => {
+        enable(true);
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, headers: { "x-id": "1" } });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("x-id")).toBe("1");
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect((await res.json()).stack).toBeDefined();
+      });
+
+      it("explicit content-type from error wins", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, headers: { "content-type": "text/x-custom" } });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("text/x-custom");
+      });
+
+      it("merges event.res.errHeaders", async () => {
+        enable();
+        t.app.get("/", (event) => {
+          event.res.errHeaders.set("x-err", "yes");
+          throw new HTTPError({ status: 400 });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("x-err")).toBe("yes");
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("applies statusText", async () => {
+        enable();
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 418, statusText: "Teapot" });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(418);
+        if (t.target === "web") expect(res.statusText).toBe("Teapot");
+      });
+    });
+
+    describe("extra", () => {
+      it("works when enabled after app creation", async () => {
+        t.app.config.problemDetails = true;
+        const res = await t.fetch("/missing");
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("onResponse middleware returning HTTPError", async () => {
+        enable();
+        t.app.use(onResponse(() => {}));
+        t.app.get("/", () => new HTTPError({ status: 409 }));
+        const res = await t.fetch("/");
+        expect(res.status).toBe(409);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("circular data becomes 500", async () => {
+        enable();
+        t.app.config.onError = undefined;
+        t.app.get("/", () => {
+          const data: any = {};
+          data.self = data;
+          throw new HTTPError({ status: 400, data });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(500);
+        t.errors = [];
+      });
+
+      it("HEAD has no body", async () => {
+        enable();
+        const res = await t.fetch("/missing", { method: "HEAD" });
+        expect(res.status).toBe(404);
+        expect(await res.text()).toBe("");
+      });
+    });
+  },
+  { allowUnhandledErrors: true },
+);
diff --git a/test/unit/error.test.ts b/test/unit/error.test.ts
