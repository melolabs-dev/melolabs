+++ b/test/unit/error.test.ts
@@ -0,0 +1,44 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+
+describe("HTTPError type/instance", () => {
+  it("exposes type and instance", () => {
+    const error = new HTTPError({
+      status: 400,
+      type: "https://example.com/probs/x",
+      instance: "/req/1",
+    });
+    expect(error.type).toBe("https://example.com/probs/x");
+    expect(error.instance).toBe("/req/1");
+  });
+
+  it("is undefined when absent", () => {
+    const error = new HTTPError({ status: 400 });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("reads from cause", () => {
+    const error = new HTTPError({ cause: { status: 400, type: "t", instance: "i" } });
+    expect(error.type).toBe("t");
+    expect(error.instance).toBe("i");
+  });
+
+  it("HTTPError.status passes details", () => {
+    const error = HTTPError.status(400, undefined, { type: "t", instance: "i" });
+    expect(error.type).toBe("t");
+    expect(error.instance).toBe("i");
+  });
+
+  it("ignores non-string values in cause", () => {
+    const error = new HTTPError({ cause: { type: 1, instance: {} } });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("toJSON does not contain type/instance", () => {
+    const json = new HTTPError({ status: 400, type: "t", instance: "i" }).toJSON();
+    expect(json).not.toHaveProperty("type");
+    expect(json).not.toHaveProperty("instance");
+  });
+});
