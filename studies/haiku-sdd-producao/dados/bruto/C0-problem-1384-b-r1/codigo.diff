diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..95b200a
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,48 @@
+import { defaultStatusText } from "./status-text.ts";
+
+export interface ErrorLike {
+  status: number;
+  statusText?: string;
+  message: string;
+  unhandled?: boolean;
+  data?: unknown;
+  body?: Record<string, unknown>;
+  type?: unknown;
+  instance?: unknown;
+}
+
+/**
+ * Build an RFC 9457 problem details object from the public fields of an error.
+ *
+ * Reads fields defensively (HTTPError-shaped errors from other packages may lack some)
+ * and never calls `error.toJSON()`. Keys without a value are omitted.
+ */
+export function toProblemDetails(error: ErrorLike): Record<string, unknown> {
+  const { status, unhandled } = error;
+  const title = error.statusText || defaultStatusText(status) || "Error";
+
+  const json: Record<string, unknown> = {
+    status,
+    statusText: error.statusText,
+    unhandled,
+    message: unhandled ? "HTTPError" : error.message,
+  };
+  if (!unhandled) {
+    if (error.data !== undefined) json.data = error.data;
+    Object.assign(json, error.body);
+  }
+
+  // Standard members are applied last: `body` cannot override them
+  delete json.type;
+  delete json.instance;
+  if (typeof error.type === "string") json.type = error.type;
+  json.title = title;
+  json.status = status;
+  json.detail = unhandled ? title : error.message;
+  if (typeof error.instance === "string") json.instance = error.instance;
+
+  for (const key of ["statusText", "unhandled"]) {
+    if (json[key] === undefined) delete json[key];
+  }
+  return json;
+}
