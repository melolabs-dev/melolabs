@@ -0,0 +1,35 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+import { toProblemDetails } from "../../src/utils/internal/problem.ts";
+
+describe("toProblemDetails", () => {
+  it("handles an external HTTPError-shaped object (srvx BodyTooLargeError)", () => {
+    const external = { status: 413, statusText: "Payload Too Large", message: "Body too large" };
+    const json = toProblemDetails(external);
+    expect(json).toMatchObject({
+      status: 413,
+      title: "Payload Too Large",
+      detail: "Body too large",
+    });
+    for (const key of ["type", "instance", "data"]) expect(key in json).toBe(false);
+  });
+
+  it("derives the title from the status when statusText is missing", () => {
+    expect(toProblemDetails({ status: 404, message: "x" }).title).toBe("Not Found");
+  });
+
+  it("matches HTTPError#toJSON()", () => {
+    const err = new HTTPError({ status: 400, message: "bad", data: { a: 1 }, type: "t" });
+    expect(toProblemDetails(err)).toEqual(err.toJSON());
+  });
+
+  it("hides message, data and body for unhandled errors", () => {
+    const json = toProblemDetails(
+      new HTTPError({ status: 500, message: "secret", unhandled: true, data: 1, body: { a: 1 } }),
+    );
+    expect(JSON.stringify(json)).not.toContain("secret");
+    expect(json).toMatchObject({ message: "HTTPError", detail: "Internal Server Error" });
+    expect("data" in json).toBe(false);
+    expect("a" in json).toBe(false);
+  });
+});
