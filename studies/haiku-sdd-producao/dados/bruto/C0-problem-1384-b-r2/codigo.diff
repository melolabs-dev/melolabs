diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..e96ae91
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,227 @@
+import { H3, HTTPError, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  describe("content-type (RF-01)", () => {
+    it("HTTPError", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(`${PROBLEM};charset=UTF-8`);
+    });
+
+    it("kNotFound (missing route)", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")?.startsWith(PROBLEM)).toBe(true);
+    });
+
+    it("async handler", async () => {
+      t.app.get("/", async () => {
+        await Promise.resolve();
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")?.startsWith(PROBLEM)).toBe(true);
+    });
+
+    it("success responses keep application/json", async () => {
+      t.app.get("/", () => ({ ok: true }));
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+  });
+
+  describe("standard members (RF-02)", () => {
+    it("exact body", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError("Sem permissão", { status: 403 });
+      });
+      const res = await t.fetch("/");
+      expect(await res.text()).toBe(
+        '{"type":"about:blank","title":"Forbidden","status":403,"detail":"Sem permissão","message":"Sem permissão"}',
+      );
+    });
+
+    it("custom statusText becomes title", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 422, statusText: "Custom" });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.title).toBe("Custom");
+      expect(body).not.toHaveProperty("statusText");
+    });
+
+    it("status without phrase omits title", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 499 });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.status).toBe(499);
+      expect(body).not.toHaveProperty("title");
+    });
+  });
+
+  describe("type and instance (RF-03)", () => {
+    it("properties", () => {
+      const a = new HTTPError({ status: 409, type: "https://e.com/t", instance: "/i/1" });
+      expect(a.type).toBe("https://e.com/t");
+      expect(a.instance).toBe("/i/1");
+      const b = HTTPError.status(409, undefined, { type: "t", instance: "i" });
+      expect(b.type).toBe("t");
+      expect(b.instance).toBe("i");
+      const c = new HTTPError({ status: 409 });
+      expect(c.type).toBeUndefined();
+      expect(c.instance).toBeUndefined();
+    });
+
+    it("rendered in body; instance omitted when absent", async () => {
+      t.app.get("/a", () => {
+        throw HTTPError.status(409, undefined, { type: "https://e.com/t", instance: "/i/1" });
+      });
+      t.app.get("/b", () => {
+        throw new HTTPError({ status: 409 });
+      });
+      const a = await (await t.fetch("/a")).json();
+      expect(a).toMatchObject({ type: "https://e.com/t", instance: "/i/1", status: 409 });
+      const b = await (await t.fetch("/b")).json();
+      expect(b.type).toBe("about:blank");
+      expect(b).not.toHaveProperty("instance");
+    });
+
+    it("toJSON is unchanged", () => {
+      const e = new HTTPError({ status: 409, type: "t", instance: "i" });
+      expect(e.toJSON()).not.toHaveProperty("type");
+      expect(e.toJSON()).not.toHaveProperty("instance");
+    });
+  });
+
+  describe("unhandled (RF-04)", () => {
+    it("generic Error does not leak", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("segredo interno");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(text).not.toContain("segredo interno");
+      expect(text).not.toContain("stack");
+      expect(JSON.parse(text)).toMatchObject({ type: "about:blank", status: 500 });
+      expect(JSON.parse(text)).not.toHaveProperty("data");
+    });
+
+    it("unhandled HTTPError hides type/instance/data/body", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          type: "https://e.com/t",
+          instance: "/i",
+          data: { s: 1 },
+          body: { extra: 1 },
+          message: "segredo",
+        });
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      const body = JSON.parse(text);
+      expect(text).not.toContain("segredo");
+      expect(body.type).toBe("about:blank");
+      for (const key of ["instance", "data", "extra", "unhandled", "statusText"]) {
+        expect(body).not.toHaveProperty(key);
+      }
+    });
+
+    it("unhandled assigned after construction", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        const error = new HTTPError({
+          status: 500,
+          type: "https://e.com/t",
+          instance: "/i",
+          message: "segredo",
+        });
+        (error as any).unhandled = true;
+        throw error;
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      const body = JSON.parse(text);
+      expect(text).not.toContain("segredo");
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+    });
+  });
+
+  describe("data and body (RF-05)", () => {
+    it("standard members cannot be overridden", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError("falhou", {
+          status: 422,
+          data: { a: 1 },
+          body: { codigo: "E42", status: 200, title: "x", detail: "y", message: "z", data: 0 },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.codigo).toBe("E42");
+      expect(body.data).toEqual({ a: 1 });
+      expect(body.status).toBe(422);
+      expect(body.title).toBe("Unprocessable Content");
+      expect(body.detail).toBe("falhou");
+      expect(body.message).toBe(body.detail);
+    });
+  });
+
+  describe("headers and debug (RF-06)", () => {
+    it("preserves headers and renders stack in debug", async () => {
+      const app = new H3({ debug: true });
+      app.get("/", () => {
+        throw new HTTPError({ status: 401, headers: { "www-authenticate": "Basic" } });
+      });
+      const res = await app.request("/");
+      expect(res.status).toBe(401);
+      expect(res.headers.get("www-authenticate")).toBe("Basic");
+      expect(res.headers.get("content-type")?.startsWith(PROBLEM)).toBe(true);
+      const text = await res.text();
+      expect(text).toContain('\n  "status": 401');
+      expect(JSON.parse(text).stack).toBeInstanceOf(Array);
+    });
+
+    it("explicit content-type wins", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, headers: { "content-type": "application/json" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json");
+    });
+
+    it("merges errHeaders", async () => {
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("x-error", "prepared");
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("x-error")).toBe("prepared");
+      expect(res.headers.get("content-type")?.startsWith(PROBLEM)).toBe(true);
+    });
+
+    it("HEAD keeps content-type with empty body", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.headers.get("content-type")?.startsWith(PROBLEM)).toBe(true);
+      expect(await res.text()).toBe("");
+    });
+  });
+});
