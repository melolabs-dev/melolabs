+++ b/test/unit/status-text.test.ts
@@ -0,0 +1,14 @@
+import { describe, it, expect } from "vitest";
+import { getStatusPhrase } from "../../src/utils/internal/status-text.ts";
+
+describe("getStatusPhrase", () => {
+  it("returns known phrases", () => {
+    expect(getStatusPhrase(404)).toBe("Not Found");
+    expect(getStatusPhrase(418)).toBe("I'm a Teapot");
+    expect(getStatusPhrase(500)).toBe("Internal Server Error");
+  });
+
+  it("falls back to Error", () => {
+    expect(getStatusPhrase(599)).toBe("Error");
+  });
+});
