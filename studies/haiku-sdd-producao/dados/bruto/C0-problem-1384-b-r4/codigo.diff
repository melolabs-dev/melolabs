diff --git a/test/unit/problem.test.ts b/test/unit/problem.test.ts
new file mode 100644
index 0000000..3192f32
--- /dev/null
+++ b/test/unit/problem.test.ts
@@ -0,0 +1,58 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+import { problemDetails } from "../../src/utils/internal/problem.ts";
+
+describe("problemDetails", () => {
+  it("orders keys: type, title, status, detail, instance, data, extensions", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://example.com/probs/x",
+      instance: "/c/12",
+      data: { a: 1 },
+      body: { code: "E" },
+    });
+    expect(Object.keys(problemDetails(error))).toEqual([
+      "type",
+      "title",
+      "status",
+      "detail",
+      "instance",
+      "data",
+      "code",
+    ]);
+    expect(JSON.stringify(error)).toBe(
+      '{"type":"https://example.com/probs/x","title":"Forbidden","status":403,"detail":"HTTPError 403","instance":"/c/12","data":{"a":1},"code":"E"}',
+    );
+  });
+
+  it("omits title for a status without a standard phrase", () => {
+    const json = new HTTPError({ status: 299, message: "custom" }).toJSON();
+    expect(json).toEqual({ status: 299, detail: "custom" });
+  });
+
+  it("body.data wins over data", () => {
+    const json = new HTTPError({ status: 400, data: 1, body: { data: 2 } }).toJSON();
+    expect(json.data).toBe(2);
+  });
+
+  it("unhandled only has status and title", () => {
+    const json = new HTTPError({
+      status: 500,
+      statusText: "Leaky",
+      unhandled: true,
+      type: "t",
+      instance: "i",
+      data: 1,
+      body: { x: 1 },
+    }).toJSON();
+    expect(json).toEqual({ status: 500, title: "Internal Server Error" });
+  });
+
+  it("matches the documented examples", () => {
+    expect(
+      JSON.stringify(
+        new HTTPError({ status: 404, statusText: "Not Found", message: "Usuário 42 não existe" }),
+      ),
+    ).toBe('{"title":"Not Found","status":404,"detail":"Usuário 42 não existe"}');
+  });
+});
