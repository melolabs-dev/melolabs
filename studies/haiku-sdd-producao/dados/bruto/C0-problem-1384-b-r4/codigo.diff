diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..4d831d0
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,287 @@
+import { H3, HTTPError, bodyLimit, readBody, readValidatedBody } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json;charset=UTF-8";
+
+describeMatrix(
+  "problem details",
+  (t, { it, expect, describe }) => {
+    describe("RF-01 content-type", () => {
+      it("uses application/problem+json with a valid JSON body", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, message: "ruim" });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(400);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(await res.json()).toMatchObject({ status: 400, detail: "ruim" });
+      });
+    });
+
+    describe("RF-02 standard members", () => {
+      it("maps statusText to title and message to detail", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 404,
+            statusText: "Not Found",
+            message: "Usuário 42 não existe",
+          });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body).toEqual({
+          title: "Not Found",
+          status: 404,
+          detail: "Usuário 42 não existe",
+        });
+        expect(body).not.toHaveProperty("type");
+        expect(body).not.toHaveProperty("message");
+        expect(body).not.toHaveProperty("statusText");
+        expect(body).not.toHaveProperty("unhandled");
+      });
+
+      it("falls back to the standard phrase for title", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 403, message: "nope" });
+        });
+        expect(await (await t.fetch("/")).json()).toMatchObject({
+          title: "Forbidden",
+          status: 403,
+          detail: "nope",
+        });
+      });
+
+      it("omits detail when message equals title", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 422, statusText: "Unprocessable" });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body).toEqual({ title: "Unprocessable", status: 422 });
+      });
+    });
+
+    describe("RF-03 type and instance", () => {
+      const type = "https://example.com/probs/sem-permissao";
+      const instance = "/contas/12/saques/7";
+
+      it("exposes them on the instance and in the body", async () => {
+        const error = new HTTPError({ status: 403, type, instance });
+        expect(error.type).toBe(type);
+        expect(error.instance).toBe(instance);
+        t.app.get("/", () => {
+          throw error;
+        });
+        expect(await (await t.fetch("/")).json()).toMatchObject({ type, instance, status: 403 });
+      });
+
+      it("is undefined when not provided", () => {
+        const error = new HTTPError({ status: 400 });
+        expect(error.type).toBeUndefined();
+        expect(error.instance).toBeUndefined();
+      });
+
+      it("reads them from cause", () => {
+        const error = new HTTPError({ cause: { status: 409, type, instance } });
+        expect(error.type).toBe(type);
+        expect(error.instance).toBe(instance);
+      });
+
+      it("ignores non string values", () => {
+        const error = new HTTPError({ cause: { status: 409, type: 42, instance: {} } });
+        expect(error.type).toBeUndefined();
+        expect(error.instance).toBeUndefined();
+        expect(error.toJSON()).not.toHaveProperty("type");
+        expect(error.toJSON()).not.toHaveProperty("instance");
+      });
+    });
+
+    describe("RF-04 extensions", () => {
+      it("keeps data and body", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 422,
+            data: { campo: "email" },
+            body: { code: "E_VALID" },
+          });
+        });
+        expect(await (await t.fetch("/")).json()).toMatchObject({
+          status: 422,
+          title: "Unprocessable Content",
+          data: { campo: "email" },
+          code: "E_VALID",
+        });
+      });
+
+      it("instance members win over body members", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 400,
+            statusText: "Bad Request",
+            type: "urn:real",
+            body: { title: "forged", type: "urn:forged", status: 200, extra: 1 },
+          });
+        });
+        expect(await (await t.fetch("/")).json()).toMatchObject({
+          title: "Bad Request",
+          type: "urn:real",
+          status: 400,
+          extra: 1,
+        });
+      });
+
+      it("body.type survives when the instance has no type", () => {
+        const json = new HTTPError({ status: 400, body: { type: "urn:user" } }).toJSON();
+        expect(json.type).toBe("urn:user");
+      });
+    });
+
+    describe("RF-05 unhandled errors do not leak", () => {
+      it("plain Error", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new Error("senha do banco: x");
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        const text = await res.text();
+        expect(text).not.toContain("senha do banco");
+        expect(JSON.parse(text)).toMatchObject({ status: 500, title: "Internal Server Error" });
+        expect(JSON.parse(text)).not.toHaveProperty("detail");
+        expect(t.errors[0].unhandled).toBe(true);
+        t.errors = [];
+      });
+
+      it("unhandled HTTPError with every member set", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 500,
+            statusText: "Leaky",
+            message: "senha do banco: x",
+            unhandled: true,
+            type: "urn:leak",
+            instance: "/leak",
+            data: { leak: 1 },
+            body: { leak: 2 },
+          });
+        });
+        const res = await t.fetch("/");
+        const text = await res.text();
+        expect(text).not.toMatch(/senha|Leaky|leak/);
+        expect(JSON.parse(text)).toMatchObject({ status: 500, title: "Internal Server Error" });
+        expect(Object.keys(JSON.parse(text)).sort()).toEqual(["status", "title"]);
+        t.errors = [];
+      });
+    });
+
+    describe("RF-06 debug and headers", () => {
+      it("keeps stack and error headers in debug mode", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 500, headers: { "x-trace": "abc" } });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("x-trace")).toBe("abc");
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        const body = await res.json();
+        expect(Array.isArray(body.stack)).toBe(true);
+        expect(body.stack.every((l: unknown) => typeof l === "string")).toBe(true);
+      });
+
+      it("omits stack without debug", async () => {
+        const app = new H3({ silent: true });
+        app.get("/", () => {
+          throw new HTTPError({ status: 500 });
+        });
+        const body = await (await app.request("/")).json();
+        expect(body).not.toHaveProperty("stack");
+      });
+
+      it("content-type from error.headers prevails", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, headers: { "content-type": "application/json" } });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("application/json");
+      });
+    });
+
+    describe("RF-07 all error paths", () => {
+      it("unknown route", async () => {
+        const res = await t.fetch("/nada");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(await res.json()).toMatchObject({
+          status: 404,
+          title: "Not Found",
+          detail: expect.stringContaining("Cannot find any route matching"),
+        });
+      });
+
+      it("throw number", async () => {
+        t.app.get("/", () => {
+          throw 404;
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(await res.json()).toMatchObject({ status: 404, title: "Not Found" });
+      });
+
+      it("validation error", async () => {
+        t.app.post("/", (event) =>
+          readValidatedBody(event, () => {
+            throw new Error("invalid");
+          }),
+        );
+        const res = await t.fetch("/", { method: "POST", body: "{}" });
+        expect(res.status).toBe(400);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(await res.json()).toMatchObject({ status: 400, title: "Validation failed" });
+      });
+
+      it("body limit", async () => {
+        t.app.post("/", (event) => readBody(event), { middleware: [bodyLimit(4)] });
+        const res = await t.fetch("/", { method: "POST", body: "too long body" });
+        expect(res.status).toBe(413);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(await res.json()).toMatchObject({ status: 413 });
+      });
+
+      it("onError returning an HTTPError", async () => {
+        t.app.config.onError = () => new HTTPError({ status: 418, message: "short and stout" });
+        t.app.get("/", () => {
+          throw new Error("boom");
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(418);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(await res.json()).toMatchObject({
+          status: 418,
+          title: "I'm a Teapot",
+          detail: "short and stout",
+        });
+      });
+
+      it("onError returning its own Response is untouched", async () => {
+        t.app.config.onError = () =>
+          Response.json({ custom: true }, { status: 400 }) as unknown as undefined;
+        t.app.get("/", () => {
+          throw new Error("boom");
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(400);
+        expect(res.headers.get("content-type")).toMatch(/^application\/json/);
+        expect(await res.json()).toEqual({ custom: true });
+      });
+
+      it("successful JSON responses keep application/json", async () => {
+        t.app.get("/", () => ({ ok: true }));
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      });
+    });
+  },
+  { allowUnhandledErrors: true },
+);
