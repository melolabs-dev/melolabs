diff --git a/test/unit/status-text.test.ts b/test/unit/status-text.test.ts
new file mode 100644
index 0000000..5f4624b
--- /dev/null
+++ b/test/unit/status-text.test.ts
@@ -0,0 +1,17 @@
+import { describe, it, expect } from "vitest";
+import { getStatusText } from "../../src/utils/internal/status-text.ts";
+
+describe("getStatusText", () => {
+  it("returns reason phrases for common codes", () => {
+    expect(getStatusText(200)).toBe("OK");
+    expect(getStatusText(404)).toBe("Not Found");
+    expect(getStatusText(413)).toBe("Content Too Large");
+    expect(getStatusText(422)).toBe("Unprocessable Content");
+    expect(getStatusText(500)).toBe("Internal Server Error");
+  });
+
+  it("returns undefined for unknown codes", () => {
+    expect(getStatusText(599)).toBeUndefined();
+    expect(getStatusText(0)).toBeUndefined();
+  });
+});
