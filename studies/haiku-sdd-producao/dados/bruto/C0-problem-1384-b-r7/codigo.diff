diff --git a/test/unit/problem-details.test.ts b/test/unit/problem-details.test.ts
new file mode 100644
index 0000000..b80f83a
--- /dev/null
+++ b/test/unit/problem-details.test.ts
@@ -0,0 +1,105 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+import { statusPhrase } from "../../src/utils/internal/status-phrase.ts";
+
+describe("statusPhrase", () => {
+  it("RF-02: returns the standard phrase", () => {
+    expect(statusPhrase(404)).toBe("Not Found");
+    expect(statusPhrase(500)).toBe("Internal Server Error");
+    expect(statusPhrase(511)).toBe("Network Authentication Required");
+  });
+
+  it("RF-02: returns undefined for unknown codes", () => {
+    expect(statusPhrase(599)).toBeUndefined();
+    expect(statusPhrase(200)).toBeUndefined();
+  });
+});
+
+describe("HTTPError problem details", () => {
+  it("RF-02: standard members", () => {
+    const json = new HTTPError({
+      status: 404,
+      statusText: "Not Found",
+      message: "Usuário 42 não existe",
+    }).toJSON();
+    expect(json).toMatchObject({
+      type: "about:blank",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário 42 não existe",
+    });
+  });
+
+  it("RF-02: title falls back to the status phrase, omitted when unknown", () => {
+    expect(new HTTPError({ status: 404 }).toJSON().title).toBe("Not Found");
+    expect(new HTTPError({ status: 599 }).toJSON().title).toBeUndefined();
+  });
+
+  it("RF-03: type and instance on the instance and body", () => {
+    const type = "https://example.com/probs/sem-saldo";
+    const instance = "/contas/12/saques/7";
+    const error = new HTTPError({ status: 403, type, instance });
+    expect(error.type).toBe(type);
+    expect(error.instance).toBe(instance);
+    expect(error.toJSON()).toMatchObject({ type, instance });
+
+    const viaStatus = HTTPError.status(403, undefined, { type, instance });
+    expect(viaStatus.type).toBe(type);
+    expect(viaStatus.instance).toBe(instance);
+  });
+
+  it("RF-03: read from cause, ignoring non-string values", () => {
+    const fromCause = new HTTPError({ cause: { status: 400, type: "t", instance: "i" } });
+    expect(fromCause.type).toBe("t");
+    expect(fromCause.instance).toBe("i");
+
+    const bad = new HTTPError({ cause: { status: 400, type: 42, instance: "" } });
+    expect(bad.type).toBeUndefined();
+    expect(bad.instance).toBeUndefined();
+  });
+
+  it("RF-04: defaults", () => {
+    const json = JSON.parse(JSON.stringify(new HTTPError("falhou")));
+    expect(json.type).toBe("about:blank");
+    expect("instance" in json).toBe(false);
+    expect(new HTTPError("x").type).toBeUndefined();
+  });
+
+  it("RF-05: unhandled errors do not leak", () => {
+    const json = JSON.parse(
+      JSON.stringify(
+        new HTTPError({
+          status: 500,
+          unhandled: true,
+          message: "segredo interno",
+          type: "t",
+          instance: "i",
+          data: { a: 1 },
+        }),
+      ),
+    );
+    expect(JSON.stringify(json)).not.toContain("segredo interno");
+    expect(json.type).toBe("about:blank");
+    expect("instance" in json).toBe(false);
+    expect("detail" in json).toBe(false);
+    expect(json.data).toBeUndefined();
+  });
+
+  it("RF-06: body cannot override standard members, but still overrides legacy ones", () => {
+    const json = new HTTPError({
+      status: 422,
+      message: "m",
+      data: { campo: "email" },
+      body: { traceId: "abc", status: 200, type: "x", title: "y", detail: "z", message: "legacy" },
+    }).toJSON();
+    expect(json).toMatchObject({
+      status: 422,
+      type: "about:blank",
+      title: "Unprocessable Content",
+      detail: "m",
+      traceId: "abc",
+      message: "legacy",
+      data: { campo: "email" },
+    });
+  });
+});
