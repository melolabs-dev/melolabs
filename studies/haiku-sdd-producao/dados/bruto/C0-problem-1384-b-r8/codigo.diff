+++ b/test/problem-details.test.ts
@@ -0,0 +1,325 @@
+import { z } from "zod/v4";
+import { createBodyTooLargeError } from "srvx/body-limit";
+import { HTTPError, onError, readValidatedBody, defineHandler } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem details (RFC 9457)", (t, { describe, it, expect }) => {
+  const stripStack = ({ stack: _stack, ...rest }: any) => rest;
+
+  describe("RF-01: content-type", () => {
+    it("uses application/problem+json for errors", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    });
+
+    it("keeps application/json for successful JSON", async () => {
+      t.app.get("/", () => ({ ok: true }));
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+  });
+
+  describe("RF-02: type and instance", () => {
+    it("are exposed on the instance", () => {
+      const error = new HTTPError({
+        status: 403,
+        type: "https://example.com/probs/forbidden",
+        instance: "/contas/12",
+      });
+      expect(error.type).toBe("https://example.com/probs/forbidden");
+      expect(error.instance).toBe("/contas/12");
+    });
+
+    it("are undefined by default", () => {
+      const error = new HTTPError({ status: 403 });
+      expect(error.type).toBeUndefined();
+      expect(error.instance).toBeUndefined();
+    });
+
+    it("work via HTTPError.status and message constructor", () => {
+      expect(HTTPError.status(418, "x", { type: "urn:a", instance: "/i" }).type).toBe("urn:a");
+      expect(HTTPError.status(418, "x", { type: "urn:a", instance: "/i" }).instance).toBe("/i");
+      expect(new HTTPError("msg", { type: "urn:b" }).type).toBe("urn:b");
+    });
+
+    it("are not inherited from cause", () => {
+      const error = new HTTPError({
+        cause: { type: "entity.too.large", instance: "/x" },
+        status: 400,
+      });
+      expect(error.type).toBeUndefined();
+      expect(error.instance).toBeUndefined();
+      const error2 = new HTTPError("m", {
+        cause: Object.assign(new Error("e"), { type: "entity.too.large" }),
+      });
+      expect(error2.type).toBeUndefined();
+    });
+  });
+
+  describe("RF-03: type", () => {
+    it("defaults to about:blank and uses the given URI", async () => {
+      t.app.get("/a", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      t.app.get("/b", () => {
+        throw new HTTPError({ status: 402, type: "https://example.com/probs/out-of-credit" });
+      });
+      expect((await (await t.fetch("/a")).json()).type).toBe("about:blank");
+      expect((await (await t.fetch("/b")).json()).type).toBe(
+        "https://example.com/probs/out-of-credit",
+      );
+    });
+  });
+
+  describe("RF-04: status and title", () => {
+    it("uses standard phrase, custom statusText, and omits unknown", async () => {
+      t.app.get("/a", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      t.app.get("/b", () => {
+        throw new HTTPError({ status: 404, statusText: "Conta inexistente" });
+      });
+      t.app.get("/c", () => {
+        throw new HTTPError({ status: 599, body: { title: "leak" } });
+      });
+      expect(await (await t.fetch("/a")).json()).toMatchObject({
+        status: 404,
+        title: "Not Found",
+      });
+      expect(await (await t.fetch("/b")).json()).toMatchObject({
+        status: 404,
+        title: "Conta inexistente",
+      });
+      const c = await (await t.fetch("/c")).json();
+      expect(c.status).toBe(599);
+      expect("title" in c).toBe(false);
+    });
+  });
+
+  describe("RF-05: detail", () => {
+    it("is present for handled errors and absent for unhandled", async () => {
+      // `debug` would expose the stack (which contains the message)
+      t.app.config.debug = false;
+      t.app.get("/a", () => {
+        throw new HTTPError({ status: 400, message: "E-mail inválido" });
+      });
+      t.app.get("/b", () => {
+        throw new Error("segredo interno");
+      });
+      expect((await (await t.fetch("/a")).json()).detail).toBe("E-mail inválido");
+      const res = await t.fetch("/b");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(text).not.toContain("segredo interno");
+      t.errors = [];
+      expect("detail" in JSON.parse(text)).toBe(false);
+      expect(JSON.parse(text)).toMatchObject({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        message: "HTTPError",
+        unhandled: true,
+      });
+    });
+  });
+
+  describe("RF-06: instance", () => {
+    it("is present or omitted; never exposed when unhandled", async () => {
+      t.app.get("/a", () => {
+        throw new HTTPError({ status: 400, instance: "/pedidos/99" });
+      });
+      t.app.get("/b", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      t.app.get("/c", () => {
+        throw new HTTPError({ status: 500, unhandled: true, instance: "/secret", type: "urn:s" });
+      });
+      expect((await (await t.fetch("/a")).json()).instance).toBe("/pedidos/99");
+      expect("instance" in (await (await t.fetch("/b")).json())).toBe(false);
+      const c = await (await t.fetch("/c")).json();
+      expect("instance" in c).toBe(false);
+      expect(c.type).toBe("about:blank");
+      t.errors = [];
+    });
+  });
+
+  describe("RF-07: compatibility", () => {
+    it("keeps legacy members and extension members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 422,
+          message: "Inválido",
+          data: { campo: "nome" },
+          body: { codigo: "E42" },
+        });
+      });
+      expect(stripStack(await (await t.fetch("/")).json())).toEqual({
+        message: "Inválido",
+        data: { campo: "nome" },
+        codigo: "E42",
+        type: "about:blank",
+        title: "Unprocessable Content",
+        status: 422,
+        detail: "Inválido",
+      });
+    });
+
+    it("body cannot override RFC members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "real",
+          body: { status: 200, title: "x", type: "y", detail: "z", instance: "w" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        status: 400,
+        title: "Bad Request",
+        type: "about:blank",
+        detail: "real",
+      });
+      expect("instance" in body).toBe(false);
+    });
+
+    it("includes stack in debug mode", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      expect(Array.isArray((await (await t.fetch("/")).json()).stack)).toBe(true);
+    });
+  });
+
+  describe("RF-08: all error paths", () => {
+    const expectProblem = async (res: Response, status: number) => {
+      expect(res.status).toBe(status);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      const body = await res.json();
+      expect(body.status).toBe(status);
+      expect(body.type).toBe("about:blank");
+      return body;
+    };
+
+    it("kNotFound / missing route", async () => {
+      const body = await expectProblem(await t.fetch("/x"), 404);
+      expect(body.title).toBe("Not Found");
+      expect(body.detail).toContain("Cannot find any route matching");
+    });
+
+    it("kNotFound returned from handler", async () => {
+      t.app.get("/", () => Symbol.for("h3.notFound"));
+      await expectProblem(await t.fetch("/"), 404);
+    });
+
+    it("throw <number>", async () => {
+      t.app.get("/", () => {
+        throw 404;
+      });
+      await expectProblem(await t.fetch("/"), 404);
+    });
+
+    it("non-HTTP error", async () => {
+      t.app.get("/", () => {
+        throw new Error("boom");
+      });
+      await expectProblem(await t.fetch("/"), 500);
+      t.errors = [];
+    });
+
+    it("error in middleware", async () => {
+      t.app.use(() => {
+        throw new HTTPError({ status: 401 });
+      });
+      await expectProblem(await t.fetch("/"), 401);
+    });
+
+    it("validation error", async () => {
+      t.app.post(
