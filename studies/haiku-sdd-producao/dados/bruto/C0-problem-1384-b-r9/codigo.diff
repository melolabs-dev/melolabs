+import { HTTPError } from "../src/index.ts";
+import { kNotFound } from "../src/response.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json";
+
+describeMatrix(
+  "problem details",
+  (t, { it, expect, describe }) => {
+    describe("RF-01 content-type", () => {
+      it("HTTPError", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400 });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(400);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("unhandled error", async () => {
+        t.app.get("/", () => {
+          throw new Error("boom");
+        });
+        const res = await t.fetch("/");
+        t.errors = [];
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("kNotFound", async () => {
+        t.app.get("/", () => kNotFound);
+        const res = await t.fetch("/");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+    });
+
+    describe("RF-02 standard members", () => {
+      it("maps type, title, status, detail", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 404,
+            statusText: "Not Found",
+            message: "Usuário 42 não existe",
+          });
+        });
+        const res = await t.fetch("/");
+        expect(await res.text()).toBe(
+          '{"status":404,"statusText":"Not Found","message":"Usuário 42 não existe","type":"about:blank","title":"Not Found","detail":"Usuário 42 não existe"}',
+        );
+      });
+
+      it("falls back to the standard phrase for title", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 409 });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body.title).toBe("Conflict");
+      });
+
+      it("omits title for statuses without a phrase", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 299 });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body).not.toHaveProperty("title");
+      });
+    });
+
+    describe("RF-03 type and instance fields", () => {
+      const input = { type: "https://example.com/probs/x", instance: "/pedidos/7" };
+
+      it("new HTTPError(details)", () => {
+        const error = new HTTPError({ status: 409, ...input });
+        expect(error.type).toBe(input.type);
+        expect(error.instance).toBe(input.instance);
+      });
+
+      it("new HTTPError(message, details)", () => {
+        const error = new HTTPError("msg", { status: 409, ...input });
+        expect(error.type).toBe(input.type);
+        expect(error.instance).toBe(input.instance);
+      });
+
+      it("HTTPError.status()", () => {
+        const error = HTTPError.status(409, "Conflict", input);
+        expect(error.type).toBe(input.type);
+        expect(error.instance).toBe(input.instance);
+      });
+
+      it("defaults to undefined and ignores non-strings", () => {
+        const empty = new HTTPError({ status: 409 });
+        expect(empty.type).toBeUndefined();
+        expect(empty.instance).toBeUndefined();
+        const bad = new HTTPError({ status: 409, type: 1, instance: {} } as any);
+        expect(bad.type).toBeUndefined();
+        expect(bad.instance).toBeUndefined();
+      });
+    });
+
+    describe("RF-04 type and instance in response", () => {
+      it("uses given values", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 409,
+            type: "https://example.com/probs/conflito",
+            instance: "/pedidos/7",
+          });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body.type).toBe("https://example.com/probs/conflito");
+        expect(body.instance).toBe("/pedidos/7");
+      });
+
+      it("omits instance when absent", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 409 });
+        });
+        const body = await (await t.fetch("/")).json();
+        expect(body.type).toBe("about:blank");
+        expect(body).not.toHaveProperty("instance");
+      });
+    });
+
+    describe("RF-05 extensions", () => {
+      it("keeps extensions but standard members win", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 422,
+            data: { campo: "x" },
+            body: { code: "E_PAGAMENTO", status: 999, type: "x", title: "y" },
+          });
+        });
+        const res = await t.fetch("/");
+        const body = await res.json();
+        expect(res.status).toBe(422);
+        expect(body.code).toBe("E_PAGAMENTO");
+        expect(body.data).toEqual({ campo: "x" });
+        expect(body.status).toBe(422);
+        expect(body.type).toBe("about:blank");
+        expect(body.title).toBe("Unprocessable Content");
+      });
+    });
+
+    describe("RF-06 legacy fields", () => {
+      it("keeps legacy and new members", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, statusText: "Bad Request", message: "inválido" });
+        });
+        expect(await (await t.fetch("/")).json()).toMatchObject({
+          status: 400,
+          statusText: "Bad Request",
+          message: "inválido",
+          type: "about:blank",
+          title: "Bad Request",
+          detail: "inválido",
+        });
+      });
+
+      it("toJSON() keys", () => {
+        const json = new HTTPError({
+          status: 400,
+          statusText: "Bad Request",
+          message: "x",
+        }).toJSON();
+        expect(JSON.parse(JSON.stringify(json))).toEqual({
+          status: 400,
+          statusText: "Bad Request",
+          message: "x",
+          type: "about:blank",
+          title: "Bad Request",
+          detail: "x",
+        });
+        expect(Object.keys(json)).toEqual(
+          expect.arrayContaining(["status", "statusText", "unhandled", "message", "data"]),
+        );
+      });
+    });
+
+    describe("RF-07 unhandled errors", () => {
+      it("does not leak internals", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new Error("segredo interno");
+        });
+        const res = await t.fetch("/");
+        t.errors = [];
+        const text = await res.text();
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+        expect(text).not.toContain("segredo interno");
+        expect(JSON.parse(text)).not.toHaveProperty("stack");
+      });
+
+      it("ignores type and instance from library errors", async () => {
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw Object.assign(new Error("too large"), {
+            type: "entity.too.large",
+            instance: "/internal",
+          });
+        });
+        const body = await (await t.fetch("/")).json();
+        t.errors = [];
+        expect(body.type).toBe("about:blank");
+        expect(body).not.toHaveProperty("instance");
+      });
+
+      it("hides everything on an unhandled HTTPError", () => {
+        const json = new HTTPError({
+          status: 500,
+          unhandled: true,
+          type: "https://x/y",
+          instance: "/z",
+          message: "secret",
+          data: { a: 1 },
+          body: { b: 2 },
+        }).toJSON();
+        expect(JSON.parse(JSON.stringify(json))).toEqual({
+          status: 500,
+          message: "HTTPError",
+          unhandled: true,
+          type: "about:blank",
+          title: "Internal Server Error",
+          detail: "HTTPError",
+        });
+      });
+
+      it("exposes stack in debug mode", async () => {
+        t.app.config.debug = true;
+        t.app.get("/", () => {
+          throw new Error("boom");
+        });
+        const body = await (await t.fetch("/")).json();
+        t.errors = [];
+        expect(body.stack).toBeInstanceOf(Array);
+      });
+    });
+
+    describe("RF-08 headers and bodies", () => {
+      it("preserves headers and statusText", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 418, statusText: "Teapot", headers: { "x-custom": "1" } });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(418);
+        expect(res.statusText).toBe("Teapot");
+        expect(res.headers.get("x-custom")).toBe("1");
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
+      });
+
+      it("HEAD has empty body", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400 });
+        });
+        const res = await t.fetch("/", { method: "HEAD" });
+        expect(res.status).toBe(400);
+        expect(res.headers.get("content-type")).toBe(PROBLEM);
