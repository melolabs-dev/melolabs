+import { vi } from "vitest";
+import { HTTPError, onError, problem } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix(
+  "problem",
+  (t, { it, expect, describe }) => {
+    const noDebug = () => {
+      t.app.config.debug = false;
+    };
+
+    it("returns an HTTPError (thrown and returned)", async () => {
+      const err = problem({ status: 404 });
+      expect(err).toBeInstanceOf(HTTPError);
+      expect(HTTPError.isError(err)).toBe(true);
+
+      t.app.get("/throw", () => {
+        throw problem({ status: 404 });
+      });
+      t.app.get("/return", () => problem({ status: 404 }));
+      for (const path of ["/throw", "/return"]) {
+        const res = await t.fetch(path);
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      }
+    });
+
+    it("serializes the full RFC 9457 body", async () => {
+      noDebug();
+      t.app.get("/", () => {
+        throw problem({
+          status: 404,
+          statusText: "Não encontrado",
+          message: "Usuário 42 não existe",
+          type: "https://exemplo.com/erros/nao-encontrado",
+          instance: "/usuarios/42",
+          body: { traceId: "abc" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(await res.json()).toEqual({
+        type: "https://exemplo.com/erros/nao-encontrado",
+        title: "Não encontrado",
+        status: 404,
+        detail: "Usuário 42 não existe",
+        instance: "/usuarios/42",
+        traceId: "abc",
+      });
+    });
+
+    it("puts data under `data`", async () => {
+      noDebug();
+      t.app.get("/", () => {
+        throw problem({ status: 400, data: { a: 1 } });
+      });
+      expect(await (await t.fetch("/")).json()).toEqual({
+        type: "about:blank",
+        title: "Bad Request",
+        status: 400,
+        data: { a: 1 },
+      });
+    });
+
+    it("keeps headers and status; caller content-type wins", async () => {
+      t.app.get("/a", () => {
+        throw problem({ status: 422, headers: { "x-request-id": "r1" } });
+      });
+      t.app.get("/b", () => {
+        throw problem({ status: 422, headers: { "content-type": "application/x-custom" } });
+      });
+      const a = await t.fetch("/a");
+      expect(a.status).toBe(422);
+      expect(a.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(a.headers.get("x-request-id")).toBe("r1");
+      expect((await a.json()).status).toBe(422);
+
+      const b = await t.fetch("/b");
+      expect(b.headers.get("content-type")).toBe("application/x-custom");
+    });
+
+    describe("defaults", () => {
+      it("problem() and problem({}) are 500 about:blank", async () => {
+        noDebug();
+        t.app.get("/a", () => {
+          throw problem();
+        });
+        t.app.get("/b", () => {
+          throw problem({});
+        });
+        for (const path of ["/a", "/b"]) {
+          const res = await t.fetch(path);
+          expect(res.status).toBe(500);
+          expect(await res.json()).toEqual({
+            type: "about:blank",
+            title: "Internal Server Error",
+            status: 500,
+          });
+        }
+      });
+
+      it("derives title from status, with a fallback", async () => {
+        noDebug();
+        t.app.get("/a", () => {
+          throw problem({ status: 404 });
+        });
+        t.app.get("/b", () => {
+          throw problem({ status: 599 });
+        });
+        expect((await (await t.fetch("/a")).json()).title).toBe("Not Found");
+        expect((await (await t.fetch("/b")).json()).title).toBe("Unknown Error");
+      });
+
+      it("omits detail without an explicit message", async () => {
+        noDebug();
+        t.app.get("/", () => {
+          throw problem({ status: 500 });
+        });
+        const json = await (await t.fetch("/")).json();
+        expect(json).not.toHaveProperty("detail");
+        expect(JSON.stringify(json)).not.toContain("HTTPError");
+      });
+
+      it("standard members win on key collisions", async () => {
+        noDebug();
+        t.app.get("/", () => {
+          throw problem({ status: 400, body: { status: 1, title: "x", type: "y", detail: "z" } });
+        });
+        expect(await (await t.fetch("/")).json()).toEqual({
+          type: "about:blank",
+          title: "Bad Request",
+          status: 400,
+        });
+      });
+    });
+
+    describe("unhandled", () => {
+      it("hides detail, data, extensions and instance", async () => {
+        noDebug();
+        t.app.get("/", () => {
+          throw problem({
+            unhandled: true,
+            message: "segredo",
+            data: { s: 1 },
+            body: { x: 1 },
+            instance: "/i",
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(500);
+        const text = await res.text();
+        expect(JSON.parse(text)).toEqual({
+          type: "about:blank",
+          title: "Internal Server Error",
+          status: 500,
+        });
+        expect(text).not.toContain("segredo");
+      });
+    });
+
+    describe("plain HTTPError is unchanged", () => {
+      it("keeps application/json and toJSON", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, message: "ruim", data: { a: 1 } });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        expect(await res.json()).toMatchObject({ status: 400, message: "ruim", data: { a: 1 } });
+      });
+
+      it("toJSON equals an equivalent HTTPError", () => {
+        const input = { status: 400, message: "ruim", data: { a: 1 }, body: { k: 1 } };
+        expect(problem({ ...input, type: "t", instance: "i" }).toJSON()).toEqual(
+          new HTTPError(input).toJSON(),
+        );
+        expect(Object.keys(problem(input))).toEqual(Object.keys(new HTTPError(input)));
+      });
+    });
+
+    describe("hooks and flow", () => {
+      it("global onError middleware receives the instance", async () => {
+        const seen = vi.fn();
+        t.app.use(onError((error) => void seen(error)));
+        t.app.get("/", async () => {
+          throw problem({ status: 409 });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(409);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+        expect(seen).toHaveBeenCalledTimes(1);
+        expect(seen.mock.calls[0]![0]).toBeInstanceOf(HTTPError);
+      });
+
+      it("config.onError receives the instance", async () => {
+        t.app.get("/", () => {
+          throw problem({ status: 409 });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(409);
+        expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+        expect(t.hooks.onError.mock.calls[0]![0]).toBeInstanceOf(HTTPError);
+      });
+
+      it("middleware throwing problem()", async () => {
+        t.app.use(() => {
+          throw problem({ status: 409 });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(409);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      });
+
+      it("onError returning a Response replaces the result", async () => {
+        t.app.config.onError = () => new Response("custom", { status: 418 });
+        t.app.get("/", () => {
+          throw problem({ status: 409 });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(418);
+        expect(await res.text()).toBe("custom");
+      });
+    });
+
+    it("HEAD has no body", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 404 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(await res.text()).toBe("");
+    });
+
+    it("debug exposes stack and indents", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 404 });
+      });
+      const text = await (await t.fetch("/")).text();
+      expect(text).toContain('\n  "type"');
+      expect(JSON.parse(text).stack).toBeInstanceOf(Array);
+    });
+  },
+  { allowUnhandledErrors: true },
+);
