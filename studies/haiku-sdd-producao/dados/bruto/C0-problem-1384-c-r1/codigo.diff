diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..0099792
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,35 @@
+import type { HTTPError } from "../../error.ts";
+
+export const kProblem = "~problem";
+
+/** Value of the `~problem` property: base headers and body serializer for `errorResponse`. */
+export interface ProblemMarker {
+  headers: Headers;
+  body: (error: HTTPError, debug?: boolean) => Record<string, unknown>;
+}
+
+export interface ProblemMeta {
+  type: string;
+  title: string;
+  detail?: string;
+  instance?: string;
+}
+
+export function problemBody(
+  error: HTTPError,
+  meta: ProblemMeta,
+  debug?: boolean,
+): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  return {
+    // Extensions first so the standard members below win on key collisions
+    ...(unhandled ? undefined : error.body),
+    data: unhandled ? undefined : error.data,
+    stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
+    type: meta.type,
+    title: meta.title,
+    status: error.status,
+    detail: unhandled ? undefined : meta.detail,
+    instance: unhandled ? undefined : meta.instance,
+  };
+}
