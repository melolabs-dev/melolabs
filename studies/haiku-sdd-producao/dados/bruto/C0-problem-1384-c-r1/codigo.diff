index 0000000..03ed946
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,48 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { kProblem, problemBody, type ProblemMarker, type ProblemMeta } from "./internal/problem.ts";
+import { getStatusText } from "./internal/status-text.ts";
+
+const problemHeaders = /* @__PURE__ */ new Headers({
+  "content-type": "application/problem+json;charset=UTF-8",
+});
+
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /**
+   * URI reference that identifies the problem type (default: `"about:blank"`).
+   */
+  type?: string;
+
+  /**
+   * URI reference that identifies this specific occurrence of the problem.
+   */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is sent as an RFC 9457 `application/problem+json` response.
+ *
+ * @example
+ *
+ * throw problem({ status: 404, message: "User 42 not found", instance: "/users/42" });
+ */
+export function problem<DataT = unknown>(input?: ProblemInput<DataT>): HTTPError<DataT> {
+  const error = new HTTPError<DataT>((input || {}) as ErrorInput<DataT>);
+
+  // Raw input: `HTTPError` sanitizes `statusText` and synthesizes `message`
+  const rawTitle = (input?.statusText ?? input?.statusMessage)?.trim();
+  const meta: ProblemMeta = {
+    type: input?.type || "about:blank",
+    title: rawTitle || getStatusText(error.status) || "Unknown Error",
+    detail: typeof input?.message === "string" && input.message ? input.message : undefined,
+    instance: input?.instance || undefined,
+  };
+
+  Object.defineProperty(error, kProblem, {
+    value: {
+      headers: problemHeaders,
+      body: (e, debug) => problemBody(e, meta, debug),
+    } satisfies ProblemMarker,
+    enumerable: false,
+  });
+  return error;
+}
