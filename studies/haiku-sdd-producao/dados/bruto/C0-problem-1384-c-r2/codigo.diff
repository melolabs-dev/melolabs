diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..fe16574
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,253 @@
+import { HTTPError, problem, type ProblemInput } from "../src/index.ts";
+import { beforeEach } from "vitest";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  describe("creation", () => {
+    it("returns an HTTPError", () => {
+      const error = problem({ status: 404 });
+      expect(error).toBeInstanceOf(HTTPError);
+      expect(error.status).toBe(404);
+      expect(HTTPError.isError(error)).toBe(true);
+    });
+
+    it("preserves error input fields", () => {
+      const input: ProblemInput<{ a: number }> = {
+        status: 400,
+        message: "x",
+        type: "https://ex.com/erros/invalido",
+        instance: "/pedidos/42",
+        data: { a: 1 },
+        headers: { "x-a": "1" },
+      };
+      const error = problem(input);
+      expect(error.status).toBe(400);
+      expect(error.message).toBe("x");
+      expect(error.data).toEqual({ a: 1 });
+      expect(error.headers?.get("x-a")).toBe("1");
+      expect(Object.keys(error)).not.toContain("~problem");
+    });
+  });
+
+  describe("response", () => {
+    beforeEach(() => {
+      t.app.config.debug = false;
+    });
+
+    it("serializes RFC 9457 members", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 404,
+          message: "Pedido não encontrado",
+          type: "https://ex.com/erros/nao-encontrado",
+          instance: "/pedidos/42",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(await res.json()).toEqual({
+        type: "https://ex.com/erros/nao-encontrado",
+        title: "Not Found",
+        status: 404,
+        detail: "Pedido não encontrado",
+        instance: "/pedidos/42",
+      });
+      t.errors = [];
+    });
+
+    it("defaults type, title and omits detail/instance", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 404 });
+      });
+      expect(await (await t.fetch("/")).json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+      });
+      t.errors = [];
+    });
+
+    it("uses statusText as title and omits title for unknown status", async () => {
+      t.app.get("/a", () => {
+        throw problem({ status: 400, statusText: "Custom" });
+      });
+      t.app.get("/b", () => {
+        throw problem({ status: 599 });
+      });
+      expect((await (await t.fetch("/a")).json()).title).toBe("Custom");
+      expect(await (await t.fetch("/b")).json()).toEqual({ type: "about:blank", status: 599 });
+      t.errors = [];
+    });
+
+    it("applies custom headers, which can override content-type", async () => {
+      t.app.get("/a", () => {
+        throw problem({ status: 400, headers: { "x-id": "1" } });
+      });
+      t.app.get("/b", () => {
+        throw problem({ status: 400, headers: { "content-type": "text/plain" } });
+      });
+      const a = await t.fetch("/a");
+      expect(a.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(a.headers.get("x-id")).toBe("1");
+      expect((await t.fetch("/b")).headers.get("content-type")).toBe("text/plain");
+      t.errors = [];
+    });
+
+    it("emits extensions and data without overriding standard members", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 422,
+          body: { balance: 30, accounts: ["/a/1"], status: 1, type: "x" },
+          data: { campo: "x" },
+        });
+      });
+      const json = await (await t.fetch("/")).json();
+      expect(json).toMatchObject({
+        type: "about:blank",
+        status: 422,
+        balance: 30,
+        accounts: ["/a/1"],
+        data: { campo: "x" },
+      });
+      t.errors = [];
+    });
+
+    it("does not leak unhandled errors", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw problem({ status: 500, message: "segredo", data: { s: 1 }, unhandled: true });
+      });
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(text).not.toContain("segredo");
+      expect(text).not.toContain('"data"');
+      expect(text).not.toContain("stack");
+      t.errors = [];
+    });
+
+    it("includes stack in debug", async () => {
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw problem({ status: 500, unhandled: true });
+      });
+      expect((await (await t.fetch("/")).json()).stack).toBeDefined();
+      t.errors = [];
+    });
+  });
+
+  describe("regressions", () => {
+    it("keeps the JSON format for regular errors", async () => {
+      t.app.config.debug = false;
+      t.app.get("/new", () => {
+        throw new HTTPError({ status: 400, message: "ruim" });
+      });
+      t.app.get("/status", () => {
+        throw HTTPError.status(404, "Nope");
+      });
+      t.app.get("/unknown", () => {
+        throw new Error("boom");
+      });
+      const cases: [string, number][] = [
+        ["/new", 400],
+        ["/status", 404],
+        ["/unknown", 500],
+        ["/missing", 404],
+      ];
+      for (const [path, status] of cases) {
+        const res = await t.fetch(path);
+        expect(res.status).toBe(status);
+        expect(res.headers.get("content-type")).toMatch(/^application\/json/);
+        const json = await res.json();
+        for (const key of ["type", "title", "detail"]) {
+          expect(json).not.toHaveProperty(key);
+        }
+        expect(json.status).toBe(status);
+      }
+      const json = await (await t.fetch("/new")).json();
+      expect(json).toMatchObject({ status: 400, message: "ruim" });
+      t.errors = [];
+    });
+  });
+
+  describe("propagation", () => {
+    const expectProblem = async (res: Response, status: number) => {
+      expect(res.status).toBe(status);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect((await res.json()).status).toBe(status);
+    };
+
+    it("direct, middleware and async throws", async () => {
+      t.app.use("/mw", () => {
+        throw problem({ status: 401 });
+      });
+      t.app.get("/mw", () => "ok");
+      t.app.get("/sync", () => {
+        throw problem({ status: 400 });
+      });
+      t.app.get("/async", async () => {
+        await Promise.resolve();
+        throw problem({ status: 409 });
+      });
+      await expectProblem(await t.fetch("/sync"), 400);
+      await expectProblem(await t.fetch("/mw"), 401);
+      await expectProblem(await t.fetch("/async"), 409);
+      t.errors = [];
+    });
+
+    it("keeps the format when onError returns undefined", async () => {
+      t.app.config.onError = () => undefined;
+      t.app.get("/", () => {
+        throw problem({ status: 400 });
+      });
+      await expectProblem(await t.fetch("/"), 400);
+    });
+
+    it("uses JSON when onError returns a regular HTTPError", async () => {
+      t.app.config.onError = () => new HTTPError({ status: 418, message: "tea" });
+      t.app.get("/", () => {
+        throw problem({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(res.headers.get("content-type")).toMatch(/^application\/json/);
+    });
+
+    it("merges event error headers", async () => {
+      t.app.get("/", (event) => {
+        event.res.errHeaders.set("x-err", "1");
+        throw problem({ status: 400, headers: { "x-own": "2" } });
+      });
+      const res = await t.fetch("/");
+      await expectProblem(res, 400);
+      expect(res.headers.get("x-err")).toBe("1");
+      expect(res.headers.get("x-own")).toBe("2");
+      t.errors = [];
+    });
+
+    it("HEAD has no body", async () => {
+      t.app.all("/", () => {
+        throw problem({ status: 400 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(400);
+      expect(await res.text()).toBe("");
+      t.errors = [];
+    });
+
+    it("keeps the mark on HTTPError-shaped errors (isError)", async () => {
+      const same = Object.assign(new Error("x"), { status: 400 });
+      Object.defineProperty(same, "name", { value: "HTTPError" });
+      Object.defineProperty(same, "~problem", { value: { type: "urn:copy" } });
+      expect(HTTPError.isError(same)).toBe(true);
+      t.app.get("/", () => {
+        throw same;
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect((await res.json()).type).toBe("urn:copy");
+      t.errors = [];
+    });
+  });
+});
