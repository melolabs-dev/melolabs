diff --git a/test/unit/problem.test.ts b/test/unit/problem.test.ts
new file mode 100644
index 0000000..fed12ec
--- /dev/null
+++ b/test/unit/problem.test.ts
@@ -0,0 +1,88 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError, problem } from "../../src/index.ts";
+import { getStatusText } from "../../src/utils/internal/status-text.ts";
+import { kProblem, problemBody } from "../../src/utils/internal/problem.ts";
+
+const body = (error: HTTPError, debug?: boolean) =>
+  problemBody(error, (error as any)[kProblem], debug);
+
+describe("getStatusText", () => {
+  it("resolves known and unknown codes", () => {
+    expect(getStatusText(404)).toBe("Not Found");
+    expect(getStatusText(500)).toBe("Internal Server Error");
+    expect(getStatusText(599)).toBeUndefined();
+  });
+});
+
+describe("problemBody", () => {
+  it("builds the RFC 9457 example", () => {
+    const json = body(
+      problem({
+        status: 404,
+        message: "Pedido não encontrado",
+        type: "https://ex.com/erros/nao-encontrado",
+        instance: "/pedidos/42",
+      }),
+    );
+    expect(json).toEqual({
+      type: "https://ex.com/erros/nao-encontrado",
+      title: "Not Found",
+      status: 404,
+      detail: "Pedido não encontrado",
+      instance: "/pedidos/42",
+    });
+    expect(Object.keys(json)).toEqual(["type", "title", "status", "detail", "instance"]);
+  });
+
+  it("applies defaults and omits missing members", () => {
+    const json = body(problem({ status: 404 }));
+    expect(json).toEqual({ type: "about:blank", title: "Not Found", status: 404 });
+    expect("detail" in json).toBe(false);
+    expect("instance" in json).toBe(false);
+  });
+
+  it("uses custom statusText as title and omits unknown titles", () => {
+    expect(body(problem({ status: 400, statusText: "Custom" })).title).toBe("Custom");
+    expect("title" in JSON.parse(JSON.stringify(body(problem({ status: 599 }))))).toBe(false);
+  });
+
+  it("keeps default members over body and adds extensions and data", () => {
+    const json = body(
+      problem({
+        status: 422,
+        body: { status: 1, type: "x", balance: 30, accounts: ["/a/1"] },
+        data: { campo: "x" },
+      }),
+    );
+    expect(json).toMatchObject({
+      type: "about:blank",
+      status: 422,
+      balance: 30,
+      accounts: ["/a/1"],
+      data: { campo: "x" },
+    });
+  });
+
+  it("passes body.data through when data is undefined", () => {
+    expect(body(problem({ status: 400, body: { data: 1 } })).data).toBe(1);
+    expect(body(problem({ status: 400, data: 2, body: { data: 1 } })).data).toBe(2);
+  });
+
+  it("hides detail, data, extensions and stack when unhandled", () => {
+    const error = problem({
+      status: 500,
+      message: "segredo",
+      data: { s: 1 },
+      body: { ext: 1 },
+      unhandled: true,
+    });
+    const json = body(error);
+    expect(json).toEqual({ type: "about:blank", title: "Internal Server Error", status: 500 });
+    expect(body(error, true).stack).toBeDefined();
+    expect(JSON.stringify(json)).not.toContain("segredo");
+  });
+
+  it("does not change HTTPError toJSON", () => {
+    expect(new HTTPError({ status: 400, message: "ruim" }).toJSON()).not.toHaveProperty("type");
+  });
+});
