index 0000000..ffab5cc
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,40 @@
+import type { ErrorInput } from "../error.ts";
+import type { ProblemMark } from "./internal/problem.ts";
+import { HTTPError } from "../error.ts";
+import { kProblem } from "./internal/problem.ts";
+
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /**
+   * URI reference identifying the problem type (RFC 9457 section 3.1.1). Defaults to `"about:blank"`.
+   */
+  type?: string;
+
+  /**
+   * URI reference identifying this occurrence of the problem (RFC 9457 section 3.1.5).
+   */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is sent as an RFC 9457 problem details response
+ * (`application/problem+json`).
+ *
+ * `message` becomes `detail`, `statusText` (or the default status text) becomes `title`, `data` is
+ * sent under `data` and `body` entries become extension members (they never override `type`,
+ * `title`, `status`, `detail`, `instance`).
+ *
+ * **NOTE:** The format is lost when the error is wrapped in `cause` by another error or replaced by
+ * an `onError` hook (it is then sent as a regular JSON error). `type` and `instance` are not hidden
+ * for `unhandled` errors, so do not put sensitive data in them.
+ *
+ * @example
+ *
+ * throw problem({ status: 404, message: "Order not found", type: "https://example.com/errors/not-found" });
+ */
+export function problem<DataT = unknown>(input: ProblemInput<DataT>): HTTPError<DataT> {
+  const detail = typeof input.message === "string" && input.message ? input.message : undefined;
+  const error = new HTTPError<DataT>({ ...input });
+  const mark: ProblemMark = { type: input.type, instance: input.instance, detail };
+  Object.defineProperty(error, kProblem, { value: mark, enumerable: false });
+  return error;
+}
