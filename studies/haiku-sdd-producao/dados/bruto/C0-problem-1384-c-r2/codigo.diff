new file mode 100644
index 0000000..c262c56
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,46 @@
+import type { HTTPError } from "../../error.ts";
+import { getStatusText } from "./status-text.ts";
+
+export const kProblem = "~problem";
+
+export interface ProblemMark {
+  type?: string;
+  instance?: string;
+  /** Explicit `message`; `undefined` when the error only has the default `HTTPError` message. */
+  detail?: string;
+}
+
+const reservedKeys = new Set(["type", "title", "status", "detail", "instance", "data"]);
+
+export function problemBody(
+  error: HTTPError,
+  mark: ProblemMark,
+  debug?: boolean,
+): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  const body: Record<string, unknown> = {
+    type: mark?.type || "about:blank",
+    title: error.statusText || getStatusText(error.status),
+    status: error.status,
+  };
+  if (!unhandled && mark?.detail) {
+    body.detail = mark.detail;
+  }
+  if (mark?.instance) {
+    body.instance = mark.instance;
+  }
+  if (!unhandled) {
+    if (error.data !== undefined) {
+      body.data = error.data;
+    }
+    for (const key in error.body) {
+      if (!reservedKeys.has(key) || (key === "data" && error.data === undefined)) {
+        body[key] = error.body[key];
+      }
+    }
+  }
+  if (debug && error.stack) {
+    body.stack = error.stack.split("\n").map((l) => l.trim());
+  }
+  return body;
+}
