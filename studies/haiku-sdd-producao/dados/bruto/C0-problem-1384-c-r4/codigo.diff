diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..96dd793
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,244 @@
+import { H3, HTTPError, onError, problem, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_CT = "application/problem+json;charset=UTF-8";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  describe("response", () => {
+    it("is an HTTPError that can be thrown", async () => {
+      const error = problem({ status: 404 });
+      expect(HTTPError.isError(error)).toBe(true);
+      t.app.get("/", () => {
+        throw error;
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    });
+
+    it("renders default members", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 404 });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(body.type).toBe("about:blank");
+      expect(body.status).toBe(404);
+      expect(body.title).toBe("Not Found");
+      expect(body).not.toHaveProperty("detail");
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("renders all members", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw problem({
+          status: 422,
+          statusText: "Invalid entity",
+          message: "O campo email é obrigatório",
+          type: "https://example.com/probs/validacao",
+          instance: "/cadastro",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(await res.json()).toEqual({
+        type: "https://example.com/probs/validacao",
+        status: 422,
+        title: "Invalid entity",
+        detail: "O campo email é obrigatório",
+        instance: "/cadastro",
+      });
+    });
+
+    it("defaults status to 500", async () => {
+      t.app.get("/a", () => {
+        throw problem({ message: "falha" });
+      });
+      t.app.get("/b", () => {
+        throw problem({ statusCode: 418 });
+      });
+      const a = await t.fetch("/a");
+      expect(a.status).toBe(500);
+      expect((await a.json()).status).toBe(500);
+      const b = await t.fetch("/b");
+      expect(b.status).toBe(418);
+      expect((await b.json()).status).toBe(418);
+    });
+
+    it("renders extensions without overriding standard members", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 400,
+          body: { errors: ["a"], status: 999, type: "x" },
+          data: { campo: "email" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.errors).toEqual(["a"]);
+      expect(body.data).toEqual({ campo: "email" });
+      expect(body.status).toBe(400);
+      expect(body.type).toBe("about:blank");
+    });
+
+    it("does not leak details of unhandled errors", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 500,
+          unhandled: true,
+          message: "segredo",
+          data: { s: 1 },
+          body: { x: 1 },
+        });
+      });
+      t.app.config.debug = false;
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(text).not.toContain("segredo");
+      const body = JSON.parse(text);
+      expect(body).toEqual({
+        type: "about:blank",
+        status: 500,
+        title: "Internal Server Error",
+      });
+      t.errors.length = 0;
+    });
+  });
+
+  describe("headers", () => {
+    it("keeps headers and forces content-type", async () => {
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("x-err", "1");
+        throw problem({
+          status: 401,
+          headers: { "www-authenticate": "Bearer", "content-type": "text/plain" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("www-authenticate")).toBe("Bearer");
+      expect(res.headers.get("x-err")).toBe("1");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    });
+
+    it("forces content-type over errHeaders", async () => {
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("content-type", "text/plain");
+        throw problem({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    });
+  });
+
+  describe("debug", () => {
+    it("includes stack only in debug mode", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 500, message: "x" });
+      });
+      const on = await (await t.fetch("/")).json();
+      expect(Array.isArray(on.stack)).toBe(true);
+      t.app.config.debug = false;
+      const off = await (await t.fetch("/")).json();
+      expect(off).not.toHaveProperty("stack");
+    });
+  });
+
+  describe("compatibility", () => {
+    it("keeps legacy format for regular errors", async () => {
+      t.app.get("/problem", () => {
+        throw problem({ status: 400 });
+      });
+      t.app.get("/new", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      t.app.get("/static", () => {
+        throw HTTPError.status(409, "Conflict");
+      });
+      for (const path of ["/new", "/static"]) {
+        const res = await t.fetch(path);
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        const body = await res.json();
+        expect(body).toHaveProperty("status");
+        expect(body).not.toHaveProperty("type");
+      }
+      expect((await t.fetch("/problem")).headers.get("content-type")).toBe(PROBLEM_CT);
+    });
+
+    it("does not change toJSON or enumerable keys", () => {
+      const error = problem({ status: 400, message: "m", type: "t" });
+      expect(Object.keys(error)).not.toContain("~problem");
+      expect(JSON.parse(JSON.stringify(error))).toEqual(
+        JSON.parse(JSON.stringify(new HTTPError({ status: 400, message: "m" }))),
+      );
+      expect(new HTTPError({ status: 404 }).toJSON()).toEqual({
+        status: 404,
+        statusText: undefined,
+        unhandled: undefined,
+        message: "HTTPError 404",
+        data: undefined,
+      });
+    });
+  });
+
+  describe("chain", () => {
+    it("renders the same response everywhere", async () => {
+      const make = () => problem({ status: 409, message: "dup", data: { a: 1 } });
+      t.app.get("/handler", () => {
+        throw make();
+      });
+      t.app.get("/middleware", () => "ok", {
+        middleware: [
+          () => {
+            throw make();
+          },
+        ],
+      });
+      t.app.get("/returned", () => make());
+      t.app.get("/on-error-mw", () => "ok", {
+        middleware: [
+          onError(() => undefined),
+          () => {
+            throw make();
+          },
+        ],
+      });
+
+      let expected: unknown;
+      for (const path of ["/handler", "/middleware", "/returned", "/on-error-mw"]) {
+        const res = await t.fetch(path);
+        expect(res.status).toBe(409);
+        expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+        const body = await res.json();
+        expected ??= body;
+        expect(body.stack ? { ...body, stack: undefined } : body).toEqual(
+          (expected as any).stack ? { ...(expected as any), stack: undefined } : expected,
+        );
+      }
+      expect(t.hooks.onError).toHaveBeenCalled();
+      for (const error of t.errors) {
+        expect(HTTPError.isError(error)).toBe(true);
+      }
+    });
+
+    it("renders from an app level onError that returns a problem", async () => {
+      const app = new H3({
+        onError: (error) => {
+          if (error.status === 404) return problem({ status: 409 });
+        },
+      });
+      const res = await app.request("/missing");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    });
+
+    it("omits the body for HEAD", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 404 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+      expect(await res.text()).toBe("");
+    });
+  });
+});
