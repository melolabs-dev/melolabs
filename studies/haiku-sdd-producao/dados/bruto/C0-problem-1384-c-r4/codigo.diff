--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,30 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { kProblem, type ProblemMark } from "./internal/problem.ts";
+
+/**
+ * Input of {@link problem}: everything accepted by `HTTPError`, plus RFC 9457 `type` and `instance`.
+ */
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /** URI reference identifying the problem type (RFC 9457 §3.1.1). Defaults to `"about:blank"`. */
+  type?: string;
+  /** URI reference identifying this occurrence of the problem (RFC 9457 §3.1.5). */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` rendered as `application/problem+json` (RFC 9457).
+ *
+ * @example
+ *
+ * throw problem({ status: 404, message: "User not found", instance: "/users/1" });
+ */
+export function problem<DataT = unknown>(input: ProblemInput<DataT>): HTTPError<DataT> {
+  const error = new HTTPError<DataT>(input);
+  const mark: ProblemMark = {
+    type: input.type,
+    instance: input.instance,
+    detail: typeof input.message === "string" && input.message ? input.message : undefined,
+  };
+  Object.defineProperty(error, kProblem, { value: mark });
+  return error;
+}
