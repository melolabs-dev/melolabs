diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..a4bd0ff
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,215 @@
+import { HTTPError, problem, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  describe("factory", () => {
+    it("returns a marked HTTPError", () => {
+      const err = problem({ status: 400 });
+      expect(err).toBeInstanceOf(HTTPError);
+      expect(HTTPError.isError(err)).toBe(true);
+      expect(err.status).toBe(400);
+      expect(Object.keys(err)).not.toContain("~problem");
+      expect(JSON.stringify(err)).not.toContain("problem");
+    });
+
+    it("does not carry type/instance in cause", () => {
+      const err = problem({ status: 400, type: "urn:x", instance: "/a" });
+      expect(err.cause).not.toHaveProperty("type");
+      expect(err.cause).not.toHaveProperty("instance");
+      expect(err.toJSON()).not.toHaveProperty("type");
+    });
+  });
+
+  describe("response body", () => {
+    it("renders the full RFC 9457 body (throw)", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário 42 não existe",
+          type: "https://exemplo.com/erros/nao-encontrado",
+          instance: "/usuarios/42",
+          body: { saldo: 0 },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.com/erros/nao-encontrado",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário 42 não existe",
+        instance: "/usuarios/42",
+        saldo: 0,
+      });
+    });
+
+    it("works when returned", async () => {
+      t.app.get("/", () => problem({ status: 400 }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    });
+
+    it("defaults type to about:blank with the standard title", async () => {
+      t.app.get("/", () => problem({ status: 404 }));
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("about:blank");
+      expect(body.title).toBe("Not Found");
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("omits title for a custom type without statusText", async () => {
+      t.app.get("/", () => problem({ status: 404, type: "urn:custom" }));
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("urn:custom");
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("does not let body override standard members", async () => {
+      t.app.get("/", () =>
+        problem({
+          status: 400,
+          message: "real",
+          body: { type: "x", title: "x", status: 1, detail: "x", instance: "x", extra: 1 },
+        }),
+      );
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        type: "about:blank",
+        title: "Bad Request",
+        status: 400,
+        detail: "real",
+        extra: 1,
+      });
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("puts data under data", async () => {
+      t.app.get("/", () => problem({ status: 400, data: { a: 1 } }));
+      expect((await (await t.fetch("/")).json()).data).toEqual({ a: 1 });
+    });
+
+    it("uses problem+json for 422", async () => {
+      t.app.get("/", () => problem({ status: 422 }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    });
+  });
+
+  describe("headers", () => {
+    it("keeps statusText and headers", async () => {
+      t.app.get("/", () =>
+        problem({
+          status: 429,
+          statusText: "Too Many Requests",
+          headers: { "retry-after": "30" },
+        }),
+      );
+      const res = await t.fetch("/");
+      expect(res.status).toBe(429);
+      expect(res.statusText).toBe("Too Many Requests");
+      expect(res.headers.get("retry-after")).toBe("30");
+    });
+
+    it("respects an explicit content-type", async () => {
+      t.app.get("/", () =>
+        problem({ status: 400, headers: { "content-type": "application/x-custom" } }),
+      );
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/x-custom");
+    });
+  });
+
+  describe("regular errors are unchanged", () => {
+    it("keeps application/json", async () => {
+      t.app.get("/http", () => {
+        throw new HTTPError({ status: 400, message: "ruim" });
+      });
+      t.app.get("/status", () => {
+        throw HTTPError.status(400);
+      });
+      t.app.get("/error", () => {
+        throw new Error("boom");
+      });
+      t.app.config.onError = undefined;
+      for (const path of ["/http", "/status", "/error", "/missing"]) {
+        const res = await t.fetch(path);
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        expect(await res.json()).not.toHaveProperty("type");
+      }
+      const body = await (await t.fetch("/http")).json();
+      expect(body).toMatchObject({ status: 400, message: "ruim" });
+    });
+  });
+
+  describe("unhandled and debug", () => {
+    for (const debug of [false, true]) {
+      it(`does not leak details (debug: ${debug})`, async () => {
+        t.app.config.debug = debug;
+        t.app.get("/", () => {
+          throw problem({
+            status: 500,
+            message: "segredo interno",
+            unhandled: true,
+            data: { secret: 1 },
+            body: { ext: "segredo" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+        const text = await res.text();
+        const body = JSON.parse(text);
+        // `stack` (debug only) carries the raw message as it does for regular errors
+        expect(JSON.stringify({ ...body, stack: undefined })).not.toContain("segredo");
+        expect(text).not.toContain("secret");
+        expect(body.detail).toBe("HTTPError");
+        expect(body.status).toBe(500);
+        expect(Array.isArray(body.stack)).toBe(debug);
+        t.errors.length = 0;
+      });
+    }
+  });
+
+  describe("hooks", () => {
+    for (const asyncHook of [false, true]) {
+      it(`onError receives the marked error (async: ${asyncHook})`, async () => {
+        let received: unknown;
+        t.app.config.onError = asyncHook
+          ? async (error) => {
+              received = error;
+            }
+          : (error) => {
+              received = error;
+            };
+        t.app.get("/", () => {
+          throw problem({ status: 409 });
+        });
+        const res = await t.fetch("/");
+        expect(HTTPError.isError(received)).toBe(true);
+        expect((received as HTTPError).status).toBe(409);
+        expect(res.status).toBe(409);
+        expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      });
+    }
+
+    it("a hook response replaces the format", async () => {
+      t.app.config.onError = () => new Response("replaced", { status: 418 });
+      t.app.get("/", () => {
+        throw problem({ status: 409 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(await res.text()).toBe("replaced");
+    });
+
+    it("renders HEAD without a body", async () => {
+      t.app.get("/", (_event: H3Event) => problem({ status: 409 }));
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(409);
+      expect(await res.text()).toBe("");
+    });
+  });
+});
