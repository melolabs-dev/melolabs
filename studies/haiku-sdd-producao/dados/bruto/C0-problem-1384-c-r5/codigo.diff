diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..ca7d7c4
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,53 @@
+import type { HTTPError } from "../../error.ts";
+
+export type ProblemMark = {
+  type?: string;
+  instance?: string;
+  // Shared, never mutated (copied by `mergeHeaders`)
+  headers: Headers;
+  // Renderer lives on the mark so `response.ts` (core bundle) does not pull in the status table
+  // Called as a method (`this` is the mark); `stack` is only set in debug mode
+  body: (this: ProblemMark, error: HTTPError, stack?: string[]) => Record<string, unknown>;
+};
+
+export function problemBody(
+  this: ProblemMark,
+  error: HTTPError,
+  stack?: string[],
+): Record<string, unknown> {
+  const type = this.type ?? "about:blank";
+  const unhandled = error.unhandled;
+  return {
+    ...(unhandled ? undefined : error.body),
+    data: unhandled ? undefined : error.data,
+    type,
+    title: error.statusText || (type === "about:blank" ? statusPhrases[error.status] : undefined),
+    status: error.status,
+    detail: error.toJSON().message,
+    instance: this.instance,
+    stack,
+  };
+}
+
+const statusPhrases: Record<number, string> = {
+  400: "Bad Request",
+  401: "Unauthorized",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  412: "Precondition Failed",
+  413: "Payload Too Large",
+  415: "Unsupported Media Type",
+  418: "I'm a Teapot",
+  422: "Unprocessable Content",
+  429: "Too Many Requests",
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+};
diff --git a/src/utils/problem.ts b/src/utils/problem.ts
new file mode 100644
index 0000000..ef90dfe
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,32 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { problemBody, type ProblemMark } from "./internal/problem.ts";
+
+const problemHeaders = /* @__PURE__ */ new Headers({
+  "content-type": "application/problem+json;charset=UTF-8",
+});
+
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /** URI reference identifying the problem type. Defaults to `"about:blank"`. */
+  type?: string;
+  /** URI reference identifying this specific occurrence of the problem. */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is responded to as RFC 9457 `application/problem+json`.
+ *
+ * `message` maps to `detail`, `statusText` to `title` and `body` to extension members.
+ *
+ * Note: `type` and `instance` are kept even when `unhandled` is set, do not interpolate internal data into them.
+ *
+ * @example
+ *
+ * throw problem({ status: 404, type: "https://example.com/not-found", message: "User 42 not found" })
+ */
+export function problem<DataT = unknown>(input: ProblemInput<DataT>): HTTPError<DataT> {
+  const { type, instance, ...rest } = input;
+  const error = new HTTPError<DataT>(rest);
+  const mark: ProblemMark = { type, instance, headers: problemHeaders, body: problemBody };
+  Object.defineProperty(error, "~problem", { value: mark });
+  return error;
+}
