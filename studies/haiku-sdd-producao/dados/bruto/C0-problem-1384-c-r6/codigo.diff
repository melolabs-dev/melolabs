diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..1bb49aa
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,328 @@
+import { describeMatrix } from "./_setup.ts";
+import { HTTPError, problem, onError, defineValidatedHandler } from "../src/index.ts";
+import { z } from "zod";
+import { beforeEach } from "vitest";
+
+const PROBLEM_CT = "application/problem+json;charset=UTF-8";
+const JSON_CT = "application/json;charset=UTF-8";
+
+describeMatrix("problem()", (t, { it, expect, describe }) => {
+  // The matrix app defaults to `debug: true` (adds `stack`); exact-body tests need it off
+  beforeEach(() => {
+    t.app.config.debug = false;
+  });
+
+  it("returns an HTTPError", () => {
+    const error = problem({ status: 404 });
+    expect(HTTPError.isError(error)).toBe(true);
+    expect(error.status).toBe(404);
+  });
+
+  it("sends problem+json with the default members", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 404 });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    expect(await res.json()).toEqual({ type: "about:blank", title: "Not Found", status: 404 });
+  });
+
+  it("maps all standard members", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 404,
+        statusText: "Not Found",
+        message: "Usuário 7 não existe",
+        type: "https://ex.com/erros/nao-encontrado",
+        instance: "/usuarios/7",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toEqual({
+      type: "https://ex.com/erros/nao-encontrado",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário 7 não existe",
+      instance: "/usuarios/7",
+    });
+  });
+
+  it("uses a custom statusText as title", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 404, statusText: "Nope" });
+    });
+    expect((await (await t.fetch("/")).json()).title).toBe("Nope");
+  });
+
+  it("omits title for unknown status without statusText", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 599 });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toEqual({ type: "about:blank", status: 599 });
+  });
+
+  it("omits detail without an explicit message", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, statusText: "Bad" });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("detail");
+    expect(body).not.toHaveProperty("message");
+    expect(body).not.toHaveProperty("statusText");
+    expect(body).not.toHaveProperty("unhandled");
+  });
+
+  it("keeps custom headers and merges content-type", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 429, headers: { "retry-after": "10" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("retry-after")).toBe("10");
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+  });
+
+  it("respects an explicit content-type", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, headers: { "content-type": "application/json" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/json");
+  });
+
+  it("supports extensions from body and data; standard members win", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 422,
+        body: { saldo: 30, status: 200, type: "x", title: "x", detail: "x", instance: "x" },
+        data: { campo: "valor" },
+      });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toEqual({
+      type: "about:blank",
+      title: "Unprocessable Content",
+      status: 422,
+      data: { campo: "valor" },
+      saldo: 30,
+    });
+  });
+
+  it("does not let body override data precedence", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, body: { data: "body" }, data: "data" });
+    });
+    expect((await (await t.fetch("/")).json()).data).toBe("data");
+  });
+
+  it("does not pollute the prototype with an own __proto__ in body", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, body: JSON.parse('{"__proto__":{"polluted":true},"ok":1}') });
+    });
+    const res = await t.fetch("/");
+    const text = await res.text();
+    const body = JSON.parse(text);
+    expect(body.ok).toBe(1);
+    expect(({} as any).polluted).toBeUndefined();
+    expect(Object.getPrototypeOf(body)).toBe(Object.prototype);
+  });
+
+  it("returns the same response for throw and return", async () => {
+    t.app.get("/throw", () => {
+      throw problem({ status: 409, message: "m" });
+    });
+    t.app.get("/return", () => problem({ status: 409, message: "m" }));
+    const a = await t.fetch("/throw");
+    const b = await t.fetch("/return");
+    expect(a.status).toBe(409);
+    expect(b.status).toBe(409);
+    expect(a.headers.get("content-type")).toBe(PROBLEM_CT);
+    expect(b.headers.get("content-type")).toBe(a.headers.get("content-type"));
+    expect(await b.json()).toEqual(await a.json());
+  });
+
+  it("works from middleware", async () => {
+    t.app.use(() => {
+      throw problem({ status: 401 });
+    });
+    t.app.get("/", () => "ok");
+    const res = await t.fetch("/");
+    expect(res.status).toBe(401);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    expect(await res.json()).toEqual({ type: "about:blank", title: "Unauthorized", status: 401 });
+  });
+
+  it("works when returned from the config onError", async () => {
+    t.app.config.onError = () => problem({ status: 418 });
+    t.app.get("/", () => {
+      throw new Error("boom");
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(418);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+  });
+
+  it("works when returned from the onError() middleware", async () => {
+    t.app.use(onError(() => problem({ status: 503 })));
+    t.app.get("/", () => {
+      throw new Error("boom");
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(503);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    expect(await res.json()).toEqual({
+      type: "about:blank",
+      title: "Service Unavailable",
+      status: 503,
+    });
+  });
+
+  it("includes stack as an extension in debug mode", async () => {
+    t.app.config.debug = true;
+    t.app.get("/", () => {
+      throw problem({ status: 400 });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(Array.isArray(body.stack)).toBe(true);
+  });
+
+  it("never includes stack without debug", async () => {
+    t.app.config.debug = false;
+    t.app.get("/", () => {
+      throw problem({ status: 400, message: "visible" });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("stack");
+    expect(body.detail).toBe("visible");
+  });
+
+  describe("toJSON and internals", () => {
+    it("toJSON matches the body sent", async () => {
+      const error = problem({
+        status: 422,
+        message: "m",
+        type: "https://ex.com/t",
+        instance: "/i",
+        data: { a: 1 },
+        body: { b: 2 },
+      });
+      t.app.config.debug = false;
+      t.app.get("/", () => error);
+      const body = await (await t.fetch("/")).json();
+      expect(JSON.parse(JSON.stringify(error.toJSON()))).toEqual(body);
+    });
+
+    it("regular HTTPError toJSON is unchanged", () => {
+      const error = new HTTPError({ status: 400, message: "ruim", data: 1, body: { x: 1 } });
+      expect(error.toJSON()).toEqual({
+        status: 400,
+        statusText: undefined,
+        unhandled: undefined,
+        message: "ruim",
+        data: 1,
+        x: 1,
+      });
+    });
+
+    it("does not expose ~problem as enumerable", () => {
+      const error = problem({ status: 400, message: "m" });
+      expect(Object.keys(error)).not.toContain("~problem");
+      expect(JSON.stringify(error)).not.toContain("~problem");
+      expect("~problem" in error).toBe(true);
+    });
+
+    it("does not propagate through cause", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ cause: problem({ status: 409 }) });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(JSON_CT);
+      expect((await res.json()).status).toBe(409);
+    });
+  });
+
+  describe("regular errors are unchanged", () => {
+    it("new HTTPError", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "ruim" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(JSON_CT);
+      const body = await res.json();
+      expect(body.message).toBe("ruim");
+      expect(body.status).toBe(400);
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("HTTPError.status", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(403);
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe(JSON_CT);
+    });
+
+    it("route 404", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(JSON_CT);
+    });
+
+    it("validation error", async () => {
+      t.app.post(
+        "/",
+        defineValidatedHandler({
+          validate: { body: z.object({ a: z.string() }) },
+          handler: (event) => event.req.json(),
+        }),
+      );
+      const res = await t.fetch("/", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ a: 1 }),
+      });
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(JSON_CT);
+    });
+  });
+});
+
+describeMatrix(
+  "problem() unhandled",
+  (t, { it, expect }) => {
+    it("does not leak details when unhandled and debug is off", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw problem({
+          status: 500,
+          message: "segredo",
+          data: { k: 1 },
+          body: { leak: "segredo" },
+          cause: new Error("segredo"),
+          unhandled: true,
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      const text = await res.text();
+      expect(text).not.toContain("segredo");
+      const body = JSON.parse(text);
+      expect(body).toEqual({ type: "about:blank", title: "Internal Server Error", status: 500 });
+    });
+
+    it("generic Error stays in the current format", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("boom");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(JSON_CT);
+      expect((await res.json()).unhandled).toBe(true);
+    });
+  },
+  { allowUnhandledErrors: true },
+);
