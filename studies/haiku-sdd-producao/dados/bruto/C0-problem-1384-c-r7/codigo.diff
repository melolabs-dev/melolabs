diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..6a83483
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,183 @@
+import { HTTPError, problem } from "../src/index.ts";
+import { beforeEach } from "vitest";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_CT = "application/problem+json;charset=UTF-8";
+
+describeMatrix("problem", (t, { it, expect }) => {
+  beforeEach(() => {
+    t.app.config.debug = false;
+  });
+
+  it("returns an HTTPError (RF-01)", () => {
+    const err = problem({ status: 404 });
+    expect(HTTPError.isError(err)).toBe(true);
+    expect(err.status).toBe(404);
+    expect(Object.keys(err)).toEqual(Object.keys(new HTTPError({ status: 404 })));
+  });
+
+  it("responds with problem+json (RF-02)", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400 });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+  });
+
+  it("emits RFC 9457 members (RF-03)", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 422,
+        statusText: "Unprocessable",
+        message: "Campo email inválido",
+        type: "https://example.com/probs/validation",
+        instance: "/users/42",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(422);
+    expect(await res.json()).toEqual({
+      type: "https://example.com/probs/validation",
+      title: "Unprocessable",
+      status: 422,
+      detail: "Campo email inválido",
+      instance: "/users/42",
+    });
+  });
+
+  it("uses defaults when only status is given (RF-04)", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 404 });
+    });
+    expect(await (await t.fetch("/")).json()).toEqual({
+      type: "about:blank",
+      title: "Not Found",
+      status: 404,
+    });
+  });
+
+  it("omits title for statuses without a default text (R-07)", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 599 });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toEqual({ type: "about:blank", status: 599 });
+  });
+
+  it("preserves headers, data and body extensions (RF-05)", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 429,
+        headers: { "retry-after": "30" },
+        body: { balance: 0, type: "ignored" },
+        data: { x: 1 },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(429);
+    expect(res.headers.get("retry-after")).toBe("30");
+    expect(res.headers.get("content-type")).toBe(PROBLEM_CT);
+    expect(await res.json()).toEqual({
+      type: "about:blank",
+      title: "Too Many Requests",
+      status: 429,
+      balance: 0,
+      data: { x: 1 },
+    });
+  });
+
+  it("keeps an explicit content-type (RF-05)", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, headers: { "Content-Type": "application/json" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/json");
+  });
+
+  it("keeps the format with onError and HEAD", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 409, message: "dup" });
+    });
+    const res = await t.fetch("/");
+    expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+    expect(await res.json()).toMatchObject({ title: "Conflict", detail: "dup" });
+    const head = await t.fetch("/", { method: "HEAD" });
+    expect(head.status).toBe(409);
+    expect(await head.text()).toBe("");
+  });
+
+  it("does not change regular errors (RF-07)", async () => {
+    t.app.get("/a", () => {
+      throw new HTTPError({ status: 400, message: "ruim" });
+    });
+    t.app.get("/b", () => {
+      throw HTTPError.status(403, "Forbidden");
+    });
+    for (const path of ["/a", "/b", "/missing"]) {
+      const res = await t.fetch(path);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(body).toHaveProperty("message");
+      expect(body).not.toHaveProperty("type");
+      expect(body).not.toHaveProperty("title");
+      expect(body).not.toHaveProperty("detail");
+    }
+    const body = await (await t.fetch("/a")).json();
+    expect(body).toMatchObject({ status: 400, message: "ruim" });
+  });
+});
+
+describeMatrix(
+  "problem (unhandled)",
+  (t, { it, expect }) => {
+    const unhandled = () =>
+      problem({
+        status: 500,
+        unhandled: true,
+        message: "segredo",
+        data: { x: 1 },
+        body: { y: 2 },
+        instance: "/segredo",
+      });
+
+    it("hides sensitive members without debug (RF-06)", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw unhandled();
+      });
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(text).not.toContain("segredo");
+      expect(JSON.parse(text)).toEqual({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+      });
+    });
+
+    it("keeps the format of generic errors (RF-07)", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("boom");
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(body).toMatchObject({ status: 500, unhandled: true });
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("exposes stack in debug", async () => {
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw unhandled();
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.stack).toBeInstanceOf(Array);
+      expect(body).not.toHaveProperty("data");
+      expect(body).not.toHaveProperty("detail");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
