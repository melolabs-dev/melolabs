diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..fc885d0
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,28 @@
+import type { HTTPError } from "../../error.ts";
+
+export const kProblem = "~problem";
+
+/** Builds the problem details body (`stack` is added by `errorResponse` in debug mode). */
+export type ProblemBody = () => Record<string, unknown>;
+
+export interface ProblemMeta {
+  type: string;
+  title?: string;
+  detail?: string;
+  instance?: string;
+}
+
+export function problemBody(error: HTTPError, meta: ProblemMeta): Record<string, unknown> {
+  if (error.unhandled) {
+    return { type: meta.type, title: meta.title, status: error.status };
+  }
+  return {
+    ...(error.data === undefined ? undefined : { data: error.data }),
+    ...error.body,
+    type: meta.type,
+    title: meta.title,
+    status: error.status,
+    detail: meta.detail,
+    instance: meta.instance,
+  };
+}
