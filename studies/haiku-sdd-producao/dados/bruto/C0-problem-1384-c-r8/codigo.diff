diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..b56119f
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,224 @@
+import { beforeEach, vi } from "vitest";
+import { H3, HTTPError, problem, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  (globalThis.console.error as any) = vi.fn();
+
+  beforeEach(() => {
+    // The test app runs in debug mode, which adds `stack` to error bodies
+    t.app.config.debug = false;
+  });
+
+  describe("errors without problem()", () => {
+    it("keeps the current format for HTTPError", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "ruim", data: { a: 1 } });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toMatchObject({ status: 400, message: "ruim", data: { a: 1 } });
+    });
+
+    it("keeps the current format for unknown routes", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(body.status).toBe(404);
+      expect(body).not.toHaveProperty("type");
+      expect(body).not.toHaveProperty("title");
+      expect(body).not.toHaveProperty("detail");
+    });
+
+    it("keeps the current format for plain errors", async () => {
+      t.app.get("/", () => {
+        throw new Error("boom");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(body).toMatchObject({ status: 500, unhandled: true });
+      expect(body).not.toHaveProperty("type");
+      expect(body).not.toHaveProperty("title");
+      expect(body).not.toHaveProperty("detail");
+    });
+  });
+
+  describe("problem()", () => {
+    it("returns an HTTPError preserving input", () => {
+      const err = problem({
+        status: 404,
+        message: "nope",
+        headers: { "x-a": "1" },
+        data: { k: 1 },
+      });
+      expect(HTTPError.isError(err)).toBe(true);
+      expect(err.status).toBe(404);
+      expect(err.message).toBe("nope");
+      expect(err.headers?.get("x-a")).toBe("1");
+      expect(err.data).toEqual({ k: 1 });
+      expect(problem({ status: 404 }).status).toBe(404);
+    });
+
+    it("renders the full RFC 9457 body", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 404,
+          type: "https://ex.com/nao-encontrado",
+          message: "Usuário 7 não existe",
+          instance: "/users/7",
+          body: { traceId: "abc" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(await res.json()).toEqual({
+        type: "https://ex.com/nao-encontrado",
+        status: 404,
+        title: "Not Found",
+        detail: "Usuário 7 não existe",
+        instance: "/users/7",
+        traceId: "abc",
+      });
+    });
+
+    it("puts data at the root as an extension", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 422, data: { field: "x" } });
+      });
+      expect(await (await t.fetch("/")).json()).toEqual({
+        type: "about:blank",
+        status: 422,
+        title: "Unprocessable Content",
+        data: { field: "x" },
+      });
+    });
+
+    it("does not let extensions override standard members", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 400, body: { title: "x", status: 1, type: "y" } });
+      });
+      expect(await (await t.fetch("/")).json()).toEqual({
+        type: "about:blank",
+        status: 400,
+        title: "Bad Request",
+      });
+    });
+
+    it("uses minimal defaults", async () => {
+      t.app.get("/403", () => {
+        throw problem({ status: 403 });
+      });
+      t.app.get("/500", () => {
+        throw problem({});
+      });
+      t.app.get("/299", () => problem({ status: 499 }));
+      const res = await t.fetch("/403");
+      const text = await res.text();
+      expect(text).not.toMatch(/undefined|null/);
+      expect(JSON.parse(text)).toEqual({ type: "about:blank", status: 403, title: "Forbidden" });
+      const res500 = await t.fetch("/500");
+      expect(res500.status).toBe(500);
+      expect((await res500.json()).status).toBe(500);
+      const res499 = await t.fetch("/299");
+      expect(await res499.json()).toEqual({ type: "about:blank", status: 499 });
+    });
+
+    it("renders the same for throw and return", async () => {
+      t.app.get("/throw", () => {
+        throw problem({ status: 409 });
+      });
+      t.app.get("/return", () => problem({ status: 409 }));
+      const a = await t.fetch("/throw");
+      const b = await t.fetch("/return");
+      expect(a.status).toBe(409);
+      expect(b.status).toBe(409);
+      expect(a.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(b.headers.get("content-type")).toBe(a.headers.get("content-type"));
+      expect(await b.text()).toBe(await a.text());
+    });
+
+    it("respects headers and statusText", async () => {
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("x-err", "1");
+        throw problem({
+          status: 429,
+          statusText: "Too Many Requests",
+          headers: { "retry-after": "30" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("retry-after")).toBe("30");
+      expect(res.headers.get("x-err")).toBe("1");
+      expect((await res.json()).title).toBe("Too Many Requests");
+    });
+
+    it("lets a user content-type win", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 400, headers: { "content-type": "application/x-custom" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/x-custom");
+    });
+
+    it("hides message, data and body when unhandled", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 500,
+          unhandled: true,
+          message: "segredo",
+          data: { k: 1 },
+          body: { b: 2 },
+        });
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      const text = await res.text();
+      expect(text).not.toContain("segredo");
+      expect(text).not.toContain('"k"');
+      expect(JSON.parse(text)).toEqual({
+        type: "about:blank",
+        status: 500,
+        title: "Internal Server Error",
+      });
+    });
+
+    it("includes stack in debug mode", async () => {
+      const app = new H3({ debug: true });
+      app.get("/", () => {
+        throw problem({ status: 400 });
+      });
+      const res = await app.request("/");
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(Array.isArray((await res.json()).stack)).toBe(true);
+    });
+
+    it("stays problem+json with onError", async () => {
+      const onError = vi.fn();
+      const app = new H3({ onError });
+      app.get("/", () => {
+        throw problem({ status: 400 });
+      });
+      const res = await app.request("/");
+      expect(onError).toHaveBeenCalledTimes(1);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    });
+
+    it("loses the mark when wrapped and keeps it hidden", async () => {
+      const err = problem({ status: 400, type: "https://ex.com/t" });
+      expect(Object.keys(err)).not.toContain("~problem");
+      expect(JSON.stringify(err)).not.toContain("problem");
+      t.app.get("/", () => {
+        throw new HTTPError(err);
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+  });
+});
