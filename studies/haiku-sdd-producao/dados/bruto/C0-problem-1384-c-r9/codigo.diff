diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..a7abe58
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,24 @@
+import type { HTTPError } from "../../error.ts";
+
+export const kProblem = "~problem";
+
+export type ProblemMark = { type?: string; instance?: string; detail?: string };
+
+export function getProblem(error: HTTPError): ProblemMark | undefined {
+  return (error as { [kProblem]?: ProblemMark })[kProblem];
+}
+
+export function problemBody(error: HTTPError, mark: ProblemMark): Record<string, unknown> {
+  if (error.unhandled) {
+    return { title: error.statusText, status: error.status };
+  }
+  return {
+    ...error.body,
+    type: typeof mark.type === "string" ? mark.type : undefined,
+    title: error.statusText,
+    status: error.status,
+    detail: mark.detail,
+    instance: typeof mark.instance === "string" ? mark.instance : undefined,
+    ...(error.data === undefined ? undefined : { data: error.data }),
+  };
+}
