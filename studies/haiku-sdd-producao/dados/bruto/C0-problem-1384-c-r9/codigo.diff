+++ b/src/utils/problem.ts
@@ -0,0 +1,21 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { kProblem, type ProblemMark } from "./internal/problem.ts";
+
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /** URI reference identifying the problem type (RFC 9457 `type`). */
+  type?: string;
+  /** URI reference identifying this occurrence (RFC 9457 `instance`). */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is rendered as `application/problem+json` (RFC 9457).
+ */
+export function problem<DataT = unknown>(input: ProblemInput<DataT>): HTTPError<DataT> {
+  const { type, instance, ...details } = input;
+  const error = new HTTPError(details) as HTTPError<DataT>;
+  Object.defineProperty(error, kProblem, {
+    value: { type, instance, detail: input.message || undefined } satisfies ProblemMark,
+  });
+  return error;
+}
diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..7624082
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,169 @@
+import { beforeEach, vi } from "vitest";
+import { HTTPError, problem, type H3Event } from "../src/index.ts";
+import { kNotFound } from "../src/response.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  (globalThis.console.error as any) = vi.fn();
+
+  // The test setup enables debug by default (adds `stack`)
+  beforeEach(() => {
+    t.app.config.debug = false;
+  });
+
+  const full = {
+    status: 403,
+    statusText: "Forbidden",
+    message: "Saldo insuficiente",
+    type: "https://example.com/probs/saldo",
+    instance: "/contas/123",
+  };
+
+  it("creates an HTTPError", () => {
+    const error = problem({ status: 404 });
+    expect(HTTPError.isError(error)).toBe(true);
+    expect(error).toBeInstanceOf(HTTPError);
+    expect(error.status).toBe(404);
+  });
+
+  it("does not expose the mark", () => {
+    const error = problem({ status: 400, type: "x" });
+    expect(Object.keys(error)).not.toContain("~problem");
+    expect(JSON.stringify(error)).toBe(JSON.stringify(new HTTPError({ status: 400 })));
+  });
+
+  for (const mode of ["throw", "return"]) {
+    it(`renders full body on ${mode}`, async () => {
+      t.app.get("/", () => {
+        const error = problem(full);
+        if (mode === "throw") throw error;
+        return error;
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(await res.text()).toBe(
+        '{"type":"https://example.com/probs/saldo","title":"Forbidden","status":403,"detail":"Saldo insuficiente","instance":"/contas/123"}',
+      );
+    });
+  }
+
+  it("omits absent members", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400 });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toEqual({ status: 400 });
+  });
+
+  it("keeps handler content-type", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, headers: { "content-type": "application/x-custom" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/x-custom");
+  });
+
+  it("merges extensions without overriding standard members", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 422,
+        type: "urn:t",
+        body: { errors: [{ campo: "nome" }], status: 200, type: "evil" },
+        data: { a: 1 },
+      });
+    });
+    const json = await (await t.fetch("/")).json();
+    expect(json).toEqual({
+      errors: [{ campo: "nome" }],
+      status: 422,
+      type: "urn:t",
+      data: { a: 1 },
+    });
+  });
+
+  describe("regression", () => {
+    it("keeps the default format", async () => {
+      t.app.get("/a", () => {
+        throw new HTTPError({ status: 400, message: "ruim" });
+      });
+      t.app.get("/b", () => {
+        throw HTTPError.status(400, "Bad Request");
+      });
+      t.app.get("/c", () => kNotFound);
+      for (const path of ["/a", "/b", "/c", "/missing"]) {
+        const res = await t.fetch(path);
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        expect(await res.json()).toHaveProperty("status");
+      }
+      const body = await (await t.fetch("/a")).json();
+      expect(body).toMatchObject({ status: 400, message: "ruim" });
+    });
+  });
+
+  describe("unhandled", () => {
+    const handler = () => {
+      throw problem({
+        status: 500,
+        message: "segredo interno",
+        type: "urn:t",
+        instance: "/i",
+        data: { s: 1 },
+        body: { b: 1 },
+        unhandled: true,
+      });
+    };
+
+    it("does not leak details", async () => {
+      t.app.get("/", handler);
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(text).not.toContain("segredo interno");
+      const json = JSON.parse(text);
+      for (const key of ["detail", "type", "instance", "data", "b", "stack"]) {
+        expect(json).not.toHaveProperty(key);
+      }
+      t.errors = [];
+    });
+
+    it("adds stack in debug without message", async () => {
+      t.app.config.debug = true;
+      t.app.get("/", handler);
+      const text = await (await t.fetch("/")).text();
+      const json = JSON.parse(text);
+      // `stack` is debug-only output and may include the original message
+      expect(json.stack).toBeInstanceOf(Array);
+      expect(json.detail).toBeUndefined();
+      expect(json.data).toBeUndefined();
+      t.errors = [];
+    });
+  });
+
+  for (const withOnError of [false, true]) {
+    it(`merges headers ${withOnError ? "with" : "without"} onError`, async () => {
+      if (!withOnError) t.app.config.onError = undefined;
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("x-error", "prepared");
+        event.res.errHeaders.append("set-cookie", "prepared=1");
+        throw problem({ status: 400, headers: { "x-own": "own", "set-cookie": "error=1" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+      expect(res.headers.get("x-error")).toBe("prepared");
+      expect(res.headers.get("x-own")).toBe("own");
+      expect(res.headers.getSetCookie()).toEqual(["error=1", "prepared=1"]);
+    });
+  }
+
+  it("renders HEAD without body", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400 });
+    });
+    const res = await t.fetch("/", { method: "HEAD" });
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-length")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+});
