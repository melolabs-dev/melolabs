   });
 });
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  const mtime = 1_700_000_000_000;
+  const lastModified = new Date(mtime).toUTCString();
+
+  // The matrix `it` has no `.each`
+  function each<T extends unknown[] | string | number | undefined>(cases: T[]) {
+    return (name: string, fn: (...args: any[]) => Promise<void>) => {
+      for (const c of cases) {
+        const args: unknown[] = Array.isArray(c) ? c : [c];
+        let n = 0;
+        it(
+          name.replace(/%s/g, () => String(args[n++])),
+          () => fn(...args),
+        );
+      }
+    };
+  }
+
+  function setup(overrides: Partial<ServeStaticOptions> = {}, meta: Record<string, unknown> = {}) {
+    const getContents = vi.fn((_id: string): BodyInit | null | undefined => "0123456789");
+    const options: ServeStaticOptions = {
+      getMeta: (id) =>
+        id.includes("404")
+          ? undefined
+          : { size: 10, etag: '"abc"', mtime, type: "text/plain", ...meta },
+      getContents,
+      ...overrides,
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+    return { getContents: options.getContents as typeof getContents };
+  }
+
+  it("advertises accept-ranges on GET and HEAD", async () => {
+    setup();
+    for (const method of ["GET", "HEAD"]) {
+      const res = await t.fetch("/f.txt", { method });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-range")).toBeNull();
+    }
+  });
+
+  it("serves a partial response", async () => {
+    setup();
+    const res = await t.fetch("/f.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("2345");
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("content-type")).toBe("text/plain");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("etag")).toBe('"abc"');
+  });
+
+  each([
+    ["bytes=7-", "789", "bytes 7-9/10"],
+    ["bytes=-3", "789", "bytes 7-9/10"],
+    ["bytes=7-999", "789", "bytes 7-9/10"],
+    ["BYTES=0-0", "0", "bytes 0-0/10"],
+    ["bytes=-999", "0123456789", "bytes 0-9/10"],
+    ["bytes=0-9", "0123456789", "bytes 0-9/10"],
+    ["bytes=9-9", "9", "bytes 9-9/10"],
+    ["bytes=0-", "0123456789", "bytes 0-9/10"],
+  ])("accepts range %s", async (range, body, contentRange) => {
+    setup();
+    const res = await t.fetch("/f.txt", { headers: { range } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(body);
+    expect(res.headers.get("content-range")).toBe(contentRange);
+    expect(res.headers.get("content-length")).toBe(String(body.length));
+  });
+
+  each([
+    "items=0-1",
+    "bytes=abc",
+    "bytes=5-2",
+    "bytes=",
+    "bytes=-",
+    "bytes=-1-2",
+    "bytes=+1-2",
+    "bytes=0-1,4-5",
+    "bytes=-5-3",
+  ])("ignores invalid range %s", async (range) => {
+    setup();
+    const res = await t.fetch("/f.txt", { headers: { range } });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe("0123456789");
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  each(["bytes=10-", "bytes=20-30", "bytes=-0"])("returns 416 for %s", async (range) => {
+    const { getContents } = setup();
+    const res = await t.fetch("/f.txt", { headers: { range } });
+    expect(res.status).toBe(416);
+    expect(await res.text()).toBe("");
+    expect(res.headers.get("content-range")).toBe("bytes */10");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("handles HEAD with a range", async () => {
+    const { getContents } = setup();
+    const ok = await t.fetch("/f.txt", { method: "HEAD", headers: { range: "bytes=2-5" } });
+    expect(ok.status).toBe(206);
+    expect(await ok.text()).toBe("");
+    expect(ok.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(ok.headers.get("content-length")).toBe("4");
+
+    const bad = await t.fetch("/f.txt", { method: "HEAD", headers: { range: "bytes=20-" } });
+    expect(bad.status).toBe(416);
+    expect(await bad.text()).toBe("");
+    expect(bad.headers.get("content-range")).toBe("bytes */10");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  describe("if-range", () => {
+    each([
+      ['"abc"', 206],
+      ['"other"', 200],
+      ['W/"abc"', 200],
+      [lastModified, 206],
+      [new Date(mtime + 5000).toUTCString(), 200],
+      ["not-a-date", 200],
+    ])("if-range %s -> %s", async (value, status) => {
+      setup();
+      const res = await t.fetch("/f.txt", { headers: { range: "bytes=2-5", "if-range": value } });
+      expect(res.status).toBe(status);
+      expect(await res.text()).toBe(status === 206 ? "2345" : "0123456789");
+    });
+
+    it("ignores if-range without range", async () => {
+      setup();
+      const res = await t.fetch("/f.txt", { headers: { "if-range": '"abc"' } });
+      expect(res.status).toBe(200);
+      expect(await res.text()).toBe("0123456789");
+    });
+  });
+
+  it("evaluates 304 before range", async () => {
+    setup();
+    const etag = await t.fetch("/f.txt", {
+      headers: { range: "bytes=2-5", "if-none-match": '"abc"' },
+    });
+    expect(etag.status).toBe(304);
+    expect(etag.headers.get("content-range")).toBeNull();
+
+    const date = await t.fetch("/f.txt", {
+      headers: { range: "bytes=2-5", "if-modified-since": lastModified },
+    });
+    expect(date.status).toBe(304);
+    expect(date.headers.get("content-range")).toBeNull();
+  });
+
+  it("ranges over the precompressed variant", async () => {
+    setup({
+      encodings: { gzip: ".gz" },
+      headers: { "cache-control": "public" },
+      getMeta: (id) => ({ size: id.endsWith(".gz") ? 8 : 10, etag: '"abc"', mtime }),
+      getContents: () => "01234567",
+    });
+    const res = await t.fetch("/f.txt", {
+      headers: { range: "bytes=0-3", "accept-encoding": "gzip" },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("0123");
+    expect(res.headers.get("content-range")).toBe("bytes 0-3/8");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(res.headers.get("content-type")).toBe("text/plain");
+    expect(res.headers.get("etag")).toBe('"abc"');
+    expect(res.headers.get("last-modified")).toBe(lastModified);
+    expect(res.headers.get("cache-control")).toBe("public");
+  });
+
+  each([undefined, 0, -1])("does not range with size %s", async (size) => {
+    setup({}, { size });
+    const res = await t.fetch("/f.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe("0123456789");
+    expect(res.headers.get("accept-ranges")).toBeNull();
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("does not range on 404 or 405", async () => {
+    setup();
+    const notFound = await t.fetch("/404.txt", { headers: { range: "bytes=2-5" } });
+    expect(notFound.status).toBe(404);
+    const post = await t.fetch("/f.txt", { method: "POST", headers: { range: "bytes=2-5" } });
+    expect(post.status).toBe(405);
+    for (const res of [notFound, post]) {
+      expect(res.headers.get("accept-ranges")).toBeNull();
+      expect(res.headers.get("content-range")).toBeNull();
+    }
+  });
+
+  it("lets the computed content-length win on 206 only", async () => {
+    setup({ headers: { "content-length": "999" } });
+    const full = await t.fetch("/f.txt", { method: "HEAD" });
+    expect(full.headers.get("content-length")).toBe("999");
+    const part = await t.fetch("/f.txt", { method: "HEAD", headers: { range: "bytes=2-5" } });
+    expect(part.headers.get("content-length")).toBe("4");
+  });
+
+  const bytes = new TextEncoder().encode("0123456789");
+  const padded = new Uint8Array(14);
+  padded.set(bytes, 2);
+  const chunked =
+    (...sizes: number[]) =>
+    () => {
+      let offset = 0;
+      return new ReadableStream<Uint8Array>({
+        start(controller) {
+          for (const size of sizes) {
+            controller.enqueue(bytes.slice(offset, offset + size));
+            offset += size;
+          }
+          controller.close();
+        },
+      });
+    };
+
+  each<[string, () => BodyInit]>([
+    ["string", () => "0123456789"],
+    ["Uint8Array", () => bytes.slice()],
+    ["Uint8Array subview", () => new Uint8Array(padded.buffer, 2, 10)],
+    ["ArrayBuffer", () => bytes.slice().buffer as ArrayBuffer],
+    ["Blob", () => new Blob(["0123456789"])],
+    ["File", () => new File(["0123456789"], "f.txt")],
+    ["URLSearchParams", () => new URLSearchParams("a=bcdefg")],
+    ["ReadableStream (1 chunk)", chunked(10)],
+    ["ReadableStream (chunks)", chunked(1, 2, 3, 4)],
+  ])("slices %s", async (name, make) => {
+    // `a=bcdefg` is 8 bytes: bytes 2-5 are "bcde"
+    const urlEncoded = name === "URLSearchParams";
+    const { getContents } = setup(
+      { getContents: vi.fn(() => make()) },
+      urlEncoded ? { size: 8 } : {},
+    );
+    const res = await t.fetch("/f.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    const buf = new Uint8Array(await res.arrayBuffer());
+    expect(new TextDecoder().decode(buf)).toBe(urlEncoded ? "bcde" : "2345");
+    expect(buf.length).toBe(Number(res.headers.get("content-length")));
+    expect(getContents).toHaveBeenCalledTimes(1);
+  });
+
+  it("slices multibyte strings by UTF-8 bytes", async () => {
+    // "é0123" = c3 a9 30 31 32 33 (6 bytes); bytes 2-3 are "01"
+    setup({ getContents: () => "é0123" }, { size: 6 });
+    const res = await t.fetch("/f.txt", { headers: { range: "bytes=2-3" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("01");
+  });
+});
