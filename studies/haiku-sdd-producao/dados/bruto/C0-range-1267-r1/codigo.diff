@@ -349,3 +381,131 @@ function idSearchPaths(id: string, encodings: string[], indexNames: string[]) {
 
   return ids;
 }
+
+type ByteRange = { start: number; end: number };
+
+/** `undefined` means the `Range` header is ignored and the full asset is served. */
+type RangeResult = ByteRange | "unsatisfiable" | undefined;
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+function isRangeableSize(size: number | undefined): size is number {
+  return Number.isSafeInteger(size) && size! > 0;
+}
+
+/**
+ * Parse a single `bytes` range (RFC 9110 section 14.1.2) against a known size.
+ *
+ * Malformed, unknown-unit and multi-range headers are ignored (`undefined`).
+ */
+function parseRange(header: string, size: number): RangeResult {
+  const match = RANGE_RE.exec(header.trim());
+  if (!match) {
+    return;
+  }
+  const [, first, last] = match;
+  if (!first) {
+    if (!last) {
+      return;
+    }
+    const suffix = Number(last);
+    return suffix === 0 ? "unsatisfiable" : { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  // Unsafe integers are always >= size, so the comparisons below cover them.
+  if (last && start > Number(last)) {
+    return;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: last ? Math.min(Number(last), size - 1) : size - 1 };
+}
+
+/**
+ * `If-Range` needs a strong comparison (RFC 9110 section 13.1.5), so `matchETag`
+ * (weak comparison) is not reused.
+ */
+function ifRangeAllows(
+  value: string | null,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  value = value?.trim() ?? null;
+  if (!value) {
+    return true;
+  }
+  if (value.startsWith('"')) {
+    return !!validators.etag && !/^w\//i.test(validators.etag) && value === validators.etag;
+  }
+  const date = Date.parse(value);
+  return (
+    !Number.isNaN(date) && !!validators.lastModified && date === validators.lastModified.getTime()
+  );
+}
+
+function resolveRange(
+  headers: Headers,
+  size: number,
+  validators: { etag?: string; lastModified?: Date },
+): RangeResult {
+  const header = headers.get("range");
+  if (!header || !ifRangeAllows(headers.get("if-range"), validators)) {
+    return;
+  }
+  return parseRange(header, size);
+}
+
+/** Slice `[start, end]` (inclusive) out of a body. Offsets are in bytes. */
+async function sliceBody(contents: BodyInit, { start, end }: ByteRange): Promise<BodyInit> {
+  if (typeof contents === "string") {
+    return new TextEncoder().encode(contents).subarray(start, end + 1);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset + start, end - start + 1);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return new Uint8Array(contents, start, end - start + 1);
+  }
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, start, end);
+  }
+  // FormData, URLSearchParams, ...
+  return (await new Response(contents).blob()).slice(start, end + 1);
+}
+
+/**
+ * Streams have no seek: bytes before `start` are read and dropped, and the
+ * reader is cancelled once `end` is reached. Only `Uint8Array` chunks are supported.
+ */
+function sliceStream(stream: ReadableStream, start: number, end: number): ReadableStream {
+  const reader = stream.getReader();
+  let position = 0;
+  return new ReadableStream({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          return controller.close();
+        }
+        const chunk = value as Uint8Array;
+        const from = Math.max(start - position, 0);
+        const to = Math.min(end + 1 - position, chunk.length);
+        position += chunk.length;
+        if (from < to) {
+          controller.enqueue(chunk.subarray(from, to));
+        }
+        if (position > end) {
+          await reader.cancel();
+          return controller.close();
+        }
+        if (from < to) {
+          return;
+        }
+      }
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
diff --git a/test/static.test.ts b/test/static.test.ts
index f171202..213cf0b 100644
--- a/test/static.test.ts
+++ b/test/static.test.ts
@@ -676,3 +676,260 @@ describe("serve static (malformed url)", () => {
