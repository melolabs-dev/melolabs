index 0000000..b76ee02
--- /dev/null
+++ b/test/unit/range.test.ts
@@ -0,0 +1,117 @@
+import { describe, it, expect, vi } from "vitest";
+import { parseRange, ifRangeAllows, sliceBody } from "../../src/utils/internal/range.ts";
+
+describe("parseRange", () => {
+  it.each([
+    ["bytes=0-9", 100, { start: 0, end: 9 }],
+    ["Bytes=0-9", 100, { start: 0, end: 9 }],
+    ["  bytes=0-9  ", 100, { start: 0, end: 9 }],
+    ["bytes=90-", 100, { start: 90, end: 99 }],
+    ["bytes=90-999", 100, { start: 90, end: 99 }],
+    ["bytes=-10", 100, { start: 90, end: 99 }],
+    ["bytes=-500", 100, { start: 0, end: 99 }],
+    ["bytes=0-0", 1, { start: 0, end: 0 }],
+    ["bytes=0-99999999999999999999999", 100, { start: 0, end: 99 }],
+    ["bytes=100-", 100, "unsatisfiable"],
+    ["bytes=-0", 100, "unsatisfiable"],
+    ["bytes=99999999999999999999999-", 100, "unsatisfiable"],
+    ["bytes=5-2", 100, undefined],
+    ["bytes=-", 100, undefined],
+    ["bytes=", 100, undefined],
+    ["bytes=0-1,5-6", 100, undefined],
+    ["items=0-1", 100, undefined],
+    ["bytes=+1-2", 100, undefined],
+    ["bytes=1 -2", 100, undefined],
+    [null, 100, undefined],
+  ])("%s (size %s)", (header, size, expected) => {
+    expect(parseRange(header, size)).toEqual(expected);
+  });
+});
+
+describe("ifRangeAllows", () => {
+  const lm = "Tue, 14 Nov 2023 22:13:20 GMT";
+  it.each([
+    [null, {}, true],
+    ['"v1"', { etag: '"v1"' }, true],
+    ['"v2"', { etag: '"v1"' }, false],
+    ['W/"v1"', { etag: 'W/"v1"' }, false],
+    ['"v1"', { etag: 'W/"v1"' }, false],
+    ['"v1"', {}, false],
+    ["w/123", { etag: "w/123" }, false],
+    [lm, { lastModified: lm }, true],
+    ["Tue, 14 Nov 2023 22:13:21 GMT", { lastModified: lm }, false],
+    ["not a date", { lastModified: lm }, false],
+    [lm, {}, false],
+  ])("%s with %j", (ifRange, validators, expected) => {
+    expect(ifRangeAllows(ifRange, validators)).toBe(expected);
+  });
+});
+
+describe("sliceBody", () => {
+  const text = "0123456789";
+  const bytes = () => new TextEncoder().encode(text);
+  const read = async (body: BodyInit) => new Response(body).text();
+
+  it("slices every body type", async () => {
+    const r = { start: 2, end: 5 };
+    expect(await read(await sliceBody(text, r))).toBe("2345");
+    expect(await read(await sliceBody(new Blob([text]), r))).toBe("2345");
+    expect(await read(await sliceBody(bytes(), r))).toBe("2345");
+    expect(await read(await sliceBody(bytes().buffer as ArrayBuffer, r))).toBe("2345");
+    expect(await read(await sliceBody(new URLSearchParams("a=1"), { start: 0, end: 2 }))).toBe(
+      "a=1",
+    );
+  });
+
+  it("slices views with an offset", async () => {
+    const view = new Uint8Array(bytes().buffer, 3, 5); // "34567"
+    expect(await read(await sliceBody(view, { start: 1, end: 2 }))).toBe("45");
+  });
+
+  it("slices streams across chunks and cancels the source", async () => {
+    const cancel = vi.fn();
+    const chunks: (Uint8Array | string)[] = [
+      bytes().subarray(0, 3),
+      "345",
+      bytes().subarray(6),
+      "tail", // keeps the source open: pull-ahead must not close it first
+      "more",
+    ];
+    const source = new ReadableStream({
+      pull(c) {
+        const next = chunks.shift();
+        if (next === undefined) {
+          c.close();
+        } else {
+          c.enqueue(next);
+        }
+      },
+      cancel,
+    });
+    expect(await read(await sliceBody(source, { start: 2, end: 7 }))).toBe("234567");
+    expect(cancel).toHaveBeenCalled();
+  });
+
+  it("ends at the real end when the source is shorter", async () => {
+    const source = new ReadableStream({
+      start(c) {
+        c.enqueue(bytes());
+        c.close();
+      },
+    });
+    expect(await read(await sliceBody(source, { start: 8, end: 50 }))).toBe("89");
+  });
+
+  it("propagates consumer cancel to the source", async () => {
+    const cancel = vi.fn();
+    const source = new ReadableStream({
+      pull(c) {
+        c.enqueue(bytes());
+      },
+      cancel,
+    });
+    const sliced = (await sliceBody(source, { start: 0, end: 1000 })) as ReadableStream;
+    await sliced.cancel("bye");
+    expect(cancel).toHaveBeenCalledWith("bye");
+  });
+});
