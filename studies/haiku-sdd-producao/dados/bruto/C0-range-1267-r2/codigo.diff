index 0000000..f9d6e6d
--- /dev/null
+++ b/src/utils/internal/range.ts
@@ -0,0 +1,135 @@
+// HTTP Range helpers for `serveStatic` (RFC 9110 sections 13.1.5, 14).
+//
+// Assumes the `size` reported by the asset meta is the real body size: a
+// mismatch yields wrong `content-length`/`content-range` headers.
+
+/** Inclusive byte range, normalized to the asset size. */
+export interface ByteRange {
+  start: number;
+  end: number;
+}
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * `undefined`: ignore the header (malformed, unknown unit, multi-range).
+ * `"unsatisfiable"`: respond with 416.
+ */
+export function parseRange(
+  header: string | null,
+  size: number,
+): ByteRange | "unsatisfiable" | undefined {
+  const match = header && RANGE_RE.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first, last] = match;
+  if (!first && !last) {
+    return undefined;
+  }
+
+  if (!first) {
+    // Suffix range: last `n` bytes.
+    const n = Number(last);
+    if (n === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - n, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: last ? Math.min(Number(last), size - 1) : size - 1 };
+}
+
+/** `false`: the `range` header must be ignored. Strong ETag or exact date match. */
+export function ifRangeAllows(
+  ifRange: string | null,
+  validators: { etag?: string | null; lastModified?: string | null },
+): boolean {
+  if (!ifRange) {
+    return true;
+  }
+  const value = ifRange.trim();
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const etag = validators.etag?.trim();
+    return !!etag && value.startsWith('"') && etag.startsWith('"') && value === etag;
+  }
+  if (!validators.lastModified) {
+    return false;
+  }
+  const date = Date.parse(value);
+  return !Number.isNaN(date) && date === Date.parse(validators.lastModified);
+}
+
+/** Slices `body` to `[start, end]` (inclusive), lazily where possible. */
+export function sliceBody(body: BodyInit, range: ByteRange): BodyInit | Promise<BodyInit> {
+  const { start, end } = range;
+  const length = end - start + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body, start, Math.min(length, Math.max(body.byteLength - start, 0)));
+  }
+  if (ArrayBuffer.isView(body)) {
+    const available = Math.max(body.byteLength - start, 0);
+    return new Uint8Array(body.buffer, body.byteOffset + start, Math.min(length, available));
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, length);
+  }
+  // `FormData`, `URLSearchParams`, ...: no cheap way to slice, buffer it.
+  return new Response(body)
+    .arrayBuffer()
+    .then((buf) => new Uint8Array(buf).subarray(start, end + 1));
+}
+
+function sliceStream(source: ReadableStream, start: number, length: number): ReadableStream {
+  const reader = source.getReader();
+  let skip = start;
+  let remaining = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (remaining > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          break;
+        }
+        let chunk: Uint8Array;
+        if (typeof value === "string") {
+          chunk = new TextEncoder().encode(value);
+        } else if (value instanceof Uint8Array) {
+          chunk = value;
+        } else {
+          const error = new TypeError("Unsupported stream chunk type");
+          await reader.cancel(error).catch(() => {});
+          controller.error(error);
+          return;
+        }
+        if (skip >= chunk.byteLength) {
+          skip -= chunk.byteLength;
+          continue;
+        }
+        chunk = chunk.subarray(skip, skip + remaining);
+        skip = 0;
+        remaining -= chunk.byteLength;
+        controller.enqueue(chunk);
+        if (remaining > 0) {
+          return;
+        }
+      }
+      await reader.cancel().catch(() => {});
+      controller.close();
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
