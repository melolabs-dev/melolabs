diff --git a/test/static.test.ts b/test/static.test.ts
index f171202..be9e081 100644
--- a/test/static.test.ts
+++ b/test/static.test.ts
@@ -676,3 +676,215 @@ describe("serve static (malformed url)", () => {
     expect(servedId).not.toMatch(/(^|[\\/])\.\.([\\/]|$)/); // no bare `..` segment
   });
 });
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  const content = "0123456789".repeat(10);
+  const mtime = 1_700_000_000_000;
+  const lastModified = new Date(mtime).toUTCString();
+
+  let getContents: ReturnType<typeof vi.fn>;
+  let getMeta: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    getContents = vi.fn((): any => content);
+    getMeta = vi.fn((id: string) =>
+      id.includes("404")
+        ? undefined
+        : {
+            type: "text/plain",
+            etag: '"v1"',
+            mtime,
+            size: id.endsWith(".gz") ? 40 : content.length,
+          },
+    );
+    t.app.all("/**", (event) =>
+      serveStatic(event, {
+        getContents: getContents as ServeStaticOptions["getContents"],
+        getMeta: getMeta as ServeStaticOptions["getMeta"],
+        encodings: { gzip: ".gz" },
+        headers: { "cache-control": "max-age=60" },
+      }),
+    );
+  });
+
+  const range = (value: string, extra: Record<string, string> = {}, method = "GET") =>
+    t.fetch("/a.txt", { method, headers: { range: value, ...extra } });
+
+  it("advertises accept-ranges on 200 (GET/HEAD) and 304", async () => {
+    for (const method of ["GET", "HEAD"]) {
+      // node's fetch would otherwise negotiate the `.gz` variant
+      const res = await t.fetch("/a.txt", { method, headers: { "accept-encoding": "identity" } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-length")).toBe("100");
+    }
+    const res = await t.fetch("/a.txt", { headers: { "if-none-match": '"v1"' } });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  for (const [header, cr, body] of [
+    ["bytes=10-19", "10-19", content.slice(10, 20)],
+    ["bytes=90-", "90-99", content.slice(90)],
+    ["bytes=-10", "90-99", content.slice(90)],
+    ["bytes=90-999", "90-99", content.slice(90)],
+    ["bytes=-500", "0-99", content],
+  ] as const) {
+    it(`serves 206 for ${header}`, async () => {
+      const res = await range(header);
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe(`bytes ${cr}/100`);
+      expect(res.headers.get("content-length")).toBe(String(body.length));
+      expect(res.headers.get("etag")).toBe('"v1"');
+      expect(res.headers.get("last-modified")).toBe(lastModified);
+      expect(res.headers.get("cache-control")).toBe("max-age=60");
+      expect(res.headers.get("vary")).toBe("accept-encoding");
+      expect(await res.text()).toBe(body);
+    });
+  }
+
+  it("HEAD with range gives 206 headers without calling getContents", async () => {
+    const get = await range("bytes=10-19");
+    const head = await range("bytes=10-19", {}, "HEAD");
+    expect(head.status).toBe(206);
+    expect(head.headers.get("content-range")).toBe(get.headers.get("content-range"));
+    expect(head.headers.get("content-length")).toBe("10");
+    expect(await head.text()).toBe("");
+    expect(getContents).toHaveBeenCalledTimes(1);
+  });
+
+  for (const header of ["bytes=100-", "bytes=150-200", "bytes=-0"]) {
+    it(`416 for ${header} (GET/HEAD)`, async () => {
+      for (const method of ["GET", "HEAD"]) {
+        const res = await range(header, {}, method);
+        expect(res.status).toBe(416);
+        expect(res.headers.get("content-range")).toBe("bytes */100");
+        expect(res.headers.get("content-length")).toBe("0");
+        expect(await res.text()).toBe("");
+      }
+      expect(getContents).not.toHaveBeenCalled();
+    });
+  }
+
+  for (const header of ["abc", "bytes=5-2", "bytes=", "items=0-1", "bytes=0-1,5-6"]) {
+    it(`ignores invalid or multi-range ${header} (RFC 9110: 5-2 is invalid)`, async () => {
+      const res = await range(header);
+      expect(res.status).toBe(200);
+      expect(res.headers.has("content-range")).toBe(false);
+      expect(await res.text()).toBe(content);
+    });
+  }
+
+  for (const size of [undefined, 0]) {
+    it(`ignores range without known size (${size})`, async () => {
+      getMeta.mockImplementation(() => ({ type: "text/plain", size }));
+      const res = await range("bytes=0-9");
+      expect(res.status).toBe(200);
+      expect(res.headers.has("accept-ranges")).toBe(false);
+      expect(await res.text()).toBe(content);
+    });
+  }
+
+  it("if-range: strong etag match gives 206", async () => {
+    expect((await range("bytes=0-9", { "if-range": '"v1"' })).status).toBe(206);
+  });
+
+  for (const ifRange of ['"v2"', 'W/"v1"', new Date(mtime - 1000).toUTCString(), "garbage"]) {
+    it(`if-range ${ifRange} (strong comparison) gives full 200`, async () => {
+      const res = await range("bytes=0-9", { "if-range": ifRange });
+      expect(res.status).toBe(200);
+      expect(await res.text()).toBe(content);
+    });
+  }
+
+  it("if-range: exact date gives 206; if-range without range gives 200", async () => {
+    expect((await range("bytes=0-9", { "if-range": lastModified })).status).toBe(206);
+    const res = await t.fetch("/a.txt", { headers: { "if-range": '"v1"' } });
+    expect(res.status).toBe(200);
+  });
+
+  it("304 is decided before range", async () => {
+    const res = await range("bytes=0-9", { "if-none-match": '"v1"' });
+    expect(res.status).toBe(304);
+    expect(res.headers.has("content-range")).toBe(false);
+  });
+
+  it("slices the encoded variant using its own size", async () => {
+    getContents.mockImplementation((id: string) => (id.endsWith(".gz") ? "g".repeat(40) : content));
+    const res = await range("bytes=10-19", { "accept-encoding": "gzip" });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 10-19/40");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(res.headers.get("content-type")).toBe("text/plain");
+    expect(await res.text()).toBe("g".repeat(10));
+
+    const unsat = await range("bytes=40-", { "accept-encoding": "gzip" });
+    expect(unsat.status).toBe(416);
+    expect(unsat.headers.has("content-encoding")).toBe(false);
+  });
+
+  it("404/405 carry no range headers", async () => {
+    const notFound = await t.fetch("/404.txt", { headers: { range: "bytes=0-9" } });
+    expect(notFound.status).toBe(404);
+    expect(notFound.headers.has("accept-ranges")).toBe(false);
+    expect(notFound.headers.has("content-range")).toBe(false);
+
+    const post = await t.fetch("/a.txt", { method: "POST", headers: { range: "bytes=0-9" } });
+    expect(post.status).toBe(405);
+    expect(post.headers.has("accept-ranges")).toBe(false);
+    expect(post.headers.has("content-range")).toBe(false);
+  });
+
+  it("range content-length wins over user header; user header kept without range", async () => {
+    const app = new H3().all("/**", (event) =>
+      serveStatic(event, {
+        getContents: getContents as ServeStaticOptions["getContents"],
+        getMeta: getMeta as ServeStaticOptions["getMeta"],
+        headers: { "content-length": "999" },
+      }),
+    );
+    const partial = await app.request("/a.txt", { headers: { range: "bytes=0-9" } });
+    expect(partial.headers.get("content-length")).toBe("10");
+    await partial.arrayBuffer();
+    const full = await app.request("/a.txt", { method: "HEAD" });
+    expect(full.headers.get("content-length")).toBe("999");
+  });
+
+  const bodies: [string, () => BodyInit][] = [
+    ["string", () => content],
+    ["Blob", () => new Blob([content])],
+    ["Uint8Array", () => new TextEncoder().encode(content)],
+    ["ArrayBuffer", () => new TextEncoder().encode(content).buffer as ArrayBuffer],
+    [
+      "ReadableStream",
+      () =>
+        new ReadableStream({
+          start(c) {
+            const bytes = new TextEncoder().encode(content);
+            c.enqueue(bytes.subarray(0, 15));
+            c.enqueue(bytes.subarray(15, 60));
+            c.enqueue(bytes.subarray(60));
+            c.close();
+          },
+        }),
+    ],
+  ];
+
+  for (const [name, make] of bodies) {
+    it(`slices ${name} bodies`, async () => {
+      getContents.mockImplementation(make);
+      const res = await range("bytes=12-71");
+      expect(res.status).toBe(206);
+      expect(await res.text()).toBe(content.slice(12, 72));
+    });
+  }
+
+  // A known size with no contents never ends in node (same as without `range`).
+  it.skipIf(t.target === "node")("empty contents with range falls back to empty 200", async () => {
+    getContents.mockImplementation(() => undefined);
+    const res = await range("bytes=0-9");
+    expect(res.status).toBe(200);
+    expect(res.headers.has("content-range")).toBe(false);
+    expect(await res.text()).toBe("");
+  });
+});
diff --git a/test/unit/range.test.ts b/test/unit/range.test.ts
