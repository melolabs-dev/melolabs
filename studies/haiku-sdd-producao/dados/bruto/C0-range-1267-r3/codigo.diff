+
+type ByteRange = { start: number; end: number }; // `end` is inclusive
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/** Parse a single `bytes` range (RFC 9110 section 14.2). `undefined` means "ignore the header". */
+function parseRange(header: string | null, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = header && RANGE_RE.exec(header.trim());
+  if (!match) {
+    return;
+  }
+  const first = match[1] ? Number(match[1]) : undefined;
+  const last = match[2] ? Number(match[2]) : undefined;
+  if (first === undefined && last === undefined) {
+    return;
+  }
+  if (
+    (first !== undefined && !Number.isSafeInteger(first)) ||
+    (last !== undefined && !Number.isSafeInteger(last))
+  ) {
+    return;
+  }
+  if (first === undefined) {
+    // Suffix range: the last `last` bytes.
+    return !last || size === 0
+      ? "unsatisfiable"
+      : { start: Math.max(size - last, 0), end: size - 1 };
+  }
+  if (last !== undefined && last < first) {
+    return;
+  }
+  if (first >= size) {
+    return "unsatisfiable";
+  }
+  return { start: first, end: last === undefined ? size - 1 : Math.min(last, size - 1) };
+}
+
+/** Strong ETag match, or a date identical to the `last-modified` sent (RFC 9110 section 13.1.5). */
+function isIfRangeFresh(
+  ifRange: string | null,
+  sent: { etag: string | null; lastModified: string | null },
+): boolean {
+  const value = ifRange?.trim();
+  if (!value) {
+    return false;
+  }
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    return /^"[^"]*"$/.test(value) && sent.etag === value;
+  }
+  return sent.lastModified === value;
+}
+
+function sliceBody(body: BodyInit, start: number, end: number): BodyInit {
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1) as unknown as BodyInit;
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(start, end + 1) as unknown as BodyInit;
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(
+      start,
+      end + 1,
+    ) as unknown as BodyInit;
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  const stream = body instanceof ReadableStream ? body : new Response(body).body;
+  return stream ? sliceStream(stream, start, end) : body;
+}
+
+function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let skip = start;
+  let remaining = end - start + 1;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          return controller.close();
+        }
+        if (!(value instanceof Uint8Array)) {
+          const error = new TypeError("Range body stream chunks must be Uint8Array");
+          await reader.cancel(error).catch(() => {});
+          return controller.error(error);
+        }
+        let chunk = value;
+        if (skip > 0) {
+          if (skip >= chunk.length) {
+            skip -= chunk.length;
+            continue;
+          }
+          chunk = chunk.subarray(skip);
+          skip = 0;
+        }
+        if (chunk.length >= remaining) {
+          controller.enqueue(chunk.subarray(0, remaining));
+          remaining = 0;
+          controller.close();
+          await reader.cancel().catch(() => {});
+          return;
+        }
+        remaining -= chunk.length;
+        controller.enqueue(chunk);
+        return;
+      }
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
