new file mode 100644
index 0000000..3ae04b4
--- /dev/null
+++ b/src/utils/internal/range.ts
@@ -0,0 +1,118 @@
+export type ByteRange = { start: number; end: number };
+
+type Validators = { etag?: string | null; lastModified?: string | null };
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/** `undefined` = ignore Range (full 200); "unsatisfiable" = 416. */
+export function resolveRange(
+  headers: Headers,
+  size: number,
+  validators: Validators,
+): ByteRange | "unsatisfiable" | undefined {
+  const range = headers.get("range");
+  if (!range || !isIfRangeFresh(headers.get("if-range"), validators)) {
+    return undefined;
+  }
+  return parseRange(range, size);
+}
+
+export function parseRange(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first, last] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  // Huge digit strings become large floats (or `Infinity`) and are clamped to `size` below.
+  if (first === "") {
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last === "" ? Number.POSITIVE_INFINITY : Number(last);
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/** Strong comparison (RFC 9110 section 13.1.5). `true` when there is no `If-Range`. */
+export function isIfRangeFresh(ifRange: string | null, validators: Validators): boolean {
+  const value = ifRange?.trim();
+  if (!value) {
+    return true;
+  }
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const etag = validators.etag;
+    return !!etag && !value.startsWith("W/") && !etag.startsWith("W/") && value === etag;
+  }
+  const date = Date.parse(value);
+  const lastModified = validators.lastModified ? Date.parse(validators.lastModified) : Number.NaN;
+  return Number.isFinite(date) && date === lastModified;
+}
+
+/** Slices `start..end` (inclusive) bytes out of a body. */
+export function sliceBody(body: BodyInit, { start, end }: ByteRange): BodyInit {
+  const stop = end + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, stop) as BodyInit;
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, stop);
+  }
+  if (body instanceof ArrayBuffer || body instanceof SharedArrayBuffer) {
+    return new Uint8Array(body, start, stop - start) as BodyInit;
+  }
+  if (ArrayBuffer.isView(body)) {
+    const bytes = new Uint8Array(body.buffer, body.byteOffset, body.byteLength);
+    return bytes.subarray(start, stop) as BodyInit;
+  }
+  const stream = body instanceof ReadableStream ? body : new Response(body).body!;
+  return sliceStream(stream, start, stop - start);
+}
+
+// --- Internal Utils ---
+
+function sliceStream(stream: ReadableStream, skip: number, length: number): ReadableStream {
+  const reader = stream.getReader();
+  let remaining = length;
+  return new ReadableStream({
+    async pull(controller) {
+      while (remaining > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          break;
+        }
+        let chunk: Uint8Array = value;
+        if (skip > 0) {
+          if (skip >= chunk.byteLength) {
+            skip -= chunk.byteLength;
+            continue;
+          }
+          chunk = chunk.subarray(skip);
+          skip = 0;
+        }
+        if (chunk.byteLength > remaining) {
+          chunk = chunk.subarray(0, remaining);
+        }
+        remaining -= chunk.byteLength;
+        controller.enqueue(chunk);
+        if (remaining > 0) {
+          return;
+        }
+      }
+      controller.close();
+      await reader.cancel().catch(() => {});
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
