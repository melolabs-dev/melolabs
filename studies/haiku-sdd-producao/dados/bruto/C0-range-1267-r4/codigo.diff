diff --git a/test/static.test.ts b/test/static.test.ts
index f171202..7c3d3b6 100644
--- a/test/static.test.ts
+++ b/test/static.test.ts
@@ -676,3 +676,213 @@ describe("serve static (malformed url)", () => {
     expect(servedId).not.toMatch(/(^|[\\/])\.\.([\\/]|$)/); // no bare `..` segment
   });
 });
+
+describeMatrix("serve static range", (t, { it: matrixIt, expect }) => {
+  // The matrix `it` has no `each`: expand cases into one test per row.
+  const it = Object.assign(matrixIt, {
+    each: (cases: any[]) => (name: string, fn: (...args: any[]) => unknown) => {
+      for (const row of cases) {
+        const args = Array.isArray(row) ? row : [row];
+        let i = 0;
+        matrixIt(
+          name.replace(/%[si]/g, () => String(args[i++])),
+          () => fn(...args),
+        );
+      }
+    },
+  });
+  const mtime = 1_700_000_000_000;
+  const lastModified = new Date(mtime).toUTCString();
+  let meta: Record<string, any>;
+  let contents: any;
+  let getContents: ReturnType<typeof vi.fn<NonNullable<ServeStaticOptions["getContents"]>>>;
+  let headers: Record<string, string> | undefined;
+
+  const setup = () => {
+    getContents = vi.fn(() => (typeof contents === "function" ? contents() : contents));
+    t.app.all("/**", (event) =>
+      serveStatic(event, {
+        getContents,
+        getMeta: (id) => (id.includes("404") ? undefined : { ...meta }),
+        encodings: meta.encodings,
+        headers,
+      }),
+    );
+  };
+
+  beforeEach(() => {
+    meta = { size: 10, etag: '"abc"', mtime };
+    contents = "0123456789";
+    headers = undefined;
+  });
+
+  const get = (range?: string, init: RequestInit = {}) => {
+    setup();
+    return t.fetch("/a.txt", {
+      ...init,
+      headers: { ...(range ? { range } : {}), ...(init.headers as any) },
+    });
+  };
+
+  it("advertises accept-ranges on GET and HEAD", async () => {
+    for (const method of ["GET", "HEAD"]) {
+      const res = await get(undefined, { method });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-range")).toBeNull();
+    }
+  });
+
+  it.each([
+    ["bytes=2-5", "2345", "bytes 2-5/10"],
+    ["bytes=4-", "456789", "bytes 4-9/10"],
+    ["bytes=-3", "789", "bytes 7-9/10"],
+    ["bytes=8-999", "89", "bytes 8-9/10"],
+    ["bytes=-50", "0123456789", "bytes 0-9/10"],
+    ["bytes=0-99999999999999999999", "0123456789", "bytes 0-9/10"],
+  ])("serves %s as 206", async (range, body, contentRange) => {
+    const res = await get(range);
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(body);
+    expect(res.headers.get("content-range")).toBe(contentRange);
+    expect(res.headers.get("content-length")).toBe(body.length + "");
+    expect(res.headers.get("etag")).toBe('"abc"');
+    expect(res.headers.get("last-modified")).toBe(lastModified);
+  });
+
+  it("HEAD with range returns headers only", async () => {
+    const res = await get("bytes=2-5", { method: "HEAD" });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("");
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it.each(["bytes=10-20", "bytes=-0", "bytes=99999999999999999999-"])(
+    "responds 416 for %s",
+    async (range) => {
+      for (const method of ["GET", "HEAD"]) {
+        const res = await get(range, { method });
+        expect(res.status).toBe(416);
+        expect(res.headers.get("content-range")).toBe("bytes */10");
+        expect(res.headers.get("content-length")).toBe("0");
+        expect(res.headers.get("etag")).toBe('"abc"');
+        expect(await res.text()).toBe("");
+      }
+      expect(getContents).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(["bytes=abc", "bytes=5-2", "bytes=0-1,4-5", "items=0-1", "bytes=", "bytes=-"])(
+    "ignores range %s",
+    async (range) => {
+      const res = await get(range);
+      expect(res.status).toBe(200);
+      expect(await res.text()).toBe("0123456789");
+      expect(res.headers.get("content-range")).toBeNull();
+    },
+  );
+
+  it.each([
+    ['"abc"', 206],
+    [lastModified, 206],
+    ['"other"', 200],
+    ['W/"abc"', 200],
+    [new Date(mtime + 5000).toUTCString(), 200],
+    ["not-a-date", 200],
+  ])("If-Range %s -> %i", async (ifRange, status) => {
+    const res = await get("bytes=0-3", { headers: { "if-range": ifRange as string } });
+    expect(res.status).toBe(status);
+  });
+
+  it("If-Range without validators ignores range", async () => {
+    meta = { size: 10 };
+    const res = await get("bytes=0-3", { headers: { "if-range": '"abc"' } });
+    expect(res.status).toBe(200);
+  });
+
+  it.each([undefined, 0])("does not apply range with size %s", async (size) => {
+    meta = { size };
+    for (const range of ["bytes=0-3", "bytes=50-60"]) {
+      const res = await get(range);
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(res.headers.get("accept-ranges")).toBeNull();
+    }
+  });
+
+  it("304 wins over range", async () => {
+    const res = await get("bytes=0-3", { headers: { "if-none-match": '"abc"' } });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("serves range of the encoded variant", async () => {
+    meta = { size: 10, encodings: { gzip: ".gz" } };
+    const res = await get("bytes=0-3", { headers: { "accept-encoding": "gzip" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("0123");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(res.headers.get("content-range")).toBe("bytes 0-3/10");
+  });
+
+  it("keeps 404 and 405 behavior with range", async () => {
+    setup();
+    expect((await t.fetch("/404.txt", { headers: { range: "bytes=0-1" } })).status).toBe(404);
+    const res = await t.fetch("/a.txt", { method: "POST", headers: { range: "bytes=0-1" } });
+    expect(res.status).toBe(405);
+  });
+
+  it("falls back to 200 when getContents returns nothing", async () => {
+    contents = undefined;
+    const res = await get("bytes=0-3");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("slices multibyte strings by UTF-8 bytes", async () => {
+    contents = "aé€b"; // 1 + 2 + 3 + 1 bytes
+    meta = { size: 7 };
+    const res = await get("bytes=1-2");
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("é");
+  });
+
+  it.each([
+    ["Uint8Array", () => new TextEncoder().encode("0123456789")],
+    ["ArrayBuffer", () => new TextEncoder().encode("0123456789").buffer],
+    ["Blob", () => new Blob(["0123456789"])],
+    [
+      "ReadableStream",
+      () =>
+        new ReadableStream({
+          start(c) {
+            for (const s of ["012", "345", "678", "9"]) c.enqueue(new TextEncoder().encode(s));
+            c.close();
+          },
+        }),
+    ],
+  ])("slices %s bodies", async (_name, make) => {
+    contents = make;
+    const res = await get("bytes=2-5");
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("2345");
+    expect(res.headers.get("content-length")).toBe("4");
+  });
+
+  it("preserves user headers but not user content-length", async () => {
+    headers = { "cache-control": "public, max-age=60", "content-length": "999" };
+    const ok = await get();
+    expect(ok.headers.get("content-length")).toBe("999");
+    expect(ok.headers.get("cache-control")).toBe("public, max-age=60");
+    for (const [range, len] of [
+      ["bytes=0-3", "4"],
+      ["bytes=20-", "0"],
+    ]) {
+      const res = await get(range);
+      expect(res.headers.get("cache-control")).toBe("public, max-age=60");
+      expect(res.headers.get("content-length")).toBe(len);
+    }
+  });
+});
diff --git a/test/unit/range.test.ts b/test/unit/range.test.ts
new file mode 100644
index 0000000..f82770f
--- /dev/null
+++ b/test/unit/range.test.ts
@@ -0,0 +1,95 @@
+import { describe, it, expect } from "vitest";
+import {
+  isIfRangeFresh,
+  parseRange,
+  resolveRange,
+  sliceBody,
+} from "../../src/utils/internal/range.ts";
+
+const text = async (body: BodyInit) => await new Response(body).text();
+
+describe("parseRange", () => {
+  it("parses valid forms", () => {
+    expect(parseRange("bytes=2-5", 10)).toEqual({ start: 2, end: 5 });
+    expect(parseRange(" BYTES=4- ", 10)).toEqual({ start: 4, end: 9 });
+    expect(parseRange("bytes=-3", 10)).toEqual({ start: 7, end: 9 });
+    expect(parseRange("bytes=-50", 10)).toEqual({ start: 0, end: 9 });
+    expect(parseRange("bytes=8-99", 10)).toEqual({ start: 8, end: 9 });
+  });
+  it("detects unsatisfiable and ignored ranges", () => {
+    expect(parseRange("bytes=10-", 10)).toBe("unsatisfiable");
+    expect(parseRange("bytes=-0", 10)).toBe("unsatisfiable");
+    for (const v of [
+      "bytes=-",
+      "bytes=5-2",
+      "bytes=a-b",
+      "bytes=0-1,3-4",
+      "bytes = 0-1",
+      "x=0-1",
+    ]) {
+      expect(parseRange(v, 10)).toBeUndefined();
+    }
+  });
+  it("handles huge numbers", () => {
+    const big = "9".repeat(400);
+    expect(parseRange(`bytes=0-${big}`, 10)).toEqual({ start: 0, end: 9 });
+    expect(parseRange(`bytes=${big}-`, 10)).toBe("unsatisfiable");
+    expect(parseRange(`bytes=-${big}`, 10)).toEqual({ start: 0, end: 9 });
+  });
+});
+
+describe("isIfRangeFresh", () => {
+  const lm = new Date(1_700_000_000_000).toUTCString();
+  it("compares etags strongly", () => {
+    expect(isIfRangeFresh(null, {})).toBe(true);
+    expect(isIfRangeFresh('"a"', { etag: '"a"' })).toBe(true);
+    expect(isIfRangeFresh('"a"', { etag: '"b"' })).toBe(false);
+    expect(isIfRangeFresh('W/"a"', { etag: 'W/"a"' })).toBe(false);
+    expect(isIfRangeFresh('"a"', { etag: 'W/"a"' })).toBe(false);
+    expect(isIfRangeFresh('"a"', {})).toBe(false);
+  });
+  it("compares dates exactly", () => {
+    expect(isIfRangeFresh(lm, { lastModified: lm })).toBe(true);
+    expect(isIfRangeFresh(new Date(0).toUTCString(), { lastModified: lm })).toBe(false);
+    expect(isIfRangeFresh("nope", { lastModified: lm })).toBe(false);
+    expect(isIfRangeFresh(lm, {})).toBe(false);
+  });
+});
+
+describe("resolveRange", () => {
+  it("handles missing range and stale If-Range", () => {
+    expect(resolveRange(new Headers(), 10, {})).toBeUndefined();
+    const h = new Headers({ range: "bytes=0-1", "if-range": '"x"' });
+    expect(resolveRange(h, 10, { etag: '"y"' })).toBeUndefined();
+    expect(resolveRange(h, 10, { etag: '"x"' })).toEqual({ start: 0, end: 1 });
+  });
+});
+
+describe("sliceBody", () => {
+  const r = { start: 2, end: 5 };
+  it("slices bodies", async () => {
+    const bytes = new TextEncoder().encode("xx0123456789").subarray(2);
+    expect(await text(sliceBody("0123456789", r))).toBe("2345");
+    expect(await text(sliceBody("aé€b", { start: 1, end: 2 }))).toBe("é");
+    expect(await text(sliceBody(bytes, r))).toBe("2345");
+    expect(await text(sliceBody(bytes.slice().buffer, r))).toBe("2345");
+    expect(await text(sliceBody(new Blob(["0123456789"]), r))).toBe("2345");
+    expect(await text(sliceBody(new URLSearchParams({ a: "1" }), { start: 1, end: 2 }))).toBe("=1");
+  });
+  it("cancels streams at the end of the range", async () => {
+    let pulled = 0;
+    let cancelled = false;
+    const stream = new ReadableStream({
+      pull(c) {
+        pulled++;
+        c.enqueue(new TextEncoder().encode("0123"));
+      },
+      cancel() {
+        cancelled = true;
+      },
+    });
+    expect(await text(sliceBody(stream, { start: 1, end: 5 }))).toBe("12301");
+    expect(cancelled).toBe(true);
+    expect(pulled).toBeLessThan(5);
+  });
+});
