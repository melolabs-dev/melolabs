+  ) {
+    getContents = vi.fn(opts.contents ?? (() => CONTENT));
+    getMeta = vi.fn((id: string) =>
+      id.includes("404")
+        ? undefined
+        : {
+            type: "text/plain",
+            etag: '"abc"',
+            mtime: 1_700_000_000_000,
+            size: CONTENT.length,
+            ...(id.endsWith(".gz") ? { encoding: "gzip", size: 30 } : {}),
+            ...opts.meta,
+          },
+    );
+    t.app.use((event) =>
+      serveStatic(event, { getContents, getMeta, ...opts.options } as ServeStaticOptions),
+    );
+  }
+
+  // The matrix `it` has no `.each`.
+  const each = (cases: any[]) => (title: string, fn: (...args: any[]) => Promise<void>) => {
