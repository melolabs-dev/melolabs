 // --- Internal Utils ---
 
+type ByteRange = { start: number; end: number };
+
+type RangeDecision =
+  | { type: "ignore" }
+  | { type: "partial"; range: ByteRange }
+  | { type: "unsatisfiable" };
+
+const RANGE_RE = /^\s*bytes\s*=\s*(\d*)\s*-\s*(\d*)\s*$/i;
+
+/** Decide how a `Range` request is handled for an asset of `size` bytes (RFC 9110 section 14). */
+function resolveRange(event: H3Event, size: number | undefined): RangeDecision {
+  const header = event.req.headers.get("range");
+  if (!header || size === undefined || !Number.isInteger(size) || size < 0) {
+    return { type: "ignore" };
+  }
+  const range = parseRange(header, size);
+  if (!range) {
+    return { type: "ignore" };
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (ifRange && !isIfRangeValid(ifRange, event.res.headers)) {
+    return { type: "ignore" };
+  }
+  return range === "unsatisfiable" ? { type: "unsatisfiable" } : { type: "partial", range };
+}
+
+/** Parse a single `bytes` range; `undefined` means the header must be ignored. */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(header);
+  if (!match) {
+    return;
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return;
+  }
+  const a = first ? Number(first) : undefined;
+  const b = last ? Number(last) : undefined;
+  if (
+    (a !== undefined && !Number.isSafeInteger(a)) ||
+    (b !== undefined && !Number.isSafeInteger(b))
+  ) {
+    return;
+  }
+  if (a === undefined) {
+    // Suffix range: the last `b` bytes.
+    if (!b || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - b, 0), end: size - 1 };
+  }
+  if (b !== undefined && b < a) {
+    return;
+  }
+  if (a >= size) {
+    return "unsatisfiable";
+  }
+  return { start: a, end: b === undefined ? size - 1 : Math.min(b, size - 1) };
+}
+
+/** `If-Range` (RFC 9110 section 13.1.5), checked against the validators being sent. */
+function isIfRangeValid(ifRange: string, resHeaders: Headers): boolean {
+  const value = ifRange.trim();
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const etag = resHeaders.get("etag");
+    return !!etag && !value.startsWith("W/") && !etag.startsWith("W/") && etag === value;
+  }
+  const lastModified = resHeaders.get("last-modified");
+  return !!lastModified && lastModified === value;
+}
+
+/** Slice a body to `range`; `undefined` when the body type cannot be sliced. */
+function sliceBody(body: BodyInit, { start, end }: ByteRange): BodyInit | undefined {
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(
+      body,
+      Math.min(start, body.byteLength),
+      clampLength(body.byteLength, start, end),
+    );
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(
+      body.buffer,
+      body.byteOffset + Math.min(start, body.byteLength),
+      clampLength(body.byteLength, start, end),
+    );
+  }
+  if (typeof Blob !== "undefined" && body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (typeof ReadableStream !== "undefined" && body instanceof ReadableStream) {
+    return sliceStream(body, start, end - start + 1);
+  }
+}
+
+function clampLength(total: number, start: number, end: number): number {
+  return Math.max(Math.min(end + 1, total) - start, 0);
+}
+
+/** Skip `skip` bytes, forward `length` bytes, then cancel the source. */
+function sliceStream(stream: ReadableStream, skip: number, length: number): ReadableStream {
+  const reader = stream.getReader();
+  let toSkip = skip;
+  let remaining = length;
+  return new ReadableStream({
+    async pull(controller) {
+      while (remaining > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          break;
+        }
+        const chunk = value instanceof Uint8Array ? value : new TextEncoder().encode(String(value));
+        if (toSkip >= chunk.length) {
+          toSkip -= chunk.length;
+          continue;
+        }
+        const part = chunk.subarray(toSkip, toSkip + remaining);
+        toSkip = 0;
+        remaining -= part.length;
+        controller.enqueue(part);
+        if (remaining > 0) {
+          return;
+        }
+      }
+      controller.close();
+      await reader.cancel().catch(() => {});
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
