 // --- Internal Utils ---
 
+// Result of evaluating a `Range` header: a satisfiable (inclusive, clamped)
+// range, `"unsatisfiable"` (416) or `undefined` (ignore the header, serve 200).
+type ByteRange = { start: number; end: number } | "unsatisfiable" | undefined;
+
+const RANGE_RE = /^\s*bytes\s*=\s*(\d*)\s*-\s*(\d*)\s*$/i;
+
+/** Parse a single `bytes` range (RFC 9110 section 14.1.2). Anything else is ignored. */
+function parseRange(header: string | null, size: number): ByteRange {
+  const match = header && RANGE_RE.exec(header);
+  if (!match) {
+    return;
+  }
+  const [, first, last] = match;
+  if (!first && !last) {
+    return;
+  }
+  if (!first) {
+    const suffix = Number(last);
+    return suffix === 0 ? "unsatisfiable" : { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last && Number(last) < start) {
+    return;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: last ? Math.min(Number(last), size - 1) : size - 1 };
+}
+
+/** `If-Range` needs strong validation (RFC 9110 section 13.1.5), unlike `If-None-Match`. */
+function ifRangeMatches(
+  ifRange: string | null,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  const value = ifRange?.trim();
+  if (value === undefined) {
+    return true;
+  }
+  if (value.startsWith("W/") || validators.etag?.startsWith("W/")) {
+    return false;
+  }
+  if (value.startsWith('"')) {
+    return value === validators.etag;
+  }
+  const date = Date.parse(value);
+  return (
+    Number.isFinite(date) && !!validators.lastModified && date === validators.lastModified.getTime()
+  );
+}
+
+/** Slice `[start, end]` (inclusive, in bytes) out of a body, or `undefined` if the type can't be sliced. */
+function sliceBody(body: BodyInit, start: number, end: number): BodyInit | undefined {
+  const length = end - start + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1) as BodyInit;
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (
+    body instanceof ArrayBuffer ||
+    (typeof SharedArrayBuffer !== "undefined" && body instanceof SharedArrayBuffer)
+  ) {
+    return new Uint8Array(body, start, length) as BodyInit;
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset + start, length) as BodyInit;
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, length);
+  }
+}
+
+function sliceStream(source: ReadableStream, start: number, length: number): ReadableStream {
+  const reader = source.getReader();
+  const encoder = new TextEncoder();
+  let skipped = 0;
+  let sent = 0;
+  return new ReadableStream({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          return controller.close();
+        }
+        let chunk: Uint8Array = typeof value === "string" ? encoder.encode(value) : value;
+        const drop = Math.min(start - skipped, chunk.length);
+        skipped += drop;
+        chunk = chunk.subarray(drop);
+        if (chunk.length === 0) {
+          continue;
+        }
+        const part = chunk.subarray(0, length - sent);
+        sent += part.length;
+        controller.enqueue(part);
+        if (sent >= length) {
+          await reader.cancel();
+          controller.close();
+        }
+        return;
+      }
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
