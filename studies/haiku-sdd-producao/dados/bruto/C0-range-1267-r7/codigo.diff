+describeMatrix("serve static range", (t, { it, expect }) => {
+  const mtime = 1_700_000_000_000;
+  const lastModified = new Date(mtime).toUTCString();
+  let getContents: ReturnType<typeof vi.fn<(id: string) => any>>;
+  let body: any;
+  let meta: any;
+  let extra: Partial<ServeStaticOptions>;
+
+  beforeEach(() => {
+    body = "0123456789";
+    meta = { size: 10, etag: '"abc"', mtime };
+    extra = {};
+    getContents = vi.fn(() => body);
+    t.app.all("/**", (event) =>
+      serveStatic(event, {
+        getContents,
+        getMeta: (id) => (id.includes("404") ? undefined : { ...meta }),
+        ...extra,
+      }),
+    );
+  });
+
+  const req = (headers: Record<string, string>, method = "GET", path = "/f.txt") =>
+    t.fetch(path, { method, headers });
+
+  it("advertises accept-ranges without Range", async () => {
+    for (const method of ["GET", "HEAD"]) {
+      const res = await req({}, method);
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-range")).toBeNull();
+      if (method === "GET") expect(await res.text()).toBe("0123456789");
+    }
+  });
+
+  it("ignores Range and omits accept-ranges without a known size", async () => {
+    for (const size of [undefined, 0]) {
+      meta.size = size;
+      const res = await req({ range: "bytes=0-3" });
+      expect(res.status).toBe(200);
+      expect(await res.text()).toBe("0123456789");
+      expect(res.headers.get("accept-ranges")).toBeNull();
+      expect(res.headers.get("content-range")).toBeNull();
+    }
+  });
+
+  for (const [range, text, cr] of [
+    ["bytes=2-5", "2345", "2-5"],
+    ["bytes=7-99", "789", "7-9"],
+    ["bytes=7-", "789", "7-9"],
+    ["bytes=-3", "789", "7-9"],
+    ["bytes=-99", "0123456789", "0-9"],
+    ["Bytes=0-1", "01", "0-1"],
+    ["  bytes = 0 - 1  ", "01", "0-1"],
+  ] as const) {
+    it(`serves ${range} as 206`, async () => {
+      const res = await req({ range });
+      expect(res.status).toBe(206);
+      expect(await res.text()).toBe(text);
+      expect(res.headers.get("content-range")).toBe(`bytes ${cr}/10`);
+      expect(res.headers.get("content-length")).toBe(String(text.length));
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+    });
+  }
+
+  for (const range of [
+    "bytes=abc",
+    "bytes=5-2",
+    "bytes=",
+    "bytes=-",
+    "bytes=0-1,4-5",
+    "items=0-1",
+  ]) {
+    it(`ignores ${range}`, async () => {
+      const res = await req({ range });
+      expect(res.status).toBe(200);
+      expect(await res.text()).toBe("0123456789");
+      expect(res.headers.get("content-range")).toBeNull();
+    });
+  }
+
+  it("answers HEAD with 206 headers only", async () => {
+    const res = await req({ range: "bytes=2-5" }, "HEAD");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  for (const [range, method] of [
+    ["bytes=10-20", "GET"],
+    ["bytes=-0", "GET"],
+    ["bytes=10-20", "HEAD"],
+  ] as const) {
+    it(`answers ${range} (${method}) with 416`, async () => {
+      extra.headers = { "content-length": "999" };
+      const res = await req({ range }, method);
+      expect(res.status).toBe(416);
+      expect(res.headers.get("content-range")).toBe("bytes */10");
+      expect(res.headers.get("content-length")).toBe("0");
+      expect(await res.text()).toBe("");
+      expect(getContents).not.toHaveBeenCalled();
+    });
+  }
+
+  it("overrides a user content-length on 206 only", async () => {
+    extra.headers = { "content-length": "999" };
