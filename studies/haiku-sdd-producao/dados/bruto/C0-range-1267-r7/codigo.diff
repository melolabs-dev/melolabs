+
+    it("matches an exact date only", async () => {
+      expect((await req({ range: "bytes=0-3", "if-range": lastModified })).status).toBe(206);
+      const other = new Date(mtime + 5000).toUTCString();
+      expect((await req({ range: "bytes=0-3", "if-range": other })).status).toBe(200);
+      expect((await req({ range: "bytes=0-3", "if-range": "garbage" })).status).toBe(200);
+    });
+
+    it("is ignored without Range", async () => {
+      const res = await req({ "if-range": '"other"' });
+      expect(res.status).toBe(200);
+    });
+  });
+
+  it("gives If-None-Match precedence over Range", async () => {
+    const res = await req({ range: "bytes=0-3", "if-none-match": '"abc"' });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    const res2 = await req({ range: "bytes=0-3", "if-modified-since": lastModified });
+    expect(res2.status).toBe(304);
+  });
+
+  it("applies Range to the chosen encoded variant", async () => {
+    extra.encodings = { gzip: ".gz" };
+    t.app.all("/enc/**", (event) =>
+      serveStatic(event, {
+        getContents,
+        getMeta: (id) =>
+          id.endsWith(".gz")
+            ? { size: 20, encoding: "gzip", type: "text/plain" }
+            : { size: 10, type: "text/plain" },
+        encodings: { gzip: ".gz" },
+      }),
+    );
+    body = "x".repeat(20);
+    const res = await req({ range: "bytes=0-4", "accept-encoding": "gzip" }, "GET", "/enc/a.txt");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBe("bytes 0-4/20");
+    expect(res.headers.get("content-length")).toBe("5");
+    expect(res.headers.get("vary")).toContain("accept-encoding");
+    expect(res.headers.get("content-type")).toBe("text/plain");
+  });
+
+  it("keeps 404 and 405 behavior with Range", async () => {
+    expect((await req({ range: "bytes=0-3" }, "GET", "/404")).status).toBe(404);
+    const post = await req({ range: "bytes=0-3" }, "POST");
+    expect(post.status).toBe(405);
+  });
+
+  describe("body types", () => {
