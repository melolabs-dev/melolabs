+      expect(await res.text()).toBe(BODY);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(res.headers.get("accept-ranges")).toBeNull();
+    }
+  });
+
+  describe("If-Range", () => {
+    for (const [name, value, status, meta] of [
+      ["same strong etag", '"v1"', 206, {}],
+      ["different etag", '"v2"', 200, {}],
+      ["weak etag in header", 'W/"v1"', 200, {}],
+      ["weak etag on asset", 'W/"v1"', 200, { etag: 'W/"v1"' }],
+      ["same date", LAST_MODIFIED, 206, {}],
+      ["different date", "Wed, 03 Jan 2024 03:04:05 GMT", 200, {}],
