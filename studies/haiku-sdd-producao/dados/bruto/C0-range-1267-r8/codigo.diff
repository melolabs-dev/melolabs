+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  it("ranges over the chosen precompressed variant", async () => {
+    const files: Record<string, string> = {
+      "/app.js": "x".repeat(30),
+      "/app.js.gz": "abcdefghijklmnopqrst",
+    };
+    const options: ServeStaticOptions = {
+      encodings: { gzip: ".gz" },
+      getContents: (id) => files[id],
+      getMeta: (id) =>
