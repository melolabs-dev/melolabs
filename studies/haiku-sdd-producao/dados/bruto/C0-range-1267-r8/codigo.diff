+    };
+    // Web-only: node's fetch would try to gunzip the fake payload.
+    const app = new H3().all("/**", (event) => serveStatic(event, options));
+    const res = await app.request("/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-4" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBe("bytes 0-4/20");
+    expect(res.headers.get("content-length")).toBe("5");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(await res.text()).toBe("abcde");
+  });
+
+  it("overrides a caller content-length on 206/416 but keeps other headers", async () => {
+    setup({ headers: { "content-length": "10", "accept-ranges": "custom" } });
+    const full = await get();
+    const res = await get("bytes=2-5");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("accept-ranges")).toBe("custom");
+    for (const h of ["etag", "last-modified", "content-type"]) {
+      expect(res.headers.get(h), h).toBe(full.headers.get(h));
+    }
+    const res416 = await get("bytes=10-");
+    expect(res416.status).toBe(416);
+    expect(res416.headers.get("content-length")).toBe("0");
+  });
+
+  it("leaves 404, fallthrough and 405 untouched", async () => {
+    const notFound: ServeStaticOptions = { getContents: () => BODY, getMeta: () => undefined };
+    const app = new H3().all("/**", (event) => serveStatic(event, notFound));
+    const r404 = await app.request("/file.txt", { headers: { range: "bytes=0-3" } });
+    expect(r404.status).toBe(404);
+    expect(r404.headers.get("content-range")).toBeNull();
+
+    const ft = new H3()
+      .use((event) => serveStatic(event, { ...notFound, fallthrough: true }))
+      .use(() => "next");
+    const rft = await ft.request("/file.txt", { headers: { range: "bytes=0-3" } });
+    expect(await rft.text()).toBe("next");
+    expect(rft.headers.get("content-range")).toBeNull();
+    expect(rft.headers.get("accept-ranges")).toBeNull();
+
+    setup();
+    const r405 = await t.fetch("/file.txt", { method: "POST", headers: { range: "bytes=0-3" } });
+    expect(r405.status).toBe(405);
+    expect(r405.headers.get("accept-ranges")).toBeNull();
+  });
+
