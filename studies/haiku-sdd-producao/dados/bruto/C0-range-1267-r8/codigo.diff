 // --- Internal Utils ---
 
+type ByteRange = { start: number; end: number };
+
+const RANGE_RE = /^\s*bytes\s*=\s*(\d*)\s*-\s*(\d*)\s*$/i;
+
+/**
+ * Parse a single `bytes` range (RFC 9110 section 14.1.2).
+ *
+ * `undefined` means the header must be ignored (serve `200`), `"unsatisfiable"` means `416`.
+ */
+function parseRange(header: string | null, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = header && RANGE_RE.exec(header);
+  if (!match || (!match[1] && !match[2])) {
+    return;
+  }
+  if (!match[1]) {
+    // Suffix range: the last `n` bytes.
+    const length = Number(match[2]);
+    return length === 0 ? "unsatisfiable" : { start: Math.max(size - length, 0), end: size - 1 };
+  }
+  const start = Number(match[1]);
+  const end = match[2] ? Number(match[2]) : Infinity;
+  if (end < start) {
+    return;
+  }
+  return start >= size ? "unsatisfiable" : { start, end: Math.min(end, size - 1) };
+}
+
+/** Evaluate `If-Range` with strong comparison (RFC 9110 section 13.1.5). */
+function ifRangeAllows(
+  headers: Headers,
+  validators: { etag: string | null; lastModified: string | null },
+): boolean {
+  const value = headers.get("if-range")?.trim();
+  if (headers.get("if-range") === null) {
+    return true;
+  }
+  if (!value) {
+    return false;
+  }
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const { etag } = validators;
+    return !!etag && !value.startsWith("W/") && !etag.startsWith("W/") && value === etag;
+  }
+  const date = Date.parse(value);
+  const lastModified = validators.lastModified ? Date.parse(validators.lastModified) : Number.NaN;
+  return (
+    !Number.isNaN(date) &&
+    !Number.isNaN(lastModified) &&
+    Math.floor(date / 1000) === Math.floor(lastModified / 1000)
+  );
+}
+
+function setPartialHeaders(headers: Headers, range: ByteRange, size: number): void {
+  headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  headers.set("content-length", range.end - range.start + 1 + "");
+}
+
+/** Slice a body by bytes; `undefined` when the body type is not supported. */
+function sliceBody(body: BodyInit, { start, end }: ByteRange): BodyInit | undefined {
+  const length = end - start + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(start, end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    const bytes = new Uint8Array(body.buffer, body.byteOffset, body.byteLength);
+    return bytes.subarray(start, end + 1);
+  }
+  if (typeof Blob !== "undefined" && body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (typeof ReadableStream !== "undefined" && body instanceof ReadableStream) {
+    return sliceStream(body, start, length);
+  }
+}
+
+function sliceStream(source: ReadableStream, skip: number, length: number): ReadableStream {
+  const reader = source.getReader();
+  let remaining = length;
+  return new ReadableStream({
+    async pull(controller) {
+      while (remaining > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          return controller.close();
+        }
+        if (!(value instanceof Uint8Array)) {
+          const error = new TypeError("Cannot slice a stream of non-binary chunks");
+          await reader.cancel(error).catch(() => {});
+          return controller.error(error);
+        }
+        if (skip >= value.byteLength) {
+          skip -= value.byteLength;
+          continue;
+        }
+        const chunk = value.subarray(skip, skip + remaining);
+        skip = 0;
+        remaining -= chunk.byteLength;
+        controller.enqueue(chunk);
+        if (remaining <= 0) {
+          await reader.cancel().catch(() => {});
+          return controller.close();
+        }
+        return;
+      }
+      await reader.cancel().catch(() => {});
+      controller.close();
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
+
 // `qvalue` grammar (RFC 9110 section 12.4.2).
 const WEIGHT_RE = /^(?:0(?:\.\d{0,3})?|1(?:\.0{0,3})?)$/;
 
