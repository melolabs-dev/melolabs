+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  const BODY = "0123456789";
+  const MTIME = new Date("2024-01-02T03:04:05.678Z");
+  const LAST_MODIFIED = "Tue, 02 Jan 2024 03:04:05 GMT";
+
+  function setup(
+    overrides: Partial<ServeStaticOptions> & { meta?: Record<string, unknown> } = {},
+    contents: (id: string) => any = () => BODY,
+  ) {
+    const getContents = vi.fn(contents);
+    const { meta, ...rest } = overrides;
+    const options: ServeStaticOptions = {
+      getContents,
+      getMeta: () => ({ size: 10, etag: '"v1"', mtime: MTIME, ...meta }),
+      ...rest,
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+    return getContents;
+  }
+
+  const get = (range?: string, headers: Record<string, string> = {}, method = "GET") =>
+    t.fetch("/file.txt", {
+      method,
+      headers: { ...(range ? { range } : {}), ...headers },
+    });
+
+  it("advertises Accept-Ranges on GET and HEAD without Range", async () => {
+    setup();
+    for (const method of ["GET", "HEAD"]) {
+      const res = await get(undefined, {}, method);
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-length")).toBe("10");
+      expect(res.headers.get("content-range")).toBeNull();
+      if (method === "GET") expect(await res.text()).toBe(BODY);
+    }
+  });
+
+  it("serves a single closed range as 206", async () => {
+    setup();
+    const res = await get("bytes=2-5");
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("2345");
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("supports open, suffix and clamped ranges", async () => {
+    setup();
+    for (const [range, cr, len, text] of [
+      ["bytes=7-", "bytes 7-9/10", "3", "789"],
+      ["bytes=-3", "bytes 7-9/10", "3", "789"],
+      ["bytes=8-99", "bytes 8-9/10", "2", "89"],
+      ["bytes=-99", "bytes 0-9/10", "10", BODY],
+      ["BYTES=2-5", "bytes 2-5/10", "4", "2345"],
+    ] as const) {
+      const res = await get(range);
+      expect(res.status, range).toBe(206);
+      expect(res.headers.get("content-range"), range).toBe(cr);
+      expect(res.headers.get("content-length"), range).toBe(len);
+      expect(await res.text(), range).toBe(text);
+    }
+  });
+
+  it("answers HEAD with 206 headers and never reads contents", async () => {
+    const getContents = setup();
+    const res = await get("bytes=2-5", {}, "HEAD");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("answers 416 for unsatisfiable ranges without reading contents", async () => {
+    const getContents = setup();
+    for (const range of ["bytes=10-", "bytes=-0", "bytes=99-100"]) {
+      const res = await get(range);
+      expect(res.status, range).toBe(416);
+      expect(res.headers.get("content-range"), range).toBe("bytes */10");
+      expect(res.headers.get("content-length"), range).toBe("0");
+      expect(await res.text(), range).toBe("");
+    }
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("ignores malformed, multi-range and unknown-unit ranges", async () => {
+    setup();
+    for (const range of [
+      "bytes=0-1,4-5",
+      "bytes=5-2",
+      "items=0-1",
+      "bytes=abc",
+      "bytes=",
+      "bytes=-",
+    ]) {
+      const res = await get(range);
+      expect(res.status, range).toBe(200);
+      expect(await res.text(), range).toBe(BODY);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(res.headers.get("content-length"), range).toBe("10");
+      expect(res.headers.get("accept-ranges"), range).toBe("bytes");
+    }
+  });
+
+  it("ignores Range without a known size", async () => {
+    for (const size of [undefined, 0]) {
