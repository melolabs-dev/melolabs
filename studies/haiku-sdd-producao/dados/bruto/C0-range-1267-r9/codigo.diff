 // --- Internal Utils ---
 
+type ByteRange = { start: number; end: number };
+
+/** Resolve the single byte range a request asks for (RFC 9110 sections 13.1.5 and 14). */
+function resolveRange(event: H3Event, size: number): ByteRange | "unsatisfiable" | undefined {
+  const header = event.req.headers.get("range");
+  if (!header) {
+    return;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (
+    ifRange &&
+    !isIfRangeValid(ifRange, {
+      etag: event.res.headers.get("etag"),
+      lastModified: event.res.headers.get("last-modified"),
+    })
+  ) {
+    return;
+  }
+  return parseRange(header, size);
+}
+
+/** `undefined` means "ignore the header and serve the full representation". */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = /^\s*bytes\s*=\s*(\d*)\s*-\s*(\d*)\s*$/i.exec(header);
+  if (!match) {
+    return;
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return;
+  }
+  if (!first) {
+    const suffix = Number(last);
+    return suffix === 0 ? "unsatisfiable" : { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last && Number(last) < start) {
+    return;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: last ? Math.min(Number(last), size - 1) : size - 1 };
+}
+
+/** `If-Range` needs a strong ETag match or a `Last-Modified` date identical to the one sent. */
+function isIfRangeValid(
+  ifRange: string,
+  validators: { etag?: string | null; lastModified?: string | null },
+): boolean {
+  const value = ifRange.trim();
+  if (value.startsWith('"') || /^w\//i.test(value)) {
+    const { etag } = validators;
+    return !!etag && !/^w\//i.test(etag) && value === etag;
+  }
+  return !!validators.lastModified && value === validators.lastModified;
+}
+
+/** Cut `body` to the inclusive byte `range`, keeping streams and blobs lazy. */
+function sliceBody(body: BodyInit, { start, end }: ByteRange): BodyInit {
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(start, end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(start, end + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  const source =
+    body instanceof ReadableStream ? body : (new Response(body).body as ReadableStream | null);
+  if (!source) {
+    return new Uint8Array(0);
+  }
+  const reader = source.getReader();
+  let skip = start;
+  let remaining = end - start + 1;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (remaining > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunk = value as Uint8Array;
+        if (skip >= chunk.byteLength) {
+          skip -= chunk.byteLength;
+          continue;
+        }
+        const part = chunk.subarray(skip, skip + remaining);
+        skip = 0;
+        remaining -= part.byteLength;
+        controller.enqueue(part);
+        if (remaining > 0) {
+          return;
+        }
+      }
+      await reader.cancel().catch(() => {});
+      controller.close();
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
+
