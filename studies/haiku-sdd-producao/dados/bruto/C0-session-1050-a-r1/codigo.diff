+/**
+ * Try each password in order, moving on only when the HMAC does not match
+ * (wrong password). Any other error (expired seal, malformed token) is thrown
+ * as is; when no password opens the token the last HMAC error is thrown.
+ */
+async function unsealWithAny(
+  sealed: string,
+  passwords: string[],
+  options: SealOptions,
+): Promise<{ value: Partial<Session>; index: number }> {
+  let lastError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      return { value: (await unseal(sealed, password, options)) as Partial<Session>, index };
+    } catch (error) {
+      if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+        throw error;
+      }
+      lastError = error;
+    }
