+/**
+ * Normalize `config.password` to a list (first seals, all unseal) without
+ * mutating the config. Throws on an empty list or an empty/non-string entry.
+ */
+export function resolvePasswords(config: Pick<SessionConfig, "password">): string[] {
+  const { password } = config;
+  const passwords = Array.isArray(password) ? password : [password];
+  if (
+    passwords.length === 0 ||
+    passwords.some((entry) => typeof entry !== "string" || entry.length === 0)
+  ) {
+    throw new Error("Session `password` must be a string or a non-empty array of passwords.");
+  }
+  return [...passwords];
+}
