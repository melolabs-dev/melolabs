+
+/**
+ * Normalize `config.password` to a validated list: first seals, all unseal.
+ *
+ * Validates every entry up front (same messages as `iron-crypto`) so a bad
+ * rotation list fails right away instead of only once an earlier password stops
+ * opening cookies.
+ */
+function getPasswords(config: SessionConfig, sealOptions: SealOptions): string[] {
+  const passwords = Array.isArray(config.password) ? config.password : [config.password];
+  if (passwords.length === 0) {
+    throw new Error("Empty password");
+  }
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const password of passwords) {
+    if (typeof password !== "string") {
+      throw new TypeError("Invalid password");
+    }
+    if (!password) {
+      throw new Error("Empty password");
+    }
+    if (password.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  return passwords;
+}
+
+function isBadPassword(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
