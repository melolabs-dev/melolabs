+/**
+ * Try every password in order and report the index of the one that opened the
+ * token. Only a failed integrity check moves on to the next password: any other
+ * error (an expired seal, a malformed token) does not depend on the password.
+ */
+async function unsealWithAny(
+  sealed: string,
+  passwords: string[],
+  options: SealOptions,
+): Promise<{ unsealed: Partial<Session>; index: number }> {
+  let lastError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = (await unseal(sealed, password, options)) as Partial<Session>;
+      return { unsealed, index };
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+function minPasswordLength(options: SealOptions): number {
+  return Math.max(options.encryption.minPasswordlength, options.integrity.minPasswordlength);
+}
