+/**
+ * Normalize `SessionConfig.password` to a non-empty list and validate every
+ * entry up front, so a bad secondary password fails regardless of which
+ * password ends up opening the token.
+ */
+export function resolvePasswords(
+  password: string | string[],
+  minLength: number,
+): [string, ...string[]] {
+  const passwords = typeof password === "string" ? [password] : password;
+  if (!Array.isArray(passwords) || passwords.length === 0) {
+    throw new Error("Empty password");
+  }
+  for (const entry of passwords) {
+    if (typeof entry !== "string" || entry.length === 0) {
+      throw new Error("Empty password");
+    }
+    if (entry.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  return passwords as [string, ...string[]];
+}
