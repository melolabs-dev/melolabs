+/**
+ * Normalize `config.password` to a list and validate every item up front, so a
+ * bad entry is a configuration error even when the cookie never reaches it.
+ */
+function getPasswords(config: SessionConfig, options: SealOptions): string[] {
+  const passwords = Array.isArray(config.password) ? config.password : [config.password];
+  if (passwords.length === 0) {
+    throw new Error("Empty password");
+  }
+  const minLength = Math.max(
+    options.encryption.minPasswordlength,
+    options.integrity.minPasswordlength,
+  );
+  for (const password of passwords) {
+    if (typeof password !== "string" || !password) {
+      throw new Error("Empty password");
+    }
+    if (password.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  return passwords;
+}
+
+/**
+ * Try each password in order. Only an HMAC mismatch moves on to the next one;
+ * any other error (expired, malformed) is thrown as is. If every password
+ * fails, the first HMAC error is thrown.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  options: SealOptions,
+): Promise<{ value: Partial<Session>; index: number }> {
+  let firstError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      return { value: (await unseal(sealed, password, options)) as Partial<Session>, index };
+    } catch (error) {
+      if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+        throw error;
+      }
+      firstError ??= error;
+    }
+  }
+  throw firstError;
+}
