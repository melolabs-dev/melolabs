+/**
+ * Normalize `SessionConfig.password` to a list. The first password seals, all of
+ * them can open.
+ */
+export function resolvePasswords(password: SessionConfig["password"]): string[] {
+  const passwords = typeof password === "string" ? [password] : [...password];
