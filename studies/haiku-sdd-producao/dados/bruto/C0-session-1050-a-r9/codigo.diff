+/** Passwords of the config as a list. Throws if `password` is an empty array. */
+export function resolveSessionPasswords(config: Pick<SessionConfig, "password">): string[] {
+  const { password } = config;
+  if (Array.isArray(password)) {
+    if (password.length === 0) {
+      throw new Error("Session password is required: provide at least one password");
+    }
+    return password;
+  }
+  return [password];
+}
