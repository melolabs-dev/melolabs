+
+// Tries `password`, then each extra password, with the current seal options;
+// then (unless disabled) the same passwords with the legacy 1-iteration count.
+// Only advances on a bad HMAC so other errors (expired seal, malformed seal,
+// invalid extra password) are not masked.
+async function unsealWithPasswords(
+  config: SessionConfig,
+  sealed: string,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  const passwords = [config.password, ...(config.extraUnsealPasswords || [])];
+  let error: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+      if (unsealed && index > 0) {
+        // Reuses `kLegacySeal`: getSession reseals the session with `password`
+        (unsealed as any)[kLegacySeal] = true;
+      }
+      return unsealed;
+    } catch (_error) {
+      if (!isBadHmac(_error)) throw _error;
+      error = _error;
+    }
+  }
+  // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+  // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+  // Sessions sealed before the default PBKDF2 iterations were raised from 1
+  // to 8192 fail HMAC verification; retry with the legacy count so existing
+  // sessions survive the upgrade (getSession reseals them with the current
+  // options).
+  if (config.legacySealFallback === false || sealOptions.integrity.iterations === 1) {
+    throw error;
+  }
+  const legacyOptions = {
+    ...sealOptions,
+    encryption: { ...sealOptions.encryption, iterations: 1 },
+    integrity: { ...sealOptions.integrity, iterations: 1 },
+  };
+  for (const password of passwords) {
+    try {
+      const unsealed = (await unseal(sealed, password, legacyOptions)) as Partial<Session>;
+      if (unsealed) {
+        (unsealed as any)[kLegacySeal] = true;
+      }
+      return unsealed;
+    } catch (_error) {
+      if (!isBadHmac(_error)) throw _error;
+      error = _error;
+    }
+  }
+  throw error;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
