@@ -0,0 +1,326 @@
+import { H3, HTTPError, onResponse, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemJSON = "application/problem+json";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  describe("option", () => {
+    it("is undefined by default", () => {
+      expect(new H3().config.problemDetails).toBeUndefined();
+    });
+  });
+
+  describe("enabled", () => {
+    it("renders HTTPError as problem details", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário não existe",
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não existe",
+      });
+      t.errors = [];
+    });
+
+    it("renders a missing route as problem details without title", async () => {
+      t.app.config.problemDetails = true;
+
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      const body = await res.json();
+      expect(body).toMatchObject({ type: "about:blank", status: 404 });
+      expect(body.detail).toMatch(/^Cannot find any route/);
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("renders the type and instance given to HTTPError", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 403,
+          message: "Sem permissão",
+          type: "https://exemplo.test/erros/sem-permissao",
+          instance: "/pedidos/42",
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.test/erros/sem-permissao",
+        instance: "/pedidos/42",
+        status: 403,
+        detail: "Sem permissão",
+      });
+    });
+
+    it("renders HEAD errors with an empty body", async () => {
+      t.app.config.problemDetails = true;
+
+      const res = await t.fetch("/missing", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      expect(await res.text()).toBe("");
+    });
+
+    it("keeps HTTPError headers", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "bad", headers: { "x-own": "1" } });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.headers.get("x-own")).toBe("1");
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+    });
+
+    // Regression guard for `errHeaders` and `set-cookie` (same case as errors.test.ts).
+    for (const asyncHandler of [false, true]) {
+      for (const method of ["GET", "HEAD"]) {
+        it(`merges errHeaders without duplicating set-cookie for ${method} ${asyncHandler ? "async" : "sync"} handlers`, async () => {
+          t.app.config.problemDetails = true;
+          const handler = (event: H3Event) => {
+            event.res.headers.set("x-success", "success");
+            event.res.errHeaders.set("x-error", "prepared");
+            event.res.errHeaders.append("set-cookie", "prepared=1");
+            throw new HTTPError({
+              status: 422,
+              statusText: "Unprocessable",
+              data: { test: 123 },
+              headers: { "x-error-own": "own", "set-cookie": "error=1" },
+            });
+          };
+          t.app.use(asyncHandler ? async (event) => handler(event) : handler);
+
+          const res = await t.fetch("/", { method });
+          expect(res.status).toBe(422);
+          expect(res.headers.get("content-type")).toBe(problemJSON);
+          expect(res.headers.get("x-error")).toBe("prepared");
+          expect(res.headers.get("x-error-own")).toBe("own");
+          expect(res.headers.get("x-success")).toBeNull();
+          expect(res.headers.getSetCookie()).toEqual(["error=1", "prepared=1"]);
+          if (method === "GET") {
+            expect(await res.json()).toMatchObject({ status: 422, title: "Unprocessable" });
+          }
+          t.errors = [];
+        });
+      }
+    }
+
+    it("hides type, instance, data and body of unhandled errors", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          message: "senha do banco: 123",
+          data: { secret: 1 },
+          body: { leaked: true },
+          type: "https://exemplo.test/erros/interno",
+          instance: "/interno",
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      const body = await res.json();
+      expect(body).toMatchObject({ type: "about:blank", status: 500, detail: "HTTPError" });
+      expect(body).not.toHaveProperty("instance");
+      expect(body).not.toHaveProperty("data");
+      expect(body).not.toHaveProperty("leaked");
+      t.errors = [];
+    });
+
+    it("does not leak an unhandled error message without debug", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("senha do banco: 123");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      const text = await res.text();
+      expect(text).not.toContain("senha do banco");
+      expect(JSON.parse(text)).toEqual({ type: "about:blank", status: 500, detail: "HTTPError" });
+      t.errors = [];
+    });
+
+    it("keeps detail as HTTPError for unhandled errors with debug on", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new Error("senha do banco: 123");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({ detail: "HTTPError", status: 500 });
+      t.errors = [];
+    });
+
+    it("renders a non-Error throw with a type field as an unhandled problem", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw { type: "x", status: 400 };
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({ type: "about:blank", status: 500 });
+      t.errors = [];
+    });
+
+    it("does not send a non-string type from an HTTPError-shaped foreign error", async () => {
+      t.app.config.problemDetails = true;
+      class ForeignHTTPError extends Error {
+        override name = "HTTPError";
+        status = 400;
+        type = 42;
+        instance = { nested: true };
+      }
+      t.app.get("/", () => {
+        throw new ForeignHTTPError("foreign");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      const body = await res.json();
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+      t.errors = [];
+    });
+
+    it("RFC members win over body keys", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "bad",
+          body: { type: "x", status: 1, extra: true },
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ type: "about:blank", status: 400, extra: true });
+    });
+
+    it("renders onResponse middleware returned HTTPError as problem details", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use(onResponse(() => {}));
+      t.app.get("/", () => new HTTPError({ status: 409, message: "conflito" }));
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      expect(await res.json()).toMatchObject({ type: "about:blank", status: 409 });
+    });
+
+    // The middleware renders the response through `toResponse` too; it must not run the app's
+    // `onResponse` hook, which the outer dispatch already runs once.
+    it("runs the app onResponse hook once when a middleware renders the error", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use(onResponse(() => {}));
+      t.app.get("/", () => new HTTPError({ status: 409, message: "conflito" }));
+
+      await t.fetch("/");
+      expect(t.hooks.onResponse).toHaveBeenCalledTimes(1);
+    });
+
+    it("renders an HTTPError returned from onError as problem details", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => new HTTPError({ status: 422, message: "Dados inválidos" });
+      t.app.get("/", () => {
+        throw new Error("handler boom");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      expect(await res.json()).toMatchObject({ detail: "Dados inválidos", status: 422 });
+    });
+
+    it("renders an Error returned from onError as an unhandled problem", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => new Error("x");
+      t.app.get("/", () => {
+        throw new Error("handler boom");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(problemJSON);
+      expect(await res.json()).toMatchObject({ detail: "HTTPError", status: 500 });
+    });
+  });
+
+  describe("disabled", () => {
+    it("keeps the current body and content type", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário não existe",
+          type: "https://exemplo.test/erros/x",
+          instance: "/x",
+        });
+      });
+
+      const res = await t.fetch("/");
