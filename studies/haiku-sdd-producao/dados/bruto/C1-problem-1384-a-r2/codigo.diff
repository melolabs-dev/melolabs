+import { describe, expect, it } from "vitest";
+import { HTTPError } from "../../src/error.ts";
+import { toProblemDetails } from "../../src/utils/internal/problem-details.ts";
+
+describe("toProblemDetails", () => {
+  it("maps status, statusText, message, type and instance to RFC 9457 members", () => {
+    const error = new HTTPError({
+      status: 409,
+      statusText: "Conflict",
+      message: "Conflito",
+      type: "https://exemplo.com/erros/conflito",
+      instance: "/pedidos/42",
+    });
+    expect(toProblemDetails(error)).toEqual({
+      type: "https://exemplo.com/erros/conflito",
+      title: "Conflict",
+      status: 409,
+      detail: "Conflito",
+      instance: "/pedidos/42",
+    });
+  });
+
+  it("defaults type to about:blank", () => {
+    const error = new HTTPError({ status: 404, statusText: "Not Found", message: "x" });
+    expect(toProblemDetails(error).type).toBe("about:blank");
+  });
+
+  it("keeps data and body as extension members", () => {
+    const error = new HTTPError({
+      status: 422,
+      statusText: "Unprocessable",
+      message: "Dados inválidos",
+      data: { field: "email" },
+      body: { topLevel: "works" },
+    });
+    expect(toProblemDetails(error)).toMatchObject({
+      data: { field: "email" },
+      topLevel: "works",
+    });
+  });
+
+  it("does not expose unhandled, statusText or message keys of toJSON", () => {
+    const error = new HTTPError({ status: 500, statusText: "Oops", message: "x" });
+    const details = toProblemDetails(error);
+    expect(details).not.toHaveProperty("unhandled");
+    expect(details).not.toHaveProperty("statusText");
+    expect(details).not.toHaveProperty("message");
+  });
+
+  it("lets RFC members win over colliding body members", () => {
+    const error = new HTTPError({
+      status: 404,
+      statusText: "Not Found",
+      message: "x",
+      body: { title: "custom", status: 999, type: "custom", detail: "custom", topLevel: "ok" },
+    });
+    expect(toProblemDetails(error)).toMatchObject({
+      type: "about:blank",
+      title: "Not Found",
+      status: 404,
+      detail: "x",
+      topLevel: "ok",
+    });
+  });
+
+  it("omits title when statusText is missing", () => {
+    const error = new HTTPError({ status: 422, message: "x" });
+    expect(JSON.parse(JSON.stringify(toProblemDetails(error)))).not.toHaveProperty("title");
+  });
+
+  it("hides type and instance for unhandled errors", () => {
+    const error = new HTTPError({
+      status: 500,
+      message: "segredo",
+      unhandled: true,
+      type: "https://exemplo.com/erros/interno",
+      instance: "/secret",
+    });
+    const details = toProblemDetails(error);
+    expect(details.type).toBeUndefined();
+    expect(details.instance).toBeUndefined();
+    expect(details.detail).toBe("HTTPError");
+    expect(JSON.stringify(details)).not.toContain("segredo");
+  });
+});
