+++ b/src/utils/internal/problem-details.ts
@@ -0,0 +1,22 @@
+import type { HTTPError } from "../../error.ts";
+
+/**
+ * Builds the RFC 9457 members of an error. Extension members (`data`, `body`) come from
+ * `HTTPError.toJSON()`; RFC members are read from the error and applied last, so they win
+ * over colliding `body` keys.
+ */
+export function toProblemDetails(error: HTTPError): Record<string, unknown> {
+  const extensions: Record<string, unknown> = { ...error.toJSON() };
+  for (const key of ["status", "statusText", "unhandled", "message"]) {
+    delete extensions[key];
+  }
+  // Unhandled errors hide `type` and `instance` (the application does not control them).
+  return {
+    ...extensions,
+    type: error.unhandled ? undefined : (error.type ?? "about:blank"),
+    title: error.statusText,
+    status: error.status,
+    detail: error.unhandled ? "HTTPError" : error.message,
+    instance: error.unhandled ? undefined : error.instance,
+  };
+}
