@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+import { HTTPError } from "../../src/error.ts";
+
+describe("HTTPError", () => {
+  describe("type and instance", () => {
+    it("exposes the values passed in details", () => {
+      const error = new HTTPError({
+        status: 409,
+        message: "Conflito",
+        type: "https://exemplo.com/erros/conflito",
+        instance: "/pedidos/42",
+      });
+      expect(error.type).toBe("https://exemplo.com/erros/conflito");
+      expect(error.instance).toBe("/pedidos/42");
+    });
+
+    it("are undefined when not provided", () => {
+      const error = new HTTPError({ status: 409, message: "Conflito" });
+      expect(error.type).toBeUndefined();
+      expect(error.instance).toBeUndefined();
+    });
+
+    it("are not serialized by toJSON", () => {
+      const error = new HTTPError({
+        status: 409,
+        message: "Conflito",
+        type: "https://exemplo.com/erros/conflito",
+        instance: "/pedidos/42",
+      });
+      expect(error.toJSON()).not.toHaveProperty("type");
+      expect(error.toJSON()).not.toHaveProperty("instance");
+    });
+
+    it("keep toJSON output unchanged", () => {
+      const error = new HTTPError({
+        status: 422,
+        statusText: "Unprocessable",
+        message: "Dados inválidos",
+        data: { field: "email" },
+        body: { topLevel: "works" },
+      });
+      expect(error.toJSON()).toEqual({
+        status: 422,
+        statusText: "Unprocessable",
+        unhandled: undefined,
+        message: "Dados inválidos",
+        data: { field: "email" },
+        topLevel: "works",
+      });
+    });
+
+    it("are not inherited from the cause", () => {
+      const cause = { status: 400, type: "entity.parse.failed" };
+      const error = new HTTPError({ cause, status: 400, message: "Bad" });
+      expect(error.type).toBeUndefined();
+    });
+  });
+});
