+import { describe, expect, it } from "vitest";
+import { H3, HTTPError, defineHandler, onResponse } from "../src/index.ts";
+import { routeRules } from "../src/rules/middleware.ts";
+import { cache } from "../src/rules/cache.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json";
+const JSON_TYPE = "application/json;charset=UTF-8";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  // Enables the option with stack traces hidden, the production-like default.
+  const enable = () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.config.silent = true;
+  };
+
+  describe("option disabled (default)", () => {
+    it("keeps the current format for HTTPError", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(JSON_TYPE);
+      expect(await res.json()).toEqual({
+        status: 404,
+        statusText: "Not Found",
+        message: "Usuário não encontrado",
+      });
+    });
+
+    it("keeps the current format for unhandled errors", async () => {
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.use(() => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(JSON_TYPE);
+      expect(await res.json()).toEqual({ status: 500, unhandled: true, message: "HTTPError" });
+    });
+  });
+
+  describe("option enabled", () => {
+    it("renders HTTPError as problem details", async () => {
+      enable();
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não encontrado",
+      });
+    });
+
+    it("renders a missing route as problem details", async () => {
+      enable();
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        status: 404,
+        detail: expect.stringContaining("Cannot find any route matching [GET]"),
+      });
+    });
+
+    it("sends type and instance from HTTPError", async () => {
+      enable();
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 409,
+          statusText: "Conflict",
+          message: "Conflito",
+          type: "https://exemplo.com/erros/conflito",
+          instance: "/pedidos/42",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toEqual({
+        type: "https://exemplo.com/erros/conflito",
+        title: "Conflict",
+        status: 409,
+        detail: "Conflito",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("keeps data and body as top-level extension members", async () => {
+      enable();
+      t.app.use(() => {
+        throw HTTPError.status(422, "Unprocessable", {
+          message: "Dados inválidos",
+          data: { field: "email" },
+          body: { topLevel: "works" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Unprocessable",
+        status: 422,
+        detail: "Dados inválidos",
+        data: { field: "email" },
+        topLevel: "works",
+      });
+    });
+
+    it("lets RFC members win over colliding body members", async () => {
+      enable();
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found", {
+          message: "x",
+          body: { title: "custom", status: 999, type: "custom", detail: "custom", topLevel: "ok" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "x",
+        topLevel: "ok",
+      });
+    });
+
+    it("omits title when HTTPError has no statusText", async () => {
+      enable();
+      t.app.use(() => {
+        throw new HTTPError({ status: 422, message: "Dados inválidos" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        status: 422,
+        detail: "Dados inválidos",
+      });
+    });
+
+    it("does not leak unhandled error details without debug", async () => {
+      enable();
+      t.app.use(() => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      const text = await res.text();
+      t.errors = [];
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(text).not.toContain("segredo do banco");
+      expect(text).not.toContain("stack");
+      expect(JSON.parse(text)).toEqual({ status: 500, detail: "HTTPError" });
+    });
+
+    it("includes the stack for unhandled errors in debug mode", async () => {
+      enable();
+      t.app.config.debug = true;
+      t.app.use(() => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      t.errors = [];
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(body.detail).toBe("HTTPError");
+      expect(body.stack).toContain("Error: segredo do banco");
+    });
+
+    it("renders a HEAD request for a missing route without a body", async () => {
+      enable();
+      const res = await t.fetch("/missing", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-length")).toBeNull();
+      expect(await res.text()).toBe("");
+    });
+
+    it("renders an HTTPError returned from onResponse middleware as problem details", async () => {
+      enable();
+      t.app.config.debug = true;
+      t.app.use(onResponse(() => {}));
+      t.app.use(() => new HTTPError({ status: 409, statusText: "Conflict", message: "x" }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      const body = await res.json();
+      expect(body).toEqual({ type: "about:blank", title: "Conflict", status: 409, detail: "x" });
+    });
+
+    it("renders an HTTPError returned under a cache rule as problem details", async () => {
+      enable();
+      t.app.use(routeRules({ "/cached/**": { swr: 60 } }, { handlers: { cache } }));
+      t.app.get("/cached/err", () => {
+        return new HTTPError({ status: 503, statusText: "Unavailable", message: "down" });
+      });
+      const res = await t.fetch("/cached/err");
+      expect(res.status).toBe(503);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Unavailable",
+        status: 503,
+        detail: "down",
+      });
+    });
+
+    it("renders an HTTPError returned by onError as problem details", async () => {
+      enable();
+      t.app.config.onError = () =>
+        new HTTPError({ status: 418, statusText: "I'm a teapot", message: "tea" });
+      t.app.use(() => {
+        throw new HTTPError({ status: 400, message: "bad" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "I'm a teapot",
+        status: 418,
+        detail: "tea",
+      });
+    });
+  });
+
+  for (const enabled of [false, true]) {
+    describe(`error headers (problemDetails: ${enabled})`, () => {
+      const expectedType = enabled ? PROBLEM : JSON_TYPE;
+
+      it("keeps WWW-Authenticate from HTTPError headers", async () => {
+        t.app.config.problemDetails = enabled;
+        t.app.config.debug = false;
+        t.app.config.silent = true;
+        t.app.use(() => {
+          throw new HTTPError({
+            status: 401,
+            statusText: "Unauthorized",
+            message: "Login required",
+            headers: { "WWW-Authenticate": "Bearer" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(401);
+        expect(res.headers.get("www-authenticate")).toBe("Bearer");
+        expect(res.headers.get("content-type")).toBe(expectedType);
+      });
+
+      it("applies set-cookie from errHeaders once", async () => {
+        t.app.config.problemDetails = enabled;
+        t.app.config.debug = false;
+        t.app.config.silent = true;
+        t.app.use((event) => {
+          event.res.errHeaders.append("set-cookie", "prepared=1");
+          throw new HTTPError({
+            status: 422,
+            statusText: "Unprocessable",
+            headers: { "set-cookie": "error=1" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.getSetCookie()).toEqual(["error=1", "prepared=1"]);
+        expect(res.headers.get("content-type")).toBe(expectedType);
+      });
+
+      it("lets an explicit content-type from HTTPError headers win", async () => {
+        t.app.config.problemDetails = enabled;
+        t.app.config.debug = false;
+        t.app.config.silent = true;
+        t.app.use(() => {
+          throw new HTTPError({
+            status: 400,
+            statusText: "Bad Request",
+            message: "bad",
+            headers: { "content-type": "text/plain" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("text/plain");
+      });
+    });
+  }
+});
+
+describe("problem details without an app", () => {
+  it("is read from H3Config", async () => {
+    const app = new H3({ problemDetails: true });
+    app.get("/item", () => {
+      throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+    });
+    const res = await app.fetch(new Request("http://test/item"));
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+    expect(await res.json()).toEqual({
+      type: "about:blank",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário não encontrado",
+    });
+  });
+
+  it("keeps the current format for handler.fetch, which has no app", async () => {
+    // `handler.fetch` builds the event without an app, so there is no config to read.
+    const handler = defineHandler(() => {
+      throw HTTPError.status(404, "Not Found", { message: "x" });
+    });
+    const res = await handler.fetch("http://test/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(JSON_TYPE);
+  });
+});
