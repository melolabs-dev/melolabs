diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..c90a941
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,245 @@
+import { H3, HTTPError, onResponse } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemJson = "application/problem+json";
+const jsonContentType = "application/json;charset=UTF-8";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  const enableProblemDetails = () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+  };
+
+  describe("config", () => {
+    it("defaults problemDetails to false", () => {
+      expect(new H3().config.problemDetails).toBe(false);
+    });
+
+    it("reads problemDetails from the app config", () => {
+      expect(new H3({ problemDetails: true }).config.problemDetails).toBe(true);
+    });
+  });
+
+  describe("disabled (default)", () => {
+    for (const debug of [false, true]) {
+      it(`keeps the current error body and content type (debug ${debug})`, async () => {
+        t.app.config.debug = debug;
+        const error = new HTTPError({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário não existe",
+        });
+        t.app.get("/", () => {
+          throw error;
+        });
+
+        const res = await t.fetch("/");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(jsonContentType);
+        const body = await res.json();
+        expect(body).toMatchObject(JSON.parse(JSON.stringify(error.toJSON())));
+        expect(body).not.toHaveProperty("type");
+        expect(body).not.toHaveProperty("instance");
+        expect(body).not.toHaveProperty("title");
+      });
+    }
+  });
+
+  describe("enabled", () => {
+    it("answers with the problem details media type and the error status", async () => {
+      enableProblemDetails();
+      t.app.use(() => {
+        throw new HTTPError({ status: 422, message: "Dados inválidos" });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(problemJson);
+    });
+
+    it("renders the RFC 9457 members from the error", async () => {
+      enableProblemDetails();
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário não existe",
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não existe",
+      });
+    });
+
+    it("renders type and instance from the error", async () => {
+      enableProblemDetails();
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 409,
+          message: "Conflito",
+          type: "https://exemplo.com/erros/conflito",
+          instance: "/pedidos/42",
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(await res.json()).toEqual({
+        type: "https://exemplo.com/erros/conflito",
+        status: 409,
+        detail: "Conflito",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("puts body members at the top level and keeps data under data", async () => {
+      enableProblemDetails();
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "Campo inválido",
+          body: { campo: "email" },
+          data: { tentativas: 2 },
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(await res.json()).toEqual({
+        campo: "email",
+        type: "about:blank",
+        status: 400,
+        detail: "Campo inválido",
+        data: { tentativas: 2 },
+      });
+    });
+
+    it("does not let body override the reserved members", async () => {
+      enableProblemDetails();
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          message: "Falhou",
+          body: { type: "x", status: 200 },
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({ type: "about:blank", status: 500 });
+    });
+
+    it("does not leak the message of unhandled errors", async () => {
+      enableProblemDetails();
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(problemJson);
+      expect(text).not.toContain("segredo do banco");
+      expect(text).not.toContain("stack");
+      expect(JSON.parse(text)).toEqual({ type: "about:blank", status: 500 });
+      t.errors = [];
+    });
+
+    it("includes the stack of unhandled errors in debug, without detail", async () => {
+      enableProblemDetails();
+      t.app.config.silent = true;
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(res.headers.get("content-type")).toBe(problemJson);
+      expect(body.stack).toBeDefined();
+      expect(body).not.toHaveProperty("detail");
+      t.errors = [];
+    });
+
+    it("forces type to about:blank for unhandled errors", async () => {
+      enableProblemDetails();
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw Object.assign(new Error("x"), { type: "secret", instance: "/x" });
+      });
+
+      const res = await t.fetch("/");
+      expect(await res.json()).toEqual({ type: "about:blank", status: 500 });
+      t.errors = [];
+    });
+
+    it("renders errors thrown by middleware", async () => {
+      enableProblemDetails();
+      t.app.use(() => {
+        throw new HTTPError({ status: 403, message: "Proibido" });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe(problemJson);
+    });
+
+    it("renders errors returned to onResponse, which does not receive the app config", async () => {
+      enableProblemDetails();
+      t.app.use(onResponse(() => {}));
+      t.app.get("/", () => new HTTPError({ status: 418, message: "Chá" }));
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(res.headers.get("content-type")).toBe(problemJson);
+      expect(await res.json()).toEqual({ type: "about:blank", status: 418, detail: "Chá" });
+    });
+
+    it("does not enable debug stack on the onResponse path", async () => {
+      enableProblemDetails();
+      t.app.config.debug = true;
+      t.app.use(onResponse(() => {}));
+      t.app.get("/", () => new HTTPError({ status: 418, message: "Chá" }));
+
+      const res = await t.fetch("/");
+      expect(await res.json()).not.toHaveProperty("stack");
+    });
+
+    it("follows the config of the app that renders the error, not the mounted sub-app", async () => {
+      enableProblemDetails();
+      const sub = new H3();
+      sub.get("/", () => {
+        throw new HTTPError({ status: 404, message: "Não existe" });
+      });
+      t.app.mount("/sub", sub);
+
+      const res = await t.fetch("/sub");
+      expect(res.headers.get("content-type")).toBe(problemJson);
+    });
+
+    for (const problemDetails of [false, true]) {
+      it(`keeps HTTPError headers (problemDetails ${problemDetails})`, async () => {
+        t.app.config.problemDetails = problemDetails;
+        t.app.config.debug = false;
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 503,
+            message: "Indisponível",
+            headers: { "retry-after": "30" },
+          });
+        });
+
+        const res = await t.fetch("/");
+        expect(res.status).toBe(503);
+        expect(res.headers.get("retry-after")).toBe("30");
+        expect(res.headers.get("content-type")).toBe(
+          problemDetails ? problemJson : jsonContentType,
+        );
+      });
+    }
+  });
+});
