+    it("is off by default", () => {
+      expect(new H3().config.problemDetails).toBeFalsy();
+    });
+  });
+
+  describe("default error format (problemDetails disabled)", () => {
+    it("keeps the current JSON error response for HTTPError 404", async () => {
+      t.app.config.debug = false;
