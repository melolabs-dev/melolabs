+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+
+describe("HTTPError problem details fields", () => {
+  it("exposes type and instance from the input", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+    expect(error.instance).toBe("/pedidos/42");
+  });
+
+  it("leaves type and instance undefined when absent", () => {
+    const error = new HTTPError({ status: 404 });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("ignores non-string type and instance", () => {
+    const error = new HTTPError({ status: 400, type: 42, instance: { path: "/" } } as any);
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("does not take type from a thrown Error", () => {
+    const cause = new Error("Malformed body");
+    (cause as any).type = "entity.parse.failed";
+    const error = new HTTPError(cause);
+    expect(error.type).toBeUndefined();
+  });
