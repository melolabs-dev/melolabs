diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..5fdab13
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,219 @@
+import { H3, HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+import { describe, it, expect } from "vitest";
+
+describe("problemDetails config", () => {
+  it("is off by default and can be enabled", () => {
+    expect(new H3().config.problemDetails).toBeFalsy();
+    expect(new H3({ problemDetails: true }).config.problemDetails).toBe(true);
+  });
+});
+
+describeMatrix("problem details", (t, { it, expect }) => {
+  const problemType = "application/problem+json";
+  const jsonType = "application/json;charset=UTF-8";
+
+  it("keeps the default JSON body when the option is off", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(jsonType);
+    expect(await res.json()).toEqual({
+      status: 404,
+      statusText: "Not Found",
+      message: "Usuário não encontrado",
+    });
+  });
+
+  it("keeps the default JSON body when type and instance are set and the option is off", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 409,
+        statusText: "Conflict",
+        message: "Conflito",
+        type: "https://exemplo.com/conflito",
+        instance: "/recurso/1",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(jsonType);
+    const body = await res.json();
+    expect(body).toEqual({ status: 409, statusText: "Conflict", message: "Conflito" });
+    expect(body).not.toHaveProperty("type");
+    expect(body).not.toHaveProperty("instance");
+    expect(body).not.toHaveProperty("title");
+  });
+
+  it("renders HTTPError as problem details", async () => {
+    t.app.config.problemDetails = true;
+    t.app.use(() => {
+      throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(problemType);
+    expect(await res.json()).toMatchObject({ status: 404 });
+  });
+
+  it("renders generic errors as problem details without unhandled", async () => {
+    t.app.config.problemDetails = true;
+    t.app.use(() => {
+      throw new Error("x");
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(500);
+    expect(res.headers.get("content-type")).toBe(problemType);
+    const body = await res.json();
+    expect(body).not.toHaveProperty("unhandled");
+    expect(body).toMatchObject({ status: 500 });
+    // Generic errors are unhandled, which the afterEach hook would otherwise report
+    t.errors.length = 0;
+  });
+
+  it("uses RFC 9457 members, with data and body as extensions", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 422,
+        statusText: "Unprocessable Content",
+        message: "Campo inválido",
+        type: "https://exemplo.com/erros/validacao",
+        instance: "/pedidos/42",
+        data: { field: "email" },
+        body: { code: "E_VALIDATION" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(422);
+    expect(res.statusText).toBe("Unprocessable Content");
+    expect(res.headers.get("content-type")).toBe(problemType);
+    expect(await res.json()).toEqual({
+      type: "https://exemplo.com/erros/validacao",
+      title: "Unprocessable Content",
+      status: 422,
+      detail: "Campo inválido",
+      instance: "/pedidos/42",
+      data: { field: "email" },
+      code: "E_VALIDATION",
+    });
+  });
+
+  it("defaults type to about:blank and omits title when statusText is missing", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({ status: 400, message: "Ruim" });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(body).toEqual({ type: "about:blank", status: 400, detail: "Ruim" });
+    expect(body).not.toHaveProperty("title");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("lets RFC members win over colliding body keys", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 400,
+        statusText: "Bad Request",
+        message: "z",
+        body: { type: "x", title: "y", detail: "w" },
+      });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({
+      type: "about:blank",
+      title: "Bad Request",
+      detail: "z",
+    });
+  });
+
+  it("hides the message, data and body of unhandled errors", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 500,
+        unhandled: true,
+        message: "senha do banco incorreta",
+        data: { secret: 1 },
+        body: { leaked: true },
+      });
+    });
+    const res = await t.fetch("/");
+    const text = await res.text();
+    expect(res.headers.get("content-type")).toBe(problemType);
+    expect(text).not.toContain("senha do banco incorreta");
+    const body = JSON.parse(text);
+    expect(body.detail).toBe("HTTPError");
+    expect(body).not.toHaveProperty("data");
+    expect(body).not.toHaveProperty("leaked");
+    t.errors.length = 0;
+  });
+
+  it("sends custom error headers and stack in debug mode", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = true;
+    t.app.use(() => {
+      throw new HTTPError({ status: 400, message: "x", headers: { "x-erro": "1" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(problemType);
+    expect(res.headers.get("x-erro")).toBe("1");
+    const body = await res.json();
+    expect(Array.isArray(body.stack)).toBe(true);
+  });
+
+  it("omits stack when debug is off", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({ status: 400, message: "x", headers: { "x-erro": "1" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("x-erro")).toBe("1");
+    expect(await res.json()).not.toHaveProperty("stack");
+  });
+
+  it("keeps onError and staged error headers working", async () => {
+    t.app.config.problemDetails = true;
+    t.app.use((event) => {
+      event.res.errHeaders.set("x-staged", "1");
+      throw HTTPError.status(403, "Forbidden", { message: "no" });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("x-staged")).toBe("1");
+    expect(res.headers.get("content-type")).toBe(problemType);
+    expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not reformat a Response returned by onError", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.onError = () => new Response("custom", { status: 418 });
+    t.app.use(() => {
+      throw HTTPError.status(400, "Bad Request", { message: "x" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(418);
+    expect(res.headers.get("content-type")).not.toBe(problemType);
+    expect(await res.text()).toBe("custom");
+  });
+
+  it("renders HEAD errors without a body", async () => {
+    t.app.config.problemDetails = true;
+    t.app.use(() => {
+      throw HTTPError.status(404, "Not Found", { message: "x" });
+    });
+    const res = await t.fetch("/", { method: "HEAD" });
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(problemType);
+    expect(await res.text()).toBe("");
+  });
+});
diff --git a/test/unit/error.test.ts b/test/unit/error.test.ts
new file mode 100644
index 0000000..16efa33
--- /dev/null
+++ b/test/unit/error.test.ts
@@ -0,0 +1,36 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/error.ts";
+
+describe("HTTPError type and instance", () => {
+  it("exposes type and instance from the input", () => {
+    const err = new HTTPError({
+      status: 409,
+      type: "https://exemplo.com/conflito",
+      instance: "/recurso/1",
+    });
+    expect(err.type).toBe("https://exemplo.com/conflito");
+    expect(err.instance).toBe("/recurso/1");
+  });
+
+  it("leaves type and instance undefined when not given", () => {
+    const err = new HTTPError("Erro", { status: 400 });
+    expect(err.type).toBeUndefined();
+    expect(err.instance).toBeUndefined();
+  });
+
+  it("does not inherit type from cause", () => {
+    const err = new HTTPError({ cause: new HTTPError({ status: 400, type: "x" }) });
+    expect(err.type).toBeUndefined();
+  });
+
+  it("keeps type and instance out of toJSON", () => {
+    const err = new HTTPError({
+      status: 409,
+      type: "https://exemplo.com/conflito",
+      instance: "/recurso/1",
+    });
+    const json = JSON.parse(JSON.stringify(err));
+    expect(json).not.toHaveProperty("type");
+    expect(json).not.toHaveProperty("instance");
+  });
+});
