   }
+  const body = problemDetails ? toProblemDetails(error) : error.toJSON();
   return new FastResponse(
     JSON.stringify(
       {
-        ...error.toJSON(),
+        ...body,
         stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
       },
       undefined,
@@ -378,3 +385,17 @@ function errorResponse(error: HTTPError, debug?: boolean, errHeaders?: Headers):
     },
   );
 }
+
+// RFC 9457 members go last so they win over colliding `body` keys.
+function toProblemDetails(error: HTTPError): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  return {
+    data: unhandled ? undefined : error.data,
+    ...(unhandled ? undefined : error.body),
+    type: error.type ?? "about:blank",
+    title: error.statusText,
+    status: error.status,
+    detail: unhandled ? "HTTPError" : error.message,
+    instance: error.instance,
+  };
+}
