-function errorResponse(error: HTTPError, debug?: boolean, errHeaders?: Headers): Response {
+function errorResponse(error: HTTPError, config: H3Config, errHeaders?: Headers): Response {
+  const { debug, problemDetails } = config;
+  const defaultHeaders = problemDetails ? problemHeaders : jsonHeaders;
   let headers: Headers = error.headers
