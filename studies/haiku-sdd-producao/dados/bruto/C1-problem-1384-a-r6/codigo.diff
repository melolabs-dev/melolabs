+// RFC 9457 members take precedence over colliding keys from `data` and `body`.
+// Unhandled errors expose nothing but the status: their `type`, message and extensions are hidden.
+function problemBody(error: HTTPError, stack: string[] | undefined): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  return {
+    ...(unhandled ? undefined : { data: error.data, ...error.body }),
+    type: (!unhandled && error.type) || "about:blank",
+    title: error.statusText,
+    status: error.status,
+    detail: unhandled ? undefined : error.message,
+    instance: unhandled ? undefined : error.instance,
