diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..ac3e08a
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,208 @@
+import { HTTPError, readBody } from "../src/index.ts";
+import { proxyRequest } from "../src/utils/proxy.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_JSON = "application/problem+json";
+
+describeMatrix("problem details", (t, { it, expect, describe }) => {
+  describe("content-type", () => {
+    it("uses application/problem+json for HTTPError", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    });
+
+    it("uses application/problem+json for route not found (kNotFound)", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    });
+
+    it("uses application/problem+json for body validation errors", async () => {
+      t.app.post("/", async (event) => readBody(event));
+
+      const res = await t.fetch("/", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: "{invalid",
+      });
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    });
+
+    it("keeps application/json for success responses", async () => {
+      t.app.get("/", () => ({ ok: true }));
+
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+
+    it("lets an app-provided content-type in HTTPError.headers win", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, headers: { "content-type": "text/plain" } });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("text/plain");
+    });
+
+    it("keeps Response returned by onError untouched", async () => {
+      t.hooks.onError.mockImplementation(() => new Response("custom", { status: 418 }));
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(await res.text()).toBe("custom");
+      expect(res.headers.get("content-type")).not.toContain("problem+json");
+    });
+
+    it("renders as problem details when onError returns undefined", async () => {
+      t.hooks.onError.mockImplementation(() => undefined);
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    });
+  });
+
+  describe("body", () => {
+    it("maps RFC 9457 members from HTTPError", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 422,
+          statusText: "Unprocessable Content",
+          message: "Campo e-mail inválido",
+          type: "https://exemplo.com/erros/email",
+          instance: "/cadastros/42",
+        });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        type: "https://exemplo.com/erros/email",
+        title: "Unprocessable Content",
+        status: 422,
+        detail: "Campo e-mail inválido",
+        instance: "/cadastros/42",
+      });
+    });
+
+    it("uses the default reason phrase as title when statusText is missing", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({ title: "Not Found", status: 404 });
+    });
+
+    it("uses about:blank as type and omits instance when not provided", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("about:blank");
+      expect("instance" in body).toBe(false);
+    });
+
+    it("keeps legacy members with the same values", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 409,
+          statusText: "Conflict",
+          message: "Slug já existe",
+          data: { campo: "slug" },
+        });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        status: 409,
+        statusText: "Conflict",
+        message: "Slug já existe",
+        data: { campo: "slug" },
+      });
+    });
+
+    it("keeps body members at the top level", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, body: { trace: "abc" } });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({ status: 400, trace: "abc" });
+    });
+
+    it("keeps headers of HTTPError in the response", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 429, headers: { "Retry-After": "30" } });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(429);
+      expect(res.headers.get("retry-after")).toBe("30");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    });
+  });
+
+  describe("upstream proxy", () => {
+    it("passes upstream error body through without conversion", async () => {
+      t.app.all("/upstream", () => {
+        return new Response("upstream down", {
+          status: 503,
+          headers: { "content-type": "text/plain" },
+        });
+      });
+      t.app.all("/", (event) => proxyRequest(event, "/upstream"));
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(503);
+      expect(res.headers.get("content-type")).toBe("text/plain");
+      expect(await res.text()).toBe("upstream down");
+    });
+  });
+});
+
+// Unhandled errors are expected in these cases, so the matrix must not fail on them.
+describeMatrix(
+  "problem details (unhandled errors)",
+  (t, { it, expect }) => {
+    it("hides message, data and stack when debug is off", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("senha do banco: 123");
+      });
+
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(text).not.toContain("senha do banco");
+      expect(text).not.toContain("stack");
+      expect(JSON.parse(text)).toMatchObject({ status: 500, detail: "HTTPError" });
+    });
+
+    it("includes stack only in debug mode", async () => {
+      t.app.get("/", () => {
+        throw new Error("senha do banco: 123");
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(body.detail).toBe("HTTPError");
+      expect(body.message).toBe("HTTPError");
+      expect(body.data).toBeUndefined();
+    });
+  },
+  { allowUnhandledErrors: true },
+);
diff --git a/test/unit/problem-details.test.ts b/test/unit/problem-details.test.ts
new file mode 100644
index 0000000..c2ca34b
--- /dev/null
+++ b/test/unit/problem-details.test.ts
@@ -0,0 +1,75 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/error.ts";
+import { getStatusText } from "../../src/utils/internal/status-text.ts";
+
+describe("HTTPError type and instance", () => {
+  it("exposes type and instance when provided", () => {
+    const err = new HTTPError({ status: 400, type: "x", instance: "/y" });
+    expect(err.type).toBe("x");
+    expect(err.instance).toBe("/y");
+  });
+
+  it("leaves type and instance undefined when not provided", () => {
+    const err = new HTTPError({ status: 400 });
+    expect(err.type).toBeUndefined();
+    expect(err.instance).toBeUndefined();
+  });
+
+  it("reads type and instance from cause when missing in details", () => {
+    const err = new HTTPError({
+      status: 400,
+      cause: { type: "from-cause", instance: "/cause" },
+    });
+    expect(err.type).toBe("from-cause");
+    expect(err.instance).toBe("/cause");
+  });
+});
+
+describe("HTTPError toJSON", () => {
+  it("returns about:blank as type when not provided", () => {
+    expect(new HTTPError({ status: 400 }).toJSON().type).toBe("about:blank");
+  });
+
+  it("omits instance from the serialized body when not provided", () => {
+    const json = JSON.parse(JSON.stringify(new HTTPError({ status: 400 })));
+    expect("instance" in json).toBe(false);
+  });
+
+  it("uses statusText as title, falling back to the default reason phrase", () => {
+    expect(new HTTPError({ status: 422, statusText: "Custom" }).toJSON().title).toBe("Custom");
+    expect(new HTTPError({ status: 422 }).toJSON().title).toBe("Unprocessable Content");
+  });
+
+  it("masks message, data and body when unhandled", () => {
+    const err = new HTTPError({
+      status: 500,
+      unhandled: true,
+      message: "secret",
+      data: { token: "abc" },
+      body: { trace: "abc" },
+    });
+    const json = err.toJSON();
+    expect(json.detail).toBe("HTTPError");
+    expect(json.message).toBe("HTTPError");
+    expect(json.data).toBeUndefined();
+    expect("trace" in json).toBe(false);
+  });
+
+  it("keeps body members next to the RFC 9457 members", () => {
+    const json = new HTTPError({ status: 400, body: { trace: "abc" } }).toJSON();
+    expect(json).toMatchObject({ status: 400, type: "about:blank", trace: "abc" });
+  });
+});
+
+describe("getStatusText", () => {
+  it("returns RFC 9110 reason phrases", () => {
+    expect(getStatusText(404)).toBe("Not Found");
+    expect(getStatusText(422)).toBe("Unprocessable Content");
+  });
+
+  it("returns undefined for codes outside RFC 9110", () => {
+    expect(getStatusText(299)).toBeUndefined();
+    expect(getStatusText(499)).toBeUndefined();
+    expect(getStatusText(599)).toBeUndefined();
+  });
+});
