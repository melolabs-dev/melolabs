diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..20af62c
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,225 @@
+import { beforeEach } from "vitest";
+import { HTTPError, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+describeMatrix(
+  "problem details",
+  (t, { it, expect, describe }) => {
+    beforeEach(() => {
+      t.app.config.silent = true;
+      t.app.config.debug = false;
+    });
+
+    describe("success", () => {
+      it("keeps JSON responses for successful handlers", async () => {
+        t.app.get("/", () => ({ ok: true }));
+        const res = await t.fetch("/");
+        expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+        expect(await res.json()).toEqual({ ok: true });
+      });
+    });
+
+    describe("error response", () => {
+      it("renders a 404 HTTPError as application/problem+json", async () => {
+        t.app.get("/", () => {
+          throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe("application/problem+json");
+        expect(await res.json()).toEqual({
+          type: "about:blank",
+          title: "Not Found",
+          status: 404,
+          detail: "Usuário não encontrado",
+        });
+      });
+
+      it("exposes data as a member and body keys at the top level", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 422,
+            message: "Inválido",
+            data: { field: "email" },
+            body: { code: "E_EMAIL", hint: "use a valid address" },
+          });
+        });
+        const res = await t.fetch("/");
+        expect(await res.json()).toMatchObject({
+          status: 422,
+          detail: "Inválido",
+          data: { field: "email" },
+          code: "E_EMAIL",
+          hint: "use a valid address",
+        });
+      });
+
+      it("keeps RFC members when body or data use the same keys", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 409,
+            message: "Conflito",
+            body: { status: 1, detail: "from body", title: "from body", type: "from body" },
+            data: { instance: "from data" },
+          });
+        });
+        const res = await t.fetch("/");
+        const json = await res.json();
+        expect(json).toMatchObject({
+          status: 409,
+          detail: "Conflito",
+          title: "Conflict",
+          type: "about:blank",
+          data: { instance: "from data" },
+        });
+        expect(json.instance).toBeUndefined();
+      });
+
+      it("renders type and instance when provided", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({
+            status: 403,
+            message: "Negado",
+            type: "https://exemplo.com/erros/sem-permissao",
+            instance: "/pedidos/42",
+          });
+        });
+        const res = await t.fetch("/");
+        expect(await res.json()).toMatchObject({
+          type: "https://exemplo.com/erros/sem-permissao",
+          instance: "/pedidos/42",
+          status: 403,
+        });
+      });
+
+      it("omits instance and uses about:blank when they are not provided", async () => {
+        t.app.get("/", () => {
+          throw HTTPError.status(400, "Bad Request", { message: "Inválido" });
+        });
+        const json = await (await t.fetch("/")).json();
+        expect(json.type).toBe("about:blank");
+        expect("instance" in json).toBe(false);
+      });
+
+      it("uses the IANA reason phrase as title when statusText is missing", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 500, message: "Falhou" });
+        });
+        const json = await (await t.fetch("/")).json();
+        expect(json.title).toBe("Internal Server Error");
+      });
+
+      it("omits title for status codes outside the phrase table", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 599, message: "Falhou" });
+        });
+        const json = await (await t.fetch("/")).json();
+        expect(json.status).toBe(599);
+        expect("title" in json).toBe(false);
+      });
+
+      it("masks unhandled errors with debug disabled", async () => {
+        t.app.get("/", () => {
+          throw new Error("senha do banco: 123");
+        });
+        const res = await t.fetch("/");
+        const text = await res.text();
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toBe("application/problem+json");
+        expect(text).not.toContain("senha do banco");
+        expect(text).not.toContain("stack");
+        expect(JSON.parse(text)).toEqual({
+          type: "about:blank",
+          title: "Internal Server Error",
+          status: 500,
+          detail: "HTTPError",
+          unhandled: true,
+        });
+      });
+
+      it("does not copy type, instance or statusText from the cause of an unhandled error", async () => {
+        t.app.get("/", () => {
+          const cause = Object.assign(new Error("leak"), {
+            statusText: "Leaked Status",
+            type: "https://leak.example/type",
+            instance: "/var/secret/path",
+          });
+          throw cause;
+        });
+        const json = await (await t.fetch("/")).json();
+        expect(json.title).toBe("Internal Server Error");
+        expect(json.type).toBe("about:blank");
+        expect("instance" in json).toBe(false);
+        expect(JSON.stringify(json)).not.toContain("leak");
+      });
+
+      it("includes stack for unhandled errors with debug enabled", async () => {
+        t.app.config.debug = true;
+        t.app.get("/", () => {
+          throw new Error("boom");
+        });
+        const json = await (await t.fetch("/")).json();
+        expect(json.detail).toBe("HTTPError");
+        expect(Array.isArray(json.stack)).toBe(true);
+        expect(json.stack[0]).toContain("boom");
+      });
+
+      it("applies HTTPError headers and lets a content-type header from the error win", async () => {
+        t.app.get("/", () => {
+          throw new HTTPError({ status: 400, message: "Bad", headers: { "x-foo": "1" } });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("x-foo")).toBe("1");
+        expect(res.headers.get("content-type")).toBe("application/problem+json");
+
+        t.app.get("/custom", () => {
+          throw new HTTPError({
+            status: 400,
+            message: "Bad",
+            headers: { "content-type": "application/vnd.custom+json" },
+          });
+        });
+        const custom = await t.fetch("/custom");
+        expect(custom.headers.get("content-type")).toBe("application/vnd.custom+json");
+      });
+
+      it("applies errHeaders set on event.res to error responses", async () => {
+        t.app.get("/", (event: H3Event) => {
+          event.res.errHeaders.set("x-error", "prepared");
+          throw HTTPError.status(401, "Unauthorized", { message: "Login" });
+        });
+        const res = await t.fetch("/");
+        expect(res.headers.get("x-error")).toBe("prepared");
+        expect(res.headers.get("content-type")).toBe("application/problem+json");
+      });
+
+      it("renders an empty body for HEAD errors", async () => {
+        t.app.get("/", () => {
+          throw HTTPError.status(404, "Not Found", { message: "Nada" });
+        });
+        const res = await t.fetch("/", { method: "HEAD" });
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-length")).toBeNull();
+        expect(await res.text()).toBe("");
+      });
+
+      it("renders a problem document when onError is configured", async () => {
+        t.app.config.onError = () => {};
+        t.app.get("/", () => {
+          throw HTTPError.status(418, "I'm a teapot", { message: "Chá" });
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(418);
+        expect(res.headers.get("content-type")).toBe("application/problem+json");
+        expect(await res.json()).toMatchObject({
+          status: 418,
+          title: "I'm a teapot",
+          detail: "Chá",
+          type: "about:blank",
+        });
+        t.app.config.onError = undefined;
+      });
