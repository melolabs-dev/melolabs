diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..36909a3
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,107 @@
+import type { HTTPError } from "../../error.ts";
+
+/**
+ * RFC 9457 problem document, with extension members.
+ * RFC members take precedence over extension keys with the same name.
+ */
+export interface ProblemDetails {
+  type: string;
+  title?: string;
+  status: number;
+  detail: string;
+  instance?: string;
+  [extension: string]: unknown;
+}
+
+/**
+ * Standard IANA reason phrases, used as `title` when the error has no `statusText`.
+ * Status codes missing from this table get no `title`.
+ */
+const kReasonPhrases: Readonly<Record<number, string>> = {
+  100: "Continue",
+  101: "Switching Protocols",
+  102: "Processing",
+  103: "Early Hints",
+  200: "OK",
+  201: "Created",
+  202: "Accepted",
+  203: "Non-Authoritative Information",
+  204: "No Content",
+  205: "Reset Content",
+  206: "Partial Content",
+  207: "Multi-Status",
+  208: "Already Reported",
+  226: "IM Used",
+  300: "Multiple Choices",
+  301: "Moved Permanently",
+  302: "Found",
+  303: "See Other",
+  304: "Not Modified",
+  305: "Use Proxy",
+  307: "Temporary Redirect",
+  308: "Permanent Redirect",
+  400: "Bad Request",
+  401: "Unauthorized",
+  402: "Payment Required",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  407: "Proxy Authentication Required",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  411: "Length Required",
+  412: "Precondition Failed",
+  413: "Content Too Large",
+  414: "URI Too Long",
+  415: "Unsupported Media Type",
+  416: "Range Not Satisfiable",
+  417: "Expectation Failed",
+  418: "I'm a teapot",
+  421: "Misdirected Request",
+  422: "Unprocessable Content",
+  423: "Locked",
+  424: "Failed Dependency",
+  425: "Too Early",
+  426: "Upgrade Required",
+  428: "Precondition Required",
+  429: "Too Many Requests",
+  431: "Request Header Fields Too Large",
+  451: "Unavailable For Legal Reasons",
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+  505: "HTTP Version Not Supported",
+  506: "Variant Also Negotiates",
+  507: "Insufficient Storage",
+  508: "Loop Detected",
+  510: "Not Extended",
+  511: "Network Authentication Required",
+};
+
+/**
+ * Build the problem document for an `HTTPError`.
+ *
+ * - Extension members (`body`, `data`, `unhandled`, `stack`) come first, so RFC members win on key clashes.
+ * - Unhandled errors use a fixed `detail`, and no `type`, `instance`, `data`, `body` or `statusText`.
+ * - `stack` is only included in debug mode.
+ */
+export function toProblemDetails(error: HTTPError, debug?: boolean): ProblemDetails {
+  const unhandled = error.unhandled;
+  const stack =
+    debug && error.stack ? error.stack.split("\n").map((line) => line.trim()) : undefined;
+  return {
+    ...(unhandled ? undefined : error.body),
+    data: unhandled ? undefined : error.data,
+    unhandled,
+    stack,
+    type: (!unhandled && error.type) || "about:blank",
+    title: (!unhandled && error.statusText) || kReasonPhrases[error.status],
+    status: error.status,
+    detail: unhandled ? "HTTPError" : error.message,
+    ...(!unhandled && error.instance ? { instance: error.instance } : undefined),
+  };
+}
