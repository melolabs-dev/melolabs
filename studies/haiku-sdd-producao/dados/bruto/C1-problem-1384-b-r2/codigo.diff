diff --git a/test/unit/http-error.test.ts b/test/unit/http-error.test.ts
new file mode 100644
index 0000000..3015aa6
--- /dev/null
+++ b/test/unit/http-error.test.ts
@@ -0,0 +1,56 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+
+describe("HTTPError", () => {
+  it("exposes type and instance when provided", () => {
+    const error = new HTTPError({
+      status: 403,
+      message: "Negado",
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+    expect(error.instance).toBe("/pedidos/42");
+  });
+
+  it("leaves type and instance undefined when not provided", () => {
+    const error = new HTTPError({ status: 500, message: "Falhou" });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("does not read type and instance from cause", () => {
+    const error = new HTTPError({
+      status: 500,
+      cause: { type: "x", instance: "y" },
+    });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("ignores type and instance values that are not strings", () => {
+    const error = new HTTPError({
+      status: 500,
+      message: "Falhou",
+      type: 42 as unknown as string,
+      instance: { path: "/x" } as unknown as string,
+    });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("keeps toJSON output unchanged", () => {
+    const error = HTTPError.status(400, "Bad Request", {
+      message: "Inválido",
+      type: "https://exemplo.com/erros/invalido",
+      instance: "/pedidos/1",
+    });
+    expect(error.toJSON()).toStrictEqual({
+      status: 400,
+      statusText: "Bad Request",
+      unhandled: undefined,
+      message: "Inválido",
+      data: undefined,
+    });
+  });
+});
