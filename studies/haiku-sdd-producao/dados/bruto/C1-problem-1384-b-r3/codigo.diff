diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..93c07ed
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,212 @@
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemContentType = "application/problem+json";
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  it("RF-01: responds HTTPError with application/problem+json", async () => {
+    t.app.use(() => {
+      throw new HTTPError({ status: 422, message: "Dados inválidos" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(422);
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+  });
+
+  it("RF-02: body has status, title, detail and type about:blank", async () => {
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 404,
+        statusText: "Not Found",
+        message: "Usuário não encontrado",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      status: 404,
+      title: "Not Found",
+      detail: "Usuário não encontrado",
+      type: "about:blank",
+    });
+  });
+
+  it("RF-02: router 404 has title from the default status text", async () => {
+    const res = await t.fetch("/missing");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+    expect(await res.json()).toMatchObject({
+      status: 404,
+      title: "Not Found",
+      type: "about:blank",
+    });
+  });
+
+  it("RF-03: type and instance are exposed on the error and in the body", async () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+    expect(error.instance).toBe("/pedidos/42");
+
+    t.app.use(() => {
+      throw error;
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+  });
+
+  it("RF-04: type is inherited from cause", () => {
+    const error = new HTTPError({
+      status: 500,
+      cause: { status: 409, type: "https://exemplo.com/erros/conflito" },
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/conflito");
+  });
+
+  it("RF-05: extension members stay in the body", async () => {
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 400,
+        message: "Campo inválido",
+        data: { campo: "email" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      status: 400,
+      title: "Bad Request",
+      detail: "Campo inválido",
+      type: "about:blank",
+      message: "Campo inválido",
+      data: { campo: "email" },
+    });
+  });
+
+  it("RF-05: body cannot override status or type", async () => {
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 400,
+        message: "Campo inválido",
+        body: { type: "x", status: 1 },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(400);
+    const json = await res.json();
+    expect(json.status).toBe(400);
+    expect(json.type).toBe("about:blank");
+  });
+
+  it("RF-07: custom headers are kept with the default problem content type", async () => {
+    t.app.use(() => {
+      throw new HTTPError({ status: 429, headers: { "Retry-After": "30" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("retry-after")).toBe("30");
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+  });
+
+  it("RF-07: user Content-Type header wins", async () => {
+    t.app.use(() => {
+      throw new HTTPError({ status: 429, headers: { "Content-Type": "text/plain" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("text/plain");
+  });
+
+  it("RF-08: same status, content type and body in web and node", async () => {
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 409,
+        type: "https://exemplo.com/erros/conflito",
+        instance: "/pedidos/1",
+        message: "Conflito",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(409);
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+    expect(await res.json()).toMatchObject({
+      message: "Conflito",
+      status: 409,
+      title: "Conflict",
+      detail: "Conflito",
+      type: "https://exemplo.com/erros/conflito",
+      instance: "/pedidos/1",
+    });
+  });
+
+  it("RF-09: an H3 without config answers with problem details", async () => {
+    t.app.use(() => {
+      throw new HTTPError({ status: 418, message: "teapot" });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+    expect(await res.json()).toMatchObject({ status: 418, type: "about:blank" });
+  });
+
+  describe("sanity", () => {
+    it("success responses keep application/json", async () => {
+      t.app.get("/", () => ({ ok: true }));
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+  });
+});
+
+// Unhandled errors are reported to the global error hook, so these cases opt out of the afterEach check.
+describeMatrix(
+  "problem details, unhandled (RFC 9457)",
+  (t, { it, expect }) => {
+    it("RF-02: unhandled error without statusText has default status title", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new Error("boom");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({
+        status: 500,
+        title: "Internal Server Error",
+        type: "about:blank",
+      });
+    });
+
+    it("RF-06: unhandled error hides the secret and the stack", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          message: "segredo-interno",
+          cause: new Error("segredo-interno"),
+        });
+      });
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(text).not.toContain("segredo-interno");
+      expect(JSON.parse(text)).not.toHaveProperty("stack");
+      expect(JSON.parse(text)).toMatchObject({
+        status: 500,
+        detail: "HTTPError",
+        type: "about:blank",
+      });
+    });
+
+    it("RF-06: stack is visible in debug mode", async () => {
+      t.app.config.debug = true;
+      t.app.use(() => {
+        throw new HTTPError({ status: 500, unhandled: true, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toHaveProperty("stack");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
diff --git a/test/unit/status-text.test.ts b/test/unit/status-text.test.ts
new file mode 100644
index 0000000..c7f7c97
--- /dev/null
+++ b/test/unit/status-text.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { getDefaultStatusText } from "../../src/utils/internal/status-text.ts";
+
+describe("getDefaultStatusText", () => {
+  it("returns the standard phrase for known codes", () => {
+    expect(getDefaultStatusText(400)).toBe("Bad Request");
+    expect(getDefaultStatusText(404)).toBe("Not Found");
+    expect(getDefaultStatusText(500)).toBe("Internal Server Error");
+  });
+
+  it("returns a fallback for codes outside the table", () => {
+    expect(getDefaultStatusText(599)).toBe("Unknown Error");
+  });
+});
