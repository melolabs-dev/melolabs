--- /dev/null
+++ b/src/utils/internal/status.ts
@@ -0,0 +1,23 @@
+/**
+ * Standard reason phrases for the statuses h3 itself produces.
+ */
+const kReasonPhrases: Record<number, string> = {
+  400: "Bad Request",
+  401: "Unauthorized",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  413: "Content Too Large",
+  415: "Unsupported Media Type",
+  500: "Internal Server Error",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+};
+
+/**
+ * Standard reason phrase for the statuses h3 produces, or `undefined` for others.
+ */
+export function reasonPhrase(status: number): string | undefined {
+  return kReasonPhrases[status];
+}
