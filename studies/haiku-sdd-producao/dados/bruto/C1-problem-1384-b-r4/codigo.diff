diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..c53bdde
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,179 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemJson = "application/problem+json";
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  // The test harness runs with `debug` on; production bodies are checked with it off.
+  beforeEach(() => {
+    t.app.config.debug = false;
+  });
+
+  describe("body members", () => {
+    it("renders status, title, detail and type for a handler error (RF-01)", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404, "Not Found", { message: "Usuário não encontrado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(await res.json()).toStrictEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não encontrado",
+      });
+    });
+
+    it("sends the problem media type for errors and keeps JSON for success (RF-02)", async () => {
+      t.app.get("/error", () => {
+        throw new HTTPError({ status: 400, message: "Bad" });
+      });
+      t.app.get("/ok", () => ({ ok: true }));
+
+      const error = await t.fetch("/error");
+      expect(error.headers.get("content-type")).toBe(problemJson);
+
+      const ok = await t.fetch("/ok");
+      expect(ok.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+
+    it("keeps data and body as top level members (RF-04)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 422,
+          message: "Inválido",
+          data: { campo: "email" },
+          body: { codigo: "E_EMAIL" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        status: 422,
+        detail: "Inválido",
+        data: { campo: "email" },
+        codigo: "E_EMAIL",
+      });
+    });
+
+    it("does not let body override RFC members (D-04)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404, message: "Gone", body: { status: 200, title: "x" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(await res.json()).toMatchObject({ status: 404, title: "Not Found" });
+    });
+
+    it("hides the message and extensions of unhandled errors (RF-05)", async () => {
+      t.app.get("/plain", () => {
+        throw new Error("senha do banco: 123");
+      });
+      t.app.get("/extended", () => {
+        throw new HTTPError({
+          status: 500,
+          message: "senha do banco: 123",
+          unhandled: true,
+          data: { senha: "123" },
+          body: { extra: "senha do banco" },
+        });
+      });
+
+      for (const path of ["/plain", "/extended"]) {
+        const res = await t.fetch(path);
+        expect(res.status).toBe(500);
+        const text = await res.text();
+        expect(text).not.toContain("senha do banco");
+        expect(text).not.toContain("123");
+        expect(JSON.parse(text)).toStrictEqual({
+          type: "about:blank",
+          title: "Internal Server Error",
+          status: 500,
+          detail: "HTTPError",
+        });
+      }
+      t.errors = [];
+    });
+
+    it("includes stack only in debug mode (RF-06)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "Bad" });
+      });
+
+      const plain = await t.fetch("/");
+      expect(await plain.json()).not.toHaveProperty("stack");
+
+      t.app.config.debug = true;
+      const debug = await t.fetch("/");
+      const body = await debug.json();
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(body.stack.every((line: unknown) => typeof line === "string")).toBe(true);
+    });
+
+    it("renders h3-generated 404 in the problem format (RF-07)", async () => {
+      const res = await t.fetch("/inexistente");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemJson);
+      expect(await res.json()).toMatchObject({ status: 404 });
+    });
+
+    it("keeps error headers and adds the problem media type (RF-09)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 401,
+          message: "Auth",
+          headers: { "WWW-Authenticate": "Basic" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("www-authenticate")).toBe("Basic");
+      expect(res.headers.get("content-type")).toBe(problemJson);
+    });
+
+    it("uses the internal reason phrase when statusText is empty", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 500, statusText: "", message: "boom" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ title: "Internal Server Error" });
+    });
+
+    it("omits title for statuses outside the internal table", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 418, message: "teapot" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(await res.json()).not.toHaveProperty("title");
+    });
+  });
+});
+
+describe("HTTPError type and instance (RF-03)", () => {
+  it("exposes type and instance from the input", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-saldo",
+      instance: "/pagamentos/42",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-saldo");
+    expect(error.instance).toBe("/pagamentos/42");
+  });
+
+  it("defaults type to about:blank and instance to undefined", () => {
+    const error = new HTTPError({ status: 403 });
+    expect(error.type).toBe("about:blank");
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("ignores type and instance from cause", () => {
+    const cause = { status: 502, type: "https://upstream/x", instance: "/upstream/1" };
+    const error = new HTTPError({ status: 502, cause });
+    expect(error.type).toBe("about:blank");
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("omits instance from the serialized body when not set", () => {
+    expect(JSON.stringify(new HTTPError({ status: 404 }))).not.toContain("instance");
+  });
+});
