diff --git a/test/problem-details.test.ts b/test/problem-details.test.ts
new file mode 100644
index 0000000..f3c4699
--- /dev/null
+++ b/test/problem-details.test.ts
@@ -0,0 +1,142 @@
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemJson = "application/problem+json;charset=UTF-8";
+
+describeMatrix("problem details", (t, { it, expect }) => {
+  it("renders HTTPError with application/problem+json (RF-01)", async () => {
+    t.app.use(() => {
+      throw HTTPError.status(400, "Bad Request");
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-type")).toBe(problemJson);
+  });
+
+  it("includes RFC 9457 members for a 422 error (RF-02)", async () => {
+    t.app.use(() => {
+      throw HTTPError.status(422, "Unprocessable Content", {
+        message: "Campo email inválido",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "about:blank",
+      title: "Unprocessable Content",
+      status: 422,
+      detail: "Campo email inválido",
+    });
+  });
+
+  it("exposes type and instance on the error and in the body (RF-03)", async () => {
+    const error = new HTTPError({
+      status: 403,
+      message: "Negado",
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/12",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+    expect(error.instance).toBe("/pedidos/12");
+
+    t.app.use(() => {
+      throw error;
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/12",
+    });
+  });
+
+  it("defaults type to about:blank when not informed (RF-04)", async () => {
+    const error = HTTPError.status(404, "Not Found");
+    expect(error.type).toBeUndefined();
+
+    t.app.use(() => {
+      throw error;
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "about:blank",
+      status: 404,
+    });
+  });
+
+  it("does not leak unhandled error details (RF-05)", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new Error("senha do banco: 123");
+    });
+    const res = await t.fetch("/");
+    // The unhandled error is expected here, so do not fail the global check
+    t.errors = [];
+
+    expect(res.status).toBe(500);
+    expect(res.headers.get("content-type")).toBe(problemJson);
+
+    const body = await res.json();
+    expect(body).toMatchObject({
+      type: "about:blank",
+      title: "Internal Server Error",
+      status: 500,
+      unhandled: true,
+    });
+    expect(body.detail).not.toBe("senha do banco: 123");
+    expect(JSON.stringify(body)).not.toContain("senha do banco");
+    expect(body).not.toHaveProperty("stack");
+  });
+
+  it("keeps data, body members and message as extensions (RF-06)", async () => {
+    t.app.use(() => {
+      throw HTTPError.status(409, "Conflict", {
+        message: "Conflito",
+        data: { id: 7 },
+        body: { motivo: "duplicado" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      detail: "Conflito",
+      data: { id: 7 },
+      motivo: "duplicado",
+    });
+  });
+
+  it("keeps status and headers of HTTPError (RF-07)", async () => {
+    t.app.use(() => {
+      throw HTTPError.status(429, "Too Many Requests", {
+        headers: { "retry-after": "30" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(429);
+    expect(res.headers.get("retry-after")).toBe("30");
+    expect(res.headers.get("content-type")).toBe(problemJson);
+    expect(await res.json()).toMatchObject({ status: 429, title: "Too Many Requests" });
+  });
+
+  it("renders the error returned by onError as problem details (RF-08)", async () => {
+    t.app.config.onError = () => HTTPError.status(418, "I'm a teapot");
+    t.app.use(() => {
+      throw new Error("boom");
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(418);
+    expect(res.headers.get("content-type")).toBe(problemJson);
+    expect(await res.json()).toMatchObject({ title: "I'm a teapot", status: 418 });
+
+    // onError replaces the default handler, so no unhandled error is recorded
+    t.errors = [];
+  });
+
+  it("renders the 404 for a missing route as problem details (RF-09)", async () => {
+    const res = await t.fetch("/inexistente");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(problemJson);
+    expect(await res.json()).toMatchObject({
+      type: "about:blank",
+      status: 404,
+      detail: expect.stringContaining("Cannot find any route matching [GET]"),
+    });
+  });
+});
diff --git a/test/unit/problem-details.test.ts b/test/unit/problem-details.test.ts
new file mode 100644
index 0000000..567f172
--- /dev/null
+++ b/test/unit/problem-details.test.ts
@@ -0,0 +1,82 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+import { sanitizeStatusMessage } from "../../src/utils/sanitize.ts";
+import { defaultStatusText, toProblemDetails } from "../../src/utils/internal/problem.ts";
+
+describe("toProblemDetails", () => {
+  it("masks message and drops data and body for unhandled errors", () => {
+    const error = new HTTPError({
+      status: 500,
+      message: "senha do banco: 123",
+      unhandled: true,
+      data: { secret: 1 },
+      body: { motivo: "vazado" },
+    });
+    const problem = toProblemDetails(error);
+    expect(problem.detail).toBe("HTTPError");
+    expect(problem.data).toBeUndefined();
+    expect(problem.motivo).toBeUndefined();
+  });
+
+  it("keeps RFC 9457 members when body has the same keys", () => {
+    const error = HTTPError.status(422, "Unprocessable Content", {
+      message: "Campo inválido",
+      type: "https://exemplo.com/erros/campo",
+      instance: "/pedidos/1",
+      body: { type: "x", title: "x", status: 1, detail: "x", instance: "x" },
+    });
+    const problem = toProblemDetails(error);
+    expect(problem).toMatchObject({
+      type: "https://exemplo.com/erros/campo",
+      title: "Unprocessable Content",
+      status: 422,
+      detail: "Campo inválido",
+      instance: "/pedidos/1",
+    });
+  });
+
+  it("uses about:blank and the default status text when none is informed", () => {
+    const problem = toProblemDetails(new HTTPError({ status: 500, message: "x" }));
+    expect(problem.type).toBe("about:blank");
+    expect(problem.title).toBe("Internal Server Error");
+    expect(problem.instance).toBeUndefined();
+  });
+
+  it("prefers statusText over the default status text", () => {
+    const problem = toProblemDetails(HTTPError.status(418, "I'm a teapot"));
+    expect(problem.title).toBe("I'm a teapot");
+  });
+});
+
+describe("HTTPError.toJSON", () => {
+  it("keeps the previous shape without problem details members", () => {
+    const keys = Object.keys(
+      HTTPError.status(422, "Unprocessable Content", { message: "x" }).toJSON(),
+    );
+    expect(keys).not.toContain("type");
+    expect(keys).not.toContain("title");
+    expect(keys).not.toContain("detail");
+  });
+});
+
+describe("defaultStatusText", () => {
+  it("returns RFC 9110 phrases", () => {
+    expect(defaultStatusText(422)).toBe("Unprocessable Content");
+    expect(defaultStatusText(500)).toBe("Internal Server Error");
+    expect(defaultStatusText(413)).toBe("Content Too Large");
+  });
+
+  it("returns undefined for codes outside the table", () => {
+    expect(defaultStatusText(599)).toBeUndefined();
+    expect(defaultStatusText(299)).toBeUndefined();
+  });
+
+  it("uses only phrases accepted by sanitizeStatusMessage", () => {
+    for (let status = 100; status <= 599; status++) {
+      const text = defaultStatusText(status);
+      if (text === undefined) continue;
+      expect(text).toMatch(/^[ -~]+$/);
+      expect(sanitizeStatusMessage(text)).toBe(text);
+    }
+  });
+});
