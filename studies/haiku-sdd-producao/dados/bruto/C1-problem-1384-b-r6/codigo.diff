+describe("getStatusPhrase", () => {
+  it("returns the RFC 9110 phrase for common codes", () => {
+    expect(getStatusPhrase(404)).toBe("Not Found");
+    expect(getStatusPhrase(500)).toBe("Internal Server Error");
+  });
+
+  it("covers every registered code from 1xx to 5xx", () => {
+    const registered = [
+      100, 101, 102, 103, 200, 201, 202, 203, 204, 205, 206, 207, 208, 226, 300, 301, 302, 303, 304,
+      305, 307, 308, 400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 410, 411, 412, 413, 414, 415,
+      416, 417, 418, 421, 422, 423, 424, 425, 426, 428, 429, 431, 451, 500, 501, 502, 503, 504, 505,
+      506, 507, 508, 510, 511,
+    ];
+    for (const status of registered) {
+      expect(getStatusPhrase(status), String(status)).toBeTypeOf("string");
+    }
+  });
+
+  it("returns undefined for unregistered codes", () => {
+    expect(getStatusPhrase(599)).toBeUndefined();
+    expect(getStatusPhrase(306)).toBeUndefined();
+    expect(getStatusPhrase(999)).toBeUndefined();
+  });
+});
+
+describe("HTTPError.toJSON()", () => {
+  it("uses about:blank, the status phrase and the status", () => {
+    expect(new HTTPError({ status: 404, message: "Usuário não encontrado" }).toJSON()).toEqual({
+      type: "about:blank",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário não encontrado",
+    });
+  });
+
+  it("does not let body members override the standard members", () => {
+    const error = new HTTPError({
+      status: 409,
+      message: "conflict",
+      body: { status: 1, title: "x", type: "y", detail: "z", instance: "w", extra: true },
+    });
+    expect(error.toJSON()).toEqual({
+      extra: true,
+      type: "about:blank",
+      title: "Conflict",
+      status: 409,
+      detail: "conflict",
+    });
+  });
+
+  it("does not leak body detail or instance when the standard members are absent", () => {
+    const problem = new HTTPError({
+      status: 500,
+      body: { detail: "secret", instance: "/secret" },
+    }).toJSON();
+    expect(problem).not.toHaveProperty("detail");
+    expect(problem).not.toHaveProperty("instance");
+  });
+
+  it("hides detail, data and body of unhandled errors", () => {
+    const problem = new HTTPError({
+      status: 500,
+      message: "db password",
+      unhandled: true,
+      data: { secret: 1 },
+      body: { secret: 2 },
+    }).toJSON();
+    expect(problem).toEqual({
+      type: "about:blank",
+      title: "Internal Server Error",
+      status: 500,
+      unhandled: true,
+    });
+  });
+
+  it("prefers statusText over the status phrase in title, except for unhandled errors", () => {
+    expect(new HTTPError({ status: 422, statusText: "Unprocessable" }).toJSON().title).toBe(
+      "Unprocessable",
+    );
+    expect(
+      new HTTPError({ status: 422, statusText: "internal detail", unhandled: true }).toJSON().title,
+    ).toBe("Unprocessable Content");
+  });
+
+  it("uses the message of an Error as detail, also when it is the cause", () => {
+    expect(new HTTPError(new Error("x")).toJSON()).toMatchObject({ detail: "x" });
+    expect(new HTTPError({ cause: new Error("x") }).toJSON()).toMatchObject({ detail: "x" });
+  });
+
+  it("omits detail when the message is synthesized", () => {
+    expect(new HTTPError({ status: 500 }).toJSON()).not.toHaveProperty("detail");
+    expect(new HTTPError({ status: 500, statusText: "Oops" }).toJSON()).not.toHaveProperty(
+      "detail",
+    );
+  });
+
+  it("keeps Error.message unchanged for logs and onError", () => {
+    expect(new HTTPError({ status: 500 }).message).toBe("HTTPError 500");
+    expect(new HTTPError({ status: 404, message: "gone" }).message).toBe("gone");
+  });
+
+  it("reads type and instance only from the details, not from the cause", () => {
+    const cause = Object.assign(new Error("x"), { type: "urn:cause", instance: "/cause" });
+    const error = new HTTPError({ status: 400, cause });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("serializes type and instance when given", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+    expect(error.instance).toBe("/pedidos/42");
+    expect(error.toJSON()).toMatchObject({
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+  });
+});
