diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..4e71e46
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,244 @@
+import { describe, expect, it } from "vitest";
+import { describeMatrix } from "./_setup.ts";
+import { HTTPError, problem } from "../src/index.ts";
+
+// Characterization: these pin the current `HTTPError` responses and must pass without src changes.
+describeMatrix("HTTPError responses are unchanged", (ctx, { it, expect }) => {
+  it("renders new HTTPError as the JSON body with status, statusText, message and stack", async () => {
+    ctx.app.get("/", () => {
+      throw new HTTPError({ status: 409, message: "Conflito" });
+    });
+    const res = await ctx.fetch("/");
+    expect(res.status).toBe(409);
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    expect(await res.json()).toEqual({
+      status: 409,
+      message: "Conflito",
+      stack: expect.any(Array),
+    });
+  });
+
+  it("renders HTTPError.status() with statusText", async () => {
+    ctx.app.get("/", () => {
+      throw HTTPError.status(404, "Not Found");
+    });
+    const res = await ctx.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    expect(await res.json()).toEqual({
+      status: 404,
+      statusText: "Not Found",
+      message: "Not Found",
+      stack: expect.any(Array),
+    });
+  });
+});
+
+describeMatrix(
+  "HTTPError responses are unchanged (unhandled)",
+  (ctx, { it, expect }) => {
+    it("hides message and body of an unhandled HTTPError", async () => {
+      ctx.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          message: "Falha no banco",
+          unhandled: true,
+          body: { code: "X" },
+        });
+      });
+      const res = await ctx.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toEqual({
+        status: 500,
+        message: "HTTPError",
+        unhandled: true,
+        stack: expect.any(Array),
+      });
+    });
+
+    it("renders a plain Error as an unhandled HTTPError body", async () => {
+      ctx.app.get("/", () => {
+        throw new Error("boom");
+      });
+      const res = await ctx.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toEqual({
+        status: 500,
+        message: "HTTPError",
+        unhandled: true,
+        stack: expect.any(Array),
+      });
+    });
+  },
+  { allowUnhandledErrors: true },
+);
+
+describeMatrix("problem()", (ctx, { it, expect }) => {
+  const input = {
+    status: 422,
+    statusText: "Unprocessable Content",
+    message: "Saldo insuficiente",
+    type: "https://exemplo.com/erros/saldo",
+    instance: "/transferencias/7",
+  };
+
+  it("produces the same response when thrown or returned", async () => {
+    ctx.app.get("/throw", () => {
+      throw problem(input);
+    });
+    ctx.app.get("/return", () => problem(input));
+
+    const thrown = await ctx.fetch("/throw");
+    const returned = await ctx.fetch("/return");
+    expect(returned.status).toBe(thrown.status);
+    expect(returned.headers.get("content-type")).toBe(thrown.headers.get("content-type"));
+    // `stack` points at the call site, which differs between the two routes
+    const thrownBody = await thrown.json();
+    const returnedBody = await returned.json();
+    delete thrownBody.stack;
+    delete returnedBody.stack;
+    expect(returnedBody).toEqual(thrownBody);
+  });
+
+  it("renders type, title, status, detail and instance (RF-03)", async () => {
+    ctx.app.get("/", () => {
+      throw problem(input);
+    });
+    const res = await ctx.fetch("/");
+    expect(res.status).toBe(422);
+    expect(await res.json()).toEqual({
+      type: "https://exemplo.com/erros/saldo",
+      title: "Unprocessable Content",
+      status: 422,
+      detail: "Saldo insuficiente",
+      instance: "/transferencias/7",
+      stack: expect.any(Array),
+    });
+  });
+
+  it("defaults type to about:blank and omits title and instance when absent", async () => {
+    ctx.app.get("/", () => {
+      throw problem({ status: 409, message: "Conflito" });
+    });
+    const body = await (await ctx.fetch("/")).json();
+    expect(body).toEqual({
+      type: "about:blank",
+      status: 409,
+      detail: "Conflito",
+      stack: expect.any(Array),
+    });
+    expect(body).not.toHaveProperty("title");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("puts body members at the top level as extensions", async () => {
+    ctx.app.get("/", () => {
+      throw problem({ status: 409, message: "Conflito", body: { code: "X" } });
+    });
+    const body = await (await ctx.fetch("/")).json();
+    expect(body).toMatchObject({ code: "X", type: "about:blank", status: 409 });
+  });
+
+  it("lets RFC members win over colliding body members", async () => {
+    ctx.app.get("/", () => {
+      throw problem({
+        status: 409,
+        message: "Conflito",
+        body: { status: 999, type: "x", detail: "y" },
+      });
+    });
+    const res = await ctx.fetch("/");
+    expect(res.status).toBe(409);
+    const body = await res.json();
+    expect(body).toMatchObject({ status: 409, type: "about:blank", detail: "Conflito" });
+  });
+
+  it("uses application/problem+json exactly (RF-04)", async () => {
+    ctx.app.get("/", () => {
+      throw problem({ status: 409, message: "Conflito" });
+    });
+    const res = await ctx.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/problem+json");
+  });
+
+  it("includes stack in debug mode", async () => {
+    ctx.app.get("/", () => {
+      throw problem({ status: 409, message: "Conflito" });
+    });
+    const body = await (await ctx.fetch("/")).json();
+    expect(body.stack).toEqual(expect.any(Array));
+  });
+
+  it("passes the problem error to onError", async () => {
+    const thrown = problem({ status: 409, message: "Conflito" });
+    ctx.app.get("/", () => {
+      throw thrown;
+    });
+    await ctx.fetch("/");
+    expect(ctx.errors).toHaveLength(1);
+    expect(ctx.errors[0]).toBe(thrown);
+    expect(HTTPError.isError(ctx.errors[0])).toBe(true);
+  });
+
+  it("clamps an invalid status to 500 and keeps headers (RF-07)", async () => {
+    ctx.app.get("/", () => {
+      throw problem({ status: 999, message: "x", headers: { "retry-after": "30" } });
+    });
+    const res = await ctx.fetch("/");
+    expect(res.status).toBe(500);
+    expect(res.headers.get("retry-after")).toBe("30");
+    expect(res.headers.get("content-type")).toBe("application/problem+json");
+    expect(await res.json()).toMatchObject({ status: 500, detail: "x" });
+  });
+});
+
+describeMatrix(
+  "problem() unhandled",
+  (ctx, { it, expect }) => {
+    it("hides detail, message and body members (RF-06)", async () => {
+      ctx.app.get("/", () => {
+        throw problem({
+          status: 500,
+          message: "Falha no banco",
+          unhandled: true,
+          body: { code: "X" },
+        });
+      });
+      const res = await ctx.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      const body = await res.json();
+      expect(body).toEqual({
+        type: "about:blank",
+        status: 500,
+        unhandled: true,
+        stack: expect.any(Array),
+      });
+      expect(body).not.toHaveProperty("detail");
+      expect(body).not.toHaveProperty("code");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
+
+describe("problem() helpers", () => {
+  it("is recognized by HTTPError.isError (RF-01)", () => {
+    expect(HTTPError.isError(problem({ status: 400, message: "x" }))).toBe(true);
+  });
+
+  it("returns an HTTPError with the given status and message (RF-01)", () => {
+    const error = problem({ status: 404, message: "Pedido não encontrado" });
+    expect(error).toBeInstanceOf(HTTPError);
+    expect(error.status).toBe(404);
+    expect(error.message).toBe("Pedido não encontrado");
+  });
+
+  it("keeps the marker out of enumerable state and JSON (R-02)", () => {
+    const error = problem({ status: 400, message: "x" });
+    const plain = new HTTPError({ status: 400, message: "x" });
+    expect(Object.keys({ ...error })).toEqual(Object.keys({ ...plain }));
+    expect(JSON.stringify(error)).toBe(JSON.stringify(plain));
+  });
+});
