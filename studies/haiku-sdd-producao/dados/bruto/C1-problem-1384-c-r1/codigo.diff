+import { describe, it, expectTypeOf } from "vitest";
+import { HTTPError, problem, type ProblemInput } from "../../src/index.ts";
+
+describe("problem types", () => {
+  it("accepts type and instance, and returns HTTPError", () => {
+    expectTypeOf(
+      problem({ status: 404, message: "x", type: "https://example.com/a", instance: "/a/1" }),
+    ).toEqualTypeOf<HTTPError>();
+  });
+
+  it("types type and instance as optional strings", () => {
+    expectTypeOf<ProblemInput["type"]>().toEqualTypeOf<string | undefined>();
+    expectTypeOf<ProblemInput["instance"]>().toEqualTypeOf<string | undefined>();
+  });
+
+  it("rejects unknown properties", () => {
+    // @ts-expect-error unknown properties are not accepted
+    problem({ status: 404, message: "x", foo: 1 });
+  });
+});
