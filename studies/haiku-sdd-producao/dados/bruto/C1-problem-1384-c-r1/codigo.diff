diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..cded5c0
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,40 @@
+import type { HTTPError } from "../../error.ts";
+
+/**
+ * Marker for an `HTTPError` created by `problem()`, which selects the RFC 9457 response format.
+ *
+ * Registry symbol, so it matches across duplicate h3 copies (same reason as `kHTTPResponse`).
+ * Set non-enumerable, so it stays out of spreads, `Object.keys` and `JSON.stringify`.
+ */
+export const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+export interface ProblemMembers {
+  type?: string;
+  instance?: string;
+}
+
+/**
+ * Build the RFC 9457 JSON body for an `HTTPError` created by `problem()`.
+ *
+ * Extension members (`body`) come first, so RFC members win on collision. Absent optional members
+ * are left out instead of set to `undefined`, so they do not erase a same-named `body` member.
+ */
+export function toProblemJSON(error: HTTPError, members: ProblemMembers): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  const json: Record<string, unknown> = unhandled ? {} : { ...error.body };
+  json.type = members.type ?? "about:blank";
+  if (error.statusText !== undefined) {
+    json.title = error.statusText;
+  }
+  json.status = error.status;
+  if (!unhandled) {
+    json.detail = error.message;
+  }
+  if (members.instance !== undefined) {
+    json.instance = members.instance;
+  }
+  if (unhandled) {
+    json.unhandled = unhandled;
+  }
+  return json;
+}
diff --git a/src/utils/problem.ts b/src/utils/problem.ts
new file mode 100644
index 0000000..547861f
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,33 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { kProblem, type ProblemMembers } from "./internal/problem.ts";
+
+/**
+ * Input for {@link problem}: the `HTTPError` input plus RFC 9457 members.
+ */
+export interface ProblemInput extends ErrorInput {
+  /**
+   * URI identifying the problem type. Serialized as `type` (defaults to `about:blank`).
+   */
+  type?: string;
+
+  /**
+   * URI reference identifying this occurrence. Serialized as `instance`.
+   */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` whose response is rendered as RFC 9457 problem details
+ * (`application/problem+json`).
+ *
+ * @example
+ *
+ * throw problem({ status: 422, statusText: "Unprocessable Content", message: "Insufficient funds", type: "https://example.com/errors/funds" })
+ */
+export function problem(input: ProblemInput): HTTPError {
+  const error = new HTTPError(input);
+  Object.defineProperty(error, kProblem, {
+    value: { type: input.type, instance: input.instance } satisfies ProblemMembers,
+  });
+  return error;
+}
