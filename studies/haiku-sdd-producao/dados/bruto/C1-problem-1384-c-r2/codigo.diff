diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..1893019
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,207 @@
+import { HTTPError, problem } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemJSON = "application/problem+json";
+const errorJSON = "application/json;charset=UTF-8";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  it("returns an HTTPError with status and message", () => {
+    const error = problem({ status: 404, message: "Usuário não encontrado" });
+    expect(error).toBeInstanceOf(HTTPError);
+    expect(error.status).toBe(404);
+    expect(error.message).toBe("Usuário não encontrado");
+  });
+
+  it("renders type, instance and statusText as title in application/problem+json", async () => {
+    t.app.use(() => {
+      throw problem({
+        status: 422,
+        statusText: "Unprocessable Entity",
+        type: "https://example.com/errors/validation",
+        message: "Campo inválido",
+        instance: "/pedidos/7",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(422);
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+    expect(await res.json()).toMatchObject({
+      type: "https://example.com/errors/validation",
+      title: "Unprocessable Entity",
+      status: 422,
+      detail: "Campo inválido",
+      instance: "/pedidos/7",
+    });
+  });
+
+  it("defaults type to about:blank and omits title and instance when absent", async () => {
+    t.app.use(() => {
+      throw problem({ status: 409, message: "Conflito" });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(body).toMatchObject({ type: "about:blank", status: 409, detail: "Conflito" });
+    expect(body).not.toHaveProperty("title");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("spreads data to the top level of the body", async () => {
+    t.app.use(() => {
+      throw problem({ status: 409, message: "Conflito", data: { campo: "email" } });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({ campo: "email" });
+    expect(body).not.toHaveProperty("data");
+  });
+
+  it("spreads body to the top level of the body", async () => {
+    t.app.use(() => {
+      throw problem({ status: 400, message: "Ruim", body: { topLevel: 1 } });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({ topLevel: 1 });
+  });
+
+  it("keeps reserved members over members of data", async () => {
+    t.app.use(() => {
+      throw problem({ status: 409, message: "Conflito", data: { status: 1, detail: "x" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(409);
+    expect(await res.json()).toMatchObject({ status: 409, detail: "Conflito" });
+  });
+
+  it("keeps non-object data as a data member", async () => {
+    t.app.use(() => {
+      throw problem({ status: 400, message: "Ruim", data: "texto" });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({ data: "texto" });
+  });
+
+  it("hides detail, data and body of unhandled problems", async () => {
+    // Debug mode adds the stack trace, which carries the message like any HTTPError does.
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw problem({
+        status: 500,
+        unhandled: true,
+        message: "segredo",
+        data: { senha: "x" },
+        body: { token: "y" },
+      });
+    });
+    const res = await t.fetch("/");
+    const text = await res.text();
+    expect(res.status).toBe(500);
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+    expect(text).not.toContain("segredo");
+    expect(text).not.toContain("senha");
+    expect(text).not.toContain('"token"');
+    t.errors = [];
+  });
+
+  it("sends headers from the input with the problem content type", async () => {
+    t.app.use(() => {
+      throw problem({ status: 429, message: "Devagar", headers: { "Retry-After": "30" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(429);
+    expect(res.headers.get("retry-after")).toBe("30");
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+  });
+
+  it("does not let input headers replace the problem content type", async () => {
+    t.app.use(() => {
+      throw problem({ status: 400, message: "Ruim", headers: { "Content-Type": "text/plain" } });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+  });
+
+  it("throwing and returning a problem render the same body", async () => {
+    t.app.config.debug = false;
+    const input = { status: 400, message: "Ruim", type: "https://example.com/x", instance: "/a" };
+    t.app.get("/throw", () => {
+      throw problem(input);
+    });
+    t.app.get("/return", () => problem(input));
+    const thrown = await t.fetch("/throw");
+    const returned = await t.fetch("/return");
+    expect(returned.status).toBe(thrown.status);
+    expect(returned.headers.get("content-type")).toBe(problemJSON);
+    expect(await returned.json()).toEqual(await thrown.json());
+  });
+
+  it("HEAD returns the problem status with no body", async () => {
+    t.app.use(() => {
+      throw problem({ status: 503, message: "Fora do ar" });
+    });
+    const res = await t.fetch("/", { method: "HEAD" });
+    expect(res.status).toBe(503);
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+    expect(await res.text()).toBe("");
+  });
+
+  it("merges errHeaders into the problem response", async () => {
+    t.app.use((event) => {
+      event.res.errHeaders.set("x-error", "prepared");
+      throw problem({ status: 400, message: "Ruim" });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("x-error")).toBe("prepared");
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+  });
+
+  it("onError returning the problem error keeps the problem format", async () => {
+    t.app.config.onError = (error) => error;
+    t.app.use(() => {
+      throw problem({ status: 400, message: "Ruim" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-type")).toBe(problemJSON);
+  });
+
+  describe("regressions", () => {
+    it("new HTTPError keeps the current format", async () => {
+      t.app.use(() => {
+        throw new HTTPError({ status: 400, message: "Ruim" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(errorJSON);
+      const body = await res.json();
+      expect(body).toMatchObject({ status: 400, message: "Ruim" });
+      expect(body).not.toHaveProperty("detail");
+      expect(body).not.toHaveProperty("type");
+    });
+
+    it("a clone of a problem error keeps the current format", async () => {
+      const original = problem({ status: 400, message: "Ruim", type: "https://example.com/x" });
+      t.app.use(() => {
+        throw Object.assign(new HTTPError({ status: 400, message: "Ruim" }), { ...original });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(errorJSON);
+      expect(await res.json()).not.toHaveProperty("detail");
+    });
+
+    it("the problem marker is not enumerable, serialized or spread", () => {
+      const error = problem({ status: 400, message: "Ruim", type: "https://example.com/x" });
+      expect(Object.getOwnPropertySymbols({ ...error })).toEqual([]);
+      expect(JSON.stringify(error)).not.toContain("example.com/x");
+      expect(Object.keys(error)).not.toContain("type");
+    });
+
+    it("onError returning a new HTTPError renders the current format", async () => {
+      t.app.config.onError = () => new HTTPError({ status: 422, message: "Outro" });
+      t.app.use(() => {
+        throw problem({ status: 400, message: "Ruim" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(errorJSON);
+    });
+  });
+});
