+  it("ProblemInput accepts every ErrorInput field", () => {
+    const input: ProblemInput<{ campo: string }> = {
+      status: 400,
+      statusText: "Bad Request",
+      message: "Ruim",
+      data: { campo: "x" },
+      body: { topLevel: true },
+      headers: { "x-a": "1" },
+      cause: new Error("cause"),
+      unhandled: false,
+      type: "https://example.com/errors/x",
+      instance: "/x/1",
+    };
+    expectTypeOf(input).toExtend<ErrorInput<{ campo: string }>>();
+  });
+
+  it("returns an HTTPError", () => {
+    expectTypeOf(problem({ status: 404, message: "x" })).toEqualTypeOf<HTTPError>();
+  });
+
+  it("keeps the data type from its generic", () => {
+    expectTypeOf(problem<{ campo: string }>({ data: { campo: "x" }, status: 400 })).toEqualTypeOf<
