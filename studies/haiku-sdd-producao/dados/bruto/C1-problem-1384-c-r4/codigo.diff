+/**
+ * Body of an RFC 9457 problem response. Reserved members are set after `body`, so `body` cannot
+ * override them. An unhandled error keeps only its status, its title and the developer-set `type`
+ * and `instance`.
+ */
+function toProblemJSON(
+  error: HTTPError,
+  members: ProblemMembers,
+  debug?: boolean,
+): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  const status = unhandled ? 500 : error.status;
+  return {
+    ...(unhandled ? undefined : error.body),
+    type: members.type ?? "about:blank",
+    title: unhandled ? getReasonPhrase(500) : (error.statusText ?? getReasonPhrase(status)),
+    status,
+    detail: unhandled ? undefined : members.detail,
+    instance: members.instance,
+    stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
+  };
