+/**
+ * Reason phrases from the IANA HTTP Status Code Registry, for 4xx and 5xx only.
+ *
+ * Kept apart from `STATUS_TEXT` in `utils/response.ts`, which is limited on purpose to the
+ * statuses that `noContent` and `redirect` use.
+ */
+const REASON_PHRASES: Record<number, string> = {
+  400: "Bad Request",
+  401: "Unauthorized",
+  402: "Payment Required",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  407: "Proxy Authentication Required",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  411: "Length Required",
+  412: "Precondition Failed",
+  413: "Content Too Large",
+  414: "URI Too Long",
+  415: "Unsupported Media Type",
+  416: "Range Not Satisfiable",
+  417: "Expectation Failed",
+  421: "Misdirected Request",
+  422: "Unprocessable Content",
+  423: "Locked",
+  424: "Failed Dependency",
+  425: "Too Early",
+  426: "Upgrade Required",
+  428: "Precondition Required",
+  429: "Too Many Requests",
+  431: "Request Header Fields Too Large",
+  451: "Unavailable For Legal Reasons",
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+  505: "HTTP Version Not Supported",
+  506: "Variant Also Negotiates",
+  507: "Insufficient Storage",
+  508: "Loop Detected",
+  510: "Not Extended",
+  511: "Network Authentication Required",
+};
+
+/**
+ * Get the standard reason phrase of a 4xx or 5xx status. Returns `undefined` for any other status.
+ */
+export function getReasonPhrase(status: number): string | undefined {
+  return REASON_PHRASES[status];
+}
diff --git a/test/problem.test.ts b/test/problem.test.ts
new file mode 100644
index 0000000..03629bd
--- /dev/null
+++ b/test/problem.test.ts
@@ -0,0 +1,258 @@
+import { beforeEach } from "vitest";
+import { HTTPError, problem, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemType = "application/problem+json";
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  // The test app runs in debug mode, which adds `stack` and indents JSON. Bodies are compared
+  // exactly here, so debug is off unless a test turns it on.
+  beforeEach(() => {
+    t.app.config.debug = false;
+  });
+
+  describe("existing errors keep the JSON format", () => {
+    it("new HTTPError renders the current body", async () => {
+      t.app.use(() => {
+        throw new HTTPError({ status: 404, message: "Nada aqui" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.text()).toBe('{"status":404,"message":"Nada aqui"}');
+    });
+
+    it("HTTPError.status renders the current body", async () => {
+      t.app.use(() => {
+        throw HTTPError.status(403, "Forbidden", { message: "Negado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.text()).toBe('{"status":403,"statusText":"Forbidden","message":"Negado"}');
+    });
+
+    it("unhandled Error hides its message and stays JSON", async () => {
+      t.app.use(() => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.text();
+      expect(body).not.toContain("segredo do banco");
+      expect(body).not.toContain("stack");
+      expect(JSON.parse(body)).toMatchObject({ status: 500, unhandled: true });
+      t.errors = [];
+    });
+  });
+
+  describe("problem()", () => {
+    it("returns an HTTPError with the given status", () => {
+      const error = problem({ status: 404, message: "Não encontrado" });
+      expect(error).toBeInstanceOf(HTTPError);
+      expect(error.status).toBe(404);
+      expect(HTTPError.isError(error)).toBe(true);
+    });
+
+    for (const mode of ["throw", "return"] as const) {
+      it(`renders the problem format when ${mode === "throw" ? "thrown" : "returned"}`, async () => {
+        t.app.use(() => {
+          const error = problem({ status: 404, message: "Não encontrado" });
+          if (mode === "throw") {
+            throw error;
+          }
+          return error;
+        });
+        const res = await t.fetch("/");
+        expect(res.status).toBe(404);
+        expect(res.headers.get("content-type")).toBe(problemType);
+        expect(await res.json()).toEqual({
+          type: "about:blank",
+          title: "Not Found",
+          status: 404,
+          detail: "Não encontrado",
+        });
+      });
+    }
+
+    it("renders type, title, status, detail and instance", async () => {
+      t.app.use(() => {
+        throw problem({
+          status: 403,
+          message: "Saldo insuficiente",
+          type: "https://exemplo.com/erros/saldo",
+          instance: "/contas/42",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe(problemType);
+      expect(await res.json()).toEqual({
+        type: "https://exemplo.com/erros/saldo",
+        title: "Forbidden",
+        status: 403,
+        detail: "Saldo insuficiente",
+        instance: "/contas/42",
+      });
+    });
+
+    it("defaults type to about:blank and omits instance and detail", async () => {
+      t.app.use(() => {
+        throw problem({ status: 409 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      const body = await res.json();
+      expect(body).toEqual({ type: "about:blank", title: "Conflict", status: 409 });
+      expect(body).not.toHaveProperty("instance");
+      expect(body).not.toHaveProperty("detail");
+    });
+
+    it("uses statusText as title when given", async () => {
+      t.app.use(() => {
+        throw problem({ status: 409, statusText: "Stale Version" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ title: "Stale Version", status: 409 });
+    });
+
+    it("omits title when the status has no standard phrase", async () => {
+      t.app.use(() => {
+        throw problem({ status: 499, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(499);
+      const body = await res.json();
+      expect(body).not.toHaveProperty("title");
+      expect(body).toMatchObject({ type: "about:blank", status: 499, detail: "x" });
+    });
+
+    it("sanitizes an invalid status to 500", async () => {
+      t.app.use(() => {
+        throw problem({ status: 42, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(problemType);
+      expect(await res.json()).toMatchObject({ status: 500 });
+      t.errors = [];
+    });
+
+    it("keeps body extensions and ignores reserved members in body", async () => {
+      t.app.use(() => {
+        throw problem({
+          status: 422,
+          message: "Inválido",
+          body: {
+            campos: ["email"],
+            status: 999,
+            type: "https://exemplo.com/forjado",
+            title: "Forjado",
+            detail: "Forjado",
+            instance: "/forjado",
+          },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Unprocessable Content",
+        status: 422,
+        detail: "Inválido",
+        campos: ["email"],
+      });
+    });
+
+    it("hides detail and body when unhandled, with status 500", async () => {
+      t.app.use(() => {
+        throw problem({ status: 503, message: "segredo", unhandled: true, body: { x: 1 } });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(problemType);
+      const text = await res.text();
+      expect(text).not.toContain("segredo");
+      const body = JSON.parse(text);
+      expect(body).toEqual({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+      });
+      expect(body).not.toHaveProperty("x");
+      expect(body).not.toHaveProperty("detail");
+      t.errors = [];
+    });
+
+    it("keeps the stack trace only in debug mode when unhandled", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw problem({ status: 503, message: "segredo", unhandled: true });
+      });
+      const hidden = await t.fetch("/");
+      expect(await hidden.json()).not.toHaveProperty("stack");
+
+      t.app.config.debug = true;
+      const shown = await t.fetch("/");
+      expect(await shown.json()).toHaveProperty("stack");
+      t.errors = [];
+    });
+
+    it("sends headers from the error with the problem content type", async () => {
+      t.app.use(() => {
+        throw problem({
+          status: 401,
+          message: "Token expirado",
+          headers: { "WWW-Authenticate": "Bearer" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(401);
+      expect(res.headers.get("www-authenticate")).toBe("Bearer");
+      expect(res.headers.get("content-type")).toBe(problemType);
+    });
+
+    it("does not let error headers override the problem content type", async () => {
+      t.app.use(() => {
+        throw problem({
+          status: 401,
+          message: "Token expirado",
+          headers: { "content-type": "text/plain" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(problemType);
+      expect(await res.json()).toMatchObject({ status: 401 });
+    });
+
+    it("merges event.res.errHeaders into a problem response", async () => {
+      t.app.use((event: H3Event) => {
+        event.res.errHeaders.set("x-error", "prepared");
+        throw problem({ status: 401, message: "Token expirado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("x-error")).toBe("prepared");
+      expect(res.headers.get("content-type")).toBe(problemType);
+    });
+
+    it("passes the problem error to onError and calls onResponse once", async () => {
+      t.app.use(() => {
+        throw problem({ status: 400, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(problemType);
+      expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+      const error = t.hooks.onError.mock.calls[0][0];
+      expect(error.status).toBe(400);
+      expect(error.message).toBe("x");
+      expect(t.hooks.onResponse).toHaveBeenCalledTimes(1);
+    });
+
+    it("keeps the cause free of type and instance", () => {
+      const error = problem({ status: 400, message: "x", type: "t", instance: "/i" });
+      expect(error.cause).toEqual({ status: 400, message: "x" });
+    });
+  });
+});
