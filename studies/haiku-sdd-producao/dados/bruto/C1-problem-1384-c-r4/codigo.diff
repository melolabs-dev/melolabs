+/**
+ * Problem members kept on an error created by `problem`. Internal: not exported from `h3`.
+ */
+export interface ProblemMembers {
+  detail?: string;
+  type?: string;
+  instance?: string;
+}
+
+/**
+ * Marks an error created by `problem`, so it renders as `application/problem+json`.
+ *
+ * It is a registry symbol, not a property name: JSON cannot carry it, so a request body cannot
+ * forge the marker, and it stays out of enumeration and spreads.
+ */
+export const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+/**
+ * Input of {@link problem}: the {@link ErrorInput} fields plus the RFC 9457 members `type` and
+ * `instance`.
+ */
+export interface ProblemInput extends ErrorInput {
+  /**
+   * URI that identifies the problem type. Defaults to `"about:blank"` in the response.
+   */
+  type?: string;
+
+  /**
+   * URI reference that identifies this occurrence of the problem. Omitted from the response when absent.
+   */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is sent as an RFC 9457 problem details response
+ * (`application/problem+json`). Use it with `throw problem(...)` or `return problem(...)`.
+ *
+ * @example
+ *
+ * throw problem({ status: 403, message: "Insufficient funds", type: "https://example.com/errors/funds", instance: "/accounts/42" })
+ */
+export function problem(input: ProblemInput): HTTPError {
+  const { type, instance, ...details } = input;
+  const error = new HTTPError(details);
+  Object.defineProperty(error, kProblem, {
+    value: { detail: input.message, type, instance } satisfies ProblemMembers,
+  });
+  return error;
+}
