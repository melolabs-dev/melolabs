new file mode 100644
index 0000000..8485cfa
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,31 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { setProblem } from "./internal/problem-body.ts";
+
+/**
+ * Input of {@link problem}: the `ErrorInput` fields plus the optional RFC 9457 members.
+ */
+export interface ProblemInput extends ErrorInput {
+  /**
+   * URI that identifies the problem type (RFC 9457, 3.1.1). Defaults to `"about:blank"`.
+   */
+  type?: string;
+
+  /**
+   * URI that identifies this occurrence of the problem (RFC 9457, 3.1.5).
+   */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is sent as `application/problem+json` (RFC 9457).
+ *
+ * @example
+ *
+ * throw problem({ status: 404, message: "User not found", instance: "/users/7" });
+ */
+export function problem(input: ProblemInput): HTTPError {
+  const { type, instance, ...details } = input;
+  const error = new HTTPError(details);
+  setProblem(error, { type, instance });
+  return error;
+}
