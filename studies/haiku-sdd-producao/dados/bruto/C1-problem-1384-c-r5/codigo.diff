+      t.app.use(() => {
+        throw new HTTPError({
+          cause: problem({ status: 418, message: "inner" }),
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(res.headers.get("content-type")).not.toBe(PROBLEM_JSON);
+      const body = await res.json();
+      expect(body).not.toHaveProperty("type");
+      expect(body.message).toBe("inner");
+    });
+  });
+});
