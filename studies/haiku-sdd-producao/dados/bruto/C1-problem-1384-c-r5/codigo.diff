+import { vi } from "vitest";
+import { HTTPError, problem, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_JSON = "application/problem+json";
+
+describeMatrix("problem", (t, { it, expect, describe }) => {
+  // Unhandled errors are logged by `prepareResponse`; keep them out of the test output
+  globalThis.console.error = vi.fn();
+
+  describe("problem()", () => {
+    it("returns an HTTPError with the given status and message", () => {
+      const error = problem({ status: 404, message: "Usuário não encontrado" });
+      expect(error).toBeInstanceOf(HTTPError);
+      expect(HTTPError.isError(error)).toBe(true);
+      expect(error.status).toBe(404);
+      expect(error.message).toBe("Usuário não encontrado");
+    });
+
+    it("keeps type and instance out of the HTTPError fields", () => {
+      const error = problem({
+        status: 422,
+        message: "Dados inválidos",
+        type: "https://exemplo.com/erros/validacao",
+        instance: "/pedidos/12",
+      });
+      expect(error).not.toHaveProperty("type");
+      expect(error).not.toHaveProperty("instance");
+      expect(Object.keys(error)).not.toContain("type");
+      expect(Object.keys(error)).not.toContain("instance");
+    });
+  });
+
+  describe("application/problem+json responses", () => {
+    it("renders type, title, status, detail and instance", async () => {
+      t.app.use(() => {
+        throw problem({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário não encontrado",
+          instance: "/usuarios/7",
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não encontrado",
+        instance: "/usuarios/7",
+        stack: expect.any(Array), // the test app runs in debug mode
+      });
+    });
+
+    it("uses the IANA phrase as title when statusText is missing", async () => {
+      t.app.use(() => {
+        throw problem({ status: 404, message: "Not here" });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body.title).toBe("Not Found");
+    });
+
+    it("uses the IANA phrase for a status with a newer name", async () => {
+      t.app.use(() => {
+        throw problem({ status: 422, message: "Dados inválidos" });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body.title).toBe("Unprocessable Content");
+    });
+
+    it("uses HTTPError as title when the status has no registered phrase", async () => {
+      t.app.use(() => {
+        throw problem({ status: 599, message: "Custom" });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(599);
+      expect((await res.json()).title).toBe("HTTPError");
+    });
+
+    it("uses about:blank as type when type is missing", async () => {
+      t.app.use(() => {
+        throw problem({ status: 400, message: "Bad" });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("about:blank");
+    });
+
+    it("uses the given type", async () => {
+      t.app.use(() => {
+        throw problem({
+          status: 422,
+          message: "Dados inválidos",
+          type: "https://exemplo.com/erros/validacao",
+        });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("https://exemplo.com/erros/validacao");
+    });
+
+    it("omits instance when it is not given", async () => {
+      t.app.use(() => {
+        throw problem({ status: 400, message: "Bad" });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).not.toHaveProperty("instance");
