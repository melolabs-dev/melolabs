diff --git a/test/unit/problem-body.test.ts b/test/unit/problem-body.test.ts
new file mode 100644
index 0000000..a01b5f0
--- /dev/null
+++ b/test/unit/problem-body.test.ts
@@ -0,0 +1,116 @@
+import { describe, expect, it } from "vitest";
+import { HTTPError, problem } from "../../src/index.ts";
+import { defaultStatusText } from "../../src/utils/internal/status-text.ts";
+import {
+  PROBLEM_CONTENT_TYPE,
+  getProblem,
+  toProblemBody,
+} from "../../src/utils/internal/problem-body.ts";
+
+describe("defaultStatusText", () => {
+  it("returns IANA phrases", () => {
+    expect(defaultStatusText(404)).toBe("Not Found");
+    expect(defaultStatusText(422)).toBe("Unprocessable Content");
+    expect(defaultStatusText(413)).toBe("Content Too Large");
+  });
+
+  it("returns undefined for codes without a registered phrase", () => {
+    expect(defaultStatusText(299)).toBeUndefined();
+    expect(defaultStatusText(599)).toBeUndefined();
+  });
+});
+
+describe("problem marker", () => {
+  it("uses the problem media type", () => {
+    expect(PROBLEM_CONTENT_TYPE).toBe("application/problem+json");
+  });
+
+  it("is read from the error itself", () => {
+    const error = problem({ status: 404, message: "x", type: "https://a.example/t" });
+    expect(getProblem(error)).toEqual({ type: "https://a.example/t", instance: undefined });
+  });
+
+  it("is not inherited through cause", () => {
+    const error = new HTTPError({ cause: problem({ status: 404, message: "x" }) });
+    expect(getProblem(error)).toBeUndefined();
+  });
+
+  it("is not an enumerable key", () => {
+    const error = problem({ status: 404, message: "x" });
+    expect(Object.keys(error)).not.toContain("h3.problem");
+    expect(JSON.stringify(error)).not.toContain("h3.problem");
+  });
+
+  it("is not set on plain HTTPError", () => {
+    expect(getProblem(new HTTPError({ status: 404, message: "x" }))).toBeUndefined();
+  });
+});
+
+describe("toProblemBody", () => {
+  it("builds the reserved members from the error", () => {
+    const error = problem({ status: 404, statusText: "Gone?", message: "Nope" });
+    expect(toProblemBody(error, {})).toEqual({
+      type: "about:blank",
+      title: "Gone?",
+      status: 404,
+      detail: "Nope",
+    });
+  });
+
+  it("falls back to the IANA phrase for title", () => {
+    const error = problem({ status: 404, message: "Nope" });
+    expect(toProblemBody(error, {}).title).toBe("Not Found");
+  });
+
+  it("uses HTTPError as title without a registered phrase", () => {
+    const error = problem({ status: 599, message: "Nope" });
+    expect(toProblemBody(error, {}).title).toBe("HTTPError");
+  });
+
+  it("lets reserved members win over extensions", () => {
+    const error = problem({
+      status: 409,
+      message: "Conflito",
+      data: { campo: "email" },
+      body: { codigo: "X1", status: 200 },
+    });
+    const body = toProblemBody(error, { instance: "/x" });
+    expect(body).toEqual({
+      codigo: "X1",
+      data: { campo: "email" },
+      type: "about:blank",
+      title: "Conflict",
+      status: 409,
+      detail: "Conflito",
+      instance: "/x",
+    });
+  });
+
+  it("drops a body instance when no instance is informed", () => {
+    const error = problem({ status: 400, message: "Bad", body: { instance: "/injetado" } });
+    expect(JSON.parse(JSON.stringify(toProblemBody(error, {})))).not.toHaveProperty("instance");
+  });
+
+  it("hides data, body and instance when unhandled", () => {
+    const error = problem({
+      status: 500,
+      message: "segredo",
+      data: { a: 1 },
+      body: { codigo: "X1" },
+      unhandled: true,
+    });
+    const body = toProblemBody(error, { instance: "/interno" });
+    expect(body).toEqual({
+      type: "about:blank",
+      title: "Internal Server Error",
+      status: 500,
+      detail: "HTTPError",
+    });
+  });
+
+  it("adds stack only in debug mode", () => {
+    const error = problem({ status: 400, message: "Bad" });
+    expect(toProblemBody(error, {}, false).stack).toBeUndefined();
+    expect(Array.isArray(toProblemBody(error, {}, true).stack)).toBe(true);
+  });
+});
