diff --git a/src/utils/internal/problem-body.ts b/src/utils/internal/problem-body.ts
new file mode 100644
index 0000000..900765a
--- /dev/null
+++ b/src/utils/internal/problem-body.ts
@@ -0,0 +1,55 @@
+import type { HTTPError } from "../../error.ts";
+import { defaultStatusText } from "./status-text.ts";
+
+export const PROBLEM_CONTENT_TYPE: string = "application/problem+json";
+
+// Symbol.for, like `kHTTPResponse` in `src/response.ts`: it matches across duplicate copies of h3,
+// and it cannot come from JSON input, so a request body cannot forge the marker.
+export const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+export interface ProblemMeta {
+  type?: string;
+  instance?: string;
+}
+
+/**
+ * Mark an error to be rendered as `application/problem+json`.
+ *
+ * Defined as non-enumerable so the marker stays out of `Object.keys` and JSON serialization.
+ */
+export function setProblem(error: HTTPError, meta: ProblemMeta): void {
+  Object.defineProperty(error, kProblem, { value: meta, enumerable: false });
+}
+
+/**
+ * Read the marker from the error itself only. It is never inherited through `cause`, so wrapping a
+ * problem in a plain `HTTPError` does not change the response format.
+ */
+export function getProblem(error: HTTPError): ProblemMeta | undefined {
+  return (error as { [kProblem]?: ProblemMeta })[kProblem];
+}
+
+/**
+ * Build the RFC 9457 body. Extension members come first and reserved members last, so `body` or
+ * `data` can never overwrite `type`, `title`, `status`, `detail` or `instance`.
+ */
+export function toProblemBody(
+  error: HTTPError,
+  meta: ProblemMeta,
+  debug?: boolean,
+): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  const extensions: Record<string, unknown> = unhandled
+    ? {}
+    : { ...error.body, ...(error.data === undefined ? undefined : { data: error.data }) };
+  return {
+    ...extensions,
+    type: meta.type ?? "about:blank",
+    title: error.statusText ?? defaultStatusText(error.status) ?? "HTTPError",
+    status: error.status,
+    detail: unhandled ? "HTTPError" : error.message,
+    // `undefined` is dropped by JSON.stringify, which also removes a `body.instance` extension.
+    instance: unhandled ? undefined : meta.instance,
+    stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
+  };
+}
