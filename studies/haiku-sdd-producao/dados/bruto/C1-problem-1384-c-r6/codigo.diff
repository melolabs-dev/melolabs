@@ -0,0 +1,22 @@
+import { describe, it, expectTypeOf } from "vitest";
+import { problem, HTTPError, type ProblemInput } from "../../src/index.ts";
+
+describe("problem types", () => {
+  it("returns HTTPError", () => {
+    expectTypeOf(problem({ status: 404, message: "x" })).toEqualTypeOf<HTTPError>();
+  });
+
+  it("accepts type and instance as strings", () => {
+    expectTypeOf<ProblemInput["type"]>().toEqualTypeOf<string | undefined>();
+    expectTypeOf<ProblemInput["instance"]>().toEqualTypeOf<string | undefined>();
+  });
+
+  it("does not require type and instance", () => {
+    problem({ status: 409, message: "Conflito" });
+  });
+
+  it("rejects unknown fields", () => {
+    // @ts-expect-error unknown field
+    problem({ status: 404, message: "x", campoInexistente: 1 });
+  });
+});
