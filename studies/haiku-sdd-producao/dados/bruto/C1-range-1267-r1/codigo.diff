+
+/** Inclusive byte range, already clamped to `[0, size - 1]`. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/**
+ * Resolve the request `Range`.
+ * - `ByteRange`: respond 206.
+ * - `"unsatisfiable"`: respond 416.
+ * - `undefined`: ignore `Range` and respond 200 with the full asset.
+ */
+function resolveRange(
+  event: H3Event,
+  size: number,
+  etag: string | undefined,
+): ByteRange | "unsatisfiable" | undefined {
+  const header = event.req.headers.get("range");
+  // A precompressed body cannot be sliced meaningfully on its own (RFC 9110 lets
+  // the server ignore `Range`), so the response's own `content-encoding` decides.
+  if (!header || event.res.headers.has("content-encoding")) {
+    return undefined;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(event, ifRange, etag)) {
+    return undefined;
+  }
+  return parseByteRange(header, size);
+}
+
+const BYTE_RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/** Parse a single `bytes` range (RFC 9110 sections 14.1.1 and 14.2) for an asset of `size` bytes. */
+function parseByteRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = BYTE_RANGE_RE.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  if (first === "") {
+    // Suffix: the last `n` bytes, or the whole asset when `n` is larger.
+    const n = Number(last);
+    return n === 0 ? "unsatisfiable" : { start: Math.max(size - n, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last === "" ? size - 1 : Number(last);
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/** Evaluate `If-Range` against the strong ETag and the `last-modified` the response carries. */
+function matchesIfRange(event: H3Event, ifRange: string, etag: string | undefined): boolean {
+  if (ifRange.startsWith('"') || ifRange.startsWith('W/"')) {
+    return !ifRange.startsWith("W/") && ifRange === etag;
+  }
+  return ifRange === event.res.headers.get("last-modified");
+}
+
+/** Slice a `BodyInit` to the byte range. */
+async function sliceBody(
+  body: BodyInit | null | undefined,
+  range: ByteRange,
+): Promise<BodyInit | null> {
+  if (body === null || body === undefined) {
+    return null;
+  }
+  const end = range.end + 1;
+  if (typeof body === "string") {
+    return textEncoder.encode(body).subarray(range.start, end);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(range.start, end);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(range.start, end);
+  }
+  if (body instanceof Blob) {
+    return body.slice(range.start, end);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, range);
+  }
+  return (await new Response(body).blob()).slice(range.start, end);
+}
+
+/** Slice a `ReadableStream` without buffering it whole: skip bytes before `start`, emit up to `end`, cancel the rest. */
+function sliceStream(stream: ReadableStream<any>, range: ByteRange): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let offset = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunk: Uint8Array = typeof value === "string" ? textEncoder.encode(value) : value;
+        const from = Math.max(range.start - offset, 0);
+        const to = Math.min(range.end + 1 - offset, chunk.byteLength);
+        offset += chunk.byteLength;
+        if (to > from) {
+          controller.enqueue(chunk.subarray(from, to));
+        }
+        if (offset > range.end) {
+          await reader.cancel();
+          controller.close();
+          return;
+        }
+        if (to > from) {
+          return;
+        }
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
