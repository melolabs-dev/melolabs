+/** Inclusive byte range, 0-based on both ends. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/** What to do with `Range` for a response that would otherwise be 200. */
+type RangeDecision =
+  | { type: "full" }
+  | { type: "partial"; range: ByteRange }
+  | { type: "unsatisfiable" };
+
+/** Validators the response is going to send (values of `event.res.headers`). */
+interface RangeValidators {
+  etag?: string | null;
+  lastModified?: string | null;
+}
+
+/**
+ * Decide how `Range` applies to an asset of `size` bytes (RFC 9110 section 13.1.5 and 14).
+ * Malformed or multi-range headers, unknown sizes and failed `If-Range` checks all
+ * fall back to the complete response.
+ */
+function resolveRange(
+  reqHeaders: Headers,
+  size: number | undefined,
+  validators: RangeValidators,
+): RangeDecision {
+  const value = reqHeaders.get("range");
+  if (!value || size === undefined) {
+    return { type: "full" };
+  }
+  const ifRange = reqHeaders.get("if-range");
+  if (ifRange && !ifRangeMatches(ifRange, validators)) {
+    return { type: "full" };
+  }
+  const range = parseRange(value, size);
+  if (range === undefined) {
+    return { type: "full" };
+  }
