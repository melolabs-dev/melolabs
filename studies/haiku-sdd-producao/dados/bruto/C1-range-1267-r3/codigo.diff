+ * clamped range otherwise. Only the single `bytes` range form is accepted.
+ */
+function parseRange(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = /^\s*bytes\s*=\s*(.+)$/i.exec(value);
+  if (!match || match[1]!.includes(",")) {
+    return undefined;
+  }
+  const spec = /^(\d*)-(\d*)$/.exec(match[1]!.trim());
+  if (!spec) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = spec;
+  if (!first && !last) {
+    return undefined;
+  }
+  if (first && last && Number(last) < Number(first)) {
+    return undefined;
+  }
+  if (size === 0) {
+    return "unsatisfiable";
+  }
+  if (!first) {
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last ? Math.min(Number(last), size - 1) : size - 1;
+  return { start, end };
