+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const content = "0123456789";
+const etag = '"v1"';
+const mtime = 1_700_000_000_000;
+const lastModified = new Date(mtime).toUTCString();
+
+function asset(overrides: Partial<ServeStaticOptions> = {}): ServeStaticOptions {
+  return {
+    getMeta: () => ({ type: "text/plain", etag, mtime, size: content.length }),
+    getContents: () => content,
+    ...overrides,
+  };
+}
+
+function chunkedStream(chunks: string[]): ReadableStream<Uint8Array> {
+  const encoder = new TextEncoder();
+  return new ReadableStream({
+    start(controller) {
+      for (const chunk of chunks) {
+        controller.enqueue(encoder.encode(chunk));
+      }
+      controller.close();
+    },
+  });
+}
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  beforeEach(() => {
+    t.app.all("/range/**", (event) => serveStatic(event, asset()));
+  });
+
+  const rangeGet = (range: string) => t.fetch("/range/file.txt", { headers: { range } });
+
+  // RF-01
+  it("advertises byte ranges on a plain GET", async () => {
+    const res = await t.fetch("/range/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(content);
+  });
+
+  // RF-08
+  it("keeps 304 ahead of Range for a matching If-None-Match", async () => {
+    const res = await t.fetch("/range/file.txt", {
+      headers: { "if-none-match": etag, range: "bytes=0-3" },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-11
+  it("returns 404 for a missing asset with Range", async () => {
+    t.app.all("/missing/**", (event) => serveStatic(event, asset({ getMeta: () => undefined })));
+    const res = await t.fetch("/missing/file.txt", { headers: { range: "bytes=0-3" } });
+    expect(res.status).toBe(404);
+  });
+
+  // RF-11
+  it("falls through for a missing asset with Range when fallthrough is set", async () => {
+    t.app.use("/fall/**", (event) =>
+      serveStatic(event, asset({ getMeta: () => undefined, fallthrough: true })),
+    );
+    t.app.all("/**", () => ({ fallthroughTest: "passing" }));
+    const res = await t.fetch("/fall/file.txt", { headers: { range: "bytes=0-3" } });
+    expect(await res.json()).toEqual({ fallthroughTest: "passing" });
+  });
+
+  // RF-11
+  it("returns 405 with Allow for POST with Range", async () => {
+    const res = await t.fetch("/range/file.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-3" },
+    });
+    expect(res.status).toBe(405);
+    expect(res.headers.get("allow")).toBe("GET, HEAD");
+  });
+
+  // RF-02
+  it("serves a bounded range as 206", async () => {
+    const res = await rangeGet("bytes=2-5");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("2345");
+  });
+
+  // RF-02
+  it("clamps an end past the last byte", async () => {
+    const open = await rangeGet("bytes=7-");
+    expect(open.status).toBe(206);
+    expect(open.headers.get("content-range")).toBe("bytes 7-9/10");
+    expect(await open.text()).toBe("789");
+
+    const past = await rangeGet("bytes=0-99");
+    expect(past.status).toBe(206);
+    expect(past.headers.get("content-range")).toBe("bytes 0-9/10");
+    expect(await past.text()).toBe(content);
+  });
+
+  // RF-03
+  it("answers HEAD with a 206 and no body", async () => {
+    const res = await t.fetch("/range/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=0-3" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-3/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-04
+  it("ignores malformed, multi-range and other-unit Range headers", async () => {
+    for (const range of ["bytes=0-1,4-5", "items=0-1", "bytes=5-2", "bytes=abc", "bytes=-"]) {
+      const res = await rangeGet(range);
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(res.headers.get("accept-ranges"), range).toBe("bytes");
+      expect(await res.text(), range).toBe(content);
+    }
+  });
+
+  // RF-05
+  it("answers 416 for unsatisfiable ranges without reading the asset", async () => {
+    const getContents = vi.fn(() => content);
+    t.app.all("/range416/**", (event) => serveStatic(event, asset({ getContents })));
+
+    for (const range of ["bytes=10-20", "bytes=-0"]) {
+      const res = await t.fetch("/range416/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(416);
+      expect(res.headers.get("content-range"), range).toBe("bytes */10");
+      expect(res.headers.get("content-length"), range).toBe("0");
+      expect(await res.text(), range).toBe("");
+    }
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  // RF-06
+  it("serves suffix ranges, clamped to the asset size", async () => {
+    const suffix = await rangeGet("bytes=-3");
+    expect(suffix.status).toBe(206);
+    expect(suffix.headers.get("content-range")).toBe("bytes 7-9/10");
+    expect(await suffix.text()).toBe("789");
+
+    const oversized = await rangeGet("bytes=-50");
+    expect(oversized.status).toBe(206);
+    expect(oversized.headers.get("content-range")).toBe("bytes 0-9/10");
+    expect(await oversized.text()).toBe(content);
+  });
+
+  // RF-07
+  it("applies the range only when a strong If-Range matches the ETag", async () => {
+    const stale = await t.fetch("/range/file.txt", {
+      headers: { range: "bytes=0-3", "if-range": '"v2"' },
+    });
+    expect(stale.status).toBe(200);
+    expect(stale.headers.get("content-range")).toBeNull();
+    expect(await stale.text()).toBe(content);
+
+    const current = await t.fetch("/range/file.txt", {
+      headers: { range: "bytes=0-3", "if-range": '"v1"' },
+    });
+    expect(current.status).toBe(206);
+    expect(current.headers.get("content-range")).toBe("bytes 0-3/10");
+    expect(await current.text()).toBe("0123");
+  });
+
+  // RF-07
+  it("compares If-Range dates to the Last-Modified value exactly", async () => {
+    const equal = await t.fetch("/range/file.txt", {
+      headers: { range: "bytes=0-3", "if-range": lastModified },
+    });
+    expect(equal.status).toBe(206);
+
+    const different = await t.fetch("/range/file.txt", {
+      headers: {
+        range: "bytes=0-3",
+        "if-range": new Date(mtime - 1000).toUTCString(),
+      },
+    });
+    expect(different.status).toBe(200);
+    expect(different.headers.get("content-range")).toBeNull();
+  });
+
+  // RF-07: the date is compared in whole seconds, like Last-Modified.
+  it("compares If-Range dates with sub-second mtimes in whole seconds", async () => {
+    t.app.all("/subsec/**", (event) =>
+      serveStatic(event, asset({ getMeta: () => ({ size: 10, mtime: mtime + 500 }) })),
+    );
+    const res = await t.fetch("/subsec/file.txt", {
+      headers: { range: "bytes=0-3", "if-range": lastModified },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-3/10");
+  });
+
+  // RF-07: a weak ETag never matches If-Range.
+  it("never matches a weak ETag in If-Range", async () => {
+    t.app.all("/weak/**", (event) =>
+      serveStatic(event, asset({ getMeta: () => ({ size: 10, etag: 'W/"v1"' }) })),
+    );
+    const res = await t.fetch("/weak/file.txt", {
+      headers: { range: "bytes=0-3", "if-range": 'W/"v1"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  // RF-09
+  it("ignores Range when getMeta has no size", async () => {
+    t.app.all("/nosize/**", (event) =>
+      serveStatic(event, asset({ getMeta: () => ({ type: "text/plain" }) })),
+    );
+    const res = await t.fetch("/nosize/file.txt", { headers: { range: "bytes=0-3" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(content);
+  });
+
+  // RF-09
+  it("ignores Range when getMeta reports a size of 0", async () => {
+    t.app.all("/zerosize/**", (event) =>
+      serveStatic(event, asset({ getMeta: () => ({ size: 0 }) })),
+    );
+    const res = await t.fetch("/zerosize/file.txt", { headers: { range: "bytes=0-3" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(content);
+  });
+
+  // RF-10: a pre-compressed variant whose meta declares its encoding.
+  it("ignores Range on an encoded representation", async () => {
+    t.app.all("/encoded/**", (event) =>
+      serveStatic(
+        event,
+        asset({
+          encodings: { gzip: ".gz" },
+          getMeta: (id) =>
+            id === "/encoded/file.txt.gz" ? { size: 10, encoding: "gzip" } : undefined,
+        }),
+      ),
+    );
+    const res = await t.fetch("/encoded/file.txt", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-3" },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBeNull();
+    await res.body?.cancel();
+  });
+
+  // D-05: a pre-compressed variant served without a Content-Encoding header.
+  it("ignores Range on a variant without a declared encoding", async () => {
+    t.app.all("/variant/**", (event) =>
+      serveStatic(
+        event,
+        asset({
