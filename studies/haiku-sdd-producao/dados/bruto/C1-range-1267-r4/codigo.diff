+
+type ByteRange = { start: number; end: number };
+
+// A single `bytes` range-spec (RFC 9110 section 14.1.1). Anything else is ignored.
+const BYTE_RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Interpret a `Range` header for an asset of `size` bytes (`size > 0`).
+ *
+ * - `undefined`: ignore the header and serve the full representation.
+ * - `{ unsatisfiable: true }`: respond 416.
+ * - `ByteRange`: respond 206 with the inclusive, clamped range.
+ */
+function parseByteRange(
+  header: string,
+  size: number,
+): ByteRange | { unsatisfiable: true } | undefined {
+  const match = BYTE_RANGE_RE.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, rawStart, rawEnd] = match;
+  if (!rawStart && !rawEnd) {
+    return undefined;
+  }
+  if (!rawStart) {
+    // Suffix range: the last `length` bytes.
+    const length = Number(rawEnd);
+    if (length === 0) {
+      return { unsatisfiable: true };
+    }
+    return { start: Math.max(0, size - length), end: size - 1 };
+  }
+  const start = Number(rawStart);
+  const end = rawEnd ? Number(rawEnd) : Number.POSITIVE_INFINITY;
+  if (start > end) {
+    return undefined;
+  }
+  if (start >= size) {
+    return { unsatisfiable: true };
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * Whether a `Range` may be applied to this response: the served variant must be
+ * the requested asset itself, not encoded, and `If-Range` (when present) must
+ * still match the current validators (RFC 9110 section 13.1.5).
+ */
+function isRangeApplicable(
+  event: H3Event,
+  asset: { id: string; assetId: string; etag?: string; lastModified?: Date },
+): boolean {
+  if (asset.id !== asset.assetId || event.res.headers.has("content-encoding")) {
+    return false;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  return !ifRange || isIfRangeMatch(ifRange, asset);
+}
+
+/**
+ * Evaluate `If-Range`: a strong ETag must be identical to the current one, and an
+ * HTTP-date must equal `Last-Modified` exactly. Anything else does not match.
+ */
+function isIfRangeMatch(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange.startsWith('"')) {
+    // A weak tag starts with `W/`, so it can never equal a quoted value here.
+    return validators.etag === ifRange;
+  }
+  return (
+    !!validators.lastModified && new Date(ifRange).getTime() === validators.lastModified.getTime()
+  );
+}
+
+/** Cut `contents` down to `range` without buffering a stream's whole body. */
+async function sliceContents(contents: NonNullable<BodyInit>, range: ByteRange): Promise<BodyInit> {
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, range);
+  }
+  // `Response` gives every `BodyInit` one byte-oriented form, and `Blob.slice` does not copy.
+  const blob = await new Response(contents).blob();
+  return blob.slice(range.start, range.end + 1);
+}
+
+/**
+ * Drop the bytes before `range.start` and stop reading once `range.end` is passed.
+ * Terminating the transform cancels the source, so the rest of it is never read.
+ *
+ * The prefix before `range.start` is still read from the source.
+ */
+function sliceStream(
+  body: ReadableStream<Uint8Array>,
+  range: ByteRange,
+): ReadableStream<Uint8Array> {
+  let offset = 0;
+  return body.pipeThrough(
+    new TransformStream<Uint8Array, Uint8Array>({
+      transform(chunk, controller) {
+        const chunkEnd = offset + chunk.byteLength;
+        if (chunkEnd > range.start) {
+          controller.enqueue(
+            chunk.subarray(Math.max(0, range.start - offset), range.end + 1 - offset),
+          );
+        }
+        offset = chunkEnd;
+        if (offset > range.end) {
+          controller.terminate();
+        }
+      },
+    }),
+  );
+}
