+
+type RangeDecision =
+  | { type: "none" }
+  | { type: "partial"; start: number; end: number; size: number }
+  | { type: "unsatisfiable" };
+
+interface RangeValidators {
+  etag?: string;
+  mtime?: Date;
+}
+
+/**
+ * Decide the `Range` of a request for an asset of known, non-zero size
+ * (RFC 9110 sections 13.1.5 and 14).
+ */
+function evaluateRange(headers: Headers, size: number, validators: RangeValidators): RangeDecision {
+  const range = headers.get("range");
+  if (range === null) {
+    return { type: "none" };
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(ifRange, validators)) {
+    return { type: "none" };
+  }
+  const parsed = parseRangeHeader(range, size);
+  if (parsed === undefined) {
+    return { type: "none" };
+  }
+  if (parsed === "unsatisfiable") {
+    return { type: "unsatisfiable" };
+  }
+  return { type: "partial", ...parsed, size };
+}
+
+// A single `bytes` spec: `N-M`, `N-` or `-N`. The unit is case-insensitive (RFC 9110 section 14.1).
+const RANGE_RE = /^bytes=(?:(\d+)-(\d*)|-(\d+))$/i;
+
+/**
+ * Read a `Range` value for an asset of `size` bytes. Returns `undefined` when the
+ * header must be ignored: malformed, another unit, or more than one spec.
+ */
+function parseRangeHeader(
+  value: string,
+  size: number,
+): { start: number; end: number } | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first, last, suffix] = match;
+  if (suffix !== undefined) {
+    // A zero-length suffix selects no bytes (RFC 9110 section 14.1.1).
+    if (Number(suffix) === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - Number(suffix)), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last ? Number(last) : Infinity;
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * Strong comparison of `If-Range` with the asset validators (RFC 9110 section 13.1.5).
+ * A date only counts when the asset's `Last-Modified` is strong (section 8.8.2.2).
+ */
+function matchesIfRange(value: string, validators: RangeValidators): boolean {
+  if (value.startsWith('"')) {
+    return validators.etag === value;
+  }
+  if (value.startsWith("W/") || !validators.mtime) {
+    return false;
+  }
+  if (Date.parse(value) !== validators.mtime.getTime()) {
+    return false;
+  }
+  // `Last-Modified` is strong only when at least one second older than the response `Date`.
+  const responseSecond = Math.floor(Date.now() / 1000) * 1000;
+  return responseSecond - validators.mtime.getTime() >= 1000;
+}
+
+function partialResponse(
+  event: H3Event,
+  range: Extract<RangeDecision, { type: "partial" }>,
+  body: BodyInit | null,
+): HTTPResponse {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${range.size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+  return new HTTPResponse(body, { status: 206, statusText: "Partial Content" });
+}
+
+/** Cut `[start, end]` (inclusive, in bytes) out of a body. */
+async function sliceBody(body: BodyInit, start: number, end: number): Promise<BodyInit> {
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end - start + 1);
+  }
+  // Blob slicing counts bytes, while string slicing counts UTF-16 units.
+  const blob = await new Response(body).blob();
+  return blob.slice(start, end + 1);
+}
+
+/** Lazily drop `start` bytes and emit `length` bytes, cancelling the source once done. */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  length: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let skip = start;
+  let remaining = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (remaining > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          break;
+        }
+        const cut = Math.min(skip, value.byteLength);
+        skip -= cut;
+        const chunk = value.subarray(cut, cut + remaining);
+        remaining -= chunk.byteLength;
+        if (chunk.byteLength > 0) {
+          controller.enqueue(chunk);
+          return;
+        }
+      }
+      controller.close();
+      await reader.cancel();
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
