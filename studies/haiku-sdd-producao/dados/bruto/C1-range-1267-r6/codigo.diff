+  it("announces Accept-Ranges on GET and HEAD without a Range header", async () => {
+    for (const method of ["GET", "HEAD"]) {
+      const res = await t.fetch("/file.txt", { method });
+      expect(res.status, method).toBe(200);
+      expect(res.headers.get("accept-ranges"), method).toBe("bytes");
+      expect(res.headers.get("content-range"), method).toBeNull();
+    }
+  });
+
+  it("serves a bounded range with 206", async () => {
+    const res = await get({ range: "bytes=0-99" });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(content.slice(0, 100));
+  });
+
+  it("serves a suffix range with 206", async () => {
