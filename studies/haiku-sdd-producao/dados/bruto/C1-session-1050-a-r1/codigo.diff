+import { describe, it, expect } from "vitest";
+import { seal, defaults as sealDefaults } from "../../src/utils/internal/iron-crypto.ts";
+import {
+  kLegacySeal,
+  resolveSessionPasswords,
+  unsealWithPasswords,
+} from "../../src/utils/internal/session.ts";
+
+const first = "primeira-senha-0123456789abcdefghijk";
+const second = "segunda-senha-0123456789abcdefghijk";
+const third = "terceira-senha-0123456789abcdefghijk";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+describe("resolveSessionPasswords", () => {
+  it("rejects an empty list", () => {
+    expect(() => resolveSessionPasswords([], 32)).toThrow(
+      "At least one session password is required",
+    );
+  });
+
+  it("rejects an empty entry", () => {
+    expect(() => resolveSessionPasswords(["", first], 32)).toThrow(
+      "Session password must not be empty",
+    );
+  });
+
+  it("rejects an entry shorter than the minimum length", () => {
+    expect(() => resolveSessionPasswords([first, "curta"], 32)).toThrow(
+      "Session password too short (min 32 characters required)",
+    );
+  });
+
+  it("removes duplicates and keeps the order of the first occurrences", () => {
+    expect(resolveSessionPasswords([second, first, second, third, first], 32)).toEqual([
+      second,
+      first,
+      third,
+    ]);
+  });
+
+  it("wraps a single string in a list", () => {
+    expect(resolveSessionPasswords(first, 32)).toEqual([first]);
+  });
+});
+
+describe("unsealWithPasswords", () => {
+  it("opens a seal with the matching password after the wrong ones", async () => {
+    const sealed = await seal({ id: "a" }, second, sealDefaults);
+    const unsealed = await unsealWithPasswords(sealed, [first, third, second], sealDefaults, false);
+    expect(unsealed).toMatchObject({ id: "a" });
+  });
+
+  it("rethrows Bad hmac value when no password matches", async () => {
+    const sealed = await seal({ id: "a" }, third, sealDefaults);
+    await expect(unsealWithPasswords(sealed, [first, second], sealDefaults, false)).rejects.toThrow(
+      "Bad hmac value",
+    );
+  });
+
+  it("rethrows Expired seal at once, without trying the next password", async () => {
+    const sealed = await seal({ id: "a" }, second, { ...sealDefaults, ttl: -120_000 });
+    await expect(unsealWithPasswords(sealed, [first, second], sealDefaults, false)).rejects.toThrow(
+      "Expired seal",
+    );
+  });
+
+  it("tries the legacy seal for each password and marks the result", async () => {
+    const sealed = await seal({ id: "legacy" }, second, legacyOptions);
+    const unsealed = await unsealWithPasswords(sealed, [first, second], sealDefaults, true);
+    expect(unsealed).toMatchObject({ id: "legacy" });
+    expect((unsealed as any)[kLegacySeal]).toBe(true);
+  });
+
+  it("does not try the legacy seal when the fallback is disabled", async () => {
+    const sealed = await seal({ id: "legacy" }, second, legacyOptions);
+    await expect(unsealWithPasswords(sealed, [first, second], sealDefaults, false)).rejects.toThrow(
+      "Bad hmac value",
+    );
+  });
+});
