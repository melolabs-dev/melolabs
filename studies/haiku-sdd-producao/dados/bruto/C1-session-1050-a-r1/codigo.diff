+/**
+ * Normalizes `SessionConfig.password` into a non-empty list without duplicates.
+ * The first password seals new sessions; every password is tried to unseal.
+ */
+export function resolveSessionPasswords(
+  password: string | string[],
+  minLength: number,
+): [string, ...string[]] {
+  const passwords = Array.isArray(password) ? password : [password];
+  if (passwords.length === 0) {
+    throw new Error("At least one session password is required");
+  }
+  for (const entry of passwords) {
+    if (!entry) {
+      throw new Error("Session password must not be empty");
+    }
+    if (entry.length < minLength) {
+      throw new Error(`Session password too short (min ${minLength} characters required)`);
+    }
+  }
+  const [first = "", ...rest] = new Set(passwords);
+  return [first, ...rest];
+}
+
+/**
+ * Tries each password in order and returns the first one that opens the seal.
+ * Only `Bad hmac value` moves on to the next password; any other error is
+ * rethrown at once. With `legacyFallback`, each password also gets the
+ * 1-iteration attempt, and a session opened that way is marked with `kLegacySeal`.
+ */
+export async function unsealWithPasswords(
+  sealed: string,
+  passwords: [string, ...string[]],
+  sealOptions: SealOptions,
+  legacyFallback: boolean,
+): Promise<Partial<Session>> {
+  const legacyOptions: SealOptions = {
+    ...sealOptions,
+    encryption: { ...sealOptions.encryption, iterations: 1 },
+    integrity: { ...sealOptions.integrity, iterations: 1 },
+  };
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+    if (!legacyFallback) {
+      continue;
+    }
+    try {
+      const unsealed = (await unseal(sealed, password, legacyOptions)) as Partial<Session>;
+      if (unsealed) {
+        (unsealed as any)[kLegacySeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
