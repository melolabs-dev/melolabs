+/**
+ * Open a sealed session with the first password in `passwords` that verifies it.
+ *
+ * A bad HMAC is the only failure that depends on the password, so only it moves
+ * on to the next one. Any other error (expired, malformed, ...) is the same for
+ * every password and is thrown as it is.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacyFallback: boolean,
+): Promise<Partial<Session>> {
+  let lastError: Error | undefined;
+  for (const password of passwords) {
+    try {
+      return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (!legacyFallback || sealOptions.integrity.iterations === 1) {
+      continue;
+    }
+    try {
+      const unsealed = (await unseal(sealed, password, {
+        ...sealOptions,
+        encryption: { ...sealOptions.encryption, iterations: 1 },
+        integrity: { ...sealOptions.integrity, iterations: 1 },
+      })) as Partial<Session>;
+      if (unsealed) {
+        (unsealed as any)[kLegacySeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  // Every password failed: rethrow the last HMAC error, which getSession ignores
+  throw lastError;
+}
+
+function isBadHmac(error: unknown): error is Error {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
