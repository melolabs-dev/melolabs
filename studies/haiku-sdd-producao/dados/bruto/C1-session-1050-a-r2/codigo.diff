@@ -0,0 +1,22 @@
+import { describe, it, expect } from "vitest";
+import { toPasswordList } from "../../src/utils/internal/session.ts";
+
+describe("toPasswordList", () => {
+  it("wraps a string in a list", () => {
+    expect(toPasswordList("x")).toEqual(["x"]);
+  });
+
+  it("returns a list as-is, in declared order", () => {
+    expect(toPasswordList(["a", "b"])).toEqual(["a", "b"]);
+  });
+
+  it("throws a configuration error for an empty list", () => {
+    expect(() => toPasswordList([])).toThrow(
+      "The session password list is empty: provide at least one password",
+    );
+  });
+
+  it("wraps a non-string, non-array value so the seal reports it as before", () => {
+    expect(toPasswordList(undefined as unknown as string)).toEqual([undefined]);
+  });
+});
