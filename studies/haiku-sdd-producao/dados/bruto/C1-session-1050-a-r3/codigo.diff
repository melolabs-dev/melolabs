+/**
+ * Normalize `SessionConfig.password` into the ordered list used to seal and open
+ * sessions. The first password seals; the rest only open.
+ */
+function toPasswordList(password: string | string[]): string[] {
+  const passwords = typeof password === "string" ? [password] : password;
+  if (passwords.length === 0) {
+    throw new Error("Session password list must not be empty");
+  }
+  return passwords;
+}
+
+/**
+ * Open a seal with the first password in the list that matches it. Only a
+ * mismatch (`"Bad hmac value"`) moves on to the next password. Any other error
+ * does not depend on the password, so it is thrown right away.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  let mismatch: unknown;
+  for (const password of toPasswordList(config.password)) {
+    try {
+      return await unsealWithPassword(
+        sealed,
+        password,
+        sealOptions,
+        config.legacySealFallback !== false,
+      );
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      mismatch ??= error;
+    }
+  }
+  throw mismatch;
+}
+
+/**
+ * Open a seal with one password, falling back to the legacy iteration count when
+ * allowed.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacyFallback: boolean,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    if (!legacyFallback || sealOptions.integrity.iterations === 1 || !isBadHmac(error)) {
+      throw error;
+    }
+  }
+  // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+  // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+  // Sessions sealed before the default PBKDF2 iterations were raised from 1
+  // to 8192 fail HMAC verification; retry with the legacy count so existing
+  // sessions survive the upgrade (getSession reseals them with the current
+  // options).
+  const unsealed = (await unseal(sealed, password, {
+    ...sealOptions,
+    encryption: { ...sealOptions.encryption, iterations: 1 },
+    integrity: { ...sealOptions.integrity, iterations: 1 },
+  })) as Partial<Session>;
+  if (unsealed) {
+    (unsealed as any)[kLegacySeal] = true;
+  }
+  return unsealed;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
