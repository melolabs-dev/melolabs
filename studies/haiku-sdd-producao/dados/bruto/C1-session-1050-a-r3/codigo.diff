+import type { SessionConfig } from "../../src/index.ts";
+import { describe, it, expectTypeOf } from "vitest";
+
+describe("session config types", () => {
+  it("accepts a password string", () => {
+    const config: SessionConfig = { password: "current-password" };
+    expectTypeOf(config.password).toEqualTypeOf<string | string[]>();
+  });
+
+  it("accepts a password list", () => {
+    const config: SessionConfig = { password: ["new-password", "old-password"] };
+    expectTypeOf(config.password).toEqualTypeOf<string | string[]>();
+  });
+});
