+/** Effective seal options: defaults, `maxAge`/`idleTimeout` as the ttl, and `config.seal` overrides. */
+function getSealOptions(config: SessionConfig): SealOptions {
+  return {
+    ...sealDefaults,
+    ttl: (config.maxAge || config.idleTimeout || 0) * 1000,
+    ...config.seal,
+  };
+}
+
+/**
+ * Passwords to seal and unseal with, in the order of `config.password`. A string
+ * is returned as is; a list is checked here, so a bad item fails on every path.
+ */
+function getPasswords(config: SessionConfig, sealOptions: SealOptions): string[] {
+  if (typeof config.password === "string") {
+    return [config.password];
+  }
+  if (config.password.length === 0) {
+    throw new Error("Session password list is empty");
+  }
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const password of config.password) {
+    assertPasswordLength(password, minLength);
+  }
+  return config.password;
+}
+
+/**
+ * Unseal with the first password that verifies the HMAC. Only `Bad hmac value`
+ * moves on to the next password; any other error means the seal is invalid for
+ * every password. For each password, the legacy 1-iteration count is tried
+ * before moving on when the fallback is enabled.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacyFallback: boolean,
+): Promise<{ unsealed: Partial<Session>; legacy: boolean }> {
+  const legacyOptions: SealOptions = {
+    ...sealOptions,
+    encryption: { ...sealOptions.encryption, iterations: 1 },
+    integrity: { ...sealOptions.integrity, iterations: 1 },
+  };
+  let firstError: unknown;
+  for (const password of passwords) {
+    try {
+      const unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+      return { unsealed, legacy: false };
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      firstError ??= error;
+    }
+    if (!legacyFallback) {
+      continue;
+    }
+    try {
+      const unsealed = (await unseal(sealed, password, legacyOptions)) as Partial<Session>;
+      return { unsealed, legacy: true };
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+    }
+  }
+  throw firstError;
+}
+
+/** Whether the error means the seal did not verify with this password. */
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
