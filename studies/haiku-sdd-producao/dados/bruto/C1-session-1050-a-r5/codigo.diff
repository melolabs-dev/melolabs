diff --git a/test/session-passwords.test.ts b/test/session-passwords.test.ts
new file mode 100644
index 0000000..c24b2ea
--- /dev/null
+++ b/test/session-passwords.test.ts
@@ -0,0 +1,173 @@
+import { beforeEach, vi } from "vitest";
+import { getSession, useSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const NEW = "current-password-0123456789abcdefghij";
+const OLD = "previous-password-0123456789abcdefgh";
+const OTHER = "unknown-password-0123456789abcdefgh";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+describeMatrix("session passwords", (t, { it, expect }) => {
+  let ids = 0;
+  const base = {
+    name: "h3-pw",
+    generateId: () => `sess-${++ids}`,
+  };
+
+  // Each route takes its config as JSON in `x-session-config`, so one app serves every case
+  beforeEach(() => {
+    t.app.get("/write", async (event) => {
+      const options = JSON.parse(event.req.headers.get("x-session-config")!);
+      try {
+        const session = await useSession(event, { ...base, ...options });
+        await session.update({ user: "alice" });
+        return { id: session.id };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/read", async (event) => {
+      const options = JSON.parse(event.req.headers.get("x-session-config")!);
+      try {
+        const session = await getSession(event, { ...base, ...options });
+        return { id: session.id, data: session.data };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+  });
+
+  const write = async (options: object) => {
+    const res = await t.fetch("/write", {
+      headers: { "x-session-config": JSON.stringify(options) },
+    });
+    const cookie = res.headers.getSetCookie()[0] ?? "";
+    const sealed = cookie.match(/h3-pw=([^;]+)/)?.[1] ?? "";
+    return {
+      ...((await res.json()) as { id?: string; error?: string }),
+      sealed: decodeURIComponent(sealed),
+    };
+  };
+
+  const read = async (options: object, cookie?: string) => {
+    const headers: Record<string, string> = {
+      "x-session-config": JSON.stringify(options),
+    };
+    if (cookie) {
+      headers.Cookie = `h3-pw=${cookie}`;
+    }
+    const res = await t.fetch("/read", { headers });
+    return (await res.json()) as { id?: string; data?: Record<string, unknown>; error?: string };
+  };
+
+  it("seals with the first password of the list (RF-01, RF-02)", async () => {
+    const { sealed } = await write({ password: [NEW, OLD] });
+    expect(await unseal(sealed, NEW, sealDefaults)).toMatchObject({ data: { user: "alice" } });
+    await expect(unseal(sealed, OLD, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("opens a session sealed with a later password of the list (RF-03)", async () => {
+    const { id, sealed } = await write({ password: [OLD] });
+    expect(await read({ password: [NEW, OLD] }, sealed)).toMatchObject({
+      id,
+      data: { user: "alice" },
+    });
+  });
+
+  it("opens a session whatever the order of the list (RF-03)", async () => {
+    const { id, sealed } = await write({ password: [NEW, OLD] });
+    expect(await read({ password: [OLD, NEW] }, sealed)).toMatchObject({
+      id,
+      data: { user: "alice" },
+    });
+  });
+
+  it("starts a new session when no password of the list opens the cookie (RF-04)", async () => {
+    const { id, sealed } = await write({ password: [OTHER] });
+    const body = await read({ password: [NEW, OLD] }, sealed);
+    expect(body.error).toBeUndefined();
+    expect(body.id).not.toBe(id);
+    expect(body.data).toEqual({});
+  });
+
+  it("unseals a legacy cookie with a later password and reseals it with the first", async () => {
+    const legacy = await seal(
+      { id: "legacy", createdAt: Date.now(), data: { foo: "legacy" } },
+      OLD,
+      legacyOptions,
+    );
+    const body = await read({ password: [NEW, OLD] }, legacy);
+    expect(body).toMatchObject({ id: "legacy", data: { foo: "legacy" } });
+
+    const res = await t.fetch("/read", {
+      headers: {
+        "x-session-config": JSON.stringify({ password: [NEW, OLD] }),
+        Cookie: `h3-pw=${legacy}`,
+      },
+    });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = decodeURIComponent(setCookies[0].match(/h3-pw=([^;]+)/)![1]);
+    expect(await unseal(resealed, NEW, sealDefaults)).toMatchObject({
+      id: "legacy",
+      data: { foo: "legacy" },
+    });
+  });
+
+  it("rejects a legacy cookie from a later password with legacySealFallback: false", async () => {
+    const legacy = await seal(
+      { id: "legacy", createdAt: Date.now(), data: { foo: "legacy" } },
+      OLD,
+      legacyOptions,
+    );
+    const body = await read({ password: [NEW, OLD], legacySealFallback: false }, legacy);
+    expect(body.id).not.toBe("legacy");
+    expect(body.data).toEqual({});
+  });
+
+  it("rejects an empty password list on read and write (RF-06)", async () => {
+    const expected = "Session password list is empty";
+    expect((await read({ password: [] })).error).toBe(expected);
+    expect((await write({ password: [] })).error).toBe(expected);
+  });
+
+  it("rejects a short password in the list on read and write (RF-06)", async () => {
+    const passwords = ["senha-curta", NEW];
+    const expected = "Password string too short (min 32 characters required)";
+    expect((await read({ password: passwords })).error).toBe(expected);
+    expect((await write({ password: passwords })).error).toBe(expected);
+  });
+
+  it("rejects more than four passwords (D-05)", async () => {
+    const passwords = [
+      NEW,
+      OLD,
+      OTHER,
+      "other-password-0123456789abcdefghijk",
+      "more-password-0123456789abcdefghijkl",
+    ];
+    expect((await read({ password: passwords })).error).toBe("Too many session passwords (max 4)");
+  });
+
+  it("derives one key per password, plus one legacy retry each (D-03)", async () => {
+    const { sealed } = await write({ password: [OTHER] });
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      const body = await read({ password: [NEW, OLD] }, sealed);
+      expect(body.error).toBeUndefined();
+      const iterations = deriveBits.mock.calls.map(
+        ([params]) => (params as { iterations?: number }).iterations,
+      );
+      expect(iterations.filter((n) => n === sealDefaults.integrity.iterations)).toHaveLength(2);
+      expect(iterations.filter((n) => n === 1)).toHaveLength(2);
+    } finally {
+      deriveBits.mockRestore();
+    }
+  });
+});
