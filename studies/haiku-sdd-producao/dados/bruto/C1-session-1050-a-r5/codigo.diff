+import { unseal, defaults as sealDefaults } from "./iron-crypto.ts";
+import { kLegacySeal } from "./session.ts";
+
+import type { SealOptions } from "./iron-crypto.ts";
+import type { Session, SessionConfig } from "../session.ts";
+
+/** Most passwords a session config can list. Each one a cookie fails to open costs PBKDF2 work. */
+export const MAX_SESSION_PASSWORDS = 4;
+
+/**
+ * Normalize and validate `config.password`. Throws if the list is empty, has more
+ * than {@link MAX_SESSION_PASSWORDS} entries, or holds a password shorter than the
+ * seal options require. Always returns at least one password; the first seals.
+ */
+export function resolvePasswords(config: Pick<SessionConfig, "password" | "seal">): string[] {
+  const passwords = typeof config.password === "string" ? [config.password] : config.password;
+  if (passwords.length === 0) {
+    throw new Error("Session password list is empty");
+  }
+  if (passwords.length > MAX_SESSION_PASSWORDS) {
+    throw new Error(`Too many session passwords (max ${MAX_SESSION_PASSWORDS})`);
+  }
+  const sealOptions = { ...sealDefaults, ...config.seal };
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const password of passwords) {
+    if (password.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  return passwords;
+}
+
+/**
+ * Unseal `sealed` with each password in order. Moves on to the next password only
+ * when the seal fails HMAC verification; any other error is thrown at once, since
+ * it does not depend on the password. With `legacyAllowed`, each password also gets
+ * one try with the legacy 1-iteration count, and a seal opened that way is marked
+ * with `kLegacySeal`. If no password opens the seal, the last HMAC error is thrown.
+ */
+export async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacyAllowed: boolean,
+): Promise<Partial<Session>> {
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+    if (!legacyAllowed) {
+      continue;
+    }
+    try {
+      const unsealed = (await unseal(
+        sealed,
+        password,
+        legacyOptions(sealOptions),
+      )) as Partial<Session>;
+      (unsealed as any)[kLegacySeal] = true;
+      return unsealed;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+function legacyOptions(sealOptions: SealOptions): SealOptions {
+  return {
+    ...sealOptions,
+    encryption: { ...sealOptions.encryption, iterations: 1 },
+    integrity: { ...sealOptions.integrity, iterations: 1 },
+  };
+}
