diff --git a/test/unit/session-passwords.test.ts b/test/unit/session-passwords.test.ts
new file mode 100644
index 0000000..52f3b05
--- /dev/null
+++ b/test/unit/session-passwords.test.ts
@@ -0,0 +1,40 @@
+import { describe, it, expect } from "vitest";
+import { sessionPasswords } from "../../src/utils/internal/session.ts";
+
+const NEW = "senha-nova-0123456789012345678901234567890123";
+const OLD = "senha-antiga-9876543210987654321098765432109876";
+
+describe("sessionPasswords", () => {
+  it("wraps a single password in a list", () => {
+    expect(sessionPasswords({ password: NEW })).toEqual([NEW]);
+  });
+
+  it("keeps the order of a valid list", () => {
+    expect(sessionPasswords({ password: [NEW, OLD] })).toEqual([NEW, OLD]);
+  });
+
+  it("rejects an empty list", () => {
+    expect(() => sessionPasswords({ password: [] })).toThrow(
+      "At least one session password is required",
+    );
+  });
+
+  it("rejects an item shorter than the minimum length", () => {
+    expect(() => sessionPasswords({ password: [NEW, "curta"] })).toThrow(/too short/);
+  });
+
+  it("uses the minimum length from the seal options", () => {
+    const seal = {
+      ttl: 0,
+      timestampSkewSec: 60,
+      localtimeOffsetMsec: 0,
+      encryption: { saltBits: 256, algorithm: "aes-256-cbc", iterations: 1, minPasswordlength: 6 },
+      integrity: { saltBits: 256, algorithm: "sha256", iterations: 1, minPasswordlength: 6 },
+    } as const;
+    expect(sessionPasswords({ password: ["curta1", "curta2"], seal })).toEqual([
+      "curta1",
+      "curta2",
+    ]);
+    expect(() => sessionPasswords({ password: ["curta"], seal })).toThrow(/too short/);
+  });
+});
