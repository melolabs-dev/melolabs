+/**
+ * Passwords for a session config: the first one seals, every one opens. Checked
+ * up front, so a bad list fails on first use instead of being swallowed as an
+ * invalid session.
+ */
+export function sessionPasswords(config: Pick<SessionConfig, "password" | "seal">): string[] {
+  const passwords = typeof config.password === "string" ? [config.password] : config.password;
+  if (passwords.length === 0) {
+    throw new Error("At least one session password is required");
+  }
+  const minLength =
+    config.seal?.encryption.minPasswordlength ?? sealDefaults.encryption.minPasswordlength;
+  for (const password of passwords) {
+    if (typeof password !== "string" || password.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  return passwords;
+}
