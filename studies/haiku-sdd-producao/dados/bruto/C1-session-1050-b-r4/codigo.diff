+      integrity: { ...sealDefaults.integrity, iterations: 1 },
+    };
+
+    let extraIdCtr = 0;
+    const extraConfig: SessionConfig = {
+      name: "h3-extra",
+      password: passwordA,
+      extraUnsealPasswords: [passwordB],
+      generateId: () => `extra-${++extraIdCtr}`,
+    };
+
+    const payload = (id: string, createdAt = Date.now()) => ({
+      id,
+      createdAt,
+      data: { user: "ana" },
