+
+/**
+ * Throws for an empty or too-short extra password, so a typo fails loudly
+ * instead of silently starting a new session. No-op without extra passwords.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig): void {
+  if (!config.extraUnsealPasswords?.length) {
+    return;
+  }
+  const options = { ...sealDefaults, ...config.seal };
+  const minLength = Math.max(
+    options.encryption.minPasswordlength,
+    options.integrity.minPasswordlength,
+  );
+  for (const password of config.extraUnsealPasswords) {
+    if (!password) {
+      throw new Error("Empty password");
+    }
+    if (password.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+}
+
+/**
+ * Tries each password in order. Moves on only on "Bad hmac value"; any other
+ * error is thrown at once. Rethrows the last "Bad hmac value" if none opens it.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  options: SealOptions,
+): Promise<Partial<Session>> {
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return (await unseal(sealed, password, options)) as Partial<Session>;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+/** True when the error means the password is wrong (HMAC mismatch). */
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
