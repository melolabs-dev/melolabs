+
+// Single byte range only: `bytes=a-b`, `bytes=a-` and `bytes=-n` (RFC 9110 section 14.1.1).
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+interface ByteRangeMeta {
+  size?: number;
+  etag?: string;
+  lastModified?: Date;
+}
+
+/** Result of `resolveRange`. `undefined` means the `Range` is ignored and the response is 200. */
+type RangeResolution =
+  | { status: 206; start: number; end: number; size: number }
+  | { status: 416; size: number };
+
+/**
+ * Resolve the request `Range` against the asset. Malformed, multi-range, non-`bytes`
+ * and `If-Range`-mismatched requests are ignored (RFC 9110 sections 13.1.5 and 14.2).
+ */
+function resolveRange(headers: Headers, meta: ByteRangeMeta): RangeResolution | undefined {
+  const range = headers.get("range");
+  const size = meta.size;
+  if (range === null || size === undefined || !Number.isFinite(size) || size < 0) {
+    return undefined;
+  }
+
+  const parsed = parseByteRange(range.trim(), size);
+  const ifRange = headers.get("if-range");
+  if (!parsed || (ifRange !== null && !ifRangeMatches(ifRange, meta))) {
+    return undefined;
+  }
+
+  if (parsed === "unsatisfiable") {
+    return { status: 416, size };
+  }
+  return { status: 206, start: parsed[0], end: parsed[1], size };
+}
+
+/** Returns the inclusive `[start, end]`, `"unsatisfiable"`, or `undefined` for an invalid `Range`. */
+function parseByteRange(
+  value: string,
+  size: number,
+): [number, number] | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value);
+  if (!match || (match[1] === "" && match[2] === "")) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+
+  if (first === "") {
+    const suffix = Number(last);
+    if (suffix === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return [Math.max(size - suffix, 0), size - 1];
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return [start, last === "" ? size - 1 : Math.min(Number(last), size - 1)];
+}
+
+/**
+ * A weak validator never matches. A strong ETag must equal the asset's strong ETag exactly,
+ * so `matchETag` (weak comparison) is not reused here. A date must equal `Last-Modified`.
+ */
+function ifRangeMatches(value: string, meta: ByteRangeMeta): boolean {
+  if (value.startsWith("W/")) {
+    return false;
+  }
+  if (value.startsWith('"')) {
+    return !!meta.etag && !meta.etag.startsWith("W/") && value === meta.etag;
+  }
+  if (!meta.lastModified) {
+    return false;
+  }
+  const date = new Date(value).getTime();
+  return !Number.isNaN(date) && date === meta.lastModified.getTime();
+}
+
+function setRangeHeaders(event: H3Event, range: RangeResolution): void {
+  if (range.status === 416) {
+    event.res.headers.set("content-range", `bytes */${range.size}`);
+    event.res.headers.set("content-length", "0");
+    return;
+  }
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${range.size}`);
+  event.res.headers.set("content-length", `${range.end - range.start + 1}`);
+}
+
+/** Slice `length` bytes starting at byte `start`. Never returns `null`. */
+function sliceBody(
+  body: NonNullable<BodyInit>,
+  start: number,
+  length: number,
+): Blob | ReadableStream<Uint8Array> {
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, length);
+  }
+  if (
+    typeof body === "string" ||
+    body instanceof Blob ||
+    body instanceof ArrayBuffer ||
+    ArrayBuffer.isView(body)
+  ) {
+    return new Blob([body]).slice(start, start + length);
+  }
+  return sliceStream(new Response(body).body!, start, length);
+}
+
+/** Stream the bytes `[skip, skip + take)` of `stream`, cancelling the source once they are emitted. */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  skip: number,
+  take: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let toSkip = skip;
+  let toTake = take;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const { done, value } = await reader.read();
+      if (done) {
+        controller.close();
+        return;
+      }
+      let chunk = value;
+      if (toSkip > 0) {
+        const cut = Math.min(toSkip, chunk.byteLength);
+        toSkip -= cut;
+        chunk = chunk.subarray(cut);
+      }
+      chunk = chunk.subarray(0, toTake);
+      toTake -= chunk.byteLength;
+      if (chunk.byteLength > 0) {
+        controller.enqueue(chunk);
+      }
+      if (toTake === 0) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
