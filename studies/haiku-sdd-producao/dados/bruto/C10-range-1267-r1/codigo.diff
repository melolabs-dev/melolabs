+import { beforeEach, expect, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import type { StaticAssetMeta } from "../src/utils/static.ts";
+import { describeMatrix, type TestContext } from "./_setup.ts";
+
+const mtime = 1_700_000_000_000;
+const lastModified = new Date(mtime).toUTCString();
+const bytes = Uint8Array.from({ length: 1000 }, (_, i) => i % 256);
+const ascii = Array.from({ length: 1000 }, (_, i) => String.fromCharCode(33 + (i % 90))).join("");
+const asciiBytes = new TextEncoder().encode(ascii);
+
+const assets: Record<string, { meta: StaticAssetMeta; body: NonNullable<BodyInit> }> = {
+  "/file.bin": {
+    meta: { type: "application/octet-stream", etag: '"abc"', mtime, size: 1000 },
+    body: bytes,
+  },
+  "/nosize.bin": {
+    meta: { type: "application/octet-stream", etag: '"abc"', mtime },
+    body: bytes,
+  },
+  "/empty.bin": {
+    meta: { type: "application/octet-stream", etag: '"empty"', mtime, size: 0 },
+    body: new Uint8Array(),
+  },
+  "/app.js": {
+    meta: { type: "text/javascript", etag: '"js"', mtime, size: 1000 },
+    body: bytes,
+  },
+  "/app.js.br": {
+    meta: { type: "text/javascript", encoding: "br", etag: '"js-br"', mtime, size: 500 },
+    body: bytes.subarray(0, 500),
+  },
+};
+
+function createOptions(overrides: Partial<ServeStaticOptions> = {}): ServeStaticOptions {
+  return {
+    getMeta: vi.fn((id) => assets[id]?.meta),
+    getContents: vi.fn((id) => assets[id]?.body),
+    ...overrides,
+  };
+}
+
+async function expectBody(res: Response, start: number, end: number) {
+  expect(new Uint8Array(await res.arrayBuffer())).toEqual(bytes.subarray(start, end + 1));
+}
+
+let options: ServeStaticOptions;
+
+function registerRoute(t: TestContext) {
+  beforeEach(() => {
+    options = createOptions();
+    t.app.all("/**", (event) => serveStatic(event, options));
+  });
+}
+
+// T-01: non-regression. Range must not change 404/405 or fallthrough.
+describeMatrix("serve static range: regressions", (t, { it }) => {
+  registerRoute(t);
+
+  it("POST to an existing asset with Range responds 405 without range headers", async () => {
+    const res = await t.fetch("/file.bin", {
+      method: "POST",
+      headers: { range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(405);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("GET to a missing asset with Range responds 404 without range headers", async () => {
+    const res = await t.fetch("/missing.bin", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  // With `fallthrough`, `serveStatic` returns `undefined`, which H3 answers with an empty 200.
+  it("falls through a missing asset with Range without range headers", async () => {
+    options = createOptions({ fallthrough: true });
+    const res = await t.fetch("/missing.bin", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  it("falls through a POST with Range without range headers", async () => {
+    options = createOptions({ fallthrough: true });
+    const res = await t.fetch("/file.bin", {
+      method: "POST",
+      headers: { range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+});
+
+// T-02: Accept-Ranges and ignored Range headers.
+describeMatrix("serve static range: accept-ranges and ignored ranges", (t, { it }) => {
+  registerRoute(t);
+
+  it("GET without Range advertises Accept-Ranges and returns the full body", async () => {
+    const res = await t.fetch("/file.bin");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-range")).toBeNull();
+    await expectBody(res, 0, 999);
+  });
+
+  const ignored = [
+    ["inverted bounds", "bytes=5-2"],
+    ["unknown unit", "items=0-9"],
+    ["multiple ranges", "bytes=0-1,3-4"],
+    ["invalid syntax", "bytes=abc"],
+  ];
+
+  for (const [name, range] of ignored) {
+    it(`ignores Range with ${name}`, async () => {
+      const res = await t.fetch("/file.bin", { headers: { range } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-length")).toBe("1000");
+      expect(res.headers.get("content-range")).toBeNull();
+      await expectBody(res, 0, 999);
+    });
+  }
+
+  it("ignores Range when getMeta has no size", async () => {
+    const res = await t.fetch("/nosize.bin", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    await expectBody(res, 0, 999);
+  });
+
+  it("preserves accept-ranges set in options.headers", async () => {
+    options = createOptions({ headers: { "accept-ranges": "none" } });
+    const res = await t.fetch("/file.bin");
+    expect(res.headers.get("accept-ranges")).toBe("none");
+  });
+});
+
+// T-03: 206 for GET, 416 and suffix/open ranges.
+describeMatrix("serve static range: partial and unsatisfiable", (t, { it }) => {
+  registerRoute(t);
+
+  it("bytes=100-199 responds 206 with the requested bytes", async () => {
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 100-199/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    await expectBody(res, 100, 199);
+  });
+
+  const resolved = [
+    ["suffix", "bytes=-50", 950, 999],
+    ["open-ended", "bytes=900-", 900, 999],
+    ["end past size", "bytes=500-5000", 500, 999],
+    ["suffix past size", "bytes=-5000", 0, 999],
+  ] as const;
+
+  for (const [name, range, start, end] of resolved) {
+    it(`resolves ${name} range ${range}`, async () => {
+      const res = await t.fetch("/file.bin", { headers: { range } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe(`bytes ${start}-${end}/1000`);
+      await expectBody(res, start, end);
+    });
+  }
+
+  it("bytes=1000-1100 responds 416 with an empty body", async () => {
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=1000-1100" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  it("bytes=-0 responds 416", async () => {
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+  });
+
+  it("any range on a zero-size asset responds 416", async () => {
+    const res = await t.fetch("/empty.bin", { headers: { range: "bytes=0-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+    expect(res.headers.get("content-length")).toBe("0");
+  });
+
+  it("options.headers content-length is overridden by a 206", async () => {
+    options = createOptions({ headers: { "content-length": "999" } });
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("10");
+  });
+
+  it("calls getContents once for a 206", async () => {
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(options.getContents).toHaveBeenCalledTimes(1);
+  });
+});
+
+// T-04: HEAD with Range.
+describeMatrix("serve static range: HEAD", (t, { it }) => {
+  registerRoute(t);
+
+  it("HEAD with a valid range responds 206 without calling getContents", async () => {
+    const res = await t.fetch("/file.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=100-199" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 100-199/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe("");
+    expect(options.getContents).not.toHaveBeenCalled();
+  });
+
+  it("HEAD with an unsatisfiable range responds 416 without calling getContents", async () => {
+    const res = await t.fetch("/file.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=1000-1100" },
+    });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(await res.text()).toBe("");
+    expect(options.getContents).not.toHaveBeenCalled();
+  });
+});
+
+// T-05: If-Range and 304 precedence.
+describeMatrix("serve static range: conditionals", (t, { it }) => {
+  registerRoute(t);
+
+  it("If-Range with a non-matching ETag ignores Range", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": '"xyz"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    await expectBody(res, 0, 999);
+  });
+
+  it("If-Range with a matching strong ETag honors Range", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": '"abc"' },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/1000");
+  });
+
+  it("If-Range with a weak ETag ignores Range", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": 'W/"abc"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("If-Range with a matching date honors Range", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": lastModified },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/1000");
+  });
+
+  it("If-Range with a different date ignores Range", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: {
+        range: "bytes=0-9",
+        "if-range": new Date(mtime + 1000).toUTCString(),
+      },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("invalid If-Range ignores an unsatisfiable Range and responds 200", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: { range: "bytes=1000-1100", "if-range": '"xyz"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("If-None-Match takes precedence over Range and responds 304", async () => {
+    const res = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-none-match": '"abc"' },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+});
+
+// T-06: pre-compressed variants, body types and null contents.
+describeMatrix("serve static range: encodings and body types", (t, { it }) => {
+  registerRoute(t);
+
+  it("applies Range to the pre-compressed variant", async () => {
+    options = createOptions({ encodings: { br: ".br" } });
+    const res = await t.fetch("/app.js", {
+      headers: { "accept-encoding": "br", range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("br");
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/500");
+    expect(res.headers.get("content-length")).toBe("10");
+    // Node's fetch decodes `content-encoding: br`, and the fixture is not real Brotli,
+    // so the body is only compared under `web`. Body slicing is covered by the other cases.
+    if (t.target === "web") {
+      expect(new Uint8Array(await res.arrayBuffer())).toEqual(bytes.subarray(0, 10));
+    }
+  });
+
+  const sources: [string, () => NonNullable<BodyInit>, Uint8Array][] = [
+    [
+      "ReadableStream",
+      () =>
+        new ReadableStream({
+          start(controller) {
+            controller.enqueue(bytes);
+            controller.close();
+          },
+        }),
+      bytes,
+    ],
+    ["Blob", () => new Blob([bytes]), bytes],
+    ["ArrayBuffer", () => bytes.slice().buffer, bytes],
+    ["Uint8Array", () => bytes.slice(), bytes],
+    ["string", () => ascii, asciiBytes],
+  ];
+
+  for (const [name, body, full] of sources) {
+    it(`slices a ${name} body`, async () => {
+      options = createOptions({ getContents: vi.fn(() => body()) });
+      const res = await t.fetch("/file.bin", { headers: { range: "bytes=100-199" } });
+      expect(res.status).toBe(206);
+      expect(new Uint8Array(await res.arrayBuffer())).toEqual(full.subarray(100, 200));
+    });
+  }
+
+  it("slices a stream whose range starts and ends inside chunks", async () => {
+    options = createOptions({
+      getContents: vi.fn(
+        () =>
+          new ReadableStream({
+            start(controller) {
+              for (const chunk of [bytes.slice(0, 300), bytes.slice(300, 600), bytes.slice(600)]) {
+                controller.enqueue(chunk);
+              }
+              controller.close();
+            },
+          }),
+      ),
+    });
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=250-649" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("400");
+    await expectBody(res, 250, 649);
+  });
+
+  it("getContents returning null with a valid Range responds 200 without range headers", async () => {
+    // `/nosize.bin` has no size, so the pre-existing `content-length` mismatch
+    // for null contents (techspec R-04) does not apply here.
+    options = createOptions({ getContents: vi.fn(() => null) });
+    const res = await t.fetch("/nosize.bin", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+});
