+// Only a single `bytes` range is honored. Multiple ranges, other units and
+// malformed values do not match and are ignored (RFC 9110 section 14.2).
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+type ByteRange = { start: number; end: number };
+
+/**
+ * Read the request `Range` for an asset of `size` bytes. Returns `undefined` when the
+ * range must be ignored, `"unsatisfiable"` when no byte satisfies it, or the inclusive range.
+ */
+function readRange(
+  headers: Headers,
+  size: number,
+  validators: { etag?: string; mtime?: Date },
+): ByteRange | "unsatisfiable" | undefined {
+  const range = headers.get("range");
+  if (!range) {
+    return undefined;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !isIfRangeMatch(ifRange, validators)) {
+    return undefined;
+  }
+  return parseByteRange(range, size);
+}
+
+/** `If-Range` honors an entity-tag only when it is strong and equal, or an HTTP-date equal to `Last-Modified`. */
+function isIfRangeMatch(ifRange: string, { etag, mtime }: { etag?: string; mtime?: Date }) {
+  if (ifRange.startsWith('"') || ifRange.startsWith("W/")) {
+    return !!etag && !etag.startsWith("W/") && ifRange === etag;
+  }
+  return !!mtime && Date.parse(ifRange) === mtime.getTime();
+}
+
+function parseByteRange(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  if (first === "") {
+    // Suffix range: the last `length` bytes.
+    const length = Number(last);
+    if (length === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - length, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last !== "" && start > Number(last)) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { start, end };
+}
+
+function sliceContents(contents: BodyInit, start: number, end: number): BodyInit {
+  if (typeof contents === "string") {
+    return new TextEncoder().encode(contents).subarray(start, end + 1);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return contents.slice(start, end + 1);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset, contents.byteLength).subarray(
+      start,
+      end + 1,
+    );
+  }
+  const stream = contents instanceof ReadableStream ? contents : new Response(contents).body!;
+  return sliceStream(stream, start, end);
+}
+
+/** Pull from the source only as far as the last byte of the range, then cancel the rest. */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let position = 0;
+  return new ReadableStream<Uint8Array>(
+    {
+      async pull(controller) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunkStart = position;
+        const chunkEnd = position + value.byteLength;
+        position = chunkEnd;
+        const from = Math.max(start - chunkStart, 0);
+        const to = Math.min(end + 1 - chunkStart, value.byteLength);
+        if (from < to) {
+          controller.enqueue(value.subarray(from, to));
+        }
+        if (chunkEnd > end) {
+          controller.close();
+          await reader.cancel();
+        }
+      },
+      cancel(reason) {
+        return reader.cancel(reason);
+      },
+    },
+    { highWaterMark: 0 },
+  );
+}
