+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const CONTENT = "abcdefghijklmnopqrstuvwxyz".repeat(4).slice(0, 100);
+const LAST_MODIFIED = new Date(1_700_000_000_000);
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let overrides: Partial<ServeStaticOptions> = {};
+
+  beforeEach(() => {
+    overrides = {};
+    t.app.all("/**", (event) => {
+      return serveStatic(event, {
+        getMeta: (id) =>
+          id.includes("404")
+            ? undefined
+            : {
+                type: "text/plain",
+                etag: '"v1"',
+                mtime: LAST_MODIFIED,
+                size: CONTENT.length,
+              },
+        getContents: (id) => (id.includes("404") ? undefined : CONTENT),
+        ...overrides,
+      });
+    });
+  });
+
+  const get = (range: string, headers: Record<string, string> = {}) =>
+    t.fetch("/file.txt", { headers: { range, ...headers } });
+
+  it("advertises accept-ranges on 200", async () => {
+    const res = await t.fetch("/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("advertises accept-ranges on 206, 416 and HEAD", async () => {
+    expect((await get("bytes=0-9")).headers.get("accept-ranges")).toBe("bytes");
+    expect((await get("bytes=100-")).headers.get("accept-ranges")).toBe("bytes");
+    expect(
+      (await t.fetch("/file.txt", { method: "HEAD", headers: { range: "bytes=0-9" } })).headers.get(
+        "accept-ranges",
+      ),
+    ).toBe("bytes");
+  });
+
+  it("keeps an accept-ranges value set by the app", async () => {
+    overrides = { headers: { "accept-ranges": "none" } };
+    const res = await get("bytes=0-9");
+    expect(res.headers.get("accept-ranges")).toBe("none");
+  });
+
+  const partialCases: [range: string, start: number, end: number][] = [
+    ["bytes=10-19", 10, 19],
+    ["bytes=90-", 90, 99],
+    ["bytes=-10", 90, 99],
+    ["bytes= 10 - 19 ", 10, 19],
+  ];
+  for (const [range, start, end] of partialCases) {
+    it(`responds 206 for ${range}`, async () => {
+      const res = await get(range);
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe(`bytes ${start}-${end}/100`);
+      expect(res.headers.get("content-length")).toBe(String(end - start + 1));
+      expect(await res.text()).toBe(CONTENT.slice(start, end + 1));
+    });
+  }
+
+  const malformedRanges = [
+    "bytes=abc",
+    "bytes=",
+    "bytes=-",
+    "bytes=5-3",
+    "bytes=0-1,3-4",
+    "items=0-1",
+  ];
+  for (const range of malformedRanges) {
+    it(`ignores malformed Range ${range} and responds 200`, async () => {
+      const res = await get(range);
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await res.text()).toBe(CONTENT);
+    });
+  }
+
+  it("clamps an end past the file to the last byte", async () => {
+    const res = await get("bytes=90-999");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 90-99/100");
+    expect(await res.text()).toBe(CONTENT.slice(90));
+  });
+
+  it("clamps a suffix longer than the file to the whole file", async () => {
+    const res = await get("bytes=-500");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/100");
+    expect(await res.text()).toBe(CONTENT);
+  });
+
+  for (const range of ["bytes=100-", "bytes=-0"]) {
+    it(`responds 416 for ${range}`, async () => {
+      const res = await get(range);
+      expect(res.status).toBe(416);
+      expect(res.headers.get("content-range")).toBe("bytes */100");
+      expect(res.headers.get("content-length")).toBe("0");
+      expect(await res.text()).toBe("");
+    });
+  }
+
+  it("responds 416 for a range on an empty asset", async () => {
+    overrides = {
+      getMeta: () => ({ etag: '"v1"', size: 0 }),
+      getContents: () => "",
+    };
+    const res = await get("bytes=0-");
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+    expect(res.headers.get("content-length")).toBe("0");
+  });
+
+  it("serves 206 when If-Range matches the ETag", async () => {
+    const res = await get("bytes=0-9", { "if-range": '"v1"' });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(CONTENT.slice(0, 10));
+  });
+
+  it("serves 200 when If-Range does not match the ETag", async () => {
+    const res = await get("bytes=0-9", { "if-range": '"v0"' });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(CONTENT);
+  });
+
+  it("serves 200 when If-Range is a weak ETag", async () => {
+    const res = await get("bytes=0-9", { "if-range": 'W/"v1"' });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(CONTENT);
+  });
+
+  it("serves 206 when If-Range is the Last-Modified date", async () => {
+    const res = await get("bytes=0-9", { "if-range": LAST_MODIFIED.toUTCString() });
+    expect(res.status).toBe(206);
+  });
+
+  it("serves 200 when If-Range is a different date", async () => {
+    const res = await get("bytes=0-9", { "if-range": new Date(0).toUTCString() });
+    expect(res.status).toBe(200);
+  });
+
+  it("ignores If-Range without Range", async () => {
+    const res = await t.fetch("/file.txt", { headers: { "if-range": '"v1"' } });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(CONTENT);
+  });
+
+  it("responds 304 with no body when If-None-Match matches, even with Range", async () => {
+    const res = await get("bytes=0-9", { "if-none-match": '"v1"' });
+    expect(res.status).toBe(304);
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds 206 with headers and no body to HEAD", async () => {
+    const res = await t.fetch("/file.txt", { method: "HEAD", headers: { range: "bytes=10-19" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 10-19/100");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds 416 to HEAD for an unsatisfiable range", async () => {
+    const res = await t.fetch("/file.txt", { method: "HEAD", headers: { range: "bytes=100-" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */100");
+  });
+
+  it("still rejects POST with 405 when Range is sent", async () => {
+    const res = await t.fetch("/file.txt", { method: "POST", headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(405);
+  });
+
+  it("still responds 404 for a missing asset with Range", async () => {
+    const res = await t.fetch("/missing404.txt", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(404);
+  });
+
+  it("calls getContents once for a 206", async () => {
+    const getContents = vi.fn(() => CONTENT);
+    overrides = { getContents };
+    await get("bytes=0-9");
+    expect(getContents).toHaveBeenCalledTimes(1);
+  });
+});
