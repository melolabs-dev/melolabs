@@ -0,0 +1,119 @@
+import { describe, it, expect } from "vitest";
+import { sliceBody, sliceStream } from "../../src/utils/internal/range.ts";
+
+async function readAll(body: BodyInit | undefined): Promise<Uint8Array> {
+  if (body === undefined) {
+    throw new Error("expected a body");
+  }
+  return new Uint8Array(await new Response(body).arrayBuffer());
+}
+
+function chunkedStream(chunks: Uint8Array[], onCancel?: (reason: unknown) => void) {
+  let index = 0;
+  return new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (index < chunks.length) {
+        controller.enqueue(chunks[index++]);
+      } else {
+        controller.close();
+      }
+    },
+    cancel(reason) {
+      onCancel?.(reason);
+    },
+  });
+}
+
+const CONTENT = Uint8Array.from({ length: 100 }, (_, i) => i);
+const EXPECTED = CONTENT.subarray(20, 30);
+const RANGE = { start: 20, end: 29 };
+
+describe("sliceBody", () => {
+  it("slices a string by UTF-8 bytes, not characters", async () => {
+    // "é" is 2 bytes in UTF-8, so the bytes 0-1 are "é" and byte 2 is "a".
+    const body = sliceBody("éa", { start: 0, end: 1 });
+    expect(await readAll(body)).toEqual(new Uint8Array([0xc3, 0xa9]));
+  });
+
+  it("slices a Uint8Array view that has a non-zero byteOffset", async () => {
+    const backing = new Uint8Array(120);
+    backing.set(CONTENT, 10);
+    const view = new Uint8Array(backing.buffer, 10, 100);
+    expect(await readAll(sliceBody(view, RANGE))).toEqual(EXPECTED);
+  });
+
+  it("slices a DataView", async () => {
+    const view = new DataView(CONTENT.buffer.slice(0));
+    expect(await readAll(sliceBody(view, RANGE))).toEqual(EXPECTED);
+  });
+
+  it("slices an ArrayBuffer", async () => {
+    expect(await readAll(sliceBody(CONTENT.buffer.slice(0), RANGE))).toEqual(EXPECTED);
+  });
+
+  it("slices a Blob", async () => {
+    expect(await readAll(sliceBody(new Blob([CONTENT]), RANGE))).toEqual(EXPECTED);
+  });
+
+  it("slices a File", async () => {
+    const file = new File([CONTENT], "a.bin");
+    expect(await readAll(sliceBody(file, RANGE))).toEqual(EXPECTED);
+  });
+
+  it("slices a ReadableStream", async () => {
+    const stream = chunkedStream([CONTENT]);
+    expect(await readAll(sliceBody(stream, RANGE))).toEqual(EXPECTED);
+  });
+
+  it.each([null, undefined])("returns undefined for %s", (body) => {
+    expect(sliceBody(body, RANGE)).toBeUndefined();
+  });
+
+  it("returns undefined for FormData", () => {
+    expect(sliceBody(new FormData(), RANGE)).toBeUndefined();
+  });
+});
+
+describe("sliceStream", () => {
+  const CHUNKS = [
+    CONTENT.subarray(0, 7),
+    CONTENT.subarray(7, 8),
+    CONTENT.subarray(8, 25),
+    CONTENT.subarray(25, 60),
+    CONTENT.subarray(60, 100),
+  ];
+
+  it("yields the range when it crosses chunk boundaries", async () => {
+    expect(await readAll(sliceStream(chunkedStream(CHUNKS), 20, 29))).toEqual(EXPECTED);
+  });
+
+  it("yields the range when it sits inside a single chunk", async () => {
+    expect(await readAll(sliceStream(chunkedStream(CHUNKS), 26, 30))).toEqual(
+      CONTENT.subarray(26, 31),
+    );
+  });
+
+  it("yields a range that starts at byte 0 and ends at the last byte", async () => {
+    expect(await readAll(sliceStream(chunkedStream(CHUNKS), 0, 99))).toEqual(CONTENT);
+  });
+
+  it("cancels the source once the range is complete", async () => {
+    const cancel = { reason: undefined as unknown, called: false };
+    const source = chunkedStream(CHUNKS, (reason) => {
+      cancel.called = true;
+      cancel.reason = reason;
+    });
+    await readAll(sliceStream(source, 20, 29));
+    expect(cancel.called).toBe(true);
+  });
+
+  it("forwards cancel(reason) to the source", async () => {
+    const cancel = { reason: undefined as unknown };
+    const source = chunkedStream(CHUNKS, (reason) => {
+      cancel.reason = reason;
+    });
+    const stream = sliceStream(source, 20, 29);
+    await stream.cancel("client gone");
+    expect(cancel.reason).toBe("client gone");
+  });
+});
