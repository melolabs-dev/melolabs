+import { describe, it, expect } from "vitest";
+import { parseRange, resolveByteRange } from "../../src/utils/internal/range.ts";
+
+describe("parseRange", () => {
+  it("parses the three RFC 9110 forms", () => {
+    expect(parseRange("bytes=10-19")).toEqual({ type: "range", start: 10, end: 19 });
+    expect(parseRange("bytes=90-")).toEqual({ type: "range", start: 90 });
+    expect(parseRange("bytes=-10")).toEqual({ type: "suffix", length: 10 });
+  });
+
+  it("tolerates optional whitespace", () => {
+    expect(parseRange("bytes= 10 - 19 ")).toEqual({ type: "range", start: 10, end: 19 });
+  });
+
+  it("accepts the unit case-insensitively", () => {
+    expect(parseRange("BYTES=0-1")).toEqual({ type: "range", start: 0, end: 1 });
+  });
+
+  it.each(["bytes=abc", "bytes=", "bytes=-", "bytes=5-3", "bytes=0-1,3-4", "items=0-1", "garbage"])(
+    "ignores malformed value %s",
+    (value) => {
+      expect(parseRange(value)).toBeUndefined();
+    },
+  );
+});
+
+describe("resolveByteRange", () => {
+  const headers = (init: Record<string, string>) => new Headers(init);
+
+  it("returns undefined without a Range header", () => {
+    expect(resolveByteRange(headers({}), { size: 100 })).toBeUndefined();
+  });
+
+  it.each([undefined, Number.NaN, -1, "100"])("ignores unknown size %s", (size) => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9" }), { size: size as number | undefined }),
+    ).toBeUndefined();
+  });
+
+  it("clamps an end past the file to size - 1", () => {
+    expect(resolveByteRange(headers({ range: "bytes=90-999" }), { size: 100 })).toEqual({
+      start: 90,
+      end: 99,
+      size: 100,
+    });
+  });
+
+  it("clamps a suffix longer than the file to the whole file", () => {
+    expect(resolveByteRange(headers({ range: "bytes=-500" }), { size: 100 })).toEqual({
+      start: 0,
+      end: 99,
+      size: 100,
+    });
+  });
+
+  it("resolves an open-ended range", () => {
+    expect(resolveByteRange(headers({ range: "bytes=90-" }), { size: 100 })).toEqual({
+      start: 90,
+      end: 99,
+      size: 100,
+    });
+  });
+
+  it.each([
+    ["bytes=100-", 100],
+    ["bytes=-0", 100],
+    ["bytes=0-", 0],
+  ])("is unsatisfiable for %s on %i bytes", (range, size) => {
+    expect(resolveByteRange(headers({ range }), { size })).toEqual({
+      unsatisfiable: true,
+      size,
+    });
+  });
+
+  it("accepts a matching strong If-Range ETag", () => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": '"v1"' }), {
+        size: 100,
+        etag: '"v1"',
+      }),
+    ).toEqual({ start: 0, end: 9, size: 100 });
+  });
+
+  it("ignores a non-matching If-Range ETag", () => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": '"v0"' }), {
+        size: 100,
+        etag: '"v1"',
+      }),
+    ).toBeUndefined();
+  });
+
+  it("ignores a weak If-Range ETag", () => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": 'W/"v1"' }), {
+        size: 100,
+        etag: '"v1"',
+      }),
+    ).toBeUndefined();
+  });
+
+  it("ignores If-Range when the asset ETag is weak", () => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": '"v1"' }), {
+        size: 100,
+        etag: 'W/"v1"',
+      }),
+    ).toBeUndefined();
+  });
+
+  it("accepts an If-Range date equal to lastModified", () => {
+    const lastModified = new Date(1_700_000_000_000);
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": lastModified.toUTCString() }), {
+        size: 100,
+        lastModified,
+      }),
+    ).toEqual({ start: 0, end: 9, size: 100 });
+  });
+
+  it("ignores an If-Range date different from lastModified", () => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": new Date(0).toUTCString() }), {
+        size: 100,
+        lastModified: new Date(1_700_000_000_000),
+      }),
+    ).toBeUndefined();
+  });
+
+  it("ignores an invalid If-Range date", () => {
+    expect(
+      resolveByteRange(headers({ range: "bytes=0-9", "if-range": "1" }), {
+        size: 100,
+        lastModified: new Date(1_700_000_000_000),
+      }),
+    ).toBeUndefined();
+  });
+
+  it("ignores If-Range when there is no Range header", () => {
+    expect(
+      resolveByteRange(headers({ "if-range": '"v1"' }), { size: 100, etag: '"v1"' }),
+    ).toBeUndefined();
+  });
+});
