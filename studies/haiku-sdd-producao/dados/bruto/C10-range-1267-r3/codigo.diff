@@ -0,0 +1,169 @@
+/** Inclusive byte range within the representation, already clamped to its size. */
+export interface ByteRange {
+  start: number;
+  end: number;
+  /** Total size of the representation (the `size` from `getMeta`). */
+  size: number;
+}
+
+/** A satisfiable range or a range that cannot be met (`416`). */
+export type ByteRangeResult = ByteRange | { unsatisfiable: true; size: number };
+
+/**
+ * Parsed `Range` header. A suffix form (`bytes=-n`) has no start.
+ */
+export type RangeSpec =
+  | { type: "suffix"; length: number }
+  | { type: "range"; start: number; end?: number };
+
+const RANGE_RE = /^\s*bytes\s*=\s*(\d*)\s*-\s*(\d*)\s*$/i;
+
+/**
+ * Resolve the `Range` request header against the asset's validators.
+ *
+ * Returns `undefined` when the range must be ignored: no `Range` header, malformed or
+ * multi-range syntax, an unknown unit, a non-finite `size`, or an `If-Range` that does not match.
+ */
+export function resolveByteRange(
+  headers: Headers,
+  validators: { size: number | undefined; etag?: string; lastModified?: Date },
+): ByteRangeResult | undefined {
+  const raw = headers.get("range");
+  if (raw === null) {
+    return undefined;
+  }
+  const { size } = validators;
+  if (typeof size !== "number" || !Number.isFinite(size) || size < 0) {
+    return undefined;
+  }
+  if (!ifRangeMatches(headers.get("if-range"), validators)) {
+    return undefined;
+  }
+  const spec = parseRange(raw);
+  if (!spec) {
+    return undefined;
+  }
+
+  if (spec.type === "suffix") {
+    if (spec.length === 0 || size === 0) {
+      return { unsatisfiable: true, size };
+    }
+    return { start: Math.max(size - spec.length, 0), end: size - 1, size };
+  }
+
+  if (spec.start >= size) {
+    return { unsatisfiable: true, size };
+  }
+  const end = spec.end === undefined || spec.end >= size ? size - 1 : spec.end;
+  return { start: spec.start, end, size };
+}
+
+/** Parse a `Range` header value. Returns `undefined` for anything that is not one `bytes` range. */
+export function parseRange(value: string): RangeSpec | undefined {
+  const match = RANGE_RE.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined; // `bytes=-`
+  }
+  if (first === "") {
+    return { type: "suffix", length: Number(last) };
+  }
+  const start = Number(first);
+  if (last === "") {
+    return { type: "range", start };
+  }
+  const end = Number(last);
+  return end < start ? undefined : { type: "range", start, end }; // `bytes=5-3`
+}
+
+/**
+ * Slice a `BodyInit` returned by `getContents` to the inclusive range.
+ * Returns `undefined` when the body type cannot be sliced, so the caller responds `200`.
+ */
+export function sliceBody(
+  body: BodyInit | null | undefined,
+  range: Pick<ByteRange, "start" | "end">,
+): BodyInit | undefined {
+  if (!body) {
+    return undefined;
+  }
+  const { start, end } = range;
+  if (typeof body === "string") {
+    // Sizes are in bytes, so slice the UTF-8 encoding rather than the characters.
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(start, end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset + start, end - start + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end);
+  }
+  return undefined;
+}
+
+/**
+ * Fresh stream that yields only bytes `start..end` (inclusive) of `source`.
+ *
+ * Chunks must be `Uint8Array`, the form `BodyInit` produces for bytes. The source is
+ * cancelled as soon as the range is complete, so the rest of the asset is never read.
+ */
+export function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  // Absolute offset of the first byte of the next chunk.
+  let offset = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunkStart = offset;
+        offset += value.byteLength;
+        if (offset <= start) {
+          continue;
+        }
+        const from = Math.max(start - chunkStart, 0);
+        const to = Math.min(end + 1 - chunkStart, value.byteLength);
+        controller.enqueue(value.subarray(from, to));
+        if (offset > end) {
+          controller.close();
+          await reader.cancel();
+        }
+        return;
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
+
+function ifRangeMatches(
+  value: string | null,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (value === null) {
+    return true;
+  }
+  const { etag, lastModified } = validators;
+  if (value.startsWith('"')) {
+    // Strong comparison on both sides (RFC 9110 section 13.1.5).
+    return !!etag && !etag.startsWith("W/") && value === etag;
+  }
+  return !!lastModified && new Date(value).getTime() === lastModified.getTime();
+}
