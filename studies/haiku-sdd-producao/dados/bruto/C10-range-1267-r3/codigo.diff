diff --git a/test/static-range-body.test.ts b/test/static-range-body.test.ts
new file mode 100644
index 0000000..4a1ef6d
--- /dev/null
+++ b/test/static-range-body.test.ts
@@ -0,0 +1,156 @@
+import { beforeEach } from "vitest";
+import { serveStatic, type ServeStaticOptions, type StaticAssetMeta } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const CONTENT = "abcdefghijklmnopqrstuvwxyz".repeat(4).slice(0, 100);
+const GZ_CONTENT = "0123456789".repeat(4);
+
+describeMatrix("serve static range with encodings", (t, { it, expect }) => {
+  let overrides: Partial<ServeStaticOptions> = {};
+
+  beforeEach(() => {
+    overrides = {};
+    t.app.all("/**", (event) => {
+      return serveStatic(event, {
+        encodings: { gzip: ".gz" },
+        getMeta: (id) => {
+          if (id === "/app.js.gz") {
+            return { encoding: "gzip", size: GZ_CONTENT.length };
+          }
+          return id === "/app.js" ? { size: CONTENT.length } : undefined;
+        },
+        getContents: (id) => (id === "/app.js.gz" ? GZ_CONTENT : CONTENT),
+        ...overrides,
+      });
+    });
+  });
+
+  it("applies the range to the precompressed variant that is served", async () => {
+    const res = await t.fetch("/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/40");
+    expect(res.headers.get("content-length")).toBe("10");
+    // Node's fetch decodes `content-encoding: gzip` and this fixture is not real gzip,
+    // so the raw bytes are only readable on the web target.
+    if (t.target === "node") {
+      await res.body?.cancel();
+      return;
+    }
+    expect(await res.text()).toBe(GZ_CONTENT.slice(0, 10));
+  });
+});
+
+describeMatrix("serve static range with unknown size", (t, { it, expect }) => {
+  let meta: StaticAssetMeta = {};
+
+  beforeEach(() => {
+    meta = {};
+    t.app.all("/**", (event) => {
+      return serveStatic(event, {
+        getMeta: () => meta,
+        getContents: () => CONTENT,
+      });
+    });
+  });
+
+  it("ignores Range when getMeta has no size", async () => {
+    meta = { etag: '"v1"' };
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(CONTENT);
+  });
+
+  it("ignores Range when size is not a number", async () => {
+    meta = { size: "100" as unknown as number };
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(CONTENT);
+  });
+});
+
+describeMatrix("serve static range with body types", (t, { it, expect }) => {
+  let getContents: () => BodyInit = () => CONTENT;
+
+  beforeEach(() => {
+    getContents = () => CONTENT;
+    t.app.all("/**", (event) => {
+      return serveStatic(event, {
+        getMeta: () => ({ size: CONTENT.length }),
+        getContents: () => getContents(),
+      });
+    });
+  });
+
+  // Irregular chunks, with bytes 20-29 crossing the boundary between chunks.
+  const chunkedStream = () => {
+    const chunks = [
+      CONTENT.slice(0, 7),
+      CONTENT.slice(7, 22),
+      CONTENT.slice(22, 26),
+      CONTENT.slice(26),
+    ].map((chunk) => new TextEncoder().encode(chunk));
+    let index = 0;
+    return new ReadableStream<Uint8Array>({
+      pull(controller) {
+        if (index < chunks.length) {
+          controller.enqueue(chunks[index++]);
+        } else {
+          controller.close();
+        }
+      },
+    });
+  };
+
+  const bodies: Record<string, () => BodyInit> = {
+    string: () => CONTENT,
+    Uint8Array: () => new TextEncoder().encode(CONTENT),
+    ArrayBuffer: () => new TextEncoder().encode(CONTENT).buffer as ArrayBuffer,
+    Blob: () => new Blob([CONTENT]),
+    ReadableStream: chunkedStream,
+  };
+
+  for (const [name, body] of Object.entries(bodies)) {
+    it(`slices a ${name} body`, async () => {
+      getContents = body;
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=20-29" } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe("bytes 20-29/100");
+      expect(await res.text()).toBe(CONTENT.slice(20, 30));
+    });
+  }
+
+  it("responds 200 with the full body for an unsupported body type", async () => {
+    getContents = () => {
+      const form = new FormData();
+      form.set("a", "b");
+      return form;
+    };
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toContain('name="a"');
+  });
+});
+
+describeMatrix("serve static range with app content-length", (t, { it, expect }) => {
+  beforeEach(() => {
+    t.app.all("/**", (event) => {
+      return serveStatic(event, {
+        headers: { "content-length": "999" },
+        getMeta: () => ({ size: CONTENT.length }),
+        getContents: () => CONTENT,
+      });
+    });
+  });
+
+  it("replaces an app content-length with the length of the range", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("10");
+  });
+});
