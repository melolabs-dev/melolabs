+/**
+ * Unseal with one password: full iterations first, then the 1-iteration legacy
+ * retry when allowed. Throws the last error.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean | undefined,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !isBadHmac(error)
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+/**
+ * Tries each password in order. Returns the session and whether a password
+ * other than the first one opened it.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacySealFallback: boolean | undefined,
+): Promise<{ unsealed: Partial<Session>; extra: boolean }> {
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await unsealWithPassword(sealed, password, sealOptions, legacySealFallback);
+      return { unsealed, extra: index > 0 };
+    } catch (error) {
+      if (index === passwords.length - 1 || !isBadHmac(error)) {
+        throw error;
+      }
+    }
+  }
+  // Unreachable: `passwords` always has at least `config.password`
+  throw new Error("No password to unseal with");
+}
+
+/** Only `"Bad hmac value"` means "wrong password, try the next one". */
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+/**
+ * Throws if `extraUnsealPasswords` has an entry the seal would not accept.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig): void {
+  const extras = config.extraUnsealPasswords;
+  if (extras === undefined) {
+    return;
+  }
+  if (!Array.isArray(extras)) {
+    throw new Error("Invalid session config: `extraUnsealPasswords` must be an array of strings.");
+  }
+  const sealOptions = config.seal ?? sealDefaults;
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const [index, password] of extras.entries()) {
+    if (typeof password !== "string" || password.length < minLength) {
+      throw new Error(
+        `Invalid session config: \`extraUnsealPasswords[${index}]\` must be a string of at least ${minLength} characters.`,
+      );
+    }
+  }
+}
