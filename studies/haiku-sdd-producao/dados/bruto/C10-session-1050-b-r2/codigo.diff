+/** Iron options for `config`, shared by sealing and unsealing. */
+function resolveSealOptions(config: SessionConfig): SealOptions {
+  return {
+    ...sealDefaults,
+    ttl: (config.maxAge || config.idleTimeout || 0) * 1000,
+    ...config.seal,
+  };
+}
+
+/** Throws if an extra unseal password is shorter than the seal minimum. */
+function assertExtraUnsealPasswords(config: SessionConfig): void {
+  if (!config.extraUnsealPasswords?.length) {
+    return;
+  }
+  const { encryption, integrity } = resolveSealOptions(config);
+  const minLength = Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+  for (const [index, password] of config.extraUnsealPasswords.entries()) {
+    if (password.length < minLength) {
+      throw new Error(`extraUnsealPasswords[${index}] must be at least ${minLength} characters`);
+    }
+  }
+}
+
+/** One unseal attempt with `password`, including the legacy 1-iteration fallback. */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  config: SessionConfig,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
