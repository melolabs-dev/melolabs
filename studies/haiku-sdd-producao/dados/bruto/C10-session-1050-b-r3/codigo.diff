+
+/**
+ * Throw if an extra unseal password is not a string as long as the seal requires
+ * for passwords. Unlike `password`, these are validated, so a bad entry is not
+ * silently ignored by `getSession`.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig): void {
+  const { encryption, integrity } = { ...sealDefaults, ...config.seal };
+  const minLength = Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+  for (const [index, password] of (config.extraUnsealPasswords || []).entries()) {
+    if (typeof password !== "string" || password.length < minLength) {
+      throw new Error(`extraUnsealPasswords[${index}] must be at least ${minLength} characters`);
+    }
+  }
+}
+
+/**
+ * Try each password in order and return the first that opens `sealed`. Only a
+ * bad HMAC means the key is wrong, so any other error is thrown at once. If no
+ * password opens it, throw the error from the first one.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  let firstError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await unsealWithPassword(sealed, password, sealOptions, legacySealFallback);
+      if (index > 0 && unsealed) {
+        (unsealed as any)[kExtraSeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      firstError ??= error;
+      if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+        throw error;
+      }
+    }
+  }
+  throw firstError;
+}
+
+/**
+ * Open `sealed` with one password, trying the current seal first and the legacy
+ * 1-iteration seal second when `legacySealFallback` allows it.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  let unsealed: Partial<Session>;
+  try {
+    unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      !legacySealFallback ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+  }
+  return unsealed;
+}
