+/**
+ * Slice the body for a 206. A `Blob` (or `File`) is sliced lazily; other body
+ * types are buffered first, so a `ReadableStream` is read in full.
+ */
+async function sliceContents(
+  contents: BodyInit | null | undefined,
+  range: ByteRange,
+): Promise<Blob> {
+  const blob = contents instanceof Blob ? contents : await new Response(contents).blob();
+  return blob.slice(range.start, range.end + 1);
