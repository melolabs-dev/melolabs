@@ -0,0 +1,94 @@
+import { describe, expect, it } from "vitest";
+import { getByteRange } from "../../src/utils/internal/range.ts";
+
+const MODIFIED = new Date(1_700_000_000_000).toUTCString();
+
+describe("getByteRange: Range grammar (RFC 9110 section 14.1.1)", () => {
+  it.each([
+    ["bytes=0-499", 1000, { start: 0, end: 499 }],
+    ["bytes=999-999", 1000, { start: 999, end: 999 }],
+    ["bytes=0-5000", 1000, { start: 0, end: 999 }],
+    ["bytes=900-", 1000, { start: 900, end: 999 }],
+    ["bytes=-200", 1000, { start: 800, end: 999 }],
+    ["bytes=-5000", 1000, { start: 0, end: 999 }],
+    ["BYTES=0-499", 1000, { start: 0, end: 499 }],
+    ["bytes=1000-1200", 1000, "unsatisfiable"],
+    ["bytes=1000-", 1000, "unsatisfiable"],
+    ["bytes=-0", 1000, "unsatisfiable"],
+    ["bytes=0-0", 0, "unsatisfiable"],
+    ["bytes=-5", 0, "unsatisfiable"],
+    ["bytes=5-2", 1000, undefined],
+    ["bytes=-", 1000, undefined],
+    ["bytes=0-1,5-9", 1000, undefined],
+    ["items=0-4", 1000, undefined],
+    ["bytes=abc", 1000, undefined],
+    ["bytes= 0-499", 1000, undefined],
+    ["bytes=0- 499", 1000, undefined],
+  ])("%s with size %s", (range, size, expected) => {
+    expect(getByteRange(new Headers({ range }), size, {})).toEqual(expected);
+  });
+
+  it.each([undefined, -1, Number.NaN, Number.POSITIVE_INFINITY])(
+    "ignores the range when size is %s",
+    (size) => {
+      expect(getByteRange(new Headers({ range: "bytes=0-499" }), size, {})).toBeUndefined();
+    },
+  );
+
+  it("ignores the request when Range is absent", () => {
+    expect(getByteRange(new Headers(), 1000, {})).toBeUndefined();
+  });
+});
+
+describe("getByteRange: If-Range (RFC 9110 section 13.1.5)", () => {
+  const range = "bytes=0-499";
+
+  it("matches an identical strong entity-tag", () => {
+    const headers = new Headers({ range, "if-range": '"abc"' });
+    expect(getByteRange(headers, 1000, { etag: '"abc"' })).toEqual({ start: 0, end: 499 });
+  });
+
+  it.each([
+    ['"xyz"', '"abc"'],
+    ['"abc"', 'W/"abc"'],
+    ['W/"abc"', '"abc"'],
+    ['W/"abc"', 'W/"abc"'],
+    ['"abc"', undefined],
+  ])("ignores If-Range %s when the validator is %s", (ifRange, etag) => {
+    const headers = new Headers({ range, "if-range": ifRange });
+    expect(getByteRange(headers, 1000, { etag })).toBeUndefined();
+  });
+
+  it("matches an identical HTTP date", () => {
+    const headers = new Headers({ range, "if-range": MODIFIED });
+    expect(getByteRange(headers, 1000, { lastModified: MODIFIED })).toEqual({
+      start: 0,
+      end: 499,
+    });
+  });
+
+  it("matches the same date written in another valid format", () => {
+    const headers = new Headers({ range, "if-range": "2023-11-14T22:13:20Z" });
+    expect(getByteRange(headers, 1000, { lastModified: MODIFIED })).toEqual({
+      start: 0,
+      end: 499,
+    });
+  });
+
+  it("ignores a different HTTP date", () => {
+    const headers = new Headers({
+      range,
+      "if-range": new Date(1_700_000_000_000 - 1000).toUTCString(),
+    });
+    expect(getByteRange(headers, 1000, { lastModified: MODIFIED })).toBeUndefined();
+  });
+
+  it.each([
+    ["not a date", MODIFIED],
+    [MODIFIED, undefined],
+    ["not a date", "not a date"],
+  ])("ignores If-Range %s when the date validator is %s", (ifRange, lastModified) => {
+    const headers = new Headers({ range, "if-range": ifRange });
+    expect(getByteRange(headers, 1000, { lastModified })).toBeUndefined();
+  });
+});
