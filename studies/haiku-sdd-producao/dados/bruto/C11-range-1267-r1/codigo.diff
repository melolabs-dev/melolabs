+/** A satisfiable byte range, inclusive at both ends. */
+export interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/**
+ * Evaluate a single-range `Range` header and its `If-Range` precondition
+ * (RFC 9110 sections 13.1.5 and 14) for a representation of `size` bytes.
+ *
+ * - `undefined`: the range does not apply (no `Range`, unknown `size`, `If-Range`
+ *   that does not match, or a malformed, multi-range or non-`bytes` spec). The
+ *   caller responds with the full representation.
+ * - `"unsatisfiable"`: a valid range that covers no byte, including any range
+ *   on an empty representation.
+ * - `ByteRange`: a satisfiable range, already limited to `size - 1`.
+ */
+export function getByteRange(
+  headers: Headers,
+  size: number | undefined,
+  validators: { etag?: string; lastModified?: string },
+): ByteRange | "unsatisfiable" | undefined {
+  const range = headers.get("range");
+  if (!range || size === undefined || !Number.isFinite(size) || size < 0) {
+    return undefined;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchIfRange(ifRange, validators)) {
+    return undefined;
+  }
+  return parseRangeSpec(range, size);
+}
+
+function parseRangeSpec(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = /^bytes=(\d*)-(\d*)$/i.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+
+  if (first === "") {
+    // Suffix range: the last `n` bytes.
+    const n = Number(last);
+    if (n === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - n), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { start, end };
+}
+
+/**
+ * An `If-Range` entity-tag matches only under the strong comparison: both sides
+ * must be strong and identical. An HTTP date matches when it parses to the same
+ * instant as `last-modified`. Anything else does not match.
+ */
+function matchIfRange(ifRange: string, validators: { etag?: string; lastModified?: string }) {
+  if (ifRange.startsWith('"') || ifRange.startsWith('W/"')) {
+    const etag = validators.etag;
+    return !!etag && !ifRange.startsWith("W/") && !etag.startsWith("W/") && ifRange === etag;
+  }
+  const date = Date.parse(ifRange);
+  return !Number.isNaN(date) && date === Date.parse(validators.lastModified ?? "");
+}
