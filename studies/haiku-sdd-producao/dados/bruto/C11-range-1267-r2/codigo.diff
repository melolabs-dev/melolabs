+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-3" } });
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-range")).toBeNull();
+    });
+  });
+
+  describe("options and fallthrough", () => {
+    it("ignores Range for POST and falls through without Accept-Ranges", async () => {
+      options.fallthrough = true;
+      const res = await t.fetch("/file.txt", {
+        method: "POST",
+        headers: { range: "bytes=0-3" },
+      });
+      expect(res.status).toBe(200);
+      expect(await res.text()).toBe("fell through");
+      expect(res.headers.get("accept-ranges")).toBeNull();
+    });
+
+    it("ignores Range when the user disables Accept-Ranges", async () => {
+      options.headers = { "accept-ranges": "none" };
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=2-5" } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("none");
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await readText(res)).toBe("0123456789");
+    });
+
+    it("uses the range length over a user content-length", async () => {
+      options.headers = { "content-length": "999" };
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=2-5" } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-length")).toBe("4");
+      expect(await readText(res)).toBe("2345");
+    });
+  });
+});
