+import { beforeEach, describe } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const mtime = 1_700_000_000_000;
+const lastModified = new Date(mtime).toUTCString();
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let options: ServeStaticOptions;
+
+  beforeEach(() => {
+    options = {
+      getMeta: () => ({ type: "text/plain", etag: '"abc"', mtime, size: 10 }),
+      getContents: () => "0123456789",
+    };
+    t.app.all("/**", async (event) => (await serveStatic(event, options)) ?? "fell through");
+  });
+
+  async function readBody(res: Response): Promise<Uint8Array> {
+    const body = new Uint8Array(await res.arrayBuffer());
+    // The declared length must match the bytes actually sent (RF-13).
+    if (res.headers.has("content-length")) {
+      expect(res.headers.get("content-length")).toBe(String(body.byteLength));
+    }
+    return body;
+  }
+
+  function readText(res: Response): Promise<string> {
+    return readBody(res).then((body) => new TextDecoder().decode(body));
+  }
+
+  describe("without Range", () => {
+    it("serves the full asset and announces Accept-Ranges", async () => {
+      const res = await t.fetch("/file.txt");
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await readText(res)).toBe("0123456789");
+    });
+
+    it("announces Accept-Ranges on HEAD without a body", async () => {
+      const res = await t.fetch("/file.txt", { method: "HEAD" });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(await res.text()).toBe("");
+    });
+
+    it("ignores Range and omits Accept-Ranges when size is unknown", async () => {
+      options.getMeta = () => ({ type: "text/plain", etag: '"abc"', mtime });
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-3" } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBeNull();
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await readText(res)).toBe("0123456789");
+    });
+
+    it("ignores Range and omits Accept-Ranges when size is 0", async () => {
+      options.getMeta = () => ({ type: "text/plain", etag: '"abc"', mtime, size: 0 });
+      options.getContents = () => "";
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-" } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBeNull();
+      expect(res.headers.get("content-range")).toBeNull();
+    });
+  });
+
+  describe("GET with a satisfiable range", () => {
+    it("responds 206 with the requested bytes", async () => {
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=2-5" } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+      expect(res.headers.get("content-length")).toBe("4");
+      expect(await readText(res)).toBe("2345");
+    });
+
+    it("supports open-ended ranges", async () => {
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=7-" } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe("bytes 7-9/10");
+      expect(res.headers.get("content-length")).toBe("3");
+      expect(await readText(res)).toBe("789");
+    });
+
+    it("supports suffix ranges larger than the asset", async () => {
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=-100" } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe("bytes 0-9/10");
+      expect(res.headers.get("content-length")).toBe("10");
+      expect(await readText(res)).toBe("0123456789");
+    });
+
+    it("clamps an end past the last byte", async () => {
+      const res = await t.fetch("/file.txt", { headers: { range: "bytes=8-50" } });
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe("bytes 8-9/10");
+      expect(await readText(res)).toBe("89");
+    });
+  });
+
+  describe("HEAD with a satisfiable range", () => {
+    it("responds 206 with the same headers and no body", async () => {
+      const res = await t.fetch("/file.txt", {
+        method: "HEAD",
+        headers: { range: "bytes=2-5" },
+      });
+      expect(res.status).toBe(206);
