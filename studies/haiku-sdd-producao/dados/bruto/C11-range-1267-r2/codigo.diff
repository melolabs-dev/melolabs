+import { HTTPError } from "../../error.ts";
+import { textEncoder } from "./encoding.ts";
+
+/** Inclusive byte range. */
+export interface ByteSpan {
+  start: number;
+  end: number;
+}
+
+/** Result of {@link parseRange}. `undefined` from `parseRange` means "ignore Range and respond 200". */
+export type RangeRequest = { type: "partial"; span: ByteSpan } | { type: "unsatisfiable" };
+
+/**
+ * Parse a single `bytes` range for a representation of `size` bytes (`size > 0`).
+ *
+ * Returns `undefined` for another unit, a malformed header and multi-range requests,
+ * which RFC 9110 section 14.2 allows a server to ignore.
+ */
+export function parseRange(header: string, size: number): RangeRequest | undefined {
+  const match = /^bytes=(\d*)-(\d*)$/i.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+
+  if (first === "") {
+    const suffix = Number(last);
+    if (!Number.isSafeInteger(suffix)) {
+      return undefined;
+    }
+    // A zero-length suffix selects nothing (RFC 9110 section 14.1.1).
+    if (suffix === 0) {
+      return { type: "unsatisfiable" };
+    }
+    return { type: "partial", span: { start: Math.max(0, size - suffix), end: size - 1 } };
+  }
+
+  const start = Number(first);
+  const end = last === "" ? size - 1 : Number(last);
+  if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start > end) {
+    return undefined;
+  }
+  if (start >= size) {
+    return { type: "unsatisfiable" };
+  }
+  return { type: "partial", span: { start, end: Math.min(end, size - 1) } };
+}
+
+/**
+ * Evaluate `If-Range` with the strong comparison of RFC 9110 section 13.1.5.
+ *
+ * Returns `true` when the range may be served. A weak ETag never matches, and a
+ * date matches only when it equals `lastModified` exactly.
+ */
+export function matchIfRange(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange.startsWith("W/")) {
+    return false;
+  }
+  if (ifRange.startsWith('"')) {
+    const { etag } = validators;
+    return etag !== undefined && !etag.startsWith("W/") && etag === ifRange;
+  }
+  const { lastModified } = validators;
+  const date = Date.parse(ifRange);
+  return lastModified !== undefined && !Number.isNaN(date) && date === lastModified.getTime();
+}
+
+/**
+ * Cut `body` down to `span`. `size` is the length `getMeta` declared for it.
+ *
+ * Synchronous bodies are sliced without copying the whole content, and a length
+ * that disagrees with `size` throws a 500 before any range header is sent. Streams
+ * are read and discarded up to `span.start`. Returns `undefined` for body types
+ * that cannot be sliced (e.g. `FormData`).
+ */
+export async function sliceBody(
+  body: BodyInit,
+  span: ByteSpan,
+  size: number,
+): Promise<BodyInit | undefined> {
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, span);
+  }
+
+  let bytes: Uint8Array | Blob;
+  if (typeof body === "string") {
+    bytes = textEncoder.encode(body);
+  } else if (body instanceof ArrayBuffer) {
+    bytes = new Uint8Array(body);
+  } else if (ArrayBuffer.isView(body)) {
+    bytes = new Uint8Array(body.buffer, body.byteOffset, body.byteLength);
+  } else if (body instanceof Blob) {
+    bytes = body;
+  } else if (body instanceof URLSearchParams) {
+    bytes = textEncoder.encode(body.toString());
+  } else {
+    return undefined;
+  }
+
+  const actualSize = bytes instanceof Blob ? bytes.size : bytes.byteLength;
+  if (actualSize !== size) {
+    throw new HTTPError({ status: 500 });
+  }
+  return bytes instanceof Blob
+    ? bytes.slice(span.start, span.end + 1)
+    : bytes.slice(span.start, span.end + 1);
+}
+
+/** Emit only the bytes of `span` from `stream`, cancelling the source once they are sent. */
+function sliceStream(stream: ReadableStream, span: ByteSpan): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  // Bytes consumed from the source so far.
+  let offset = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          // The source ended before `span.end`: the declared length cannot be met.
+          controller.error(new Error("Static asset is shorter than its declared size"));
+          return;
+        }
+        if (!(value instanceof Uint8Array)) {
+          const error = new TypeError("Static asset chunks must be Uint8Array");
+          controller.error(error);
+          await reader.cancel(error);
+          return;
+        }
+
+        const chunkStart = offset;
+        const chunkEnd = offset + value.byteLength;
+        offset = chunkEnd;
+        if (chunkEnd <= span.start) {
+          continue;
+        }
+
+        const from = Math.max(0, span.start - chunkStart);
+        const to = Math.min(value.byteLength, span.end + 1 - chunkStart);
+        controller.enqueue(value.subarray(from, to));
+        if (span.end + 1 <= chunkEnd) {
+          await reader.cancel();
+          controller.close();
+        }
+        return;
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
