+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+type RangeResult =
+  | { kind: "ignore" }
+  | { kind: "unsatisfiable" }
+  | { kind: "partial"; start: number; end: number };
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/** Decide how to answer a request for `size` bytes, honoring `If-Range` (RFC 9110 sections 13.1.5 and 14.2). */
+function resolveRange(
+  headers: Headers,
+  size: number,
+  validators: { etag?: string; lastModified?: Date },
+): RangeResult {
+  const range = headers.get("range");
+  if (!range) {
+    return { kind: "ignore" };
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, validators)) {
+    return { kind: "ignore" };
+  }
+  return parseRange(range, size);
+}
+
+/** Parse a single `bytes` range. Anything that is not exactly one satisfiable-or-not range is ignored. */
+function parseRange(value: string, size: number): RangeResult {
+  const match = RANGE_RE.exec(value);
+  if (!match) {
+    return { kind: "ignore" };
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return { kind: "ignore" };
+  }
+  if (!first) {
+    // Suffix range: the last `n` bytes, or the whole asset when `n` is larger.
+    const n = Number(last);
+    if (n === 0) {
+      return { kind: "unsatisfiable" };
+    }
+    return { kind: "partial", start: Math.max(size - n, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last && Number(last) < start) {
+    return { kind: "ignore" };
+  }
+  if (start >= size) {
+    return { kind: "unsatisfiable" };
+  }
+  const end = last ? Math.min(Number(last), size - 1) : size - 1;
+  return { kind: "partial", start, end };
+}
+
+/** Strong ETag equality or exact date equality with `Last-Modified`. Weak ETags never match. */
+function ifRangeMatches(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  const { etag, lastModified } = validators;
+  if (etag && !etag.startsWith("W/") && ifRange === etag) {
+    return true;
+  }
+  return lastModified !== undefined && Date.parse(ifRange) === lastModified.getTime();
+}
+
+/** Slice `contents` to `range`. `Blob`s are sliced lazily; other bodies are streamed and cut in flight. */
+function sliceBody(contents: BodyInit, range: ByteRange): BodyInit {
+  if (contents instanceof Blob) {
+    return contents.slice(range.start, range.end + 1);
+  }
+  let offset = 0;
+  return new Response(contents).body!.pipeThrough(
+    new TransformStream<Uint8Array, Uint8Array>({
+      transform(chunk, controller) {
+        const from = Math.max(range.start - offset, 0);
+        const to = Math.min(range.end + 1 - offset, chunk.byteLength);
+        if (from < to) {
+          controller.enqueue(chunk.subarray(from, to));
+        }
+        offset += chunk.byteLength;
+        // Terminating errors the writable side, which makes `pipeThrough` cancel the source.
+        if (offset > range.end) {
+          controller.terminate();
+        }
+      },
+    }),
+  );
+}
