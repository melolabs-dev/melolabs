+/**
+ * Resolve the seal options for a config, with the session lifetime as the
+ * seal `ttl`. Shared by sealing, unsealing and extra password validation so
+ * they all agree on `seal` overrides.
+ */
+function resolveSealOptions(config: SessionConfig): SealOptions {
+  return {
+    ...sealDefaults,
+    ttl: (config.maxAge || config.idleTimeout || 0) * 1000,
+    ...config.seal,
+  };
+}
+
+/**
+ * Reject malformed `extraUnsealPasswords` entries with the same minimum length
+ * the seal enforces for `password`.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig, sealOptions: SealOptions): void {
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const [index, password] of (config.extraUnsealPasswords ?? []).entries()) {
+    if (typeof password !== "string" || password.length < minLength) {
+      throw new Error(
+        `Invalid extraUnsealPasswords[${index}]: each password must be a string of at least ${minLength} characters`,
+      );
+    }
+  }
+}
+
+/**
+ * Try each password in order and return the first that opens the seal. Only a
+ * wrong password (`Bad hmac value`) moves on to the next; any other error means
+ * the seal itself is bad, so it is thrown without spending more PBKDF2 work.
+ * When every password fails, the first error is thrown.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  let firstError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await unsealWithFallback(sealed, password, sealOptions, legacySealFallback);
+      // Opened by an extra password: getSession reseals it with `password`
+      if (index > 0 && unsealed) {
+        (unsealed as any)[kRotatedSeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      firstError ??= error;
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+    }
+  }
+  throw firstError;
+}
+
+/**
+ * Unseal with one password, retrying with the legacy 1 PBKDF2 iteration when
+ * the full count fails HMAC verification.
+ */
+async function unsealWithFallback(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (!legacySealFallback || sealOptions.integrity.iterations === 1 || !isBadHmac(error)) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
