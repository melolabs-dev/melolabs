@@ -0,0 +1,293 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { afterEach, vi } from "vitest";
+import { getSession, updateSession, useSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Passwords must be at least 32 characters long (see RF-07)
+const pw = (name: string) => name.padEnd(49, "x");
+const OLD_PASSWORD = pw("senha-antiga");
+const NEW_PASSWORD = pw("senha-nova");
+const UNKNOWN_PASSWORD = pw("senha-desconhecida");
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+function sessionWith(overrides: Record<string, unknown> = {}) {
+  return { id: "old-1", createdAt: Date.now(), data: { user: "ana" }, ...overrides };
+}
+
+function cookieValue(setCookie: string) {
+  return decodeURIComponent(setCookie.match(/h3-test=([^;]+)/)![1]);
+}
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+describeMatrix("session extra unseal passwords", (t, { it, expect }) => {
+  let idCtr = 0;
+  const config = (overrides: Partial<SessionConfig> = {}): SessionConfig => ({
+    name: "h3-test",
+    password: NEW_PASSWORD,
+    generateId: () => `new-${++idCtr}`,
+    ...overrides,
+  });
+
+  // Route that reads the session with the given config
+  const readRoute = (path: string, cfg: SessionConfig) => {
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data, lastSeenAt: session.lastSeenAt };
+    });
+  };
+
+  // Route that reports the validation error instead of throwing
+  const validateRoute = (path: string, cfg: SessionConfig) => {
+    t.app.get(path, async (event) => {
+      try {
+        await getSession(event, cfg);
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+  };
+
+  // --- RF-01, RF-02, RF-03, RF-04 ---
+
+  it("opens a session sealed with a previous password", async () => {
+    readRoute("/read", config({ extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, sealDefaults);
+
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { user: "ana" } });
+  });
+
+  it("seals with the current password only", async () => {
+    t.app.get("/write", async (event) => {
+      await updateSession(event, config({ extraUnsealPasswords: [OLD_PASSWORD] }), {
+        user: "ana",
+      });
+      return "ok";
+    });
+
+    const res = await t.fetch("/write");
+    const value = cookieValue(res.headers.getSetCookie()[0]);
+    expect(await unseal(value, NEW_PASSWORD, sealDefaults)).toMatchObject({
+      data: { user: "ana" },
+    });
+    await expect(unseal(value, OLD_PASSWORD, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("treats a session sealed with an unknown password as new", async () => {
+    readRoute("/read", config({ extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), UNKNOWN_PASSWORD, sealDefaults);
+
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-test=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("old-1");
+    expect(body.data).toEqual({});
+  });
+
+  // --- RF-05, ordering and D-05 ---
+
+  it("behaves the same with no extras and with an empty list", async () => {
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, sealDefaults);
+    readRoute("/no-extras", config());
+    readRoute("/empty-extras", config({ extraUnsealPasswords: [] }));
+
+    for (const path of ["/no-extras", "/empty-extras"]) {
+      const res = await t.fetch(path, { headers: { Cookie: `h3-test=${sealed}` } });
+      const body = await res.json();
+      expect(body.id).not.toBe("old-1");
+      expect(body.data).toEqual({});
+    }
+  });
+
+  it("tries extras in array order", async () => {
+    readRoute("/order", config({ extraUnsealPasswords: [pw("senha-1"), OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, sealDefaults);
+
+    const res = await t.fetch("/order", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { user: "ana" } });
+  });
+
+  it("does not derive extras when the current password opens the session", async () => {
+    readRoute("/current", config({ extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), NEW_PASSWORD, sealDefaults);
+
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    const res = await t.fetch("/current", { headers: { Cookie: `h3-test=${sealed}` } });
+    // Two derivations (integrity and encryption) for the single unseal that succeeds
+    expect(deriveBits).toHaveBeenCalledTimes(2);
+    expect(await res.json()).toMatchObject({ id: "old-1" });
+    deriveBits.mockRestore();
+  });
+
+  it("does not try extras after a non-HMAC error from the current password", async () => {
+    // A current password shorter than the seal minimum fails with "Password string too short"
+    readRoute("/short", config({ password: "curta", extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, sealDefaults);
+
+    const res = await t.fetch("/short", { headers: { Cookie: `h3-test=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("old-1");
+    expect(body.data).toEqual({});
+  });
+
+  // --- RF-07, validation ---
+
+  it("rejects an empty extra password", async () => {
+    validateRoute("/invalid-empty", config({ extraUnsealPasswords: [""] }));
+
+    const res = await t.fetch("/invalid-empty");
+    expect((await res.json()).error).toContain("extraUnsealPasswords");
+  });
+
+  it("rejects an extra password shorter than the seal minimum", async () => {
+    validateRoute("/invalid-short", config({ extraUnsealPasswords: ["0123456789"] }));
+
+    const res = await t.fetch("/invalid-short");
+    expect((await res.json()).error).toContain("extraUnsealPasswords");
+  });
+
+  it("rejects an invalid extra password in useSession", async () => {
+    t.app.get("/use-invalid", async (event) => {
+      try {
+        await useSession(event, config({ extraUnsealPasswords: ["0123456789"] }));
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    const res = await t.fetch("/use-invalid");
+    expect((await res.json()).error).toContain("extraUnsealPasswords");
+  });
+
+  it("rejects an invalid extra password even when the session is already loaded", async () => {
+    t.app.get("/loaded-invalid", async (event) => {
+      await getSession(event, config());
+      try {
+        await getSession(event, config({ extraUnsealPasswords: [""] }));
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    const res = await t.fetch("/loaded-invalid");
+    expect((await res.json()).error).toContain("extraUnsealPasswords");
+  });
+
+  // --- RF-06, resealing ---
+
+  it("reseals a cookie session opened with a previous password", async () => {
+    readRoute("/reseal", config({ extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, sealDefaults);
+
+    const res = await t.fetch("/reseal", { headers: { Cookie: `h3-test=${sealed}` } });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const value = cookieValue(setCookies[0]);
+    expect(await unseal(value, NEW_PASSWORD, sealDefaults)).toMatchObject({ id: "old-1" });
+    await expect(unseal(value, OLD_PASSWORD, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("does not reseal a header session opened with a previous password", async () => {
+    readRoute("/header", config({ extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, sealDefaults);
+
+    const res = await t.fetch("/header", { headers: { "x-h3-test-session": sealed } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { user: "ana" } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  // --- RF-08, RF-09, expiration and legacy seal ---
+
+  it("treats a session sealed with a previous password past maxAge as new", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    readRoute("/expired", config({ maxAge: 3600, extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(
+      sessionWith({ createdAt: t0 - 7200_000 }),
+      OLD_PASSWORD,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/expired", { headers: { Cookie: `h3-test=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("old-1");
+    expect(body.data).toEqual({});
+  });
+
+  it("unseals and reseals a legacy session sealed with a previous password", async () => {
+    readRoute("/legacy", config({ extraUnsealPasswords: [OLD_PASSWORD] }));
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, legacyOptions);
+
+    const res = await t.fetch("/legacy", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { user: "ana" } });
+
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const value = cookieValue(setCookies[0]);
+    expect(await unseal(value, NEW_PASSWORD, sealDefaults)).toMatchObject({ id: "old-1" });
+  });
+
+  // --- RF-09, cost, legacySealFallback and idleTimeout ---
+
+  it("derives keys 2 × (1 + N) times for a forged cookie with N extras", async () => {
+    readRoute(
+      "/forged",
+      config({ extraUnsealPasswords: [pw("uma"), pw("duas")], legacySealFallback: true }),
+    );
+    const forged = await seal(sessionWith(), UNKNOWN_PASSWORD, sealDefaults);
+
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    await t.fetch("/forged", { headers: { Cookie: `h3-test=${forged}` } });
+    // N = 2 extras: 3 passwords, each with a current and a legacy attempt
+    expect(deriveBits).toHaveBeenCalledTimes(6);
+    deriveBits.mockRestore();
+  });
+
+  it("rejects a legacy session sealed with a previous password when legacySealFallback is false", async () => {
+    readRoute(
+      "/no-fallback",
+      config({ extraUnsealPasswords: [OLD_PASSWORD], legacySealFallback: false }),
+    );
+    const sealed = await seal(sessionWith(), OLD_PASSWORD, legacyOptions);
+
+    const res = await t.fetch("/no-fallback", { headers: { Cookie: `h3-test=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("old-1");
+    expect(body.data).toEqual({});
+  });
+
+  it("slides the idle window when a session opened by an extra is resealed", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    readRoute("/idle", config({ idleTimeout: 60, extraUnsealPasswords: [OLD_PASSWORD] }));
