+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach, vi } from "vitest";
+import { getSession, updateSession, useSession, readBody } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PASSWORD_A = "current-password-aaaaaaaaaaaaaaaaaaaa";
+const PASSWORD_B = "previous-password-bbbbbbbbbbbbbbbbbbb";
+const PASSWORD_C = "older-password-cccccccccccccccccccccc";
+const PASSWORD_D = "unknown-password-dddddddddddddddddddd";
+
+const COOKIE = "h3-rot";
+
+const kExtraUnsealPassword = Symbol.for("h3.internal.session.extra-unseal-password");
+
+/** Seal a session payload the way h3 would with `password`. */
+function sealWith(password: string, payload: Record<string, unknown>, legacy = false) {
+  return seal(
+    payload,
+    password,
+    legacy
+      ? {
+          ...sealDefaults,
+          encryption: { ...sealDefaults.encryption, iterations: 1 },
+          integrity: { ...sealDefaults.integrity, iterations: 1 },
+        }
+      : sealDefaults,
+  );
+}
+
+/** Read the sealed value of the session cookie from a response, if it was set. */
+function setCookieValue(res: Response): string | undefined {
+  const cookie = res.headers.getSetCookie().find((c) => c.startsWith(`${COOKIE}=`));
+  return cookie && decodeURIComponent(cookie.match(/h3-rot=([^;]+)/)![1]);
+}
+
+describeMatrix("session unseal passwords", (t, { it, expect }) => {
+  const config: SessionConfig = {
+    name: COOKIE,
+    password: PASSWORD_A,
+    extraUnsealPasswords: [PASSWORD_B],
+    generateId: () => "new-id",
+  };
+
+  beforeEach(() => {
+    t.app.get("/read", async (event) => {
+      const session = await getSession(event, config);
+      return {
+        id: session.id,
+        createdAt: session.createdAt,
+        data: session.data,
+        hasMarker: Reflect.ownKeys(session).includes(kExtraUnsealPassword),
+      };
+    });
+    t.app.post("/write", async (event) => {
+      const session = await useSession(event, config);
+      await session.update((await readBody(event)) as any);
+      return { id: session.id, data: session.data };
+    });
+    t.app.get("/use", async (event) => {
+      const session = await useSession(event, config);
+      await session.update({ user: "bob" });
+      return { id: session.id, data: session.data };
+    });
+    t.app.get("/update", async (event) => {
+      await updateSession(event, config, { user: "carol" });
+      return "ok";
+    });
+    t.app.get("/validate", async (event) => {
+      try {
+        await getSession(event, { ...config, extraUnsealPasswords: ["curta"] });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/validate-use", async (event) => {
+      try {
+        await useSession(event, { ...config, extraUnsealPasswords: [PASSWORD_B, "curta"] });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+  });
+
+  const payload = { id: "sess-1", createdAt: Date.now(), data: { user: "alice" } };
+
+  // RF-01
+  it("opens a cookie sealed with an extra password, keeping id, createdAt and data", async () => {
+    const sealed = await sealWith(PASSWORD_B, payload);
+    const res = await t.fetch("/read", { headers: { Cookie: `${COOKIE}=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      id: "sess-1",
+      createdAt: payload.createdAt,
+      data: { user: "alice" },
+    });
+  });
+
+  // RF-02
+  it("writes with password only: the cookie opens with A and not with B", async () => {
+    const res = await t.fetch("/update");
+    const sealed = setCookieValue(res)!;
+    expect(sealed).toBeTruthy();
+    expect(await unseal(sealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      data: { user: "carol" },
+    });
+    await expect(unseal(sealed, PASSWORD_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("useSession update on a cookie sealed with B writes a cookie that opens only with A", async () => {
+    const sealed = await sealWith(PASSWORD_B, payload);
+    const res = await t.fetch("/use", { headers: { Cookie: `${COOKIE}=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "sess-1", data: { user: "bob" } });
+    const written = setCookieValue(res)!;
+    expect(await unseal(written, PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "sess-1",
+      data: { user: "bob" },
+    });
+    await expect(unseal(written, PASSWORD_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-03
+  it("reseals a session opened with an extra password under password on the same request", async () => {
+    const sealed = await sealWith(PASSWORD_B, payload);
+    const res = await t.fetch("/read", { headers: { Cookie: `${COOKIE}=${sealed}` } });
+    const resealed = setCookieValue(res)!;
+    expect(resealed).toBeTruthy();
+    expect(resealed).not.toBe(sealed);
+    expect(await unseal(resealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "sess-1",
+      createdAt: payload.createdAt,
+      data: { user: "alice" },
+    });
+    await expect(unseal(resealed, PASSWORD_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("does not leak the internal marker into the session or the resealed payload", async () => {
+    const sealed = await sealWith(PASSWORD_B, payload);
+    const res = await t.fetch("/read", { headers: { Cookie: `${COOKIE}=${sealed}` } });
+    expect((await res.json()).hasMarker).toBe(false);
+    const resealed = setCookieValue(res)!;
+    const opened = (await unseal(resealed, PASSWORD_A, sealDefaults)) as Record<string, unknown>;
+    expect(Reflect.ownKeys(opened)).not.toContain(kExtraUnsealPassword);
+  });
+
