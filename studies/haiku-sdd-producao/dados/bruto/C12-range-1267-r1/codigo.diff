+++ b/test/static-range.test.ts
@@ -0,0 +1,369 @@
+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const content = "0123456789".repeat(10); // 100 bytes
+const lastModifiedDate = "Wed, 21 Oct 2015 07:28:00 GMT";
+const encoder = new TextEncoder();
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let options: ServeStaticOptions;
+
+  beforeEach(() => {
+    options = {
+      getMeta: vi.fn((id) =>
+        id === "/test.txt"
+          ? { type: "text/plain", etag: '"v1"', mtime: 1_700_000_000_000, size: 100 }
+          : undefined,
+      ),
+      getContents: vi.fn((id) => (id === "/test.txt" ? content : undefined)),
+    };
+    t.app.use((event) => serveStatic(event, options));
+  });
+
+  const range = (value: string) => ({ headers: { range: value } });
+
+  // RF-01
+  it("advertises Accept-Ranges on a full GET response", async () => {
+    const res = await t.fetch("/test.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(content);
+  });
+
+  it("advertises Accept-Ranges on a HEAD response", async () => {
+    const res = await t.fetch("/test.txt", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("advertises Accept-Ranges on a 304 response", async () => {
+    const res = await t.fetch("/test.txt", { headers: { "if-none-match": '"v1"' } });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("does not advertise Accept-Ranges on 404, 405 or fallthrough", async () => {
+    const notFound = await t.fetch("/missing.txt");
+    expect(notFound.status).toBe(404);
+    expect(notFound.headers.get("accept-ranges")).toBeNull();
+
+    const notAllowed = await t.fetch("/test.txt", { method: "POST" });
+    expect(notAllowed.status).toBe(405);
+    expect(notAllowed.headers.get("accept-ranges")).toBeNull();
+
+    options.fallthrough = true;
+    t.app.get("/**", () => "fallthrough");
+    const fellThrough = await t.fetch("/missing.txt");
+    expect(await fellThrough.text()).toBe("fallthrough");
+    expect(fellThrough.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("keeps an Accept-Ranges value set in options.headers", async () => {
+    options.headers = { "accept-ranges": "none" };
+    const res = await t.fetch("/test.txt");
+    expect(res.headers.get("accept-ranges")).toBe("none");
+  });
+
+  // RF-02
+  it("ignores Range headers that are not a single bytes range", async () => {
+    for (const value of ["bytes=0-4,10-14", "items=0-4", "bytes=5-2", "bytes=abc"]) {
+      const res = await t.fetch("/test.txt", range(value));
+      expect(res.status, value).toBe(200);
+      expect(res.headers.get("content-range"), value).toBeNull();
+      expect(await res.text(), value).toHaveLength(100);
+    }
+  });
+
+  it("ignores Range when getMeta does not return a size", async () => {
+    options.getMeta = () => ({ type: "text/plain", etag: '"v1"' });
+    const res = await t.fetch("/test.txt", range("bytes=0-4"));
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(content);
+  });
+
+  // RF-03
+  it("responds 206 with the requested bytes for satisfiable ranges", async () => {
+    const cases: [string, string, string][] = [
+      ["bytes=10-19", "bytes 10-19/100", content.slice(10, 20)],
+      ["bytes=95-200", "bytes 95-99/100", content.slice(95)],
+      ["bytes=-10", "bytes 90-99/100", content.slice(90)],
+      ["bytes=-200", "bytes 0-99/100", content],
+      ["bytes=50-", "bytes 50-99/100", content.slice(50)],
+    ];
+    for (const [value, contentRange, body] of cases) {
+      const res = await t.fetch("/test.txt", range(value));
+      expect(res.status, value).toBe(206);
+      expect(res.headers.get("content-range"), value).toBe(contentRange);
+      expect(res.headers.get("content-length"), value).toBe(String(body.length));
+      expect(await res.text(), value).toBe(body);
+    }
+  });
+
+  // RF-04
+  it("responds 416 for unsatisfiable ranges without calling getContents", async () => {
+    for (const value of ["bytes=100-", "bytes=-0"]) {
+      const res = await t.fetch("/test.txt", range(value));
+      expect(res.status, value).toBe(416);
+      expect(res.headers.get("content-range"), value).toBe("bytes */100");
+      expect(res.headers.get("content-length"), value).toBe("0");
+      expect(res.headers.get("accept-ranges"), value).toBe("bytes");
+      expect(await res.text(), value).toBe("");
+    }
+    expect(options.getContents).not.toHaveBeenCalled();
+  });
+
+  // RF-05
+  it("answers HEAD 206 with GET headers and no body or getContents call", async () => {
+    const res = await t.fetch("/test.txt", { method: "HEAD", ...range("bytes=10-19") });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(res.headers.get("content-range")).toBe("bytes 10-19/100");
+    expect(await res.text()).toBe("");
+    expect(options.getContents).not.toHaveBeenCalled();
+  });
+
+  it("answers HEAD 416 with GET headers and no getContents call", async () => {
+    const res = await t.fetch("/test.txt", { method: "HEAD", ...range("bytes=100-") });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */100");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+    expect(options.getContents).not.toHaveBeenCalled();
+  });
+
+  it("answers HEAD with 200 and no Content-Range when the Range is ignored", async () => {
+    const res = await t.fetch("/test.txt", { method: "HEAD", ...range("items=0-4") });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  // RF-06
+  it("evaluates If-Range against the strong ETag", async () => {
+    const withIfRange = (value: string) => ({ headers: { range: "bytes=0-9", "if-range": value } });
+
+    const matching = await t.fetch("/test.txt", withIfRange('"v1"'));
+    expect(matching.status).toBe(206);
+
+    const different = await t.fetch("/test.txt", withIfRange('"v2"'));
+    expect(different.status).toBe(200);
+    expect(await different.text()).toBe(content);
+
+    const weak = await t.fetch("/test.txt", withIfRange('W/"v1"'));
+    expect(weak.status).toBe(200);
+    expect(await weak.text()).toBe(content);
+  });
+
+  it("evaluates If-Range against a weak ETag asset as not matching", async () => {
+    options.getMeta = () => ({ type: "text/plain", etag: 'W/"v1"', size: 100 });
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-9", "if-range": 'W/"v1"' },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(content);
+  });
+
+  it("evaluates If-Range against Last-Modified by exact date", async () => {
+    options.getMeta = () => ({
+      type: "text/plain",
+      mtime: new Date(lastModifiedDate).getTime(),
+      size: 100,
+    });
+    const same = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-9", "if-range": lastModifiedDate },
+    });
+    expect(same.status).toBe(206);
+
+    const differentSecond = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-9", "if-range": "Wed, 21 Oct 2015 07:28:01 GMT" },
+    });
+    expect(differentSecond.status).toBe(200);
+  });
+
+  it("ignores If-Range when the asset has no ETag or the date is invalid", async () => {
+    options.getMeta = () => ({ type: "text/plain", size: 100 });
+    const noEtag = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-9", "if-range": '"v1"' },
+    });
+    expect(noEtag.status).toBe(200);
+
+    const invalidDate = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-9", "if-range": "not a date" },
+    });
+    expect(invalidDate.status).toBe(200);
+  });
+
+  it("ignores If-Range when there is no Range header", async () => {
+    const res = await t.fetch("/test.txt", { headers: { "if-range": '"v2"' } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(content);
+  });
+
+  // RF-07
+  it("keeps 304 ahead of Range when If-None-Match matches", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-9", "if-none-match": '"v1"' },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-08
+  it("keeps validators and content type on 206 and 416 responses", async () => {
+    options.getMeta = () => ({
+      type: "text/plain",
+      etag: '"v1"',
+      mtime: new Date(lastModifiedDate).getTime(),
+      size: 100,
+    });
+    const full = await t.fetch("/test.txt");
+    const partial = await t.fetch("/test.txt", range("bytes=10-19"));
+    const unsatisfiable = await t.fetch("/test.txt", range("bytes=100-"));
+
+    for (const res of [partial, unsatisfiable]) {
+      expect(res.headers.get("etag")).toBe(full.headers.get("etag"));
+      expect(res.headers.get("last-modified")).toBe(full.headers.get("last-modified"));
+      expect(res.headers.get("content-type")).toBe(full.headers.get("content-type"));
+    }
+  });
+
+  it("applies options.headers on 206 and 416, with the range Content-Length winning", async () => {
+    options.headers = { "x-custom": "yes", "content-length": "999" };
+    const partial = await t.fetch("/test.txt", range("bytes=10-19"));
+    expect(partial.headers.get("x-custom")).toBe("yes");
+    expect(partial.headers.get("content-length")).toBe("10");
+
+    const unsatisfiable = await t.fetch("/test.txt", range("bytes=100-"));
+    expect(unsatisfiable.headers.get("x-custom")).toBe("yes");
+    expect(unsatisfiable.headers.get("content-length")).toBe("0");
+  });
+
+  // RF-09
+  // A coding name runtimes do not decode: `fetch` would gunzip a `gzip` body, and the
+  // partial bytes of a real gzip stream are not decodable.
