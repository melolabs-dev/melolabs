@@ -0,0 +1,154 @@
+import { describe, it, expect, vi } from "vitest";
+import { parseRange, matchesIfRange, sliceBody } from "../../src/utils/internal/range.ts";
+
+const encoder = new TextEncoder();
+
+function pulledStream(chunks: string[], cancel = vi.fn()) {
+  let index = 0;
+  const stream = new ReadableStream<Uint8Array>({
+    pull(controller) {
+      if (index < chunks.length) {
+        controller.enqueue(encoder.encode(chunks[index++]));
+      } else {
+        controller.close();
+      }
+    },
+    cancel,
+  });
+  return { stream, cancel };
+}
+
+describe("parseRange", () => {
+  it("resolves satisfiable ranges", () => {
+    expect(parseRange("bytes=0-4", 100)).toEqual({ start: 0, end: 4, size: 100 });
+    expect(parseRange("bytes=4-", 100)).toEqual({ start: 4, end: 99, size: 100 });
+    expect(parseRange("bytes=-10", 100)).toEqual({ start: 90, end: 99, size: 100 });
+    expect(parseRange("bytes=-200", 100)).toEqual({ start: 0, end: 99, size: 100 });
+    expect(parseRange("bytes=95-200", 100)).toEqual({ start: 95, end: 99, size: 100 });
+  });
+
+  it("treats the unit name as case-insensitive", () => {
+    expect(parseRange("BYTES=0-4", 100)).toEqual({ start: 0, end: 4, size: 100 });
+  });
+
+  it("returns unsatisfiable when the start is beyond the size or the suffix is 0", () => {
+    expect(parseRange("bytes=100-", 100)).toBe("unsatisfiable");
+    expect(parseRange("bytes=-0", 100)).toBe("unsatisfiable");
+    expect(parseRange("bytes=9007199254740993-", 100)).toBe("unsatisfiable");
+  });
+
+  it("ignores ranges that are invalid, multiple, or not in bytes", () => {
+    expect(parseRange("bytes=5-2", 100)).toBeUndefined();
+    expect(parseRange("bytes=0-4,10-14", 100)).toBeUndefined();
+    expect(parseRange("items=0-4", 100)).toBeUndefined();
+    expect(parseRange("bytes=abc", 100)).toBeUndefined();
+    expect(parseRange("bytes=", 100)).toBeUndefined();
+    expect(parseRange("bytes=-", 100)).toBeUndefined();
+  });
+
+  it("ignores ranges without a known size", () => {
+    expect(parseRange("bytes=0-4", undefined)).toBeUndefined();
+    expect(parseRange("bytes=0-4", 0)).toBeUndefined();
+  });
+
+  it("ignores a missing header", () => {
+    expect(parseRange(null, 100)).toBeUndefined();
+    expect(parseRange(undefined, 100)).toBeUndefined();
+  });
+});
+
+describe("matchesIfRange", () => {
+  const lastModified = "Wed, 21 Oct 2015 07:28:00 GMT";
+
+  it("matches an identical strong ETag", () => {
+    expect(matchesIfRange('"v1"', { etag: '"v1"', lastModified })).toBe(true);
+  });
+
+  it("rejects a different strong ETag", () => {
+    expect(matchesIfRange('"v2"', { etag: '"v1"', lastModified })).toBe(false);
+  });
+
+  it("rejects weak ETags on either side", () => {
+    expect(matchesIfRange('W/"v1"', { etag: '"v1"', lastModified })).toBe(false);
+    expect(matchesIfRange('"v1"', { etag: 'W/"v1"', lastModified })).toBe(false);
+    expect(matchesIfRange('W/"v1"', { etag: 'W/"v1"', lastModified })).toBe(false);
+  });
+
+  it("rejects an ETag when the asset has none", () => {
+    expect(matchesIfRange('"v1"', { lastModified })).toBe(false);
+  });
+
+  it("matches an identical date", () => {
+    expect(matchesIfRange(lastModified, { etag: '"v1"', lastModified })).toBe(true);
+  });
+
+  it("rejects a date one second apart", () => {
+    expect(matchesIfRange("Wed, 21 Oct 2015 07:28:01 GMT", { lastModified })).toBe(false);
+  });
+
+  it("rejects an invalid date", () => {
+    expect(matchesIfRange("not a date", { lastModified })).toBe(false);
+  });
+
+  it("rejects a date when the asset has no Last-Modified", () => {
+    expect(matchesIfRange(lastModified, {})).toBe(false);
+    expect(matchesIfRange(lastModified, { lastModified: null })).toBe(false);
+  });
+
+  it("rejects an unquoted value that is not a date", () => {
+    expect(matchesIfRange("v1", { etag: '"v1"', lastModified })).toBe(false);
+  });
+});
+
+describe("sliceBody", () => {
+  it("slices a multibyte string by UTF-8 bytes", async () => {
+    const body = await sliceBody("aé", 1, 2);
+    expect(await new Response(body).text()).toBe("é");
+  });
+
+  it("slices an ArrayBuffer", async () => {
+    const body = await sliceBody(encoder.encode("abcdefgh").buffer, 2, 4);
+    expect(await new Response(body).text()).toBe("cde");
+  });
+
+  it("slices a Uint8Array with a non-zero byteOffset", async () => {
+    const view = new Uint8Array(encoder.encode("xxabcdyy").buffer, 2, 4);
+    const body = await sliceBody(view, 1, 2);
+    expect(await new Response(body).text()).toBe("bc");
+  });
+
+  it("slices a DataView", async () => {
+    const view = new DataView(encoder.encode("abcdefgh").buffer);
+    const body = await sliceBody(view, 2, 4);
+    expect(await new Response(body).text()).toBe("cde");
+  });
+
+  it("slices a Blob", async () => {
+    const body = await sliceBody(new Blob(["abcdefgh"]), 2, 4);
+    expect(await new Response(body).text()).toBe("cde");
+  });
+
+  it("slices a ReadableStream made of one chunk", async () => {
+    const { stream } = pulledStream(["abcdefgh"]);
+    const body = await sliceBody(stream, 2, 4);
+    expect(await new Response(body).text()).toBe("cde");
+  });
+
+  it("slices a ReadableStream whose range crosses chunk boundaries", async () => {
+    const { stream } = pulledStream(["ab", "cd", "ef", "gh"]);
+    const body = await sliceBody(stream, 3, 5);
+    expect(await new Response(body).text()).toBe("def");
+  });
+
+  it("cancels the source stream once the last requested byte is delivered", async () => {
+    const { stream, cancel } = pulledStream(["ab", "cd", "ef", "gh"]);
+    const body = await sliceBody(stream, 0, 1);
+    expect(await new Response(body).text()).toBe("ab");
+    expect(cancel).toHaveBeenCalledTimes(1);
+  });
+
+  it("converts other BodyInit types to bytes before slicing", async () => {
+    const body = await sliceBody(new URLSearchParams("a=bcd"), 2, 4);
+    expect(await new Response(body).text()).toBe("bcd");
+  });
+});
