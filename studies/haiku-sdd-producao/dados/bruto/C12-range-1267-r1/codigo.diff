+    );
+    options.getContents = vi.fn((id) => (id === "/app.js" ? original : undefined));
+
+    const res = await t.fetch("/app.js", range("bytes=0-9"));
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/120");
+    expect(await res.text()).toBe(original.slice(0, 10));
+  });
+
+  // RF-10
+  it("slices each supported body type by byte", async () => {
+    const makers: Record<string, () => BodyInit> = {
+      string: () => "abcdefgh",
+      ArrayBuffer: () => encoder.encode("abcdefgh").buffer,
+      Blob: () => new Blob(["abcdefgh"]),
