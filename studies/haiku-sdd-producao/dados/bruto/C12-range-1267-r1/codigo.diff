+    expect(res.headers.get("content-range")).toBe("bytes 0-9/50");
+    expect(await res.text()).toBe(variant.slice(0, 10));
+
+    const unsatisfiable = await t.fetch("/app.js", {
+      headers: { "accept-encoding": "x-range", range: "bytes=50-" },
+    });
+    expect(unsatisfiable.status).toBe(416);
+    expect(unsatisfiable.headers.get("content-encoding")).toBe("x-range");
+    expect(unsatisfiable.headers.get("content-range")).toBe("bytes */50");
+  });
+
+  it("ranges over the original file when no encoding is accepted", async () => {
