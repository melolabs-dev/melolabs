+
+  // Edge cases
+  it("responds 200 without range headers when getContents returns nothing", async () => {
+    // No `size`: with one, `content-length` would promise bytes the empty body never sends.
+    options.getMeta = () => ({ type: "text/plain", etag: '"v1"' });
