+++ b/src/utils/internal/range.ts
@@ -0,0 +1,133 @@
+import { textEncoder } from "./encoding.ts";
+
+/** Inclusive byte range, already clamped to `size - 1`. */
+export type ByteRange = { start: number; end: number; size: number };
+
+// Only a single `bytes` range is interpreted: `start-end`, `start-` or `-suffix`.
+// Range unit names are case-insensitive (RFC 9110 section 14.1).
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * `undefined`: Range is ignored and the full `200` is sent.
+ * `"unsatisfiable"`: respond `416`.
+ * `ByteRange`: respond `206`.
+ */
+export function parseRange(
+  header: string | null | undefined,
+  size: number | undefined,
+): ByteRange | "unsatisfiable" | undefined {
+  if (!header || size === undefined || size <= 0) {
+    return undefined;
+  }
+  const match = RANGE_RE.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, rawStart = "", rawEnd = ""] = match;
+  if (rawStart === "") {
+    if (rawEnd === "") {
+      return undefined;
+    }
+    const suffix = Number(rawEnd);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1, size };
+  }
+  const start = Number(rawStart);
+  if (rawEnd !== "" && Number(rawEnd) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = rawEnd === "" ? size - 1 : Math.min(Number(rawEnd), size - 1);
+  return { start, end, size };
+}
+
+/**
+ * Evaluate `If-Range` (RFC 9110 section 13.1.5). The validator must be a strong
+ * ETag identical to the asset's, or a date identical to the served `Last-Modified`.
+ */
+export function matchesIfRange(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: string | null },
+): boolean {
+  if (ifRange.startsWith('"')) {
+    const { etag } = validators;
+    return etag !== undefined && !etag.startsWith("W/") && ifRange === etag;
+  }
+  return validators.lastModified != null && ifRange === validators.lastModified;
+}
+
+/** Slice a body to the inclusive byte range `[start, end]`. */
+export async function sliceBody(body: BodyInit, start: number, end: number): Promise<BodyInit> {
+  const last = end + 1;
+  if (typeof body === "string") {
+    return textEncoder.encode(body).subarray(start, last);
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(start, last);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(start, last);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, last);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end);
+  }
+  return new Uint8Array(await new Response(body).arrayBuffer()).subarray(start, last);
+}
+
+function sliceStream(
+  source: ReadableStream,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  const last = end + 1; // exclusive
+  let offset = 0; // bytes already read from the source
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunk = toBytes(value);
+        const chunkStart = offset;
+        offset += chunk.byteLength;
+        const from = Math.max(start - chunkStart, 0);
+        const to = Math.min(last - chunkStart, chunk.byteLength);
+        if (from < to) {
+          controller.enqueue(chunk.subarray(from, to));
+        }
+        if (offset >= last) {
+          controller.close();
+          await reader.cancel();
+          return;
+        }
+        if (from < to) {
+          return;
+        }
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
+
+function toBytes(chunk: unknown): Uint8Array {
+  if (typeof chunk === "string") {
+    return textEncoder.encode(chunk);
+  }
+  if (chunk instanceof ArrayBuffer) {
+    return new Uint8Array(chunk);
+  }
+  const view = chunk as ArrayBufferView;
+  return new Uint8Array(view.buffer, view.byteOffset, view.byteLength);
+}
