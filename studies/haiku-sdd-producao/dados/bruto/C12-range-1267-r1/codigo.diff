+
+  it("calls getContents exactly once for a 206 and for an ignored Range", async () => {
+    await t.fetch("/test.txt", range("bytes=10-19"));
+    expect(options.getContents).toHaveBeenCalledTimes(1);
+
+    vi.mocked(options.getContents).mockClear();
+    await t.fetch("/test.txt", range("items=0-4"));
+    expect(options.getContents).toHaveBeenCalledTimes(1);
+  });
+
+  it("serves the full asset when getMeta returns no size", async () => {
+    options.getMeta = vi.fn(() => ({ type: "text/plain", etag: '"v1"' }));
+    const res = await t.fetch("/test.txt", range("bytes=0-4"));
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(content);
+    expect(options.getContents).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/test/unit/range.test.ts b/test/unit/range.test.ts
