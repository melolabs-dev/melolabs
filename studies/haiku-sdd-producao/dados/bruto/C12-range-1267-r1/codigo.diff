+            controller.close();
+          },
+        }),
+    };
+    for (const [name, make] of Object.entries(makers)) {
+      options.getMeta = () => ({ type: "text/plain", size: 8 });
+      options.getContents = () => make();
+      const res = await t.fetch("/test.txt", range("bytes=2-4"));
+      expect(res.status, name).toBe(206);
+      expect(await res.text(), name).toBe("cde");
+    }
+  });
+
+  it("counts UTF-8 bytes for multibyte strings", async () => {
+    options.getMeta = () => ({ type: "text/plain", size: 3 });
+    options.getContents = () => "aé";
+    const res = await t.fetch("/test.txt", range("bytes=1-2"));
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 1-2/3");
+    expect(await res.text()).toBe("é");
+  });
+
+  it("cancels the source stream after the last requested byte", async () => {
+    const cancel = vi.fn();
+    let index = 0;
+    const chunks = ["ab", "cd", "ef", "gh"];
+    options.getMeta = () => ({ type: "text/plain", size: 8 });
+    options.getContents = () =>
