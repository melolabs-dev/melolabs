+
+// Single byte-range spec (`bytes=a-b`, `bytes=a-`, `bytes=-n`), RFC 9110 section 14.1.1.
+const RANGE_RE = /^[ \t]*bytes[ \t]*=[ \t]*(\d*)[ \t]*-[ \t]*(\d*)[ \t]*$/i;
+
+const encoder = new TextEncoder();
+
+interface PartialRange {
+  start: number;
+  end: number;
+  size: number;
+}
+
+type RangeResolution =
+  | { type: "ignore" }
+  | { type: "unsatisfiable" }
+  | { type: "partial"; start: number; end: number };
+
+/** Interpret a `Range` header value against an asset of `size` bytes. */
+function parseRange(value: string, size: number): RangeResolution {
+  const match = RANGE_RE.exec(value);
+  if (!match) {
+    return { type: "ignore" };
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return { type: "ignore" };
+  }
+
+  if (first === "") {
+    const n = Number(last);
+    if (!Number.isSafeInteger(n)) {
+      return { type: "ignore" };
+    }
+    if (n === 0 || size === 0) {
+      return { type: "unsatisfiable" };
+    }
+    return { type: "partial", start: Math.max(size - n, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (!Number.isSafeInteger(start)) {
+    return { type: "ignore" };
+  }
+  let end = size - 1;
+  if (last !== "") {
+    end = Number(last);
+    if (!Number.isSafeInteger(end) || end < start) {
+      return { type: "ignore" };
+    }
+  }
+  if (start >= size) {
+    return { type: "unsatisfiable" };
+  }
+  return { type: "partial", start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * Evaluate `If-Range`. An entity-tag matches only when it is strong and identical
+ * to the asset's ETag; a date matches only when it is exactly the `last-modified` sent.
+ */
+function isIfRangeMatch(
+  ifRange: string,
+  etag: string | undefined,
+  lastModified: string | null,
+): boolean {
+  if (ifRange.startsWith('"') || ifRange.startsWith('W/"')) {
+    return etag !== undefined && !etag.startsWith("W/") && etag === ifRange;
+  }
+  return lastModified !== null && ifRange === lastModified;
+}
+
+function setPartialHeaders(headers: Headers, { start, end, size }: PartialRange): void {
+  headers.set("content-range", `bytes ${start}-${end}/${size}`);
+  headers.set("content-length", String(end - start + 1));
+}
+
+/** Slice a body to the inclusive byte range `[start, end]`, without copying when possible. */
+async function sliceBody(
+  body: NonNullable<BodyInit>,
+  start: number,
+  end: number,
+): Promise<BodyInit> {
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end - start + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body, start, end - start + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset + start, end - start + 1);
+  }
+  if (typeof body === "string") {
+    return encoder.encode(body).subarray(start, end + 1);
+  }
+  return (await new Response(body).blob()).slice(start, end + 1);
+}
+
+/** Skip `start` bytes of `source`, emit `length` bytes, then cancel the source. */
+function sliceStream(
+  source: ReadableStream,
+  start: number,
+  length: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let toSkip = start;
+  let toEmit = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (toEmit > 0) {
+        const { done, value } = await reader.read();
+        if (done) {
+          break;
+        }
+        const chunk = toBytes(value);
+        const skipped = Math.min(toSkip, chunk.byteLength);
+        toSkip -= skipped;
+        const part = chunk.subarray(skipped, skipped + toEmit);
+        toEmit -= part.byteLength;
+        if (part.byteLength > 0) {
+          controller.enqueue(part);
+          return;
+        }
+      }
+      await reader.cancel();
+      controller.close();
+    },
+    async cancel(reason) {
+      await reader.cancel(reason);
+    },
+  });
+}
+
+function toBytes(chunk: unknown): Uint8Array {
+  if (typeof chunk === "string") {
+    return encoder.encode(chunk);
+  }
+  if (chunk instanceof ArrayBuffer) {
+    return new Uint8Array(chunk);
+  }
+  const view = chunk as ArrayBufferView;
+  return new Uint8Array(view.buffer, view.byteOffset, view.byteLength);
+}
