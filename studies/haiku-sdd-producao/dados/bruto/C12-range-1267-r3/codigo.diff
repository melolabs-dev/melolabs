+import { beforeEach, vi, type Mock } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// 1000 ASCII bytes: byte i is the letter at index i % 26.
+const CONTENT = Array.from({ length: 1000 }, (_, i) => String.fromCharCode(97 + (i % 26))).join("");
+const MTIME = Date.UTC(2023, 10, 14, 22, 13, 20);
+const LAST_MODIFIED = new Date(MTIME).toUTCString();
+
+type Asset = {
+  meta: { type?: string; etag?: string; mtime?: number; size?: number; encoding?: string };
+  contents: () => BodyInit;
+};
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let assets: Record<string, Asset>;
+  let overrides: Partial<ServeStaticOptions>;
+  let getContents: Mock<(id: string) => BodyInit | undefined>;
+
+  beforeEach(() => {
+    assets = {
+      "/range/file.txt": {
+        meta: { type: "text/plain", etag: '"abc"', mtime: MTIME, size: 1000 },
+        contents: () => CONTENT,
+      },
+      "/range/empty.txt": {
+        meta: { type: "text/plain", etag: '"abc"', mtime: MTIME, size: 0 },
+        contents: () => "",
+      },
+      "/range/nosize.txt": {
+        meta: { type: "text/plain", etag: '"abc"', mtime: MTIME },
+        contents: () => CONTENT,
+      },
+      "/range/weak.txt": {
+        meta: { type: "text/plain", etag: 'W/"abc"', mtime: MTIME, size: 1000 },
+        contents: () => CONTENT,
+      },
+      "/range/app.js": {
+        meta: { type: "text/javascript", mtime: MTIME, size: 1000 },
+        contents: () => CONTENT,
+      },
+      "/range/app.js.gz": {
+        meta: { encoding: "gzip", mtime: MTIME, size: 400 },
+        contents: () => "g".repeat(400),
+      },
+      "/range/unicode.txt": {
+        meta: { type: "text/plain", mtime: MTIME, size: 6 },
+        contents: () => "ação",
+      },
+      "/range/form.txt": {
+        meta: { type: "text/plain", mtime: MTIME, size: 1000 },
+        contents: () => new FormData(),
+      },
+      "/range/blob.txt": {
+        meta: { type: "text/plain", mtime: MTIME, size: 1000 },
+        contents: () => new Blob([CONTENT]),
+      },
+    };
+
+    getContents = vi.fn((id: string) => assets[id]?.contents());
+    overrides = {};
+
+    t.app.all("/range/**", (event) => {
+      return serveStatic(event, {
+        getMeta: (id) => assets[id]?.meta,
+        getContents: (id) => getContents(id),
+        encodings: { gzip: ".gz" },
+        ...overrides,
+      });
+    });
+
+    // Same assets, mounted under another prefix, with a Content-Length set on event.res first.
+    const preset = (id: string) => id.replace(/^\/preset\//, "/range/");
+    t.app.all("/preset/**", (event) => {
+      event.res.headers.set("content-length", "5");
+      return serveStatic(event, {
+        getMeta: (id) => assets[preset(id)]?.meta,
+        getContents: (id) => getContents(preset(id)),
+      });
+    });
+  });
+
+  // RF-01
+  it("GET without Range announces byte ranges", async () => {
+    const res = await t.fetch("/range/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-length")).toBe("1000");
+    expect(await res.text()).toBe(CONTENT);
+  });
+
+  it("HEAD without Range announces byte ranges", async () => {
+    const res = await t.fetch("/range/file.txt", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-length")).toBe("1000");
+  });
+
+  // RF-03
+  it("serves bytes=100-199 as 206", async () => {
+    const res = await t.fetch("/range/file.txt", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 100-199/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(res.headers.get("content-type")).toBe("text/plain");
+    expect(res.headers.get("etag")).toBe('"abc"');
+    expect(res.headers.get("last-modified")).toBe(LAST_MODIFIED);
+    expect(await res.text()).toBe(CONTENT.slice(100, 200));
+  });
+
+  it("serves bytes=900- to the end", async () => {
+    const res = await t.fetch("/range/file.txt", { headers: { range: "bytes=900-" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(CONTENT.slice(900));
+  });
+
+  it("serves a suffix range bytes=-100", async () => {
+    const res = await t.fetch("/range/file.txt", { headers: { range: "bytes=-100" } });
+    expect(res.status).toBe(206);
