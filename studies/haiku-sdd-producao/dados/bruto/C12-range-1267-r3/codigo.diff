+export type ParsedRange =
+  | { status: "satisfiable"; start: number; end: number }
+  | { status: "unsatisfiable" };
+
+const RANGE_RE = /^bytes\s*=\s*(\d*)-(\d*)$/i;
+
+/**
+ * Interpreta o cabeçalho `Range` (RFC 9110 §14.1.1 e §14.2) para um corpo de `size` bytes.
+ * Retorna `undefined` quando o cabeçalho deve ser ignorado. `start` e `end` são inclusivos.
+ */
+export function parseRange(header: string, size: number): ParsedRange | undefined {
+  const match = RANGE_RE.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  // Checked before satisfiability: `bytes=1000-100` is invalid even when `size` is 500.
+  if (first !== "" && last !== "" && Number(last) < Number(first)) {
+    return undefined;
+  }
+
+  if (first === "") {
+    const suffix = Number(last);
+    if (suffix === 0 || size === 0) {
+      return { status: "unsatisfiable" };
+    }
+    return { status: "satisfiable", start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (start >= size) {
+    return { status: "unsatisfiable" };
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { status: "satisfiable", start, end };
+}
+
+/**
+ * Avalia `If-Range` (RFC 9110 §13.1.5) contra os validadores da resposta.
+ * Retorna `true` quando o intervalo pode ser atendido.
+ */
+export function matchIfRange(
+  ifRange: string | null,
+  validators: { etag?: string; lastModified?: string },
+): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  // Only strong validators can be compared, so a weak ETag on either side never matches.
+  if (ifRange.startsWith('"') || ifRange.startsWith("W/")) {
+    const { etag } = validators;
+    return (
+      !ifRange.startsWith("W/") && etag !== undefined && !etag.startsWith("W/") && ifRange === etag
+    );
+  }
+  return validators.lastModified !== undefined && ifRange === validators.lastModified;
+}
+
+/**
+ * Corta o corpo para os bytes `[start, end]` inclusivos.
+ * Retorna `undefined` quando o tipo não é cortável (`null`, `undefined`, `FormData`, ...).
+ */
+export function sliceBody(
+  body: BodyInit | null | undefined,
+  range: { start: number; end: number },
+): BodyInit | undefined {
+  const { start, end } = range;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(start, end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(start, end + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end);
+  }
+  return undefined;
+}
+
+// --- Internal Utils ---
+
+/**
+ * Reads the origin lazily: `highWaterMark: 0` means nothing is pulled until the client asks,
+ * and the origin is cancelled as soon as the chunk holding the last byte has been read.
+ */
+function sliceStream(body: ReadableStream, start: number, end: number): ReadableStream<Uint8Array> {
+  const reader = body.getReader();
+  let offset = 0;
+  return new ReadableStream<Uint8Array>(
+    {
+      async pull(controller) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const bytes = toUint8Array(value);
+        const chunkStart = offset;
+        offset += bytes.byteLength;
+        const from = Math.max(start - chunkStart, 0);
+        const to = Math.min(end + 1 - chunkStart, bytes.byteLength);
+        if (to > from) {
+          controller.enqueue(bytes.subarray(from, to));
+        }
+        if (offset > end) {
+          controller.close();
+          await reader.cancel();
+        }
+      },
+      cancel(reason) {
+        return reader.cancel(reason);
+      },
+    },
+    { highWaterMark: 0 },
+  );
+}
+
+function toUint8Array(chunk: unknown): Uint8Array {
+  if (typeof chunk === "string") {
+    return new TextEncoder().encode(chunk);
+  }
+  if (ArrayBuffer.isView(chunk)) {
+    return new Uint8Array(chunk.buffer, chunk.byteOffset, chunk.byteLength);
+  }
+  if (chunk instanceof ArrayBuffer) {
+    return new Uint8Array(chunk);
+  }
+  throw new TypeError("Unsupported stream chunk type");
+}
