+import { describe, it, expect } from "vitest";
+import { parseRange, matchIfRange, sliceBody } from "../../src/utils/internal/range.ts";
+
+const bytesOf = async (body: BodyInit | undefined) =>
+  new Uint8Array(await new Response(body).arrayBuffer());
+
+describe("parseRange", () => {
+  const cases: [string, number, ReturnType<typeof parseRange>][] = [
+    ["bytes=0-99", 1000, { status: "satisfiable", start: 0, end: 99 }],
+    ["bytes=100-", 1000, { status: "satisfiable", start: 100, end: 999 }],
+    ["bytes=-100", 1000, { status: "satisfiable", start: 900, end: 999 }],
+    ["bytes=-5000", 1000, { status: "satisfiable", start: 0, end: 999 }],
+    ["bytes=0-5000", 1000, { status: "satisfiable", start: 0, end: 999 }],
+    ["Bytes=0-9", 1000, { status: "satisfiable", start: 0, end: 9 }],
+    ["bytes=1000-1100", 1000, { status: "unsatisfiable" }],
+    ["bytes=1000-", 1000, { status: "unsatisfiable" }],
+    ["bytes=-0", 1000, { status: "unsatisfiable" }],
+    ["bytes=0-99", 0, { status: "unsatisfiable" }],
+    ["bytes=-5", 0, { status: "unsatisfiable" }],
+    ["bytes=5-2", 1000, undefined],
+    ["bytes=1000-100", 500, undefined],
+    ["bytes=0-1,5-6", 1000, undefined],
+    ["items=0-9", 1000, undefined],
+    ["bytes=", 1000, undefined],
+    ["bytes=-", 1000, undefined],
+    ["bytes=abc", 1000, undefined],
+  ];
+
+  for (const [header, size, expected] of cases) {
+    it(`${header} with size ${size}`, () => {
+      expect(parseRange(header, size)).toEqual(expected);
+    });
+  }
+});
+
+describe("matchIfRange", () => {
+  const etag = '"abc"';
+  const lastModified = "Tue, 14 Nov 2023 22:13:20 GMT";
+
+  it("matches when there is no If-Range", () => {
+    expect(matchIfRange(null, { etag, lastModified })).toBe(true);
+  });
+
+  it("matches the same strong ETag", () => {
+    expect(matchIfRange('"abc"', { etag, lastModified })).toBe(true);
+  });
+
+  it("does not match a different strong ETag", () => {
+    expect(matchIfRange('"xyz"', { etag, lastModified })).toBe(false);
+  });
+
+  it("never matches a weak ETag in the request", () => {
+    expect(matchIfRange('W/"abc"', { etag, lastModified })).toBe(false);
+  });
+
+  it("never matches when the asset ETag is weak", () => {
+    expect(matchIfRange('"abc"', { etag: 'W/"abc"', lastModified })).toBe(false);
+  });
+
+  it("never matches when both ETags are weak", () => {
+    expect(matchIfRange('W/"abc"', { etag: 'W/"abc"', lastModified })).toBe(false);
+  });
+
+  it("does not match an ETag when the asset has none", () => {
+    expect(matchIfRange('"abc"', { lastModified })).toBe(false);
+  });
+
+  it("matches the same date as Last-Modified", () => {
+    expect(matchIfRange(lastModified, { etag, lastModified })).toBe(true);
+  });
+
+  it("does not match a different date", () => {
+    expect(matchIfRange("Wed, 15 Nov 2023 22:13:20 GMT", { etag, lastModified })).toBe(false);
+  });
+
+  it("does not match an invalid date", () => {
+    expect(matchIfRange("not a date", { etag, lastModified })).toBe(false);
+  });
+
+  it("does not match a date when the asset has no Last-Modified", () => {
+    expect(matchIfRange(lastModified, { etag })).toBe(false);
+  });
+});
+
+describe("sliceBody", () => {
+  it("cuts a string by its UTF-8 bytes", async () => {
+    const part = sliceBody("ação", { start: 1, end: 2 });
+    expect(await bytesOf(part)).toEqual(new Uint8Array([0xc3, 0xa7]));
+  });
+
+  it("cuts an ArrayBuffer", async () => {
+    const buf = new Uint8Array([0, 1, 2, 3, 4, 5]).buffer;
+    expect(await bytesOf(sliceBody(buf, { start: 2, end: 4 }))).toEqual(new Uint8Array([2, 3, 4]));
+  });
+
+  it("cuts a Uint8Array with a non-zero byteOffset", async () => {
+    const backing = new Uint8Array(32).map((_, i) => i);
+    const view = new Uint8Array(backing.buffer, 4, 10); // bytes 4..13
+    expect(await bytesOf(sliceBody(view, { start: 2, end: 4 }))).toEqual(new Uint8Array([6, 7, 8]));
+  });
+
+  it("cuts a DataView", async () => {
+    const backing = new Uint8Array(32).map((_, i) => i);
+    const view = new DataView(backing.buffer, 4, 10); // bytes 4..13
+    expect(await bytesOf(sliceBody(view, { start: 0, end: 1 }))).toEqual(new Uint8Array([4, 5]));
+  });
+
+  it("cuts a Blob with slice", async () => {
+    const part = sliceBody(new Blob(["0123456789"]), { start: 2, end: 4 });
+    expect(part).toBeInstanceOf(Blob);
+    expect(await bytesOf(part)).toEqual(new Uint8Array([50, 51, 52]));
+  });
+
+  it("cuts a ReadableStream", async () => {
+    const source = new ReadableStream<Uint8Array>({
+      start(controller) {
+        controller.enqueue(new Uint8Array([0, 1, 2, 3]));
+        controller.enqueue(new Uint8Array([4, 5, 6, 7]));
+        controller.close();
+      },
+    });
+    expect(await bytesOf(sliceBody(source, { start: 2, end: 5 }))).toEqual(
+      new Uint8Array([2, 3, 4, 5]),
+    );
+  });
+
+  it("returns undefined for null and undefined", () => {
+    expect(sliceBody(null, { start: 0, end: 1 })).toBeUndefined();
+    expect(sliceBody(undefined, { start: 0, end: 1 })).toBeUndefined();
+  });
+
+  it("returns undefined for FormData and URLSearchParams", () => {
+    expect(sliceBody(new FormData(), { start: 0, end: 1 })).toBeUndefined();
+    expect(sliceBody(new URLSearchParams("a=1"), { start: 0, end: 1 })).toBeUndefined();
+  });
+});
+
+describe("sliceBody ReadableStream", () => {
+  const CHUNK = 64 * 1024;
+
+  // highWaterMark 0 on the origin, so `pulled` counts only the chunks the consumer read.
+  function createOrigin(totalChunks: number) {
+    const counter = { pulled: 0 };
+    const origin = new ReadableStream<Uint8Array>(
+      {
+        pull(controller) {
+          if (counter.pulled >= totalChunks) {
+            controller.close();
+            return;
+          }
+          const chunk = new Uint8Array(CHUNK).map((_, i) => (counter.pulled * CHUNK + i) % 251);
+          counter.pulled++;
+          controller.enqueue(chunk);
+        },
+      },
+      { highWaterMark: 0 },
+    );
+    return { origin, counter };
+  }
+
+  it("delivers only the requested bytes and stops pulling after the chunk with the last byte", async () => {
+    const { origin, counter } = createOrigin(160); // 10 MB
+    const part = sliceBody(origin, { start: 0, end: 99 }) as ReadableStream<Uint8Array>;
+    const bytes = await bytesOf(part);
+    expect(bytes.byteLength).toBe(100);
+    expect(bytes[99]).toBe(99 % 251);
+    expect(counter.pulled).toBe(1);
+  });
+
+  it("reads across a chunk boundary", async () => {
+    const { origin } = createOrigin(4);
+    const part = sliceBody(origin, {
+      start: CHUNK - 2,
+      end: CHUNK + 1,
+    }) as ReadableStream<Uint8Array>;
+    const bytes = await bytesOf(part);
+    expect(Array.from(bytes)).toEqual([
+      (CHUNK - 2) % 251,
+      (CHUNK - 1) % 251,
+      CHUNK % 251,
+      (CHUNK + 1) % 251,
+    ]);
+  });
+
+  it("ends without error when the origin is shorter than the range", async () => {
+    const { origin } = createOrigin(1);
+    const part = sliceBody(origin, { start: 0, end: 999_999 }) as ReadableStream<Uint8Array>;
+    expect((await bytesOf(part)).byteLength).toBe(CHUNK);
+  });
+
+  it("propagates cancel of the output stream to the origin", async () => {
+    let cancelled = false;
+    const origin = new ReadableStream<Uint8Array>(
+      {
+        pull(controller) {
+          controller.enqueue(new Uint8Array(CHUNK));
+        },
+        cancel() {
+          cancelled = true;
+        },
+      },
+      { highWaterMark: 0 },
+    );
+    const part = sliceBody(origin, { start: 0, end: 9 }) as ReadableStream<Uint8Array>;
+    const reader = part.getReader();
+    await reader.read();
+    await reader.cancel();
+    expect(cancelled).toBe(true);
+  });
+});
