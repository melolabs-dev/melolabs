diff --git a/test/session-unseal-passwords.test.ts b/test/session-unseal-passwords.test.ts
new file mode 100644
index 0000000..caffcf9
--- /dev/null
+++ b/test/session-unseal-passwords.test.ts
@@ -0,0 +1,171 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach } from "vitest";
+import { getSession, unsealSession, updateSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const oldPassword = "0000000000000000000000000000000000000000OLD";
+const newPassword = "1111111111111111111111111111111111111111NEW";
+const otherPassword = "2222222222222222222222222222222222222222OTH";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const sealWith = (
+  password: string,
+  data: Record<string, unknown> = { foo: "bar" },
+  createdAt = Date.now(),
+  options = sealDefaults,
+) => seal({ id: "old-session", createdAt, data }, password, options);
+
+const cookieValue = (setCookie: string) =>
+  decodeURIComponent(setCookie.match(/h3-test=([^;]+)/)![1]);
+
+describeMatrix("session unseal passwords", (t, { it, expect }) => {
+  const baseConfig: SessionConfig = {
+    name: "h3-test",
+    password: newPassword,
+    extraUnsealPasswords: [oldPassword],
+  };
+  // Config used by the routes below; each test may replace it.
+  let current: SessionConfig;
+
+  beforeEach(() => {
+    current = baseConfig;
+    t.app.get("/", async (event) => {
+      const session = await getSession(event, current);
+      return { session, symbols: Object.getOwnPropertySymbols(session).length };
+    });
+    t.app.get("/unseal", async (event) => {
+      try {
+        await unsealSession(event, current, event.req.headers.get("x-sealed")!);
+        return { ok: true };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/update", async (event) => {
+      await updateSession(event, current, { user: "x" });
+      return { ok: true };
+    });
+  });
+
+  it("restores a session sealed with an extra password", async () => {
+    const sealed = await sealWith(oldPassword);
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-session", createdAt: expect.any(Number), data: { foo: "bar" } },
+      symbols: 0,
+    });
+  });
+
+  it("reseals a session opened with an extra password using password", async () => {
+    const sealed = await sealWith(oldPassword);
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = cookieValue(setCookies[0]);
+    expect(await unseal(resealed, newPassword, sealDefaults)).toMatchObject({
+      id: "old-session",
+      data: { foo: "bar" },
+    });
+    await expect(unseal(resealed, oldPassword, sealDefaults)).rejects.toThrow();
+  });
+
+  it("seals only with password", async () => {
+    const res = await t.fetch("/update");
+    const sealed = cookieValue(res.headers.getSetCookie()[0]);
+    expect(await unseal(sealed, newPassword, sealDefaults)).toMatchObject({ data: { user: "x" } });
+    await expect(unseal(sealed, oldPassword, sealDefaults)).rejects.toThrow();
+  });
+
+  it("does not reseal or change anything without extra passwords", async () => {
+    const sealed = await sealWith(newPassword);
+    for (const extraUnsealPasswords of [undefined, []]) {
+      current = { name: "h3-test", password: newPassword, extraUnsealPasswords };
+      const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+      expect(res.headers.getSetCookie()).toHaveLength(0);
+      expect(await res.json()).toMatchObject({
+        session: { id: "old-session", data: { foo: "bar" } },
+      });
+    }
+  });
+
+  it("rejects an expired session opened with an extra password", async () => {
+    current = { ...baseConfig, maxAge: 60 };
+    const sealed = await sealWith(oldPassword, { foo: "bar" }, Date.now() - 120_000);
+    const unsealed = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+    expect(await unsealed.json()).toEqual({ error: "Session expired!" });
+
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+    const { session } = await res.json();
+    expect(session.id).not.toBe("old-session");
+    expect(session.data).toEqual({});
+  });
+
+  it("treats a session sealed with an unknown password as a wrong password", async () => {
+    const sealed = await sealWith(otherPassword);
+    const unsealed = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+    expect(await unsealed.json()).toEqual({ error: "Bad hmac value" });
+
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    const { session } = await res.json();
+    expect(session.id).not.toBe("old-session");
+    expect(session.data).toEqual({});
+  });
+
+  it("restores a legacy session sealed with an extra password", async () => {
+    const sealed = await sealWith(oldPassword, { foo: "bar" }, Date.now(), legacyOptions);
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-session", data: { foo: "bar" } },
+    });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    expect(await unseal(cookieValue(setCookies[0]), newPassword, sealDefaults)).toMatchObject({
+      id: "old-session",
+    });
+  });
+
+  it("rejects a legacy session sealed with an extra password with legacySealFallback: false", async () => {
+    current = { ...baseConfig, legacySealFallback: false };
+    const sealed = await sealWith(oldPassword, { foo: "bar" }, Date.now(), legacyOptions);
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+    const { session } = await res.json();
+    expect(session.id).not.toBe("old-session");
+    expect(session.data).toEqual({});
+  });
+
+  it("restores a session from the session header without resealing it", async () => {
+    const sealed = await sealWith(oldPassword);
+    const res = await t.fetch("/", { headers: { "x-h3-test-session": sealed } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-session", data: { foo: "bar" } },
+    });
+  });
+
+  it("skips an invalid extra password and keeps trying the rest", async () => {
+    current = { ...baseConfig, extraUnsealPasswords: ["", oldPassword] };
+    const sealed = await sealWith(oldPassword);
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-session", data: { foo: "bar" } },
+    });
+  });
+
+  it("tries extra passwords in order", async () => {
+    const olderPassword = "3333333333333333333333333333333333333333OLD";
+    current = { ...baseConfig, extraUnsealPasswords: [olderPassword, oldPassword] };
+    const sealed = await sealWith(oldPassword);
+    const res = await t.fetch("/", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-session", data: { foo: "bar" } },
+    });
+  });
+});
