@@ -0,0 +1,98 @@
+import { unseal, defaults as sealDefaults } from "./iron-crypto.ts";
+
+import type { SealOptions } from "./iron-crypto.ts";
+import type { SessionConfig } from "../session.ts";
+
+export interface UnsealAttempt {
+  /** Payload as returned by `unseal`, before expiration checks. */
+  unsealed: unknown;
+  /** Opened with the legacy 1-iteration fallback. */
+  legacy: boolean;
+  /** Opened with a password from `extraUnsealPasswords`. */
+  fromExtra: boolean;
+}
+
+/**
+ * Throws if an extra password is shorter than the minimum `unseal` enforces.
+ * Runs before any read, so a bad extra password is never hidden by the
+ * read error handling in `getSession`.
+ */
+export function assertExtraUnsealPasswords(config: SessionConfig): void {
+  const min = minPasswordLength(config);
+  for (const password of config.extraUnsealPasswords ?? []) {
+    if (password.length < min) {
+      throw new Error(`Password string too short (min ${min} characters required)`);
+    }
+  }
+}
+
+/**
+ * Tries `primary`, then each of `extra`, in order. Each candidate gets the
+ * current options and then the legacy 1-iteration fallback. Only `Bad hmac
+ * value` moves on to the next candidate; any other error is rethrown. If every
+ * candidate fails, the last error is rethrown.
+ */
+export async function unsealWithPasswords(
+  sealed: string,
+  primary: string,
+  extra: readonly string[],
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<UnsealAttempt> {
+  const candidates = [primary, ...extra];
+  let lastError: unknown;
+  for (const [index, password] of candidates.entries()) {
+    try {
+      const { unsealed, legacy } = await unsealOne(
+        sealed,
+        password,
+        sealOptions,
+        legacySealFallback,
+      );
+      return { unsealed, legacy, fromExtra: index > 0 };
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+async function unsealOne(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<{ unsealed: unknown; legacy: boolean }> {
+  try {
+    return { unsealed: await unseal(sealed, password, sealOptions), legacy: false };
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (!legacySealFallback || sealOptions.integrity.iterations === 1 || !isBadHmac(error)) {
+      throw error;
+    }
+    const unsealed = await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    });
+    return { unsealed, legacy: true };
+  }
+}
+
+/** Shortest password `unseal` accepts, for both encryption and integrity. */
+function minPasswordLength(config: SessionConfig): number {
+  const { encryption, integrity } = { ...sealDefaults, ...config.seal };
+  return Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
