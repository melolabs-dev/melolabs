+function parseByteRange(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, rawStart = "", rawEnd = ""] = match;
+  if (rawStart === "" && rawEnd === "") {
+    return undefined;
+  }
+  const start = rawStart === "" ? undefined : Number(rawStart);
+  const end = rawEnd === "" ? undefined : Number(rawEnd);
+  if (start !== undefined && end !== undefined && start > end) {
+    return undefined;
+  }
+  if (size === 0) {
+    return "unsatisfiable";
+  }
+  if (start === undefined) {
+    // Suffix `bytes=-n`: the last `n` bytes, or the whole file when `n` is larger.
+    if (end === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - end!), end: size - 1 };
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: end === undefined ? size - 1 : Math.min(end, size - 1) };
+}
+
+/**
+ * Strong comparison for ETags (a weak validator never matches), exact equality
+ * for dates against the `Last-Modified` value we send (RFC 9110 section 13.1.5).
+ */
+function matchesIfRange(
+  ifRange: string,
+  representation: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange.startsWith('"') || ifRange.startsWith("W/")) {
+    const { etag } = representation;
+    return etag !== undefined && !etag.startsWith("W/") && etag === ifRange;
+  }
+  return (
+    representation.lastModified !== undefined &&
+    new Date(ifRange).getTime() === representation.lastModified.getTime()
+  );
+}
+
+/** Cut the bytes of `range` out of whatever `getContents` returned, without reading more than needed for common bodies. */
+async function sliceContents(
+  contents: BodyInit | null | undefined,
+  range: ByteRange,
+): Promise<BodyInit | null> {
+  if (contents === null || contents === undefined) {
+    return null;
+  }
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, range);
+  }
+  const blob = contents instanceof Blob ? contents : await new Response(contents).blob();
+  return blob.slice(range.start, range.end + 1);
+}
+
+/** Skip bytes before `range.start` and stop reading once the range is done. */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  range: ByteRange,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let skip = range.start;
+  let remaining = range.end - range.start + 1;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const drop = Math.min(skip, value.byteLength);
+        skip -= drop;
+        const chunk = value.subarray(drop, drop + remaining);
+        remaining -= chunk.byteLength;
+        if (remaining === 0) {
+          await reader.cancel();
+          controller.enqueue(chunk);
+          controller.close();
+          return;
+        }
+        if (chunk.byteLength > 0) {
+          controller.enqueue(chunk);
+          return;
+        }
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
