+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Decide how to answer a `Range` request. `full` covers "no range", "range does
+ * not apply" and "encoded representation" alike (RFC 9110 sections 13.1.5, 14.2).
+ */
+function evaluateRange(
+  headers: Headers,
+  representation: {
+    size: number;
+    etag?: string;
+    lastModified?: Date;
+    encoded: boolean;
+  },
+): RangeEvaluation {
+  const range = headers.get("range");
+  if (range === null || representation.encoded) {
+    return { kind: "full" };
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(ifRange, representation)) {
+    return { kind: "full" };
+  }
+  const parsed = parseByteRange(range, representation.size);
+  if (parsed === undefined) {
+    return { kind: "full" };
+  }
+  if (parsed === "unsatisfiable") {
+    return { kind: "unsatisfiable" };
+  }
+  return { kind: "partial", range: parsed };
