+import { describe, expect, it } from "vitest";
+import { resolveByteRange, sliceBody } from "../../src/utils/internal/range.ts";
+
+function rangeHeaders(range: string, extra: Record<string, string> = {}): Headers {
+  return new Headers({ range, ...extra });
+}
+
+describe("resolveByteRange", () => {
+  const size = 1000;
+
+  it.each([
+    ["bytes=0-499", 0, 499],
+    ["bytes=900-", 900, 999],
+    ["bytes=-100", 900, 999],
+    ["BYTES=0-1", 0, 1],
+    ["  bytes=0-1  ", 0, 1],
+  ])("parses %s as a partial range", (value, start, end) => {
+    expect(resolveByteRange(rangeHeaders(value), { size })).toEqual({
+      type: "partial",
+      start,
+      end,
+    });
+  });
+
+  it.each([
+    "bytes=abc",
+    "bytes=0-1,5-9",
+    "items=0-4",
+    "bytes=5-3",
+    "bytes=-",
+    "bytes=+1-2",
+    "bytes= 0-1",
+    "bytes=0 - 1",
+  ])("ignores malformed or unsupported %s", (value) => {
+    expect(resolveByteRange(rangeHeaders(value), { size })).toBeUndefined();
+  });
+
+  it("clamps the end to the last byte", () => {
+    expect(resolveByteRange(rangeHeaders("bytes=0-5000"), { size })).toEqual({
+      type: "partial",
+      start: 0,
+      end: 999,
+    });
+  });
+
+  it("starts a suffix longer than the asset at byte 0", () => {
+    expect(resolveByteRange(rangeHeaders("bytes=-5000"), { size })).toEqual({
+      type: "partial",
+      start: 0,
+      end: 999,
+    });
+  });
+
+  it.each([
+    ["bytes=1000-", 1000],
+    ["bytes=-0", 1000],
+    ["bytes=0-", 0],
+  ])("reports %s as unsatisfiable", (value, assetSize) => {
+    expect(resolveByteRange(rangeHeaders(value), { size: assetSize })).toEqual({
+      type: "unsatisfiable",
+    });
+  });
+
+  it("returns undefined when there is no Range header", () => {
+    expect(resolveByteRange(new Headers(), { size })).toBeUndefined();
+  });
+
+  describe("If-Range", () => {
+    const lastModified = new Date(1_700_000_000_000);
+
+    it("applies the range when the strong entity-tag matches", () => {
+      const headers = rangeHeaders("bytes=0-99", { "if-range": '"abc"' });
+      expect(resolveByteRange(headers, { size, etag: '"abc"' })).toEqual({
+        type: "partial",
+        start: 0,
+        end: 99,
+      });
+    });
+
+    it("ignores the range when the entity-tag differs", () => {
+      const headers = rangeHeaders("bytes=0-99", { "if-range": '"xyz"' });
+      expect(resolveByteRange(headers, { size, etag: '"abc"' })).toBeUndefined();
+    });
+
+    it("never matches a weak entity-tag", () => {
+      const headers = rangeHeaders("bytes=0-99", { "if-range": 'W/"abc"' });
+      expect(resolveByteRange(headers, { size, etag: 'W/"abc"' })).toBeUndefined();
+      expect(resolveByteRange(headers, { size, etag: '"abc"' })).toBeUndefined();
+    });
+
+    it("never matches a weak asset entity-tag", () => {
+      const headers = rangeHeaders("bytes=0-99", { "if-range": '"abc"' });
+      expect(resolveByteRange(headers, { size, etag: 'W/"abc"' })).toBeUndefined();
+    });
+
+    it("applies the range when the HTTP date equals lastModified", () => {
+      const headers = rangeHeaders("bytes=0-99", {
+        "if-range": lastModified.toUTCString(),
+      });
+      expect(resolveByteRange(headers, { size, lastModified })).toEqual({
+        type: "partial",
+        start: 0,
+        end: 99,
+      });
+    });
+
+    it("ignores the range when the HTTP date differs", () => {
+      const headers = rangeHeaders("bytes=0-99", {
+        "if-range": new Date(1_600_000_000_000).toUTCString(),
+      });
+      expect(resolveByteRange(headers, { size, lastModified })).toBeUndefined();
+    });
+
+    it("ignores the range when the asset has no validator to compare", () => {
+      const headers = rangeHeaders("bytes=0-99", { "if-range": '"abc"' });
+      expect(resolveByteRange(headers, { size })).toBeUndefined();
+    });
+
+    it("applies the range when If-Range is absent", () => {
+      expect(
+        resolveByteRange(rangeHeaders("bytes=0-99"), { size, etag: '"abc"', lastModified }),
+      ).toEqual({ type: "partial", start: 0, end: 99 });
+    });
+  });
+});
+
+describe("sliceBody", () => {
+  async function bytesOf(body: BodyInit | null): Promise<number[]> {
+    if (body === null) {
+      return [];
+    }
+    return [...new Uint8Array(await new Response(body).arrayBuffer())];
+  }
+
+  it("returns null when there is no body", async () => {
+    expect(sliceBody(null, { start: 0, end: 1 })).toBeNull();
+    expect(sliceBody(undefined, { start: 0, end: 1 })).toBeNull();
+  });
+
+  it("slices a Uint8Array by bytes", async () => {
+    const body = new Uint8Array([0, 1, 2, 3, 4, 5]);
+    expect(await bytesOf(sliceBody(body, { start: 2, end: 4 }))).toEqual([2, 3, 4]);
+  });
+
+  it("slices an ArrayBuffer by bytes", async () => {
+    const body = new Uint8Array([0, 1, 2, 3, 4, 5]).buffer;
+    expect(await bytesOf(sliceBody(body, { start: 0, end: 1 }))).toEqual([0, 1]);
+  });
+
+  it("slices a Blob without reading it", async () => {
+    const blob = new Blob([new Uint8Array([0, 1, 2, 3, 4, 5])]);
+    expect(await bytesOf(sliceBody(blob, { start: 3, end: 5 }))).toEqual([3, 4, 5]);
+  });
+
+  it("slices a string by its UTF-8 bytes, not by characters", async () => {
+    // "aéb" is 4 bytes: 61 c3 a9 62. Bytes 1-2 are the two bytes of "é".
+    expect(await bytesOf(sliceBody("aéb", { start: 1, end: 2 }))).toEqual([0xc3, 0xa9]);
+  });
+
+  it("slices a ReadableStream across chunk boundaries", async () => {
+    const stream = new ReadableStream<Uint8Array>({
+      start(controller) {
+        controller.enqueue(new Uint8Array([0, 1, 2]));
+        controller.enqueue(new Uint8Array([3, 4, 5]));
+        controller.enqueue(new Uint8Array([6, 7, 8, 9]));
+        controller.close();
+      },
+    });
+    expect(await bytesOf(sliceBody(stream, { start: 2, end: 6 }))).toEqual([2, 3, 4, 5, 6]);
+  });
+
+  it("stops reading a ReadableStream after the end byte", async () => {
+    let pulls = 0;
+    const stream = new ReadableStream<Uint8Array>({
+      pull(controller) {
+        pulls++;
+        controller.enqueue(new Uint8Array([pulls, pulls, pulls, pulls]));
+        if (pulls === 100) {
+          controller.close();
+        }
+      },
+    });
+    expect(await bytesOf(sliceBody(stream, { start: 0, end: 3 }))).toEqual([1, 1, 1, 1]);
+    expect(pulls).toBeLessThan(100);
+  });
+});
