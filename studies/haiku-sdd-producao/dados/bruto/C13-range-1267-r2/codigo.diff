+    const res = await t.fetch("/missing.bin", { headers: { range: "bytes=0-99" } });
+
+    expect(res.status).toBe(404);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("keeps 405 for unsupported methods even with Range (RF-11)", async () => {
+    const res = await t.fetch("/video.bin", {
+      method: "POST",
+      headers: { range: "bytes=0-99" },
+    });
+
+    expect(res.status).toBe(405);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("keeps the full response unchanged apart from Accept-Ranges (RF-11)", async () => {
+    const res = await t.fetch("/video.bin");
+
+    expect(res.status).toBe(200);
+    expect(res.headers.get("etag")).toBe('"abc"');
+    expect(res.headers.get("last-modified")).toBe(new Date(MTIME).toUTCString());
+    expect(res.headers.get("content-type")).toBe("application/octet-stream");
+  });
+
+  it("overrides a Content-Length set in options.headers on 206", async () => {
+    options.headers = { "content-length": "999" };
+
+    const res = await t.fetch("/video.bin", { headers: { range: "bytes=0-9" } });
+
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("10");
+  });
+
+  it("slices string, Blob and ReadableStream bodies on 206", async () => {
+    const text = Array.from({ length: SIZE }, (_, i) => String.fromCharCode(97 + (i % 26))).join(
+      "",
+    );
+    const expected = text.slice(0, 500);
+    const bodies: Record<string, () => BodyInit> = {
+      string: () => text,
+      Blob: () => new Blob([text]),
+      ReadableStream: () =>
+        new ReadableStream<Uint8Array>({
+          start(controller) {
+            const bytes = new TextEncoder().encode(text);
+            for (let i = 0; i < bytes.length; i += 333) {
+              controller.enqueue(bytes.slice(i, i + 333));
+            }
+            controller.close();
+          },
+        }),
+    };
+
+    for (const [kind, makeBody] of Object.entries(bodies)) {
+      options.getContents = vi.fn(makeBody);
+
+      const res = await t.fetch("/video.txt", { headers: { range: "bytes=0-499" } });
+
+      expect(res.status, kind).toBe(206);
+      expect(res.headers.get("content-length"), kind).toBe("500");
+      expect(await res.text(), kind).toBe(expected);
+    }
+  });
+
+  it("does not read the body on 416", async () => {
+    await t.fetch("/video.bin", { headers: { range: "bytes=2000-3000" } });
+
+    expect(options.getContents).not.toHaveBeenCalled();
+  });
+
+  it("returns 416 for a range on an empty asset and 200 without Range (size 0)", async () => {
+    options.getMeta = vi.fn(() => ({ size: 0 }));
+    options.getContents = vi.fn(() => new Uint8Array(0));
+
+    const ranged = await t.fetch("/empty.bin", { headers: { range: "bytes=0-" } });
+    expect(ranged.status).toBe(416);
+    expect(ranged.headers.get("content-range")).toBe("bytes */0");
+
+    const full = await t.fetch("/empty.bin");
+    expect(full.status).toBe(200);
+    // The size is not used as Content-Length. The node adapter adds `0` for an empty body.
+    expect(full.headers.get("content-length") ?? "0").toBe("0");
+    expect(full.headers.get("content-range")).toBeNull();
+    expect(full.headers.get("accept-ranges")).toBe("bytes");
+  });
+});
