+  it("ignores Range when the asset size is unknown (RF-09)", async () => {
+    options.getMeta = vi.fn(() => ({ etag: '"abc"', mtime: MTIME }));
+    options.getContents = vi.fn(() => "full body");
+
+    const res = await t.fetch("/video.txt", { headers: { range: "bytes=0-99" } });
+
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("full body");
+  });
