@@ -0,0 +1,252 @@
+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const SIZE = 1000;
+const MTIME = 1_700_000_000_000;
+const CONTENT = new Uint8Array(SIZE).map((_, i) => i % 256);
+
+function bytesOf(buffer: ArrayBuffer): number[] {
+  return [...new Uint8Array(buffer)];
+}
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let options: ServeStaticOptions;
+
+  beforeEach(() => {
+    options = {
+      getMeta: vi.fn(() => ({
+        type: "application/octet-stream",
+        etag: '"abc"',
+        mtime: MTIME,
+        size: SIZE,
+      })),
+      getContents: vi.fn(() => CONTENT),
+    };
+
+    t.app.all("/**", (event) => serveStatic(event, options));
+  });
+
+  it("advertises Accept-Ranges on a full response (RF-01)", async () => {
+    const res = await t.fetch("/video.bin");
+
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-length")).toBe(String(SIZE));
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(bytesOf(await res.arrayBuffer())).toEqual([...CONTENT]);
+  });
+
+  it("responds 206 with the requested bytes (RF-02)", async () => {
+    const res = await t.fetch("/video.bin", { headers: { range: "bytes=0-499" } });
+
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe(`bytes 0-499/${SIZE}`);
+    expect(res.headers.get("content-length")).toBe("500");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(bytesOf(await res.arrayBuffer())).toEqual([...CONTENT.subarray(0, 500)]);
+  });
+
+  it("accepts open-ended and suffix ranges (RF-03)", async () => {
+    for (const range of ["bytes=900-", "bytes=-100"]) {
+      const res = await t.fetch("/video.bin", { headers: { range } });
+
+      expect(res.status, range).toBe(206);
+      expect(res.headers.get("content-range"), range).toBe(`bytes 900-999/${SIZE}`);
+      expect(res.headers.get("content-length"), range).toBe("100");
+      expect(bytesOf(await res.arrayBuffer()), range).toEqual([...CONTENT.subarray(900)]);
+    }
+  });
+
+  it("responds 416 for an unsatisfiable range (RF-04)", async () => {
+    const res = await t.fetch("/video.bin", { headers: { range: "bytes=2000-3000" } });
+
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe(`bytes */${SIZE}`);
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  it("ignores malformed, multiple or foreign-unit ranges (RF-05)", async () => {
+    for (const range of ["bytes=abc", "bytes=0-1,5-9", "items=0-4"]) {
+      const res = await t.fetch("/video.bin", { headers: { range } });
+
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(res.headers.get("content-length"), range).toBe(String(SIZE));
+      expect(bytesOf(await res.arrayBuffer()), range).toEqual([...CONTENT]);
+    }
+  });
+
+  it("ignores the range when If-Range does not match (RF-06)", async () => {
+    const res = await t.fetch("/video.bin", {
+      headers: { range: "bytes=0-99", "if-range": '"xyz"' },
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(bytesOf(await res.arrayBuffer())).toEqual([...CONTENT]);
+  });
+
+  it("applies the range when If-Range matches the strong ETag (RF-06)", async () => {
+    const res = await t.fetch("/video.bin", {
+      headers: { range: "bytes=0-99", "if-range": '"abc"' },
+    });
+
+    expect(res.status).toBe(206);
+    expect(bytesOf(await res.arrayBuffer())).toEqual([...CONTENT.subarray(0, 100)]);
+  });
+
+  it("evaluates cache validators before Range (RF-07)", async () => {
+    const res = await t.fetch("/video.bin", {
+      headers: { range: "bytes=0-99", "if-none-match": '"abc"' },
+    });
+
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds to HEAD with 206 headers and an empty body (RF-08)", async () => {
+    const res = await t.fetch("/video.bin", {
