+/** Byte interval with inclusive `start` and `end`. */
+export type ByteRange = { type: "partial"; start: number; end: number };
+
+export type ByteRangeResult = ByteRange | { type: "unsatisfiable" };
+
+export interface RangeValidators {
+  size: number;
+  etag?: string;
+  lastModified?: Date;
+}
+
+/**
+ * Resolve the `Range` request header against the current representation.
+ *
+ * Returns `undefined` when the full response should be sent instead: no `Range`,
+ * a malformed, multiple or foreign-unit `Range` (RFC 9110 section 14.2 allows
+ * ignoring it), or an `If-Range` that does not match (section 13.1.5).
+ * `If-Range` is checked before `Range`, so a stale validator never produces a 416.
+ */
+export function resolveByteRange(
+  headers: Headers,
+  validators: RangeValidators,
+): ByteRangeResult | undefined {
+  const range = headers.get("range");
+  if (!range) {
+    return undefined;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(ifRange.trim(), validators)) {
+    return undefined;
+  }
+  return parseRangeHeader(range.trim(), validators.size);
+}
+
+/**
+ * Slice a response body to the bytes `[start, end]`, both inclusive.
+ *
+ * Strings, buffers and blobs are sliced directly. Streams and other `BodyInit`
+ * values are read from the beginning and the bytes before `start` are discarded,
+ * so the I/O of a seek on a stream grows with `start`. Assets that can be sliced
+ * directly (`Blob`, `Uint8Array`, `ArrayBuffer`) do not have this cost.
+ */
+export function sliceBody(
+  body: BodyInit | null | undefined,
+  range: Pick<ByteRange, "start" | "end">,
+): BodyInit | null {
+  if (body === null || body === undefined) {
+    return null;
+  }
+  const { start } = range;
+  const endExclusive = range.end + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).slice(start, endExclusive);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, endExclusive);
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(start, endExclusive);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).slice(start, endExclusive);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, endExclusive);
+  }
+  const stream = new Response(body).body;
+  return stream ? sliceStream(stream, start, endExclusive) : null;
+}
+
+// Only the byte-range-spec form is accepted (RFC 9110 section 14.1.1).
+// Whitespace around `-` is not part of the grammar, so it is rejected.
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+function parseRangeHeader(value: string, size: number): ByteRangeResult | undefined {
+  const match = RANGE_RE.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  if (first === "") {
+    // Suffix range: the last `length` bytes, or the whole asset when it is shorter.
+    const length = Number(last);
+    if (length === 0 || size === 0) {
+      return { type: "unsatisfiable" };
+    }
+    return { type: "partial", start: Math.max(0, size - length), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last === "" ? Infinity : Number(last);
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return { type: "unsatisfiable" };
+  }
+  return { type: "partial", start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * An entity-tag `If-Range` matches only a strong validator that is identical
+ * (RFC 9110 section 13.1.5). Any other value is an HTTP date, compared at second
+ * precision because `Last-Modified` is truncated to whole seconds.
+ */
+function matchesIfRange(value: string, validators: RangeValidators): boolean {
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const { etag } = validators;
+    return !!etag && !etag.startsWith("W/") && etag === value;
+  }
+  if (!validators.lastModified) {
+    return false;
+  }
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) {
+    return false;
+  }
+  return toSeconds(date) === toSeconds(validators.lastModified);
+}
+
+function toSeconds(date: Date): number {
+  return Math.floor(date.getTime() / 1000);
+}
+
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  endExclusive: number,
+): ReadableStream<Uint8Array> {
+  let offset = 0;
+  return stream.pipeThrough(
+    new TransformStream<Uint8Array, Uint8Array>({
+      transform(chunk, controller) {
+        const chunkStart = offset;
+        const chunkEnd = offset + chunk.byteLength;
+        offset = chunkEnd;
+        if (chunkEnd <= start) {
+          return;
+        }
+        const from = Math.max(0, start - chunkStart);
+        const to = Math.min(chunk.byteLength, endExclusive - chunkStart);
+        controller.enqueue(chunk.subarray(from, to));
+        if (chunkEnd >= endExclusive) {
+          // Closing the readable side also cancels the upstream stream.
+          controller.terminate();
+        }
+      },
+    }),
+  );
+}
