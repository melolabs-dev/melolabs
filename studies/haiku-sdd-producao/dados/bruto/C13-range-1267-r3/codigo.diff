+type ByteRange = { start: number; end: number }; // inclusive
+
+// A single `bytes` range: `a-b`, `a-` or `-n` (RFC 9110 section 14.1.2).
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Parse a `Range` header for one byte range. Returns `undefined` when the header
+ * must be ignored (RFC 9110 section 14.2), or `"unsatisfiable"` for a range that
+ * selects no byte of an asset of `size` bytes.
+ */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+
+  if (first === "") {
+    // Suffix range: the last `n` bytes, or the whole asset when `n` is larger.
+    const suffix = Number(last);
+    if (suffix === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { start, end };
+}
+
+/**
+ * `If-Range` matches a strong ETag equal to the current one, or an HTTP date equal
+ * to `Last-Modified` (RFC 9110 section 13.1.5). A weak ETag never matches, and
+ * neither does anything that is neither.
+ */
+function isIfRangeMatch(value: string, validators: { etag?: string; mtime?: Date }): boolean {
+  if (value.startsWith("W/")) {
+    return false;
+  }
+  if (value.startsWith('"')) {
+    return value === validators.etag;
+  }
+  return !!validators.mtime && new Date(value).getTime() === validators.mtime.getTime();
+}
+
+function setRangeHeaders(headers: Headers, range: ByteRange, size: number): void {
+  headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  headers.set("content-length", `${range.end - range.start + 1}`);
+}
+
+/** Cut `body` down to the bytes of `range`. Every cut is by byte, never by character. */
+async function sliceBody(body: BodyInit, range: ByteRange): Promise<BodyInit> {
+  const { start, end } = range;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(start, end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(start, end + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, range);
+  }
+  const bytes = new Uint8Array(await new Response(body).arrayBuffer());
+  return bytes.subarray(start, end + 1);
+}
+
+/** Skip the bytes before `range` and close the source once `range` has ended. */
+function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  range: ByteRange,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let offset = 0; // bytes read from the source so far
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const { done, value } = await reader.read();
+      if (done) {
+        controller.close();
+        return;
+      }
+      const chunkStart = offset;
+      offset += value.byteLength;
+      const from = Math.max(range.start - chunkStart, 0);
+      const to = Math.min(range.end + 1 - chunkStart, value.byteLength);
+      if (from < to) {
+        controller.enqueue(value.subarray(from, to));
+      }
+      if (offset > range.end) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
