+/**
+ * Throw if an `extraUnsealPasswords` item is invalid. Extras follow the same
+ * length rule `iron` applies to `password`, so a bad one fails loudly here instead
+ * of looking like an expired session.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig, sealOptions: SealOptions): void {
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const [index, password] of (config.extraUnsealPasswords ?? []).entries()) {
+    if (typeof password !== "string" || password.length < minLength) {
+      throw new Error(
+        `Invalid extraUnsealPasswords[${index}]: must be a string of at least ${minLength} characters`,
+      );
+    }
+  }
