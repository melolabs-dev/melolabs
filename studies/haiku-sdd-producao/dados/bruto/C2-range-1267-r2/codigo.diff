+describeMatrix("serve static range requests", (t, { it, expect }) => {
+  const body = "abcdefghij".repeat(100);
+  const meta = {
+    size: 1000,
+    etag: '"abc"',
+    mtime: 1_700_000_000_000,
+    type: "text/plain",
+  };
+
+  function serve(options: Partial<ServeStaticOptions> = {}) {
+    t.app.all("/**", (event) =>
+      serveStatic(event, {
+        getMeta: () => meta,
+        getContents: () => body,
+        ...options,
+      }),
+    );
+  }
+
+  function chunkedStream(text: string, chunkSize: number) {
+    const bytes = new TextEncoder().encode(text);
+    return new ReadableStream<Uint8Array>({
+      start(controller) {
+        for (let i = 0; i < bytes.length; i += chunkSize) {
+          controller.enqueue(bytes.slice(i, i + chunkSize));
+        }
+        controller.close();
+      },
+    });
+  }
+
+  it("announces byte ranges on GET without a Range header", async () => {
+    serve();
+    const res = await t.fetch("/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(body);
+  });
+
+  it("announces byte ranges on HEAD without a Range header", async () => {
+    serve();
+    const res = await t.fetch("/file.txt", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  it("keeps 304 precedence over Range and still announces byte ranges", async () => {
+    serve();
+    const res = await t.fetch("/file.txt", {
+      headers: { "if-none-match": '"abc"', range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  it("does not run Range handling for POST", async () => {
+    serve();
+    const res = await t.fetch("/file.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(405);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("serves a 206 for bytes=start-end", async () => {
+    serve();
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 100-199/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(body.slice(100, 200));
+  });
+
+  it("serves a 206 without body for HEAD suffix ranges and skips getContents", async () => {
+    const getContents = vi.fn(() => body);
+    serve({ getContents });
+    const res = await t.fetch("/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=-50" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 950-999/1000");
+    expect(res.headers.get("content-length")).toBe("50");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("clamps open-ended and oversized ranges to the asset size", async () => {
+    serve();
+    const open = await t.fetch("/file.txt", { headers: { range: "bytes=990-" } });
+    expect(open.status).toBe(206);
+    expect(open.headers.get("content-range")).toBe("bytes 990-999/1000");
+    expect(await open.text()).toBe(body.slice(990));
+
+    const overEnd = await t.fetch("/file.txt", { headers: { range: "bytes=900-5000" } });
+    expect(overEnd.status).toBe(206);
+    expect(overEnd.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(await overEnd.text()).toBe(body.slice(900));
+  });
+
+  it("serves the whole asset as 206 for a suffix longer than the asset", async () => {
+    serve();
