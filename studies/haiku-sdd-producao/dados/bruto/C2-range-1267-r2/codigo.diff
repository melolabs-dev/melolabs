+
+/** Inclusive byte range, already clamped to the asset size. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Decide which `Range` to apply to the response (RFC 9110 sections 13.1.5, 13.2.2 and 14).
+ *
+ * Returns `undefined` to ignore `Range` and answer `200` with the full asset, or
+ * `"unsatisfiable"` for `416`. Conditional cache checks run before this, so `Range`
+ * is never evaluated for a `304`.
+ *
+ * `If-Range` is checked only after `Range` parses, so a non-applicable `Range`
+ * never changes the outcome. Multiple ranges are ignored as a whole rather than
+ * served as `multipart/byteranges`, which is out of scope.
+ */
+function resolveByteRange(
+  headers: Headers,
+  validators: { size: number; etag?: string; lastModified?: Date },
+): ByteRange | "unsatisfiable" | undefined {
+  const value = headers.get("range");
+  if (value === null) {
+    return undefined;
+  }
+  const range = parseRange(value, validators.size);
+  if (range === undefined) {
+    return undefined;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, validators)) {
+    return undefined;
+  }
+  return range;
+}
+
+/** Parse a single `bytes=a-b`, `bytes=a-` or `bytes=-n` spec against `size` (> 0). */
+function parseRange(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+
+  if (first === "") {
+    if (last === "") {
+      return undefined;
+    }
+    // `bytes=-n` is the last `n` bytes. A zero-length suffix selects nothing.
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  const end = last === "" ? Infinity : Number(last);
+  // A last position before the first is syntactically invalid, so the header is ignored.
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * Evaluate `If-Range` (RFC 9110 section 13.1.5). Only a strong ETag matches by
+ * exact comparison, and a weak ETag never does. A date matches by equality with
+ * `Last-Modified`, which is truncated to whole seconds.
+ */
+function ifRangeMatches(
+  value: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (validators.etag && !validators.etag.startsWith("W/") && value === validators.etag) {
+    return true;
+  }
+  if (validators.lastModified) {
+    return new Date(value).getTime() === validators.lastModified.getTime();
+  }
+  return false;
+}
+
+/**
+ * Slice a body to the range. `undefined` means the body cannot be sliced safely,
+ * so the caller answers `200` with the full body.
+ *
+ * Strings, buffers and blobs are sliced without reading the rest. A stream is
+ * read and discarded up to the range start, then cancelled after the range end.
+ */
+function sliceBody(body: BodyInit | null | undefined, range: ByteRange): BodyInit | undefined {
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(range.start, range.end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).subarray(range.start, range.end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(
+      range.start,
+      range.end + 1,
+    );
+  }
+  if (body instanceof Blob) {
+    return body.slice(range.start, range.end + 1);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, range);
+  }
+  return undefined;
+}
+
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  range: ByteRange,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  // Offset of the first byte of the next chunk.
+  let offset = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const { done, value } = await reader.read();
+      if (done) {
+        controller.close();
+        return;
+      }
+      const chunkStart = offset;
+      offset += value.byteLength;
+      if (offset <= range.start) {
+        return;
+      }
+      const from = Math.max(range.start - chunkStart, 0);
+      const to = Math.min(range.end + 1 - chunkStart, value.byteLength);
+      controller.enqueue(value.subarray(from, to));
+      if (offset > range.end) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
+
+function partialResponse(
+  event: H3Event,
+  body: BodyInit | null,
+  range: ByteRange,
+  size: number,
+): HTTPResponse {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+  return new HTTPResponse(body, { status: 206, statusText: "Partial Content" });
+}
