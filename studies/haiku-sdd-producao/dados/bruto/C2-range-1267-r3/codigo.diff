+    return new TextEncoder().encode(contents).subarray(start, end);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return new Uint8Array(contents, start, length);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset + start, length);
+  }
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, start, end);
+  }
