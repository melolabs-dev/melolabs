+
+/**
+ * Unseal with `password`, then with each extra in turn, until one validates the
+ * seal. Only a wrong password (`Bad hmac value`) moves on: any other error does
+ * not depend on the password, so retrying would repeat the work for nothing.
+ * When none validates, the first attempt's error is thrown.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  let firstError: unknown;
+  for (const [index, password] of unsealPasswords(config).entries()) {
+    try {
+      const unsealed = await unsealWithPassword(
+        sealed,
+        password,
+        sealOptions,
+        config.legacySealFallback,
+      );
+      if (index > 0) {
+        // Getting here means an extra password opened it, so mark it for a reseal
+        (unsealed as any)[kRotatedSeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (index === 0) {
+        firstError = error;
+      }
+      if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+        throw error;
+      }
+    }
+  }
+  throw firstError;
+}
+
+/**
+ * One unseal attempt with a single password, including the legacy 1-iteration
+ * fallback.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean | undefined,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+/**
+ * Passwords tried to unseal a session, in order: `password` first, then each
+ * extra. An extra equal to `password` is dropped, so it does not cost a second
+ * PBKDF2 pass for the same key.
+ */
+function unsealPasswords(config: SessionConfig): string[] {
+  const passwords = [config.password];
+  for (const password of config.extraUnsealPasswords || []) {
+    if (!passwords.includes(password)) {
+      passwords.push(password);
+    }
+  }
+  return passwords;
+}
+
+/**
+ * Throws if `extraUnsealPasswords` is malformed. The message names the index but
+ * never the value, so a bad entry cannot leak into logs.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig, sealOptions: SealOptions): void {
+  const extras = config.extraUnsealPasswords;
+  if (extras === undefined) {
+    return;
+  }
+  if (!Array.isArray(extras)) {
+    throw new Error("Invalid session config: extraUnsealPasswords must be an array of strings");
+  }
+  // The length iron requires of both its encryption and integrity passwords
+  const min = Math.max(
+    1,
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const [index, password] of extras.entries()) {
+    if (typeof password !== "string" || password.length < min) {
+      throw new Error(
+        `Invalid session extra password at extraUnsealPasswords[${index}]: must be a string of at least ${min} characters`,
+      );
+    }
+  }
+}
