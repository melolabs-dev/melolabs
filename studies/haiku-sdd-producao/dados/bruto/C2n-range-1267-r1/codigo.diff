+
+/** Inclusive byte range, already limited to `[0, size - 1]`. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/** Validators of the asset, used by `If-Range`. `lastModified` is the string sent in `Last-Modified`. */
+interface RangeValidators {
+  etag?: string;
+  lastModified?: string;
+}
+
+const BYTES_RANGE_RE = /^bytes=(\d+)-(\d*)$/i;
+const BYTES_SUFFIX_RE = /^bytes=-(\d+)$/i;
+
+/**
+ * Decide the range of a request for an asset of known size (RFC 9110 section 14.2).
+ * Returns `undefined` when no range applies, `"unsatisfiable"` for 416, or the range for 206.
+ */
+function resolveRange(
+  headers: Headers,
+  validators: RangeValidators,
+  size: number,
+): ByteRange | "unsatisfiable" | undefined {
+  const range = headers.get("range");
+  if (!range) {
+    return undefined;
+  }
+  // `If-Range` is checked before the range is read, so a stale validator never yields 416.
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, validators)) {
+    return undefined;
+  }
+  return parseRange(range, size);
+}
+
+/** `If-Range` (RFC 9110 section 13.1.5): strong comparison for ETags, exact match for dates. */
+function ifRangeMatches(ifRange: string, validators: RangeValidators): boolean {
+  if (ifRange.startsWith('"')) {
+    return (
+      validators.etag !== undefined &&
+      !validators.etag.startsWith("W/") &&
+      validators.etag === ifRange
+    );
+  }
+  return validators.lastModified !== undefined && validators.lastModified === ifRange;
+}
+
+/**
+ * Strict parse of a single `bytes` range. Malformed, multiple or unsupported ranges
+ * return `undefined` and are ignored; a range starting past the end is `"unsatisfiable"`.
+ */
+function parseRange(value: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const suffix = BYTES_SUFFIX_RE.exec(value);
+  if (suffix) {
+    const length = toSafeInteger(suffix[1]!);
+    if (length === undefined) {
+      return undefined;
+    }
+    if (length === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - length, 0), end: size - 1 };
+  }
+
+  const match = BYTES_RANGE_RE.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  const start = toSafeInteger(first);
+  const end = last === "" ? Infinity : toSafeInteger(last);
+  if (start === undefined || end === undefined || end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+function toSafeInteger(digits: string): number | undefined {
+  const number = Number(digits);
+  return Number.isSafeInteger(number) ? number : undefined;
+}
+
+function setRangeHeaders(headers: Headers, range: ByteRange, size: number): void {
+  headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  headers.set("content-length", String(range.end - range.start + 1));
+}
