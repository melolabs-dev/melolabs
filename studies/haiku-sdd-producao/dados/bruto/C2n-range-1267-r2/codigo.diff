+/** Inclusive byte bounds, as in the `Content-Range` header. */
+export type ByteRangeResult =
+  | { type: "full" }
+  | { type: "partial"; start: number; end: number }
+  | { type: "unsatisfiable" };
+
+const FULL: ByteRangeResult = { type: "full" };
+const UNSATISFIABLE: ByteRangeResult = { type: "unsatisfiable" };
+
+// `byte-range-spec` without OWS: `first-last`, `first-` or `-suffix` (RFC 9110 section 14.1.1).
+const BYTE_RANGE_SPEC_RE = /^(\d*)-(\d*)$/;
+
+/**
+ * Evaluate a `Range` field-value against a representation of `options.size` bytes.
+ * `null` means the header is absent and yields `full`.
+ *
+ * Only single `bytes` ranges are honored. Anything else the server cannot apply
+ * (other unit, several ranges, malformed spec, `first > last`, unsafe integer)
+ * yields `full`, which RFC 9110 section 14.2 allows, so a bad header never gets a 400.
+ */
+export function parseRange(header: string | null, options: { size: number }): ByteRangeResult {
+  if (header === null) {
+    return FULL;
+  }
+  const equals = header.indexOf("=");
+  if (equals === -1 || header.slice(0, equals).toLowerCase() !== "bytes") {
+    return FULL;
+  }
+  const match = BYTE_RANGE_SPEC_RE.exec(header.slice(equals + 1));
+  if (!match || (match[1] === "" && match[2] === "")) {
+    return FULL;
+  }
+  const first = match[1] === "" ? undefined : Number(match[1]);
+  const last = match[2] === "" ? undefined : Number(match[2]);
+  if (
+    (first !== undefined && !Number.isSafeInteger(first)) ||
+    (last !== undefined && !Number.isSafeInteger(last))
+  ) {
+    return FULL;
+  }
+  if (first !== undefined && last !== undefined && first > last) {
+    return FULL;
+  }
+
+  const { size } = options;
+  if (first === undefined) {
+    // `-suffix`: the last `last` bytes, or the whole asset when the suffix is longer.
+    if (last === 0 || size === 0) {
+      return UNSATISFIABLE;
+    }
+    return { type: "partial", start: Math.max(size - last!, 0), end: size - 1 };
+  }
+  if (first >= size) {
+    return UNSATISFIABLE;
+  }
+  // `first-` runs to the end; `first-last` is clamped to the last existing byte.
+  return { type: "partial", start: first, end: Math.min(last ?? size - 1, size - 1) };
+}
+
+/**
+ * Evaluate an `If-Range` field-value (RFC 9110 §13.1.5). `etag` and `lastModified` are the
+ * validators of the response about to be sent. Returns `true` when the Range applies.
+ *
+ * A value starting with `"` is a strong ETag and must equal the response ETag exactly, so a
+ * weak ETag on either side never matches. Any other value is an HTTP-date and must equal
+ * `lastModified` byte for byte.
+ */
+export function matchesIfRange(
+  ifRange: string,
+  options: { etag?: string; lastModified?: string },
+): boolean {
+  if (ifRange.startsWith('"')) {
+    return options.etag === ifRange;
+  }
+  return options.lastModified !== undefined && options.lastModified === ifRange;
+}
+
+/**
+ * Cut the bytes of `range` out of a body. Returns `undefined` when the body type is not
+ * supported, so the caller can fall back to the full representation.
+ *
+ * Offsets are in bytes. `Blob`, `ArrayBuffer` and views are cut without copying. Strings are
+ * encoded once to UTF-8. Streams are read lazily, see {@link sliceStream} for their cost.
+ */
+export function sliceBody(
+  body: BodyInit,
+  range: { start: number; end: number },
+): BodyInit | undefined {
+  const { start, end } = range;
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body, start, end - start + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset + start, end - start + 1);
+  }
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end);
+  }
+  return undefined;
+}
+
+/**
+ * Cost (PRD R1): `getContents` takes no offset, so the bytes before `start` are read and
+ * discarded. Pulling stops as soon as the byte at `end` has been read: the upstream reader
+ * is cancelled there, so the rest of the asset is never read.
+ */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  let reader: ReadableStreamDefaultReader<Uint8Array> | undefined;
+  // Offset of the first byte of the next chunk, relative to the start of the asset.
+  let position = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      reader ??= stream.getReader();
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunkStart = position;
+        position += value.byteLength;
+        const from = Math.max(start - chunkStart, 0);
+        const to = Math.min(end + 1 - chunkStart, value.byteLength);
+        if (from < to) {
+          controller.enqueue(value.subarray(from, to));
+        }
+        if (position > end) {
+          controller.close();
+          await reader.cancel();
+          return;
+        }
+        if (from < to) {
+          return;
+        }
+      }
+    },
+    cancel(reason) {
+      return reader ? reader.cancel(reason) : stream.cancel(reason);
+    },
+  });
+}
