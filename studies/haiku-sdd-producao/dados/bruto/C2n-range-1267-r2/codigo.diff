+import { describe, it, expect } from "vitest";
+import { matchesIfRange, parseRange, sliceBody } from "../../src/utils/internal/range.ts";
+
+const readBody = async (body: BodyInit | undefined): Promise<string | undefined> => {
+  return body === undefined ? undefined : new Response(body).text();
+};
+
+describe("parseRange", () => {
+  it.each([
+    [null, "full"],
+    ["bytes=2-5", { type: "partial", start: 2, end: 5 }],
+    ["bytes=5-", { type: "partial", start: 5, end: 9 }],
+    ["bytes=-3", { type: "partial", start: 7, end: 9 }],
+    ["bytes=5-100", { type: "partial", start: 5, end: 9 }],
+    ["bytes=-100", { type: "partial", start: 0, end: 9 }],
+    ["BYTES=2-5", { type: "partial", start: 2, end: 5 }],
+    ["bytes=20-30", { type: "unsatisfiable" }],
+    ["bytes=10-", { type: "unsatisfiable" }],
+    ["bytes=-0", { type: "unsatisfiable" }],
+    ["bytes=abc", { type: "full" }],
+    ["bytes=0-1,4-5", { type: "full" }],
+    ["items=0-1", { type: "full" }],
+    ["bytes=5-2", { type: "full" }],
+    ["bytes=+1-2", { type: "full" }],
+    ["bytes=1e3-", { type: "full" }],
+    ["bytes=1-2-3", { type: "full" }],
+    ["bytes= 2-5", { type: "full" }],
+    ["bytes=0-9007199254740993", { type: "full" }],
+    ["bytes=", { type: "full" }],
+    ["bytes=-", { type: "full" }],
+  ])("parses %j", (header, expected) => {
+    expect(parseRange(header, { size: 10 })).toEqual(
+      typeof expected === "string" ? { type: expected } : expected,
+    );
+  });
+
+  it("is unsatisfiable for any valid range on an empty asset", () => {
+    expect(parseRange("bytes=0-", { size: 0 })).toEqual({ type: "unsatisfiable" });
+  });
+});
+
+describe("matchesIfRange", () => {
+  const date = "Tue, 14 Nov 2023 22:13:20 GMT";
+
+  it.each([
+    ['"abc"', { etag: '"abc"' }, true],
+    ['W/"abc"', { etag: '"abc"' }, false],
+    ['"abc"', { etag: 'W/"abc"' }, false],
+    ['"abc"', { etag: '"xyz"' }, false],
+    ['"abc"', {}, false],
+    ["", { etag: '"abc"' }, false],
+    [date, { lastModified: date }, true],
+    [date, { lastModified: "Tue, 14 Nov 2023 22:13:21 GMT" }, false],
+    [date, {}, false],
+    ["", { lastModified: date }, false],
+  ])("matchesIfRange(%j, %j) is %s", (ifRange, validators, expected) => {
+    expect(matchesIfRange(ifRange, validators)).toBe(expected);
+  });
+});
+
+describe("sliceBody", () => {
+  it("cuts a string by UTF-8 byte offsets", async () => {
+    // "é" is two bytes in UTF-8, so bytes 2-5 are "0123", not "1234".
+    expect(await readBody(sliceBody("é0123456789", { start: 2, end: 5 }))).toBe("0123");
+  });
+
+  it("cuts a Blob", async () => {
+    const body = sliceBody(new Blob(["0123456789"]), { start: 2, end: 5 });
+    expect(body).toBeInstanceOf(Blob);
+    expect(await readBody(body)).toBe("2345");
+  });
+
+  it("cuts an ArrayBuffer", async () => {
+    const buffer = new TextEncoder().encode("0123456789").buffer;
+    expect(await readBody(sliceBody(buffer, { start: 2, end: 5 }))).toBe("2345");
+  });
+
+  it("cuts a Uint8Array", async () => {
+    const bytes = new TextEncoder().encode("0123456789");
+    expect(await readBody(sliceBody(bytes, { start: 2, end: 5 }))).toBe("2345");
+  });
+
+  it("cuts a Uint8Array with a non-zero byteOffset from the right place", async () => {
+    const bytes = new Uint8Array([9, 9, ...new TextEncoder().encode("0123456789")]).subarray(2);
+    expect(bytes.byteOffset).toBe(2);
+    expect(await readBody(sliceBody(bytes, { start: 2, end: 5 }))).toBe("2345");
+  });
+
+  it("cuts a ReadableStream", async () => {
+    const stream = new Response("0123456789").body!;
+    expect(await readBody(sliceBody(stream, { start: 2, end: 5 }))).toBe("2345");
+  });
+
+  it("ends a stream that closes before the range does", async () => {
+    const stream = new Response("01").body!;
+    expect(await readBody(sliceBody(stream, { start: 0, end: 5 }))).toBe("01");
+  });
+
+  it("cancels the upstream stream when the sliced one is cancelled before any read", async () => {
+    let cancelled = false;
+    const upstream = new ReadableStream<Uint8Array>({
+      pull(controller) {
+        controller.enqueue(new Uint8Array([48]));
+      },
+      cancel() {
+        cancelled = true;
+      },
+    });
+    await (sliceBody(upstream, { start: 0, end: 1 }) as ReadableStream).cancel();
+    expect(cancelled).toBe(true);
+  });
+
+  it("returns undefined for types it cannot cut", () => {
+    expect(sliceBody(new FormData(), { start: 0, end: 1 })).toBeUndefined();
+  });
+});
