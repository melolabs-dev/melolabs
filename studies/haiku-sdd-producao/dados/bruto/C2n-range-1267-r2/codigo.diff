index 0000000..5bbae40
--- /dev/null
+++ b/test/static-range.test.ts
@@ -0,0 +1,370 @@
+import { beforeEach, vi, type Mock } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const ASSET = "0123456789";
+const MTIME = 1_700_000_000_000;
+const LAST_MODIFIED = new Date(MTIME).toUTCString();
+
+describeMatrix("serve static: range requests", (t, { it, expect }) => {
+  let getContents: Mock<ServeStaticOptions["getContents"]>;
+
+  beforeEach(() => {
+    getContents = vi.fn(() => ASSET);
+    const options: ServeStaticOptions = {
+      getContents: (id) => getContents(id),
+      getMeta: (id) =>
+        id.includes("404")
+          ? undefined
+          : { type: "text/plain", etag: '"abc"', mtime: MTIME, size: ASSET.length },
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+
+    t.app.all("/custom/**", (event) =>
+      serveStatic(event, {
+        getContents: () => ASSET,
+        getMeta: () => ({ size: ASSET.length }),
+        headers: { "accept-ranges": "none" },
+      }),
+    );
+
+    t.app.all("/weak/**", (event) =>
+      serveStatic(event, {
+        getContents: () => ASSET,
+        getMeta: () => ({ size: ASSET.length, etag: 'W/"abc"' }),
+      }),
+    );
+
+    t.app.all("/empty/**", (event) =>
+      serveStatic(event, {
+        getContents: () => "",
+        getMeta: () => ({ size: 0 }),
+      }),
+    );
+
+    t.app.all("/nosize/**", (event) =>
+      serveStatic(event, {
+        getContents: () => ASSET,
+        getMeta: () => ({ type: "text/plain" }),
+      }),
+    );
+
+    t.app.all("/clen/**", (event) =>
+      serveStatic(event, {
+        getContents: () => ASSET,
+        getMeta: () => ({ size: ASSET.length }),
+        headers: { "content-length": "999" },
+      }),
+    );
+
+    t.app.all("/ft/**", async (event) => {
+      const res = await serveStatic(event, {
+        getContents: () => ASSET,
+        getMeta: () => undefined,
+        fallthrough: true,
+      });
+      return res ?? "fell through";
+    });
+
+    t.app.all("/gz/**", (event) =>
+      serveStatic(event, {
+        getContents: (id) => (id === "/gz/file.txt.gz" ? "abcdef" : ASSET),
+        getMeta: (id) =>
+          id === "/gz/file.txt.gz"
+            ? { type: "text/plain", encoding: "gzip", etag: '"gz"', size: 6 }
+            : undefined,
+        encodings: { gzip: ".gz" },
+      }),
+    );
+
+    t.app.all("/type/**", (event) =>
+      serveStatic(event, {
+        getContents: (id) => bodies[id.slice("/type/".length)]?.(),
+        getMeta: (id) => (bodies[id.slice("/type/".length)] ? { size: ASSET.length } : undefined),
+      }),
+    );
+
+    t.app.all("/cancel/**", (event) =>
+      serveStatic(event, {
+        getContents: () => streamOf(ASSET),
+        getMeta: () => ({ size: ASSET.length }),
+      }),
+    );
+  });
+
+  // Bodies returned by `getContents` for `/type/*`; each one is a different `BodyInit` kind.
+  const bodies: Record<string, () => BodyInit | null> = {
+    string: () => ASSET,
+    blob: () => new Blob([ASSET]),
+    arraybuffer: () => new TextEncoder().encode(ASSET).buffer,
+    uint8array: () => new TextEncoder().encode(ASSET),
+    stream: () => streamOf(ASSET),
+    formdata: () => new FormData(),
+    null: () => null,
+  };
+
+  let streamPulls = 0;
+  let streamCancelled = false;
+  function streamOf(text: string): ReadableStream<Uint8Array> {
+    const encoder = new TextEncoder();
+    const chars = [...text];
+    let index = 0;
+    return new ReadableStream<Uint8Array>({
+      pull(controller) {
+        streamPulls++;
+        if (index >= chars.length) {
+          controller.close();
+          return;
+        }
+        controller.enqueue(encoder.encode(chars[index++]));
+      },
+      cancel() {
+        streamCancelled = true;
+      },
+    });
+  }
+
+  it("RF-01: advertises accept-ranges on a full GET", async () => {
+    const res = await t.fetch("/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(ASSET);
+  });
+
+  it("RF-01: advertises accept-ranges on HEAD", async () => {
+    const res = await t.fetch("/file.txt", { method: "HEAD" });
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("RF-01: keeps accept-ranges set in options.headers", async () => {
+    const res = await t.fetch("/custom/file.txt");
+    expect(res.headers.get("accept-ranges")).toBe("none");
+  });
+
+  it("RF-01: a 304 does not carry accept-ranges", async () => {
+    const res = await t.fetch("/file.txt", { headers: { "if-none-match": '"abc"' } });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("RF-02: serves the requested bytes as 206", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("2345");
+  });
+
+  it("RF-03: open, suffix and over-long ranges are clamped to the asset", async () => {
+    for (const [range, contentRange, body] of [
+      ["bytes=5-", "bytes 5-9/10", "56789"],
+      ["bytes=-3", "bytes 7-9/10", "789"],
+      ["bytes=5-100", "bytes 5-9/10", "56789"],
+      ["bytes=-100", "bytes 0-9/10", ASSET],
+    ]) {
+      const res = await t.fetch("/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(206);
+      expect(res.headers.get("content-range"), range).toBe(contentRange);
+      expect(await res.text(), range).toBe(body);
+    }
+  });
+
+  it("RF-04: HEAD returns the 206 headers without a body or getContents", async () => {
+    const res = await t.fetch("/file.txt", { method: "HEAD", headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("RF-05: ranges with no satisfiable byte are 416 with no body", async () => {
+    for (const range of ["bytes=20-30", "bytes=-0", "bytes=10-"]) {
+      const res = await t.fetch("/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(416);
+      expect(res.headers.get("content-range"), range).toBe("bytes */10");
+      expect(res.headers.get("content-length"), range).toBe("0");
+      expect(await res.text(), range).toBe("");
+    }
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("RF-05: any range on a zero-size asset is 416 bytes */0", async () => {
+    const res = await t.fetch("/empty/file.txt", { headers: { range: "bytes=0-" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+    expect(res.headers.get("content-length")).toBe("0");
+  });
+
+  it("RF-06: malformed, multi-range, other-unit and inverted ranges are ignored", async () => {
+    for (const range of ["bytes=abc", "bytes=0-1,4-5", "items=0-1", "bytes=5-2"]) {
+      const res = await t.fetch("/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-length"), range).toBe("10");
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(await res.text(), range).toBe(ASSET);
+    }
+  });
+
+  it("RF-07: a matching strong If-Range applies the range", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=2-5", "if-range": '"abc"' },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("2345");
+  });
+
+  it("RF-07: a non-matching If-Range serves the full asset", async () => {
+    for (const ifRange of ['"xyz"', 'W/"abc"']) {
+      const res = await t.fetch("/file.txt", {
+        headers: { range: "bytes=2-5", "if-range": ifRange },
+      });
+      expect(res.status, ifRange).toBe(200);
+      expect(await res.text(), ifRange).toBe(ASSET);
+    }
+  });
+
+  it("RF-07: a weak ETag on the asset never matches If-Range", async () => {
+    const res = await t.fetch("/weak/file.txt", {
+      headers: { range: "bytes=2-5", "if-range": '"abc"' },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(ASSET);
+  });
+
+  it("RF-07: a matching If-Range date applies the range", async () => {
+    const res = await t.fetch("/file.txt", {
