+/**
+ * The range that applies to this request, after `If-Range`. `full` when the asset size is
+ * unknown (RF-10), when `If-Range` does not match, or when `Range` is ignored.
+ */
+function selectRange(event: H3Event, size: number | undefined): ByteRangeResult {
