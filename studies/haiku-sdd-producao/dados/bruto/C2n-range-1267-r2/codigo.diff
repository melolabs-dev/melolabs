+
+  it("RF-11: a precompressed variant is ranged over its own bytes", async () => {
+    const res = await t.fetch("/gz/file.txt", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-1" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-1/6");
+    expect(res.headers.get("content-length")).toBe("2");
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    // Not reading the body: node's fetch decodes `content-encoding: gzip`, and "abcdef" is not gzip.
+    await res.body?.cancel();
+  });
+
+  it("RF-11: vary is kept on 304 and 416 for a variant", async () => {
+    const notModified = await t.fetch("/gz/file.txt", {
+      headers: { "accept-encoding": "gzip", "if-none-match": '"gz"' },
+    });
+    expect(notModified.status).toBe(304);
+    expect(notModified.headers.get("vary")).toBe("accept-encoding");
+
+    const unsatisfiable = await t.fetch("/gz/file.txt", {
+      headers: { "accept-encoding": "gzip", range: "bytes=20-30" },
+    });
+    expect(unsatisfiable.status).toBe(416);
+    expect(unsatisfiable.headers.get("content-range")).toBe("bytes */6");
+    expect(unsatisfiable.headers.get("content-encoding")).toBe("gzip");
+    expect(unsatisfiable.headers.get("vary")).toBe("accept-encoding");
+  });
+
+  it("cuts string, Blob, ArrayBuffer, Uint8Array and stream bodies for a 206", async () => {
+    for (const kind of ["string", "blob", "arraybuffer", "uint8array", "stream"]) {
+      const res = await t.fetch(`/type/${kind}`, { headers: { range: "bytes=2-5" } });
+      expect(res.status, kind).toBe(206);
+      expect(await res.text(), kind).toBe("2345");
+    }
+  });
+
+  it("serves the full body when the type cannot be cut (FormData)", async () => {
+    const res = await t.fetch("/type/formdata", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("serves a 200 without a 206 body when getContents returns null", async () => {
+    const res = await t.fetch("/type/null", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    await res.body?.cancel();
+  });
+
+  it("D-06: a 206 overrides content-length set in options.headers", async () => {
+    const res = await t.fetch("/clen/file.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("2345");
+  });
+
+  it("cancels the upstream stream after the last requested byte", async () => {
+    streamPulls = 0;
+    streamCancelled = false;
+    const res = await t.fetch("/cancel/file.txt", { headers: { range: "bytes=0-1" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("01");
+    expect(streamCancelled).toBe(true);
+    expect(streamPulls).toBeLessThan(ASSET.length);
+  });
+});
