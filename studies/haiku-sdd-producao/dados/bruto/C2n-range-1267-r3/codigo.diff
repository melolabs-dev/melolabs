+// Single `bytes` range only (RFC 9110 section 14.1). Spaces, other units and
+// lists of ranges do not match and are ignored.
+const RANGE_RE = /^bytes=(?:(\d+)-(\d*)|-(\d+))$/;
+
+/** Inclusive byte range, already limited to the asset size. */
+type ByteRange = { start: number; end: number };
+
+/**
+ * `undefined` serves the full asset with `200`. `"unsatisfiable"` answers `416`.
+ * Anything else is the `206` range.
+ */
+type RangeOutcome = ByteRange | "unsatisfiable" | undefined;
+
+/**
+ * Resolve the `Range` header against the asset. The order matters: `If-Range`
+ * is checked before the range is parsed, and a syntactically invalid range
+ * (`b < a`) is ignored rather than answered with `416`.
+ */
+function resolveRange(
+  headers: Headers,
+  validators: { size?: number; etag?: string; lastModified?: string },
+): RangeOutcome {
+  const match = RANGE_RE.exec(headers.get("range") || "");
+  if (!match || !isIfRangeMatch(headers.get("if-range"), validators)) {
+    return undefined;
+  }
+  const size = validators.size;
+  if (!size) {
+    return undefined;
+  }
+
+  const [, first, last, suffix] = match;
+  if (suffix !== undefined) {
+    const length = Number(suffix);
+    if (!Number.isSafeInteger(length)) {
+      return undefined;
+    }
+    if (length === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - length), end: size - 1 };
+  }
+
+  const start = Number(first);
+  const end = last ? Number(last) : undefined;
+  if (!Number.isSafeInteger(start) || (end !== undefined && !Number.isSafeInteger(end))) {
+    return undefined;
+  }
+  if (end !== undefined && end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: end === undefined ? size - 1 : Math.min(end, size - 1) };
+}
+
+/**
+ * Whether `If-Range` allows a partial response. A value shaped as an entity-tag
+ * is compared only with a strong ETag. Any other value is an HTTP-date, compared
+ * by equality with `last-modified`.
