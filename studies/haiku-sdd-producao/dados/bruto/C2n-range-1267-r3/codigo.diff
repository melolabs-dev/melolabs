+function isIfRangeMatch(
+  ifRange: string | null,
+  validators: { etag?: string; lastModified?: string },
+): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  if (ifRange.startsWith('"') || ifRange.startsWith('W/"')) {
+    return !ifRange.startsWith("W/") && ifRange === validators.etag;
+  }
+  return ifRange === validators.lastModified;
+}
+
+/** The part of a materialized body covered by `range`, or `undefined` when the body cannot be sliced. */
+function sliceBody(body: BodyInit | null | undefined, range: ByteRange): BodyInit | undefined {
+  const end = range.end + 1;
+  if (body instanceof Blob) {
+    return body.slice(range.start, end);
+  }
+  if (body instanceof Uint8Array) {
+    return body.subarray(range.start, end) as Uint8Array<ArrayBuffer>;
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(range.start, end);
+  }
+  // Slice the UTF-8 bytes, so the offsets match `Content-Range` and `size`.
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(range.start, end);
+  }
+  return undefined;
+}
+
+/** Release a stream that will not be read, e.g. on HEAD. */
+function cancelIfStream(body: BodyInit | null | undefined): void {
+  if (body instanceof ReadableStream) {
+    body.cancel().catch(() => {});
+  }
+}
