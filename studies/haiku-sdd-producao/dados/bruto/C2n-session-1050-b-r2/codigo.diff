+import type { SessionConfig } from "../../src/utils/session.ts";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { getSession, mockEvent, sealSession, unsealSession } from "../../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../../src/utils/internal/iron-crypto.ts";
+
+// Spy on the seal primitives while keeping their behavior, so tests can check
+// which passwords were tried, in which order, and how often a cookie was resealed.
+vi.mock("../../src/utils/internal/iron-crypto.ts", async (importOriginal) => {
+  const original = await importOriginal<typeof import("../../src/utils/internal/iron-crypto.ts")>();
+  return {
+    ...original,
+    seal: vi.fn(original.seal),
+    unseal: vi.fn(original.unseal),
+  };
+});
+
+const PASSWORD = "current-password-current-password-0001";
+const EXTRA_1 = "previous-password-previous-password-1";
+const EXTRA_2 = "older-password-older-password-000002";
+const UNKNOWN = "unknown-password-unknown-password-009";
+
+const sessionConfig = (overrides: Partial<SessionConfig> = {}): SessionConfig => ({
+  name: "h3",
+  password: PASSWORD,
+  legacySealFallback: false,
+  ...overrides,
+});
+
+const sealWith = (password: string) =>
+  seal({ id: "unit-1", createdAt: Date.now(), data: { foo: "bar" } }, password, sealDefaults);
+
+const eventWithCookie = (sealed: string) => mockEvent("/", { headers: { cookie: `h3=${sealed}` } });
+
+// Passwords passed to `unseal`, in call order
+const triedPasswords = () => vi.mocked(unseal).mock.calls.map((call) => call[1]);
+
+beforeEach(() => {
+  vi.mocked(unseal).mockClear();
+  vi.mocked(seal).mockClear();
+});
+
+describe("extraUnsealPasswords: order of attempts", () => {
+  // Protects RF-02: the current password is tried first, then the extras in order.
+  it("tries password first, then the extras in the order given", async () => {
+    const sealed = await sealWith(UNKNOWN);
+    vi.mocked(unseal).mockClear();
+
+    await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1, EXTRA_2] }),
+    );
+
+    expect(triedPasswords()).toEqual([PASSWORD, EXTRA_1, EXTRA_2]);
+  });
+
+  // Protects RF-02: the first password that opens the seal is the last one tried.
+  it("stops at the first password that opens the cookie", async () => {
+    const sealed = await sealWith(EXTRA_1);
+    vi.mocked(unseal).mockClear();
+
+    const session = await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1, EXTRA_2] }),
+    );
+
+    expect(session.id).toBe("unit-1");
+    expect(triedPasswords()).toEqual([PASSWORD, EXTRA_1]);
+  });
+
+  // Protects D-03: a candidate that fails for its own reason (too short) must
+  // not stop the attempts that follow it.
+  it("keeps trying after a candidate fails for its own reason", async () => {
+    const sealed = await sealWith(EXTRA_1);
+    vi.mocked(unseal).mockClear();
+
+    const session = await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: ["too-short", EXTRA_1] }),
+    );
+
+    expect(session.id).toBe("unit-1");
+    expect(triedPasswords()).toEqual([PASSWORD, "too-short", EXTRA_1]);
+  });
+});
+
+describe("extraUnsealPasswords: sealing", () => {
+  // Protects RF-03: sealing never falls back to an extra password.
+  it("seals with password, so the result does not open with an extra password", async () => {
+    const sealed = await sealSession(
