+
+/**
+ * Unseal with `password`, then with each of `extraUnsealPasswords` in order,
+ * stopping at the first one that verifies. Expiration is checked once, on the
+ * session that opened, not per candidate.
+ */
+async function unsealCandidates(
+  config: SessionConfig,
+  sealed: string,
+): Promise<{ session: Partial<Session>; openedWithExtra: boolean }> {
+  const sealOptions = {
+    ...sealDefaults,
+    ttl: (config.maxAge || config.idleTimeout || 0) * 1000,
+    ...config.seal,
+  };
+  let unsealed: Partial<Session> | undefined;
+  let openedWithExtra = false;
+  let firstError: unknown;
+  for (const [index, password] of unsealPasswords(config).entries()) {
+    try {
+      unsealed = await unsealWithPassword(sealed, password, sealOptions, config.legacySealFallback);
+      openedWithExtra = index > 0;
+      break;
+    } catch (error) {
+      firstError ??= error;
+    }
+  }
+  if (!unsealed) {
+    throw firstError;
+  }
+  // Absolute lifetime, counted from when the session was created
+  if (config.maxAge) {
+    const age = Date.now() - (unsealed.createdAt || Number.NEGATIVE_INFINITY);
+    if (age > config.maxAge * 1000) {
+      throw new Error("Session expired!");
+    }
+  }
+  // Idle window, counted from the last reseal. Sessions sealed before
+  // idleTimeout was configured, and sessions read from the session header (which
+  // are never resealed), fall back to createdAt
+  if (config.idleTimeout) {
+    const idle =
+      Date.now() - (unsealed.lastSeenAt || unsealed.createdAt || Number.NEGATIVE_INFINITY);
+    if (idle > config.idleTimeout * 1000) {
+      throw new Error("Session expired!");
+    }
+  }
+  return { session: unsealed, openedWithExtra };
+}
+
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean | undefined,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+/**
+ * The passwords to try, in order. `password` comes first and is never repeated;
+ * empty strings are ignored.
+ */
+function unsealPasswords(config: SessionConfig): string[] {
+  const extras = (config.extraUnsealPasswords ?? []).filter(Boolean);
+  return [...new Set([config.password, ...extras])];
+}
