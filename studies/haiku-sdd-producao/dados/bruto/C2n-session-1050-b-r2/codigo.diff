+    const session = await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1] }),
+    );
+
+    expect(session.id).toBe("unit-1");
+    expect(session.data).toEqual({ foo: "bar" });
+  });
+});
+
+describe("extraUnsealPasswords: edge cases", () => {
+  // Protects RF-09: an extra equal to `password` adds no attempt.
+  it("does not retry password when it is also listed as an extra", async () => {
+    const sealed = await sealWith(UNKNOWN);
+    vi.mocked(unseal).mockClear();
+
+    await getSession(eventWithCookie(sealed), sessionConfig({ extraUnsealPasswords: [PASSWORD] }));
+
+    expect(triedPasswords()).toEqual([PASSWORD]);
+  });
+
+  // Protects RF-09: an empty extra is ignored, not tried.
+  it("ignores empty extra passwords", async () => {
+    const sealed = await sealWith(UNKNOWN);
+    vi.mocked(unseal).mockClear();
+
+    await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: ["", EXTRA_1] }),
+    );
+
+    expect(triedPasswords()).toEqual([PASSWORD, EXTRA_1]);
+  });
+
+  // Protects RF-09: duplicate extras are tried once each.
+  it("tries each distinct extra password once", async () => {
+    const sealed = await sealWith(UNKNOWN);
+    vi.mocked(unseal).mockClear();
+
+    await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1, EXTRA_1, EXTRA_2] }),
+    );
+
+    expect(triedPasswords()).toEqual([PASSWORD, EXTRA_1, EXTRA_2]);
+  });
+
+  // Protects RF-09: repeating `password` among the extras adds no attempt.
+  it("does not try password again when it is repeated among the extras", async () => {
+    const sealed = await sealWith(UNKNOWN);
+    vi.mocked(unseal).mockClear();
+
+    await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: [PASSWORD, EXTRA_1] }),
+    );
+
+    expect(triedPasswords()).toEqual([PASSWORD, EXTRA_1]);
+  });
+
+  // Regression guard for D-05 (passes before and after the change): the value
+  // returned by unsealSession has the same shape whichever password opened it.
+  it("returns the same object shape whether an extra password opened the cookie or not", async () => {
+    const current = await unsealSession(
+      mockEvent("/"),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1] }),
+      await sealWith(PASSWORD),
+    );
+    const extra = await unsealSession(
+      mockEvent("/"),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1] }),
+      await sealWith(EXTRA_1),
+    );
+
+    expect(Object.keys(extra)).toEqual(Object.keys(current));
+    expect(Object.getOwnPropertySymbols(extra)).toEqual(Object.getOwnPropertySymbols(current));
+  });
+});
+
+describe("extraUnsealPasswords: failure", () => {
+  // Regression guard for RF-08 (passes before and after the change): when no
+  // password opens the cookie, the request gets a new session and no error.
+  it("treats the request as a new session when no password opens the cookie", async () => {
+    const sealed = await sealWith(UNKNOWN);
+
+    const session = await getSession(
+      eventWithCookie(sealed),
+      sessionConfig({ extraUnsealPasswords: [EXTRA_1] }),
+    );
+
+    expect(session.id).not.toBe("unit-1");
+    expect(session.data).toEqual({});
+  });
+
+  // Regression guard (passes before and after the change): with a single
+  // password, unsealSession keeps throwing the same error as before.
+  it("throws the first candidate's error from unsealSession when nothing opens", async () => {
+    const sealed = await sealWith(UNKNOWN);
+
+    await expect(unsealSession(mockEvent("/"), sessionConfig(), sealed)).rejects.toThrow(
+      "Bad hmac value",
+    );
+  });
+});
