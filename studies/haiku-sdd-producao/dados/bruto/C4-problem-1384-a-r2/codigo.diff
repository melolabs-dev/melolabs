diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..ac8d009
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,309 @@
+import { describe, expect, it } from "vitest";
+import { H3, HTTPError, onResponse } from "../src/index.ts";
+import { kNotFound } from "../src/response.ts";
+import { routeRules } from "../src/rules/middleware.ts";
+import { createOcacheRuleHandler } from "../src/rules/cache.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM = "application/problem+json";
+
+describeMatrix("problem details option (RF-01, RF-02)", (t, { it, expect }) => {
+  it("is disabled by default", () => {
+    expect(t.app.config.problemDetails).toBeFalsy();
+  });
+
+  it("keeps the current error body and content-type when disabled", async () => {
+    t.app.config.debug = false;
+    t.app.get("/", () => {
+      throw HTTPError.status(404, "Not Found", { message: "x" });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    expect(await res.json()).toEqual({ status: 404, statusText: "Not Found", message: "x" });
+  });
+
+  it("keeps the current body and content-type when explicitly false", async () => {
+    t.app.config.debug = false;
+    t.app.config.problemDetails = false;
+    t.app.get("/", () => {
+      throw HTTPError.status(404, "Not Found", { message: "x" });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    expect(await res.json()).toEqual({ status: 404, statusText: "Not Found", message: "x" });
+  });
+});
+
+describeMatrix("problem details rendering (RF-03, RF-04, RF-05 contract)", (t, { it, expect }) => {
+  it("responds with the status and application/problem+json", async () => {
+    t.app.config.problemDetails = true;
+    t.app.get("/", () => {
+      throw HTTPError.status(400, "Bad Request");
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+  });
+
+  it("maps HTTPError fields to RFC 9457 members", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 403,
+        statusText: "Forbidden",
+        message: "Sem permissão",
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(403);
+    expect(await res.json()).toEqual({
+      type: "https://exemplo.com/erros/sem-permissao",
+      title: "Forbidden",
+      status: 403,
+      detail: "Sem permissão",
+      instance: "/pedidos/42",
+    });
+  });
+
+  it("uses about:blank for a missing type and omits missing instance and title", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 418, message: "Teapot" });
+    });
+
+    const body = await (await t.fetch("/")).json();
+    expect(body).toEqual({ type: "about:blank", status: 418, detail: "Teapot" });
+    expect(body).not.toHaveProperty("title");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("renders a missing route (kNotFound) as a 404 problem", async () => {
+    t.app.config.problemDetails = true;
+
+    const res = await t.fetch("/missing");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+    const body = await res.json();
+    expect(body).toMatchObject({ type: "about:blank", status: 404 });
+    expect(body.detail).toContain("Cannot find any route");
+  });
+
+  it("renders a missing route through a global middleware that calls onResponse", async () => {
+    t.app.config.problemDetails = true;
+    t.app.use(onResponse(() => undefined));
+
+    const res = await t.fetch("/missing");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+  });
+
+  it("returns no body for HEAD but keeps the problem content-type", async () => {
+    t.app.config.problemDetails = true;
+
+    const res = await t.fetch("/missing", { method: "HEAD" });
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+    expect(await res.text()).toBe("");
+  });
+
+  it("emits data and body as extension members without overriding standard members", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 403,
+        message: "Negado",
+        data: { field: "email" },
+        body: { code: "E1", status: 999, type: "x" },
+      });
+    });
+
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({
+      type: "about:blank",
+      status: 403,
+      detail: "Negado",
+      data: { field: "email" },
+      code: "E1",
+    });
+  });
+
+  it("includes a stack trace as an array in debug mode and indents the body", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = true;
+    t.app.get("/", () => {
+      throw HTTPError.status(400, "Bad Request");
+    });
+
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+    const text = await res.text();
+    expect(text).toContain("\n  ");
+    expect(Array.isArray(JSON.parse(text).stack)).toBe(true);
+  });
+
+  it("omits the stack trace when debug is off", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.get("/", () => {
+      throw HTTPError.status(400, "Bad Request");
+    });
+
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("stack");
+  });
+
+  it("keeps onError and errHeaders working with a single set-cookie", async () => {
+    t.app.config.problemDetails = true;
+    t.app.config.debug = false;
+    t.app.get("/", (event) => {
+      event.res.errHeaders.append("set-cookie", "session=1");
+      throw HTTPError.status(401, "Unauthorized");
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(401);
+    expect(res.headers.get("content-type")).toBe(PROBLEM);
+    expect(res.headers.getSetCookie()).toEqual(["session=1"]);
+    expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+    expect(t.hooks.onError.mock.calls[0]![0]).toBeInstanceOf(HTTPError);
+    expect((t.hooks.onError.mock.calls[0]![0] as HTTPError).status).toBe(401);
+  });
+});
+
+describe("problem details rendering with cache rules (D-09)", () => {
+  it("renders a cached route's missing response as a problem", async () => {
+    const app = new H3({ problemDetails: true });
+    app.use(
+      routeRules(
+        { "/cached/**": { cache: { maxAge: 60 } } },
+        { handlers: { cache: createOcacheRuleHandler() } },
+      ),
+    );
+    app.get("/cached/missing", () => kNotFound);
+
+    const first = await app.fetch(new Request("http://test/cached/missing"));
+    expect(first.status).toBe(404);
+    expect(first.headers.get("content-type")).toBe(PROBLEM);
+
+    const second = await app.fetch(new Request("http://test/cached/missing"));
+    expect(second.headers.get("content-type")).toBe(PROBLEM);
+  });
+});
+
+describeMatrix(
+  "problem details for unhandled errors (RF-06, RF-07)",
+  (t, { it, expect }) => {
+    it("hides the message of a plain Error", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      expect(JSON.parse(text)).toMatchObject({ status: 500, detail: "HTTPError" });
+    });
+
+    it("omits data, body and message of an unhandled HTTPError", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          message: "interno",
+          unhandled: true,
+          data: { token: "abc" },
+          body: { secret: "def" },
+        });
+      });
+
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(text).not.toContain("interno");
+      expect(text).not.toContain("abc");
+      expect(text).not.toContain("def");
+      const body = JSON.parse(text);
+      expect(body).toMatchObject({ status: 500, detail: "HTTPError" });
+      expect(body).not.toHaveProperty("data");
+      expect(body).not.toHaveProperty("secret");
+    });
+
+    it("renders a 500 problem when onError throws", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.config.onError = () => {
+        throw new Error("falha no onError");
+      };
+      t.app.get("/", () => {
+        throw HTTPError.status(401, "Unauthorized");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.text()).not.toContain("falha no onError");
+    });
+
+    it("includes the stack for unhandled errors in debug mode", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = true;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error("boom");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(Array.isArray((await res.json()).stack)).toBe(true);
+    });
+  },
+  { allowUnhandledErrors: true },
+);
+
+describe("HTTPError type and instance (RF-05)", () => {
+  it("exposes type and instance from the constructor input", () => {
+    const err = new HTTPError({
+      status: 409,
+      message: "Conflito",
+      type: "https://exemplo.com/erros/conflito",
+      instance: "/recurso/1",
+    });
+    expect(err.type).toBe("https://exemplo.com/erros/conflito");
+    expect(err.instance).toBe("/recurso/1");
+  });
+
+  it("leaves type and instance undefined when not provided", () => {
+    const err = new HTTPError({ status: 409, message: "Conflito" });
+    expect(err.type).toBeUndefined();
+    expect(err.instance).toBeUndefined();
+  });
+
+  it("does not add type or instance to toJSON()", () => {
+    const err = new HTTPError({
+      status: 409,
+      message: "Conflito",
+      type: "https://exemplo.com/erros/conflito",
+      instance: "/recurso/1",
+    });
+    expect(err.toJSON()).not.toHaveProperty("type");
+    expect(err.toJSON()).not.toHaveProperty("instance");
+  });
+});
