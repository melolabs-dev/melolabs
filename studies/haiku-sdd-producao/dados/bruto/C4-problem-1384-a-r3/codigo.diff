+++ b/src/utils/internal/problem-details.ts
@@ -0,0 +1,45 @@
+import type { HTTPError } from "../../error.ts";
+
+/** Members of an RFC 9457 problem details object emitted by H3. */
+export interface ProblemDetails {
+  type: string;
+  title?: string;
+  status: number;
+  detail?: string;
+  instance?: string;
+  [member: string]: unknown;
+}
+
+const kStandardMembers: ReadonlySet<string> = new Set([
+  "type",
+  "title",
+  "status",
+  "detail",
+  "instance",
+]);
+
+/**
+ * Build the RFC 9457 body for an error. The standard members take precedence over `data`.
+ * Unhandled errors expose only `type` and `status`.
+ */
+export function toProblemDetails(error: HTTPError): ProblemDetails {
+  if (error.unhandled) {
+    return { type: "about:blank", status: error.status };
+  }
+  return {
+    ...dataMembers(error.data),
+    type: error.type || "about:blank",
+    ...(error.statusText ? { title: error.statusText } : {}),
+    status: error.status,
+    ...(error.message ? { detail: error.message } : {}),
+    ...(error.instance ? { instance: error.instance } : {}),
+  };
+}
+
+/** Plain object members of `data`, minus keys that would collide with the standard members. */
+function dataMembers(data: unknown): Record<string, unknown> {
+  if (typeof data !== "object" || data === null || Array.isArray(data)) {
+    return {};
+  }
+  return Object.fromEntries(Object.entries(data).filter(([key]) => !kStandardMembers.has(key)));
+}
