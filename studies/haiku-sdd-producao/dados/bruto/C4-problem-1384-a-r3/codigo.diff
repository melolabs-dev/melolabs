@@ -0,0 +1,99 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../../src/index.ts";
+import { toProblemDetails } from "../../src/utils/internal/problem-details.ts";
+
+describe("toProblemDetails", () => {
+  it("emits standard members in order for a complete error", () => {
+    const error = new HTTPError({
+      status: 404,
+      statusText: "Not Found",
+      message: "Usuário não existe",
+      type: "https://example.com/probs/not-found",
+      instance: "/users/42",
+    });
+    const problem = toProblemDetails(error);
+    expect(Object.keys(problem)).toEqual(["type", "title", "status", "detail", "instance"]);
+    expect(problem).toEqual({
+      type: "https://example.com/probs/not-found",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário não existe",
+      instance: "/users/42",
+    });
+  });
+
+  it("uses about:blank when type is missing", () => {
+    expect(toProblemDetails(new HTTPError({ status: 400 })).type).toBe("about:blank");
+  });
+
+  it("omits title and instance when they are not set", () => {
+    const problem = toProblemDetails(new HTTPError({ status: 400, message: "x" }));
+    expect(problem).not.toHaveProperty("title");
+    expect(problem).not.toHaveProperty("instance");
+  });
+
+  it("spreads plain object data without standard member keys", () => {
+    const error = new HTTPError({
+      status: 422,
+      message: "campo inválido",
+      data: { field: "email", type: "x", title: "t", status: 1, detail: "d", instance: "i" },
+    });
+    expect(toProblemDetails(error)).toEqual({
+      field: "email",
+      type: "about:blank",
+      status: 422,
+      detail: "campo inválido",
+    });
+  });
+
+  it("drops colliding data keys even when the standard member is absent", () => {
+    const error = new HTTPError({ status: 400, data: { title: "from data" } });
+    expect(toProblemDetails(error)).not.toHaveProperty("title");
+  });
+
+  it("does not spread non-object data", () => {
+    for (const data of ["text", ["a", "b"], null, 42]) {
+      const problem = toProblemDetails(new HTTPError({ status: 400, message: "x", data }));
+      expect(Object.keys(problem)).toEqual(["type", "status", "detail"]);
+    }
+  });
+
+  it("exposes only type and status for unhandled errors", () => {
+    const error = new HTTPError({
+      status: 500,
+      statusText: "Internal",
+      message: "segredo",
+      data: { a: 1 },
+      instance: "/x",
+      type: "https://example.com/t",
+      unhandled: true,
+    });
+    expect(toProblemDetails(error)).toEqual({ type: "about:blank", status: 500 });
+  });
+
+  it("never emits stack, body or unhandled", () => {
+    const error = new HTTPError({ status: 400, body: { extra: true }, unhandled: false });
+    const problem = toProblemDetails(error);
+    expect(problem).not.toHaveProperty("stack");
+    expect(problem).not.toHaveProperty("body");
+    expect(problem).not.toHaveProperty("unhandled");
+    expect(problem).not.toHaveProperty("extra");
+  });
+});
+
+describe("HTTPError type and instance", () => {
+  it("ignores non-string values", () => {
+    const error = new HTTPError({ status: 400, type: 1, instance: null } as any);
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("does not read type from cause", () => {
+    const error = new HTTPError({
+      status: 400,
+      cause: { type: "entity.too.large", instance: "/internal" },
+    });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+});
