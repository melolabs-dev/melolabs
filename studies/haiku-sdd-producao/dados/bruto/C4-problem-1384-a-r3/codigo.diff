diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..6fd255f
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,292 @@
+import { H3, HTTPError, onResponse } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_CONTENT_TYPE = "application/problem+json";
+const DEFAULT_CONTENT_TYPE = "application/json;charset=UTF-8";
+
+describeMatrix("sdd: problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  // RF-02
+  describe("HTTPError type and instance", () => {
+    it("exposes type and instance given in the input", () => {
+      const error = new HTTPError({
+        status: 404,
+        type: "https://example.com/probs/not-found",
+        instance: "/users/42",
+      });
+      expect(error.type).toBe("https://example.com/probs/not-found");
+      expect(error.instance).toBe("/users/42");
+    });
+
+    it("leaves type and instance undefined when not given", () => {
+      const error = new HTTPError({ status: 404 });
+      expect(error.type).toBeUndefined();
+      expect(error.instance).toBeUndefined();
+    });
+
+    it("ignores non-string type and instance", () => {
+      const error = new HTTPError({ status: 404, type: 42, instance: {} } as any);
+      expect(error.type).toBeUndefined();
+      expect(error.instance).toBeUndefined();
+    });
+  });
+
+  // RF-01 and RF-06
+  describe("problemDetails option", () => {
+    it("is off by default", () => {
+      expect(t.app.config.problemDetails).toBeFalsy();
+    });
+
+    it("is typed as a boolean", () => {
+      // Type-only check, enforced by `pnpm typecheck`
+      new H3({ problemDetails: true });
+      // @ts-expect-error problemDetails must be a boolean
+      new H3({ problemDetails: "sim" });
+      expect(true).toBe(true);
+    });
+  });
+
+  // RF-04
+  describe("default format (option off)", () => {
+    it("keeps the current body and content-type, without type or instance", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "inválido" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(DEFAULT_CONTENT_TYPE);
+      const body = await res.json();
+      expect(body).toMatchObject({ status: 400, message: "inválido" });
+      expect(body).not.toHaveProperty("type");
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("does not apply problem format when the option is explicitly false", async () => {
+      t.app.config.problemDetails = false;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "inválido" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(DEFAULT_CONTENT_TYPE);
+    });
+  });
+
+  // RF-03
+  describe("problem format (option on)", () => {
+    it("renders the RF-03 example exactly", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/users/:id", () => {
+        throw new HTTPError({
+          status: 404,
+          statusText: "Not Found",
+          message: "Usuário não existe",
+          instance: "/users/42",
+        });
+      });
+      const res = await t.fetch("/users/42");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não existe",
+        instance: "/users/42",
+      });
+    });
+
+    it("uses about:blank as type when the error has no type", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "inválido" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect((await res.json()).type).toBe("about:blank");
+    });
+
+    it("uses the error type when it is set", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, type: "https://example.com/probs/bad" });
+      });
+      const res = await t.fetch("/");
+      expect((await res.json()).type).toBe("https://example.com/probs/bad");
+    });
+
+    it("includes data members without overriding standard members", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 422,
+          message: "campo inválido",
+          data: { field: "email", status: 1, type: "x" },
+        });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(body.field).toBe("email");
+      expect(body.status).toBe(422);
+      expect(body.type).toBe("about:blank");
+    });
+  });
+
+  // RF-05
+  describe("non-HTTPError with option on", () => {
+    it("renders a 500 problem without leaking the internal message", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      const body = JSON.parse(text);
+      expect(body.status).toBe(500);
+      expect(body).not.toHaveProperty("detail");
+      expect(t.errors[0].unhandled).toBe(true);
+      t.errors = [];
+    });
+
+    it("does not take type from a thrown non-Error object", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw { status: 404, type: "x" };
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      const body = await res.json();
+      expect(body.type).toBe("about:blank");
+      expect(body.status).toBe(500);
+      t.errors = [];
+    });
+
+    it("does not take type from a plain Error property", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        const error = new Error("boom") as Error & { type: string };
+        error.type = "entity.too.large";
+        throw error;
+      });
+      const res = await t.fetch("/");
+      expect((await res.json()).type).toBe("about:blank");
+      t.errors = [];
+    });
+  });
+
+  // Techspec: edge cases and non-reformatting
+  describe("edge cases with option on", () => {
+    it("formats an HTTPError that is returned instead of thrown", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => new HTTPError({ status: 409, message: "conflito" }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect((await res.json()).detail).toBe("conflito");
+    });
+
+    it("does not reformat a Response returned by the handler", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => new Response("nope", { status: 404 }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).not.toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.text()).toBe("nope");
+    });
+
+    it("does not reformat a custom Response returned by onError", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => new Response("custom", { status: 418 });
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(res.headers.get("content-type")).not.toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.text()).toBe("custom");
+    });
+
+    it("renders the problem format when onError returns nothing", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.onError = () => {};
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+    });
+
+    it("renders a 500 problem when data cannot be serialized", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        const data: Record<string, unknown> = {};
+        data.self = data;
+        throw new HTTPError({ status: 400, data });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      t.errors = [];
+    });
+
+    it("omits stack in debug mode", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.json()).not.toHaveProperty("stack");
+    });
+
+    it("sends status and content-type without body for HEAD", async () => {
+      t.app.config.problemDetails = true;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404, message: "x" });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.text()).toBe("");
+    });
+
+    it("formats an HTTPError returned through an onResponse middleware", async () => {
+      t.app.config.problemDetails = true;
+      t.app.use(onResponse(() => undefined));
+      t.app.get("/", () => new HTTPError({ status: 410, message: "gone" }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(410);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+    });
+  });
+
+  // Techspec D-10: the app that receives the request decides the format
+  describe("mounted sub-apps", () => {
+    it("uses the sub-app config when mounted as a fetchable", async () => {
+      const sub = new H3();
+      sub.config.problemDetails = true;
+      sub.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      t.app.mount("/sub", { fetch: (req: Request) => sub.fetch(req) });
+      const res = await t.fetch("/sub/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+    });
+
+    it("uses the parent config when mounted as an app", async () => {
+      const sub = new H3();
+      sub.config.problemDetails = true;
+      sub.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      t.app.mount("/sub", sub);
+      const res = await t.fetch("/sub/");
+      expect(res.headers.get("content-type")).toBe(DEFAULT_CONTENT_TYPE);
+    });
+  });
+});
