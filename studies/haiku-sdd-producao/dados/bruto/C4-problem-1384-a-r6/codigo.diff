index 0000000..c62c2d6
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,67 @@
+import type { HTTPError } from "../../error.ts";
+
+/**
+ * Problem details body (RFC 9457, section 3.1).
+ */
+export interface ProblemDetails {
+  type: string;
+  title?: string;
+  status: number;
+  detail?: string;
+  instance?: string;
+}
+
+/**
+ * Build the RFC 9457 body for an error. Unhandled errors hide their message, type and instance,
+ * as `HTTPError#toJSON` does.
+ */
+export function toProblemDetails(error: HTTPError): ProblemDetails {
+  const masked = error.unhandled;
+  return {
+    type: (!masked && error.type) || "about:blank",
+    title: statusTitles[error.status] ?? error.statusText,
+    status: error.status,
+    detail: masked ? undefined : error.message,
+    instance: masked ? undefined : error.instance,
+  };
+}
+
+// Reason phrases from the IANA HTTP Status Code Registry (common codes)
+const statusTitles: Record<number, string> = {
+  400: "Bad Request",
+  401: "Unauthorized",
+  402: "Payment Required",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  407: "Proxy Authentication Required",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  411: "Length Required",
+  412: "Precondition Failed",
+  413: "Content Too Large",
+  414: "URI Too Long",
+  415: "Unsupported Media Type",
+  416: "Range Not Satisfiable",
+  417: "Expectation Failed",
+  418: "I'm a Teapot",
+  421: "Misdirected Request",
+  422: "Unprocessable Content",
+  423: "Locked",
+  424: "Failed Dependency",
+  425: "Too Early",
+  426: "Upgrade Required",
+  428: "Precondition Required",
+  429: "Too Many Requests",
+  431: "Request Header Fields Too Large",
+  451: "Unavailable For Legal Reasons",
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+  505: "HTTP Version Not Supported",
+  511: "Network Authentication Required",
+};
diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..4e1fbf7
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,249 @@
+import { describe, expect, it } from "vitest";
+import { H3, HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_JSON = "application/problem+json";
+
+describe("sdd: problemDetails option (RF-01)", () => {
+  it("is true when enabled", () => {
+    const app = new H3({ problemDetails: true });
+    expect(app.config.problemDetails).toBe(true);
+  });
+
+  it("defaults to false when not provided", () => {
+    const app = new H3();
+    expect(app.config.problemDetails).toBe(false);
+  });
+});
+
+describe("sdd: HTTPError type and instance (RF-03, D-01)", () => {
+  it("exposes type and instance", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-saldo",
+      instance: "/pagamentos/42",
+    });
+    expect(error.type).toBe("https://exemplo.com/erros/sem-saldo");
+    expect(error.instance).toBe("/pagamentos/42");
+  });
+
+  it("leaves type and instance undefined when not provided", () => {
+    const error = new HTTPError({ status: 403 });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("does not add type or instance to toJSON()", () => {
+    const body = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-saldo",
+      instance: "/pagamentos/42",
+    }).toJSON();
+    expect(body).not.toHaveProperty("type");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("does not inherit type or instance from details.cause", () => {
+    const error = new HTTPError({
+      status: 500,
+      cause: { type: "https://exemplo.com/erros/interno", instance: "/interno" },
+    });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+});
+
+describeMatrix("sdd: problem details rendering", (t, { it, expect }) => {
+  const enable = () => {
+    t.app.config.problemDetails = true;
+  };
+
+  it("renders HTTPError as application/problem+json (RF-02)", async () => {
+    enable();
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 404, message: "Usuário não encontrado" });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    expect(await res.json()).toMatchObject({
+      status: 404,
+      title: "Not Found",
+      detail: "Usuário não encontrado",
+    });
+  });
+
+  it("includes type and instance from HTTPError (RF-04)", async () => {
+    enable();
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 403,
+        message: "Sem saldo",
+        type: "https://exemplo.com/erros/sem-saldo",
+        instance: "/pagamentos/42",
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "https://exemplo.com/erros/sem-saldo",
+      instance: "/pagamentos/42",
+    });
+  });
+
+  it("uses about:blank as type when HTTPError has no type (RF-04)", async () => {
+    enable();
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 400, message: "Ruim" });
+    });
+
+    const body = await (await t.fetch("/")).json();
+    expect(body.type).toBe("about:blank");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("does not include stack, even in debug mode", async () => {
+    enable();
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 400, message: "Ruim" });
+    });
+
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("stack");
+  });
+
+  it("applies error.headers over the problem details content type (D-06)", async () => {
+    enable();
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 400,
+        message: "Ruim",
+        headers: { "content-type": "application/custom+json", "x-error-own": "own" },
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/custom+json");
+    expect(res.headers.get("x-error-own")).toBe("own");
+  });
+
+  it("omits the body for HEAD but keeps the problem content type", async () => {
+    enable();
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 400, message: "Ruim" });
+    });
+
+    const res = await t.fetch("/", { method: "HEAD" });
+    expect(res.status).toBe(400);
+    expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+    expect(await res.text()).toBe("");
+  });
+
+  for (const withOnError of [false, true]) {
+    const hook = withOnError ? "with onError" : "without onError";
+
+    it(`renders problem details when onError returns nothing, ${hook}`, async () => {
+      enable();
+      if (!withOnError) t.app.config.onError = undefined;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 409, message: "Conflito" });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(await res.json()).toMatchObject({ status: 409, detail: "Conflito" });
+    });
+  }
+
+  it("lets a Response returned by onError replace the problem details (R-09)", async () => {
+    enable();
+    t.app.config.onError = () => new Response("custom", { status: 503 });
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 409, message: "Conflito" });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(503);
+    expect(res.headers.get("content-type")).not.toBe(PROBLEM_JSON);
+    expect(await res.text()).toBe("custom");
+  });
+
+  it("keeps the current error format when the option is off (RF-06)", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 403,
+        message: "Sem saldo",
+        type: "https://exemplo.com/erros/sem-saldo",
+        instance: "/pagamentos/42",
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(403);
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    const body = await res.json();
+    expect(body).not.toHaveProperty("type");
+    expect(body).not.toHaveProperty("instance");
+    expect(body).toHaveProperty("stack");
+  });
+
+  it("keeps the current error format when problemDetails is false (RF-06)", async () => {
+    t.app.config.problemDetails = false;
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 403, message: "Sem saldo" });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+  });
+});
+
+describeMatrix(
+  "sdd: problem details do not leak unhandled errors",
+  (t, { it, expect }) => {
+    const leak = "falha interna do banco";
+
+    it("renders a plain Error as 500 without its message (RF-05)", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error(leak);
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      const text = await res.text();
+      expect(text).not.toContain(leak);
+      expect(JSON.parse(text)).not.toHaveProperty("detail");
+    });
+
+    it("renders a thrown string as 500 without its message (RF-05)", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw leak;
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(await res.text()).not.toContain(leak);
+    });
+
+    it("does not leak unhandled errors type or instance (D-05)", async () => {
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw Object.assign(new Error(leak), { type: "https://exemplo.com/vazado" });
+      });
+
+      const text = await (await t.fetch("/")).text();
+      expect(text).not.toContain(leak);
+      expect(text).not.toContain("https://exemplo.com/vazado");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
