diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..1eb0c94
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,242 @@
+import { describe, it, expect } from "vitest";
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests derived from sdd/prd.md (RF-01 to RF-08) and sdd/techspec.md (D-03 to D-05).
+
+describe("HTTPError type and instance", () => {
+  it("exposes type and instance when given (RF-04)", () => {
+    const error = new HTTPError({ status: 400, message: "x", type: "urn:erro:x", instance: "/a" });
+    expect(error.type).toBe("urn:erro:x");
+    expect(error.instance).toBe("/a");
+  });
+
+  it("leaves type and instance undefined when not given (RF-04)", () => {
+    const error = new HTTPError({ status: 400, message: "x" });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  it("does not read type from cause (D-04)", () => {
+    const error = new HTTPError({
+      cause: new HTTPError({ status: 400, type: "urn:x" }),
+    });
+    expect(error.type).toBeUndefined();
+  });
+
+  it("keeps type and instance out of toJSON (D-03, RF-05)", () => {
+    const error = new HTTPError({
+      status: 400,
+      message: "x",
+      type: "urn:erro:x",
+      instance: "/a",
+    });
+    const json = error.toJSON();
+    expect(json).not.toHaveProperty("type");
+    expect(json).not.toHaveProperty("instance");
+  });
+});
+
+describeMatrix(
+  "problem details: option off by default",
+  (t, { it, expect }) => {
+    it("leaves problemDetails unset in config (RF-01)", () => {
+      expect(t.app.config.problemDetails).toBeFalsy();
+    });
+
+    it("keeps the JSON error body and content type (RF-05)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "x",
+          type: "urn:erro:x",
+          instance: "/a",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toEqual({ status: 400, message: "x" });
+    });
+
+    it("keeps the JSON 404 for a missing route (RF-05)", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    });
+  },
+  { config: { debug: false } },
+);
+
+describeMatrix(
+  "problem details: rendering",
+  (t, { it, expect }) => {
+    it("renders HTTPError as problem details (RF-02)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 422, message: "Dados inválidos" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(await res.json()).toMatchObject({ status: 422, detail: "Dados inválidos" });
+    });
+
+    it("renders the 404 for a missing route as problem details (RF-02)", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+    });
+
+    it("maps HTTPError fields to the problem members (RF-03)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 403,
+          statusText: "Forbidden",
+          message: "Sem permissão",
+          type: "https://exemplo.com/erros/sem-permissao",
+          instance: "/pedidos/42",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(await res.json()).toEqual({
+        type: "https://exemplo.com/erros/sem-permissao",
+        title: "Forbidden",
+        status: 403,
+        detail: "Sem permissão",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("uses about:blank when type is missing (RF-03)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("about:blank");
+    });
+
+    it("omits title when statusText is missing (RF-03)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("does not let body override status or title (D-05)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 409,
+          statusText: "Conflict",
+          message: "x",
+          body: { status: 200, title: "forjado" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({ status: 409, title: "Conflict" });
+    });
+
+    it("forwards error headers (RF-08)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 429,
+          message: "x",
+          headers: { "retry-after": "30" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("retry-after")).toBe("30");
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+    });
+
+    it("returns no body for HEAD (R-8)", async () => {
+      t.app.all("/head", () => {
+        throw new HTTPError({ status: 422, message: "x" });
+      });
+      const res = await t.fetch("/head", { method: "HEAD" });
+      expect(res.status).toBe(422);
+      expect(await res.text()).toBe("");
+    });
+  },
+  { config: { problemDetails: true, debug: false } },
+);
+
+describeMatrix(
+  "problem details: unhandled errors",
+  (t, { it, expect }) => {
+    it("hides the message of an unhandled error (RF-06)", async () => {
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      expect(JSON.parse(text)).toEqual({ type: "about:blank", status: 500 });
+    });
+
+    it("does not read type from the original error (D-04)", async () => {
+      t.app.get("/", () => {
+        throw Object.assign(new Error("x"), { type: "entity.too.large" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({ type: "about:blank" });
+    });
+  },
+  {
+    allowUnhandledErrors: true,
+    config: { problemDetails: true, debug: false, silent: true },
+  },
+);
+
+describeMatrix(
+  "problem details: stack trace only in debug",
+  (t, { it, expect }) => {
+    it("includes stack when debug is on (RF-07)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toHaveProperty("stack");
+    });
+  },
+  { config: { problemDetails: true, debug: true } },
+);
+
+describeMatrix(
+  "problem details: no stack without debug",
+  (t, { it, expect }) => {
+    it("omits stack when debug is off (RF-07)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "x" });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).not.toHaveProperty("stack");
+    });
+  },
+  { config: { problemDetails: true, debug: false } },
+);
+
+describeMatrix(
+  "problem details: onError response",
+  (t, { it, expect }) => {
+    it("delivers the Response returned by onError (RF-08)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 422, message: "x" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(503);
+      expect(await res.text()).toBe("custom");
+    });
+  },
+  {
+    config: {
+      problemDetails: true,
+      debug: false,
+      onError: () => new Response("custom", { status: 503 }),
+    },
+  },
+);
