diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..9454622
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,219 @@
+import { describe, it, expect } from "vitest";
+import { H3, HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemContentType = /^application\/problem\+json/;
+
+const orderError = () =>
+  new HTTPError({
+    status: 404,
+    statusText: "Not Found",
+    message: "Pedido não existe",
+    type: "https://example.com/probs/missing",
+    instance: "/orders/42",
+  });
+
+describe("problem details: config and HTTPError", () => {
+  it("is disabled by default", () => {
+    expect(new H3().config.problemDetails ?? false).toBe(false);
+  });
+
+  it("reads problemDetails from H3 config", () => {
+    expect(new H3({ problemDetails: true }).config.problemDetails).toBe(true);
+  });
+
+  it("exposes type and instance from the HTTPError input", () => {
+    const error = orderError();
+    expect(error.type).toBe("https://example.com/probs/missing");
+    expect(error.instance).toBe("/orders/42");
+  });
+
+  it("leaves type and instance undefined when not provided", () => {
+    const error = new HTTPError({ status: 400, message: "Bad" });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+});
+
+describeMatrix("problem details: default format is unchanged", (t, { it, expect }) => {
+  it("keeps the body and content-type identical when type and instance are set", async () => {
+    t.app.config.debug = false;
+    const base = { status: 404, statusText: "Not Found", message: "Pedido não existe" };
+    t.app.get("/plain/:id", () => {
+      throw new HTTPError(base);
+    });
+    t.app.get("/problem/:id", () => {
+      throw new HTTPError({
+        ...base,
+        type: "https://example.com/probs/missing",
+        instance: "/orders/42",
+      });
+    });
+
+    const plain = await t.fetch("/plain/42");
+    const withFields = await t.fetch("/problem/42");
+
+    expect(withFields.status).toBe(404);
+    expect(withFields.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    expect(withFields.headers.get("content-type")).toBe(plain.headers.get("content-type"));
+    expect(await withFields.text()).toBe(await plain.text());
+  });
+});
+
+describeMatrix("problem details: rendering", (t, { it, expect }) => {
+  it("renders RFC 9457 members from HTTPError", async () => {
+    t.app.config.debug = false;
+    t.app.config.problemDetails = true;
+    t.app.get("/orders/:id", () => {
+      throw orderError();
+    });
+
+    const res = await t.fetch("/orders/42");
+
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toMatch(problemContentType);
+    expect(await res.json()).toEqual({
+      type: "https://example.com/probs/missing",
+      title: "Not Found",
+      status: 404,
+      detail: "Pedido não existe",
+      instance: "/orders/42",
+    });
+  });
+
+  it("uses about:blank and omits instance when the error has neither", async () => {
+    t.app.config.debug = false;
+    t.app.config.problemDetails = true;
+    t.app.get("/fail", () => {
+      throw new HTTPError({ status: 500 });
+    });
+
+    const res = await t.fetch("/fail");
+    const body = await res.json();
+
+    expect(res.status).toBe(500);
+    expect(body).toMatchObject({ type: "about:blank", status: 500 });
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  it("keeps headers and sanitizes statusText as the default path does", async () => {
+    t.app.config.debug = false;
+    t.app.config.problemDetails = true;
+    const rawStatusText = "Too\u0001Many";
+    const sanitized = new HTTPError({ status: 429, statusText: rawStatusText }).statusText;
+    expect(sanitized).toBeDefined();
+    expect(sanitized).not.toContain("\u0001");
+
+    t.app.get("/limited", () => {
+      throw new HTTPError({
+        status: 429,
+        statusText: rawStatusText,
+        headers: { "retry-after": "120" },
+      });
+    });
+
+    const res = await t.fetch("/limited");
+    expect(res.status).toBe(429);
+    expect(res.headers.get("retry-after")).toBe("120");
+    expect(res.headers.get("content-type")).toMatch(problemContentType);
+    expect((await res.json()).title).toBe(sanitized);
+  });
+
+  it("includes stack as an extension member in debug mode", async () => {
+    t.app.config.debug = true;
+    t.app.config.problemDetails = true;
+    t.app.get("/orders/:id", () => {
+      throw orderError();
+    });
+
+    const body = await (await t.fetch("/orders/42")).json();
+
+    expect(Array.isArray(body.stack)).toBe(true);
+  });
+
+  it("merges errHeaders once", async () => {
+    t.app.config.debug = false;
+    t.app.config.problemDetails = true;
+    t.app.get("/orders/:id", (event) => {
+      event.res.errHeaders.set("x-error", "1");
+      event.res.errHeaders.append("set-cookie", "prepared=1");
+      throw orderError();
+    });
+
+    const res = await t.fetch("/orders/42");
+
+    expect(res.headers.get("x-error")).toBe("1");
+    expect(res.headers.getSetCookie()).toEqual(["prepared=1"]);
+  });
+
+  it("passes type and instance to onError and calls onResponse once", async () => {
+    t.app.config.debug = false;
+    t.app.config.problemDetails = true;
+    t.app.get("/orders/:id", () => {
+      throw orderError();
+    });
+
+    const res = await t.fetch("/orders/42");
+
+    expect(res.status).toBe(404);
+    expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+    const [error] = t.hooks.onError.mock.calls[0]!;
+    expect(error.type).toBe("https://example.com/probs/missing");
+    expect(error.instance).toBe("/orders/42");
+    expect(t.hooks.onResponse).toHaveBeenCalledTimes(1);
+    // The node adapter hands `onResponse` a 200 response even without problemDetails (pre-existing),
+    // so the final status is only checked on web.
+    if (t.target === "web") {
+      const [response] = t.hooks.onResponse.mock.calls[0]!;
+      expect(response.status).toBe(404);
+    }
+  });
+});
+
+describeMatrix(
+  "problem details: unhandled errors",
+  (t, { it, expect }) => {
+    it("hides the message and stack of a plain Error (RF-06)", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/boom", () => {
+        throw new Error("senha do banco: x");
+      });
+
+      const res = await t.fetch("/boom");
+      const text = await res.text();
+
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toMatch(problemContentType);
+      expect(text).not.toContain("senha do banco");
+      expect(text).not.toContain("stack");
+      expect(text).not.toContain("    at ");
+      expect(JSON.parse(text)).toMatchObject({ type: "about:blank", status: 500 });
+    });
+
+    it("uses about:blank and omits instance for an unhandled HTTPError (D-05)", async () => {
+      t.app.config.debug = false;
+      t.app.config.problemDetails = true;
+      t.app.config.silent = true;
+      t.app.get("/secret", () => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          message: "segredo interno",
+          type: "https://x/y",
+          instance: "/a",
+        });
+      });
+
+      const res = await t.fetch("/secret");
+      const text = await res.text();
+
+      expect(res.status).toBe(500);
+      expect(JSON.parse(text)).toMatchObject({ type: "about:blank", status: 500 });
+      expect(JSON.parse(text)).not.toHaveProperty("instance");
+      expect(text).not.toContain("segredo interno");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
