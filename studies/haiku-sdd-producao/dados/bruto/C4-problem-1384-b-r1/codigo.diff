--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,246 @@
+import { describe as describeUnit, expect as expectUnit, it as itUnit } from "vitest";
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for sdd/prd.md (RF-01 to RF-07) and sdd/techspec.md (D-04, D-08).
+// Every error response is an RFC 9457 problem details document.
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect }) => {
+  // Stack traces carry the error message; debug mode exposes them by design,
+  // so the leak checks run with debug disabled.
+  const disableDebug = () => {
+    t.app.config.debug = false;
+  };
+
+  it("RF-01: HTTPError is rendered as application/problem+json", async () => {
+    t.app.get("/users/1", () => {
+      throw new HTTPError({ status: 404, message: "Usuário não encontrado" });
+    });
+
+    const res = await t.fetch("/users/1");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    expect(await res.json()).toMatchObject({
+      status: 404,
+      detail: "Usuário não encontrado",
+      title: "Not Found",
+    });
+  });
+
+  it("RF-03: type defaults to about:blank and instance is omitted when not set", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 400, message: "bad" });
+    });
+
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(body.type).toBe("about:blank");
+    expect("instance" in body).toBe(false);
+  });
+
+  it("RF-02: type and instance are sent in the body", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 403,
+        message: "Sem permissão",
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+      status: 403,
+    });
+  });
+
+  it("RF-04: unhandled HTTPError does not expose message or data", async () => {
+    disableDebug();
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 500,
+        message: "segredo do banco",
+        data: { senha: "x" },
+        unhandled: true,
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(500);
+    const text = await res.text();
+    expect(text).not.toContain("segredo do banco");
+    expect(text).not.toContain("senha");
+    expect(JSON.parse(text)).toMatchObject({
+      title: "Internal Server Error",
+      type: "about:blank",
+      status: 500,
+    });
+    expect(JSON.parse(text)).not.toHaveProperty("unhandled");
+    t.errors = [];
+  });
+
+  it("RF-04: foreign HTTPError-named error does not leak its URL", async () => {
+    disableDebug();
+    class UpstreamHTTPError extends Error {
+      override name = "HTTPError";
+    }
+    t.app.get("/", () => {
+      throw new UpstreamHTTPError("Request failed: GET https://internal/?token=secret");
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(500);
+    const text = await res.text();
+    expect(text).not.toContain("token=secret");
+    expect(JSON.parse(text)).toMatchObject({ title: "Internal Server Error" });
+    t.errors = [];
+  });
+
+  it("RF-05: data and body are kept as extension members", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 422,
+        message: "Inválido",
+        data: { campo: "email" },
+        body: { codigo: "INVALIDO" },
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      status: 422,
+      data: { campo: "email" },
+      codigo: "INVALIDO",
+    });
+  });
+
+  it("RF-06: error headers are kept next to the problem content type", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 401,
+        message: "Não autenticado",
+        headers: { "WWW-Authenticate": "Bearer" },
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.headers.get("www-authenticate")).toBe("Bearer");
+    expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+  });
+
+  it("RF-07: plain Error becomes a 500 problem document without its message", async () => {
+    disableDebug();
+    t.app.get("/", () => {
+      throw new Error("falha inesperada");
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(500);
+    expect(res.headers.get("content-type")).toMatch(/^application\/problem\+json/);
+    const text = await res.text();
+    expect(text).not.toContain("falha inesperada");
+    expect(JSON.parse(text)).toMatchObject({
+      type: "about:blank",
+      title: "Internal Server Error",
+      status: 500,
+    });
+    t.errors = [];
+  });
+
+  it("D-08: body members cannot override RFC members", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({
+        status: 404,
+        message: "não achou",
+        body: { status: 999, type: "x", title: "forged" },
+      });
+    });
+
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(await res.json()).toMatchObject({
+      status: 404,
+      type: "about:blank",
+      title: "Not Found",
+    });
+  });
+
+  it("D-04: statusText is the title for handled errors", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 422, statusText: "Unprocessable", message: "x" });
+    });
+
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({ title: "Unprocessable" });
+  });
+
+  it("D-04: unhandled errors ignore statusText and use the reason phrase", async () => {
+    disableDebug();
+    t.app.get("/", () => {
+      throw new HTTPError({ status: 500, statusText: "Leaky Status", unhandled: true });
+    });
+
+    const res = await t.fetch("/");
+    const text = await res.text();
+    expect(text).not.toContain("Leaky Status");
+    expect(JSON.parse(text)).toMatchObject({ title: "Internal Server Error" });
+    t.errors = [];
+  });
+});
+
+describeUnit("HTTPError type and instance", () => {
+  itUnit("RF-02: exposes type and instance as properties", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    });
+    expectUnit(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+    expectUnit(error.instance).toBe("/pedidos/42");
+  });
+
+  itUnit("RF-02: inherits type and instance from cause", () => {
+    const error = new HTTPError({ cause: { status: 400, type: "u", instance: "i" } });
+    expectUnit(error.type).toBe("u");
+    expectUnit(error.instance).toBe("i");
+  });
+
+  itUnit("RF-03: type and instance are undefined when not provided", () => {
+    const error = new HTTPError({ status: 400, message: "bad" });
+    expectUnit(error.type).toBeUndefined();
+    expectUnit(error.instance).toBeUndefined();
+    expectUnit(error.toJSON().type).toBe("about:blank");
+    // `instance` is undefined in toJSON(); JSON serialization is what omits it from the body
+    expectUnit(JSON.parse(JSON.stringify(error))).not.toHaveProperty("instance");
+  });
+
+  itUnit("toJSON title is the reason phrase for the codes h3 generates", () => {
+    const expected: Record<number, string> = {
+      400: "Bad Request",
+      401: "Unauthorized",
+      403: "Forbidden",
+      404: "Not Found",
+      405: "Method Not Allowed",
+      409: "Conflict",
+      413: "Content Too Large",
+      415: "Unsupported Media Type",
+      422: "Unprocessable Content",
+      429: "Too Many Requests",
+      500: "Internal Server Error",
+      502: "Bad Gateway",
+      504: "Gateway Timeout",
+    };
+    for (const [status, title] of Object.entries(expected)) {
+      const error = new HTTPError({ status: Number(status), message: "m" });
+      expectUnit(error.toJSON().title).toBe(title);
+    }
+  });
+
+  itUnit("reasonPhrase returns RFC 9110 phrases and undefined for unknown codes", async () => {
+    const { reasonPhrase } = await import("../src/utils/internal/status-text.ts");
+    expectUnit(reasonPhrase(422)).toBe("Unprocessable Content");
+    expectUnit(reasonPhrase(499)).toBeUndefined();
+  });
+});
