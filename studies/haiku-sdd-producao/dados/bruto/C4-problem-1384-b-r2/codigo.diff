diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..35bef1c
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,264 @@
+import { HTTPError, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PROBLEM_CONTENT_TYPE = "application/problem+json;charset=UTF-8";
+
+describeMatrix("sdd: problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  describe("RF-01 error body members", () => {
+    it("renders a thrown HTTPError as problem details", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404, message: "Usuário não encontrado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não encontrado",
+      });
+    });
+
+    it("renders a returned HTTPError as problem details", async () => {
+      t.app.get("/", () => new HTTPError({ status: 409, message: "Conflict here" }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Conflict",
+        status: 409,
+        detail: "Conflict here",
+      });
+    });
+
+    it("renders a missing route (kNotFound) as problem details", async () => {
+      const res = await t.fetch("/missing");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: expect.stringContaining("Cannot find any route matching"),
+      });
+    });
+
+    it("renders an unhandled error without detail and with masked message", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("database password is hunter2");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      const body = await res.json();
+      expect(body).toMatchObject({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        unhandled: true,
+        message: "HTTPError",
+      });
+      expect(body).not.toHaveProperty("detail");
+      expect(JSON.stringify(body)).not.toContain("hunter2");
+      t.errors = [];
+    });
+
+    it("renders HEAD errors with the problem content type and no body", async () => {
+      const res = await t.fetch("/missing", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.text()).toBe("");
+    });
+  });
+
+  describe("RF-02 content type", () => {
+    it("uses application/problem+json for every error source", async () => {
+      t.app.get("/thrown", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      t.app.get("/returned", () => new HTTPError({ status: 400 }));
+      for (const path of ["/thrown", "/returned", "/missing"]) {
+        const res = await t.fetch(path);
+        expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      }
+    });
+  });
+
+  describe("RF-03 type and instance", () => {
+    it("exposes type and instance on the error", () => {
+      const error = new HTTPError({
+        status: 403,
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+      expect(error.type).toBe("https://exemplo.com/erros/sem-permissao");
+      expect(error.instance).toBe("/pedidos/42");
+    });
+
+    it("inherits type and instance from cause", () => {
+      const error = new HTTPError({
+        status: 403,
+        cause: { type: "https://exemplo.com/erros/outro", instance: "/pedidos/7" },
+      });
+      expect(error.type).toBe("https://exemplo.com/erros/outro");
+      expect(error.instance).toBe("/pedidos/7");
+    });
+
+    it("renders type and instance in the body", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 403,
+          type: "https://exemplo.com/erros/sem-permissao",
+          instance: "/pedidos/42",
+          message: "Sem permissão",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+    });
+  });
+
+  describe("RF-04 default type", () => {
+    it("uses about:blank when type is not informed", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 500 });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ type: "about:blank" });
+      t.errors = [];
+    });
+  });
+
+  describe("RF-05 title and detail", () => {
+    it("uses statusText as title and omits detail when no message is given", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 422, statusText: "Unprocessable Content" });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(body).toMatchObject({ title: "Unprocessable Content", status: 422 });
+      expect(body).not.toHaveProperty("detail");
+    });
+
+    it("uses the default reason phrase as title when statusText is missing", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404);
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ title: "Not Found" });
+    });
+
+    it("keeps detail when the message equals the statusText", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "Bad Request", statusText: "Bad Request" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ detail: "Bad Request", title: "Bad Request" });
+    });
+
+    it("maps status codes outside the reason phrase table to Error", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 599 });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ title: "Error", status: 599 });
+    });
+  });
+
+  describe("RF-06 data and body preservation", () => {
+    it("keeps data as an extension member", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, data: { campo: "email" } });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ data: { campo: "email" }, status: 400 });
+    });
+
+    it("keeps body members as extension members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "bad", body: { x: 1 } });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ x: 1, detail: "bad" });
+    });
+
+    it("does not let body override h3 members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "bad",
+          body: {
+            status: 200,
+            type: "urn:forjado",
+            title: "forjado",
+            detail: "forjado",
+            instance: "/forjado",
+          },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(await res.json()).toMatchObject({
+        status: 400,
+        type: "about:blank",
+        title: "Bad Request",
+        detail: "bad",
+      });
+    });
+  });
+
+  describe("RF-07 stack only in debug", () => {
+    it("omits stack when debug is disabled", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "bad" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).not.toHaveProperty("stack");
+    });
+
+    it("renders stack as an array of lines when debug is enabled", async () => {
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, message: "bad" });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(body.stack.length).toBeGreaterThan(0);
+      expect(body.stack.every((line: unknown) => typeof line === "string")).toBe(true);
+    });
+  });
+
+  describe("RF-08 headers", () => {
+    it("applies error headers and prepared error headers", async () => {
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("x-error", "prepared");
+        throw new HTTPError({
+          status: 429,
+          message: "slow down",
+          headers: { "retry-after": "30" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(429);
+      expect(res.headers.get("retry-after")).toBe("30");
+      expect(res.headers.get("x-error")).toBe("prepared");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+    });
+  });
+
+  describe("RF-09 success responses unchanged", () => {
+    it("keeps application/json for object responses", async () => {
+      t.app.get("/", () => ({ ok: true }));
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toEqual({ ok: true });
+    });
+  });
+});
