index 0000000..2f7dbc9
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,38 @@
+import type { HTTPError } from "../../error.ts";
+import { defaultStatusText } from "./status-text.ts";
+
+/**
+ * Body of an RFC 9457 problem details response.
+ */
+export interface ProblemDetails {
+  type: string;
+  title: string;
+  status: number;
+  detail?: string;
+  instance?: string;
+  [extension: string]: unknown;
+}
+
+/**
+ * Build the RFC 9457 body of an h3 error.
+ *
+ * The `body` of the error is spread first, so the members set by h3 win over it on conflicts.
+ * Unhandled errors do not expose `body`, `data` or the message, and only carry `detail` when a
+ * message was explicitly provided.
+ */
+export function toProblemDetails(error: HTTPError, debug?: boolean): ProblemDetails {
+  const unhandled = error.unhandled;
+  return {
+    ...(unhandled ? undefined : error.body),
+    type: error.type ?? "about:blank",
+    title: error.statusText || defaultStatusText(error.status),
+    status: error.status,
+    detail: unhandled || !error["~hasMessage"] ? undefined : error.message,
+    instance: error.instance,
+    message: unhandled ? "HTTPError" : error.message,
+    statusText: error.statusText,
+    unhandled,
+    data: unhandled ? undefined : error.data,
+    stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
+  };
+}
