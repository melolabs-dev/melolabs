diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..c0af758
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,247 @@
+import { describe, expect, it } from "vitest";
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for RFC 9457 problem details (sdd/prd.md RF-01..RF-04, sdd/techspec.md §5.1).
+// `allowUnhandledErrors`: several cases throw unhandled errors on purpose and assert on them.
+describeMatrix(
+  "problem details (sdd)",
+  (t, { it, expect }) => {
+    const PROBLEM_JSON = "application/problem+json";
+
+    it("RF-01: renders HTTPError as application/problem+json with RFC 9457 members", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found", { message: "Usuário não existe" });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(await res.json()).toEqual({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não existe",
+      });
+    });
+
+    it("RF-02: uses about:blank as type and keeps data as an extension member", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({ status: 422, statusText: "Unprocessable", data: { campo: "email" } });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      const body = await res.json();
+      expect(body.type).toBe("about:blank");
+      expect(body.title).toBe("Unprocessable");
+      expect(body.status).toBe(422);
+      expect(body.data).toEqual({ campo: "email" });
+    });
+
+    it("RF-02: body extension members never override RFC members", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 422,
+          statusText: "Unprocessable",
+          message: "Dados inválidos",
+          body: { status: 999, title: "hacked", type: "https://evil.example/x", extra: true },
+        });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        type: "about:blank",
+        title: "Unprocessable",
+        status: 422,
+        detail: "Dados inválidos",
+        extra: true,
+      });
+    });
+
+    it("RF-02: title falls back to the RFC 9110 reason phrase when statusText is missing", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({ status: 404 });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body.title).toBe("Not Found");
+      expect(body.status).toBe(404);
+    });
+
+    it("RF-02: title is omitted when neither statusText nor a reason phrase exists", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({ status: 499 });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(499);
+      const body = await res.json();
+      expect(body).not.toHaveProperty("title");
+      expect(body.status).toBe(499);
+    });
+
+    it("RF-03: type and instance are readonly properties of the error", () => {
+      const error = new HTTPError({
+        status: 403,
+        type: "https://example.com/probs/sem-permissao",
+        instance: "/pedidos/42",
+      });
+      expect(error.type).toBe("https://example.com/probs/sem-permissao");
+      expect(error.instance).toBe("/pedidos/42");
+    });
+
+    it("RF-03: type and instance appear in the response body", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 403,
+          message: "Sem permissão",
+          type: "https://example.com/probs/sem-permissao",
+          instance: "/pedidos/42",
+        });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).toEqual({
+        type: "https://example.com/probs/sem-permissao",
+        title: "Forbidden",
+        status: 403,
+        detail: "Sem permissão",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("RF-03: instance is absent from the body when not provided", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({ status: 403 });
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("RF-04: unhandled errors hide detail and stack when debug is off", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new Error("segredo do banco");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      const body = JSON.parse(text);
+      expect(body.status).toBe(500);
+      expect(body).not.toHaveProperty("detail");
+      expect(body).not.toHaveProperty("stack");
+      expect(t.errors.some((error) => error.unhandled)).toBe(true);
+    });
+
+    it("RF-04: unhandled errors ignore their type and omit their instance", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          type: "https://example.com/probs/interno",
+          instance: "/pedidos/42",
+          message: "segredo do banco",
+        });
+      });
+
+      const res = await t.fetch("/");
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      const body = JSON.parse(text);
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+      expect(body).not.toHaveProperty("detail");
+      expect(body.status).toBe(500);
+    });
+
+    it("RF-04: stack is included as an array of strings in debug mode", async () => {
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found");
+      });
+
+      const body = await (await t.fetch("/")).json();
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(body.stack.length).toBeGreaterThan(0);
+      for (const line of body.stack) {
+        expect(typeof line).toBe("string");
+      }
+    });
+
+    it("keeps error headers and errHeaders while using the problem content type", async () => {
+      t.app.config.debug = false;
+      t.app.use((event) => {
+        event.res.errHeaders.set("x-error", "prepared");
+        throw new HTTPError({
+          status: 422,
+          statusText: "Unprocessable",
+          headers: { "x-error-own": "own" },
+        });
+      });
+
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(res.headers.get("x-error-own")).toBe("own");
+      expect(res.headers.get("x-error")).toBe("prepared");
+    });
+
+    it("omits the body for HEAD requests to a problem response", async () => {
+      t.app.config.debug = false;
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found");
+      });
+
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_JSON);
+      expect(res.headers.get("content-length")).toBeNull();
+      expect(await res.text()).toBe("");
+    });
+
+    it("returns a Response produced by onError unchanged", async () => {
+      t.app.config.onError = () =>
+        new Response("custom", { status: 418, headers: { "content-type": "text/plain" } });
+      t.app.use(() => {
+        throw HTTPError.status(404, "Not Found");
+      });
+
+      const res = await t.fetch("/");
+      expect(res.status).toBe(418);
+      expect(res.headers.get("content-type")).toBe("text/plain");
+      expect(await res.text()).toBe("custom");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
+
+describe("problem details (sdd) unit", () => {
+  it("RF-03 / D-02: toJSON() keeps the legacy shape", () => {
+    const error = new HTTPError({
+      status: 404,
+      statusText: "Not Found",
+      message: "Usuário não existe",
+      data: { campo: "email" },
+      body: { extra: true },
+    });
+    expect(error.toJSON()).toEqual({
+      status: 404,
+      statusText: "Not Found",
+      unhandled: undefined,
+      message: "Usuário não existe",
+      data: { campo: "email" },
+      extra: true,
+    });
+  });
+});
