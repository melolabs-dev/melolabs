diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..739c38e
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,223 @@
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for sdd/prd.md (RF-01 a RF-07) and sdd/techspec.md (D-02, D-04, D-06, D-07).
+// "guards" pass on the current code and must keep passing; the other tests describe the new behavior.
+describeMatrix("problem details (sdd)", (t, { it, expect, describe }) => {
+  const PROBLEM = "application/problem+json";
+
+  describe("RF-01 error response format", () => {
+    it("renders a thrown HTTPError as problem details", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 403, statusText: "Forbidden" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toMatchObject({
+        status: 403,
+        title: "Forbidden",
+        type: "about:blank",
+      });
+    });
+  });
+
+  describe("RF-02 type and instance", () => {
+    const type = "https://exemplo.com/erros/usuario-inexistente";
+
+    it("exposes type and instance on HTTPError and serializes them", async () => {
+      const error = new HTTPError({ status: 404, type, instance: "/usuarios/42" });
+      expect(error.type).toBe(type);
+      expect(error.instance).toBe("/usuarios/42");
+
+      t.app.get("/usuarios/:id", () => {
+        throw error;
+      });
+      const res = await t.fetch("/usuarios/42");
+      expect(res.status).toBe(404);
+      expect(await res.json()).toMatchObject({ type, instance: "/usuarios/42" });
+    });
+
+    it("does not inherit type or instance from cause", async () => {
+      const cause = Object.assign(new Error("payload too large"), {
+        type: "entity.too.large",
+        instance: "/interno",
+      });
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 413, cause });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+    });
+  });
+
+  describe("RF-03 default type and title", () => {
+    it("uses about:blank and the standard phrase when type and statusText are missing", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 500 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Internal Server Error",
+      });
+    });
+
+    it("falls back to Error when the status has no standard phrase", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 599 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(599);
+      expect(await res.json()).toMatchObject({ title: "Error" });
+    });
+  });
+
+  describe("RF-04 detail and existing members", () => {
+    it("exposes the message as detail and keeps message and data", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "Campo inválido",
+          data: { campo: "email" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(await res.json()).toMatchObject({
+        detail: "Campo inválido",
+        message: "Campo inválido",
+        data: { campo: "email" },
+      });
+    });
+  });
+
+  describe("RF-05 unhandled errors stay hidden", () => {
+    // Guard: passes today.
+    it("does not leak the original message, headers or stack without debug", async () => {
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error("senha do banco vazada");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const raw = await res.text();
+      expect(res.status).toBe(500);
+      expect(raw).not.toContain("senha do banco vazada");
+      expect(JSON.stringify([...res.headers])).not.toContain("senha do banco vazada");
+      expect(JSON.parse(raw)).not.toHaveProperty("stack");
+    });
+
+    it("renders detail and message as HTTPError for an unhandled error", async () => {
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error("senha do banco vazada");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({
+        detail: "HTTPError",
+        message: "HTTPError",
+        type: "about:blank",
+      });
+    });
+
+    it("omits type, instance and data from an unhandled HTTPError", async () => {
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          message: "segredo interno",
+          type: "https://exemplo.com/erros/interno",
+          instance: "/interno/1",
+          data: { senha: "x" },
+        });
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const body = await res.json();
+      expect(body).toMatchObject({ type: "about:blank", detail: "HTTPError" });
+      expect(body).not.toHaveProperty("instance");
+      expect(body).not.toHaveProperty("data");
+      expect(JSON.stringify(body)).not.toContain("segredo interno");
+    });
+  });
+
+  describe("RF-06 onError and error headers", () => {
+    it("renders the onError HTTPError as problem details with one Set-Cookie", async () => {
+      t.app.config.onError = () => new HTTPError({ status: 422, instance: "/pedidos/7" });
+      t.app.get("/", (event) => {
+        event.res.errHeaders.append("set-cookie", "auth=1");
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.json()).toMatchObject({ status: 422, instance: "/pedidos/7" });
+      expect(res.headers.getSetCookie()).toEqual(["auth=1"]);
+    });
+
+    // Guard: passes today.
+    it("sends a thrown HTTPError's Set-Cookie header exactly once", async () => {
+      t.app.config.onError = undefined;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 422, headers: { "set-cookie": "error=1" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.getSetCookie()).toEqual(["error=1"]);
+    });
+  });
+
+  describe("RF-07 route not found", () => {
+    it("renders 404 as problem details with the route in detail", async () => {
+      const res = await t.fetch("/inexistente");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      const body = await res.json();
+      expect(body.detail).toContain("[GET]");
+      expect(body.detail).toContain("/inexistente");
+    });
+  });
+
+  describe("D-06 and D-07 body contract", () => {
+    // Guard: passes today.
+    it("keeps plain objects returned by onError as application/json", async () => {
+      t.app.config.onError = () => ({ custom: true });
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toEqual({ custom: true });
+    });
+
+    // Guard: passes today.
+    it("keeps type and title out of toJSON()", () => {
+      expect(new HTTPError({ status: 400 }).toJSON()).not.toHaveProperty("type");
+      expect(new HTTPError({ status: 400 }).toJSON()).not.toHaveProperty("title");
+    });
+
+    it("keeps body members, and lets body override type and title", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 409,
+          body: { foo: 1, title: "Conflito de pedido" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(409);
+      expect(await res.json()).toMatchObject({
+        foo: 1,
+        title: "Conflito de pedido",
+        type: "about:blank",
+      });
+    });
+  });
+});
