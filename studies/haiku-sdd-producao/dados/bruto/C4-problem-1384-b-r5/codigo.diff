@@ -0,0 +1,17 @@
+import { describe, it, expect } from "vitest";
+import { getReasonPhrase } from "../../src/utils/internal/status.ts";
+
+describe("getReasonPhrase", () => {
+  it("returns the IANA reason phrase of registered codes", () => {
+    expect(getReasonPhrase(200)).toBe("OK");
+    expect(getReasonPhrase(404)).toBe("Not Found");
+    expect(getReasonPhrase(418)).toBe("I'm a teapot");
+    expect(getReasonPhrase(422)).toBe("Unprocessable Content");
+    expect(getReasonPhrase(511)).toBe("Network Authentication Required");
+  });
+
+  it("returns Unknown Error for codes without a registered phrase", () => {
+    expect(getReasonPhrase(599)).toBe("Unknown Error");
+    expect(getReasonPhrase(499)).toBe("Unknown Error");
+  });
+});
