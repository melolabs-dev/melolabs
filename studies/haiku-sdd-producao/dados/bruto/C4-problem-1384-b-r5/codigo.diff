diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..80500b1
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,289 @@
+import { HTTPError, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemContentType = "application/problem+json;charset=UTF-8";
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  describe("content type", () => {
+    // RF-01
+    it("sends application/problem+json for an HTTPError", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+    });
+
+    // RF-01
+    it("sends application/problem+json for a status returned by a thrown number", async () => {
+      t.app.get("/", () => {
+        throw 404;
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+    });
+
+    // RF-01
+    it("sends application/problem+json for an unhandled error", async () => {
+      t.app.config.silent = true;
+      t.app.get("/", () => {
+        throw new Error("boom");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+      t.errors = [];
+    });
+
+    // D-04: the h3 content type wins over `HTTPError.headers`
+    it("keeps application/problem+json when HTTPError.headers sets content-type", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, headers: { "content-type": "text/plain" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+    });
+
+    // RF-07
+    it("applies HTTPError headers without losing the problem content type", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 401, headers: { "www-authenticate": "Basic" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(401);
+      expect(res.headers.get("www-authenticate")).toBe("Basic");
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+    });
+
+    // RF-07
+    it("applies event.res.errHeaders to the problem response", async () => {
+      t.app.get("/", (event: H3Event) => {
+        event.res.errHeaders.set("x-err", "1");
+        throw new HTTPError({ status: 400 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("x-err")).toBe("1");
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+    });
+
+    // Regression: HEAD sends no body but keeps the content type
+    it("sends application/problem+json without a body for HEAD", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+      expect(await res.text()).toBe("");
+    });
+  });
+
+  describe("body members", () => {
+    // RF-02
+    it("serializes type, title, status and detail", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 422,
+          statusText: "Unprocessable Content",
+          message: "Campo inválido",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Unprocessable Content",
+        status: 422,
+        detail: "Campo inválido",
+      });
+    });
+
+    // RF-02, D-07
+    it("uses the standard reason phrase as title when statusText is missing", async () => {
+      t.app.get("/thrown", () => {
+        throw 404;
+      });
+      t.app.get("/teapot", () => {
+        throw new HTTPError({ status: 418 });
+      });
+      expect(await (await t.fetch("/thrown")).json()).toMatchObject({
+        title: "Not Found",
+        status: 404,
+      });
+      expect(await (await t.fetch("/teapot")).json()).toMatchObject({
+        title: "I'm a teapot",
+        status: 418,
+      });
+    });
+
+    // D-07
+    it("uses Unknown Error as title for a status without a registered phrase", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 599 });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ title: "Unknown Error", status: 599 });
+    });
+
+    // RF-02: instance is omitted when absent
+    it("omits instance when it was not provided", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({ type: "about:blank", status: 404 });
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    // RF-03
+    it("exposes type and instance and includes them in the body", async () => {
+      const error = new HTTPError({
+        status: 404,
+        type: "https://exemplo.com/erros/usuario-inexistente",
+        instance: "/usuarios/42",
+      });
+      expect(error.type).toBe("https://exemplo.com/erros/usuario-inexistente");
+      expect(error.instance).toBe("/usuarios/42");
+
+      t.app.get("/", () => {
+        throw error;
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        type: "https://exemplo.com/erros/usuario-inexistente",
+        instance: "/usuarios/42",
+        status: 404,
+      });
+    });
+
+    // D-05: `type` is not inherited from `cause`
+    it("does not inherit type from cause", async () => {
+      const error = new HTTPError({ status: 400, cause: { type: "entity.too.large" } });
+      expect(error.type).toBeUndefined();
+
+      t.app.get("/", () => {
+        throw error;
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({ type: "about:blank", status: 400 });
+    });
+
+    // RF-04
+    it("does not expose the message of an unhandled error", async () => {
+      t.app.config.silent = true;
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      expect(JSON.parse(text)).toMatchObject({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        detail: "HTTPError",
+      });
+      t.errors = [];
+    });
+
+    // D-06: type and instance are masked for unhandled errors
+    it("masks type and instance of an unhandled HTTPError", async () => {
+      t.app.config.silent = true;
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          unhandled: true,
+          message: "segredo",
+          type: "https://exemplo.com/erros/interno",
+          instance: "/secret/1",
+        });
+      });
+      const text = await (await t.fetch("/")).text();
+      expect(text).not.toContain("/secret/1");
+      expect(text).not.toContain("segredo");
+      expect(JSON.parse(text)).toMatchObject({ type: "about:blank", detail: "HTTPError" });
+      expect(JSON.parse(text)).not.toHaveProperty("instance");
+      t.errors = [];
+    });
+
+    // RF-05: data and body are extension members; standard members win
+    it("keeps data and body as top level extensions without overriding standard members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "Campo inválido",
+          data: { campo: "email" },
+          body: { status: 1, title: "y", detail: "z", type: "x", topLevel: "works" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        status: 400,
+        title: "Bad Request",
+        detail: "Campo inválido",
+        type: "about:blank",
+        data: { campo: "email" },
+        topLevel: "works",
+      });
+    });
+
+    // RF-06: legacy members stay in the body and in toJSON()
+    it("keeps the legacy members in the body and in toJSON()", async () => {
+      const error = new HTTPError({
+        status: 409,
+        statusText: "Conflict",
+        message: "Conflito",
+        data: { id: 1 },
+      });
+      expect(error.toJSON()).toMatchObject({
+        status: 409,
+        statusText: "Conflict",
+        message: "Conflito",
+        data: { id: 1 },
+        type: "about:blank",
+        title: "Conflict",
+        detail: "Conflito",
+      });
+
+      t.app.get("/", () => {
+        throw error;
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        status: 409,
+        statusText: "Conflict",
+        message: "Conflito",
+        data: { id: 1 },
+        type: "about:blank",
+        title: "Conflict",
+        detail: "Conflito",
+      });
+    });
+  });
+
+  describe("debug stack", () => {
+    // RF-04: stack only in debug mode
+    it("includes stack in debug mode", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(Array.isArray(body.stack)).toBe(true);
+    });
+
+    it("omits stack outside debug mode", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400 });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).not.toHaveProperty("stack");
+    });
+  });
+});
