diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..3141142
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,192 @@
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for sdd/prd.md (RF-01 to RF-08) and sdd/techspec.md (D-01 to D-08).
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  describe("content-type", () => {
+    it("RF-01: error responses use application/problem+json", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404);
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(await res.json()).toMatchObject({ status: 404 });
+    });
+
+    it("RF-06: custom headers and status are kept with problem+json", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(429, "Too Many Requests", {
+          headers: { "retry-after": "30" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(429);
+      expect(res.headers.get("retry-after")).toBe("30");
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+    });
+
+    it("guard: success JSON keeps application/json", async () => {
+      t.app.get("/", () => ({ a: 1 }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toEqual({ a: 1 });
+    });
+  });
+
+  describe("body members", () => {
+    it("RF-02: maps status, statusText, message and default type", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 403,
+          statusText: "Forbidden",
+          message: "Não autenticado",
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        type: "about:blank",
+        title: "Forbidden",
+        status: 403,
+        detail: "Não autenticado",
+      });
+    });
+
+    it("RF-02: title falls back to the standard reason phrase", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404);
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.title).toBe("Not Found");
+      expect(body.detail).toBe("HTTPError 404");
+    });
+
+    it("RF-02: instance key is absent when not informed", async () => {
+      t.app.get("/", () => {
+        throw HTTPError.status(404);
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(Object.keys(body)).not.toContain("instance");
+    });
+
+    it("RF-03: type and instance are exposed on the error and in the body", async () => {
+      const error = new HTTPError({
+        status: 422,
+        message: "Inválido",
+        type: "https://exemplo.com/erros/validacao",
+        instance: "/pedidos/42",
+      });
+      expect(error.type).toBe("https://exemplo.com/erros/validacao");
+      expect(error.instance).toBe("/pedidos/42");
+
+      t.app.get("/", () => {
+        throw error;
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        type: "https://exemplo.com/erros/validacao",
+        instance: "/pedidos/42",
+        status: 422,
+      });
+    });
+
+    it("RF-03: type and instance are inherited from cause", () => {
+      const error = new HTTPError({
+        status: 422,
+        message: "Inválido",
+        cause: { type: "https://exemplo.com/erros/validacao", instance: "/pedidos/42" },
+      });
+      expect(error.type).toBe("https://exemplo.com/erros/validacao");
+      expect(error.instance).toBe("/pedidos/42");
+    });
+
+    it("RF-07: data, body members and message mirror detail", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "Campo obrigatório",
+          data: { campo: "nome" },
+          body: { codigo: "E01" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).toMatchObject({
+        status: 400,
+        detail: "Campo obrigatório",
+        message: "Campo obrigatório",
+        data: { campo: "nome" },
+        codigo: "E01",
+      });
+    });
+
+    it("D-04: body cannot override RFC members", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "x",
+          body: { type: "forjado", title: "y" },
+        });
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body.type).toBe("about:blank");
+      expect(body.title).toBe("Bad Request");
+    });
+  });
+
+  describe("security and debug", () => {
+    it("RF-04: unhandled errors do not leak message, stack or data outside debug", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("senha do banco inválida");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(text).not.toContain("senha do banco inválida");
+      expect(JSON.parse(text)).not.toHaveProperty("stack");
+      expect(JSON.parse(text)).toMatchObject({ status: 500, detail: "HTTPError" });
+    });
+
+    it("RF-04: unhandled errors hide data and body", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 500,
+          message: "senha do banco inválida",
+          unhandled: true,
+          data: { segredo: 1 },
+          body: { vazado: 1 },
+        });
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      expect(text).not.toContain("senha do banco inválida");
+      expect(text).not.toContain("segredo");
+      expect(text).not.toContain("vazado");
+    });
+
+    it("RF-05: stack is a list of lines in debug mode", async () => {
+      t.app.config.debug = true;
+      t.app.get("/", () => {
+        throw HTTPError.status(400);
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(Array.isArray(body.stack)).toBe(true);
+      expect(body.stack.length).toBeGreaterThan(0);
+      expect(body.stack.every((line: unknown) => typeof line === "string")).toBe(true);
+    });
+
+    it("RF-05: stack is absent when debug is off", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw HTTPError.status(400);
+      });
+      const body = await (await t.fetch("/")).json();
+      expect(body).not.toHaveProperty("stack");
+    });
+  });
+});
diff --git a/test/unit/status-text.test.ts b/test/unit/status-text.test.ts
new file mode 100644
index 0000000..661c31e
--- /dev/null
+++ b/test/unit/status-text.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { getReasonPhrase } from "../../src/utils/internal/status-text.ts";
+
+describe("getReasonPhrase", () => {
+  it("returns the RFC 9110 phrase for 4xx and 5xx", () => {
+    expect(getReasonPhrase(404)).toBe("Not Found");
+    expect(getReasonPhrase(500)).toBe("Internal Server Error");
+  });
+
+  it("returns undefined for codes outside the table", () => {
+    expect(getReasonPhrase(499)).toBeUndefined();
+    expect(getReasonPhrase(200)).toBeUndefined();
+  });
+});
