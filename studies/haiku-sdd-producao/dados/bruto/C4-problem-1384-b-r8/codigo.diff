diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..56a7e83
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,184 @@
+import { describe, expect, expectTypeOf, it as plainIt } from "vitest";
+import { HTTPError, type ErrorInput } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests derived from sdd/prd.md (RF-01 to RF-10) and sdd/techspec.md (D-01 to D-08)
+
+describeMatrix("sdd: problem details (RFC 9457)", (t, { it, expect }) => {
+  it("RF-01: responds with problem details and application/problem+json", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({ status: 404, message: "Usuário não encontrado" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe("application/problem+json");
+    expect(await res.json()).toEqual({
+      type: "about:blank",
+      title: "Not Found",
+      status: 404,
+      detail: "Usuário não encontrado",
+    });
+  });
+
+  it("RF-03: sends type and instance in the body", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 403,
+        type: "https://example.com/probs/sem-permissao",
+        instance: "/pedidos/42",
+      });
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({
+      type: "https://example.com/probs/sem-permissao",
+      instance: "/pedidos/42",
+      title: "Forbidden",
+      status: 403,
+    });
+  });
+
+  it("RF-04: hides the message of unhandled errors", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new Error("senha do banco: 123");
+    });
+    const res = await t.fetch("/");
+    const text = await res.text();
+    expect(res.status).toBe(500);
+    expect(text).not.toContain("senha do banco");
+    expect(JSON.parse(text)).toMatchObject({
+      detail: "HTTPError",
+      title: "Internal Server Error",
+      status: 500,
+    });
+    t.errors = [];
+  });
+
+  it("RF-04/D-04: unhandled errors use the standard phrase as title, not statusText", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({ status: 403, statusText: "Leaky", unhandled: true });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(res.status).toBe(403);
+    expect(body).toMatchObject({ title: "Forbidden", detail: "HTTPError" });
+    expect(JSON.stringify(body)).not.toContain("Leaky");
+    t.errors = [];
+  });
+
+  it("RF-05: includes stack only in debug mode", async () => {
+    t.app.use(() => {
+      throw new HTTPError({ status: 400, message: "bad" });
+    });
+    t.app.config.debug = true;
+    const debugBody = await (await t.fetch("/")).json();
+    expect(Array.isArray(debugBody.stack)).toBe(true);
+    expect(debugBody.stack.every((line: unknown) => typeof line === "string")).toBe(true);
+
+    t.app.config.debug = false;
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("stack");
+  });
+
+  it("RF-06: keeps data and body members at the top level", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 422,
+        message: "inválido",
+        data: { campo: "x" },
+        body: { codigo: "E42" },
+      });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({ status: 422, data: { campo: "x" }, codigo: "E42" });
+  });
+
+  it("RF-06/D-03: body members cannot override RFC members", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 400,
+        message: "ruim",
+        body: { status: 999, title: "x", type: "y" },
+      });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).toMatchObject({
+      status: 400,
+      title: "Bad Request",
+      type: "about:blank",
+      detail: "ruim",
+    });
+  });
+
+  it("RF-07: keeps error headers and forces the problem media type", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({
+        status: 400,
+        message: "x",
+        headers: { "x-request-id": "abc", "content-type": "text/plain" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("x-request-id")).toBe("abc");
+    expect(res.headers.get("content-type")).toBe("application/problem+json");
+  });
+
+  it("R4/D-04: omits title when the status has no standard phrase", async () => {
+    t.app.config.debug = false;
+    t.app.use(() => {
+      throw new HTTPError({ status: 499, message: "custom" });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("title");
+    expect(body).toMatchObject({ status: 499, detail: "custom", type: "about:blank" });
+  });
+});
+
+describe("sdd: problem details unit", () => {
+  plainIt("RF-02: exposes type and instance on the error", () => {
+    const error = new HTTPError({
+      status: 403,
+      type: "https://example.com/probs/sem-permissao",
+      instance: "/pedidos/42",
+    });
+    expect(error.type).toBe("https://example.com/probs/sem-permissao");
+    expect(error.instance).toBe("/pedidos/42");
+  });
+
+  plainIt("RF-02: type and instance are undefined when not given", () => {
+    const error = new HTTPError({ status: 403 });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  plainIt("D-05: does not inherit type and instance from cause", () => {
+    const error = new HTTPError({ cause: { type: "x", instance: "y", status: 400 } });
+    expect(error.type).toBeUndefined();
+    expect(error.instance).toBeUndefined();
+  });
+
+  plainIt("D-04: toJSON of an unhandled error ignores statusText", () => {
+    const json = new HTTPError({ status: 403, statusText: "Leaky", unhandled: true }).toJSON();
+    expect(json.title).toBe("Forbidden");
+    expect(JSON.stringify(json)).not.toContain("Leaky");
+  });
+
+  plainIt("D-07: unhandled and statusText stay on the instance", () => {
+    const error = new HTTPError({ status: 403, statusText: "Leaky", unhandled: true });
+    expect(error.unhandled).toBe(true);
+    expect(error.statusText).toBe("Leaky");
+  });
+
+  plainIt("types: ErrorInput and HTTPError accept type and instance as strings", () => {
+    expectTypeOf<ErrorInput["type"]>().toEqualTypeOf<string | undefined>();
+    expectTypeOf<ErrorInput["instance"]>().toEqualTypeOf<string | undefined>();
+    expectTypeOf<HTTPError["type"]>().toEqualTypeOf<string | undefined>();
+    expectTypeOf<HTTPError["instance"]>().toEqualTypeOf<string | undefined>();
+  });
+});
