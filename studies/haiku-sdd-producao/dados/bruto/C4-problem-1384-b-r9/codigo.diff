diff --git a/test/sdd-problem-details.test.ts b/test/sdd-problem-details.test.ts
new file mode 100644
index 0000000..61455c5
--- /dev/null
+++ b/test/sdd-problem-details.test.ts
@@ -0,0 +1,213 @@
+import { HTTPError } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for RFC 9457 problem details (sdd/prd.md RF-01..RF-07, sdd/techspec.md D-03..D-07)
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  const PROBLEM = "application/problem+json";
+
+  describe("content-type", () => {
+    it("HTTPError response is application/problem+json (RF-01)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+    });
+
+    it("HEAD error keeps application/problem+json with an empty body (RF-01)", async () => {
+      t.app.use(() => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.text()).toBe("");
+    });
+
+    // Production mode: `debug` adds the stack trace to the body, which carries the message (techspec D-02).
+    it("unhandled non-HTTPError is a 500 problem+json that hides the message (RF-06)", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new TypeError("x is undefined");
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+      expect(await res.text()).not.toContain("x is undefined");
+      t.errors = [];
+    });
+
+    it("error headers are kept next to the problem content-type (RF-07)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 429, headers: { "Retry-After": "120" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("retry-after")).toBe("120");
+      expect(res.headers.get("content-type")).toBe(PROBLEM);
+    });
+
+    it("content-type given by the user wins over the default (RF-07, D-04)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 400, headers: { "content-type": "text/plain" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toMatch("text/plain");
+    });
+  });
+
+  describe("standard members", () => {
+    it("sets type, title, status and detail from the error (RF-02)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError("Usuário não encontrado", { status: 404, statusText: "Not Found" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Not Found",
+        status: 404,
+        detail: "Usuário não encontrado",
+      });
+    });
+
+    it("title falls back to the standard phrase of the status (RF-02)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 404 });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({ title: "Not Found" });
+    });
+
+    it("title is omitted when the status has no registered phrase (RF-02, D-05)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 599 });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(body).toMatchObject({ type: "about:blank", status: 599 });
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("type and instance are exposed on the HTTPError (RF-03)", () => {
+      const err = new HTTPError({
+        status: 403,
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+      expect(err.type).toBe("https://exemplo.com/erros/sem-permissao");
+      expect(err.instance).toBe("/pedidos/42");
+      expect(JSON.parse(JSON.stringify(err))).toMatchObject({
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("type and instance reach the response body (RF-03)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 403,
+          type: "https://exemplo.com/erros/sem-permissao",
+          instance: "/pedidos/42",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.com/erros/sem-permissao",
+        instance: "/pedidos/42",
+      });
+    });
+
+    it("instance is absent from the body when not given (RF-03)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({ status: 403 });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(body).toMatchObject({ type: "about:blank" });
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("type and instance are not inherited from cause (D-06)", () => {
+      const err = new HTTPError({
+        cause: new HTTPError({ status: 400, type: "https://interno/erro", instance: "/interno" }),
+      });
+      expect(err.type).toBeUndefined();
+      expect(err.instance).toBeUndefined();
+      const body = JSON.parse(JSON.stringify(err));
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+    });
+  });
+
+  describe("legacy members", () => {
+    it("message, data and body fields stay as extensions (RF-04)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          message: "inválido",
+          data: { campo: "email" },
+          body: { codigo: "E01" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        message: "inválido",
+        data: { campo: "email" },
+        codigo: "E01",
+        type: "about:blank",
+        title: "Bad Request",
+        status: 400,
+        detail: "inválido",
+      });
+    });
+
+    it("body cannot override status or RFC members (D-03)", async () => {
+      t.app.get("/", () => {
+        throw new HTTPError({
+          status: 400,
+          body: { status: 999, type: "x", title: "forjado", detail: "y", instance: "/forjado" },
+        });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(res.status).toBe(400);
+      expect(body).toMatchObject({ status: 400, type: "about:blank", title: "Bad Request" });
+      expect(body.detail).toBe(body.message);
+      expect(body).not.toHaveProperty("instance");
+    });
+  });
+
+  describe("unhandled errors", () => {
+    // Production mode: `debug` adds the stack trace to every error body, by design (techspec D-02).
+    it("never leaks the original message, data or stack (RF-05)", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(text).not.toContain("segredo do banco");
+      const body = JSON.parse(text);
+      expect(body).toMatchObject({ status: 500, message: "HTTPError" });
+      expect(body).not.toHaveProperty("data");
+      expect(body).not.toHaveProperty("stack");
+    });
+
+    it("detail is HTTPError and does not expose the original message (RF-05)", async () => {
+      t.app.config.debug = false;
+      t.app.get("/", () => {
+        throw new Error("segredo do banco");
+      });
+      const res = await t.fetch("/");
+      t.errors = [];
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      expect(JSON.parse(text)).toMatchObject({
+        detail: "HTTPError",
+        title: "Internal Server Error",
+      });
+    });
+  });
+});
