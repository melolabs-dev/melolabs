diff --git a/test/sdd-problem.test.ts b/test/sdd-problem.test.ts
new file mode 100644
index 0000000..23f0c3b
--- /dev/null
+++ b/test/sdd-problem.test.ts
@@ -0,0 +1,212 @@
+import { HTTPError, problem, type H3Event } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const problemContentType = "application/problem+json";
+
+// RF-01 — exported utility returns an HTTPError
+describeMatrix("problem() factory", (_t, { it, expect }) => {
+  it("returns an HTTPError recognized by HTTPError.isError", () => {
+    const error = problem({ status: 404, message: "Não encontrado" });
+    expect(error).toBeInstanceOf(HTTPError);
+    expect(HTTPError.isError(error)).toBe(true);
+    expect(error.status).toBe(404);
+  });
+
+  it("rejects a non-string type at compile time", () => {
+    // @ts-expect-error type must be a string
+    expect(() => problem({ status: 400, type: 1 })).toBeDefined();
+  });
+});
+
+describeMatrix("problem() response", (t, { it, expect }) => {
+  // RF-02 — type and instance
+  it("renders the type and instance given by the caller", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 403,
+        message: "Sem acesso",
+        type: "https://exemplo.com/erros/sem-acesso",
+        instance: "/pedidos/42",
+      });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(res.status).toBe(403);
+    expect(body.type).toBe("https://exemplo.com/erros/sem-acesso");
+    expect(body.instance).toBe("/pedidos/42");
+  });
+
+  it("defaults type to about:blank and omits instance", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 403, message: "Sem acesso" });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body.type).toBe("about:blank");
+    expect(body).not.toHaveProperty("instance");
+  });
+
+  // RF-03 — RFC 9457 member mapping
+  it("maps statusText to title, message to detail, and keeps data", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 404,
+        statusText: "Not Found",
+        message: "Pedido inexistente",
+        data: { id: 42 },
+      });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(body.status).toBe(404);
+    expect(body.title).toBe("Not Found");
+    expect(body.detail).toBe("Pedido inexistente");
+    expect(body.type).toBe("about:blank");
+    expect(body.data).toEqual({ id: 42 });
+  });
+
+  it("omits title when statusText is not informed", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 404, message: "Pedido inexistente" });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body).not.toHaveProperty("title");
+    expect(body.detail).toBe("Pedido inexistente");
+  });
+
+  // RF-04 — content-type and headers
+  it("responds with application/problem+json and keeps custom headers", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 429,
+        message: "Muitas requisições",
+        headers: { "retry-after": "30" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(429);
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+    expect(res.headers.get("retry-after")).toBe("30");
+  });
+
+  it("does not let a content-type in headers override problem content-type", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 400,
+        message: "Inválido",
+        headers: { "content-type": "text/plain" },
+      });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+  });
+
+  it("does not let event.res.errHeaders content-type override problem content-type", async () => {
+    t.app.get("/", (event: H3Event) => {
+      event.res.errHeaders.set("content-type", "text/plain");
+      throw problem({ status: 400, message: "Inválido" });
+    });
+    const res = await t.fetch("/");
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+  });
+
+  // D-04 — RFC members win over body extension members
+  it("does not let body members change status or type in the JSON", async () => {
+    t.app.get("/", () => {
+      throw problem({
+        status: 400,
+        message: "Inválido",
+        body: { status: 999, type: "x" },
+      });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(res.status).toBe(400);
+    expect(body.status).toBe(400);
+    expect(body.type).toBe("about:blank");
+  });
+
+  it("exposes body members as top-level extension members when not unhandled", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 400, message: "Inválido", body: { field: "email" } });
+    });
+    const body = await (await t.fetch("/")).json();
+    expect(body.field).toBe("email");
+  });
+
+  // Flow — async and sync handlers, onError, HEAD
+  for (const asyncHandler of [false, true]) {
+    it(`renders problem details thrown from a ${asyncHandler ? "async" : "sync"} handler`, async () => {
+      const handler = () => {
+        throw problem({ status: 422, statusText: "Unprocessable", message: "Campo vazio" });
+      };
+      t.app.get("/", asyncHandler ? async () => handler() : handler);
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.statusText).toBe("Unprocessable");
+      expect(res.headers.get("content-type")).toBe(problemContentType);
+      expect((await res.json()).detail).toBe("Campo vazio");
+    });
+  }
+
+  it("still renders problem details when onError returns nothing", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 409, message: "Conflito" });
+    });
+    const res = await t.fetch("/");
+    expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+    expect((await res.json()).type).toBe("about:blank");
+  });
+
+  it("omits the body for a HEAD request", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 409, message: "Conflito" });
+    });
+    const res = await t.fetch("/", { method: "HEAD" });
+    expect(res.status).toBe(409);
+    expect(res.headers.get("content-type")).toBe(problemContentType);
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-06 — errors without problem() keep the current format
+  it("keeps the default JSON format for a plain HTTPError", async () => {
+    t.app.get("/", () => {
+      throw new HTTPError("Inválido", { status: 400 });
+    });
+    const res = await t.fetch("/");
+    const body = await res.json();
+    expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+    expect(body.status).toBe(400);
+    expect(body).toHaveProperty("message", "Inválido");
+    expect(body).not.toHaveProperty("type");
+    expect(body).not.toHaveProperty("detail");
+  });
+});
+
+// RF-05 — unhandled problem errors do not expose message or data
+describeMatrix(
+  "problem() unhandled errors",
+  (t, { it, expect }) => {
+    for (const debug of [false, true]) {
+      it(`hides message and data for unhandled problems (debug: ${debug})`, async () => {
+        t.app.config.debug = debug;
+        t.app.get("/", () => {
+          throw problem({
+            status: 500,
+            message: "senha do banco vazou",
+            data: { x: 1 },
+            unhandled: true,
+          });
+        });
+        const res = await t.fetch("/");
+        const text = await res.text();
+        expect(res.status).toBe(500);
+        expect(res.headers.get("content-type")).toBe(problemContentType);
+        expect(text).not.toContain('"detail"');
+        expect(text).not.toContain('"data"');
+        expect(JSON.parse(text).status).toBe(500);
+      });
+    }
+  },
+  { allowUnhandledErrors: true },
+);
