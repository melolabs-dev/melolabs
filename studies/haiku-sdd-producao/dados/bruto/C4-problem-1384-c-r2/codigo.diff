diff --git a/test/sdd-problem.test.ts b/test/sdd-problem.test.ts
new file mode 100644
index 0000000..f2c2d14
--- /dev/null
+++ b/test/sdd-problem.test.ts
@@ -0,0 +1,252 @@
+import type { ProblemInput } from "../src/index.ts";
+import { H3, HTTPError, problem } from "../src/index.ts";
+import { describe, expectTypeOf, it } from "vitest";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for `problem()` (RFC 9457), derived from sdd/prd.md (RF-01..RF-08)
+// and sdd/techspec.md (D-01..D-08).
+
+describe("ProblemInput type", () => {
+  it("accepts type and instance, and rejects unknown keys", () => {
+    expectTypeOf<ProblemInput>().toHaveProperty("status");
+    expectTypeOf<ProblemInput>().toHaveProperty("message");
+    expectTypeOf<ProblemInput>().toHaveProperty("type");
+    expectTypeOf<ProblemInput>().toHaveProperty("instance");
+
+    const input: ProblemInput = {
+      status: 403,
+      message: "Sem permissão",
+      type: "https://exemplo.com/erros/sem-permissao",
+      instance: "/pedidos/42",
+    };
+    expectTypeOf(input).toEqualTypeOf<ProblemInput>();
+
+    // @ts-expect-error unknown keys are not part of the input
+    const invalid: ProblemInput = { status: 400, message: "x", unknownKey: true };
+    void invalid;
+  });
+});
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  describe("problem()", () => {
+    it("returns an HTTPError with status and message (RF-01)", () => {
+      const error = problem({ status: 404, message: "Usuário não encontrado" });
+      expect(HTTPError.isError(error)).toBe(true);
+      expect(error).toBeInstanceOf(HTTPError);
+      expect(error.status).toBe(404);
+      expect(error.message).toBe("Usuário não encontrado");
+    });
+
+    it("renders the same response when thrown and when returned (RF-01)", async () => {
+      t.app.get("/thrown", () => {
+        throw problem({ status: 404, message: "Usuário não encontrado" });
+      });
+      t.app.get("/returned", () => problem({ status: 404, message: "Usuário não encontrado" }));
+
+      const thrown = await t.fetch("/thrown");
+      const returned = await t.fetch("/returned");
+
+      expect(returned.status).toBe(thrown.status);
+      expect(returned.headers.get("content-type")).toBe(thrown.headers.get("content-type"));
+      // `stack` comes from debug mode and differs per route, so it is not compared
+      const thrownBody = await thrown.json();
+      const returnedBody = await returned.json();
+      delete thrownBody.stack;
+      delete returnedBody.stack;
+      expect(returnedBody).toEqual(thrownBody);
+    });
+  });
+
+  describe("body fields", () => {
+    it("writes type and instance into the body (RF-02)", async () => {
+      t.app.get("/pedido", () => {
+        throw problem({
+          status: 403,
+          message: "Sem permissão",
+          type: "https://exemplo.com/erros/sem-permissao",
+          instance: "/pedidos/42",
+        });
+      });
+      const body = await (await t.fetch("/pedido")).json();
+      expect(body.type).toBe("https://exemplo.com/erros/sem-permissao");
+      expect(body.instance).toBe("/pedidos/42");
+    });
+
+    it("uses about:blank as type and omits instance when they are not given (RF-02)", async () => {
+      t.app.get("/sem-tipo", () => {
+        throw problem({ status: 500 });
+      });
+      const body = await (await t.fetch("/sem-tipo")).json();
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("instance");
+    });
+
+    it("maps statusText to title, message to detail and keeps data as extension (RF-04)", async () => {
+      t.app.get("/conflito", () => {
+        throw problem({
+          status: 409,
+          statusText: "Conflict",
+          message: "E-mail já cadastrado",
+          data: { field: "email" },
+        });
+      });
+      const body = await (await t.fetch("/conflito")).json();
+      expect(body.status).toBe(409);
+      expect(body.title).toBe("Conflict");
+      expect(body.detail).toBe("E-mail já cadastrado");
+      expect(body.data).toEqual({ field: "email" });
+    });
+
+    it("omits detail when no message is given (D-05)", async () => {
+      t.app.get("/sem-detalhe", () => {
+        throw problem({ status: 500 });
+      });
+      const body = await (await t.fetch("/sem-detalhe")).json();
+      expect(body.status).toBe(500);
+      expect(body).not.toHaveProperty("detail");
+    });
+
+    it("does not leak the message of a cause into detail (D-05)", async () => {
+      t.app.get("/causa", () => {
+        throw problem({
+          status: 400,
+          message: "Entrada inválida",
+          cause: new Error("segredo interno"),
+        });
+      });
+      const text = await (await t.fetch("/causa")).text();
+      const body = JSON.parse(text);
+      expect(body.detail).toBe("Entrada inválida");
+      expect(text).not.toContain("segredo interno");
+    });
+
+    it("does not let body keys override the RFC members (D-05)", async () => {
+      t.app.get("/colisao", () => {
+        throw problem({
+          status: 409,
+          statusText: "Conflict",
+          message: "conflito",
+          type: "https://exemplo.com/erros/conflito",
+          instance: "/recursos/1",
+          body: { title: "hack", status: 1, type: "hack", detail: "hack", instance: "hack" },
+        });
+      });
+      const body = await (await t.fetch("/colisao")).json();
+      expect(body.status).toBe(409);
+      expect(body.title).toBe("Conflict");
+      expect(body.type).toBe("https://exemplo.com/erros/conflito");
+      expect(body.detail).toBe("conflito");
+      expect(body.instance).toBe("/recursos/1");
+    });
+
+    it("keeps extra body properties when the error is handled (D-05)", async () => {
+      t.app.get("/extra", () => {
+        throw problem({ status: 422, message: "Dados inválidos", body: { campo: "nome" } });
+      });
+      const body = await (await t.fetch("/extra")).json();
+      expect(body.campo).toBe("nome");
+    });
+  });
+
+  describe("content type", () => {
+    it("uses application/problem+json exactly (RF-03)", async () => {
+      t.app.get("/invalido", () => {
+        throw problem({ status: 422, message: "Dados inválidos" });
+      });
+      const res = await t.fetch("/invalido");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+    });
+
+    it("merges headers from problem() and lets them override content-type (D-03)", async () => {
+      t.app.get("/cabecalhos", () => {
+        throw problem({
+          status: 400,
+          message: "x",
+          headers: { "x-request-kind": "problem", "content-type": "application/xml" },
+        });
+      });
+      const res = await t.fetch("/cabecalhos");
+      expect(res.headers.get("x-request-kind")).toBe("problem");
+      expect(res.headers.get("content-type")).toBe("application/xml");
+    });
+
+    it("passes problem() errors to onError (integration)", async () => {
+      t.app.get("/hook", () => {
+        throw problem({ status: 404, message: "não achado" });
+      });
+      const res = await t.fetch("/hook");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(t.hooks.onError).toHaveBeenCalledTimes(1);
+      const [error] = t.hooks.onError.mock.calls[0]!;
+      expect(HTTPError.isError(error)).toBe(true);
+      expect((error as HTTPError).status).toBe(404);
+    });
+  });
+
+  describe("regression: errors created without problem()", () => {
+    it("keeps application/json and the current body keys (RF-05)", async () => {
+      t.app.config.debug = false;
+      t.app.get("/comum", () => {
+        throw new HTTPError({
+          status: 404,
+          statusText: "Not Found",
+          message: "Não encontrado",
+          unhandled: false,
+          data: { id: 1 },
+        });
+      });
+      const res = await t.fetch("/comum");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(Object.keys(body).sort()).toEqual(
+        ["data", "message", "status", "statusText", "unhandled"].sort(),
+      );
+      expect(body).not.toHaveProperty("type");
+      expect(body).not.toHaveProperty("title");
+    });
+
+    it("keeps the stack in debug mode for problem() errors", async () => {
+      const app = new H3({ debug: true });
+      app.get("/debug", () => {
+        throw problem({ status: 400, message: "x" });
+      });
+      const res = await app.request("/debug", { headers: { host: "localhost" } });
+      const body = await res.json();
+      expect(Array.isArray(body.stack)).toBe(true);
+    });
+  });
+});
+
+describeMatrix(
+  "problem details for unhandled errors",
+  (t, { it, expect }) => {
+    it("hides detail, data and body but keeps status (RF-06)", async () => {
+      // Debug mode adds the stack trace, which carries the message by design (inherited from HTTPError)
+      t.app.config.debug = false;
+      t.app.get("/interno", () => {
+        throw problem({
+          status: 500,
+          message: "senha do banco inválida",
+          data: { tabela: "usuarios" },
+          body: { extra: "vazado" },
+          unhandled: true,
+        });
+      });
+      const res = await t.fetch("/interno");
+      const text = await res.text();
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(text).not.toContain("senha do banco inválida");
+      expect(text).not.toContain("usuarios");
+      expect(text).not.toContain("vazado");
+      const body = JSON.parse(text);
+      expect(body.status).toBe(500);
+      expect(body).not.toHaveProperty("data");
+      expect(body).not.toHaveProperty("detail");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
