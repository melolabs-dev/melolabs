new file mode 100644
index 0000000..619ad6b
--- /dev/null
+++ b/src/problem.ts
@@ -0,0 +1,66 @@
+import { HTTPError, type ErrorInput } from "./error.ts";
+
+/**
+ * Input of `problem()`: the `HTTPError` fields plus the RFC 9457 `type` and `instance` members.
+ */
+export interface ProblemInput extends ErrorInput {
+  /**
+   * URI identifying the problem type. Defaults to `"about:blank"` in the response body when omitted.
+   */
+  type?: string;
+
+  /**
+   * URI reference identifying this occurrence of the problem.
+   */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` rendered as RFC 9457 problem details (`application/problem+json`) when thrown or returned.
+ *
+ * @example
+ *
+ * throw problem({ status: 404, message: "User not found", type: "https://example.com/errors/user-not-found" })
+ */
+export function problem(input: ProblemInput): HTTPError {
+  const error: ProblemError = new HTTPError(input);
+  error[kProblem] = {
+    type: input.type,
+    instance: input.instance,
+    detail: input.message || undefined,
+  };
+  return error;
+}
+
+const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+export interface ProblemFields {
+  type?: string;
+  instance?: string;
+  detail?: string;
+}
+
+type ProblemError = HTTPError & { [kProblem]?: ProblemFields };
+
+/**
+ * Return the problem details fields when the error was created by `problem()`, otherwise `undefined`.
+ */
+export function getProblemFields(error: HTTPError): ProblemFields | undefined {
+  return (error as ProblemError)[kProblem];
+}
+
+/**
+ * RFC 9457 JSON body. `undefined` values are dropped on serialization, so missing fields are omitted.
+ */
+export function toProblemJSON(error: HTTPError, fields: ProblemFields): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  return {
+    ...(unhandled ? undefined : error.body),
+    type: fields.type ?? "about:blank",
+    title: error.statusText,
+    status: error.status,
+    detail: unhandled ? undefined : fields.detail,
+    instance: fields.instance,
+    data: unhandled ? undefined : error.data,
+  };
+}
