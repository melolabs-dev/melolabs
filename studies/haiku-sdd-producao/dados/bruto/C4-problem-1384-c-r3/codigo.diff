diff --git a/test/sdd-problem.test.ts b/test/sdd-problem.test.ts
new file mode 100644
index 0000000..c6e2f60
--- /dev/null
+++ b/test/sdd-problem.test.ts
@@ -0,0 +1,258 @@
+import { describe, expect, it, vi } from "vitest";
+import * as h3 from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const { HTTPError, problem } = h3;
+
+// Acceptance tests derived from sdd/prd.md (RF-01 to RF-10) and sdd/techspec.md (D-02, D-09).
+// Internal symbols are checked through their registry key, so this file does not import src/problem.ts.
+const kProblemKey = "h3.problem";
+
+describe("problem() (unit)", () => {
+  // RF-01
+  it("returns an HTTPError with the given status and message", () => {
+    const err = problem({ status: 404, message: "Usuário não encontrado" });
+    expect(err).toBeInstanceOf(HTTPError);
+    expect(HTTPError.isError(err)).toBe(true);
+    expect(err.status).toBe(404);
+    expect(err.message).toBe("Usuário não encontrado");
+  });
+
+  // RF-02: type and instance are kept for the response, not exposed as public fields
+  it("keeps type and instance out of Object.keys and JSON.stringify", () => {
+    const err = problem({
+      status: 409,
+      message: "Saldo insuficiente",
+      type: "https://exemplo.com/erros/saldo-insuficiente",
+      instance: "/contas/42/transacoes/7",
+    });
+    expect(Object.keys(err)).not.toContain("type");
+    expect(Object.keys(err)).not.toContain("instance");
+    const json = JSON.stringify(err);
+    expect(json).not.toContain("saldo-insuficiente");
+    expect(json).not.toContain("/contas/42/transacoes/7");
+  });
+
+  // D-02: the brand is a non-enumerable symbol from the global registry
+  it("stores the problem brand as a non-enumerable symbol property", () => {
+    const err = problem({ status: 500, message: "Falha" });
+    const brand = Object.getOwnPropertySymbols(err).find((s) => s === Symbol.for(kProblemKey));
+    expect(brand).toBeDefined();
+    expect(Object.getOwnPropertyDescriptor(err, brand!)?.enumerable).toBe(false);
+  });
+
+  // D-09: a cause carrying a problem does not transfer the brand
+  it("does not propagate the problem brand through cause", () => {
+    const cause = problem({ status: 404, message: "Nope" });
+    const wrapper = new HTTPError({ cause });
+    expect(Object.getOwnPropertySymbols(wrapper)).not.toContain(Symbol.for(kProblemKey));
+  });
+
+  // RF-08: only `problem` is added to the public exports
+  it("exports problem and no other problem helper", () => {
+    expect(typeof problem).toBe("function");
+    expect(Object.keys(h3)).not.toContain("kProblem");
+    expect(Object.keys(h3)).not.toContain("toProblemJSON");
+  });
+});
+
+describeMatrix("problem details responses", (t, { it, expect, describe }) => {
+  // RF-03: shape, status and media type
+  describe("RF-03 shape and media type", () => {
+    it("responds as application/problem+json when thrown", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 403, statusText: "Forbidden", message: "Token expirado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(await res.json()).toMatchObject({
+        status: 403,
+        title: "Forbidden",
+        detail: "Token expirado",
+        type: "about:blank",
+      });
+    });
+
+    it("responds as application/problem+json when returned", async () => {
+      t.app.get("/", () => {
+        return problem({ status: 403, statusText: "Forbidden", message: "Token expirado" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(403);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(await res.json()).toMatchObject({
+        status: 403,
+        title: "Forbidden",
+        detail: "Token expirado",
+        type: "about:blank",
+      });
+    });
+  });
+
+  // RF-04: default type and default title from the status registry
+  describe("RF-04 defaults", () => {
+    it("uses about:blank and the default reason phrase when type and statusText are missing", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 500, message: "Falha" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        detail: "Falha",
+      });
+      t.errors = [];
+    });
+  });
+
+  // RF-02: type and instance reach the response body
+  describe("RF-02 type and instance", () => {
+    it("writes the given type and instance into the body", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 409,
+          statusText: "Conflict",
+          message: "Saldo insuficiente",
+          type: "https://exemplo.com/erros/saldo-insuficiente",
+          instance: "/contas/42/transacoes/7",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.com/erros/saldo-insuficiente",
+        instance: "/contas/42/transacoes/7",
+      });
+    });
+  });
+
+  // RF-05: extension members at the top level; standard members win on collision
+  describe("RF-05 extension members", () => {
+    it("places body keys at the top level", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 422, message: "Dados inválidos", body: { campo: "email" } });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        campo: "email",
+        status: 422,
+        title: "Unprocessable Content",
+        detail: "Dados inválidos",
+        type: "about:blank",
+      });
+    });
+
+    it("keeps standard members when body uses the same names", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 422,
+          statusText: "Unprocessable",
+          message: "Dados inválidos",
+          body: { status: 999, type: "x", title: "y" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(await res.json()).toMatchObject({
+        status: 422,
+        type: "about:blank",
+        title: "Unprocessable",
+      });
+    });
+
+    it("puts data under the data key and keeps a body data key when data is absent", async () => {
+      t.app.get("/with-data", () => {
+        throw problem({ status: 400, message: "x", data: { a: 1 } });
+      });
+      t.app.get("/body-data", () => {
+        throw problem({ status: 400, message: "x", body: { data: "from-body" } });
+      });
+      expect(await (await t.fetch("/with-data")).json()).toMatchObject({ data: { a: 1 } });
+      expect(await (await t.fetch("/body-data")).json()).toMatchObject({ data: "from-body" });
+    });
+  });
+
+  // RF-06: errors that do not go through problem() keep the current format
+  describe("RF-06 other errors", () => {
+    it("keeps application/json and the toJSON body for HTTPError.status()", async () => {
+      const error = HTTPError.status(404, "Not Found");
+      t.app.get("/", () => {
+        throw error;
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(404);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).toMatchObject(JSON.parse(JSON.stringify(error.toJSON())));
+    });
+  });
+
+  // RF-07: unhandled problem errors hide internal details
+  describe("RF-07 unhandled", () => {
+    it("does not send the internal message when unhandled outside debug mode", async () => {
+      t.app.config.debug = false;
+      const spy = vi.spyOn(console, "error").mockImplementation(() => {});
+      t.app.get("/", () => {
+        throw problem({ status: 500, message: "senha do banco: x", unhandled: true });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+      const body = await res.text();
+      expect(body).not.toContain("senha do banco: x");
+      expect(JSON.parse(body)).toMatchObject({ status: 500, type: "about:blank" });
+      expect(JSON.parse(body)).not.toHaveProperty("detail");
+      spy.mockRestore();
+      t.errors = [];
+    });
+  });
+
+  // RF-09 / user headers: headers from the input keep working as in HTTPError
+  describe("headers", () => {
+    it("keeps custom headers from the input", async () => {
+      t.app.get("/", () => {
+        throw problem({ status: 401, message: "Sem token", headers: { "x-erro": "1" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("x-erro")).toBe("1");
+      expect(res.headers.get("content-type")).toBe("application/problem+json");
+    });
+
+    it("lets a content-type header from the input override the default", async () => {
+      t.app.get("/", () => {
+        throw problem({
+          status: 401,
+          message: "Sem token",
+          headers: { "content-type": "text/plain" },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe("text/plain");
+    });
+  });
+
+  // HEAD requests get the same headers and no body
+  it("answers HEAD with the problem content-type and no body", async () => {
+    t.app.get("/", () => {
+      throw problem({ status: 404, message: "Não existe" });
+    });
+    const res = await t.fetch("/", { method: "HEAD" });
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe("application/problem+json");
+    expect(await res.text()).toBe("");
+  });
+
+  // onError that returns nothing keeps the problem format
+  it("keeps the problem format when onError returns undefined", async () => {
+    t.app.config.onError = () => undefined;
+    t.app.get("/", () => {
+      throw problem({ status: 404, message: "Não existe" });
+    });
+    const res = await t.fetch("/");
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-type")).toBe("application/problem+json");
+    expect(await res.json()).toMatchObject({ status: 404, detail: "Não existe" });
+  });
+});
