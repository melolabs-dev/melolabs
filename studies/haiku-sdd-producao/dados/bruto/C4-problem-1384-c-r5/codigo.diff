+function problemErrorResponse(error: HTTPError, debug?: boolean, errHeaders?: Headers): Response {
+  let headers: Headers = new Headers(error.headers);
+  if (errHeaders) {
+    headers = mergeHeaders(headers, errHeaders);
+  }
