--- /dev/null
+++ b/src/problem.ts
@@ -0,0 +1,72 @@
+import { HTTPError, type ErrorInput } from "./error.ts";
+import { statusTexts } from "./utils/internal/status-text.ts";
+
+/**
+ * Marker for errors created by {@link problem}. `Symbol.for` keeps it matching across duplicate
+ * copies of h3, and a symbol never shows up in `JSON.stringify`.
+ */
+export const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+/**
+ * Input for {@link problem}: the {@link HTTPError} input plus the RFC 9457 `type` and `instance`.
+ */
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /**
+   * URI that identifies the problem type. Defaults to `"about:blank"`.
+   */
+  type?: string;
+
+  /**
+   * URI reference that identifies this specific occurrence of the problem.
+   */
+  instance?: string;
+}
+
+interface ProblemMeta {
+  readonly type: string;
+  readonly instance: string | undefined;
+  readonly detail: string | undefined;
+}
+
+/**
+ * Create an {@link HTTPError} that is rendered as an RFC 9457 problem details response
+ * (`application/problem+json`) when it reaches the response.
+ *
+ * `message` is sent as `detail`. Without a `message`, `detail` is omitted.
+ *
+ * @example
+ *
+ * throw problem({ status: 404, type: "https://example.com/errors/not-found", message: "Item not found", instance: "/items/7" })
+ */
+export function problem<DataT = unknown>(
+  input: ProblemInput<DataT>,
+): HTTPError<DataT> & { readonly type: string; readonly instance: string | undefined } {
+  const { type = "about:blank", instance, ...errorInput } = input;
+  const error = new HTTPError<DataT>(errorInput);
+  const meta: ProblemMeta = { type, instance, detail: input.message || undefined };
+  return Object.assign(error, { type, instance, [kProblem]: meta });
+}
+
+/**
+ * RFC 9457 members of a problem error, in serialization order.
+ *
+ * Extension members (`data` and `body`) come first, so the RFC members win on a name clash.
+ * Unhandled errors keep only `type`, `title` and `status`, and never expose `stack`.
+ */
+export function problemMembers(error: HTTPError, debug?: boolean): Record<string, unknown> {
+  const { type, instance, detail } = (error as HTTPError & { [kProblem]: ProblemMeta })[kProblem];
+  const title = error.statusText || statusTexts[error.status] || "Unknown Error";
+  if (error.unhandled) {
+    return { type, title, status: error.status };
+  }
+  return {
+    data: error.data,
+    ...error.body,
+    type,
+    title,
+    status: error.status,
+    detail,
+    instance,
+    stack: debug && error.stack ? error.stack.split("\n").map((l) => l.trim()) : undefined,
+  };
+}
