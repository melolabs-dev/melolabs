diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..b0c6266
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,101 @@
+import type { HTTPError } from "../../error.ts";
+
+/**
+ * Internal brand of errors created by `problem()`, checked by the error responder.
+ *
+ * A registry symbol keeps the brand out of `JSON.stringify` and matches across duplicate module
+ * instances, like `kHTTPResponse` in `src/response.ts`.
+ */
+export const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+/** Payload stored under {@link kProblem}. */
+export interface ProblemBrand {
+  detail?: string;
+}
+
+/** Problem fields that `problem()` writes on the error instance. */
+type ProblemFields = { type?: string; instance?: string; [kProblem]?: ProblemBrand };
+
+/** Default titles from RFC 9110 for common status codes. Other codes get no title. */
+const PROBLEM_TITLES: Record<number, string> = {
+  200: "OK",
+  201: "Created",
+  202: "Accepted",
+  204: "No Content",
+  301: "Moved Permanently",
+  302: "Found",
+  303: "See Other",
+  304: "Not Modified",
+  307: "Temporary Redirect",
+  308: "Permanent Redirect",
+  400: "Bad Request",
+  401: "Unauthorized",
+  402: "Payment Required",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  407: "Proxy Authentication Required",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  411: "Length Required",
+  412: "Precondition Failed",
+  413: "Content Too Large",
+  414: "URI Too Long",
+  415: "Unsupported Media Type",
+  416: "Range Not Satisfiable",
+  417: "Expectation Failed",
+  421: "Misdirected Request",
+  422: "Unprocessable Content",
+  423: "Locked",
+  424: "Failed Dependency",
+  425: "Too Early",
+  426: "Upgrade Required",
+  428: "Precondition Required",
+  429: "Too Many Requests",
+  431: "Request Header Fields Too Large",
+  451: "Unavailable For Legal Reasons",
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+  505: "HTTP Version Not Supported",
+};
+
+/**
+ * Build the RFC 9457 problem details body of an error created by `problem()`.
+ *
+ * `data` and `body` object members are spread first, so the standard members always win on
+ * conflict (RFC 9457 §3.2). Unhandled errors only expose `type`, `title` and `status`.
+ * The `stack` is not included: the error responder adds it in debug mode.
+ */
+export function toProblemJSON(error: HTTPError): Record<string, unknown> {
+  const problem = error as HTTPError & ProblemFields;
+  const title = error.statusText ?? PROBLEM_TITLES[error.status];
+  const type = problem.type ?? "about:blank";
+  if (error.unhandled) {
+    return { type, title, status: error.status };
+  }
+  return {
+    ...toExtensionMembers(error.data),
+    ...error.body,
+    type,
+    title,
+    status: error.status,
+    detail: problem[kProblem]?.detail,
+    instance: problem.instance,
+  };
+}
+
+/** Plain object data is spread to the top level; any other value stays under `data`. */
+function toExtensionMembers(data: unknown): Record<string, unknown> {
+  if (data === null || typeof data !== "object" || Array.isArray(data)) {
+    return { data };
+  }
+  const proto = Object.getPrototypeOf(data);
+  return proto === Object.prototype || proto === null
+    ? (data as Record<string, unknown>)
+    : { data };
+}
