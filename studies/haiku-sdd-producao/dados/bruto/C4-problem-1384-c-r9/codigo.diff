+// https://www.iana.org/assignments/http-status-codes/http-status-codes.xhtml
+// Reason phrases for the common codes. Not `node:http` `STATUS_CODES`, which is not a web standard.
+const STATUS_TEXTS: Record<number, string> = {
+  200: "OK",
+  201: "Created",
+  202: "Accepted",
+  204: "No Content",
+  206: "Partial Content",
+
+  301: "Moved Permanently",
+  302: "Found",
+  303: "See Other",
+  304: "Not Modified",
+  307: "Temporary Redirect",
+  308: "Permanent Redirect",
+
+  400: "Bad Request",
+  401: "Unauthorized",
+  402: "Payment Required",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  407: "Proxy Authentication Required",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  411: "Length Required",
+  412: "Precondition Failed",
+  413: "Content Too Large",
+  414: "URI Too Long",
+  415: "Unsupported Media Type",
+  416: "Range Not Satisfiable",
+  417: "Expectation Failed",
+  418: "I'm a Teapot",
+  421: "Misdirected Request",
+  422: "Unprocessable Content",
+  423: "Locked",
+  424: "Failed Dependency",
+  425: "Too Early",
+  426: "Upgrade Required",
+  428: "Precondition Required",
+  429: "Too Many Requests",
+  431: "Request Header Fields Too Large",
+  451: "Unavailable For Legal Reasons",
+
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+  505: "HTTP Version Not Supported",
+  507: "Insufficient Storage",
+  508: "Loop Detected",
+  511: "Network Authentication Required",
+};
+
+/** Default reason phrase of an HTTP status. `undefined` when the code is not in the table. */
+export function getStatusText(status: number): string | undefined {
+  return STATUS_TEXTS[status];
+}
diff --git a/src/utils/problem.ts b/src/utils/problem.ts
new file mode 100644
index 0000000..fd8c347
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,69 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { getStatusText } from "./internal/status-text.ts";
+
+/** Brand for errors created by {@link problem}. `Symbol.for` so it holds across h3 copies. */
+const kProblem: unique symbol = /* @__PURE__ */ Symbol.for("h3.problem");
+
+/**
+ * Original `statusText` of a problem. `HTTPError` sanitizes `statusText` for the HTTP status line
+ * (visible ASCII only), but `title` lives in a JSON body, where the text can be kept as written.
+ */
+const kProblemTitle: unique symbol = /* @__PURE__ */ Symbol("h3.problem.title");
+
+export interface ProblemInput<DataT = unknown> extends ErrorInput<DataT> {
+  /** URI reference of the problem type. Defaults to `about:blank`. */
+  type?: string;
+  /** URI reference of the specific occurrence of the problem. */
+  instance?: string;
+}
+
+/**
+ * Create an `HTTPError` that is serialized as `application/problem+json` (RFC 9457).
+ *
+ * Only errors created here change format. `new HTTPError(...)` and `createError(...)` keep the
+ * default JSON body.
+ *
+ * @example
+ *
+ * throw problem({ status: 404, message: "Usuário não encontrado" });
+ */
+export function problem<DataT = unknown>(
+  input: ProblemInput<DataT>,
+): HTTPError<DataT> & { readonly type: string; readonly instance: string | undefined } {
+  const error = new HTTPError<DataT>(input);
+  return Object.defineProperties(error, {
+    [kProblem]: { value: true },
+    [kProblemTitle]: { value: input.statusText },
+    type: { value: input.type ?? "about:blank" },
+    instance: { value: input.instance },
+  }) as HTTPError<DataT> & { readonly type: string; readonly instance: string | undefined };
+}
+
+/** Whether the error was created by {@link problem}. */
+export function isProblemError(input: unknown): boolean {
+  return HTTPError.isError(input) && (input as any)[kProblem] === true;
+}
+
+/**
+ * RFC 9457 body of an error created by {@link problem}.
+ *
+ * Extension members (`data`, `body`) come first, so a `body` key cannot overwrite a standard member.
+ * Unhandled errors hide `detail`, `data` and `body`, like `HTTPError.toJSON` hides `message`.
+ */
+export function toProblemJSON(error: HTTPError): Record<string, unknown> {
+  const problemError = error as HTTPError & {
+    readonly type: string;
+    readonly instance?: string;
+    readonly [kProblemTitle]?: string;
+  };
+  const unhandled = error.unhandled;
+  return {
+    ...(unhandled ? undefined : error.body),
+    data: unhandled ? undefined : error.data,
+    type: problemError.type,
+    title: problemError[kProblemTitle] ?? error.statusText ?? getStatusText(error.status),
+    status: error.status,
+    detail: unhandled ? undefined : error.message,
+    instance: problemError.instance,
+  };
+}
diff --git a/test/sdd-problem.test.ts b/test/sdd-problem.test.ts
new file mode 100644
index 0000000..87f7a23
--- /dev/null
+++ b/test/sdd-problem.test.ts
@@ -0,0 +1,217 @@
+import * as h3 from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const { HTTPError } = h3;
+
+// Acceptance tests derived from sdd/prd.md (RF-01 to RF-07) and sdd/techspec.md.
+// `h3` is imported as a namespace so each test fails on its own until `problem` is exported.
+
+const PROBLEM_CONTENT_TYPE = "application/problem+json";
+
+describeMatrix("problem details (RFC 9457)", (t, { it, expect, describe }) => {
+  describe("RF-01: problem() export", () => {
+    it("returns an HTTPError with the given status and message", () => {
+      const err = h3.problem({ status: 404, message: "Usuário não encontrado" });
+      expect(err).toBeInstanceOf(HTTPError);
+      expect(err.status).toBe(404);
+      expect(err.message).toBe("Usuário não encontrado");
+    });
+  });
+
+  describe("RF-02: type and instance", () => {
+    it("keeps type and instance on the error", () => {
+      const err = h3.problem({
+        status: 402,
+        message: "Saldo insuficiente",
+        type: "https://exemplo.com/erros/saldo",
+        instance: "/contas/42",
+      });
+      expect(err.type).toBe("https://exemplo.com/erros/saldo");
+      expect(err.instance).toBe("/contas/42");
+    });
+
+    it("defaults type to about:blank and leaves instance undefined", () => {
+      const err = h3.problem({ status: 400, message: "x" });
+      expect(err.type).toBe("about:blank");
+      expect(err.instance).toBeUndefined();
+    });
+  });
+
+  describe("RF-03: application/problem+json response", () => {
+    it("renders type, title, status, detail and instance", async () => {
+      t.app.use(() => {
+        throw h3.problem({
+          status: 422,
+          statusText: "Entidade inválida",
+          message: "Campo 'email' ausente",
+          type: "https://exemplo.com/erros/validacao",
+          instance: "/cadastros/7",
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      // `stack` is an extension member added in debug mode (the test harness runs in debug).
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.com/erros/validacao",
+        title: "Entidade inválida",
+        status: 422,
+        detail: "Campo 'email' ausente",
+        instance: "/cadastros/7",
+      });
+    });
+
+    it("renders the problem format when the handler returns the error", async () => {
+      t.app.use(() => h3.problem({ status: 422, message: "returned" }));
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.json()).toMatchObject({ status: 422, detail: "returned" });
+    });
+
+    it("sends no body for HEAD but keeps the problem content type", async () => {
+      t.app.use(() => {
+        throw h3.problem({ status: 422, message: "x" });
+      });
+      const res = await t.fetch("/", { method: "HEAD" });
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.text()).toBe("");
+    });
+
+    it("keeps the problem format when onError returns the same error", async () => {
+      t.app.config.onError = (error) => error;
+      t.app.use(() => {
+        throw h3.problem({ status: 422, message: "via onError" });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(await res.json()).toMatchObject({ status: 422, detail: "via onError" });
+    });
+
+    it("merges event.res.errHeaders and the error headers", async () => {
+      t.app.use((event) => {
+        event.res.errHeaders.set("x-error", "prepared");
+        throw h3.problem({ status: 422, message: "x", headers: { "x-error-own": "own" } });
+      });
+      const res = await t.fetch("/");
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      expect(res.headers.get("x-error")).toBe("prepared");
+      expect(res.headers.get("x-error-own")).toBe("own");
+    });
+  });
+
+  describe("RF-04: defaults", () => {
+    it("uses about:blank and the default status text as title", async () => {
+      t.app.use(() => {
+        throw h3.problem({ status: 500, message: "Falha interna" });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Internal Server Error",
+        status: 500,
+        detail: "Falha interna",
+      });
+    });
+
+    it("omits title when the status has no known text", async () => {
+      t.app.use(() => {
+        throw h3.problem({ status: 499, message: "custom" });
+      });
+      const res = await t.fetch("/");
+      const body = await res.json();
+      expect(body.type).toBe("about:blank");
+      expect(body).not.toHaveProperty("title");
+    });
+  });
+
+  describe("RF-05: common errors keep their format", () => {
+    it("new HTTPError keeps application/json and has no problem members", async () => {
+      t.app.use(() => {
+        throw new HTTPError({ status: 400, message: "Requisição inválida" });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(400);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      const body = await res.json();
+      expect(body).toMatchObject({ status: 400, message: "Requisição inválida" });
+      expect(body).not.toHaveProperty("title");
+      expect(body).not.toHaveProperty("detail");
+      expect(body).not.toHaveProperty("type");
+    });
+
+    it("new HTTPError wrapping a problem error loses the problem format", async () => {
+      t.app.use(() => {
+        throw new HTTPError(h3.problem({ status: 422, message: "x" }));
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(422);
+      expect(res.headers.get("content-type")).toBe("application/json;charset=UTF-8");
+      expect(await res.json()).not.toHaveProperty("title");
+    });
+  });
+
+  describe("RF-07: data and body", () => {
+    it("includes data as an extension member", async () => {
+      t.app.use(() => {
+        throw h3.problem({ status: 409, message: "Conflito", data: { campo: "email" } });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "about:blank",
+        title: "Conflict",
+        status: 409,
+        detail: "Conflito",
+        data: { campo: "email" },
+      });
+    });
+
+    it("body members do not overwrite the standard members", async () => {
+      t.app.use(() => {
+        throw h3.problem({
+          status: 409,
+          message: "Conflito",
+          type: "https://exemplo.com/erros/conflito",
+          body: { type: "outro", title: "outro", status: 1, detail: "outro", extra: 1 },
+        });
+      });
+      const res = await t.fetch("/");
+      expect(await res.json()).toMatchObject({
+        type: "https://exemplo.com/erros/conflito",
+        title: "Conflict",
+        status: 409,
+        detail: "Conflito",
+        extra: 1,
+      });
+    });
+  });
+});
+
+describeMatrix(
+  "problem details, unhandled errors",
+  (t, { it, expect }) => {
+    it("hides detail, data and stack for unhandled problem errors", async () => {
+      t.app.config.debug = false;
+      t.app.config.silent = true;
+      t.app.use(() => {
+        throw h3.problem({
+          status: 500,
+          message: "segredo do banco",
+          data: { secret: "dados" },
+          unhandled: true,
+        });
+      });
+      const res = await t.fetch("/");
+      expect(res.status).toBe(500);
+      expect(res.headers.get("content-type")).toBe(PROBLEM_CONTENT_TYPE);
+      const text = await res.text();
+      expect(text).not.toContain("segredo do banco");
+      expect(text).not.toContain("dados");
+      expect(text).not.toContain("stack");
+      expect(JSON.parse(text)).not.toHaveProperty("detail");
+      expect(JSON.parse(text)).not.toHaveProperty("data");
+    });
+  },
+  { allowUnhandledErrors: true },
+);
