+
+interface RangeSpec {
+  /** Start of the range. `undefined` for the suffix form `-n`. */
+  start?: number;
+  /** Last byte (inclusive), or the suffix length when `start` is `undefined`. `undefined` for `a-`. */
+  end?: number;
+}
+
+interface ByteRange {
+  start: number;
+  end: number;
+  size: number;
+}
+
+const RANGE_UNIT_RE = /^\s*bytes\s*=(.*)$/i;
+const RANGE_SPEC_RE = /^(\d*)-(\d*)$/;
+
+/**
+ * Parse a `Range` header for a single byte range (RFC 9110 section 14.1.1).
+ *
+ * Returns `undefined` when the header must be ignored: another unit, malformed
+ * syntax, `last < first`, or more than one range. Empty list elements are
+ * tolerated (section 5.6.1).
+ */
+function parseRange(header: string): RangeSpec | undefined {
+  const unit = RANGE_UNIT_RE.exec(header);
+  if (!unit) {
+    return undefined;
+  }
+  const specs = unit[1]!
+    .split(",")
+    .map((spec) => spec.trim())
+    .filter(Boolean);
+  if (specs.length !== 1) {
+    return undefined;
+  }
+  const match = RANGE_SPEC_RE.exec(specs[0]!);
+  if (!match || (match[1] === "" && match[2] === "")) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "") {
+    return { end: Number(last) };
+  }
+  if (last !== "" && Number(last) < Number(first)) {
+    return undefined;
+  }
+  return { start: Number(first), end: last === "" ? undefined : Number(last) };
+}
+
+/**
+ * Resolve a parsed range against the asset size. Returns `null` when the range
+ * is not satisfiable (416): a start at or past the end, or a zero-length suffix.
+ */
+function resolveRange(spec: RangeSpec, size: number): ByteRange | null {
+  if (spec.start === undefined) {
+    if (!spec.end) {
+      return null;
+    }
+    return { start: Math.max(size - spec.end, 0), end: size - 1, size };
+  }
+  if (spec.start >= size) {
+    return null;
+  }
+  return { start: spec.start, end: Math.min(spec.end ?? size - 1, size - 1), size };
+}
+
+/**
+ * The range this request asks for. `undefined` means serve the whole asset,
+ * `null` means the range cannot be satisfied. A range is only honored when the
+ * size is known and `If-Range`, if present, matches the current validators.
+ */
+function requestedRange(event: H3Event, size: number | undefined): ByteRange | null | undefined {
+  const header = event.req.headers.get("range");
+  if (!header || !size || size <= 0) {
+    return undefined;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (
+    ifRange !== null &&
+    !matchesIfRange(ifRange, event.res.headers.get("etag"), event.res.headers.get("last-modified"))
+  ) {
+    return undefined;
+  }
+  const spec = parseRange(header);
+  return spec && resolveRange(spec, size);
+}
+
+/** `If-Range` matches only a strong ETag or an exact `Last-Modified` date (RFC 9110 section 13.1.5). */
+function matchesIfRange(
+  ifRange: string,
+  etag: string | null,
+  lastModified: string | null,
+): boolean {
+  if (etag && !etag.startsWith("W/") && ifRange === etag) {
+    return true;
+  }
+  return ifRange === lastModified;
+}
+
+function setRangeHeaders(event: H3Event, range: ByteRange): void {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${range.size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+}
+
+/**
+ * Cut `length` bytes starting at `start`. `Blob` is sliced lazily by the
+ * runtime. Other bodies are streamed, which skips `start` bytes without seeking.
+ */
+function sliceContents(contents: BodyInit, start: number, length: number): BodyInit {
+  if (contents instanceof Blob) {
+    return contents.slice(start, start + length);
+  }
+  return sliceStream(new Response(contents).body!, start, length);
+}
+
+/**
+ * Skip `start` bytes of `source` and emit `length` bytes, then cancel the source.
+ *
+ * If the source ends early, the body closes short: `meta.size` is trusted to
+ * match the content, as the `content-length` it sets already assumes.
+ */
+function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  start: number,
+  length: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let toSkip = start;
+  let toEmit = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      // Keep reading inside one `pull`: a pull that enqueues nothing is not
+      // followed by another one, so the pending read would never resolve.
+      let result = await reader.read();
+      while (!result.done && toSkip >= result.value.byteLength) {
+        toSkip -= result.value.byteLength;
+        result = await reader.read();
+      }
+      if (result.done) {
+        controller.close();
+        return;
+      }
+      const chunk = result.value.subarray(toSkip, toSkip + toEmit);
+      toSkip = 0;
+      toEmit -= chunk.byteLength;
+      controller.enqueue(chunk);
+      if (toEmit === 0) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
diff --git a/test/sdd-static-range.test.ts b/test/sdd-static-range.test.ts
