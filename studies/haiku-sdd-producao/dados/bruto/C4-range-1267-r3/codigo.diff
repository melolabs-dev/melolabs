index 0000000..e2ecaa7
--- /dev/null
+++ b/test/sdd-static-range.test.ts
@@ -0,0 +1,296 @@
+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const ASSET = "0123456789".repeat(100);
+const MTIME = 1_700_000_000_000;
+const ETAG = '"abc"';
+
+function baseOptions(): ServeStaticOptions {
+  return {
+    getMeta: () => ({ type: "text/plain", etag: ETAG, mtime: MTIME, size: ASSET.length }),
+    getContents: () => ASSET,
+    headers: { "cache-control": "public, max-age=60" },
+  };
+}
+
+function chunkedStream(text: string, cancel = vi.fn()) {
+  const chunks = (text.match(/.{1,100}/g) || []).map((c) => new TextEncoder().encode(c));
+  return new ReadableStream<Uint8Array>({
+    pull(controller) {
+      const chunk = chunks.shift();
+      if (chunk) {
+        controller.enqueue(chunk);
+      } else {
+        controller.close();
+      }
+    },
+    cancel,
+  });
+}
+
+describeMatrix("sdd serve static range", (t, { it, expect }) => {
+  let overrides: Partial<ServeStaticOptions>;
+
+  beforeEach(() => {
+    overrides = {};
+    t.app.all("/assets/**", (event) => {
+      return serveStatic(event, { ...baseOptions(), ...overrides });
+    });
+  });
+
+  // RF-01
+  it("advertises Accept-Ranges on 200 (GET and HEAD), 206 and 416", async () => {
+    const get200 = await t.fetch("/assets/file.txt");
+    expect(get200.status).toBe(200);
+    expect(get200.headers.get("accept-ranges")).toBe("bytes");
+
+    const head200 = await t.fetch("/assets/file.txt", { method: "HEAD" });
+    expect(head200.status).toBe(200);
+    expect(head200.headers.get("accept-ranges")).toBe("bytes");
+
+    const get206 = await t.fetch("/assets/file.txt", { headers: { range: "bytes=0-9" } });
+    expect(get206.status).toBe(206);
+    expect(get206.headers.get("accept-ranges")).toBe("bytes");
+
+    const get416 = await t.fetch("/assets/file.txt", { headers: { range: "bytes=1000-" } });
+    expect(get416.status).toBe(416);
+    expect(get416.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  // RF-02
+  it("serves a bounded range with 206, Content-Range and Content-Length", async () => {
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=0-499" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-499/1000");
+    expect(res.headers.get("content-length")).toBe("500");
+    expect(await res.text()).toBe(ASSET.slice(0, 500));
+  });
+
+  // RF-02
+  it("serves open-ended and suffix ranges", async () => {
+    const openEnded = await t.fetch("/assets/file.txt", { headers: { range: "bytes=500-" } });
+    expect(openEnded.status).toBe(206);
+    expect(openEnded.headers.get("content-range")).toBe("bytes 500-999/1000");
+    expect(openEnded.headers.get("content-length")).toBe("500");
+    expect(await openEnded.text()).toBe(ASSET.slice(500));
+
+    const suffix = await t.fetch("/assets/file.txt", { headers: { range: "bytes=-100" } });
+    expect(suffix.status).toBe(206);
+    expect(suffix.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(suffix.headers.get("content-length")).toBe("100");
+    expect(await suffix.text()).toBe(ASSET.slice(900));
+  });
+
+  // RF-02
+  it("clamps an end past the last byte", async () => {
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=900-5000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(ASSET.slice(900));
+  });
+
+  // RF-03
+  it("ignores malformed, other-unit and multi-range headers with a full 200", async () => {
+    const ranges = ["bytes=abc", "items=0-10", "bytes=0-10, 20-30", "bytes=5-3", "bytes="];
+    for (const range of ranges) {
+      const res = await t.fetch("/assets/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(await res.text(), range).toBe(ASSET);
+    }
+  });
+
+  // RF-03 (unit is case-insensitive, RFC 9110 14.1)
+  it("accepts the bytes unit regardless of case", async () => {
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "BYTES=0-499" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-499/1000");
+  });
+
+  // RF-04
+  it("responds 416 for unsatisfiable ranges, with an empty body", async () => {
+    for (const range of ["bytes=1000-1200", "bytes=-0"]) {
+      const res = await t.fetch("/assets/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(416);
+      expect(res.headers.get("content-range"), range).toBe("bytes */1000");
+      expect(res.headers.get("content-length"), range).toBe("0");
+      expect(await res.text(), range).toBe("");
+    }
+  });
+
+  // RF-04 / D-06
+  it("does not send cache-control on 416 even when configured in headers", async () => {
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=1000-1200" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("cache-control")).toBeNull();
+  });
+
+  // RF-05
+  it("answers HEAD with 206 headers and no body", async () => {
+    const res = await t.fetch("/assets/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=0-499" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-499/1000");
+    expect(res.headers.get("content-length")).toBe("500");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-05
+  it("answers HEAD with 416 for an unsatisfiable range", async () => {
+    const res = await t.fetch("/assets/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=1000-" },
+    });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-06
+  it("honors If-Range only when it matches the strong ETag", async () => {
+    const same = await t.fetch("/assets/file.txt", {
+      headers: { range: "bytes=0-499", "if-range": '"abc"' },
+    });
+    expect(same.status).toBe(206);
+
+    const different = await t.fetch("/assets/file.txt", {
+      headers: { range: "bytes=0-499", "if-range": '"xyz"' },
+    });
+    expect(different.status).toBe(200);
+    expect(await different.text()).toBe(ASSET);
+
+    const weak = await t.fetch("/assets/file.txt", {
+      headers: { range: "bytes=0-499", "if-range": 'W/"abc"' },
+    });
+    expect(weak.status).toBe(200);
+    expect(await weak.text()).toBe(ASSET);
+  });
+
+  // RF-06
+  it("honors If-Range when the date equals Last-Modified", async () => {
+    const lastModified = new Date(MTIME).toUTCString();
+    const same = await t.fetch("/assets/file.txt", {
+      headers: { range: "bytes=0-499", "if-range": lastModified },
+    });
+    expect(same.status).toBe(206);
+
+    const other = new Date(MTIME - 60_000).toUTCString();
+    const different = await t.fetch("/assets/file.txt", {
+      headers: { range: "bytes=0-499", "if-range": other },
+    });
+    expect(different.status).toBe(200);
+    expect(await different.text()).toBe(ASSET);
+  });
+
+  // RF-07
+  it("keeps 304 ahead of Range processing", async () => {
+    const res = await t.fetch("/assets/file.txt", {
+      headers: { range: "bytes=0-499", "if-none-match": '"abc"' },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  // RF-08
+  it("ignores Range when getMeta does not return a size", async () => {
+    overrides.getMeta = () => ({ type: "text/plain", etag: ETAG, mtime: MTIME });
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=0-499" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(ASSET);
+  });
+
+  // RF-08
+  it("ignores Range when getMeta reports a zero size", async () => {
+    overrides.getMeta = () => ({ type: "text/plain", etag: ETAG, mtime: MTIME, size: 0 });
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=0-499" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(ASSET);
+  });
+
+  // RF-09
+  it("returns undefined for POST with fallthrough, ignoring Range", async () => {
+    t.app.all("/fall/**", async (event) => {
+      const result = await serveStatic(event, { ...baseOptions(), fallthrough: true });
+      return { returned: result === undefined ? "undefined" : "response" };
+    });
+    const res = await t.fetch("/fall/file.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-10" },
+    });
+    expect(await res.json()).toEqual({ returned: "undefined" });
+  });
+
+  // RF-09
+  it("keeps 405 for POST without fallthrough", async () => {
+    const res = await t.fetch("/assets/file.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-10" },
+    });
+    expect(res.status).toBe(405);
+  });
+
+  // D-07
+  it("overrides a user content-length on 206 with the range length", async () => {
+    overrides.headers = { "content-length": "999" };
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=0-499" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("500");
+    expect(await res.text()).toBe(ASSET.slice(0, 500));
+  });
+
+  // D-03
+  it("slices string, Uint8Array, Blob and ReadableStream contents the same way", async () => {
+    const sources: [string, () => BodyInit][] = [
+      ["string", () => ASSET],
+      ["Uint8Array", () => new TextEncoder().encode(ASSET)],
+      ["Blob", () => new Blob([ASSET])],
+      ["ReadableStream", () => chunkedStream(ASSET)],
+    ];
+    for (const [name, makeContents] of sources) {
+      overrides.getContents = makeContents;
+      for (const [start, end] of [
+        [0, 499],
+        [990, 999],
+      ]) {
+        const res = await t.fetch("/assets/file.txt", {
+          headers: { range: `bytes=${start}-${end}` },
+        });
+        expect(res.status, name).toBe(206);
+        expect(await res.text(), name).toBe(ASSET.slice(start, end + 1));
+      }
+    }
+  });
+
+  // D-03
+  it("cancels the upstream stream once the range is fully emitted", async () => {
+    const cancel = vi.fn();
+    overrides.getContents = () => chunkedStream(ASSET, cancel);
+    const res = await t.fetch("/assets/file.txt", { headers: { range: "bytes=0-499" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(ASSET.slice(0, 500));
+    expect(cancel).toHaveBeenCalled();
+  });
+
+  // Pre-compressed variants (PRD premissas)
+  it("applies the range to the bytes and size of the selected encoded variant", async () => {
+    const gz = "gz".repeat(200);
+    overrides.encodings = { gzip: ".gz" };
+    overrides.getMeta = (id) =>
+      id.endsWith(".gz") ? { type: "text/javascript", size: gz.length } : undefined;
+    overrides.getContents = (id) => (id.endsWith(".gz") ? gz : undefined);
+
+    const res = await t.fetch("/assets/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/400");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(gz.slice(0, 100));
+  });
+});
