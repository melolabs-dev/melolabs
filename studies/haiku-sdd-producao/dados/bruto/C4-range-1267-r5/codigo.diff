+
+/** Inclusive byte range, already limited to the asset size. */
+type ByteRange = { start: number; end: number };
+
+/**
+ * Decide the range to serve for this request (RFC 9110 sections 13.1.5 and 14).
+ *
+ * - `ByteRange`: respond `206`.
+ * - `"unsatisfiable"`: respond `416`.
+ * - `undefined`: ignore `Range` and respond with the full `200`.
+ */
+function resolveRange(
+  event: H3Event,
+  meta: StaticAssetMeta,
+  context: { id: string; assetId: string; mtimeDate?: Date },
+): ByteRange | "unsatisfiable" | undefined {
+  const header = event.req.headers.get("range");
+  if (!header || meta.size === undefined || !(meta.size > 0)) {
+    return undefined;
+  }
+  // A precompressed variant (`.gz`, `.br`, or one flagged with `encoding`) is
+  // compressed bytes: a range over it would not match the representation.
+  if (context.id !== context.assetId || meta.encoding) {
+    return undefined;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, { etag: meta.etag, mtime: context.mtimeDate })) {
+    return undefined;
+  }
+  return parseRange(header, meta.size);
+}
+
+/**
+ * Interpret a single `bytes` range-spec for an asset of `size` bytes.
+ *
+ * Only `a-b`, `a-` and `-n` are accepted. Anything else (other units, several
+ * ranges, malformed syntax, `start > end`) returns `undefined`, so the caller
+ * ignores `Range`.
+ */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const eq = header.indexOf("=");
+  if (eq === -1 || header.slice(0, eq).toLowerCase() !== "bytes") {
+    return undefined;
+  }
+  const specs = header
+    .slice(eq + 1)
+    .split(",")
+    .map((spec) => spec.trim())
+    .filter(Boolean);
+  if (specs.length !== 1) {
+    return undefined;
+  }
+  const match = /^(\d*)-(\d*)$/.exec(specs[0]!);
+  if (!match || (match[1] === "" && match[2] === "")) {
+    return undefined;
+  }
+  const [, rawStart = "", rawEnd = ""] = match;
+
+  if (rawStart === "") {
+    const suffix = Number(rawEnd);
+    if (!Number.isSafeInteger(suffix)) {
+      return undefined;
+    }
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+
+  const start = Number(rawStart);
+  if (!Number.isSafeInteger(start)) {
+    return undefined;
+  }
+  let end = size - 1;
+  if (rawEnd !== "") {
+    end = Number(rawEnd);
+    if (!Number.isSafeInteger(end) || start > end) {
+      return undefined;
+    }
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * Evaluate `If-Range` (RFC 9110 section 13.1.5). Only a strong ETag equal to the
+ * asset's, or an HTTP date equal to its mtime truncated to seconds, matches.
+ */
+function ifRangeMatches(ifRange: string, validators: { etag?: string; mtime?: Date }): boolean {
+  // A weak ETag (`W/"..."`) never starts with a quote, so it cannot match here.
+  if (ifRange.startsWith('"')) {
+    return ifRange === validators.etag;
+  }
+  if (!validators.mtime) {
+    return false;
+  }
+  return new Date(ifRange).getTime() === validators.mtime.getTime();
+}
+
+/**
+ * Slice the body to the range. `Blob` slices lazily; other body types are
+ * normalized to a byte stream that drops `start` bytes and emits the range,
+ * without accumulating the content.
+ */
+function sliceBody(body: BodyInit | null | undefined, range: ByteRange): BodyInit | null {
+  if (body === null || body === undefined) {
+    return null;
+  }
+  if (body instanceof Blob) {
+    return body.slice(range.start, range.end + 1);
+  }
+  const reader = new Response(body).body!.getReader();
+  let skip = range.start;
+  let remaining = range.end - range.start + 1;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        if (skip >= value.byteLength) {
+          skip -= value.byteLength;
+          continue;
+        }
+        const chunk = value.subarray(skip, Math.min(value.byteLength, skip + remaining));
+        skip = 0;
+        remaining -= chunk.byteLength;
+        controller.enqueue(chunk);
+        if (remaining === 0) {
+          controller.close();
+          void reader.cancel();
+        }
+        return;
+      }
+    },
+    cancel() {
+      return reader.cancel();
+    },
+  });
+}
diff --git a/test/sdd-static-range.test.ts b/test/sdd-static-range.test.ts
