+
+/** Inclusive byte range, already clamped to the asset size. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/** `ByteRange` when satisfiable, `"unsatisfiable"` for a 416, `undefined` to ignore the `Range` header. */
+type RangeOutcome = ByteRange | "unsatisfiable" | undefined;
+
+// A single `bytes` range-spec with optional whitespace (RFC 9110 section 14.1.1).
+// Multiple ranges, other units and malformed values do not match and are ignored.
+const RANGE_RE = /^\s*bytes\s*=\s*(\d*)-(\d*)\s*$/i;
+
+/** Apply `If-Range` (RFC 9110 section 13.1.5), then parse `Range` (section 14.2). */
+function evaluateRange(
+  headers: Headers,
+  size: number,
+  validators: { etag?: string; lastModified?: Date },
+): RangeOutcome {
+  const header = headers.get("range");
+  if (!header) {
+    return undefined;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, validators)) {
+    return undefined;
+  }
+  return parseRange(header, size);
+}
+
+/** Interpret a `Range` header for an asset of `size` bytes (`size` > 0). */
+function parseRange(header: string, size: number): RangeOutcome {
+  const match = RANGE_RE.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "") {
+    if (last === "") {
+      return undefined;
+    }
+    // Suffix range: the last `n` bytes, or the whole asset when `n` is larger.
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { start, end };
+}
+
+/**
+ * Compare `If-Range` with the current validators. Only a strong entity-tag or an
+ * exact HTTP date can match; a weak entity-tag never does.
+ */
+function ifRangeMatches(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange.startsWith('"') || ifRange.startsWith('W/"')) {
+    const { etag } = validators;
+    return !!etag && !etag.startsWith("W/") && etag === ifRange;
+  }
+  const { lastModified } = validators;
+  return !!lastModified && Date.parse(ifRange) === lastModified.getTime();
+}
+
+/** Return only the requested part of `contents`. Streams are read up to the range end. */
+async function sliceBody(
+  contents: BodyInit | null | undefined,
+  range: ByteRange,
+): Promise<BodyInit | null> {
+  if (contents === null || contents === undefined) {
+    return null;
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(range.start, range.end + 1);
+  }
+  if (contents instanceof ReadableStream) {
+    return takeBytes(contents, range.start, range.end - range.start + 1);
+  }
+  const bytes = new Uint8Array(await new Response(contents).arrayBuffer());
+  return bytes.subarray(range.start, range.end + 1);
+}
+
+/** Skip `start` bytes of `stream`, then emit `length` bytes and cancel the source. */
+function takeBytes(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  length: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let toSkip = start;
+  let toEmit = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const skipped = Math.min(toSkip, value.byteLength);
+        toSkip -= skipped;
+        const chunk = value.subarray(skipped);
+        if (chunk.byteLength === 0) {
+          continue;
+        }
+        const taken = chunk.subarray(0, Math.min(toEmit, chunk.byteLength));
+        toEmit -= taken.byteLength;
+        controller.enqueue(taken);
+        if (toEmit === 0) {
+          await reader.cancel();
+          controller.close();
+        }
+        return;
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
diff --git a/test/sdd-static-range.test.ts b/test/sdd-static-range.test.ts
