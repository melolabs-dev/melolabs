index 0000000..3a1a66d
--- /dev/null
+++ b/test/sdd-static-range.test.ts
@@ -0,0 +1,309 @@
+import { beforeEach } from "vitest";
+import { serveStatic, type ServeStaticOptions, type StaticAssetMeta } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for HTTP Range support in `serveStatic` (sdd/prd.md, sdd/techspec.md).
+// Fixture from techspec "Estratégia de testes": strong ETag, no encoding, size 1000.
+
+const BODY = "0123456789".repeat(100);
+const LAST_MODIFIED = new Date(1_700_000_000_000).toUTCString();
+const META: StaticAssetMeta = {
+  type: "text/plain",
+  etag: '"abc"',
+  mtime: 1_700_000_000_000,
+  size: 1000,
+};
+
+function options(overrides: Partial<ServeStaticOptions> = {}): ServeStaticOptions {
+  return {
+    getMeta: () => META,
+    getContents: () => BODY,
+    ...overrides,
+  };
+}
+
+describeMatrix("sdd: serveStatic range requests", (t, { it, expect }) => {
+  beforeEach(() => {
+    t.app.all("/**", (event) => serveStatic(event, options()));
+  });
+
+  // RF-01
+  it("advertises byte ranges on a full GET", async () => {
+    const res = await t.fetch("/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("advertises byte ranges on a full HEAD", async () => {
+    const res = await t.fetch("/file.txt", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-02
+  it("serves bytes=a-b as 206", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("serves bytes=a- as 206 up to the end", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=900-" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(BODY.slice(900));
+  });
+
+  it("serves bytes=-n as the last n bytes", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=-100" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(await res.text()).toBe(BODY.slice(-100));
+  });
+
+  it("clamps bytes=-n larger than the asset to the whole asset", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=-5000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-999/1000");
+    expect(res.headers.get("content-length")).toBe("1000");
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("accepts a range unit regardless of case", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "Bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+  });
+
+  // RF-03
+  for (const range of ["bytes=0-10,20-30", "items=0-10", "bytes=abc", "bytes=5-3", "bytes=-"]) {
+    it(`ignores ${range} and serves the full asset`, async () => {
+      const res = await t.fetch("/file.txt", { headers: { range } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await res.text()).toBe(BODY);
+    });
+  }
+
+  // RF-04
+  it("answers 416 when the range is past the end of the asset", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=2000-3000" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  it("answers 416 for a suffix of zero bytes", async () => {
+    const res = await t.fetch("/file.txt", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+  });
+
+  // RF-05
+  it("sends the same headers without a body for HEAD with a range", async () => {
+    const getRes = await t.fetch("/file.txt", { headers: { range: "bytes=0-99" } });
+    const headRes = await t.fetch("/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=0-99" },
+    });
+    expect(headRes.status).toBe(206);
+    expect(headRes.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(headRes.headers.get("content-length")).toBe("100");
+    expect(headRes.headers.get("content-range")).toBe(getRes.headers.get("content-range"));
+    expect(headRes.headers.get("content-length")).toBe(getRes.headers.get("content-length"));
+    expect(await headRes.text()).toBe("");
+  });
+
+  it("answers 416 without a body for HEAD past the end", async () => {
+    const res = await t.fetch("/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=2000-" },
+    });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-06
+  it("ignores the range when If-Range does not match the ETag", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": '"xyz"' },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("honors the range when If-Range matches the strong ETag", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": '"abc"' },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("never matches a weak ETag in If-Range", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": 'W/"abc"' },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("honors the range when If-Range is the exact Last-Modified date", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": LAST_MODIFIED },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("ignores the range when If-Range is a different date", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: {
+        range: "bytes=0-99",
+        "if-range": new Date(1_700_000_000_000 + 1000).toUTCString(),
+      },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("returns 200 instead of 416 when If-Range fails on an unsatisfiable range", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=2000-", "if-range": '"xyz"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(BODY);
+  });
+
+  // RF-07
+  it("ignores the range when the asset has no size", async () => {
+    t.app.all("/nosize/**", (event) =>
+      serveStatic(event, options({ getMeta: () => ({ type: "text/plain", etag: '"abc"' }) })),
+    );
+    const res = await t.fetch("/nosize/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("ignores the range when the asset size is zero", async () => {
+    t.app.all("/zerosize/**", (event) =>
+      serveStatic(event, options({ getMeta: () => ({ ...META, size: 0 }) })),
+    );
+    const res = await t.fetch("/zerosize/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(BODY);
+  });
+
+  // RF-08
+  it("keeps answering 304 before evaluating the range", async () => {
+    const res = await t.fetch("/file.txt", {
+      headers: { range: "bytes=0-99", "if-none-match": '"abc"' },
+    });
+    expect(res.status).toBe(304);
+  });
+
+  it("returns undefined for a missing asset with fallthrough, even with a range", async () => {
+    let result: unknown = "unset";
+    t.app.all("/ft/**", async (event) => {
+      result = await serveStatic(event, options({ getMeta: () => undefined, fallthrough: true }));
+      return "fell through";
+    });
+    const res = await t.fetch("/ft/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(result).toBeUndefined();
+    expect(await res.text()).toBe("fell through");
+  });
+
+  // D-07
+  it("overrides a content-length configured in options.headers on 206", async () => {
+    t.app.all("/headers/**", (event) =>
+      serveStatic(event, options({ headers: { "content-length": "999" } })),
+    );
+    const res = await t.fetch("/headers/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  // D-05
+  it("ignores the range for a precompressed variant", async () => {
+    t.app.all("/pre/**", (event) => serveStatic(event, options({ encodings: { gzip: ".gz" } })));
+    const res = await t.fetch("/pre/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("content-length")).toBe("1000");
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("serves a precompressed variant without a range the same as before", async () => {
+    t.app.all("/pre/**", (event) => serveStatic(event, options({ encodings: { gzip: ".gz" } })));
+    const res = await t.fetch("/pre/app.js", {
+      headers: { "accept-encoding": "gzip" },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("content-length")).toBe("1000");
+    expect(await res.text()).toBe(BODY);
+  });
+
+  // D-06
+  it("slices a ReadableStream body without reading past the range end", async () => {
+    let pulls = 0;
+    const bytes = new TextEncoder().encode(BODY);
+    t.app.all("/stream/**", (event) =>
+      serveStatic(
+        event,
+        options({
+          getContents: () => {
+            let offset = 0;
+            return new ReadableStream<Uint8Array>({
+              pull(controller) {
+                pulls++;
+                if (offset >= bytes.length) {
+                  controller.close();
+                  return;
+                }
+                controller.enqueue(bytes.slice(offset, offset + 7));
+                offset += 7;
+              },
+            });
+          },
+        }),
+      ),
+    );
+    const res = await t.fetch("/stream/file.txt", { headers: { range: "bytes=13-17" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("34567");
+    // The whole body is 143 chunks of 7 bytes; bytes 13-17 need only the first three.
+    expect(pulls).toBeLessThan(10);
+  });
+
+  it("slices a Blob body", async () => {
+    t.app.all("/blob/**", (event) =>
+      serveStatic(
+        event,
+        options({
+          getContents: () => new Blob([BODY], { type: "text/plain" }),
+        }),
+      ),
+    );
+    const res = await t.fetch("/blob/file.txt", { headers: { range: "bytes=13-17" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("5");
+    expect(await res.text()).toBe("34567");
+  });
+});
