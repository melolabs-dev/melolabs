+    const asset = {
+      meta: {
+        type: "application/octet-stream",
+        etag: '"abc"',
+        mtime: lastModified,
+        size: SIZE,
+      },
+      contents: bytes,
+    };
+    files = {
+      "/asset.bin": asset,
+      "/cl/asset.bin": asset,
+      "/weak.bin": {
+        meta: { etag: 'W/"abc"', mtime: lastModified, size: SIZE },
+        contents: bytes,
+      },
+      "/nosize.bin": {
+        meta: { etag: '"abc"', mtime: lastModified },
+        contents: bytes,
+      },
+      "/zero.bin": {
+        meta: { size: 0 },
+        contents: bytes,
+      },
+      "/one.bin": {
+        meta: { size: 1 },
+        contents: Uint8Array.of(7),
+      },
+      "/app.js.gz": {
+        meta: { type: "text/javascript", encoding: "gzip", size: 300 },
+        contents: gzip,
+      },
+    };
+    getContents = vi.fn((id: string) => files[id]?.contents);
+
+    const serve =
+      (options: Partial<ServeStaticOptions> = {}) =>
+      (event: any) =>
+        serveStatic(event, {
+          getMeta: (id) => files[id]?.meta,
+          getContents,
+          encodings: { gzip: ".gz" },
+          ...options,
+        });
+
+    t.app.all("/**", serve());
+    t.app.all("/strict/**", serve({ fallthrough: false }));
+    t.app.all("/fall/**", serve({ fallthrough: true }));
+    t.app.all("/cl/**", serve({ headers: { "content-length": "999" } }));
+    t.app.post("/fall/**", async (event) => {
+      const result = await serveStatic(event, {
+        getMeta: (id) => files[id]?.meta,
+        getContents,
+        fallthrough: true,
+      });
+      return { passedThrough: result === undefined };
+    });
+  });
+
+  // RF-01
+  it("RF-01: advertises Accept-Ranges on a 200 response", async () => {
+    const res = await t.fetch("/asset.bin");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("RF-01: advertises Accept-Ranges on HEAD and 416 responses", async () => {
+    const head = await t.fetch("/asset.bin", { method: "HEAD" });
+    expect(head.headers.get("accept-ranges")).toBe("bytes");
+
+    const unsatisfiable = await t.fetch("/asset.bin", { headers: { range: "bytes=1000-1100" } });
+    expect(unsatisfiable.status).toBe(416);
+    expect(unsatisfiable.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("RF-01 / RF-08: no Accept-Ranges on 304, 404 or 405", async () => {
