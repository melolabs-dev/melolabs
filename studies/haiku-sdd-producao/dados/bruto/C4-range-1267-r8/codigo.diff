+type RangeResult = { status: 200 } | { status: 206; start: number; end: number } | { status: 416 };
+
+/**
+ * Decide how to answer the `Range` header. Anything unusable (no size, a
+ * non-matching `If-Range`, a malformed or multi-part range) is ignored and the
+ * full asset is served, which RFC 9110 section 14.2 allows.
+ */
+function resolveRange(
+  headers: Headers,
+  size: number | undefined,
+  validators: { etag?: string; lastModified?: Date },
+): RangeResult {
+  const range = headers.get("range");
+  if (!range || size === undefined || size <= 0) {
+    return { status: 200 };
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(ifRange, validators)) {
+    return { status: 200 };
+  }
+  const parsed = parseRange(range, size);
+  if (parsed === undefined) {
+    return { status: 200 };
+  }
+  if (parsed === "unsatisfiable") {
+    return { status: 416 };
+  }
+  return { status: 206, start: parsed.start, end: parsed.end };
+}
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/;
+
+/**
+ * Parse a single `bytes` range into inclusive offsets. Only one side of the
+ * `-` may be empty; `bytes=-N` is a suffix of the last N bytes.
+ */
+function parseRange(
+  value: string,
+  size: number,
+): { start: number; end: number } | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(value.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  if (first === "") {
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last === "" ? size - 1 : Number(last);
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * An `If-Range` holding an entity tag must match the current strong ETag
+ * exactly. Anything else is an HTTP date that must equal `Last-Modified`
+ * (RFC 9110 section 13.1.5). A weak ETag never matches.
+ */
+function matchesIfRange(
+  value: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const { etag } = validators;
+    return !!etag && !etag.startsWith("W/") && etag === value;
+  }
+  const { lastModified } = validators;
+  return !!lastModified && new Date(value).getTime() === lastModified.getTime();
+}
+
+/**
+ * Cut `[start, end]` (inclusive, in bytes) out of a body. Byte offsets are
+ * honored without loading whole files where the body type allows it: `Blob`
+ * slices lazily, and typed arrays are views. Other body types are read only up
+ * to `end`, then cancelled.
+ */
+function sliceBody(
+  contents: BodyInit | null | undefined,
+  start: number,
+  end: number,
+): BodyInit | null {
+  if (contents === null || contents === undefined) {
+    return null;
+  }
+  if (typeof contents === "string") {
+    return new TextEncoder().encode(contents).subarray(start, end + 1);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset + start, end - start + 1);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return new Uint8Array(contents, start, end - start + 1);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  let skip = start;
+  let remaining = end - start + 1;
+  const reader = new Response(contents).body!.getReader();
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const dropped = Math.min(skip, value.byteLength);
+        skip -= dropped;
+        const part = value.subarray(dropped, dropped + remaining);
+        remaining -= part.byteLength;
+        if (part.byteLength > 0) {
+          controller.enqueue(part);
+        }
+        if (remaining === 0) {
+          controller.close();
+          await reader.cancel();
+          return;
+        }
+        if (part.byteLength > 0) {
+          return;
+        }
+      }
+    },
+    cancel() {
+      return reader.cancel();
+    },
+  });
+}
