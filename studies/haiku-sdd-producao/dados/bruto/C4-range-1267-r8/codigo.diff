+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("RF-05: a zero-length suffix bytes=-0 returns 416", async () => {
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+  });
+
+  // RF-06
+  const unusableRanges = [
+    ["multiple ranges", "bytes=0-1,5-9"],
+    ["another unit", "items=0-9"],
+    ["reversed bounds", "bytes=5-2"],
+    ["no bounds", "bytes=-"],
+    ["non-numeric", "bytes=abc"],
+  ];
+  for (const [name, range] of unusableRanges) {
+    it(`RF-06: ignores an unusable Range (${name}) and returns the full asset`, async () => {
+      const res = await t.fetch("/asset.bin", { headers: { range } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await readBytes(res)).toEqual(bytes);
+    });
+  }
+
+  // RF-07
+  it("RF-07: If-Range with the matching strong ETag honors the Range", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-9", "if-range": '"abc"' },
+    });
+    expect(res.status).toBe(206);
+    expect(await readBytes(res)).toEqual(bytes.slice(0, 10));
+  });
+
+  it("RF-07: If-Range with a different ETag returns the full asset", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-9", "if-range": '"outra"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await readBytes(res)).toEqual(bytes);
+  });
+
+  it("RF-07: a weak ETag never satisfies If-Range", async () => {
+    const res = await t.fetch("/weak.bin", {
+      headers: { range: "bytes=0-9", "if-range": 'W/"abc"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("RF-07: If-Range with the matching Last-Modified date honors the Range", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-9", "if-range": lastModifiedDate },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/1000");
