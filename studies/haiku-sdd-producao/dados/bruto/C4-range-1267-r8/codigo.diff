+
+describeMatrix("sdd: serveStatic Range body types", (t, { it, expect }) => {
+  const text = "héllo wörld";
+  const textBytes = new TextEncoder().encode(text);
+  const expected = textBytes.slice(2, 6);
+
+  function serveWith(contents: () => BodyInit) {
