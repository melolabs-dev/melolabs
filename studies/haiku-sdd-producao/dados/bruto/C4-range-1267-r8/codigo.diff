+// Acceptance tests for h3js/h3#1267 (HTTP Range in serveStatic), derived from sdd/prd.md (RF-01 to RF-12)
+// and sdd/techspec.md (D-02 to D-08).
+
+const SIZE = 1000;
+const bytes = Uint8Array.from({ length: SIZE }, (_, i) => i % 256);
+const lastModified = 1_700_000_000_000;
+const lastModifiedDate = new Date(lastModified).toUTCString();
+
+const gzip = Uint8Array.from({ length: 300 }, (_, i) => (i * 7) % 256);
