+
+  it("string bodies are sliced by bytes, not characters", async () => {
+    t.app.all(
+      "/**",
+      serveWith(() => text),
+    );
+    const res = await t.fetch("/a.bin", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(await readBytes(res)).toEqual(expected);
+  });
+
+  it("Blob bodies are sliced to the requested range", async () => {
+    t.app.all(
+      "/**",
