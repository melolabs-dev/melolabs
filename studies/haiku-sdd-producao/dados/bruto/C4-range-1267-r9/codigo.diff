+
+/** A single byte range, inclusive at both ends. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/** Outcome of reading a `Range` header against the asset size. */
+type RangeResolution =
+  | { type: "ignore" }
+  | { type: "partial"; range: ByteRange }
+  | { type: "unsatisfiable" };
+
+// A single range only: `bytes=<start>-<end>`, `bytes=<start>-`, or `bytes=-<suffix>`.
+// A trailing comma is tolerated (RFC 9110 section 5.6.1). The unit is case-insensitive.
+const RANGE_RE = /^bytes=(\d*)-(\d*),?$/i;
+
+/**
+ * Resolve a `Range` header against the asset size (RFC 9110 section 14).
+ *
+ * Syntax that is not a single range (multi-range, another unit, malformed, or
+ * `end < start`) is ignored, so the full asset is served instead.
+ */
+function resolveRange(header: string, size: number): RangeResolution {
+  const match = RANGE_RE.exec(header);
+  if (!match) {
+    return { type: "ignore" };
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return { type: "ignore" };
+  }
+  if (first && last && Number(last) < Number(first)) {
+    return { type: "ignore" };
+  }
+  if (size === 0) {
+    return { type: "unsatisfiable" };
+  }
+  if (!first) {
+    const length = Number(last);
+    if (length === 0) {
+      return { type: "unsatisfiable" };
+    }
+    return { type: "partial", range: { start: Math.max(size - length, 0), end: size - 1 } };
+  }
+  const start = Number(first);
+  if (start >= size) {
+    return { type: "unsatisfiable" };
+  }
+  const end = last ? Math.min(Number(last), size - 1) : size - 1;
+  return { type: "partial", range: { start, end } };
+}
+
+/**
+ * Whether `If-Range` matches the current asset (RFC 9110 section 13.1.5).
+ *
+ * Only a strong ETag or an exact `Last-Modified` date can match. Weak ETags never match.
+ */
+function matchesIfRange(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange.startsWith('"')) {
+    return ifRange === validators.etag;
+  }
+  if (ifRange.startsWith("W/")) {
+    return false;
+  }
+  return validators.lastModified !== undefined
+    ? Date.parse(ifRange) === validators.lastModified.getTime()
+    : false;
+}
+
+/**
+ * Slice a body to a byte range. Returns `undefined` for body types that cannot be
+ * sliced cheaply and reliably (for example streams), so the caller serves it in full.
+ */
+function sliceBody(body: BodyInit, range: ByteRange): BodyInit | undefined {
+  const end = range.end + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(range.start, end);
+  }
+  if (body instanceof Blob) {
+    return body.slice(range.start, end);
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(range.start, end);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(range.start, end);
+  }
+  return undefined;
+}
+
+function partialResponse(
+  event: H3Event,
+  range: ByteRange,
+  size: number,
+  body?: BodyInit,
+): HTTPResponse {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+  return new HTTPResponse(body ?? null, { status: 206, statusText: "Partial Content" });
+}
diff --git a/test/sdd-static-range.test.ts b/test/sdd-static-range.test.ts
