+/**
+ * Normalizes `password` to a list, in order. Throws if the list is empty or if an
+ * item is shorter than the minimum the seal options allow, so a bad configuration
+ * fails before any cookie is read.
+ */
+function resolvePasswords(config: SessionConfig): string[] {
+  const passwords = Array.isArray(config.password) ? config.password : [config.password];
+  if (passwords.length === 0) {
+    throw new Error("At least one password is required in `password`.");
+  }
+  const { encryption, integrity } = { ...sealDefaults, ...config.seal };
+  const minLength = Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+  for (const password of passwords) {
+    if (password.length < minLength) {
+      throw new Error(`Session password must be at least ${minLength} characters.`);
+    }
+  }
+  return passwords;
+}
+
+/**
+ * Tries to open `sealed` with each password, in order. Only a wrong password
+ * (`Bad hmac value`) moves on to the next one; any other error is thrown at once.
+ * `index` is the position of the password that opened it.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  opts: SealOptions,
+): Promise<{ unsealed: Partial<Session>; index: number }> {
+  let error: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = (await unseal(sealed, password, opts)) as Partial<Session>;
+      return { unsealed, index };
+    } catch (err) {
+      if (!isBadHmac(err)) {
+        throw err;
+      }
+      error = err;
+    }
+  }
+  throw error;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
diff --git a/test/sdd-password-rotation.test.ts b/test/sdd-password-rotation.test.ts
new file mode 100644
index 0000000..52c3f9c
--- /dev/null
+++ b/test/sdd-password-rotation.test.ts
@@ -0,0 +1,246 @@
+import { getSession, useSession } from "../src/index.ts";
+import type { SessionConfig } from "../src/utils/session.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for sdd/prd.md (RF-01 to RF-09) and sdd/techspec.md (D-01 to D-06)
+
+// 51 characters each, like the password used in test/session.test.ts
+const NOVA = "nova".padEnd(51, "x");
+const ANTIGA = "antiga".padEnd(51, "x");
+const TERCEIRA = "terceira".padEnd(51, "x");
+const DESCONHECIDA = "desconhecida".padEnd(51, "x");
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const rotated: SessionConfig = { name: "h3-rot", password: [NOVA, ANTIGA] };
+
+function sealedWith(password: string, data: Record<string, unknown> = {}, opts = sealDefaults) {
+  return seal({ id: "old", createdAt: Date.now(), data }, password, opts);
+}
+
+function cookieHeader(sealed: string) {
+  return { Cookie: `h3-rot=${encodeURIComponent(sealed)}` };
+}
+
+function cookieValue(setCookie: string): string {
+  return decodeURIComponent(setCookie.match(/h3-rot=([^;]+)/)![1]);
+}
+
+describeMatrix("sdd password rotation", (t, { it, expect }) => {
+  function readSession(path: string, config: SessionConfig) {
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, config);
+      return { id: session.id, data: session.data };
+    });
+  }
+
+  function useSessionRoute(path: string, config: SessionConfig) {
+    t.app.get(path, async (event) => {
+      const session = await useSession(event, config);
+      return { id: session.id };
+    });
+  }
+
+  // RF-01
+  it("accepts a list of passwords", async () => {
+    useSessionRoute("/use", rotated);
+    const res = await t.fetch("/use");
+    expect(res.status).toBe(200);
+    expect(res.headers.getSetCookie()).toHaveLength(1);
+  });
+
+  // RF-02
+  it("seals with the first password only", async () => {
+    useSessionRoute("/use", rotated);
+    const res = await t.fetch("/use");
+    const sealed = cookieValue(res.headers.getSetCookie()[0]);
+    expect(await unseal(sealed, NOVA, sealDefaults)).toMatchObject({ data: {} });
+    await expect(unseal(sealed, ANTIGA, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-03, RF-06
+  it("reads a session sealed with an older password and reseals it with the first", async () => {
+    readSession("/read", rotated);
+    const res = await t.fetch("/read", {
+      headers: cookieHeader(await sealedWith(ANTIGA, { user: "alice" })),
+    });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = cookieValue(setCookies[0]);
+    expect(await unseal(resealed, NOVA, sealDefaults)).toMatchObject({
+      id: "old",
+      data: { user: "alice" },
+    });
+    await expect(unseal(resealed, ANTIGA, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-06, negative case
+  it("does not reseal a session already sealed with the first password", async () => {
+    readSession("/read", rotated);
+    const res = await t.fetch("/read", { headers: cookieHeader(await sealedWith(NOVA)) });
+    expect(await res.json()).toMatchObject({ id: "old" });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  // RF-04
+  it("keeps single password behavior", async () => {
+    const single: SessionConfig = { name: "h3-rot", password: NOVA };
+    readSession("/single", single);
+
+    const current = await t.fetch("/single", { headers: cookieHeader(await sealedWith(NOVA)) });
+    expect(await current.json()).toMatchObject({ id: "old", data: {} });
+    expect(current.headers.getSetCookie()).toHaveLength(0);
+
+    const other = await t.fetch("/single", { headers: cookieHeader(await sealedWith(ANTIGA)) });
+    expect((await other.json()).id).not.toBe("old");
+  });
+
+  // RF-05
+  it("rejects an empty password list", async () => {
+    const empty: SessionConfig = { name: "h3-rot", password: [] };
+    useSessionRoute("/empty", empty);
+
+    const res = await t.fetch("/empty");
+    expect(res.status).toBe(500);
+    expect(t.errors[0]?.message).toMatch(/at least one password/i);
+    t.errors = [];
+
+    // A valid cookie must not hide the configuration error as a new session
+    const withCookie = await t.fetch("/empty", {
+      headers: cookieHeader(await sealedWith(NOVA)),
+    });
+    expect(withCookie.status).toBe(500);
+    expect(t.errors[0]?.message).toMatch(/at least one password/i);
+    t.errors = [];
+  });
+
+  // D-04
+  it("rejects a password shorter than the minimum, even when it is not the first", async () => {
+    const short: SessionConfig = { name: "h3-rot", password: [NOVA, "curta"] };
+    readSession("/short", short);
+
+    const res = await t.fetch("/short", { headers: cookieHeader(await sealedWith(NOVA)) });
+    expect(res.status).toBe(500);
+    expect(t.errors[0]?.message).toMatch(/at least 32 characters/i);
+    t.errors = [];
+  });
+
+  // RF-07
+  it("reseals a legacy session sealed with an older password", async () => {
+    readSession("/read", rotated);
+    const legacy = await seal(
+      { id: "old", createdAt: Date.now(), data: { user: "alice" } },
+      ANTIGA,
+      legacyOptions,
+    );
+    const res = await t.fetch("/read", { headers: cookieHeader(legacy) });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    expect(await unseal(cookieValue(setCookies[0]), NOVA, sealDefaults)).toMatchObject({
+      id: "old",
+      data: { user: "alice" },
+    });
+  });
+
+  // RF-03 with three passwords
+  it("opens with any password in the list", async () => {
+    const three: SessionConfig = { name: "h3-rot", password: [NOVA, ANTIGA, TERCEIRA] };
+    readSession("/read", three);
+
+    for (const older of [ANTIGA, TERCEIRA]) {
+      const res = await t.fetch("/read", {
+        headers: cookieHeader(await sealedWith(older, { user: "alice" })),
+      });
+      expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+      const setCookies = res.headers.getSetCookie();
+      expect(setCookies).toHaveLength(1);
+      expect(await unseal(cookieValue(setCookies[0]), NOVA, sealDefaults)).toMatchObject({
+        data: { user: "alice" },
+      });
+    }
+  });
+
+  // RF-02 and RF-03: order of the list decides which password seals
+  it("seals with the first password of the list, whatever the list order", async () => {
+    const reversed: SessionConfig = { name: "h3-rot", password: [ANTIGA, NOVA] };
+    readSession("/read", reversed);
+
+    const res = await t.fetch("/read", { headers: cookieHeader(await sealedWith(NOVA)) });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = cookieValue(setCookies[0]);
+    await expect(unseal(resealed, ANTIGA, sealDefaults)).resolves.toMatchObject({ id: "old" });
+    await expect(unseal(resealed, NOVA, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // Unseal failure other than a wrong password is still a new session
+  it("starts a new session when no password in the list opens the cookie", async () => {
+    readSession("/read", rotated);
+    const res = await t.fetch("/read", {
+      headers: cookieHeader(await sealedWith(DESCONHECIDA)),
+    });
+    const body = await res.json();
+    expect(body.id).not.toBe("old");
+    expect(body.data).toEqual({});
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+    expect(t.errors).toHaveLength(0);
+  });
+
+  // RF-07 with legacySealFallback: false
+  it("rejects legacy sessions with legacySealFallback: false", async () => {
+    const strict: SessionConfig = { ...rotated, legacySealFallback: false };
+    readSession("/strict", strict);
+
+    // Positive control: a current seal with an older password still opens
+    const modern = await t.fetch("/strict", {
+      headers: cookieHeader(await sealedWith(ANTIGA, { user: "alice" })),
+    });
+    expect(await modern.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+    const legacy = await t.fetch("/strict", {
+      headers: cookieHeader(
+        await seal(
+          { id: "old", createdAt: Date.now(), data: { user: "alice" } },
+          ANTIGA,
+          legacyOptions,
+        ),
+      ),
+    });
+    const body = await legacy.json();
+    expect(body.id).not.toBe("old");
+    expect(body.data).toEqual({});
+  });
+
+  // D-06
+  it("reads a session from the session header without resealing it", async () => {
+    readSession("/read", rotated);
+    const res = await t.fetch("/read", {
+      headers: { "x-h3-rot-session": await sealedWith(ANTIGA, { user: "alice" }) },
+    });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  // techspec risk 3 and test case 12
+  it("does not leak the internal rotation marker into the session", async () => {
+    t.app.get("/keys", async (event) => {
+      const session = await getSession(event, rotated);
+      return {
+        keys: Object.keys(session).sort(),
+        symbols: Object.getOwnPropertySymbols(session).length,
+      };
+    });
+    const res = await t.fetch("/keys", { headers: cookieHeader(await sealedWith(ANTIGA)) });
+    expect(await res.json()).toEqual({ keys: ["createdAt", "data", "id"], symbols: 0 });
+  });
+});
