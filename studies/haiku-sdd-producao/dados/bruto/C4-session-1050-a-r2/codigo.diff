diff --git a/test/sdd-session-password-list.test.ts b/test/sdd-session-password-list.test.ts
new file mode 100644
index 0000000..cd6ffb1
--- /dev/null
+++ b/test/sdd-session-password-list.test.ts
@@ -0,0 +1,252 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { useSession, getSession, updateSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for sdd/prd.md (RF-01 to RF-09) and sdd/techspec.md §5
+describeMatrix("session password list", (t, { it, expect }) => {
+  const name = "h3-sdd";
+  const PASSWORD_A = "password-a-for-session-list-tests-0001";
+  const PASSWORD_B = "password-b-for-session-list-tests-0002";
+  const PASSWORD_C = "password-c-for-session-list-tests-0003";
+
+  const config = (password: SessionConfig["password"], extra: Partial<SessionConfig> = {}) =>
+    ({
+      name,
+      password,
+      generateId: () => "new-id",
+      ...extra,
+    }) as SessionConfig;
+
+  const sealLegacy = (data: object, password: string) =>
+    seal(data, password, {
+      ...sealDefaults,
+      encryption: { ...sealDefaults.encryption, iterations: 1 },
+      integrity: { ...sealDefaults.integrity, iterations: 1 },
+    });
+
+  const cookieValue = (res: Response) => {
+    const setCookie = res.headers.getSetCookie().find((c) => c.startsWith(`${name}=`))!;
+    return decodeURIComponent(setCookie.split(";")[0].slice(name.length + 1));
+  };
+
+  it("RF-01: accepts a list of passwords in useSession", async () => {
+    t.app.get("/list", async (event) => {
+      const session = await useSession(event, config([PASSWORD_A, PASSWORD_B]));
+      return { id: session.id, data: session.data };
+    });
+
+    const res = await t.fetch("/list");
+    expect(res.status).toBe(200);
+    expect(await res.json()).toMatchObject({ id: "new-id", data: {} });
+  });
+
+  it("RF-02: seals new sessions with the first password only", async () => {
+    t.app.get("/write", async (event) => {
+      const session = await updateSession(event, config([PASSWORD_A, PASSWORD_B]), {
+        user: "alice",
+      });
+      return { id: session.id };
+    });
+
+    const res = await t.fetch("/write");
+    const sealed = cookieValue(res);
+    expect(await unseal(sealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "new-id",
+      data: { user: "alice" },
+    });
+    await expect(unseal(sealed, PASSWORD_B, sealDefaults)).rejects.toThrow();
+  });
+
+  it("RF-03: unseals with a later password and keeps id and createdAt", async () => {
+    const createdAt = Date.now() - 1000;
+    const sealed = await seal(
+      { id: "sealed-b", createdAt, data: { user: "bob" } },
+      PASSWORD_B,
+      sealDefaults,
+    );
+    t.app.get("/read", async (event) => {
+      const session = await getSession(event, config([PASSWORD_A, PASSWORD_B]));
+      return { id: session.id, createdAt: session.createdAt, data: session.data };
+    });
+
+    const res = await t.fetch("/read", { headers: { Cookie: `${name}=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      id: "sealed-b",
+      createdAt,
+      data: { user: "bob" },
+    });
+  });
+
+  it("RF-03: unseals with a later password from the session header", async () => {
+    const sealed = await seal(
+      { id: "header-b", createdAt: Date.now(), data: { user: "bob" } },
+      PASSWORD_B,
+      sealDefaults,
+    );
+    t.app.get("/header", async (event) => {
+      const session = await getSession(event, config([PASSWORD_A, PASSWORD_B]));
+      return { id: session.id, data: session.data };
+    });
+
+    const res = await t.fetch("/header", { headers: { [`x-${name}-session`]: sealed } });
+    expect(await res.json()).toMatchObject({ id: "header-b", data: { user: "bob" } });
+  });
+
+  it("RF-04: starts a new session when no password in the list opens the cookie", async () => {
+    const sealed = await seal(
+      { id: "sealed-c", createdAt: Date.now(), data: { user: "mallory" } },
+      PASSWORD_C,
+      sealDefaults,
+    );
+    t.app.get("/read", async (event) => {
+      const session = await getSession(event, config([PASSWORD_A, PASSWORD_B]));
+      return { id: session.id, data: session.data };
+    });
+
+    const res = await t.fetch("/read", { headers: { Cookie: `${name}=${sealed}` } });
+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(body.id).not.toBe("sealed-c");
+    expect(body.data).toEqual({});
+    expect(t.errors).toHaveLength(0);
+  });
+
+  it("RF-04: a corrupted cookie starts a new session without unhandled errors", async () => {
+    const sealed = await seal(
+      { id: "rot-1", createdAt: Date.now(), data: { user: "carol" } },
+      PASSWORD_A,
+      sealDefaults,
+    );
+    const corrupted = sealed.slice(0, -1) + (sealed.endsWith("A") ? "B" : "A");
+    t.app.get("/corrupt", async (event) => {
+      const session = await getSession(event, config([PASSWORD_A, PASSWORD_B]));
+      return { id: session.id };
+    });
+
+    const res = await t.fetch("/corrupt", { headers: { Cookie: `${name}=${corrupted}` } });
+    expect(res.status).toBe(200);
+    expect((await res.json()).id).not.toBe("rot-1");
+    expect(t.errors).toHaveLength(0);
+  });
+
+  it("RF-06: useSession rejects an empty password list", async () => {
+    t.app.get("/empty-use", async (event) => {
+      await useSession(event, config([]));
+      return "ok";
+    });
+
+    const res = await t.fetch("/empty-use");
+    expect(res.status).toBe(500);
+    expect(t.errors[0].message).toMatch("empty");
+    expect(t.errors[0].unhandled).toBe(true);
+    t.errors = [];
+  });
+
+  it("RF-06: getSession rejects an empty password list", async () => {
+    t.app.get("/empty-get", async (event) => {
+      await getSession(event, config([]));
+      return "ok";
+    });
+
+    const res = await t.fetch("/empty-get");
+    expect(res.status).toBe(500);
+    expect(t.errors[0].message).toMatch("empty");
+    expect(t.errors[0].unhandled).toBe(true);
+    t.errors = [];
+  });
+
+  it("RF-07: expiry does not depend on which password opened the session", async () => {
+    const expired = {
+      id: "old-b",
+      createdAt: Date.now() - 120_000,
+      data: { user: "bob" },
+    };
+    const sealed = await seal(expired, PASSWORD_B, sealDefaults);
+    t.app.get("/expiry", async (event) => {
+      const session = await getSession(event, config([PASSWORD_A, PASSWORD_B], { maxAge: 60 }));
+      return { id: session.id };
+    });
+    t.app.get("/expiry-b", async (event) => {
+      const session = await getSession(event, config(PASSWORD_B, { maxAge: 60 }));
+      return { id: session.id };
+    });
+
+    const listRes = await t.fetch("/expiry", { headers: { Cookie: `${name}=${sealed}` } });
+    expect((await listRes.json()).id).not.toBe("old-b");
+    const singleRes = await t.fetch("/expiry-b", { headers: { Cookie: `${name}=${sealed}` } });
+    expect((await singleRes.json()).id).not.toBe("old-b");
+  });
+
+  it("RF-08: reseals a legacy session opened by a later password with the first one", async () => {
+    const legacy = await sealLegacy(
+      { id: "legacy-b", createdAt: Date.now(), data: { user: "bob" } },
+      PASSWORD_B,
+    );
+    t.app.get("/legacy", async (event) => {
+      const session = await getSession(event, config([PASSWORD_A, PASSWORD_B]));
+      return { id: session.id, data: session.data };
+    });
+
+    const res = await t.fetch("/legacy", { headers: { Cookie: `${name}=${legacy}` } });
+    expect(await res.json()).toMatchObject({ id: "legacy-b", data: { user: "bob" } });
+    const resealed = cookieValue(res);
+    expect(await unseal(resealed, PASSWORD_A, sealDefaults)).toMatchObject({ id: "legacy-b" });
+  });
+
+  it("RF-08: legacy sessions from a later password are rejected with legacySealFallback: false", async () => {
+    const legacy = await sealLegacy(
+      { id: "legacy-b", createdAt: Date.now(), data: { user: "bob" } },
+      PASSWORD_B,
+    );
+    t.app.get("/legacy-strict", async (event) => {
+      const session = await getSession(
+        event,
+        config([PASSWORD_A, PASSWORD_B], { legacySealFallback: false }),
+      );
+      return { id: session.id };
+    });
+
+    const res = await t.fetch("/legacy-strict", { headers: { Cookie: `${name}=${legacy}` } });
+    expect((await res.json()).id).not.toBe("legacy-b");
+  });
+
+  it("RF-09: a session sealed with the old password stays valid and is resealed with the new one", async () => {
+    const sealed = await seal(
+      { id: "rot-1", createdAt: Date.now(), data: { user: "carol" } },
+      PASSWORD_A,
+      sealDefaults,
+    );
+    t.app.post("/rotate", async (event) => {
+      const session = await updateSession(event, config([PASSWORD_B, PASSWORD_A]), {
+        visits: 1,
+      });
+      return { id: session.id, data: session.data };
+    });
+
+    const res = await t.fetch("/rotate", {
+      method: "POST",
+      headers: { Cookie: `${name}=${sealed}` },
+      body: "{}",
+    });
+    expect(await res.json()).toMatchObject({ id: "rot-1", data: { user: "carol", visits: 1 } });
+    const resealed = cookieValue(res);
+    expect(await unseal(resealed, PASSWORD_B, sealDefaults)).toMatchObject({ id: "rot-1" });
+    await expect(unseal(resealed, PASSWORD_A, sealDefaults)).rejects.toThrow();
+  });
+
+  it("RF-09: once the old password is removed, its sessions stop opening", async () => {
+    const sealed = await seal(
+      { id: "rot-2", createdAt: Date.now(), data: { user: "carol" } },
+      PASSWORD_A,
+      sealDefaults,
+    );
+    t.app.get("/only-new", async (event) => {
+      const session = await getSession(event, config(PASSWORD_B));
+      return { id: session.id };
+    });
+
+    const res = await t.fetch("/only-new", { headers: { Cookie: `${name}=${sealed}` } });
+    expect((await res.json()).id).not.toBe("rot-2");
+  });
+});
