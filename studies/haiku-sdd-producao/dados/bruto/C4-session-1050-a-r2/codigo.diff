 import type { SessionConfig } from "../session.ts";
+import type { SealOptions } from "./iron-crypto.ts";
+import { unseal } from "./iron-crypto.ts";
 
 export const kGetSession: unique symbol = /* @__PURE__ */ Symbol.for("h3.internal.session.promise");
 
@@ -16,3 +18,34 @@ export const DEFAULT_SESSION_COOKIE: SessionConfig["cookie"] = {
   httpOnly: true,
   sameSite: "lax",
 };
+
+/**
+ * Normalize `SessionConfig.password` into a non-empty list of passwords.
+ */
+export function toPasswordList(password: string | string[]): string[] {
+  const passwords = typeof password === "string" ? [password] : password;
+  if (passwords.length === 0) {
+    throw new Error("Session password list is empty");
+  }
+  return passwords;
+}
+
+/**
+ * Try `unseal` with each password in order and return the first success. When
+ * every attempt fails, rethrow the error of the last one.
+ */
+export async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  opts: SealOptions,
+): Promise<unknown> {
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return await unseal(sealed, password, opts);
+    } catch (error) {
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
