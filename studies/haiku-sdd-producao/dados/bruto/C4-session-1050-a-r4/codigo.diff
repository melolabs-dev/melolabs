+
+/**
+ * Passwords in the order they are tried. The first one seals. Throws on an empty
+ * list or a password shorter than the seal minimum. The error never includes the
+ * password itself.
+ */
+function sessionPasswords(config: SessionConfig): string[] {
+  const passwords = Array.isArray(config.password) ? config.password : [config.password];
+  if (passwords.length === 0) {
+    throw new Error("Session password list is empty");
+  }
+  const { encryption, integrity } = { ...sealDefaults, ...config.seal };
+  const minLength = Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+  for (const [index, password] of passwords.entries()) {
+    if (password.length < minLength) {
+      throw new Error(
+        `Session password at position ${index + 1} is too short (min ${minLength} characters required)`,
+      );
+    }
+  }
+  return passwords;
+}
+
+/**
+ * Try to open the seal with one password, including the legacy 1-iteration
+ * fallback. Throws `"Bad hmac value"` when this password does not match.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  let unsealed: Partial<Session>;
+  try {
+    unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kResealNeeded] = true;
+    }
+  }
+  return unsealed;
+}
diff --git a/test/sdd-multi-password.test.ts b/test/sdd-multi-password.test.ts
new file mode 100644
index 0000000..845581c
--- /dev/null
+++ b/test/sdd-multi-password.test.ts
@@ -0,0 +1,216 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach, vi } from "vitest";
+import { useSession, getSession, updateSession, H3 } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for h3js/h3#1050: `SessionConfig.password` accepts a list.
+// The first password seals, every password opens, in declared order.
+const PASS_A = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
+const PASS_B = "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB";
+const PASS_C = "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+function cookieValue(setCookie: string): string {
+  return decodeURIComponent(setCookie.match(/sdd-rot=([^;]+)/)![1]!);
+}
+
+describeMatrix("sdd multi-password sessions", (t, { it, expect }) => {
+  let app: H3;
+
+  beforeEach(() => {
+    app = new H3({});
+    t.app.use(app.handler);
+  });
+
+  const config = (password: string | string[]): SessionConfig => ({
+    name: "sdd-rot",
+    password,
+    generateId: () => "new-id",
+  });
+
+  // RF-01: a list is accepted by the type and by useSession
+  it("accepts a password list in useSession", async () => {
+    const cfg: SessionConfig = { name: "sdd-rot", password: [PASS_A, PASS_B] };
+    t.app.get("/", async (event) => {
+      const session = await useSession(event, cfg);
+      return { id: session.id };
+    });
+    const res = await t.fetch("/");
+    expect(await res.json()).toMatchObject({ id: expect.any(String) });
+    expect(res.headers.getSetCookie()).toHaveLength(1);
+  });
+
+  // RF-02: new sessions are sealed with the first password only
+  it("seals with the first password", async () => {
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.post("/", async (event) => {
+      await updateSession(event, cfg, { user: "alice" });
+      return "ok";
+    });
+    const res = await t.fetch("/", { method: "POST" });
+    const sealed = cookieValue(res.headers.getSetCookie()[0]!);
+
+    await expect(unseal(sealed, PASS_A, sealDefaults)).resolves.toMatchObject({
+      data: { user: "alice" },
+    });
+    await expect(unseal(sealed, PASS_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-03: a cookie sealed with an older password still loads
+  it("opens a cookie sealed with an older password", async () => {
+    const sealedB = await seal(
+      { id: "old-id", createdAt: Date.now(), data: { user: "bob" } },
+      PASS_B,
+      sealDefaults,
+    );
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.get("/", async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+    const res = await t.fetch("/", { headers: { Cookie: `sdd-rot=${sealedB}` } });
+    expect(await res.json()).toMatchObject({ id: "old-id", data: { user: "bob" } });
+  });
+
+  // RF-03: the first password keeps working after rotation
+  it("opens a cookie sealed with the first password", async () => {
+    const sealedA = await seal(
+      { id: "current-id", createdAt: Date.now(), data: { user: "carol" } },
+      PASS_A,
+      sealDefaults,
+    );
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.get("/", async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+    const res = await t.fetch("/", { headers: { Cookie: `sdd-rot=${sealedA}` } });
+    expect(await res.json()).toMatchObject({ id: "current-id", data: { user: "carol" } });
+  });
+
+  // RF-04: a cookie no listed password opens is treated as a new session
+  it("treats a cookie sealed with an unknown password as a new session", async () => {
+    const sealedC = await seal(
+      { id: "stale-id", createdAt: Date.now(), data: { user: "mallory" } },
+      PASS_C,
+      sealDefaults,
+    );
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.get("/", async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+    const res = await t.fetch("/", { headers: { Cookie: `sdd-rot=${sealedC}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("stale-id");
+    expect(body.data).toEqual({});
+  });
+
+  // RF-03 + legacy seal: a 1-iteration cookie sealed with an older password
+  it("unseals a legacy cookie sealed with an older password", async () => {
+    const legacySealedB = await seal(
+      { id: "legacy-id", createdAt: Date.now(), data: { user: "dave" } },
+      PASS_B,
+      legacyOptions,
+    );
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.get("/", async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+    const res = await t.fetch("/", { headers: { Cookie: `sdd-rot=${legacySealedB}` } });
+    expect(await res.json()).toMatchObject({ id: "legacy-id", data: { user: "dave" } });
+  });
+
+  // Rotation: reading a cookie sealed with an older password reseals it with the first
+  it("reseals a cookie sealed with an older password on read", async () => {
+    const sealedB = await seal(
+      { id: "old-id", createdAt: Date.now(), data: { user: "erin" } },
+      PASS_B,
+      sealDefaults,
+    );
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.get("/", async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id };
+    });
+    const res = await t.fetch("/", { headers: { Cookie: `sdd-rot=${sealedB}` } });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = cookieValue(setCookies[0]!);
+    await expect(unseal(resealed, PASS_A, sealDefaults)).resolves.toMatchObject({
+      id: "old-id",
+      data: { user: "erin" },
+    });
+    await expect(unseal(resealed, PASS_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-06: empty list is a configuration error, not a silent new session
+  it("throws a clear error for an empty password list", async () => {
+    const cfg = config([]);
+    t.app.get("/", async (event) => {
+      try {
+        await getSession(event, cfg);
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    const res = await t.fetch("/");
+    expect((await res.json()).error).toMatch(/empty/i);
+  });
+
+  it("throws a clear error for an empty password list in useSession", async () => {
+    const cfg = config([]);
+    t.app.get("/", async (event) => {
+      try {
+        await useSession(event, cfg);
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    const res = await t.fetch("/", { headers: { Cookie: "sdd-rot=whatever" } });
+    expect((await res.json()).error).toMatch(/empty/i);
+  });
+
+  // RF-06: a short password in the list is reported by position, without its value
+  it("reports a short password by position without leaking it", async () => {
+    const cfg = config([PASS_A, "curta"]);
+    t.app.get("/", async (event) => {
+      try {
+        await useSession(event, cfg);
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    const res = await t.fetch("/");
+    const error: string = (await res.json()).error;
+    expect(error).toMatch(/position 2/);
+    expect(error).not.toContain("curta");
+    expect(error).not.toContain(PASS_A);
+  });
+
+  // Writes seal once: the list does not add PBKDF2 work to a write
+  it("seals a write with a single derivation pass", async () => {
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    const cfg = config([PASS_A, PASS_B]);
+    t.app.get("/seal-count", async (event) => {
+      await updateSession(event, cfg, { user: "frank" });
+      return "ok";
+    });
+    deriveBits.mockClear();
+    const res = await t.fetch("/seal-count");
+    expect(res.headers.getSetCookie()).toHaveLength(1);
+    // Two derivations (encryption + integrity) for a single seal
+    expect(deriveBits).toHaveBeenCalledTimes(2);
+    deriveBits.mockRestore();
+  });
+});
