+/**
+ * Passwords to try, in order: the first seals, the rest only open. A string is
+ * returned as-is. A list must be non-empty, and every item a string of at least
+ * `minPasswordlength` characters.
+ * @throws {Error} `Invalid session password list` when a list is invalid. The
+ * message never includes a password.
+ */
+export function sessionPasswords(config: SessionConfig): string[] {
+  const { password } = config;
+  if (!Array.isArray(password)) {
+    return [password];
+  }
+  if (password.length === 0) {
+    throw new Error("Invalid session password list: the list is empty");
+  }
+  const minLength =
+    config.seal?.encryption.minPasswordlength ?? defaults.encryption.minPasswordlength;
+  for (const [index, item] of password.entries()) {
+    if (typeof item !== "string" || item.length === 0 || item.length < minLength) {
+      throw new Error(
+        `Invalid session password list: item ${index} must be a string of at least ${minLength} characters`,
+      );
+    }
+  }
+  return password;
+}
