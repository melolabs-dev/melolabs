+/**
+ * Open the sealed session with the first password that verifies it. Any error
+ * other than a bad HMAC does not depend on the password, so it is thrown at once.
+ * If none opens it, the last bad-HMAC error is thrown.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  let lastError: unknown;
+  for (const password of sessionPasswords(config)) {
+    try {
+      return await unsealWithPassword(sealed, password, sealOptions, config);
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  config: SessionConfig,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !isBadHmac(error)
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
diff --git a/test/sdd-session-password-list.test.ts b/test/sdd-session-password-list.test.ts
new file mode 100644
index 0000000..e275384
--- /dev/null
+++ b/test/sdd-session-password-list.test.ts
@@ -0,0 +1,222 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { useSession, getSession, updateSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const COOKIE = "h3-list";
+const PASSWORD_A = "alpha-password-with-more-than-32-chars";
+const PASSWORD_B = "bravo-password-with-more-than-32-chars";
+const PASSWORD_C = "charlie-password-with-more-than-32-chars";
+
+const LEGACY_SEAL = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+function configOf(password: SessionConfig["password"], extra: Partial<SessionConfig> = {}) {
+  return { name: COOKIE, password, generateId: () => "fresh", ...extra } satisfies SessionConfig;
+}
+
+function sealedOf(res: Response): string {
+  const cookie = res.headers.getSetCookie().find((value) => value.startsWith(`${COOKIE}=`))!;
+  return decodeURIComponent(cookie.slice(COOKIE.length + 1).split(";")[0]!);
+}
+
+function cookieOf(res: Response): string {
+  return `${COOKIE}=${encodeURIComponent(sealedOf(res))}`;
+}
+
+async function body(res: Response): Promise<{ id: string; data: Record<string, unknown> }> {
+  return (await res.json()) as { id: string; data: Record<string, unknown> };
+}
+
+describeMatrix("session password list", (t, { it, expect }) => {
+  function mount(path: string, config: SessionConfig) {
+    t.app.all(path, async (event) => {
+      const session = await useSession(event, config);
+      if (event.req.method === "POST") {
+        await session.update({ user: "ana" });
+      }
+      return { id: session.id, data: session.data };
+    });
+  }
+
+  // RF-01
+  it("accepts a password list when creating and reading a session", async () => {
+    mount("/", configOf([PASSWORD_A, PASSWORD_B]));
+
+    const created = await t.fetch("/", { method: "POST" });
+    expect(await body(created)).toEqual({ id: "fresh", data: { user: "ana" } });
+
+    const read = await t.fetch("/", { headers: { Cookie: cookieOf(created) } });
+    expect(await body(read)).toEqual({ id: "fresh", data: { user: "ana" } });
+  });
+
+  // RF-02
+  it("seals with the first password only", async () => {
+    mount("/ab", configOf([PASSWORD_A, PASSWORD_B]));
+    mount("/a", configOf([PASSWORD_A]));
+    mount("/b", configOf([PASSWORD_B]));
+
+    const created = await t.fetch("/ab", { method: "POST" });
+
+    const withA = await t.fetch("/a", { headers: { Cookie: cookieOf(created) } });
+    expect((await body(withA)).data).toEqual({ user: "ana" });
+
+    const withB = await t.fetch("/b", { headers: { Cookie: cookieOf(created) } });
+    expect((await body(withB)).data).toEqual({});
+  });
+
+  // RF-03
+  it("opens a session sealed with any password in the list", async () => {
+    mount("/seed", configOf([PASSWORD_B]));
+    mount("/", configOf([PASSWORD_A, PASSWORD_B]));
+
+    const seeded = await t.fetch("/seed", { method: "POST" });
+    const res = await t.fetch("/", { headers: { Cookie: cookieOf(seeded) } });
+    expect(await body(res)).toEqual({ id: "fresh", data: { user: "ana" } });
+  });
+
+  // RF-03 (write path): after opening with B, a write reseals with A
+  it("reseals with the first password when a session opened by a later one is written", async () => {
+    mount("/seed", configOf([PASSWORD_B]));
+    mount("/", configOf([PASSWORD_A, PASSWORD_B]));
+
+    const seeded = await t.fetch("/seed", { method: "POST" });
+    const written = await t.fetch("/", { method: "POST", headers: { Cookie: cookieOf(seeded) } });
+    expect(await unseal(sealedOf(written), PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "fresh",
+      data: { user: "ana" },
+    });
+  });
+
+  // RF-04
+  it("seals a single password the same way as a list of one", async () => {
+    mount("/string", configOf(PASSWORD_A));
+    mount("/list", configOf([PASSWORD_A]));
+
+    for (const path of ["/string", "/list"]) {
+      const res = await t.fetch(path, { method: "POST" });
+      const sealed = sealedOf(res);
+      // Password id is empty, as before the list support
+      expect(sealed.split("*")[1]).toBe("");
+      expect(await unseal(sealed, PASSWORD_A, sealDefaults)).toMatchObject({
+        data: { user: "ana" },
+      });
+    }
+  });
+
+  // RF-05
+  it("rejects an invalid password list in useSession, getSession and updateSession, even without a cookie", async () => {
+    let config = configOf([PASSWORD_A]);
+    t.app.get("/use", async (event) => {
+      try {
+        await useSession(event, config);
+        return { error: undefined };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/get", async (event) => {
+      try {
+        await getSession(event, config);
+        return { error: undefined };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/update", async (event) => {
+      try {
+        await updateSession(event, config, { user: "ana" });
+        return { error: undefined };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    const invalid = [[], ["", PASSWORD_A], [PASSWORD_A, 1], [PASSWORD_A, "curta"]];
+    for (const password of invalid) {
+      config = configOf(password as SessionConfig["password"]);
+      for (const path of ["/use", "/get", "/update"]) {
+        const res = await t.fetch(path);
+        const { error } = (await res.json()) as { error?: string };
+        expect(error).toContain("Invalid session password list");
+        // The message does not reveal the content of any password
+        expect(error).not.toContain(PASSWORD_A);
+        expect(res.headers.getSetCookie()).toHaveLength(0);
+      }
+    }
+  });
+
+  // RF-06
+  it("reads a cookie sealed with an unknown password as a new session, like a single wrong password", async () => {
+    mount("/seed", configOf(PASSWORD_C, { generateId: () => "seeded" }));
+    mount("/list", configOf([PASSWORD_A, PASSWORD_B]));
+    mount("/single", configOf(PASSWORD_A));
+
+    const seeded = await t.fetch("/seed", { method: "POST" });
+    const cookie = cookieOf(seeded);
+
+    const list = await body(await t.fetch("/list", { headers: { Cookie: cookie } }));
+    const single = await body(await t.fetch("/single", { headers: { Cookie: cookie } }));
+    expect(list).toEqual({ id: "fresh", data: {} });
+    expect(list).toEqual(single);
+  });
+
+  // RF-07
+  it("unseals and reseals a legacy cookie sealed with a later password in the list", async () => {
+    const legacy = await seal(
+      { id: "legacy", createdAt: Date.now(), data: { user: "ana" } },
+      PASSWORD_B,
+      LEGACY_SEAL,
+    );
+    mount("/", configOf([PASSWORD_A, PASSWORD_B]));
+
+    const res = await t.fetch("/", {
+      headers: { Cookie: `${COOKIE}=${encodeURIComponent(legacy)}` },
+    });
+    expect(await body(res)).toEqual({ id: "legacy", data: { user: "ana" } });
+    expect(await unseal(sealedOf(res), PASSWORD_A, sealDefaults)).toMatchObject({ id: "legacy" });
+  });
+
+  // RF-07 with the fallback disabled
+  it("does not open a legacy cookie sealed with a later password when legacySealFallback is false", async () => {
+    const legacy = await seal(
+      { id: "legacy", createdAt: Date.now(), data: { user: "ana" } },
+      PASSWORD_B,
+      LEGACY_SEAL,
+    );
+    mount("/", configOf([PASSWORD_A, PASSWORD_B], { legacySealFallback: false }));
+
+    const res = await t.fetch("/", {
+      headers: { Cookie: `${COOKIE}=${encodeURIComponent(legacy)}` },
+    });
+    expect(await body(res)).toEqual({ id: "fresh", data: {} });
+  });
+
+  // D-06: expiration applies to whichever password opened the session
+  it("does not open an expired session sealed with a later password", async () => {
+    const expired = await seal(
+      { id: "old", createdAt: Date.now() - 10_000, data: { user: "ana" } },
+      PASSWORD_B,
+      sealDefaults,
+    );
+    mount("/", configOf([PASSWORD_A, PASSWORD_B], { maxAge: 5 }));
+
+    const res = await t.fetch("/", {
+      headers: { Cookie: `${COOKIE}=${encodeURIComponent(expired)}` },
+    });
+    expect(await body(res)).toEqual({ id: "fresh", data: {} });
+  });
+
+  // D-01: the list is tried in order, not only its first item
+  it("opens a session sealed with a password listed in second place", async () => {
+    mount("/seed", configOf(PASSWORD_A, { generateId: () => "seeded" }));
+    mount("/", configOf([PASSWORD_B, PASSWORD_A]));
+
+    const seeded = await t.fetch("/seed", { method: "POST" });
+    const res = await t.fetch("/", { headers: { Cookie: cookieOf(seeded) } });
+    expect(await body(res)).toEqual({ id: "seeded", data: { user: "ana" } });
+  });
+});
