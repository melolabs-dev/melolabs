+/**
+ * Try each password in order. Only a wrong-password failure moves on to the
+ * next one; any other error (malformed seal, expired seal) is the same for
+ * every password, so it is thrown at once. If none opens the seal, the last
+ * "Bad hmac value" is rethrown, as with a single password.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  options: SealOptions,
+): Promise<unknown> {
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return await unseal(sealed, password, options);
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
