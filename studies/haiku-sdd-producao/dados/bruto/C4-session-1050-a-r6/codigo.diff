+++ b/test/sdd-multiple-passwords.test.ts
@@ -0,0 +1,318 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { expectTypeOf } from "vitest";
+import {
+  getSession,
+  sealSession,
+  unsealSession,
+  updateSession,
+  useSession,
+  readBody,
+} from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { kLegacySeal } from "../src/utils/internal/session.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for sdd/prd.md (RF-01 to RF-07) and sdd/techspec.md.
+const SENHA_NOVA = "nova-senha-para-testes-de-rotacao-0001";
+const SENHA_ANTIGA = "antiga-senha-para-testes-de-rotacao-02";
+const SENHA_REMOVIDA = "removida-senha-de-teste-rotacao-0003";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const opens = (sealed: string, password: string): Promise<boolean> =>
+  unseal(sealed, password, sealDefaults).then(
+    () => true,
+    () => false,
+  );
+
+const errorOf = async (fn: () => Promise<unknown>): Promise<string | undefined> => {
+  try {
+    await fn();
+    return undefined;
+  } catch (error) {
+    return (error as Error).message;
+  }
+};
+
+const cookieValue = (res: Response, name: string): string => {
+  const match = res.headers.getSetCookie()[0].match(new RegExp(`${name}=([^;]+)`));
+  return decodeURIComponent(match![1]);
+};
+
+describeMatrix("sdd: multiple session passwords", (t, { it, expect }) => {
+  const config: SessionConfig = {
+    name: "h3-sdd",
+    password: [SENHA_NOVA, SENHA_ANTIGA],
+    generateId: () => "sess-1",
+  };
+
+  const registerRead = () => {
+    t.app.get("/read", async (event) => {
+      const session = await getSession(event, config);
+      return { id: session.id, data: session.data };
+    });
+  };
+
+  // RF-01
+  it("reads a cookie sealed only with the old password", async () => {
+    registerRead();
+    const sealed = await seal(
+      { id: "old-1", createdAt: Date.now(), data: { user: "alice" } },
+      SENHA_ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { user: "alice" } });
+  });
+
+  // RF-01
+  it("reads a session header sealed only with the old password", async () => {
+    registerRead();
+    const sealed = await seal(
+      { id: "old-2", createdAt: Date.now(), data: { user: "bob" } },
+      SENHA_ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/read", { headers: { "x-h3-sdd-session": sealed } });
+    expect(await res.json()).toMatchObject({ id: "old-2", data: { user: "bob" } });
+  });
+
+  // RF-02
+  it("seals new sessions with the first password only", async () => {
+    t.app.get("/seal", async (event) => ({ sealed: await sealSession(event, config) }));
+
+    const { sealed } = await (await t.fetch("/seal")).json();
+    expect(await opens(sealed, SENHA_NOVA)).toBe(true);
+    expect(await opens(sealed, SENHA_ANTIGA)).toBe(false);
+  });
+
+  // RF-02
+  it("reseals a session read with the old password using the first password", async () => {
+    t.app.get("/write", async (event) => {
+      await updateSession(event, config, { user: "carol" });
+      return "ok";
+    });
+    const sealed = await seal(
+      { id: "old-3", createdAt: Date.now(), data: { user: "old" } },
+      SENHA_ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/write", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    const resealed = cookieValue(res, "h3-sdd");
+    expect(await opens(resealed, SENHA_NOVA)).toBe(true);
+    expect(await opens(resealed, SENHA_ANTIGA)).toBe(false);
+  });
+
+  // RF-02 (legacy reseal goes through updateSession, see techspec D-04)
+  it("reseals a legacy session with the first password", async () => {
+    registerRead();
+    const legacySealed = await seal(
+      { id: "legacy-1", createdAt: Date.now(), data: { user: "legacy" } },
+      SENHA_ANTIGA,
+      legacyOptions,
+    );
+
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-sdd=${legacySealed}` } });
+    expect(await res.json()).toMatchObject({ id: "legacy-1", data: { user: "legacy" } });
+    const resealed = cookieValue(res, "h3-sdd");
+    expect(await opens(resealed, SENHA_NOVA)).toBe(true);
+    expect(await opens(resealed, SENHA_ANTIGA)).toBe(false);
+  });
+
+  // RF-03
+  it("starts an empty session for a cookie sealed with an unknown password", async () => {
+    registerRead();
+    const sealed = await seal(
+      { id: "gone-1", createdAt: Date.now(), data: { user: "mallory" } },
+      SENHA_REMOVIDA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(body.id).not.toBe("gone-1");
+    expect(body.data).toEqual({});
+  });
+
+  // RF-03: rejection of unknown passwords goes through unsealSession directly
+  it("rejects an unknown password with the same error as a single password", async () => {
+    t.app.post("/unseal", async (event) => {
+      const { sealed } = (await readBody(event)) as { sealed: string };
+      return { message: await errorOf(() => unsealSession(event, config, sealed)) };
+    });
+    const sealed = await seal(
+      { id: "gone-2", createdAt: Date.now(), data: {} },
+      SENHA_REMOVIDA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/unseal", { method: "POST", body: JSON.stringify({ sealed }) });
+    expect(await res.json()).toEqual({ message: "Bad hmac value" });
+  });
+
+  // RF-04
+  it("behaves like a string when the list has a single entry", async () => {
+    t.app.get("/single", async (event) => {
+      const session = await getSession(event, { ...config, password: [SENHA_NOVA] });
+      return { data: session.data };
+    });
+    const ok = await seal(
+      { id: "s", createdAt: Date.now(), data: { a: 1 } },
+      SENHA_NOVA,
+      sealDefaults,
+    );
+    const other = await seal(
+      { id: "s", createdAt: Date.now(), data: { a: 2 } },
+      SENHA_ANTIGA,
+      sealDefaults,
+    );
+
+    expect(
+      await (await t.fetch("/single", { headers: { Cookie: `h3-sdd=${ok}` } })).json(),
+    ).toEqual({
+      data: { a: 1 },
+    });
+    expect(
+      await (await t.fetch("/single", { headers: { Cookie: `h3-sdd=${other}` } })).json(),
+    ).toEqual({
+      data: {},
+    });
+  });
+
+  // RF-05
+  it("throws for an empty password list before reading or sealing", async () => {
+    const bad: SessionConfig = { ...config, password: [] };
+    t.app.get("/empty", async (event) => ({
+      getSession: await errorOf(() => getSession(event, bad)),
+      useSession: await errorOf(() => useSession(event, bad)),
+      sealSession: await errorOf(() => sealSession(event, bad)),
+    }));
+
+    // No cookie on purpose: validation must run before any read
+    const body = await (await t.fetch("/empty")).json();
+    expect(body.getSession).toBeTypeOf("string");
+    expect(body.useSession).toBeTypeOf("string");
+    expect(body.sealSession).toBeTypeOf("string");
+  });
+
+  // RF-05 and D-05
+  it("throws for a short entry in the password list before reading or sealing", async () => {
+    const bad: SessionConfig = { ...config, password: [SENHA_NOVA, "curta"] };
+    t.app.get("/short-list", async (event) => ({
+      getSession: await errorOf(() => getSession(event, bad)),
+      useSession: await errorOf(() => useSession(event, bad)),
+      sealSession: await errorOf(() => sealSession(event, bad)),
+    }));
+
+    const body = await (await t.fetch("/short-list")).json();
+    expect(body.getSession).toBeTypeOf("string");
+    expect(body.useSession).toBeTypeOf("string");
+    expect(body.sealSession).toBeTypeOf("string");
+  });
+
+  // D-05: a short single string now throws on read instead of being ignored
+  it("throws for a short single password on read", async () => {
+    const bad: SessionConfig = { ...config, password: "curta" };
+    t.app.get("/short-string", async (event) => ({
+      getSession: await errorOf(() => getSession(event, bad)),
+    }));
+
+    const body = await (await t.fetch("/short-string")).json();
+    expect(body.getSession).toBeTypeOf("string");
+  });
+
+  // RF-06
+  it("opens a legacy session sealed with the old password at index 1", async () => {
+    t.app.post("/unseal", async (event) => {
+      const { sealed } = (await readBody(event)) as { sealed: string };
+      const unsealed = (await unsealSession(event, config, sealed)) as Record<PropertyKey, unknown>;
+      return { legacy: unsealed[kLegacySeal] === true, data: unsealed.data };
+    });
+    const legacySealed = await seal(
+      { id: "legacy-2", createdAt: Date.now(), data: { user: "old" } },
+      SENHA_ANTIGA,
+      legacyOptions,
+    );
+
+    const res = await t.fetch("/unseal", {
+      method: "POST",
+      body: JSON.stringify({ sealed: legacySealed }),
+    });
+    expect(await res.json()).toEqual({ legacy: true, data: { user: "old" } });
+  });
+
+  // RF-06
+  it("opens a legacy session sealed with the old password at index 2", async () => {
+    t.app.post("/unseal", async (event) => {
+      const { sealed } = (await readBody(event)) as { sealed: string };
+      const unsealed = (await unsealSession(
+        event,
+        { ...config, password: [SENHA_NOVA, SENHA_REMOVIDA, SENHA_ANTIGA] },
+        sealed,
+      )) as Record<PropertyKey, unknown>;
+      return { legacy: unsealed[kLegacySeal] === true };
+    });
+    const legacySealed = await seal(
+      { id: "legacy-3", createdAt: Date.now(), data: {} },
+      SENHA_ANTIGA,
+      legacyOptions,
+    );
+
+    const res = await t.fetch("/unseal", {
+      method: "POST",
+      body: JSON.stringify({ sealed: legacySealed }),
+    });
+    expect(await res.json()).toEqual({ legacy: true });
+  });
+
+  // RF-06 with legacySealFallback: false
+  it("rejects a legacy session with the old password when the fallback is off", async () => {
+    t.app.get("/strict", async (event) => {
+      const session = await getSession(event, { ...config, legacySealFallback: false });
+      return { id: session.id, data: session.data };
+    });
+    const legacySealed = await seal(
+      { id: "legacy-4", createdAt: Date.now(), data: { user: "old" } },
+      SENHA_ANTIGA,
+      legacyOptions,
+    );
+
+    const res = await t.fetch("/strict", { headers: { Cookie: `h3-sdd=${legacySealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("legacy-4");
+    expect(body.data).toEqual({});
+  });
+
+  // Regression: an expired session is still rejected, not masked by trying passwords
+  it("keeps rejecting sessions past maxAge with a password list", async () => {
+    const maxAgeConfig: SessionConfig = { ...config, maxAge: 3600 };
+    t.app.post("/expired", async (event) => {
+      const { sealed } = (await readBody(event)) as { sealed: string };
+      return { message: await errorOf(() => unsealSession(event, maxAgeConfig, sealed)) };
+    });
+    const expired = await seal(
+      { id: "expired-1", createdAt: Date.now() - 7200 * 1000, data: {} },
+      SENHA_ANTIGA,
+      { ...sealDefaults, ttl: 3600 * 1000 },
+    );
+
+    const res = await t.fetch("/expired", {
+      method: "POST",
+      body: JSON.stringify({ sealed: expired }),
+    });
+    expect(await res.json()).toEqual({ message: "Session expired!" });
+  });
+
+  // Public type contract (techspec D-01): string | string[], no tuple
+  it("types password as string or string[]", () => {
+    expectTypeOf<SessionConfig["password"]>().toEqualTypeOf<string | string[]>();
+  });
+});
