diff --git a/test/session-rotation.test.ts b/test/session-rotation.test.ts
new file mode 100644
index 0000000..d3c8205
--- /dev/null
+++ b/test/session-rotation.test.ts
@@ -0,0 +1,231 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { vi } from "vitest";
+import { getSession, unsealSession, updateSession, useSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const NEW = "new-password-".padEnd(40, "n");
+const OLD = "old-password-".padEnd(40, "o");
+const UNKNOWN = "unknown-password-".padEnd(40, "u");
+const SHORT = "curta";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const rotating: SessionConfig = {
+  name: "h3-rot",
+  password: [NEW, OLD],
+  generateId: () => "fresh",
+};
+
+describeMatrix("session rotation", (t, { it, expect }) => {
+  /** Seals a session with `password`, as h3 did before the rotation. */
+  const sealFor = (password: string, options = sealDefaults) =>
+    seal({ id: "old-id", createdAt: Date.now(), data: { user: "alice" } }, password, options);
+
+  const cookieOf = (res: Response) =>
+    res.headers.getSetCookie().find((c) => c.startsWith("h3-rot="));
+
+  const valueOf = (setCookie: string) => decodeURIComponent(setCookie.match(/h3-rot=([^;]+)/)![1]);
+
+  /** Runs `run` and resolves to the message of the error it throws, or null. */
+  const errorOf = (run: () => Promise<unknown>) =>
+    run().then(
+      () => null,
+      (error: Error) => error.message,
+    );
+
+  /** Reads the session through `getSession`, as a handler would. */
+  const addReadRoute = (path: string, config: SessionConfig) =>
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, config);
+      return { id: session.id, data: session.data };
+    });
+
+  it("accepts a list of passwords in useSession (RF-01)", async () => {
+    t.app.get("/use", async (event) => {
+      const session = await useSession(event, rotating);
+      return { id: session.id };
+    });
+    const res = await t.fetch("/use");
+    expect(res.status).toBe(200);
+    expect(cookieOf(res)).toBeDefined();
+  });
+
+  it("seals with the first password only (RF-02)", async () => {
+    t.app.get("/seal", async (event) => {
+      await updateSession(event, rotating, { user: "alice" });
+      return "ok";
+    });
+    const sealed = valueOf(cookieOf(await t.fetch("/seal"))!);
+    expect(await unseal(sealed, NEW, sealDefaults)).toMatchObject({ data: { user: "alice" } });
+    await expect(unseal(sealed, OLD, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("seals with the old password when it is listed first (RF-02, reversed order)", async () => {
+    t.app.get("/seal-reversed", async (event) => {
+      await updateSession(event, { ...rotating, password: [OLD, NEW] }, { user: "alice" });
+      return "ok";
+    });
+    const sealed = valueOf(cookieOf(await t.fetch("/seal-reversed"))!);
+    await expect(unseal(sealed, NEW, sealDefaults)).rejects.toThrow("Bad hmac value");
+    expect(await unseal(sealed, OLD, sealDefaults)).toMatchObject({ data: { user: "alice" } });
+  });
+
+  it("opens a session sealed with a later password (RF-03)", async () => {
+    addReadRoute("/read", rotating);
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-rot=${await sealFor(OLD)}` } });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toMatchObject({ id: "old-id", data: { user: "alice" } });
+  });
+
+  it("rejects a session that no listed password opens (RF-04)", async () => {
+    addReadRoute("/read", rotating);
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-rot=${await sealFor(UNKNOWN)}` } });
+    expect(await res.json()).toEqual({ id: "fresh", data: {} });
+
+    t.app.get("/unseal", async (event) => ({
+      error: await errorOf(async () => unsealSession(event, rotating, await sealFor(UNKNOWN))),
+    }));
+    expect(await (await t.fetch("/unseal")).json()).toEqual({ error: "Bad hmac value" });
+  });
+
+  it("reseals a session opened with a later password under the first one (RF-05)", async () => {
+    addReadRoute("/read", rotating);
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-rot=${await sealFor(OLD)}` } });
+    expect(await res.json()).toMatchObject({ id: "old-id", data: { user: "alice" } });
+
+    const resealed = valueOf(cookieOf(res)!);
+    expect(await unseal(resealed, NEW, sealDefaults)).toMatchObject({ id: "old-id" });
+    await expect(unseal(resealed, OLD, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("does not reseal an old session read from the header (RF-05, D-05)", async () => {
+    addReadRoute("/read", rotating);
+    const res = await t.fetch("/read", {
+      headers: { "x-h3-rot-session": await sealFor(OLD) },
+    });
+    expect(await res.json()).toMatchObject({ id: "old-id", data: { user: "alice" } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("rejects an empty password list, even without a cookie (RF-06)", async () => {
+    t.app.get("/seal-empty", async (event) => ({
+      error: await errorOf(() =>
+        updateSession(event, { ...rotating, password: [] }, { user: "alice" }),
+      ),
+    }));
+    t.app.get("/read-empty", async (event) => ({
+      error: await errorOf(() => getSession(event, { ...rotating, password: [] })),
+    }));
+    const message = { error: "Session password is missing or invalid" };
+    expect(await (await t.fetch("/seal-empty")).json()).toEqual(message);
+    expect(await (await t.fetch("/read-empty")).json()).toEqual(message);
+  });
+
+  it("rejects an empty entry even when an earlier password opens the session (RF-06)", async () => {
+    t.app.get("/read-empty-entry", async (event) => ({
+      error: await errorOf(() => getSession(event, { ...rotating, password: [NEW, ""] })),
+    }));
+    const res = await t.fetch("/read-empty-entry", {
+      headers: { Cookie: `h3-rot=${await sealFor(NEW)}` },
+    });
+    expect(await res.json()).toEqual({ error: "Empty password" });
+  });
+
+  it("rejects a short entry in the list (RF-06)", async () => {
+    t.app.get("/seal-short", async (event) => ({
+      error: await errorOf(() =>
+        updateSession(event, { ...rotating, password: [NEW, SHORT] }, { user: "alice" }),
+      ),
+    }));
+    expect(await (await t.fetch("/seal-short")).json()).toEqual({
+      error: "Password string too short (min 32 characters required)",
+    });
+  });
+
+  it("rejects a non-string password (RF-06)", async () => {
+    t.app.get("/seal-number", async (event) => ({
+      error: await errorOf(() =>
+        updateSession(event, { ...rotating, password: 42 as unknown as string }, { user: "a" }),
+      ),
+    }));
+    expect(await (await t.fetch("/seal-number")).json()).toEqual({
+      error: "Session password is missing or invalid",
+    });
+  });
+
+  it("treats a string and a one-item list alike (RF-07)", async () => {
+    t.app.get("/string", async (event) => ({
+      error: await errorOf(() =>
+        updateSession(event, { ...rotating, password: "x" }, { user: "alice" }),
+      ),
+    }));
+    t.app.get("/list", async (event) => ({
+      error: await errorOf(() =>
+        updateSession(event, { ...rotating, password: ["x"] }, { user: "alice" }),
+      ),
+    }));
+    const fromString = await (await t.fetch("/string")).json();
+    const fromList = await (await t.fetch("/list")).json();
+    expect(fromString).toEqual({ error: "Password string too short (min 32 characters required)" });
+    expect(fromList).toEqual(fromString);
+  });
+
+  it("opens a session the same way with a string or a one-item list (RF-07)", async () => {
+    addReadRoute("/one", { ...rotating, password: NEW });
+    addReadRoute("/one-list", { ...rotating, password: [NEW] });
+    const headers = { Cookie: `h3-rot=${await sealFor(NEW)}` };
+    expect(await (await t.fetch("/one", { headers })).json()).toMatchObject({ id: "old-id" });
+    expect(await (await t.fetch("/one-list", { headers })).json()).toMatchObject({ id: "old-id" });
+  });
+
+  it("opens a legacy seal from a later password and reseals it (RF-08)", async () => {
+    addReadRoute("/read", rotating);
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `h3-rot=${await sealFor(OLD, legacyOptions)}` },
+    });
+    expect(await res.json()).toMatchObject({ id: "old-id", data: { user: "alice" } });
+
+    const resealed = valueOf(cookieOf(res)!);
+    expect(await unseal(resealed, NEW, sealDefaults)).toMatchObject({ id: "old-id" });
+  });
+
+  it("rejects a legacy seal from a later password with legacySealFallback: false (RF-08)", async () => {
+    addReadRoute("/read-strict", { ...rotating, legacySealFallback: false });
+    const res = await t.fetch("/read-strict", {
+      headers: { Cookie: `h3-rot=${await sealFor(OLD, legacyOptions)}` },
+    });
+    expect(await res.json()).toEqual({ id: "fresh", data: {} });
+  });
+
+  it("derives two keys per seal, from the first password only (cost)", async () => {
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    t.app.get("/seal-count", async (event) => {
+      await updateSession(event, rotating, { user: "alice" });
+      return "ok";
+    });
+
+    deriveBits.mockClear();
+    const res = await t.fetch("/seal-count");
+    expect(res.headers.getSetCookie()).toHaveLength(1);
+    // Encryption and integrity keys for one seal, not one per listed password
+    expect(deriveBits).toHaveBeenCalledTimes(2);
+    deriveBits.mockRestore();
+  });
+
+  it("propagates Expired seal without trying the next password (propagation)", async () => {
+    // An expiration older than the clock skew allowance fails before any HMAC check
+    const expired = await seal({ id: "old-id", createdAt: Date.now(), data: {} }, OLD, {
+      ...sealDefaults,
+      ttl: -120_000,
+    });
+    t.app.get("/unseal-expired", async (event) => ({
+      error: await errorOf(() => unsealSession(event, rotating, expired)),
+    }));
+    expect(await (await t.fetch("/unseal-expired")).json()).toEqual({ error: "Expired seal" });
+  });
+});
