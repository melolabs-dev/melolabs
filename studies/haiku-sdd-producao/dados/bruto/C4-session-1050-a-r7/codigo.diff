+ * Throws before any unseal attempt, so invalid entries never go unchecked.
+ */
+function resolvePasswords(config: SessionConfig): string[] {
+  const passwords = Array.isArray(config.password) ? config.password : [config.password];
+  if (passwords.length === 0 || passwords.some((password) => typeof password !== "string")) {
+    throw new Error("Session password is missing or invalid");
+  }
+  const { encryption, integrity } = { ...sealDefaults, ...config.seal };
+  const minLength = Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+  for (const password of passwords) {
+    if (!password) {
+      throw new Error("Empty password");
