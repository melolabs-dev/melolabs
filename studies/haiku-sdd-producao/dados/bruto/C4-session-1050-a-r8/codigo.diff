+/**
+ * Open a sealed session with the first password that verifies it. A session
+ * opened with any other password is marked so `getSession` reseals it with the
+ * first one. Throws the last error when no password opens it.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  let lastError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await unsealWithPassword(sealed, password, sealOptions, legacySealFallback);
+      if (index > 0 && unsealed) {
+        (unsealed as any)[kOlderPassword] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+/**
+ * Unseal with one password, applying the legacy 1-iteration fallback to it.
+ * Throws the same errors `unseal` does for that password.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  let unsealed: Partial<Session>;
+  try {
+    unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      !legacySealFallback ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+  }
+  return unsealed;
+}
