+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach } from "vitest";
+import { getSession, sealSession, unsealSession, updateSession, useSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const NOVA = "nova-1234567123456712345671234567123456712345671234567";
+const ANTIGA = "antiga-1234567123456712345671234567123456712345671234567";
+const DESCONHECIDA = "desconhecida-12345671234567123456712345671234567123456";
+
+const LEGACY_SEAL_OPTIONS = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+/** Extract the sealed value of the last `Set-Cookie` for the test session cookie. */
+function sealedFrom(res: Response): string {
+  const setCookie = res.headers.getSetCookie().at(-1)!;
+  return decodeURIComponent(setCookie.match(/h3-test=([^;]+)/)![1]);
+}
+
+describeMatrix("sdd: várias senhas de unseal nas sessões", (t, { it, expect }) => {
+  const config = (password: SessionConfig["password"], extra: Partial<SessionConfig> = {}) =>
+    ({
+      name: "h3-test",
+      password,
+      generateId: () => "new-id",
+      ...extra,
+    }) as SessionConfig;
+
+  const rotating = config([NOVA, ANTIGA]);
+
+  beforeEach(() => {
+    t.app.get("/get", async (event) => {
+      const session = await getSession(event, rotating);
+      return { id: session.id, data: session.data };
+    });
+    t.app.post("/update", async (event) => {
+      const session = await useSession(event, rotating);
+      await session.update({ foo: "bar" });
+      return { id: session.id, data: session.data };
+    });
+  });
+
+  // RF-01
+  it("seals new sessions with the first password of the list", async () => {
+    const res = await t.fetch("/update", { method: "POST" });
+    const sealed = sealedFrom(res);
+
+    expect(await unseal(sealed, NOVA, sealDefaults)).toMatchObject({ data: { foo: "bar" } });
+    await expect(unseal(sealed, ANTIGA, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-02
+  it("reads a session sealed with an older password of the list", async () => {
+    const sealed = await seal(
+      { id: "orig-id", createdAt: Date.now(), data: { foo: "antiga" } },
+      ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/get", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toEqual({ id: "orig-id", data: { foo: "antiga" } });
+  });
+
+  // RF-03
+  it("treats a session sealed with an unknown password as a new session", async () => {
+    const sealed = await seal(
+      { id: "orig-id", createdAt: Date.now(), data: { foo: "secreto" } },
+      DESCONHECIDA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/get", { headers: { Cookie: `h3-test=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("orig-id");
+    expect(body.data).toEqual({});
+  });
+
+  // RF-04
+  it("reseals a session read with an older password using the first password", async () => {
+    const sealed = await seal(
+      { id: "orig-id", createdAt: Date.now(), data: { foo: "antiga" } },
+      ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/update", {
+      method: "POST",
+      headers: { Cookie: `h3-test=${sealed}` },
+    });
+    const resealed = sealedFrom(res);
+
+    expect(await unseal(resealed, NOVA, sealDefaults)).toMatchObject({
+      id: "orig-id",
+      data: { foo: "bar" },
+    });
+    await expect(unseal(resealed, ANTIGA, sealDefaults)).rejects.toThrow("Bad hmac value");
+    // Internal markers must not leak into the sealed payload
+    const payload = (await unseal(resealed, NOVA, sealDefaults)) as Record<string, unknown>;
+    expect(Object.keys(payload).sort()).toEqual(["createdAt", "data", "id"]);
+  });
+
+  // RF-04 (idleTimeout slide)
+  it("reseals an idle-sliding session opened with an older password using the first password", async () => {
+    const idleConfig = config([NOVA, ANTIGA], { idleTimeout: 3600 });
+    t.app.get("/idle", async (event) => {
+      const session = await getSession(event, idleConfig);
+      return { id: session.id };
+    });
+    const sealed = await seal(
+      {
+        id: "orig-id",
+        createdAt: Date.now() - 2100 * 1000,
+        data: { foo: "antiga" },
+      },
+      ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/idle", { headers: { Cookie: `h3-test=${sealed}` } });
+    expect(await res.json()).toEqual({ id: "orig-id" });
+    const resealed = sealedFrom(res);
+    expect(await unseal(resealed, NOVA, sealDefaults)).toMatchObject({ id: "orig-id" });
+    await expect(unseal(resealed, ANTIGA, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  // RF-06
+  it("opens a legacy 1-iteration session sealed with a non-first password and reseals it", async () => {
+    const legacySealed = await seal(
+      { id: "legacy", createdAt: Date.now(), data: { foo: "legacy" } },
