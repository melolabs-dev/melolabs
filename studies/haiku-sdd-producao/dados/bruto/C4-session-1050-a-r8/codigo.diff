+    const res = await t.fetch("/get", { headers: { Cookie: `h3-test=${legacySealed}` } });
+    expect(await res.json()).toEqual({ id: "legacy", data: { foo: "legacy" } });
+
+    const resealed = sealedFrom(res);
+    expect(await unseal(resealed, NOVA, sealDefaults)).toMatchObject({
+      id: "legacy",
+      data: { foo: "legacy" },
+    });
+  });
+
+  // RF-08
+  it("expires an older-password session by maxAge the same way as a current one", async () => {
+    const maxAgeConfig = config([NOVA, ANTIGA], { maxAge: 60 });
+    t.app.get("/max", async (event) => {
+      const session = await getSession(event, maxAgeConfig);
+      return { id: session.id };
+    });
+    const sealed = await seal(
+      { id: "old", createdAt: Date.now() - 120 * 1000, data: { foo: "antiga" } },
+      ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/max", { headers: { Cookie: `h3-test=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("old");
+  });
+
+  // RF-09
+  it("reads an older-password session sent in the session header", async () => {
+    const sealed = await seal(
+      { id: "orig-id", createdAt: Date.now(), data: { foo: "antiga" } },
+      ANTIGA,
+      sealDefaults,
+    );
+
+    const res = await t.fetch("/get", { headers: { "x-h3-test-session": sealed } });
+    expect(await res.json()).toEqual({ id: "orig-id", data: { foo: "antiga" } });
+    // Header sessions are not resealed
+    expect(res.headers.getSetCookie()).toHaveLength(0);
