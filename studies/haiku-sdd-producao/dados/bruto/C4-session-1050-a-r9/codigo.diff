+/**
+ * The configured passwords as a list, in order. Throws on an empty list, so it
+ * can never be mistaken for a failed unseal.
+ */
+function unsealPasswords(config: SessionConfig): string[] {
+  const passwords = Array.isArray(config.password) ? config.password : [config.password];
+  if (passwords.length === 0) {
+    throw new Error("Session password list is empty: at least one password is required");
+  }
+  return passwords;
+}
+
+/** The password used to seal: the first of the list. */
+function sealPassword(config: SessionConfig): string {
+  return unsealPasswords(config)[0]!;
+}
+
+/**
+ * Open `sealed` with each password in order. Only `Bad hmac value` moves on to
+ * the next password; any other error is thrown at once, so a malformed or
+ * expired seal costs no derivations and an invalid password in the list surfaces
+ * as a configuration error. Each password also gets the legacy 1-iteration
+ * attempt, marked with `kLegacySeal`. If none opens the seal, the last
+ * `Bad hmac value` is thrown, without saying which position failed.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (!legacySealFallback || sealOptions.integrity.iterations === 1) {
+      continue;
+    }
+    try {
+      const unsealed = (await unseal(sealed, password, {
+        ...sealOptions,
+        encryption: { ...sealOptions.encryption, iterations: 1 },
+        integrity: { ...sealOptions.integrity, iterations: 1 },
+      })) as Partial<Session>;
+      if (unsealed) {
+        (unsealed as any)[kLegacySeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
diff --git a/test/sdd-multiple-passwords.test.ts b/test/sdd-multiple-passwords.test.ts
