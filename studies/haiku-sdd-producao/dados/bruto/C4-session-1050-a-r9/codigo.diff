index 0000000..8a13fdd
--- /dev/null
+++ b/test/sdd-multiple-passwords.test.ts
@@ -0,0 +1,259 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach, vi } from "vitest";
+import { useSession, getSession, readBody } from "../src/index.ts";
+import { sealSession, unsealSession } from "../src/utils/session.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for multiple unseal passwords (sdd/prd.md, sdd/techspec.md)
+const PW_A = "senha-nova-com-32-caracteres-ou-mais-a";
+const PW_B = "senha-antiga-com-32-caracteres-ou-mais-b";
+const PW_C = "senha-fora-da-lista-com-32-caracteres-c";
+const SHORT = "curta";
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const sealedBy = (
+  password: string,
+  session: { id: string; createdAt: number; data: Record<string, unknown> },
+  options = sealDefaults,
+) => seal(session, password, options);
+
+const cookieValue = (res: Response) =>
+  decodeURIComponent(res.headers.getSetCookie()[0].match(/h3-multi=([^;]+)/)![1]);
+
+describeMatrix("session: multiple passwords", (t, { it, expect }) => {
+  const config: SessionConfig = {
+    name: "h3-multi",
+    password: [PW_A, PW_B],
+  };
+  const oldSession = (password: string, data = { user: "alice" }, options = sealDefaults) =>
+    sealedBy(password, { id: "old", createdAt: Date.now(), data }, options);
+
+  beforeEach(() => {
+    t.app.all("/", async (event) => {
+      const session = await useSession(event, config);
+      if (event.req.method === "POST") {
+        await session.update((await readBody(event)) as any);
+      }
+      return { id: session.id, data: session.data };
+    });
+
+    // Opens a sealed value with `config` and reports the error message, if any
+    t.app.post("/unseal", async (event) => {
+      const sealed = await event.req.text();
+      try {
+        return await unsealSession(event, config, sealed);
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    t.app.get("/strict", async (event) => {
+      const session = await useSession(event, { ...config, legacySealFallback: false });
+      return { id: session.id, data: session.data };
+    });
+
+    t.app.get("/one", async (event) => {
+      const session = await useSession(event, { name: "h3-multi", password: [PW_A] });
+      return { id: session.id, data: session.data };
+    });
+
+    t.app.get("/string", async (event) => {
+      const session = await useSession(event, { name: "h3-multi", password: PW_A });
+      return { id: session.id, data: session.data };
+    });
+
+    t.app.get("/empty-seal", async (event) => {
+      try {
+        await sealSession(event, { ...config, password: [] });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    t.app.get("/empty-read", async (event) => {
+      try {
+        await getSession(event, { ...config, password: [] });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    t.app.get("/short-new", async (event) => {
+      try {
+        await useSession(event, { ...config, password: [SHORT, PW_B] });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    t.app.post("/unseal-short-second", async (event) => {
+      const sealed = await event.req.text();
+      try {
+        await unsealSession(event, { ...config, password: [PW_A, SHORT, PW_B] }, sealed);
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    t.app.post("/unseal-three", async (event) => {
+      const sealed = await event.req.text();
+      const data = await unsealSession(event, { ...config, password: [PW_A, PW_B, PW_C] }, sealed);
+      return data;
+    });
+  });
+
+  it("seals new sessions with the first password only", async () => {
+    const res = await t.fetch("/");
+    const sealed = cookieValue(res);
+
+    await expect(unseal(sealed, PW_A, sealDefaults)).resolves.toMatchObject({ data: {} });
+    await expect(unseal(sealed, PW_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("opens a session sealed with a previous password", async () => {
+    const res = await t.fetch("/", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(await oldSession(PW_B))}` },
+    });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+  });
+
+  it("reseals a session opened with a previous password under the first one", async () => {
+    const res = await t.fetch("/", {
+      method: "POST",
+      headers: { Cookie: `h3-multi=${encodeURIComponent(await oldSession(PW_B))}` },
+      body: JSON.stringify({ role: "admin" }),
+    });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice", role: "admin" } });
+
+    const resealed = cookieValue(res);
+    await expect(unseal(resealed, PW_A, sealDefaults)).resolves.toMatchObject({ id: "old" });
+    await expect(unseal(resealed, PW_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("rejects a session sealed with a password outside the list", async () => {
+    const outside = await oldSession(PW_C);
+
+    const res = await t.fetch("/", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(outside)}` },
+    });
+    const body = await res.json();
+    expect(body.id).not.toBe("old");
+    expect(body.data).toEqual({});
+
+    const direct = await t.fetch("/unseal", {
+      method: "POST",
+      body: outside,
+    });
+    expect(await direct.json()).toEqual({ error: "Bad hmac value" });
+  });
+
+  it("reads a previous-password session from the session header", async () => {
+    const res = await t.fetch("/", {
+      headers: { "x-h3-multi-session": await oldSession(PW_B) },
+    });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+  });
+
+  it("opens a legacy seal made with a previous password and reseals it", async () => {
+    const legacy = await oldSession(PW_B, { user: "alice" }, legacyOptions);
+
+    const res = await t.fetch("/", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(legacy)}` },
+    });
+    expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+    const resealed = cookieValue(res);
+    await expect(unseal(resealed, PW_A, sealDefaults)).resolves.toMatchObject({ id: "old" });
+  });
+
+  it("does not open a legacy seal made with a previous password when legacySealFallback is false", async () => {
+    const legacy = await oldSession(PW_B, { user: "alice" }, legacyOptions);
+
+    const res = await t.fetch("/strict", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(legacy)}` },
+    });
+    const body = await res.json();
+    expect(body.id).not.toBe("old");
+    expect(body.data).toEqual({});
+  });
+
+  it("rejects an empty password list when sealing", async () => {
+    const res = await t.fetch("/empty-seal");
+    expect(await res.json()).toEqual({
+      error: "Session password list is empty: at least one password is required",
+    });
+  });
+
+  it("rejects an empty password list when reading a session that has a cookie", async () => {
+    const res = await t.fetch("/empty-read", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(await oldSession(PW_A))}` },
+    });
+    expect(await res.json()).toEqual({
+      error: "Session password list is empty: at least one password is required",
+    });
+  });
+
+  it("treats a one-item list the same as a string password", async () => {
+    const sealedByString = await oldSession(PW_A);
+    const fromList = await t.fetch("/one", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(sealedByString)}` },
+    });
+    expect(await fromList.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+    // A session sealed through the list opens through the plain string
+    const created = await t.fetch("/one");
+    const { id } = await created.json();
+    const fromString = await t.fetch("/string", {
+      headers: { Cookie: `h3-multi=${encodeURIComponent(cookieValue(created))}` },
+    });
+    expect(await fromString.json()).toMatchObject({ id });
+  });
+
+  it("validates the first password with the single-password rules when sealing", async () => {
+    const res = await t.fetch("/short-new");
+    expect((await res.json()).error).toContain("Password string too short");
+  });
+
+  it("surfaces a short password later in the list as a configuration error", async () => {
+    const sealedBySecond = await oldSession(PW_B);
+    const res = await t.fetch("/unseal-short-second", {
+      method: "POST",
+      body: sealedBySecond,
+    });
+    const { error } = await res.json();
+    expect(error).toContain("Password string too short");
+    expect(error).not.toBe("Bad hmac value");
+  });
+
+  it("derives keys once per password tried, plus the success path", async () => {
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      const sealedByLast = await oldSession(PW_C);
+      deriveBits.mockClear();
+      const res = await t.fetch("/unseal-three", {
+        method: "POST",
+        body: sealedByLast,
+      });
+      expect(await res.json()).toMatchObject({ id: "old", data: { user: "alice" } });
+
+      // Two failed passwords (one HMAC derivation each) + the matching one
+      // (HMAC and decryption key). Legacy 1-iteration attempts are not counted.
+      const fullIterations = deriveBits.mock.calls.filter(
+        ([params]) => (params as { iterations?: number }).iterations === 8192,
+      );
+      expect(fullIterations).toHaveLength(4);
+    } finally {
+      deriveBits.mockRestore();
+    }
+  });
+});
