diff --git a/test/sdd-extra-unseal-passwords.test.ts b/test/sdd-extra-unseal-passwords.test.ts
new file mode 100644
index 0000000..94b40f9
--- /dev/null
+++ b/test/sdd-extra-unseal-passwords.test.ts
@@ -0,0 +1,211 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach, vi } from "vitest";
+import { getSession, useSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for `extraUnsealPasswords` (h3js/h3#1050, variant B).
+// Derived from sdd/prd.md (RF-01 to RF-08) and sdd/techspec.md.
+
+const CURRENT = "current-password-0123456789abcdefghij";
+const PREVIOUS = "previous-password-0123456789abcdefgh";
+const OTHER = "other-previous-password-0123456789abcd";
+const UNKNOWN = "unknown-password-0123456789abcdefghijk";
+
+const sessionName = "h3-extra";
+
+describeMatrix("sdd extraUnsealPasswords", (t, { it, expect, describe }) => {
+  let idCtr = 0;
+
+  beforeEach(() => {
+    idCtr = 0;
+  });
+
+  const config = (overrides: Partial<SessionConfig> = {}): SessionConfig => ({
+    name: sessionName,
+    password: CURRENT,
+    extraUnsealPasswords: [PREVIOUS],
+    generateId: () => `sdd-${++idCtr}`,
+    ...overrides,
+  });
+
+  const sealWith = (password: string, id: string, data: Record<string, unknown> = {}) =>
+    seal({ id, createdAt: Date.now(), data }, password, sealDefaults);
+
+  const cookieHeader = (sealed: string) => ({ Cookie: `${sessionName}=${sealed}` });
+
+  const sessionCookie = (res: Response) =>
+    res.headers.getSetCookie().find((c) => c.startsWith(`${sessionName}=`));
+
+  const sealedValue = (setCookie: string) =>
+    decodeURIComponent(setCookie.match(/^h3-extra=([^;]+)/)![1]);
+
+  const registerRead = (cfg: SessionConfig, path = "/read") => {
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+  };
+
+  describe("extraUnsealPasswords", () => {
+    it("RF-03 / RF-07: reads a session sealed with a previous password and keeps its id", async () => {
+      registerRead(config());
+      const sealed = await sealWith(PREVIOUS, "old-1", { user: "alice" });
+
+      const res = await t.fetch("/read", { headers: cookieHeader(sealed) });
+      expect(await res.json()).toMatchObject({ id: "old-1", data: { user: "alice" } });
+      expect(sessionCookie(res)).toBeDefined();
+    });
+
+    it("RF-02 / RF-07: reseals a session opened with a previous password using the current password only", async () => {
+      registerRead(config());
+      const sealed = await sealWith(PREVIOUS, "old-1", { user: "alice" });
+
+      const res = await t.fetch("/read", { headers: cookieHeader(sealed) });
+      const cookie = sessionCookie(res);
+      expect(cookie).toBeDefined();
+      const resealed = sealedValue(cookie!);
+
+      await expect(unseal(resealed, CURRENT, sealDefaults)).resolves.toMatchObject({
+        id: "old-1",
+        data: { user: "alice" },
+      });
+      await expect(unseal(resealed, PREVIOUS, sealDefaults)).rejects.toThrow();
+    });
+
+    it("RF-02: seals new sessions with the current password only", async () => {
+      t.app.get("/new", async (event) => {
+        const session = await useSession(event, config());
+        return { id: session.id };
+      });
+
+      const res = await t.fetch("/new");
+      const cookie = sessionCookie(res);
+      expect(cookie).toBeDefined();
+      const sealed = sealedValue(cookie!);
+
+      await expect(unseal(sealed, CURRENT, sealDefaults)).resolves.toMatchObject({ id: "sdd-1" });
+      await expect(unseal(sealed, PREVIOUS, sealDefaults)).rejects.toThrow();
+    });
+
+    it("RF-03: tries the extra passwords in order, so any of them can open a session", async () => {
+      registerRead(config({ extraUnsealPasswords: [OTHER, PREVIOUS] }));
+      const fromPrevious = await sealWith(PREVIOUS, "from-previous");
+      const fromOther = await sealWith(OTHER, "from-other");
+
+      const res1 = await t.fetch("/read", { headers: cookieHeader(fromPrevious) });
+      expect(await res1.json()).toMatchObject({ id: "from-previous" });
+
+      const res2 = await t.fetch("/read", { headers: cookieHeader(fromOther) });
+      expect(await res2.json()).toMatchObject({ id: "from-other" });
+    });
+
+    it("RF-04: with extra passwords present, a current session is read without resealing", async () => {
+      registerRead(config());
+      const sealed = await sealWith(CURRENT, "current-1", { user: "bob" });
+
+      const res = await t.fetch("/read", { headers: cookieHeader(sealed) });
+      expect(await res.json()).toMatchObject({ id: "current-1", data: { user: "bob" } });
+      expect(res.headers.getSetCookie()).toHaveLength(0);
+    });
+
+    it("RF-04: without extra passwords, reads behave as before", async () => {
+      registerRead(config({ extraUnsealPasswords: undefined }), "/none");
+      const sealed = await sealWith(CURRENT, "current-1", { user: "bob" });
+
+      const res = await t.fetch("/none", { headers: cookieHeader(sealed) });
+      expect(await res.json()).toMatchObject({ id: "current-1", data: { user: "bob" } });
+      expect(res.headers.getSetCookie()).toHaveLength(0);
+    });
+
+    it("RF-04: with an empty extra list, reads behave as before", async () => {
+      registerRead(config({ extraUnsealPasswords: [] }), "/empty");
+      const sealed = await sealWith(CURRENT, "current-1", { user: "bob" });
+
+      const res = await t.fetch("/empty", { headers: cookieHeader(sealed) });
+      expect(await res.json()).toMatchObject({ id: "current-1", data: { user: "bob" } });
+      expect(res.headers.getSetCookie()).toHaveLength(0);
+    });
+
+    it("RF-05: a cookie that no password unseals is treated as no session", async () => {
+      registerRead(config());
+      const sealed = await sealWith(UNKNOWN, "unknown-1", { user: "mallory" });
+
+      const res = await t.fetch("/read", { headers: cookieHeader(sealed) });
+      expect(res.status).toBe(200);
+      const body = await res.json();
+      expect(body.id).not.toBe("unknown-1");
+      expect(body.data).toEqual({});
+    });
+
+    it("RF-06: the legacy 1-iteration fallback applies to extra passwords", async () => {
+      registerRead(config());
+      const legacySealed = await seal(
+        { id: "legacy-1", createdAt: Date.now(), data: { user: "carol" } },
+        PREVIOUS,
+        {
+          ...sealDefaults,
+          encryption: { ...sealDefaults.encryption, iterations: 1 },
+          integrity: { ...sealDefaults.integrity, iterations: 1 },
+        },
+      );
+
+      const res = await t.fetch("/read", { headers: cookieHeader(legacySealed) });
+      expect(await res.json()).toMatchObject({ id: "legacy-1", data: { user: "carol" } });
+      const cookie = sessionCookie(res);
+      expect(cookie).toBeDefined();
+      await expect(unseal(sealedValue(cookie!), CURRENT, sealDefaults)).resolves.toMatchObject({
+        id: "legacy-1",
+      });
+    });
+
+    it("RF-08: a too-short extra password is a configuration error when creating or reading", async () => {
+      const message = "extraUnsealPasswords[0] is too short (min 32 characters required)";
+      const short = config({ extraUnsealPasswords: ["curta"] });
+      t.app.get("/short", async (event) => {
+        try {
+          await useSession(event, short);
+          return { error: null };
+        } catch (error) {
+          return { error: (error as Error).message };
+        }
+      });
+
+      const created = await t.fetch("/short");
+      expect(await created.json()).toEqual({ error: message });
+
+      const sealed = await sealWith(CURRENT, "current-1");
+      const read = await t.fetch("/short", { headers: cookieHeader(sealed) });
+      expect(await read.json()).toEqual({ error: message });
+    });
+
+    it("extra passwords do not extend a session past maxAge", async () => {
+      const t0 = Date.parse("2030-01-01T00:00:00Z");
+      vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+      try {
+        registerRead(config({ maxAge: 60 }));
+        const sealed = await seal(
+          { id: "old-1", createdAt: t0 - 120_000, data: { user: "dave" } },
+          PREVIOUS,
+          sealDefaults,
+        );
+
+        const res = await t.fetch("/read", { headers: cookieHeader(sealed) });
+        const body = await res.json();
+        expect(body.id).not.toBe("old-1");
+        expect(body.data).toEqual({});
+      } finally {
+        vi.useRealTimers();
+      }
+    });
+
+    it("reads a session sent in the session header with a previous password, without a Set-Cookie", async () => {
+      registerRead(config());
+      const sealed = await sealWith(PREVIOUS, "header-1", { user: "erin" });
+
+      const res = await t.fetch("/read", { headers: { "x-h3-extra-session": sealed } });
+      expect(await res.json()).toMatchObject({ id: "header-1", data: { user: "erin" } });
+      expect(res.headers.getSetCookie()).toHaveLength(0);
+    });
+  });
+});
