+/**
+ * Reject `extraUnsealPasswords` shorter than the minimum the seal accepts for
+ * `password`. Checked up front so a short entry is a configuration error, not a
+ * silent failure to unseal.
+ */
+function assertExtraUnsealPasswords(config: SessionConfig): void {
+  if (!config.extraUnsealPasswords?.length) {
+    return;
+  }
+  const { encryption, integrity } = { ...sealDefaults, ...config.seal };
+  const min = Math.max(encryption.minPasswordlength, integrity.minPasswordlength);
+  config.extraUnsealPasswords.forEach((password, i) => {
+    if (password.length < min) {
+      throw new Error(`extraUnsealPasswords[${i}] is too short (min ${min} characters required)`);
+    }
+  });
+}
