+import type { SessionConfig } from "../src/utils/session.ts";
+import { beforeEach, expectTypeOf, vi } from "vitest";
+import { getSession, unsealSession, updateSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Spy on `unseal` without changing its behavior, to check the order of attempts
+vi.mock("../src/utils/internal/iron-crypto.ts", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("../src/utils/internal/iron-crypto.ts")>();
+  return { ...actual, unseal: vi.fn(actual.unseal) };
+});
+
+const PASSWORD_A = "a".repeat(48);
+const PASSWORD_B = "b".repeat(48);
+const PASSWORD_C = "c".repeat(48);
+const PASSWORD_D = "d".repeat(48);
+const PASSWORD_Z = "z".repeat(48);
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+function sessionSealedWith(
+  password: string,
+  overrides: Record<string, unknown> = {},
+  options = sealDefaults,
+): Promise<string> {
+  return seal(
+    { id: "sdd-1", createdAt: Date.now(), data: { user: "bob" }, ...overrides },
+    password,
+    options,
+  );
+}
+
+describeMatrix("session extra unseal passwords (sdd)", (t, { it, expect }) => {
+  const baseConfig: SessionConfig = {
+    name: "h3-sdd",
+    password: PASSWORD_A,
+    extraUnsealPasswords: [PASSWORD_B],
+  };
+
+  // Route handlers read the config of the current test from here
+  let config: SessionConfig = baseConfig;
+
+  beforeEach(() => {
+    config = baseConfig;
+    vi.mocked(unseal).mockClear();
+
+    t.app.get("/read", async (event) => {
+      try {
+        const session = await getSession(event, config);
+        return { id: session.id, data: session.data };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/write", async (event) => {
+      await updateSession(event, config, { user: "carol" });
+      return "ok";
+    });
+    t.app.get("/unseal", async (event) => {
+      try {
+        const unsealed = await unsealSession(event, config, event.req.headers.get("x-sealed")!);
+        return { data: unsealed.data };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+  });
+
+  it("opens a session sealed with an extra password (RF-01)", async () => {
+    const sealed = await sessionSealedWith(PASSWORD_B);
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `h3-sdd=${sealed}` },
+    });
+    expect(await res.json()).toMatchObject({ id: "sdd-1", data: { user: "bob" } });
+  });
+
+  it("reseals an extra-sealed session with password on read (RF-02, D-04)", async () => {
+    const sealed = await sessionSealedWith(PASSWORD_B);
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `h3-sdd=${sealed}` },
+    });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = decodeURIComponent(setCookies[0].match(/h3-sdd=([^;]+)/)![1]);
+
+    expect(await unseal(resealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "sdd-1",
+      data: { user: "bob" },
+    });
+    await expect(unseal(resealed, PASSWORD_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("seals writes with password only (RF-02)", async () => {
+    const sealed = await sessionSealedWith(PASSWORD_B);
+    const res = await t.fetch("/write", {
+      headers: { Cookie: `h3-sdd=${sealed}` },
+    });
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const written = decodeURIComponent(setCookies[0].match(/h3-sdd=([^;]+)/)![1]);
+
+    expect(await unseal(written, PASSWORD_A, sealDefaults)).toMatchObject({
+      data: { user: "carol" },
+    });
+    await expect(unseal(written, PASSWORD_B, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("does not reseal an extra-sealed session read from the session header (D-04)", async () => {
+    const sealed = await sessionSealedWith(PASSWORD_B);
+    const res = await t.fetch("/read", {
+      headers: { "x-h3-sdd-session": sealed },
+    });
+    expect(await res.json()).toMatchObject({ id: "sdd-1", data: { user: "bob" } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("tries passwords in declared order and stops at the match (RF-03, D-01)", async () => {
+    config = { ...baseConfig, extraUnsealPasswords: [PASSWORD_B, PASSWORD_C, PASSWORD_D] };
+    const sealed = await sessionSealedWith(PASSWORD_C);
+    vi.mocked(unseal).mockClear();
+
+    const res = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+
+    expect(await res.json()).toMatchObject({ data: { user: "bob" } });
+    // Each password may be tried twice (normal, then the legacy 1-iteration retry),
+    // so compare the order of first attempts
+    const attempted = vi.mocked(unseal).mock.calls.map(([, password]) => password);
+    expect([...new Set(attempted)]).toEqual([PASSWORD_A, PASSWORD_B, PASSWORD_C]);
+  });
+
+  it("fails with the same error as without extras when no password opens it (RF-03)", async () => {
+    const sealed = await sessionSealedWith(PASSWORD_Z);
+
+    const res = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+    expect(await res.json()).toEqual({ error: "Bad hmac value" });
+
+    const withoutExtras = await t.fetch("/read", {
+      headers: { Cookie: `h3-sdd=${sealed}` },
+    });
+    expect(await withoutExtras.json()).toMatchObject({ data: {} });
+  });
+
+  it("stops at a non-HMAC error without trying other passwords (D-01)", async () => {
+    config = { ...baseConfig, extraUnsealPasswords: [PASSWORD_B, PASSWORD_C] };
+    const expired = await sessionSealedWith(PASSWORD_B, {}, { ...sealDefaults, ttl: -120_000 });
+    vi.mocked(unseal).mockClear();
+
+    const res = await t.fetch("/unseal", { headers: { "x-sealed": expired } });
+
+    expect(await res.json()).toEqual({ error: "Expired seal" });
+    expect(vi.mocked(unseal)).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects an empty extra password instead of skipping it (RF-05)", async () => {
+    config = { ...baseConfig, extraUnsealPasswords: [""] };
+    const sealed = await sessionSealedWith(PASSWORD_A);
+
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `h3-sdd=${sealed}` },
+    });
+    expect(await res.json()).toEqual({ error: "Empty password" });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("validates extras before trying any password, even when password matches (RF-05, D-03)", async () => {
+    config = { ...baseConfig, extraUnsealPasswords: ["", PASSWORD_B] };
+    const sealed = await sessionSealedWith(PASSWORD_A);
+
+    const res = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+    expect(await res.json()).toEqual({ error: "Empty password" });
+  });
+
+  it("rejects a short extra password with the same message as password (RF-05)", async () => {
+    config = { ...baseConfig, extraUnsealPasswords: ["curta"] };
+    const sealed = await sessionSealedWith(PASSWORD_A);
+
+    const res = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+    expect(await res.json()).toEqual({
+      error: "Password string too short (min 32 characters required)",
+    });
+  });
+
+  it("opens a legacy seal sealed with an extra password and reseals it (RF-06)", async () => {
+    const legacySealed = await sessionSealedWith(PASSWORD_B, {}, legacyOptions);
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `h3-sdd=${legacySealed}` },
+    });
+    expect(await res.json()).toMatchObject({ id: "sdd-1", data: { user: "bob" } });
+
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = decodeURIComponent(setCookies[0].match(/h3-sdd=([^;]+)/)![1]);
+    expect(await unseal(resealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      data: { user: "bob" },
+    });
+  });
+
+  it("rejects a legacy seal sealed with an extra password when legacySealFallback is false (RF-06)", async () => {
+    config = { ...baseConfig, legacySealFallback: false };
+    const legacySealed = await sessionSealedWith(PASSWORD_B, {}, legacyOptions);
+
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `h3-sdd=${legacySealed}` },
+    });
+    expect(await res.json()).toMatchObject({ data: {} });
+    expect(res.headers.getSetCookie().join(";")).not.toContain("h3-sdd=");
+  });
+
+  it("expires a session opened with an extra password (RF-07)", async () => {
+    config = { ...baseConfig, maxAge: 60 };
+    const sealed = await sessionSealedWith(PASSWORD_B, { createdAt: Date.now() - 120_000 });
+
+    const res = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+    expect(await res.json()).toEqual({ error: "Session expired!" });
+  });
+
+  it("behaves the same without extras, or with an empty list (RF-04)", async () => {
+    const sealed = await sessionSealedWith(PASSWORD_Z);
+    const results = [];
+    for (const extraUnsealPasswords of [undefined, []]) {
+      config = { name: "h3-sdd", password: PASSWORD_A, extraUnsealPasswords };
+      const unsealRes = await t.fetch("/unseal", { headers: { "x-sealed": sealed } });
+      const readRes = await t.fetch("/read", { headers: { Cookie: `h3-sdd=${sealed}` } });
+      results.push([await unsealRes.json(), (await readRes.json()).data]);
+    }
+    expect(results[0]).toEqual([{ error: "Bad hmac value" }, {}]);
+    expect(results[1]).toEqual(results[0]);
