+/**
+ * Try each password in order and return the first session that opens. Only a
+ * "Bad hmac value" moves on to the next password; any other error is about the
+ * seal itself (expired, malformed), so it is thrown without more derivations.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  allowLegacy: boolean,
+): Promise<Partial<Session>> {
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await unsealWithPassword(sealed, password, sealOptions, allowLegacy);
+      if (index > 0) {
+        (unsealed as any)[kExtraPasswordSeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (!isBadHmac(error) || index === passwords.length - 1) {
+        throw error;
+      }
+    }
+  }
+  // Unreachable: the last password either returns or throws above
+  throw new Error("Bad hmac value");
+}
+
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  allowLegacy: boolean,
+): Promise<Partial<Session>> {
+  let unsealed: Partial<Session>;
+  try {
+    unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (!allowLegacy || sealOptions.integrity.iterations === 1 || !isBadHmac(error)) {
+      throw error;
+    }
+    unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+  }
+  return unsealed;
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+/**
+ * Validate every extra password with the same rules as `password`. Run before
+ * any unseal attempt, so a bad entry throws even when `password` would match.
+ */
+function assertExtraPasswords(config: SessionConfig): void {
+  const minLength = (config.seal ?? sealDefaults).integrity.minPasswordlength;
+  for (const password of config.extraUnsealPasswords || []) {
+    assertPassword(password, minLength);
+  }
+}
