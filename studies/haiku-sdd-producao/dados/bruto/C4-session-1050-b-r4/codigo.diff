+/**
+ * Throws if an entry of `extraUnsealPasswords` is not a string of at least the
+ * seal's minimum password length. The message names the index, never the value.
+ */
+export function assertExtraUnsealPasswords(config: SessionConfig): void {
+  if (!config.extraUnsealPasswords) {
+    return;
+  }
+  const seal = { ...sealDefaults, ...config.seal };
+  const min = Math.max(seal.encryption.minPasswordlength, seal.integrity.minPasswordlength);
+  config.extraUnsealPasswords.forEach((password, index) => {
+    if (typeof password !== "string" || password.length < min) {
+      throw new Error(`extraUnsealPasswords[${index}] must be at least ${min} characters`);
+    }
+  });
+}
+
+/**
+ * Tries `config.password`, then each `config.extraUnsealPasswords` entry, in
+ * order. Only `Bad hmac value` moves on to the next password. Any other error
+ * is thrown at once, and the last HMAC error is thrown if every password fails.
+ * The legacy 1-iteration fallback applies to each password. A session opened
+ * with an extra password gets `kExtraUnsealSeal`; a legacy one gets `kLegacySeal`.
+ */
+export async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  const passwords = [config.password, ...(config.extraUnsealPasswords || [])];
+  let error: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await unsealWithFallback(sealed, password, config, sealOptions);
+      if (index > 0 && unsealed) {
+        (unsealed as any)[kExtraUnsealSeal] = true;
+      }
+      return unsealed;
+    } catch (err) {
+      if (!(err instanceof Error) || err.message !== "Bad hmac value") {
+        throw err;
+      }
+      error = err;
+    }
+  }
+  throw error;
+}
+
+async function unsealWithFallback(
+  sealed: string,
+  password: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
