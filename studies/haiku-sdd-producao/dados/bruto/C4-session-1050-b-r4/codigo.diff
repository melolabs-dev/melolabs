diff --git a/test/sdd-extra-unseal-passwords.test.ts b/test/sdd-extra-unseal-passwords.test.ts
new file mode 100644
index 0000000..6358b0d
--- /dev/null
+++ b/test/sdd-extra-unseal-passwords.test.ts
@@ -0,0 +1,240 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { describe, expect, it, vi } from "vitest";
+import { getSession, updateSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for `extraUnsealPasswords` (sdd/prd.md RF-01..RF-08, sdd/techspec.md)
+const OLD_A = "senha-antiga-com-32-caracteres-ou-mais-A";
+const CURRENT_B = "senha-atual-trocada-na-rotacao-B-00000";
+const OLDER_C = "outra-senha-antiga-usada-na-rotacao-C-99";
+const UNKNOWN_Z = "chave-desconhecida-nunca-configurada-Z-7";
+
+const sealWith = (password: string, session: object, ttl = 0) =>
+  seal(session, password, { ...sealDefaults, ttl });
+
+const cookieValue = (res: Response, name: string) => {
+  const setCookie = res.headers.getSetCookie().find((c) => c.startsWith(`${name}=`));
+  return setCookie ? decodeURIComponent(setCookie.match(/=([^;]+)/)![1]) : undefined;
+};
+
+const opens = (sealed: string, password: string) =>
+  unseal(sealed, password, sealDefaults).then(
+    () => true,
+    () => false,
+  );
+
+describeMatrix("sdd: extraUnsealPasswords", (t, { it, expect }) => {
+  const config = (extra?: string[]): SessionConfig => ({
+    name: "h3-extra",
+    password: CURRENT_B,
+    sessionHeader: "x-h3-session",
+    generateId: () => "new-id",
+    ...(extra ? { extraUnsealPasswords: extra } : {}),
+  });
+
+  const readRoute = (path: string, cfg: () => SessionConfig) => {
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, cfg());
+      return { id: session.id, data: session.data };
+    });
+  };
+
+  // RF-01, RF-02
+  it("opens a session sealed with an extra password and keeps its id and data", async () => {
+    const sealed = await sealWith(OLD_A, {
+      id: "old-1",
+      createdAt: Date.now(),
+      data: { foo: "bar" },
+    });
+    readRoute("/read", () => config([OLD_A]));
+    const res = await t.fetch("/read", { headers: { Cookie: `h3-extra=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { foo: "bar" } });
+  });
+
+  // RF-02 (custo): a cookie sealed with the current password costs no extra attempts
+  it("does not derive extra keys when the cookie opens with the current password", async () => {
+    const sealed = await sealWith(CURRENT_B, {
+      id: "cur-1",
+      createdAt: Date.now(),
+      data: {},
+    });
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      readRoute("/cost-plain", () => config());
+      readRoute("/cost-extra", () => config([OLD_A, OLDER_C]));
+
+      deriveBits.mockClear();
+      await t.fetch("/cost-plain", { headers: { Cookie: `h3-extra=${sealed}` } });
+      const plain = deriveBits.mock.calls.length;
+
+      deriveBits.mockClear();
+      const res = await t.fetch("/cost-extra", { headers: { Cookie: `h3-extra=${sealed}` } });
+      expect(await res.json()).toMatchObject({ id: "cur-1" });
+      expect(deriveBits.mock.calls.length).toBe(plain);
+    } finally {
+      deriveBits.mockRestore();
+    }
+  });
+
+  // RF-03
+  it("seals new cookies only with the current password", async () => {
+    t.app.get("/write", async (event) => {
+      await updateSession(event, config([OLD_A]), { user: "alice" });
+      return "ok";
+    });
+    const res = await t.fetch("/write");
+    const sealed = cookieValue(res, "h3-extra")!;
+    expect(sealed).toBeDefined();
+    expect(await opens(sealed, CURRENT_B)).toBe(true);
+    expect(await opens(sealed, OLD_A)).toBe(false);
+  });
+
+  // RF-04
+  it("treats a session sealed with another password as invalid without extra passwords", async () => {
+    const sealed = await sealWith(OLD_A, {
+      id: "old-1",
+      createdAt: Date.now(),
+      data: { foo: "bar" },
+    });
+    readRoute("/no-extra", () => config());
+    const res = await t.fetch("/no-extra", { headers: { Cookie: `h3-extra=${sealed}` } });
+    const body = await res.json();
+    expect(body.id).not.toBe("old-1");
+    expect(body.data).toEqual({});
+  });
+
+  // RF-05
+  it("opens a session sealed with an extra password sent in the session header", async () => {
+    const sealed = await sealWith(OLD_A, {
+      id: "old-1",
+      createdAt: Date.now(),
+      data: { foo: "bar" },
+    });
+    readRoute("/header", () => config([OLD_A]));
+    const res = await t.fetch("/header", { headers: { "x-h3-session": sealed } });
+    expect(await res.json()).toMatchObject({ id: "old-1", data: { foo: "bar" } });
+  });
+
+  // RF-06
+  it("expires a session opened with an extra password once maxAge has passed", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    try {
+      const sealed = await sealWith(OLD_A, {
+        id: "old-1",
+        createdAt: t0,
+        data: { foo: "bar" },
+      });
+      readRoute("/max-age", () => ({ ...config([OLD_A]), maxAge: 60 }));
+
+      vi.setSystemTime(t0 + 61_000);
+      const res = await t.fetch("/max-age", { headers: { Cookie: `h3-extra=${sealed}` } });
+      const body = await res.json();
+      expect(body.id).not.toBe("old-1");
+      expect(body.data).toEqual({});
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  // RF-07
+  it("reseals with the current password a cookie opened with an extra password", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    try {
+      const sealed = await sealWith(OLD_A, {
+        id: "old-1",
+        createdAt: t0,
+        data: { foo: "bar" },
+      });
+      readRoute("/slide", () => ({ ...config([OLD_A]), idleTimeout: 60 }));
+
+      // 31s used of a 60s idle window: past half, so the read reseals it
+      vi.setSystemTime(t0 + 31_000);
+      const res = await t.fetch("/slide", { headers: { Cookie: `h3-extra=${sealed}` } });
+      expect(await res.json()).toMatchObject({ id: "old-1" });
+
+      const resealed = cookieValue(res, "h3-extra");
+      expect(resealed).toBeDefined();
+      expect(await opens(resealed!, CURRENT_B)).toBe(true);
+      expect(await opens(resealed!, OLD_A)).toBe(false);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  // RF-08
+  it("throws a configuration error naming the index for a short extra password", async () => {
+    const sealed = await sealWith(CURRENT_B, {
+      id: "cur-1",
+      createdAt: Date.now(),
+      data: {},
+    });
+    t.app.get("/short", async (event) => {
+      try {
+        await getSession(event, config(["curta"]));
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    const res = await t.fetch("/short", { headers: { Cookie: `h3-extra=${sealed}` } });
+    const { error } = await res.json();
+    expect(error).toContain("extraUnsealPasswords[0]");
+    expect(error).not.toContain("curta");
+  });
+
+  // D-02 / D-07: an expired seal is rejected before HMAC, so no attempt costs a derivation
+  it("does not try extra passwords on a cookie whose seal has expired", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      const sealed = await sealWith(OLD_A, { id: "old-1", createdAt: t0, data: {} }, 60_000);
+      readRoute("/expired-seal", () => ({ ...config([OLD_A, OLDER_C]), maxAge: 60 }));
+
+      vi.setSystemTime(t0 + 120_000);
+      deriveBits.mockClear();
+      const res = await t.fetch("/expired-seal", {
+        headers: { Cookie: `h3-extra=${sealed}` },
+      });
+      expect(await res.json()).not.toMatchObject({ id: "old-1" });
+      expect(deriveBits).not.toHaveBeenCalled();
+    } finally {
+      deriveBits.mockRestore();
+      vi.useRealTimers();
+    }
+  });
+
+  // Cost of a forged cookie: each password costs the same, so the total scales with the list
+  it("tries each password once for a forged cookie, without throwing", async () => {
+    const forged = await sealWith(UNKNOWN_Z, { id: "forged", createdAt: Date.now(), data: {} });
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      readRoute("/forged-plain", () => config());
+      readRoute("/forged-extra", () => config([OLD_A, OLDER_C]));
+
+      deriveBits.mockClear();
+      await t.fetch("/forged-plain", { headers: { Cookie: `h3-extra=${forged}` } });
+      const onePassword = deriveBits.mock.calls.length;
+
+      deriveBits.mockClear();
+      const res = await t.fetch("/forged-extra", { headers: { Cookie: `h3-extra=${forged}` } });
+      const body = await res.json();
+      expect(body.id).not.toBe("forged");
+      expect(body.data).toEqual({});
+      expect(deriveBits.mock.calls.length).toBe(onePassword * 3);
+    } finally {
+      deriveBits.mockRestore();
+    }
+  });
+});
+
+describe("sdd: extraUnsealPasswords types", () => {
+  // RF-01: this compiles only once SessionConfig has `extraUnsealPasswords`
+  it("accepts extraUnsealPasswords in SessionConfig", () => {
+    const cfg: SessionConfig = { password: CURRENT_B, extraUnsealPasswords: [OLD_A] };
+    expect(cfg.extraUnsealPasswords).toEqual([OLD_A]);
+  });
+});
