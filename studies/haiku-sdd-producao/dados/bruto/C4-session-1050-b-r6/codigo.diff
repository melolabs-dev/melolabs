+
+/**
+ * Try `unseal` with each password in order and return the first that opens the
+ * seal, with its index in `passwords`. When none does, throw the error from the
+ * first password, so that without extra passwords the error is the same as before.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  options: SealOptions,
+): Promise<{ unsealed: Partial<Session>; index: number }> {
+  let firstError: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = (await unseal(sealed, password, options)) as Partial<Session>;
+      return { unsealed, index };
+    } catch (error) {
+      firstError ??= error;
+    }
+  }
+  throw firstError;
+}
diff --git a/test/sdd-extra-unseal-passwords.test.ts b/test/sdd-extra-unseal-passwords.test.ts
new file mode 100644
index 0000000..fa47ecd
--- /dev/null
+++ b/test/sdd-extra-unseal-passwords.test.ts
@@ -0,0 +1,231 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { expectTypeOf, it as baseIt, vi } from "vitest";
+import { getSession, readBody, unsealSession, updateSession, useSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const PASSWORD_A = "a".repeat(49);
+const PASSWORD_B = "b".repeat(49);
+const PASSWORD_C = "c".repeat(49);
+const NAME = "h3-sdd";
+const LEGACY_OPTIONS = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const sealWith = (password: string, data: Record<string, unknown> = {}) =>
+  seal({ id: "sealed", createdAt: Date.now(), data }, password, sealDefaults);
+
+const sealLegacyWith = (password: string, data: Record<string, unknown> = {}) =>
+  seal({ id: "sealed", createdAt: Date.now(), data }, password, LEGACY_OPTIONS);
+
+const sealedFrom = (setCookie: string) => decodeURIComponent(setCookie.match(/=([^;]+)/)![1]);
+
+const cookieOf = (res: Response) =>
+  res.headers.getSetCookie().find((c) => c.startsWith(`${NAME}=`));
+
+baseIt("types extraUnsealPasswords as an optional string array (RF-01)", () => {
+  expectTypeOf<SessionConfig["extraUnsealPasswords"]>().toEqualTypeOf<string[] | undefined>();
+  expectTypeOf<SessionConfig["password"]>().toEqualTypeOf<string>();
+});
+
+describeMatrix("session extra unseal passwords", (t, { it, expect }) => {
+  const config: SessionConfig = {
+    name: NAME,
+    password: PASSWORD_A,
+    extraUnsealPasswords: [PASSWORD_B],
+  };
+
+  const readRoute = (path: string, cfg: SessionConfig) =>
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+
+  it("opens a session sealed with an extra password and reseals it with password (RF-02, RF-07)", async () => {
+    readRoute("/read", config);
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    const res = await t.fetch("/read", { headers: { Cookie: `${NAME}=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "sealed", data: { user: "bob" } });
+
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    const resealed = sealedFrom(setCookies[0]);
+    expect(await unseal(resealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "sealed",
+      data: { user: "bob" },
+    });
+    await expect(unseal(resealed, PASSWORD_B, sealDefaults)).rejects.toThrow();
+
+    // The resealed cookie is read with `password` alone, without another reseal
+    const next = await t.fetch("/read", { headers: { Cookie: setCookies[0].split(";")[0] } });
+    expect(await next.json()).toMatchObject({ id: "sealed", data: { user: "bob" } });
+    expect(next.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("tries password first, then extra passwords in order (RF-02)", async () => {
+    readRoute("/order", { ...config, extraUnsealPasswords: [PASSWORD_B, PASSWORD_C] });
+    const sealedWithB = await sealWith(PASSWORD_B, { from: "b" });
+    const sealedWithC = await sealWith(PASSWORD_C, { from: "c" });
+
+    const resB = await t.fetch("/order", { headers: { Cookie: `${NAME}=${sealedWithB}` } });
+    expect(await resB.json()).toMatchObject({ id: "sealed", data: { from: "b" } });
+
+    const resC = await t.fetch("/order", { headers: { Cookie: `${NAME}=${sealedWithC}` } });
+    expect(await resC.json()).toMatchObject({ id: "sealed", data: { from: "c" } });
+  });
+
+  it("seals new and updated sessions only with password (RF-03)", async () => {
+    t.app.post("/write", async (event) => {
+      const session = await updateSession(event, config, (await readBody(event)) as any);
+      return { id: session.id, data: session.data };
+    });
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    const res = await t.fetch("/write", {
+      method: "POST",
+      headers: { Cookie: `${NAME}=${sealed}` },
+      body: JSON.stringify({ n: 1 }),
+    });
+    expect(await res.json()).toMatchObject({ id: "sealed", data: { user: "bob", n: 1 } });
+
+    const resealed = sealedFrom(cookieOf(res)!);
+    expect(await unseal(resealed, PASSWORD_A, sealDefaults)).toMatchObject({
+      data: { user: "bob", n: 1 },
+    });
+    await expect(unseal(resealed, PASSWORD_B, sealDefaults)).rejects.toThrow();
+  });
+
+  it("behaves as before when there are no extra passwords or the list is empty (RF-04)", async () => {
+    readRoute("/plain", { name: NAME, password: PASSWORD_A });
+    readRoute("/empty", { name: NAME, password: PASSWORD_A, extraUnsealPasswords: [] });
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    for (const path of ["/plain", "/empty"]) {
+      const res = await t.fetch(path, { headers: { Cookie: `${NAME}=${sealed}` } });
+      const body = await res.json();
+      expect(body.id).not.toBe("sealed");
+      expect(body.data).toEqual({});
+      expect(res.headers.getSetCookie()).toHaveLength(0);
+    }
+  });
+
+  it("starts a new session and does not leak passwords when no password opens the seal (RF-05)", async () => {
+    readRoute("/none", config);
+    const sealed = await sealWith(PASSWORD_C, { user: "eve" });
+
+    const res = await t.fetch("/none", { headers: { Cookie: `${NAME}=${sealed}` } });
+    const text = await res.text();
+    const body = JSON.parse(text);
+    expect(body.id).not.toBe("sealed");
+    expect(body.data).toEqual({});
+    expect(text).not.toContain("eve");
+    expect(text).not.toContain(PASSWORD_A);
+    expect(text).not.toContain(PASSWORD_B);
+    expect(text).not.toContain(PASSWORD_C);
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("skips an invalid extra password and still opens with the next one (RF-06)", async () => {
+    readRoute("/short", { ...config, extraUnsealPasswords: ["curta", PASSWORD_B] });
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    const res = await t.fetch("/short", { headers: { Cookie: `${NAME}=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "sealed", data: { user: "bob" } });
+  });
+
+  it("opens a legacy session sealed with an extra password and migrates it to password (RF-08)", async () => {
+    readRoute("/legacy", config);
+    const sealed = await sealLegacyWith(PASSWORD_B, { user: "legacy" });
+
+    const res = await t.fetch("/legacy", { headers: { Cookie: `${NAME}=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "sealed", data: { user: "legacy" } });
+
+    const setCookies = res.headers.getSetCookie();
+    expect(setCookies).toHaveLength(1);
+    expect(await unseal(sealedFrom(setCookies[0]), PASSWORD_A, sealDefaults)).toMatchObject({
+      id: "sealed",
+      data: { user: "legacy" },
+    });
+
+    const next = await t.fetch("/legacy", { headers: { Cookie: setCookies[0].split(";")[0] } });
+    expect(await next.json()).toMatchObject({ id: "sealed", data: { user: "legacy" } });
+    expect(next.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("does not run the legacy path for a current session sealed with an extra password (cost)", async () => {
+    readRoute("/cost", config);
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      const res = await t.fetch("/cost", { headers: { Cookie: `${NAME}=${sealed}` } });
+      expect(await res.json()).toMatchObject({ id: "sealed" });
+      expect(deriveBits.mock.calls.length).toBeGreaterThan(0);
+      for (const [params] of deriveBits.mock.calls) {
+        expect((params as Pbkdf2Params).iterations).not.toBe(1);
+      }
+    } finally {
+      deriveBits.mockRestore();
+    }
+  });
+
+  it("opens a header-carried session sealed with an extra password without resealing it (D-05)", async () => {
+    readRoute("/header", config);
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    const res = await t.fetch("/header", { headers: { "x-h3-sdd-session": sealed } });
+    expect(await res.json()).toMatchObject({ id: "sealed", data: { user: "bob" } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("still expires sessions by maxAge when they are opened with an extra password", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    try {
+      readRoute("/expiry", { ...config, maxAge: 60 });
+      const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+      vi.setSystemTime(t0 + 30_000);
+      const res1 = await t.fetch("/expiry", { headers: { Cookie: `${NAME}=${sealed}` } });
+      expect((await res1.json()).id).toBe("sealed");
+
+      vi.setSystemTime(t0 + 61_000);
+      const res2 = await t.fetch("/expiry", { headers: { Cookie: `${NAME}=${sealed}` } });
+      expect((await res2.json()).id).not.toBe("sealed");
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("returns session data from unsealSession without exposing the internal marker (R-08)", async () => {
+    t.app.post("/unseal", async (event) => {
+      const body = (await readBody(event)) as { sealed: string };
+      const unsealed = await unsealSession(event, config, body.sealed);
+      return { id: unsealed.id, keys: Object.keys(unsealed), json: JSON.stringify(unsealed) };
+    });
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    const res = await t.fetch("/unseal", {
+      method: "POST",
+      body: JSON.stringify({ sealed }),
+    });
+    const body = await res.json();
+    expect(body.id).toBe("sealed");
+    expect([...body.keys].sort()).toEqual(["createdAt", "data", "id"]);
+    expect(body.json).not.toContain("extra");
+  });
+
+  it("keeps useSession returning a usable session when opened with an extra password", async () => {
+    t.app.get("/use", async (event) => {
+      const session = await useSession(event, config);
+      return { id: session.id, data: session.data };
+    });
+    const sealed = await sealWith(PASSWORD_B, { user: "bob" });
+
+    const res = await t.fetch("/use", { headers: { Cookie: `${NAME}=${sealed}` } });
+    expect(await res.json()).toMatchObject({ id: "sealed", data: { user: "bob" } });
+    expect(cookieOf(res)).toBeDefined();
+  });
+});
