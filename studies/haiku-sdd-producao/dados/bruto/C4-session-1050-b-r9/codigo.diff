+/** Result of trying each candidate password against one sealed string. */
+type OpenedSeal = { unsealed: Partial<Session>; index: number; legacy: boolean };
+
+/**
+ * Tries `passwords` in order at the current PBKDF2 iterations, then (if allowed)
+ * again at the legacy count. Throws the first error when none opens.
+ */
+async function openSeal(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+  legacyAllowed: boolean,
+): Promise<OpenedSeal> {
+  const errors: unknown[] = [];
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+      return { unsealed, index, legacy: false };
+    } catch (error) {
+      errors.push(error);
+    }
+  }
+  // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+  // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+  // Sessions sealed before the default PBKDF2 iterations were raised from 1
+  // to 8192 fail HMAC verification; retry with the legacy count so existing
+  // sessions survive the upgrade (getSession reseals them with the current
+  // options).
+  const legacyOptions = {
+    ...sealOptions,
+    encryption: { ...sealOptions.encryption, iterations: 1 },
+    integrity: { ...sealOptions.integrity, iterations: 1 },
+  };
+  const hmacFailed = errors.some(
+    (error) => error instanceof Error && error.message === "Bad hmac value",
+  );
+  if (legacyAllowed && hmacFailed) {
+    for (const [index, password] of passwords.entries()) {
+      try {
+        const unsealed = (await unseal(sealed, password, legacyOptions)) as Partial<Session>;
+        return { unsealed, index, legacy: true };
+      } catch {
+        // Keep trying the other passwords; the first error is reported below
+      }
+    }
+  }
+  throw errors[0];
+}
