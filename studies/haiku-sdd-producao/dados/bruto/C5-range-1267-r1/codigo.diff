+    const res = await t.fetch("/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-9" },
+    });
+    expect(await res.text()).toBe("ABCDEFGHIJ");
+  });
+
+  it("does not serve a range for a missing asset", async () => {
+    const res = await t.fetch("/missing.txt", { headers: { range: "bytes=0-3" } });
+    expect(res.status).toBe(404);
+  });
+
+  it("responds 405 with Allow to POST with a range", async () => {
+    const res = await t.fetch("/test.txt", {
+      method: "POST",
+      headers: { range: "bytes=2-5" },
+    });
+    expect(res.status).toBe(405);
+  });
+
+  it("keeps a user content-length header out of a 206 response", async () => {
+    t.app.all("/headers/**", (event) =>
+      serveStatic(event, {
+        getMeta: () => ({ type: "text/plain", size: 10 }),
+        getContents: () => text,
+        headers: { "content-length": "999" },
+      }),
+    );
+    const res = await t.fetch("/headers/test.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("2345");
+  });
+
+  it("keeps a user content-length header on a full response", async () => {
+    t.app.all("/headers/**", (event) =>
+      serveStatic(event, {
+        getMeta: () => ({ type: "text/plain", size: 10 }),
+        getContents: () => text,
+        headers: { "content-length": "999" },
+      }),
+    );
+    const res = await t.fetch("/headers/test.txt", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-length")).toBe("999");
+  });
+
+  const bodies: Record<string, () => BodyInit> = {
+    string: () => text,
+    ArrayBuffer: () => new TextEncoder().encode(text).buffer,
