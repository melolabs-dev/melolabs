+
+type ByteRange = { start: number; end: number };
+
+/** `undefined` ignores the `Range`, `"unsatisfiable"` gives 416, and anything else is a 206 slice. */
+type RangeOutcome = ByteRange | "unsatisfiable" | undefined;
+
+// A single `bytes` range, with no commas, so multi-range and other units never match.
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Resolve a `Range` header of one `bytes` range against a known size (RFC 9110 sections 14.1 and 14.2).
+ *
+ * Syntax errors and reversed ranges are ignored, while a range that starts past the end
+ * of the file, or a zero-length suffix, is unsatisfiable. The end is clamped to the file,
+ * and a suffix longer than the file covers the whole file.
+ */
+function parseRange(value: string, size: number): RangeOutcome {
+  const match = RANGE_RE.exec(value.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "") {
+    if (last === "") {
+      return undefined;
+    }
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: last === "" ? size - 1 : Math.min(Number(last), size - 1) };
+}
+
+/**
+ * Check `If-Range` (RFC 9110 section 13.1.5): a quoted ETag must equal the current one exactly,
+ * and a date must equal `last-modified` to the second. A weak ETag never starts with `"`, so
+ * exact equality with a quoted value already implies a strong match.
+ */
+function ifRangeMatches(ifRange: string, validators: { etag?: string; mtime?: Date }): boolean {
+  if (ifRange.startsWith('"')) {
+    return ifRange === validators.etag;
+  }
+  return (
+    validators.mtime !== undefined && new Date(ifRange).getTime() === validators.mtime.getTime()
+  );
+}
+
+/** Cut `contents` down to the bytes from `start` to `end` (inclusive) without reading more than needed. */
+function sliceBody(contents: BodyInit, start: number, end: number): BodyInit | Promise<BodyInit> {
+  if (typeof contents === "string") {
+    return new TextEncoder().encode(contents).subarray(start, end + 1);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return contents.slice(start, end + 1);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset + start, end - start + 1);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  if (contents instanceof ReadableStream) {
+    let skip = start;
+    let remaining = end - start + 1;
+    return contents.pipeThrough(
+      new TransformStream<Uint8Array, Uint8Array>({
+        transform(chunk, controller) {
+          let bytes = chunk;
+          if (skip > 0) {
+            const dropped = Math.min(skip, bytes.byteLength);
+            bytes = bytes.subarray(dropped);
+            skip -= dropped;
+          }
+          const kept = bytes.subarray(0, remaining);
+          remaining -= kept.byteLength;
+          if (kept.byteLength > 0) {
+            controller.enqueue(kept);
+          }
+          // Terminating errors the writable side, which cancels the upstream source.
+          if (remaining <= 0) {
+            controller.terminate();
+          }
+        },
+      }),
+    );
+  }
+  // Other body types (FormData, URLSearchParams) have no byte view, so buffer them once.
+  return new Response(contents).arrayBuffer().then((buffer) => buffer.slice(start, end + 1));
+}
