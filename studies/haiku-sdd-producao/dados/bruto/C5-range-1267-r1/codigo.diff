+import { beforeEach, vi, type Mock } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import type { StaticAssetMeta } from "../src/utils/static.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for HTTP Range support in `serveStatic` (sdd/prd.md RF-01 to RF-10, sdd/techspec.md).
+
+const text = "0123456789";
+const gzipped = Array.from({ length: 50 }, (_, i) => String.fromCharCode(65 + i)).join("");
+const mtime = 1_700_000_000_000;
+
+const files: Record<string, { contents: string; meta: StaticAssetMeta }> = {
+  "/test.txt": { contents: text, meta: { type: "text/plain", etag: '"v1"', mtime, size: 10 } },
+  "/nosize.txt": { contents: text, meta: { type: "text/plain", etag: '"v1"', mtime } },
+  "/empty.txt": { contents: "", meta: { type: "text/plain", size: 0 } },
+  "/weak.txt": { contents: text, meta: { type: "text/plain", etag: 'W/"v1"', mtime, size: 10 } },
+  "/app.js.gz": {
+    contents: gzipped,
+    meta: { type: "text/javascript", encoding: "gzip", etag: '"gz1"', size: 50 },
+  },
+};
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let getContents: Mock<(id: string) => string | undefined>;
+
+  beforeEach(() => {
+    getContents = vi.fn((id: string) => files[id]?.contents);
+    const options: ServeStaticOptions = {
+      getMeta: (id) => files[id]?.meta,
+      getContents,
+      encodings: { gzip: ".gz" },
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+  });
+
+  it("advertises byte ranges on a full 200 response", async () => {
+    const res = await t.fetch("/test.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe(text);
+  });
+
+  it("advertises byte ranges on a 304 response", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { "if-none-match": '"v1"', range: "bytes=0-3" },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds 206 with the requested bytes", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=2-5" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("2345");
+  });
+
+  it("responds 206 for a suffix range", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=-3" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 7-9/10");
+    expect(res.headers.get("content-length")).toBe("3");
+    expect(await res.text()).toBe("789");
+  });
+
+  it("responds 206 for an open-ended range", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=7-" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 7-9/10");
+    expect(await res.text()).toBe("789");
+  });
+
+  it("clamps an end past the end of the file", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=6-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 6-9/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("6789");
+  });
+
+  it("responds 206 with the whole file for a suffix longer than the file", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/10");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe(text);
+  });
+
+  it("ignores a multi-range header and serves the full file", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=0-1,4-5" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe(text);
+  });
+
+  for (const range of ["items=0-1", "bytes=abc", "bytes=5-2", "bytes=-"]) {
+    it(`ignores malformed range ${JSON.stringify(range)} and serves the full file`, async () => {
+      const res = await t.fetch("/test.txt", { headers: { range } });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(await res.text()).toBe(text);
+    });
+  }
+
+  it("responds 416 when the range starts past the end of the file", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=10-20" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */10");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds 416 for a zero-length suffix range", async () => {
+    const res = await t.fetch("/test.txt", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */10");
+    expect(res.headers.get("content-length")).toBe("0");
+  });
+
+  it("responds to HEAD with 206 headers and no body", async () => {
+    const res = await t.fetch("/test.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=2-5" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 2-5/10");
+    expect(res.headers.get("content-length")).toBe("4");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("responds to HEAD with 416 without reading the file", async () => {
+    const res = await t.fetch("/test.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=10-20" },
+    });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */10");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("ignores the range when the size is unknown", async () => {
+    const res = await t.fetch("/nosize.txt", { headers: { range: "bytes=0-3" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(text);
+  });
+
+  it("ignores the range when the size is zero", async () => {
+    const res = await t.fetch("/empty.txt", { headers: { range: "bytes=0-3" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  it("applies the range when If-Range matches the ETag", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-3", "if-range": '"v1"' },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("0123");
+  });
+
+  it("ignores the range when If-Range does not match the ETag", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-3", "if-range": '"v2"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(text);
+  });
+
+  it("applies the range when If-Range matches Last-Modified", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-3", "if-range": new Date(mtime).toUTCString() },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe("0123");
+  });
+
+  it("ignores the range when If-Range has a different date", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-3", "if-range": new Date(mtime - 60_000).toUTCString() },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("ignores the range when If-Range has sub-second precision", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { range: "bytes=0-3", "if-range": new Date(mtime + 500).toISOString() },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("ignores the range when the ETag is weak", async () => {
+    const res = await t.fetch("/weak.txt", {
+      headers: { range: "bytes=0-3", "if-range": 'W/"v1"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("serves the full file when If-Range is sent without Range", async () => {
+    const res = await t.fetch("/test.txt", { headers: { "if-range": '"v1"' } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(text);
+  });
+
+  it("gives precedence to a 304 over the range", async () => {
+    const res = await t.fetch("/test.txt", {
+      headers: { "if-none-match": '"v1"', range: "bytes=0-3" },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  it("applies the range to the precompressed variant headers", async () => {
+    const res = await t.fetch("/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/50");
+    expect(res.headers.get("content-length")).toBe("10");
+    await res.body?.cancel();
+  });
+
