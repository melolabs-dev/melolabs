+
+/** Inclusive byte range, already clamped to `[0, size - 1]`. */
+type ByteRange = { start: number; end: number };
+
+// Single `bytes` range only (RFC 9110 section 14.1.1). Multi-range and other units never match.
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Resolve a `Range` header against the asset size.
+ *
+ * Returns the range to serve, `"unsatisfiable"` when a valid range lies outside
+ * the asset (416), or `undefined` when the header is ignored (full 200). An
+ * empty asset has no byte to satisfy any range, so it is always unsatisfiable.
+ */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+
+  if (first === "") {
+    // Suffix range `bytes=-n`: the last `n` bytes.
+    const n = Number(last);
+    if (n === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - n, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: last === "" ? size - 1 : Math.min(Number(last), size - 1) };
+}
+
+/**
+ * `true` when `If-Range` is absent or matches the current validators (RFC 9110
+ * section 13.1.5). The comparison is strong: weak ETags never match.
+ */
+function matchesIfRange(
+  value: string | null,
+  etag: string | undefined,
+  mtime: Date | undefined,
+): boolean {
+  if (value === null) {
+    return true;
+  }
+  if (value.startsWith("W/")) {
+    return false;
+  }
+  if (value.startsWith('"')) {
+    return etag !== undefined && !etag.startsWith("W/") && value === etag;
+  }
+  const date = Date.parse(value);
+  return mtime !== undefined && !Number.isNaN(date) && date === mtime.getTime();
+}
+
+/**
+ * Cut the body down to `range`. A `Blob` is sliced lazily. Other body types are
+ * read in full before slicing, so a range request on them buffers the whole asset.
+ */
+async function sliceContents(
+  contents: BodyInit | null | undefined,
+  range: ByteRange,
+): Promise<Blob | ArrayBuffer> {
+  const end = range.end + 1;
+  if (contents instanceof Blob) {
+    return contents.slice(range.start, end);
+  }
+  const buffer = await new Response(contents || null).arrayBuffer();
+  return buffer.slice(range.start, end);
+}
diff --git a/test/sdd-static-range.test.ts b/test/sdd-static-range.test.ts
new file mode 100644
index 0000000..6e9468c
--- /dev/null
+++ b/test/sdd-static-range.test.ts
@@ -0,0 +1,249 @@
+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// 1000 bytes with predictable content: byte `i` is `String(i % 10)`.
+const BODY = "0123456789".repeat(100);
+const MTIME = 1_700_000_000_000;
+const LAST_MODIFIED = new Date(MTIME).toUTCString();
+
+function assetOptions(overrides: Partial<ServeStaticOptions> = {}): ServeStaticOptions {
+  return {
+    getMeta: (id) =>
+      id.includes("404")
+        ? undefined
+        : { type: "text/plain", etag: '"v2"', mtime: MTIME, size: BODY.length },
+    getContents: (id) => (id.includes("404") ? undefined : BODY),
+    ...overrides,
+  };
+}
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  beforeEach(() => {
+    t.app.all("/asset/**", (event) => serveStatic(event, assetOptions()));
+    t.app.all("/blob/**", (event) =>
+      serveStatic(
+        event,
+        assetOptions({ getContents: () => new Blob([BODY], { type: "text/plain" }) }),
+      ),
+    );
+    t.app.all("/empty/**", (event) =>
+      serveStatic(
+        event,
+        assetOptions({
+          getMeta: () => ({ type: "text/plain", etag: '"v2"', mtime: MTIME, size: 0 }),
+          getContents: () => "",
+        }),
+      ),
+    );
+    t.app.all("/headers/**", (event) =>
+      serveStatic(event, assetOptions({ headers: { "content-length": "999" } })),
+    );
+  });
+
+  // RF-01
+  it("announces byte ranges on GET without a Range header", async () => {
+    const res = await t.fetch("/asset/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("announces byte ranges on HEAD without a Range header", async () => {
+    const res = await t.fetch("/asset/file.txt", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-02
+  it("serves a bounded range with 206 (bytes=0-99)", async () => {
+    const res = await t.fetch("/asset/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("serves a suffix range with 206 (bytes=-50)", async () => {
+    const res = await t.fetch("/asset/file.txt", { headers: { range: "bytes=-50" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 950-999/1000");
+    expect(res.headers.get("content-length")).toBe("50");
+    expect(await res.text()).toBe(BODY.slice(950));
+  });
+
+  it("serves an open-ended range with 206 (bytes=990-)", async () => {
+    const res = await t.fetch("/asset/file.txt", { headers: { range: "bytes=990-" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 990-999/1000");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe(BODY.slice(990));
+  });
+
+  it("clamps the end of a range to the last byte (bytes=990-2000)", async () => {
+    const res = await t.fetch("/asset/file.txt", { headers: { range: "bytes=990-2000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 990-999/1000");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe(BODY.slice(990));
+  });
+
+  it("serves a Blob body with the same range result", async () => {
+    const res = await t.fetch("/blob/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("overrides a user content-length header on 206", async () => {
+    const res = await t.fetch("/headers/file.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  // RF-03
+  it("returns headers and no body for HEAD with a valid range, without reading contents", async () => {
+    const getContents = vi.fn(() => BODY);
+    t.app.all("/spy/**", (event) => serveStatic(event, assetOptions({ getContents })));
+    const res = await t.fetch("/spy/file.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=500-" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 500-999/1000");
+    expect(res.headers.get("content-length")).toBe("500");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  // RF-04
+  it("ignores malformed, other-unit and multi-range headers with a full 200", async () => {
+    for (const range of ["bytes=0-10,20-30", "items=0-10", "bytes=abc", "bytes=5-2", "bytes=-"]) {
+      const res = await t.fetch("/asset/file.txt", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(await res.text(), range).toBe(BODY);
+    }
+  });
+
+  // RF-05
+  it("returns 416 for a range that starts past the end", async () => {
+    const res = await t.fetch("/asset/file.txt", { headers: { range: "bytes=1000-1010" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+    // 416 carries no representation headers.
+    expect(res.headers.get("content-type")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  it("returns 416 for a zero-length suffix (bytes=-0)", async () => {
+    const res = await t.fetch("/asset/file.txt", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(await res.text()).toBe("");
+  });
+
+  it("returns 416 for any range on an empty asset", async () => {
+    const res = await t.fetch("/empty/file.txt", { headers: { range: "bytes=0-" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-06
+  it("ignores Range when If-Range is a stale ETag", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": '"v1"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("applies Range when If-Range matches the current ETag", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": '"v2"' },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("ignores Range when If-Range is a weak ETag", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": 'W/"v2"' },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(BODY);
+  });
+
+  it("applies Range when If-Range matches Last-Modified", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      headers: { range: "bytes=0-99", "if-range": LAST_MODIFIED },
+    });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(BODY.slice(0, 100));
+  });
+
+  it("ignores Range when If-Range is a different date", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      headers: {
+        range: "bytes=0-99",
+        "if-range": new Date(MTIME + 60_000).toUTCString(),
+      },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(BODY);
+  });
+
+  // RF-07
+  it("keeps the 304 for a matching If-None-Match even with Range", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      headers: { range: "bytes=0-99", "if-none-match": '"v2"' },
+    });
+    expect(res.status).toBe(304);
+    expect(await res.text()).toBe("");
+  });
+
+  it("keeps 405 for POST with Range", async () => {
+    const res = await t.fetch("/asset/file.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(405);
+  });
+
+  it("keeps 404 for a missing asset with Range", async () => {
+    const res = await t.fetch("/asset/404.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(404);
+  });
+});
+
+describeMatrix("serve static range with fallthrough", (t, { it, expect }) => {
+  beforeEach(() => {
+    t.app.use((event) => serveStatic(event, assetOptions({ fallthrough: true })));
+    t.app.use(() => ({ fallthroughTest: "passing" }));
+  });
+
+  it("falls through for POST with Range", async () => {
+    const res = await t.fetch("/file.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ fallthroughTest: "passing" });
+  });
+
+  it("falls through for a missing asset with Range", async () => {
+    const res = await t.fetch("/404.txt", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ fallthroughTest: "passing" });
+  });
+});
