+  // Mounts serveStatic on every path. Call once per test.
+  function serve(overrides: Partial<ServeStaticOptions> = {}) {
+    const options: ServeStaticOptions = {
+      getContents: () => BODY,
+      getMeta: (id) => (id === "/file.txt" ? META : undefined),
+      encodings: { gzip: ".gz" },
+      ...overrides,
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+  }
+
+  // `accept-encoding: identity` keeps the default variant selection stable across runtimes.
+  function get(path: string, headers: Record<string, string> = {}) {
+    return t.fetch(path, {
+      headers: { "accept-encoding": "identity", ...headers },
+    });
+  }
+
+  function head(path: string, headers: Record<string, string> = {}) {
+    return t.fetch(path, {
+      method: "HEAD",
+      headers: { "accept-encoding": "identity", ...headers },
+    });
+  }
+
