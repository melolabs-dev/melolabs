+// Acceptance tests for sdd/prd.md (RF-01 to RF-10) and sdd/techspec.md (D-01 to D-08).
+
+const BODY = "0123456789";
+const META: StaticAssetMeta = {
+  type: "text/plain",
+  etag: '"abc"',
+  // Sub-second part on purpose: `last-modified` and If-Range dates must use whole seconds.
+  mtime: 1_700_000_000_123,
+  size: 10,
+};
+const LAST_MODIFIED = new Date(1_700_000_000_000).toUTCString();
