+    it("advertises accept-ranges on GET without Range", async () => {
+      serve();
+      const res = await get("/file.txt");
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+    });
+
+    it("advertises accept-ranges on GET with Range", async () => {
+      serve();
+      const res = await get("/file.txt", { range: "bytes=2-5" });
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+    });
+
+    it("advertises accept-ranges on HEAD", async () => {
+      serve();
+      const res = await head("/file.txt");
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+    });
+
+    it("omits accept-ranges when size is unknown", async () => {
+      serve({ getMeta: () => ({ type: "text/plain" }) });
+      const res = await get("/file.txt", { range: "bytes=2-5" });
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBeNull();
+    });
+
+    it("omits accept-ranges when size is 0", async () => {
+      serve({ getMeta: () => ({ type: "text/plain", size: 0 }) });
+      const res = await get("/file.txt");
+      expect(res.headers.get("accept-ranges")).toBeNull();
+    });
+  });
+
+  describe("RF-02: 206 for a satisfiable range", () => {
+    it("serves bytes=2-5 as 206 with content-range, content-length and the slice", async () => {
+      serve();
