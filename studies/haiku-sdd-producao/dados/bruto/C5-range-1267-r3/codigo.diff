+/** A requested range, before the asset size is applied. */
+type RangeRequest = { start: number; end?: number } | { suffix: number };
+
+/** A resolved range. `end` is inclusive and never past `size - 1`. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/**
+ * Validate the syntax of a single `bytes` range (RFC 9110 section 14.1.1). Malformed
+ * and multiple ranges return `undefined`, and the `Range` header is then ignored.
+ * The unit name is case-insensitive (section 14.1).
+ */
+function parseRange(header: string): RangeRequest | undefined {
+  const match = /^bytes=(?:(\d+)-(\d*)|-(\d+))$/i.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, first, last, suffix] = match;
+  if (suffix !== undefined) {
+    return { suffix: Number(suffix) };
+  }
+  const start = Number(first);
+  if (last === "") {
+    return { start };
+  }
+  return Number(last) < start ? undefined : { start, end: Number(last) };
+}
+
+/**
+ * Apply the asset size to a parsed range. Returns `undefined` when the range cannot be
+ * satisfied, which is a 416 (RFC 9110 section 15.5.17).
+ */
+function resolveRange(request: RangeRequest, size: number): ByteRange | undefined {
+  if ("suffix" in request) {
+    return request.suffix > 0
+      ? { start: Math.max(0, size - request.suffix), end: size - 1 }
+      : undefined;
+  }
+  if (request.start >= size) {
+    return undefined;
+  }
+  return { start: request.start, end: Math.min(request.end ?? size - 1, size - 1) };
+}
+
+/**
+ * Evaluate `If-Range` (RFC 9110 section 13.1.5). An ETag must be strong and equal to the
+ * current one. A date must match the whole-second `Last-Modified` exactly. Without
+ * `If-Range` the range applies.
+ */
+function matchesIfRange(ifRange: string | null, meta: StaticAssetMeta, mtime?: Date): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  if (ifRange.startsWith("W/")) {
+    return false;
+  }
+  if (ifRange.startsWith('"')) {
+    return !!meta.etag && !meta.etag.startsWith("W/") && ifRange === meta.etag;
+  }
+  return !!mtime && ifRange === mtime.toUTCString();
+}
+
+/**
+ * Slice a body to an inclusive byte range. Direct body types are sliced in place. Other
+ * types are read and their leading bytes dropped, because `getContents` does not receive
+ * the range (sdd/prd.md, risk R1).
+ */
+function sliceBody(contents: BodyInit, { start, end }: ByteRange): BodyInit {
+  if (typeof contents === "string") {
+    return new TextEncoder().encode(contents).subarray(start, end + 1);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return new Uint8Array(contents, start, end - start + 1);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset + start, end - start + 1);
+  }
+  return sliceStream(new Response(contents).body!, start, end);
+}
+
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let position = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const { done, value } = await reader.read();
+      if (done) {
+        controller.close();
+        return;
+      }
+      const chunkStart = position;
+      position += value.byteLength;
+      if (position > start) {
+        controller.enqueue(value.subarray(Math.max(0, start - chunkStart), end + 1 - chunkStart));
+      }
+      if (position > end) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
