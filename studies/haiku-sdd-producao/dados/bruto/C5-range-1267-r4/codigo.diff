+/** Result of evaluating `Range`. `kind: "none"` means the full response. */
+type ByteRange =
+  | { kind: "none" }
+  | { kind: "unsatisfiable" }
+  | { kind: "partial"; start: number; end: number }; // inclusive
+
+const NO_RANGE: ByteRange = { kind: "none" };
+
+/**
+ * Interpret a `Range` header against an asset of `size` bytes. Only a single
+ * `bytes` range is honored; anything else (malformed, `a > b`, several ranges,
+ * other units) is ignored, which yields the full response (RFC 9110 section 14.2).
+ */
+function parseRange(header: string, size: number): ByteRange {
+  const unit = /^\s*bytes\s*=(.*)$/i.exec(header);
+  if (!unit) {
+    return NO_RANGE;
+  }
+  // Empty list elements are skipped, as the RFC list grammar allows.
+  const specs = unit[1]!
+    .split(",")
+    .map((spec) => spec.trim())
+    .filter((spec) => spec !== "");
+  if (specs.length !== 1) {
+    return NO_RANGE;
+  }
+  const spec = /^(\d*)\s*-\s*(\d*)$/.exec(specs[0]!);
+  if (!spec || (spec[1] === "" && spec[2] === "")) {
+    return NO_RANGE;
+  }
+  const [, first = "", last = ""] = spec;
+
+  if (first === "") {
+    // Suffix range: the last `n` bytes, or the whole asset when `n` is larger.
+    const n = Number(last);
+    if (n === 0 || size === 0) {
+      return { kind: "unsatisfiable" };
+    }
+    return { kind: "partial", start: Math.max(size - n, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return NO_RANGE;
+  }
+  if (start >= size) {
+    return { kind: "unsatisfiable" };
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { kind: "partial", start, end };
+}
+
+/**
+ * Evaluate `If-Range` against the current validators. Only a strong ETag or an
+ * exact HTTP date equal to `last-modified` matches; anything else, including a
+ * weak ETag, means the full response (RFC 9110 section 13.1.5).
+ */
+function ifRangeMatches(
+  value: string | null,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (value === null) {
+    return true;
+  }
+  if (value.startsWith("W/")) {
+    return false;
+  }
+  if (value.startsWith('"')) {
+    const { etag } = validators;
+    return etag !== undefined && !etag.startsWith("W/") && value === etag;
+  }
+  const date = new Date(value);
+  const { lastModified } = validators;
+  return (
+    lastModified !== undefined &&
+    !Number.isNaN(date.getTime()) &&
+    date.getTime() === lastModified.getTime()
+  );
+}
+
+/**
+ * Slice a body to the inclusive byte range `[start, end]`. Returns `undefined`
+ * when the body cannot be sliced without reading it all into memory (form
+ * bodies are re-encoded with a random boundary, so their bytes are not stable).
+ */
+function sliceContents(
+  contents: BodyInit | null | undefined,
+  start: number,
+  end: number,
+): BodyInit | undefined {
+  if (typeof contents === "string") {
+    return new TextEncoder().encode(contents).subarray(start, end + 1);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return contents.slice(start, end + 1);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    return new Uint8Array(contents.buffer, contents.byteOffset + start, end - start + 1);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, start, end);
+  }
+  return undefined;
+}
+
+/** Read and discard bytes before `start`, emit `[start, end]`, then cancel the source. */
+function sliceStream(
+  stream: ReadableStream,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let skip = start;
+  let remaining = end - start + 1;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const { done, value } = await reader.read();
+      if (done) {
+        controller.close();
+        return;
+      }
+      let chunk = value as Uint8Array;
+      if (skip > 0) {
+        if (chunk.byteLength <= skip) {
+          skip -= chunk.byteLength;
+          return;
+        }
+        chunk = chunk.subarray(skip);
+        skip = 0;
+      }
+      if (chunk.byteLength >= remaining) {
+        controller.enqueue(chunk.subarray(0, remaining));
+        controller.close();
+        reader.cancel().catch(() => {});
+        return;
+      }
+      remaining -= chunk.byteLength;
+      controller.enqueue(chunk);
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
diff --git a/test/sdd-static-range.test.ts b/test/sdd-static-range.test.ts
