@@ -0,0 +1,304 @@
+import type { Mock } from "vitest";
+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for HTTP Range support in `serveStatic` (sdd/prd.md, sdd/techspec.md).
+const body = "abcdefghij".repeat(100);
+const mtime = 1_700_000_000_000;
+const lastModified = new Date(mtime).toUTCString();
+
+describeMatrix("serve static range requests", (t, { it, expect }) => {
+  let getContents: Mock<() => string>;
+
+  // Each case mounts its own prefix, so no test depends on route order.
+  const mount = (prefix: string, options: ServeStaticOptions) => {
+    t.app.all(`${prefix}/**`, (event) => serveStatic(event, options));
+  };
+
+  beforeEach(() => {
+    getContents = vi.fn(() => body);
+    mount("/range", {
+      getContents,
+      getMeta: () => ({ type: "text/plain", etag: '"v1"', mtime, size: 1000 }),
+    });
+  });
+
+  // RF-01
+  it("announces byte ranges on a full response", async () => {
+    const res = await t.fetch("/range/file.bin");
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe(body);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  // RF-02
+  it("responds 206 with the bytes of a closed range", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(body.slice(0, 100));
+  });
+
+  it("responds 206 with the last bytes for a suffix range", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=-50" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 950-999/1000");
+    expect(res.headers.get("content-length")).toBe("50");
+    expect(await res.text()).toBe(body.slice(950));
+  });
+
+  it("responds 206 to an open-ended range", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=900-" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 900-999/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe(body.slice(900));
+  });
+
+  it("clamps an end past the last byte", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=990-5000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 990-999/1000");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe(body.slice(990));
+  });
+
+  it("returns the whole asset for a suffix longer than the asset", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=-5000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-999/1000");
+    expect(await res.text()).toBe(body);
+  });
+
+  // RF-03
+  it("responds 206 to HEAD without a body and without reading contents", async () => {
+    const res = await t.fetch("/range/file.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  // RF-04
+  it("ignores malformed, multiple, or unknown-unit ranges", async () => {
+    for (const range of ["bytes=0-10,20-30", "bytes=50-10", "items=0-10", "bytes=abc"]) {
+      const res = await t.fetch("/range/file.bin", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(await res.text(), range).toBe(body);
+    }
+  });
+
+  it("ignores a range when the asset size is unknown", async () => {
+    mount("/range-nosize", {
+      getContents: () => body,
+      getMeta: () => ({ type: "text/plain" }),
+    });
+    const res = await t.fetch("/range-nosize/file.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe(body);
+  });
+
+  // RF-05
+  it("responds 416 when the range starts past the end", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=1000-1100" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds 416 to HEAD without a body", async () => {
+    const res = await t.fetch("/range/file.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=1000-" },
+    });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(await res.text()).toBe("");
+  });
+
+  it("responds 416 to a zero-length suffix", async () => {
+    const res = await t.fetch("/range/file.bin", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+  });
+
+  it("responds 416 for any range on an empty asset", async () => {
+    mount("/range-empty", {
+      getContents: () => "",
+      getMeta: () => ({ type: "text/plain", size: 0 }),
+    });
+    const res = await t.fetch("/range-empty/file.bin", { headers: { range: "bytes=0-" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+  });
+
+  // RF-06
+  it("applies If-Range only when the validator matches the current asset", async () => {
+    for (const [ifRange, status] of [
+      ['"v1"', 206],
+      ['"v0"', 200],
+      ['W/"v1"', 200],
+      [lastModified, 206],
+      [new Date(mtime + 1000).toUTCString(), 200],
+    ] as const) {
+      const res = await t.fetch("/range/file.bin", {
+        headers: { range: "bytes=0-99", "if-range": ifRange },
+      });
+      expect(res.status, ifRange).toBe(status);
+      if (status === 200) {
+        expect(res.headers.get("content-range"), ifRange).toBeNull();
+        expect(await res.text(), ifRange).toBe(body);
+      } else {
+        expect(await res.text(), ifRange).toBe(body.slice(0, 100));
+      }
+    }
+  });
+
+  // RF-07
+  it("keeps 304 for a matching If-None-Match even with a Range", async () => {
+    const res = await t.fetch("/range/file.bin", {
+      headers: { "if-none-match": '"v1"', range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  it("keeps 405 for other methods even with a Range", async () => {
+    // `allow` is not asserted: it is set on `event.res` but not on the error
+    // response today, with or without Range (pre-existing, out of scope).
+    const res = await t.fetch("/range/file.bin", {
+      method: "POST",
+      headers: { range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(405);
+  });
+
+  it("falls through to the next handler for a missing asset with a Range", async () => {
+    t.app.all("/range-missing/**", async (event) => {
+      const res = await serveStatic(event, {
+        fallthrough: true,
+        getContents: () => undefined,
+        getMeta: () => undefined,
+      });
+      return res ?? "next";
+    });
+    const res = await t.fetch("/range-missing/file.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe("next");
+  });
+
+  // RF-08
+  it("ranges over the precompressed variant and keeps its encoding", async () => {
+    const files: Record<string, string> = {
+      "/range-enc/app.js": "x".repeat(1000),
+      "/range-enc/app.js.gz": "g".repeat(300),
+    };
+    mount("/range-enc", {
+      encodings: { gzip: ".gz" },
+      getContents: (id) => files[id],
+      getMeta: (id) =>
+        files[id]
+          ? { size: files[id].length, encoding: id.endsWith(".gz") ? "gzip" : undefined }
+          : undefined,
+    });
+    const res = await t.fetch("/range-enc/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/300");
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-type")).toBe("text/javascript");
+    // Node's fetch decodes `content-encoding: gzip`, and a partial gzip stream
+    // cannot be decoded, so the body is only checked on the web target.
+    if (t.target === "web") {
+      expect(await res.text()).toBe("g".repeat(100));
+    }
+  });
+
+  // D-05 body types
+  it("slices a Blob body", async () => {
+    mount("/range-blob", {
+      getContents: () => new Blob([body]),
+      getMeta: () => ({ size: 1000 }),
+    });
+    const res = await t.fetch("/range-blob/file.bin", { headers: { range: "bytes=10-19" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(body.slice(10, 20));
+  });
+
+  it("slices an ArrayBuffer body", async () => {
+    mount("/range-buffer", {
+      getContents: () => new TextEncoder().encode(body).buffer,
+      getMeta: () => ({ size: 1000 }),
+    });
+    const res = await t.fetch("/range-buffer/file.bin", { headers: { range: "bytes=10-19" } });
+    expect(res.status).toBe(206);
+    expect(await res.text()).toBe(body.slice(10, 20));
+  });
+
+  it("slices a ReadableStream body across chunks", async () => {
+    const encoder = new TextEncoder();
+    mount("/range-stream", {
+      getContents: () =>
+        new ReadableStream({
+          start(controller) {
+            controller.enqueue(encoder.encode(body.slice(0, 300)));
+            controller.enqueue(encoder.encode(body.slice(300)));
+            controller.close();
+          },
+        }),
+      getMeta: () => ({ size: 1000 }),
+    });
+    const res = await t.fetch("/range-stream/file.bin", { headers: { range: "bytes=500-599" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 500-599/1000");
+    expect(await res.text()).toBe(body.slice(500, 600));
+  });
+
+  it("serves a FormData body in full even with a Range", async () => {
+    const form = new FormData();
+    form.set("field", "value");
+    mount("/range-form", {
+      getContents: () => form,
+      getMeta: () => ({ size: 1000 }),
+    });
+    const res = await t.fetch("/range-form/file.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("counts size and slices bytes, not characters, for a multibyte string", async () => {
+    const encoder = new TextEncoder();
+    const text = "héllo wörld ✓ ".repeat(50);
+    const bytes = encoder.encode(text);
+    mount("/range-utf8", {
+      getContents: () => text,
+      getMeta: () => ({ size: bytes.length }),
+    });
