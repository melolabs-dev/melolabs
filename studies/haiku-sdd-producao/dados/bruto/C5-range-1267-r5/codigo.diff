+import { vi } from "vitest";
+import { serveStatic, type ServeStaticOptions, type StaticAssetMeta } from "../src/index.ts";
+import { describeMatrix, type TestContext } from "./_setup.ts";
+
+const SIZE = 1000;
+const content = Uint8Array.from({ length: SIZE }, (_, i) => i % 256);
+const mtime = 1_700_000_000_000;
+const lastModified = new Date(mtime).toUTCString();
+
+const fixtureMeta: StaticAssetMeta = {
+  type: "application/octet-stream",
+  etag: '"abc"',
+  mtime,
+  size: SIZE,
+};
+
+function fixture(overrides: Partial<ServeStaticOptions> = {}): ServeStaticOptions {
+  return {
+    getMeta: () => ({ ...fixtureMeta }),
+    getContents: () => content,
+    ...overrides,
+  };
+}
+
+let mounts = 0;
+
+// Each call mounts the options on a fresh prefix and returns the asset path.
+function mount(t: TestContext, options: ServeStaticOptions): string {
+  const prefix = `/mount-${mounts++}`;
+  t.app.all(`${prefix}/**`, (event) => serveStatic(event, options));
+  return `${prefix}/file.bin`;
+}
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  const expectPartial = async (res: Response, start: number, end: number) => {
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe(`bytes ${start}-${end}/${SIZE}`);
+    expect(res.headers.get("content-length")).toBe(String(end - start + 1));
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(content.slice(start, end + 1));
+  };
+
+  const expectFull = async (res: Response) => {
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(content);
+  };
+
+  // RF-01
+  it("announces byte ranges on GET without a Range header", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url);
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(content);
+  });
+
+  // RF-01, RF-08 (304 keeps the same header set as the etag it reuses)
+  it("announces byte ranges on HEAD and on 304", async () => {
+    const url = mount(t, fixture());
+
+    const head = await t.fetch(url, { method: "HEAD" });
+    expect(head.status).toBe(200);
+    expect(head.headers.get("accept-ranges")).toBe("bytes");
+
+    const notModified = await t.fetch(url, { headers: { "if-none-match": '"abc"' } });
+    expect(notModified.status).toBe(304);
+    expect(notModified.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  // RF-02
+  it("serves a closed byte range with 206", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, { headers: { range: "bytes=100-199" } });
+    await expectPartial(res, 100, 199);
+  });
+
+  it("clamps a range end past the last byte", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, { headers: { range: "bytes=990-2000" } });
+    await expectPartial(res, 990, 999);
+  });
+
+  // RF-03
+  it("serves an open-ended range", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, { headers: { range: "bytes=900-" } });
+    await expectPartial(res, 900, 999);
+  });
+
+  it("serves a suffix range", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, { headers: { range: "bytes=-50" } });
+    await expectPartial(res, 950, 999);
+  });
+
+  it("returns the whole file as 206 when the suffix is longer than the asset", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, { headers: { range: "bytes=-5000" } });
+    await expectPartial(res, 0, 999);
+  });
+
+  // RF-04
+  it("answers HEAD with a range without a body and without reading contents", async () => {
+    const getContents = vi.fn(() => content);
+    const url = mount(t, fixture({ getContents }));
+    const res = await t.fetch(url, { method: "HEAD", headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe(`bytes 0-99/${SIZE}`);
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  // RF-05
+  it("answers 416 when the range starts after the last byte", async () => {
+    const getContents = vi.fn(() => content);
+    const url = mount(t, fixture({ getContents }));
+    const res = await t.fetch(url, { headers: { range: "bytes=1000-1100" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe(`bytes */${SIZE}`);
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("answers 416 for a zero-length suffix", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe(`bytes */${SIZE}`);
+    expect(await res.text()).toBe("");
+  });
+
+  it("answers 416 for any range on an empty asset", async () => {
+    const url = mount(
+      t,
+      fixture({ getMeta: () => ({ ...fixtureMeta, size: 0 }), getContents: () => "" }),
+    );
+    const res = await t.fetch(url, { headers: { range: "bytes=0-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  // RF-06
+  it("ignores a Range that does not apply and returns the full asset", async () => {
+    const url = mount(t, fixture());
+    for (const range of ["bytes=0-1,5-6", "items=0-1", "bytes=abc", "bytes=5-1", "bytes=-"]) {
+      const res = await t.fetch(url, { headers: { range } });
+      await expectFull(res);
+    }
+  });
+
+  it("ignores a Range when the asset size is unknown", async () => {
+    const url = mount(
+      t,
+      fixture({ getMeta: () => ({ type: "application/octet-stream", etag: '"abc"' }) }),
+    );
+    const res = await t.fetch(url, { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  // RF-07
+  it("applies a Range only when If-Range matches the strong ETag", async () => {
+    const url = mount(t, fixture());
+
+    const mismatch = await t.fetch(url, {
+      headers: { range: "bytes=0-99", "if-range": '"xyz"' },
+    });
+    await expectFull(mismatch);
+
+    const match = await t.fetch(url, {
+      headers: { range: "bytes=0-99", "if-range": '"abc"' },
+    });
+    await expectPartial(match, 0, 99);
+  });
+
+  it("never matches a weak ETag in If-Range", async () => {
+    const url = mount(t, fixture());
+    const res = await t.fetch(url, {
+      headers: { range: "bytes=0-99", "if-range": 'W/"abc"' },
+    });
+    await expectFull(res);
+  });
+
+  it("matches If-Range against the Last-Modified date", async () => {
+    const url = mount(t, fixture());
+
+    const match = await t.fetch(url, {
+      headers: { range: "bytes=0-99", "if-range": lastModified },
+    });
+    await expectPartial(match, 0, 99);
+
+    const other = await t.fetch(url, {
+      headers: {
+        range: "bytes=0-99",
+        "if-range": new Date(mtime + 1000).toUTCString(),
+      },
+    });
+    await expectFull(other);
+
+    const invalid = await t.fetch(url, {
+      headers: { range: "bytes=0-99", "if-range": "not a date" },
+    });
+    await expectFull(invalid);
+  });
+
+  // RF-08
+  it("answers 304 and ignores the Range when the cache validators match", async () => {
+    const url = mount(t, fixture());
+
+    const byEtag = await t.fetch(url, {
+      headers: { "if-none-match": '"abc"', range: "bytes=0-99" },
+    });
+    expect(byEtag.status).toBe(304);
+    expect(byEtag.headers.get("content-range")).toBeNull();
+    expect(await byEtag.text()).toBe("");
+
+    const byDate = await t.fetch(url, {
+      headers: { "if-modified-since": lastModified, range: "bytes=0-99" },
+    });
+    expect(byDate.status).toBe(304);
+    expect(byDate.headers.get("content-range")).toBeNull();
+    expect(await byDate.text()).toBe("");
+  });
+
+  // RF-09, D-07
+  it("sets Content-Length to the slice even when options.headers sets one", async () => {
+    const url = mount(t, fixture({ headers: { "content-length": "999" } }));
+    const res = await t.fetch(url, { headers: { range: "bytes=100-199" } });
+    await expectPartial(res, 100, 199);
+  });
+
+  // RF-09, D-10
+  it("applies Range to the precompressed variant chosen by accept-encoding", async () => {
+    const gz = Uint8Array.from({ length: 300 }, (_, i) => (i * 7) % 256);
+    const url = mount(
+      t,
+      fixture({
+        encodings: { gzip: ".gz" },
+        getMeta: (id) => (id.endsWith(".gz") ? { size: gz.length } : { ...fixtureMeta }),
+        getContents: (id) => (id.endsWith(".gz") ? gz : content),
+      }),
+    );
+    const res = await t.fetch(url, {
+      headers: { "accept-encoding": "gzip", range: "bytes=10-19" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 10-19/300");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(gz.slice(10, 20));
+  });
+
+  // D-08: slicing per body type
+  it("slices a string by UTF-8 bytes", async () => {
