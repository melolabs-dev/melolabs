+
+type RangeOutcome =
+  | { kind: "ignore" }
+  | { kind: "unsatisfiable" }
+  | { kind: "partial"; start: number; end: number }; // inclusive, already capped at size - 1
+
+const IGNORE: RangeOutcome = { kind: "ignore" };
+const UNSATISFIABLE: RangeOutcome = { kind: "unsatisfiable" };
+
+const RANGE_SPEC_RE = /^(\d*)-(\d*)$/;
+
+/**
+ * Resolve the one byte range a request asks for (RFC 9110 section 14.1.2), or
+ * `ignore` when the full representation should be served instead.
+ */
+function resolveRange(
+  headers: Headers,
+  size: number | undefined,
+  validators: { etag?: string; lastModified?: Date },
+): RangeOutcome {
+  const range = headers.get("range");
+  if (!range || size === undefined) {
+    return IGNORE;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, validators)) {
+    return IGNORE;
+  }
+  return parseRangeHeader(range, size);
+}
+
+/** Parse `bytes=<spec>` for a single range. Anything outside that grammar is ignored (RFC 9110 section 14.2). */
+function parseRangeHeader(value: string, size: number): RangeOutcome {
+  const unitEnd = value.indexOf("=");
+  if (unitEnd === -1 || value.slice(0, unitEnd).trim().toLowerCase() !== "bytes") {
+    return IGNORE;
+  }
+  // Empty list elements are allowed (RFC 9110 section 5.6.1); more than one range is not supported.
+  const specs = value
+    .slice(unitEnd + 1)
+    .split(",")
+    .map((spec) => spec.trim())
+    .filter((spec) => spec !== "");
+  if (specs.length !== 1) {
+    return IGNORE;
+  }
+  const match = RANGE_SPEC_RE.exec(specs[0]!);
+  if (!match) {
+    return IGNORE;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "") {
+    if (last === "") {
+      return IGNORE;
+    }
+    // Suffix range: the last `n` bytes. `-0` and any range on an empty asset are unsatisfiable.
+    const suffix = toSafeInteger(last);
+    if (suffix === undefined) {
+      return IGNORE;
+    }
+    if (suffix === 0 || size === 0) {
+      return UNSATISFIABLE;
+    }
+    return { kind: "partial", start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = toSafeInteger(first);
+  if (start === undefined) {
+    return IGNORE;
+  }
+  let end = size - 1;
+  if (last !== "") {
+    const requestedEnd = toSafeInteger(last);
+    if (requestedEnd === undefined || requestedEnd < start) {
+      return IGNORE;
+    }
+    end = Math.min(requestedEnd, size - 1);
+  }
+  if (size === 0 || start >= size) {
+    return UNSATISFIABLE;
+  }
+  return { kind: "partial", start, end };
+}
+
+/** Parse a run of ASCII digits as a safe integer, or `undefined` when it is too large. */
+function toSafeInteger(digits: string): number | undefined {
+  const value = Number(digits);
+  return Number.isSafeInteger(value) ? value : undefined;
+}
+
+/**
+ * Compare `If-Range` with the strong comparison of RFC 9110 section 13.1.5: a
+ * weak ETag, on either side, never matches. Anything that is not an ETag is
+ * compared as an HTTP date with `Last-Modified`.
+ */
+function ifRangeMatches(
+  value: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    return (
+      validators.etag !== undefined &&
+      !validators.etag.startsWith("W/") &&
+      value === validators.etag
+    );
+  }
+  if (validators.lastModified === undefined) {
+    return false;
+  }
+  const date = new Date(value);
+  return !Number.isNaN(date.getTime()) && date.getTime() === validators.lastModified.getTime();
+}
+
+/**
+ * Cut the inclusive byte range `[start, end]` out of a body. Returns `undefined`
+ * when the body cannot be sliced, and the caller then serves the full body.
+ */
+function sliceBody(
+  body: BodyInit | null | undefined,
+  start: number,
+  end: number,
+): BodyInit | undefined {
+  const endExclusive = end + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, endExclusive);
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(start, endExclusive);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(
+      start,
+      endExclusive,
+    );
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, endExclusive);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, start, end);
+  }
+  return undefined;
+}
+
+/** Read and discard the bytes before `start`, emit `[start, end]`, then cancel the rest of the source. */
+function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  start: number,
+  end: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let offset = 0; // bytes read from the source so far
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunkStart = offset;
+        offset += value.byteLength;
+        if (offset <= start) {
+          continue;
+        }
+        controller.enqueue(
+          value.subarray(
+            Math.max(start - chunkStart, 0),
+            Math.min(end + 1 - chunkStart, value.byteLength),
+          ),
+        );
+        if (offset > end) {
+          controller.close();
+          await reader.cancel();
+        }
+        return;
+      }
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
