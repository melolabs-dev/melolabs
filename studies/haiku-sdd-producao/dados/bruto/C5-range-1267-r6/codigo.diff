+import { beforeEach, vi } from "vitest";
+import { serveStatic, type ServeStaticOptions } from "../src/index.ts";
+import { describeMatrix } from "./_setup.ts";
+
+const SIZE = 1000;
+const MTIME = 1_700_000_000_000;
+const ASSET = new Uint8Array(SIZE).map((_, i) => i % 256);
+
+/** Bytes from `start` to `end`, inclusive. */
+const slice = (data: Uint8Array, start: number, end: number) => data.slice(start, end + 1);
+
+function streamOf(data: Uint8Array, chunkSize: number) {
+  return new ReadableStream<Uint8Array>({
+    start(controller) {
+      for (let i = 0; i < data.length; i += chunkSize) {
+        controller.enqueue(data.slice(i, i + chunkSize));
+      }
+      controller.close();
+    },
+  });
+}
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  let options: ServeStaticOptions;
+
+  beforeEach(() => {
+    options = {
+      getMeta: () => ({
+        type: "application/octet-stream",
+        etag: '"v1"',
+        mtime: MTIME,
+        size: SIZE,
+      }),
+      getContents: () => ASSET,
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+  });
+
+  async function expectPartial(range: string, start: number, end: number) {
+    const res = await t.fetch("/asset.bin", { headers: { range } });
+    expect(res.status, range).toBe(206);
+    expect(res.headers.get("content-range"), range).toBe(`bytes ${start}-${end}/${SIZE}`);
+    expect(res.headers.get("content-length"), range).toBe(String(end - start + 1));
+    expect(new Uint8Array(await res.arrayBuffer()), range).toEqual(slice(ASSET, start, end));
+  }
+
+  // --- RF-01, RF-09, RF-11: accept-ranges and cache precedence ---
+
+  it("Advertises byte ranges on GET", async () => {
+    const res = await t.fetch("/asset.bin");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(ASSET);
+  });
+
+  it("Advertises byte ranges on HEAD", async () => {
+    const res = await t.fetch("/asset.bin", { method: "HEAD" });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("Does not advertise byte ranges on 304", async () => {
+    const res = await t.fetch("/asset.bin", { headers: { "if-none-match": '"v1"' } });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("Returns 304 instead of 206 when the cache validator matches", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-none-match": '"v1"' },
+    });
+    expect(res.status).toBe(304);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("");
+  });
+
+  // --- RF-02, RF-03, RF-04: valid ranges on GET ---
+
+  it("Serves a closed byte range with 206", async () => {
+    await expectPartial("bytes=100-199", 100, 199);
+  });
+
+  it("Serves an open-ended byte range with 206", async () => {
+    await expectPartial("bytes=990-", 990, 999);
+  });
+
+  it("Serves a suffix range with the last bytes", async () => {
+    await expectPartial("bytes=-100", 900, 999);
+  });
+
+  it("Serves a suffix larger than the asset as the whole asset", async () => {
+    await expectPartial("bytes=-5000", 0, 999);
+  });
+
+  it("Clamps the end of a range to the last byte", async () => {
+    await expectPartial("bytes=900-5000", 900, 999);
+  });
+
+  it("Clamps an end beyond the safe integer range", async () => {
+    await expectPartial("bytes=0-99999999999999999999", 0, 999);
+  });
+
+  it("Accepts the range unit case-insensitively", async () => {
+    await expectPartial("BYTES=0-9", 0, 9);
+  });
+
+  // --- RF-05: ranges that are ignored ---
+
+  it("Ignores malformed or unsupported Range headers", async () => {
+    for (const range of [
+      "bytes=abc",
+      "items=0-5",
+      "bytes=500-100",
+      "bytes=0-10,20-30",
+      "bytes=-",
+    ]) {
+      const res = await t.fetch("/asset.bin", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(new Uint8Array(await res.arrayBuffer()), range).toEqual(ASSET);
+    }
+  });
+
+  // --- RF-06, D-02: 416 ---
+
+  it("Responds 416 when the range starts after the last byte", async () => {
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=1000-1100" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe("");
+  });
+
+  it("Responds 416 to a zero-length suffix range", async () => {
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=-0" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+  });
+
+  it("Responds 416 to any range on an empty asset", async () => {
+    options.getMeta = () => ({ type: "application/octet-stream", size: 0 });
+    options.getContents = () => "";
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=0-" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */0");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  // --- RF-07: HEAD with ranges ---
+
+  it("Applies a byte range to HEAD without a body", async () => {
+    const res = await t.fetch("/asset.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=100-199" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 100-199/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(await res.text()).toBe("");
+  });
+
+  it("Responds 416 to HEAD with an unsatisfiable range", async () => {
+    const res = await t.fetch("/asset.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=1000-1100" },
+    });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(await res.text()).toBe("");
+  });
+
+  it("Ignores a malformed Range on HEAD", async () => {
+    const res = await t.fetch("/asset.bin", {
+      method: "HEAD",
+      headers: { range: "bytes=abc" },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  // --- RF-08: If-Range ---
+
+  it("Honors a strong If-Range ETag that matches", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-range": '"v1"' },
+    });
+    expect(res.status).toBe(206);
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(slice(ASSET, 0, 99));
+  });
+
+  it("Ignores the Range when If-Range ETag differs", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-range": '"v0"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(ASSET);
+  });
+
+  it("Ignores the Range when If-Range carries a weak ETag", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-range": 'W/"v1"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(ASSET);
+  });
+
+  it("Honors If-Range with the exact Last-Modified date", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-range": new Date(MTIME).toUTCString() },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+  });
+
+  it("Ignores the Range when If-Range date differs", async () => {
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-range": new Date(MTIME - 1000).toUTCString() },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("Ignores the Range when the asset has no validator", async () => {
+    options.getMeta = () => ({ type: "application/octet-stream", size: SIZE });
+    const res = await t.fetch("/asset.bin", {
+      headers: { range: "bytes=0-99", "if-range": '"v1"' },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  // --- RF-10, D-09: unknown or invalid size ---
+
+  it("Ignores the Range when getMeta has no size", async () => {
+    options.getMeta = () => ({ type: "application/octet-stream" });
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(ASSET);
+  });
+
+  it("Ignores the Range when size is NaN or negative", async () => {
+    for (const size of [Number.NaN, -1]) {
+      options.getMeta = () => ({ type: "application/octet-stream", size });
+      const res = await t.fetch("/asset.bin", { headers: { range: "bytes=0-99" } });
+      expect(res.status, String(size)).toBe(200);
+      expect(res.headers.get("content-range"), String(size)).toBeNull();
+    }
+  });
+
+  // --- D-05: slicing by body type ---
+
+  it("Slices string bodies by UTF-8 bytes", async () => {
+    const text = "é".repeat(500); // 1000 bytes in UTF-8
+    options.getContents = () => text;
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(
+      slice(new TextEncoder().encode(text), 100, 199),
+    );
+  });
+
+  it("Slices Blob bodies", async () => {
+    options.getContents = () => new Blob([ASSET]);
+    await expectPartial("bytes=100-199", 100, 199);
+  });
+
+  it("Slices ArrayBuffer bodies", async () => {
+    options.getContents = () => ASSET.slice().buffer;
+    await expectPartial("bytes=100-199", 100, 199);
+  });
+
+  it("Slices Uint8Array bodies", async () => {
+    options.getContents = () => ASSET;
+    await expectPartial("bytes=100-199", 100, 199);
+  });
+
+  it("Slices ReadableStream bodies across chunks", async () => {
+    options.getContents = () => streamOf(ASSET, 77);
+    await expectPartial("bytes=100-199", 100, 199);
+  });
+
+  it("Applies ranges to FormData bodies (status and headers only)", async () => {
+    const form = new FormData();
+    form.append("file", new Blob([ASSET]), "asset.bin");
+    options.getContents = () => form;
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 100-199/1000");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect((await res.arrayBuffer()).byteLength).toBe(100);
+  });
+
+  it("Cancels the source stream once the range is read", async () => {
+    const cancel = vi.fn();
+    let offset = 0;
+    options.getContents = () =>
+      new ReadableStream<Uint8Array>({
+        pull(controller) {
+          if (offset >= SIZE) {
+            controller.close();
+            return;
+          }
+          controller.enqueue(ASSET.slice(offset, offset + 100));
+          offset += 100;
+        },
+        cancel,
+      });
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=100-199" } });
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(slice(ASSET, 100, 199));
+    expect(cancel).toHaveBeenCalled();
+  });
+
+  // --- RF-12: precompressed variants ---
+
+  it("Ranges the precompressed variant and keeps its encoding", async () => {
+    const gzip = new Uint8Array(400).map((_, i) => (i * 7) % 256);
+    options.encodings = { gzip: ".gz" };
+    options.getMeta = (id) =>
+      id.endsWith(".gz") ? { type: "text/javascript", encoding: "gzip", size: 400 } : undefined;
+    options.getContents = () => gzip;
+    const res = await t.fetch("/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/400");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(res.headers.get("vary")).toContain("accept-encoding");
+    // Not read as bytes: undici decodes `content-encoding: gzip` on read.
+    await res.body?.cancel();
+  });
+
+  // --- D-06: options.headers do not win over the partial length ---
+
+  it("Overrides a content-length set by options.headers on 206", async () => {
+    options.headers = { "content-length": "999" };
+    const res = await t.fetch("/asset.bin", { headers: { range: "bytes=100-199" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(new Uint8Array(await res.arrayBuffer())).toEqual(slice(ASSET, 100, 199));
+  });
+
+  // --- RF-11: behavior that must not change ---
+
+  it("Keeps 404 for a missing asset with a Range", async () => {
+    options.getMeta = () => undefined;
+    const res = await t.fetch("/missing.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(404);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(res.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("Keeps 405 for non-GET methods with a Range", async () => {
+    const res = await t.fetch("/asset.bin", {
+      method: "POST",
+      headers: { range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(405);
+    expect(res.headers.get("content-range")).toBeNull();
+  });
+
+  it("Falls through with a Range for a missing asset", async () => {
+    t.app.all("/fallthrough/**", async (event) => {
+      const res = await serveStatic(event, {
+        ...options,
+        getMeta: () => undefined,
+        fallthrough: true,
+      });
+      return res ?? "next handler";
