+    const res = await t.fetch("/fallthrough/asset.bin", { headers: { range: "bytes=0-99" } });
+    expect(res.status).toBe(200);
+    expect(res.headers.get("content-range")).toBeNull();
+    expect(await res.text()).toBe("next handler");
+  });
+});
