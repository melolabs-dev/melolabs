+
+/** Inclusive byte range, already limited to the asset size. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/** `undefined` ignores the Range, `"unsatisfiable"` responds 416, and a range responds 206. */
+type RangeDecision = ByteRange | "unsatisfiable" | undefined;
+
+// `first-last`, `first-` or `-suffix` after the `bytes` unit (RFC 9110 section 14.1).
+const BYTES_RANGE_RE = /^bytes\s*=\s*(\d*)-(\d*)$/i;
+
+/**
+ * Interpret a `Range` header for an asset of `size` bytes.
+ *
+ * Only one `bytes` range is supported. Multiple ranges, other units and
+ * malformed values return `undefined`, so the whole asset is served instead.
+ */
+function parseByteRange(value: string, size: number): RangeDecision {
+  const match = BYTES_RANGE_RE.exec(value.trim());
+  if (!match || (match[1] === "" && match[2] === "")) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+
+  if (first === "") {
+    const suffix = Number(last);
+    if (suffix === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { start, end };
+}
+
+/**
+ * Evaluate `If-Range` against the asset's current validators (RFC 9110 section 13.1.5).
+ *
+ * Only a strong ETag equal to the current one or an exact `Last-Modified` date
+ * matches. A weak ETag never matches, and neither does a missing validator.
+ */
+function matchesIfRange(
+  ifRange: string | null,
+  validators: { etag?: string; mtime?: Date },
+): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  if (ifRange.startsWith('"') || ifRange.startsWith("W/")) {
+    return !!validators.etag && !validators.etag.startsWith("W/") && validators.etag === ifRange;
+  }
+  return !!validators.mtime && new Date(ifRange).getTime() === validators.mtime.getTime();
+}
+
+function resolveRange(
+  headers: Headers,
+  size: number | undefined,
+  validators: { etag?: string; mtime?: Date },
+): RangeDecision {
+  const range = headers.get("range");
+  // An unknown or invalid size cannot produce a coherent Content-Range.
+  if (!range || size === undefined || !Number.isSafeInteger(size) || size < 0) {
+    return undefined;
+  }
+  if (!matchesIfRange(headers.get("if-range"), validators)) {
+    return undefined;
+  }
+  return parseByteRange(range, size);
+}
+
+function partialResponse(
+  event: H3Event,
+  range: ByteRange,
+  size: number,
+  body: BodyInit | null,
+): HTTPResponse {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+  return new HTTPResponse(body, { status: 206, statusText: "Partial Content" });
+}
+
+/**
+ * Cut a body down to `range` without materializing it when the type allows.
+ * Byte offsets are used for strings, so multi-byte characters are sliced by bytes.
+ */
+function sliceBody(body: BodyInit, range: ByteRange): BodyInit {
+  const end = range.end + 1;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(range.start, end);
+  }
+  if (body instanceof Blob) {
+    return body.slice(range.start, end);
+  }
+  if (body instanceof ArrayBuffer || ArrayBuffer.isView(body)) {
+    const bytes = ArrayBuffer.isView(body)
+      ? new Uint8Array(body.buffer, body.byteOffset, body.byteLength)
+      : new Uint8Array(body);
+    return bytes.subarray(range.start, end);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, range, true);
+  }
+  // FormData and URLSearchParams have no reliable byte size, so this is best effort.
+  // Their body is in memory, and undici throws if it is cancelled mid-pump, so
+  // the source is left to drain instead of being released.
+  return sliceStream(new Response(body).body!, range, false);
+}
+
+/**
+ * Skip `range.start` bytes and emit the rest of the range. With `releaseSource`,
+ * the source is cancelled once the range is read or the consumer goes away.
+ */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  range: ByteRange,
+  releaseSource: boolean,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let skip = range.start;
+  let remaining = range.end - range.start + 1;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        let chunk = value;
+        if (skip > 0) {
+          const dropped = Math.min(skip, chunk.byteLength);
+          skip -= dropped;
+          chunk = chunk.subarray(dropped);
+        }
+        if (chunk.byteLength > 0) {
+          const emit = chunk.subarray(0, remaining);
+          remaining -= emit.byteLength;
+          controller.enqueue(emit);
+          if (remaining === 0) {
+            if (releaseSource) {
+              await reader.cancel();
+            }
+            controller.close();
+          }
+          return;
+        }
+      }
+    },
+    cancel(reason) {
+      return releaseSource ? reader.cancel(reason) : undefined;
+    },
+  });
+}
