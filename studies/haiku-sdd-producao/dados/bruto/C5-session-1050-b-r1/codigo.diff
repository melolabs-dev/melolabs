+    expect((await res.json()).id).not.toBe("legacy-old");
+  });
+
+  it("RF-08: a short extra password placed before the sealing one fails the read", async () => {
+    const sealed = await seal({ id: "old-1", createdAt: Date.now(), data: {} }, OLD, sealDefaults);
+    readSession("/rf08-before", { ...base, extraUnsealPasswords: [SHORT, OLD] });
