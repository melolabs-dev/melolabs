+
+/**
+ * Try `password`, then each extra in order, and stop at the first that opens the
+ * cookie. Only a wrong password (`Bad hmac value`) moves on to the next one; any
+ * other error is a configuration or format problem and propagates. An opening
+ * by an extra is marked with `kExtraSeal` so `getSession` reseals it.
+ */
+async function openWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  const passwords = [...new Set([config.password, ...(config.extraUnsealPasswords ?? [])])];
+  let lastError: Error | undefined;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      const unsealed = await openWithPassword(sealed, password, sealOptions, config);
+      if (unsealed && index > 0) {
+        (unsealed as any)[kExtraSeal] = true;
+      }
+      return unsealed;
+    } catch (error) {
+      if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+/**
+ * Unseal with one password, retrying with the legacy 1-iteration count when
+ * `legacySealFallback` allows it.
+ */
+async function openWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  config: SessionConfig,
+): Promise<Partial<Session>> {
+  let unsealed: Partial<Session>;
+  try {
+    unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+  }
+  return unsealed;
+}
