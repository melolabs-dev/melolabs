+    );
+    readSession("/rf07-strict", {
+      ...base,
+      extraUnsealPasswords: [OLD],
+      legacySealFallback: false,
+    });
+
+    const res = await t.fetch("/rf07-strict", {
+      headers: { Cookie: `h3-sdd=${legacySealed}` },
