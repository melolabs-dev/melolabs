+++ b/test/sdd-extra-unseal-passwords.test.ts
@@ -0,0 +1,312 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { vi } from "vitest";
+import { getSession, useSession, updateSession } from "../src/index.ts";
+import { unsealSession } from "../src/utils/session.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for `extraUnsealPasswords` (h3js/h3#1050), derived from sdd/prd.md
+// and sdd/techspec.md. Each RF is tagged in its test name.
+describeMatrix("sdd: extra unseal passwords", (t, { it, expect }) => {
+  const NEW = "new-" + "n".repeat(40);
+  const OLD = "old-" + "o".repeat(40);
+  const WRONG = "wrong-" + "w".repeat(40);
+  const SHORT = "too-short";
+
+  const base: SessionConfig = {
+    name: "h3-sdd",
+    password: NEW,
+    generateId: () => "fresh-id",
+  };
+
+  const legacyOptions = {
+    ...sealDefaults,
+    encryption: { ...sealDefaults.encryption, iterations: 1 },
+    integrity: { ...sealDefaults.integrity, iterations: 1 },
+  };
+
+  const cookieValue = (res: Response, name: string) => {
+    const setCookie = res.headers.getSetCookie().find((c) => c.startsWith(`${name}=`));
+    return setCookie && decodeURIComponent(setCookie.split(";")[0].slice(name.length + 1));
+  };
+
+  const readSession = (path: string, config: SessionConfig) =>
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, config);
+      return { id: session.id, createdAt: session.createdAt, data: session.data };
+    });
+
+  it("RF-01: opens a cookie sealed with a previous password, keeping id, createdAt and data", async () => {
+    const createdAt = 1_700_000_000_000;
+    const sealed = await seal(
+      { id: "old-1", createdAt, data: { user: "alice" } },
+      OLD,
+      sealDefaults,
+    );
+    readSession("/rf01", { ...base, extraUnsealPasswords: [OLD] });
+
+    const res = await t.fetch("/rf01", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      id: "old-1",
+      createdAt,
+      data: { user: "alice" },
+    });
+  });
+
+  it("RF-02: seals created and updated sessions with password only", async () => {
+    const config: SessionConfig = { ...base, extraUnsealPasswords: [OLD] };
+    t.app.post("/rf02-create", async (event) => {
+      const session = await useSession(event, config);
+      await session.update({ step: "created" });
+      return { id: session.id };
+    });
+    t.app.post("/rf02-update", async (event) => {
+      const session = await updateSession(event, config, { step: "updated" });
+      return { id: session.id };
+    });
+
+    const created = await t.fetch("/rf02-create", { method: "POST" });
+    const createdCookie = cookieValue(created, "h3-sdd")!;
+    expect(await unseal(createdCookie, NEW, sealDefaults)).toMatchObject({
+      id: "fresh-id",
+      data: { step: "created" },
+    });
+    await expect(unseal(createdCookie, OLD, sealDefaults)).rejects.toThrow("Bad hmac value");
+
+    const updated = await t.fetch("/rf02-update", {
+      method: "POST",
+      headers: { Cookie: `h3-sdd=${createdCookie}` },
+    });
+    const updatedCookie = cookieValue(updated, "h3-sdd")!;
+    expect(await unseal(updatedCookie, NEW, sealDefaults)).toMatchObject({
+      id: "fresh-id",
+      data: { step: "updated" },
+    });
+    await expect(unseal(updatedCookie, OLD, sealDefaults)).rejects.toThrow("Bad hmac value");
+  });
+
+  it("RF-03: reseals an old-password cookie with password on the same response", async () => {
+    const sealed = await seal(
+      { id: "old-1", createdAt: Date.now(), data: { user: "alice" } },
+      OLD,
+      sealDefaults,
+    );
+    readSession("/rf03", { ...base, extraUnsealPasswords: [OLD] });
+    readSession("/rf03-plain", base);
+
+    const res1 = await t.fetch("/rf03", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(await res1.json()).toMatchObject({ id: "old-1" });
+    expect(res1.headers.getSetCookie()).toHaveLength(1);
+
+    // The resealed cookie opens with password alone, no extra needed
+    const resealed = cookieValue(res1, "h3-sdd")!;
+    const res2 = await t.fetch("/rf03-plain", { headers: { Cookie: `h3-sdd=${resealed}` } });
+    expect(await res2.json()).toMatchObject({ id: "old-1", data: { user: "alice" } });
+  });
+
+  it("RF-04: opens with the first matching password, ignoring repeats and password itself", async () => {
+    const sealed = await seal({ id: "old-1", createdAt: Date.now(), data: {} }, OLD, sealDefaults);
+    const configs: SessionConfig[] = [
+      { ...base, extraUnsealPasswords: [WRONG, OLD] },
+      { ...base, extraUnsealPasswords: [OLD, OLD, NEW] },
+    ];
+    for (const [index, config] of configs.entries()) {
+      readSession(`/rf04-${index}`, config);
+      const res = await t.fetch(`/rf04-${index}`, { headers: { Cookie: `h3-sdd=${sealed}` } });
+      expect(await res.json()).toMatchObject({ id: "old-1" });
+    }
+  });
+
+  it("RF-04: counts password attempts and stops at the one that opens the cookie", async () => {
+    const sealed = await seal({ id: "old-1", createdAt: Date.now(), data: {} }, OLD, sealDefaults);
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    const event = {} as any;
+    const attempts = async (config: SessionConfig) => {
+      deriveBits.mockClear();
+      await unsealSession(event, { ...config, legacySealFallback: false }, sealed);
+      return deriveBits.mock.calls.length;
+    };
+    try {
+      // NEW fails (1 derivation: integrity), WRONG fails (1), OLD opens (2)
+      expect(await attempts({ ...base, extraUnsealPasswords: [WRONG, OLD] })).toBe(4);
+      // OLD is password and also an extra: opened on the first try, duplicate never tried
+      expect(await attempts({ ...base, password: OLD, extraUnsealPasswords: [OLD] })).toBe(2);
+    } finally {
+      deriveBits.mockRestore();
+    }
+  });
+
+  it("RF-05: an old-password cookie past maxAge is treated as expired", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    try {
+      const sealed = await seal(
+        { id: "old-1", createdAt: t0 - 120_000, data: { user: "alice" } },
+        OLD,
+        sealDefaults,
+      );
+      readSession("/rf05-max", { ...base, maxAge: 60, extraUnsealPasswords: [OLD] });
+
+      const res = await t.fetch("/rf05-max", { headers: { Cookie: `h3-sdd=${sealed}` } });
+      expect(await res.json()).toMatchObject({ id: "fresh-id", data: {} });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("RF-05: an old-password cookie past idleTimeout is treated as expired", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    try {
+      const sealed = await seal(
+        { id: "old-1", createdAt: t0 - 120_000, lastSeenAt: t0 - 120_000, data: {} },
+        OLD,
+        sealDefaults,
+      );
+      readSession("/rf05-idle", { ...base, idleTimeout: 60, extraUnsealPasswords: [OLD] });
+
+      const res = await t.fetch("/rf05-idle", { headers: { Cookie: `h3-sdd=${sealed}` } });
+      expect(await res.json()).toMatchObject({ id: "fresh-id", data: {} });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("RF-05: no password is tried after an expired cookie has been opened", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    const deriveBits = vi.spyOn(crypto.subtle, "deriveBits");
+    try {
+      const sealed = await seal(
+        { id: "old-1", createdAt: t0 - 120_000, data: {} },
+        OLD,
+        sealDefaults,
+      );
+      deriveBits.mockClear();
+      await expect(
+        unsealSession(
+          {} as any,
+          {
+            ...base,
+            maxAge: 60,
+            extraUnsealPasswords: [OLD, WRONG],
+            legacySealFallback: false,
+          },
+          sealed,
+        ),
+      ).rejects.toThrow("Session expired!");
+      // NEW fails (1), OLD opens (2); WRONG is never tried
+      expect(deriveBits).toHaveBeenCalledTimes(3);
+    } finally {
+      deriveBits.mockRestore();
+      vi.useRealTimers();
+    }
+  });
+
+  it("RF-06: an empty extraUnsealPasswords list behaves like no list", async () => {
+    t.app.post("/rf06-empty", async (event) => {
+      const session = await updateSession(
+        event,
+        { ...base, extraUnsealPasswords: [] },
+        {
+          user: "alice",
+        },
+      );
+      return { id: session.id, data: session.data };
+    });
+    t.app.post("/rf06-plain", async (event) => {
+      const session = await updateSession(event, base, { user: "alice" });
+      return { id: session.id, data: session.data };
+    });
+
+    const empty = await t.fetch("/rf06-empty", { method: "POST" });
+    const plain = await t.fetch("/rf06-plain", { method: "POST" });
+    // Cookie values carry a fresh IV, so compare everything but the value
+    const shape = (res: Response) =>
+      res.headers.getSetCookie().map((c) => c.replace(/=[^;]*/, "="));
+    expect(shape(empty)).toEqual(shape(plain));
+    expect(await empty.json()).toEqual(await plain.json());
+  });
+
+  it("RF-07: reseals a legacy 1-iteration cookie sealed with an old password using current options", async () => {
+    const legacySealed = await seal(
+      { id: "legacy-old", createdAt: Date.now(), data: { user: "legacy" } },
+      OLD,
+      legacyOptions,
+    );
+    readSession("/rf07", { ...base, extraUnsealPasswords: [OLD] });
+
+    const res = await t.fetch("/rf07", { headers: { Cookie: `h3-sdd=${legacySealed}` } });
+    expect(await res.json()).toMatchObject({ id: "legacy-old", data: { user: "legacy" } });
+    expect(res.headers.getSetCookie()).toHaveLength(1);
+    const resealed = cookieValue(res, "h3-sdd")!;
+    expect(await unseal(resealed, NEW, sealDefaults)).toMatchObject({ id: "legacy-old" });
+  });
+
+  it("RF-07: rejects the same legacy cookie with legacySealFallback: false", async () => {
+    const legacySealed = await seal(
+      { id: "legacy-old", createdAt: Date.now(), data: { user: "legacy" } },
