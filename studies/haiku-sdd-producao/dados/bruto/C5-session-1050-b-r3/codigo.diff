diff --git a/test/sdd-extra-unseal-passwords.test.ts b/test/sdd-extra-unseal-passwords.test.ts
new file mode 100644
index 0000000..3c27bd2
--- /dev/null
+++ b/test/sdd-extra-unseal-passwords.test.ts
@@ -0,0 +1,186 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import { vi } from "vitest";
+import { getSession, sealSession, unsealSession, updateSession } from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Passwords must be at least 32 characters (seal.minPasswordlength)
+const OLD = "old-password-".repeat(3);
+const NEW = "new-password-".repeat(3);
+const CREATED_AT = Date.parse("2030-01-01T00:00:00Z");
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+// RF-01: `extraUnsealPasswords` is typed on SessionConfig, and `password` stays a string
+const config: SessionConfig = {
+  name: "h3-sdd",
+  password: NEW,
+  extraUnsealPasswords: [OLD],
+};
+
+/** Value of a `Set-Cookie` for `name`, decoded as the cookie parser sees it */
+function cookieValue(res: Response, name: string): string {
+  const cookie = res.headers.getSetCookie().find((c) => c.startsWith(`${name}=`))!;
+  const [pair] = cookie.split(";");
+  return decodeURIComponent(pair.slice(name.length + 1));
+}
+
+describeMatrix("sdd: extraUnsealPasswords", (t, { it, expect }) => {
+  /** Registers a route that returns the session loaded with `cfg` */
+  const readSession = (path: string, cfg: SessionConfig) => {
+    t.app.all(path, async (event) => ({ session: await getSession(event, cfg) }));
+  };
+
+  it("RF-02: opens a session sealed with a previous password", async () => {
+    const sealed = await seal(
+      { id: "old-id", createdAt: CREATED_AT, data: { user: "ana" } },
+      OLD,
+      sealDefaults,
+    );
+    readSession("/rf02", config);
+
+    const res = await t.fetch("/rf02", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-id", createdAt: CREATED_AT, data: { user: "ana" } },
+    });
+  });
+
+  it("RF-03: sealSession only uses password, never an extra one", async () => {
+    t.app.get("/rf03", async (event) => ({ sealed: await sealSession(event, config) }));
+
+    const { sealed } = await (await t.fetch("/rf03")).json();
+    await expect(unseal(sealed, NEW, sealDefaults)).resolves.toHaveProperty("id");
+    await expect(unseal(sealed, OLD, sealDefaults)).rejects.toThrow();
+  });
+
+  it("RF-04: without extras, a cookie sealed with another password starts a new session", async () => {
+    const sealed = await seal(
+      { id: "old-id", createdAt: CREATED_AT, data: { user: "ana" } },
+      OLD,
+      sealDefaults,
+    );
+    readSession("/rf04", { name: "h3-sdd", password: NEW, legacySealFallback: false });
+
+    const res = await t.fetch("/rf04", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    const body = await res.json();
+    expect(body.session.id).not.toBe("old-id");
+    expect(body.session.data).toEqual({});
+  });
+
+  it("RF-05: an extra password does not bypass maxAge", async () => {
+    const t0 = Date.parse("2030-01-01T00:00:00Z");
+    vi.useFakeTimers({ toFake: ["Date"], now: t0 });
+    try {
+      const maxAged: SessionConfig = { ...config, maxAge: 3600 };
+      const expired = await seal(
+        { id: "old-id", createdAt: t0 - 7_200_000, data: {} },
+        OLD,
+        sealDefaults,
+      );
+      await expect(unsealSession(undefined as any, maxAged, expired)).rejects.toThrow(
+        "Session expired!",
+      );
+
+      // Control: the same extra password opens a session still within maxAge
+      const fresh = await seal(
+        { id: "old-id", createdAt: t0 - 1_000, data: {} },
+        OLD,
+        sealDefaults,
+      );
+      await expect(unsealSession(undefined as any, maxAged, fresh)).resolves.toMatchObject({
+        id: "old-id",
+      });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("RF-06: updateSession reseals a session opened with an extra password under password", async () => {
+    const sealed = await seal(
+      { id: "old-id", createdAt: CREATED_AT, data: { user: "ana" } },
+      OLD,
+      sealDefaults,
+    );
+    t.app.all("/rf06", async (event) => {
+      await updateSession(event, config, { role: "admin" });
+      return {};
+    });
+
+    const res = await t.fetch("/rf06", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    const resealed = cookieValue(res, "h3-sdd");
+    await expect(unseal(resealed, NEW, sealDefaults)).resolves.toMatchObject({
+      id: "old-id",
+      data: { user: "ana", role: "admin" },
+    });
+    await expect(unseal(resealed, OLD, sealDefaults)).rejects.toThrow();
+  });
+
+  it("RF-06: a legacy session opened with an extra password is resealed under password", async () => {
+    const sealed = await seal(
+      { id: "legacy", createdAt: CREATED_AT, data: { user: "ana" } },
+      OLD,
+      legacyOptions,
+    );
+    readSession("/rf06-legacy", config);
+
+    const res = await t.fetch("/rf06-legacy", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "legacy", data: { user: "ana" } },
+    });
+    const resealed = cookieValue(res, "h3-sdd");
+    await expect(unseal(resealed, NEW, sealDefaults)).resolves.toMatchObject({ id: "legacy" });
+    await expect(unseal(resealed, OLD, sealDefaults)).rejects.toThrow();
+  });
+
+  it("RF-07: a session read from the session header opens with an extra password and is not resealed", async () => {
+    const sealed = await seal(
+      { id: "old-id", createdAt: CREATED_AT, data: { user: "ana" } },
+      OLD,
+      sealDefaults,
+    );
+    readSession("/rf07", config);
+
+    const res = await t.fetch("/rf07", { headers: { "x-h3-sdd-session": sealed } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "old-id", data: { user: "ana" } },
+    });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("D-02: a cookie sealed with password still opens when the extra list also has it", async () => {
+    const sealed = await seal(
+      { id: "new-id", createdAt: CREATED_AT, data: { user: "ana" } },
+      NEW,
+      sealDefaults,
+    );
+    const withBoth: SessionConfig = { ...config, extraUnsealPasswords: [OLD, NEW] };
+    t.app.all("/d02", async (event) => {
+      await updateSession(event, withBoth, { role: "admin" });
+      return {};
+    });
+
+    const res = await t.fetch("/d02", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    await expect(unseal(cookieValue(res, "h3-sdd"), NEW, sealDefaults)).resolves.toMatchObject({
+      id: "new-id",
+      data: { user: "ana", role: "admin" },
+    });
+  });
+
+  it("D-04: empty, duplicate, and too-short extra passwords are ignored", async () => {
+    const sealed = await seal(
+      { id: "new-id", createdAt: CREATED_AT, data: { user: "ana" } },
+      NEW,
+      sealDefaults,
+    );
+    readSession("/d04", { ...config, extraUnsealPasswords: ["", NEW, "short-pass"] });
+
+    const res = await t.fetch("/d04", { headers: { Cookie: `h3-sdd=${sealed}` } });
+    expect(await res.json()).toMatchObject({
+      session: { id: "new-id", data: { user: "ana" } },
+    });
+  });
+});
