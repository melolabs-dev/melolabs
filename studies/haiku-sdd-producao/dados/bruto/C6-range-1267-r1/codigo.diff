+type ByteRange = { start: number; end: number }; // inclusive, already limited to size - 1
+
+/**
+ * Resolve the request's `Range` against an asset of `size` bytes: `undefined` to
+ * serve the whole asset, `"unsatisfiable"` for a 416, or the range to send.
+ * `If-Range` is checked against the validators the response will carry.
+ */
+function getRange(event: H3Event, size: number): ByteRange | "unsatisfiable" | undefined {
+  const header = event.req.headers.get("range");
+  if (!header || !Number.isInteger(size) || size <= 0) {
+    return undefined;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (ifRange) {
+    const lastModified = event.res.headers.get("last-modified");
+    const validators = {
+      etag: event.res.headers.get("etag") ?? undefined,
+      lastModified: lastModified ? new Date(lastModified) : undefined,
+    };
+    if (!ifRangeMatches(ifRange, validators)) {
+      return undefined;
+    }
+  }
+  return parseRange(header, size);
+}
+
+/**
+ * Parse a single `bytes=` range (RFC 9110 section 14.1.2). Anything that is not one
+ * well-formed range (other unit, several ranges, malformed) is ignored.
+ */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = /^bytes=(\d*)-(\d*)$/i.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "" && last === "") {
+    return undefined;
+  }
+  if (first === "") {
+    // Suffix range: the last `suffix` bytes. A suffix longer than the asset is the whole asset.
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last === "") {
+    return start >= size ? "unsatisfiable" : { start, end: size - 1 };
+  }
+  const end = Number(last);
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * `If-Range` validation (RFC 9110 section 13.1.5). An entity-tag must be strong and
+ * equal to the response's ETag; a date must equal `Last-Modified` exactly.
+ */
+function ifRangeMatches(
+  ifRange: string,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange.startsWith('"')) {
+    // A quoted tag is strong, so byte equality is the strong comparison: a weak
+    // `W/` ETag on the response can never equal it.
+    return ifRange === validators.etag;
+  }
+  if (ifRange.startsWith("W/") || !validators.lastModified) {
+    return false;
+  }
+  return new Date(ifRange).getTime() === validators.lastModified.getTime();
+}
+
+function setRangeHeaders(event: H3Event, range: ByteRange, size: number): void {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+}
+
+/**
+ * Slice a body to `range`. Returns `undefined` when it cannot be sliced (unsupported
+ * type, or a length that disagrees with `size`), so the caller serves it whole.
+ */
+function sliceBody(
+  body: BodyInit | null | undefined,
+  range: ByteRange,
+  size: number,
+): BodyInit | undefined {
+  if (typeof body === "string") {
+    return sliceBytes(new TextEncoder().encode(body), range, size);
+  }
+  if (body instanceof ReadableStream) {
+    return sliceStream(body, range);
+  }
+  if (body instanceof Blob) {
+    return body.size === size ? body.slice(range.start, range.end + 1) : undefined;
+  }
+  if (body instanceof ArrayBuffer) {
+    return sliceBytes(new Uint8Array(body), range, size);
+  }
+  if (ArrayBuffer.isView(body)) {
+    // Views are typed over `ArrayBufferLike`, but `BodyInit` takes `ArrayBuffer`-backed
+    // ones. The cast only narrows the type: the bytes read are the same either way.
+    const bytes = new Uint8Array(body.buffer as ArrayBuffer, body.byteOffset, body.byteLength);
+    return sliceBytes(bytes, range, size);
+  }
+  return undefined;
+}
+
+function sliceBytes(
+  bytes: Uint8Array<ArrayBuffer>,
+  range: ByteRange,
+  size: number,
+): Uint8Array<ArrayBuffer> | undefined {
+  return bytes.byteLength === size ? bytes.subarray(range.start, range.end + 1) : undefined;
+}
+
+/**
+ * Slice a stream without buffering it: chunks before the range are dropped as they
+ * arrive, and the source is cancelled as soon as the range is complete.
+ */
+function sliceStream(stream: ReadableStream, range: ByteRange): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  const encoder = new TextEncoder();
+  const endExclusive = range.end + 1;
+  let position = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      // Read until a chunk reaches the consumer: a pull that enqueues nothing is
+      // not called again by the stream until the consumer reads.
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const bytes = typeof value === "string" ? encoder.encode(value) : value;
+        if (!(bytes instanceof Uint8Array)) {
+          throw new TypeError("serveStatic: a ranged stream must yield bytes or strings");
+        }
+        const chunkStart = position;
+        const chunkEnd = position + bytes.byteLength;
+        position = chunkEnd;
+        if (chunkEnd <= range.start) {
+          continue; // Entirely before the range.
+        }
+        controller.enqueue(
+          bytes.subarray(
+            Math.max(range.start - chunkStart, 0),
+            Math.min(endExclusive - chunkStart, bytes.byteLength),
+          ),
+        );
+        if (chunkEnd >= endExclusive) {
+          await reader.cancel();
+          controller.close();
+        }
+        return;
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
