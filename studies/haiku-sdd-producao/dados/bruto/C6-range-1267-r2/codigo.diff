+  return undefined;
+}
+
+/**
+ * Lazily drop the bytes before `range.start` and stop reading after `range.end`.
+ * The source is cancelled as soon as the range is complete.
+ */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  range: ByteRange,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let offset = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const result = await reader.read();
+      if (result.done) {
+        controller.close();
+        return;
+      }
+      const chunkStart = offset;
+      offset += result.value.byteLength;
+      if (offset <= range.start) {
+        return;
+      }
+      controller.enqueue(
+        result.value.subarray(Math.max(range.start - chunkStart, 0), range.end + 1 - chunkStart),
+      );
+      if (offset > range.end) {
+        await reader.cancel();
+        controller.close();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
