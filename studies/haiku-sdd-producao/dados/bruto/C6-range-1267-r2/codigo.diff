+ * Evaluate `If-Range` (RFC 9110 section 13.1.5). An entity-tag must be identical
+ * to the current strong ETag, and a date must equal the current Last-Modified.
+ * A weak entity-tag never matches, since it cannot equal a quoted value.
+ */
+function isIfRangeValid(
+  ifRange: string,
+  etag: string | null,
+  lastModified: string | null,
+): boolean {
+  if (ifRange.startsWith('"')) {
+    return ifRange === etag;
+  }
+  if (ifRange.startsWith("W/") || lastModified === null) {
+    return false;
+  }
+  const date = Date.parse(ifRange);
+  return date === Date.parse(lastModified);
+}
+
+function setPartialHeaders(headers: Headers, range: ByteRange, size: number): void {
+  headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  headers.set("content-length", String(range.end - range.start + 1));
+}
+
+/**
