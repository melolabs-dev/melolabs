+/** Inclusive byte range, already clamped to the asset size. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+// A single `bytes` range (RFC 9110 section 14.1.2). The unit is case-insensitive.
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Resolve a `Range` header against a representation of `size` bytes (> 0).
+ *
+ * `undefined` means the header is ignored: absent, malformed, multi-range, a
+ * unit other than `bytes`, or a last byte before the first. `"unsatisfiable"`
+ * means 416. Anything else is the range to serve.
+ */
+function parseRange(header: string | null, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(header?.trim() ?? "");
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return undefined;
+  }
+  if (!first) {
+    // Suffix range: the last `n` bytes, or the whole asset when `n` is larger.
+    const length = toByteOffset(last);
+    return length === 0 ? "unsatisfiable" : { start: Math.max(size - length, 0), end: size - 1 };
+  }
+  const start = toByteOffset(first);
+  const end = last ? toByteOffset(last) : Infinity;
+  if (end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/** Digits beyond the safe integer range count as unbounded. */
+function toByteOffset(digits: string): number {
+  const value = Number(digits);
+  return Number.isSafeInteger(value) ? value : Infinity;
+}
+
