+ * sliced, or when its length is known to differ from `size`, so the caller
+ * serves the full body instead of a wrong `content-range`.
+ */
+function sliceBody(body: BodyInit, range: ByteRange, size: number): BodyInit | undefined {
+  const { start, end } = range;
+  if (typeof body === "string") {
+    const bytes = new TextEncoder().encode(body);
+    return bytes.byteLength === size ? bytes.subarray(start, end + 1) : undefined;
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.byteLength === size ? new Uint8Array(body, start, end - start + 1) : undefined;
+  }
+  if (ArrayBuffer.isView(body)) {
+    return body.byteLength === size
+      ? new Uint8Array(body.buffer, body.byteOffset + start, end - start + 1)
+      : undefined;
+  }
