+ * ETag, or an HTTP date that equals `Last-Modified` exactly (RFC 9110 section 13.1.5).
+ * Without `If-Range` the range always applies.
+ */
+function ifRangeMatches(
+  ifRange: string | null,
+  validators: { etag: string | null; lastModified: string | null },
+): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  const value = ifRange.trim();
+  if (value.startsWith('"') || isWeakEtag(value)) {
+    return (
+      validators.etag !== null &&
+      !isWeakEtag(value) &&
+      !isWeakEtag(validators.etag) &&
+      value === validators.etag
+    );
+  }
+  const date = Date.parse(value);
+  return validators.lastModified !== null && date === Date.parse(validators.lastModified);
+}
+
+function isWeakEtag(tag: string): boolean {
+  return /^w\//i.test(tag);
+}
+
+function setPartialHeaders(headers: Headers, range: ByteRange, size: number): void {
+  headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  headers.set("content-length", String(range.end - range.start + 1));
+}
+
+/**
+ * Cut `body` down to `range`. Returns `undefined` when the body's real length is not
+ * `size`, so the caller falls back to the full response instead of a 206 whose
+ * `Content-Length` the body cannot honor.
+ */
+async function sliceBody(
+  body: BodyInit,
+  range: ByteRange,
+  size: number,
+): Promise<BodyInit | undefined> {
+  const end = range.end + 1; // exclusive
+  if (body instanceof Blob) {
+    return body.size === size ? body.slice(range.start, end) : undefined;
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.byteLength === size ? body.slice(range.start, end) : undefined;
+  }
+  if (ArrayBuffer.isView(body)) {
+    if (body.byteLength !== size) {
+      return undefined;
+    }
+    const bytes = new Uint8Array(body.buffer, body.byteOffset, body.byteLength);
+    return bytes.subarray(range.start, end);
+  }
+  if (body instanceof ReadableStream) {
+    // The real length of a stream is unknown up front, so `size` is trusted.
+    return sliceStream(body, range);
+  }
+  // Strings and form bodies are measured and cut in UTF-8 bytes, as `size` is.
+  const blob = await new Response(body).blob();
+  return blob.size === size ? blob.slice(range.start, end) : undefined;
+}
+
+/** Skip to `range.start` and stop at `range.end`, cancelling the source once it is no longer needed. */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  range: ByteRange,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let position = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      const { done, value } = await reader.read();
+      if (done) {
+        controller.close();
+        return;
+      }
+      const chunkStart = position;
+      const chunkEnd = position + value.byteLength;
+      position = chunkEnd;
+      const from = Math.max(range.start, chunkStart) - chunkStart;
+      const to = Math.min(range.end + 1, chunkEnd) - chunkStart;
+      if (to > from) {
+        controller.enqueue(value.subarray(from, to));
+      }
+      if (chunkEnd > range.end) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
