+interface ByteRange {
+  /** Inclusive. */
+  start: number;
+  /** Inclusive, already limited to `size - 1`. */
+  end: number;
+}
+
+/**
+ * Parse a single `bytes=first-last` range (RFC 9110 section 14.1). Returns `undefined`
+ * for anything the server should ignore: other units, multiple ranges, bad syntax, or
+ * a backwards range such as `bytes=5-2`.
+ */
+function parseRange(header: string): { first?: number; last?: number } | undefined {
+  const match = /^bytes=(\d*)-(\d*)$/i.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, rawFirst = "", rawLast = ""] = match;
+  if (!rawFirst && !rawLast) {
+    return undefined;
+  }
+  const first = rawFirst ? Number(rawFirst) : undefined;
+  const last = rawLast ? Number(rawLast) : undefined;
+  if (first !== undefined && last !== undefined && last < first) {
+    return undefined;
+  }
+  return { first, last };
+}
+
+/**
+ * Resolve the Range header against a known, positive `size`. `undefined` means
+ * the header is ignored and the full asset is sent.
+ */
+function resolveRange(
+  header: string | null,
+  size: number,
+): ByteRange | "unsatisfiable" | undefined {
+  if (header === null) {
+    return undefined;
+  }
+  const parsed = parseRange(header);
+  if (!parsed) {
+    return undefined;
+  }
+  const { first, last } = parsed;
+  if (first === undefined) {
+    // `bytes=-n`: the last `n` bytes. A zero-length suffix selects nothing.
+    if (!last) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - last, 0), end: size - 1 };
+  }
+  if (first >= size) {
+    return "unsatisfiable";
+  }
+  return { start: first, end: last === undefined ? size - 1 : Math.min(last, size - 1) };
+}
+
+/**
