+
+/**
+ * The passwords to try, in order: `password` first, then each extra. Extras are
+ * validated against the same minimum length iron applies to `password`, and a
+ * repeat of `password` is dropped so it is not tried twice.
+ */
+function unsealPasswords(config: SessionConfig, sealOptions: SealOptions): string[] {
+  const extras = config.extraUnsealPasswords || [];
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const extra of extras) {
+    if (!extra) {
+      throw new Error("Empty password");
+    }
+    if (extra.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  // A Set keeps first occurrences, so declared order holds
+  return [...new Set([config.password, ...extras])];
+}
+
+/**
+ * Open a seal with each password in turn. Only a wrong password moves on to the
+ * next one: any other error (expiry, malformed seal) is the real cause and is
+ * thrown as it is.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  let lastError: unknown;
+  for (const password of unsealPasswords(config, sealOptions)) {
+    try {
+      return await unsealWith(sealed, password, config, sealOptions);
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+/**
+ * Open a seal with one password: the current iterations, then the legacy count
+ * when it applies.
+ */
+async function unsealWith(
+  sealed: string,
+  password: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  let unsealed: Partial<Session>;
+  try {
+    unsealed = (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !isBadHmac(error)
+    ) {
+      throw error;
+    }
+    unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+  }
+  return unsealed;
+}
+
+/** The error iron throws when the password does not verify the seal. */
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
