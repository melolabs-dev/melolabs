+/**
+ * Reject a malformed `extraUnsealPasswords`. Checked up front because an error
+ * from unsealing is swallowed by `getSession`, which would silently drop the
+ * session. Messages name the index and never the password itself.
+ */
+export function assertExtraUnsealPasswords(config: SessionConfig): void {
+  const extra = config.extraUnsealPasswords;
+  if (extra === undefined) {
+    return;
+  }
+  if (!Array.isArray(extra)) {
+    throw new Error("extraUnsealPasswords must be an array of strings");
+  }
+  // The password has to satisfy both the encryption and the integrity derivation
+  const minLength = Math.max(
+    config.seal?.encryption.minPasswordlength ?? sealDefaults.encryption.minPasswordlength,
+    config.seal?.integrity.minPasswordlength ?? sealDefaults.integrity.minPasswordlength,
+  );
+  for (const [index, password] of extra.entries()) {
+    if (typeof password !== "string") {
+      throw new Error(`extraUnsealPasswords[${index}] must be a string`);
+    }
+    if (password.length < minLength) {
+      throw new Error(
+        `extraUnsealPasswords[${index}] is empty or too short (min ${minLength} characters required)`,
+      );
+    }
+  }
+}
+
+/** Unseal with one password, retrying once with the legacy 1-iteration PBKDF2 count. */
+export async function unsealWith(
+  sealed: string,
+  password: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !isBadHmac(error)
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
