+/** Whether an unseal error means this password did not open the token. */
+export function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+/** `password` first, then the extras in order, without repeats. */
+export function candidatePasswords(config: SessionConfig): string[] {
+  return [...new Set([config.password, ...(config.extraUnsealPasswords ?? [])])];
