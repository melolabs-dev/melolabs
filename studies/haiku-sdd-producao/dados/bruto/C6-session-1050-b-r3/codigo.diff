+/**
+ * Open the seal with `config.password`, then with each extra password in order.
+ *
+ * The error from `config.password` is the one thrown when none of them opens
+ * the seal, so an invalid extra password never changes what callers observe.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session> | null> {
+  const [password, ...extras] = unsealPasswords(config);
+  try {
+    return await unsealWithPassword(sealed, password, config, sealOptions);
+  } catch (error) {
+    for (const extra of extras) {
+      try {
+        const unsealed = await unsealWithPassword(sealed, extra, config, sealOptions);
+        if (unsealed) {
+          (unsealed as any)[kStaleSeal] = true;
+        }
+        return unsealed;
+      } catch {
+        // Not this password's seal: try the next one
+      }
+    }
+    throw error;
+  }
+}
+
+/**
+ * Open the seal with one password. Falls back to the legacy 1-iteration PBKDF2
+ * count for seals that predate the current default, and marks those as stale.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session> | null> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !(error instanceof Error) ||
+      error.message !== "Bad hmac value"
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kStaleSeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+/**
+ * `config.password` followed by the extra unseal passwords, without empty
+ * entries or repeats. A repeat would cost another PBKDF2 derivation for nothing,
+ * and an entry that is not a string cannot open anything.
+ */
+function unsealPasswords(config: SessionConfig): string[] {
+  const extras = (config.extraUnsealPasswords || []).filter(
+    (password) => typeof password === "string" && password !== "" && password !== config.password,
+  );
+  return [config.password, ...new Set(extras)];
+}
