   });
 });
+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  const body = "abcdefghijklmnopqrstuvwxyz".repeat(39).slice(0, 1000); // 1000 ASCII bytes
+  const gzBody = "0123456789".repeat(30); // 300 bytes, stands in for app.js.gz
+  const files: Record<string, { body: string; encoding?: string }> = {
+    "/r/asset.txt": { body },
+    "/r/app.js": { body },
+    "/r/app.js.gz": { body: gzBody, encoding: "gzip" },
+  };
+  const meta = (id: string) => {
+    const file = files[id];
+    if (!file) {
+      return undefined;
+    }
+    return {
+      type: "text/plain",
+      etag: '"abc"',
+      mtime: 1_700_000_000_000,
+      size: file.body.length,
+      encoding: file.encoding,
+    };
+  };
+
+  beforeEach(() => {
+    t.app.all("/r/**", (event) =>
+      serveStatic(event, {
+        getMeta: meta,
+        getContents: (id) => files[id]?.body,
+        encodings: { gzip: ".gz" },
+        headers: { "cache-control": "public, max-age=60" },
+      }),
+    );
+  });
+
+  it("advertises accept-ranges on found assets only", async () => {
+    const res = await t.fetch("/r/asset.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+
+    const missing = await t.fetch("/r/missing.txt");
+    expect(missing.status).toBe(404);
+    expect(missing.headers.get("accept-ranges")).toBeNull();
+  });
+
+  it("serves byte ranges in every supported form", async () => {
+    for (const [range, expected] of [
+      ["bytes=100-199", body.slice(100, 200)],
+      ["bytes=900-", body.slice(900)],
+      ["bytes=-100", body.slice(900)],
+    ] as const) {
+      const res = await t.fetch("/r/asset.txt", { headers: { range } });
+      expect(res.status, range).toBe(206);
+      expect(await res.text(), range).toBe(expected);
+    }
+  });
+
+  it("clamps a range that ends past the end of the asset", async () => {
+    const res = await t.fetch("/r/asset.txt", { headers: { range: "bytes=500-2000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 500-999/1000");
+    expect(res.headers.get("content-length")).toBe("500");
+    expect(await res.text()).toBe(body.slice(500));
+  });
+
+  it("answers 416 for unsatisfiable ranges", async () => {
+    for (const range of ["bytes=1000-1100", "bytes=-0"]) {
+      const res = await t.fetch("/r/asset.txt", { headers: { range } });
+      expect(res.status, range).toBe(416);
+      expect(res.headers.get("content-range"), range).toBe("bytes */1000");
+      expect(res.headers.get("content-length"), range).toBe("0");
+      expect(await res.text(), range).toBe("");
+    }
+  });
+
+  it("ignores ranges it does not support and serves the full asset", async () => {
+    for (const range of [
+      "bytes=0-9,20-29",
+      "items=0-9",
+      "bytes=abc",
+      "bytes=500-100",
+      "bytes=",
+      "bytes=-",
+    ]) {
+      const res = await t.fetch("/r/asset.txt", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(await res.text(), range).toBe(body);
+    }
+  });
+
+  it("answers HEAD ranges without reading the body", async () => {
+    const getContents = vi.fn(() => body);
+    t.app.all("/head/**", (event) =>
+      serveStatic(event, {
+        getMeta: () => ({ type: "text/plain", size: 1000 }),
+        getContents,
+      }),
+    );
+
+    const res = await t.fetch("/head/a.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-9/1000");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await res.text()).toBe("");
+
+    const unsatisfiable = await t.fetch("/head/a.txt", {
+      method: "HEAD",
+      headers: { range: "bytes=1000-" },
+    });
+    expect(unsatisfiable.status).toBe(416);
+    expect(unsatisfiable.headers.get("content-range")).toBe("bytes */1000");
+
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("ranges the pre-compressed variant with its own size", async () => {
+    // The variant body is not real gzip, so only headers are asserted.
+    const res = await t.fetch("/r/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-99" },
+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-encoding")).toBe("gzip");
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/300");
+    expect(res.headers.get("content-length")).toBe("100");
+  });
+
+  it("applies If-Range with strong validators only", async () => {
+    const cases: [string, number][] = [
+      ['"xyz"', 200],
+      ['"abc"', 206],
+      ['W/"abc"', 200],
+      [new Date(1_700_000_000_000).toUTCString(), 206],
+      [new Date(1_700_000_000_000 - 60_000).toUTCString(), 200],
+      ["foo", 200],
+    ];
+    for (const [ifRange, status] of cases) {
+      const res = await t.fetch("/r/asset.txt", {
+        headers: { range: "bytes=0-9", "if-range": ifRange },
+      });
+      expect(res.status, ifRange).toBe(status);
+      expect(await res.text(), ifRange).toBe(status === 206 ? body.slice(0, 10) : body);
+    }
+  });
+
+  it("keeps 304, 405 and shared headers intact around ranges", async () => {
+    const notModified = await t.fetch("/r/asset.txt", {
+      headers: { range: "bytes=0-9", "if-none-match": '"abc"' },
+    });
+    expect(notModified.status).toBe(304);
+    expect(await notModified.text()).toBe("");
+
+    const post = await t.fetch("/r/asset.txt", {
+      method: "POST",
+      headers: { range: "bytes=0-9" },
+    });
+    expect(post.status).toBe(405);
+    expect(post.headers.get("allow")).toBe("GET, HEAD");
+
+    const full = await t.fetch("/r/app.js", { headers: { "accept-encoding": "gzip" } });
+    const partial = await t.fetch("/r/app.js", {
+      headers: { "accept-encoding": "gzip", range: "bytes=0-9" },
+    });
+    expect(full.status).toBe(200);
+    expect(partial.status).toBe(206);
+    for (const name of [
+      "etag",
+      "last-modified",
+      "cache-control",
+      "vary",
+      "content-type",
+      "content-encoding",
+    ]) {
+      expect(partial.headers.get(name), name).toBe(full.headers.get(name));
+    }
+  });
+
+  it("ignores Range when the size is zero or unknown", async () => {
+    t.app.all("/zero/**", (event) =>
+      serveStatic(event, {
+        getMeta: () => ({ type: "text/plain", size: 0 }),
+        getContents: () => body,
+      }),
+    );
+    t.app.all("/nosize/**", (event) =>
+      serveStatic(event, {
+        getMeta: () => ({ type: "text/plain" }),
+        getContents: () => body,
+      }),
+    );
+    for (const path of ["/zero/a.txt", "/nosize/a.txt"]) {
+      const res = await t.fetch(path, { headers: { range: "bytes=0-9" } });
+      expect(res.status, path).toBe(200);
+      expect(res.headers.get("content-range"), path).toBeNull();
+      expect(await res.text(), path).toBe(body);
+    }
+  });
+
+  it("slices every body type by bytes, not characters", async () => {
+    const text = "ação-✓-日本語-".repeat(20);
+    const bytes = new TextEncoder().encode(text);
+    const expected = bytes.slice(5, 41);
+    const bodies: [string, () => BodyInit][] = [
+      [
+        "ReadableStream",
+        () =>
+          new ReadableStream({
+            start(controller) {
+              controller.enqueue(bytes.slice(0, 7));
+              controller.enqueue(bytes.slice(7));
+              controller.close();
+            },
+          }),
+      ],
+      ["Blob", () => new Blob([bytes])],
+      ["Uint8Array", () => bytes],
+      ["ArrayBuffer", () => bytes.slice().buffer],
+      ["string", () => text],
+    ];
+    for (const [name, make] of bodies) {
+      t.app.all(`/cut/${name}/**`, (event) =>
+        serveStatic(event, {
+          getMeta: () => ({ type: "text/plain", size: bytes.byteLength }),
+          getContents: make,
+        }),
+      );
+      const res = await t.fetch(`/cut/${name}/a.txt`, { headers: { range: "bytes=5-40" } });
+      expect(res.status, name).toBe(206);
+      expect(new Uint8Array(await res.arrayBuffer()), name).toEqual(expected);
+    }
+  });
+});
