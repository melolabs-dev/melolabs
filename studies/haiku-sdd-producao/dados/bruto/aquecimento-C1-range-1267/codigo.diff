+// --- Range (RFC 9110 sections 13.1.5, 14) ---
+
+/** `end` is inclusive. */
+type RangeOutcome =
+  | { kind: "ignore" }
+  | { kind: "unsatisfiable" }
+  | { kind: "partial"; start: number; end: number };
+
+const RANGE_SPEC_RE = /^(\d*)-(\d*)$/;
+
+/**
+ * Evaluate the `Range` header against a representation of `size` bytes.
+ *
+ * Syntax is checked first; then `If-Range`, when it does not match, makes the
+ * whole Range ignored, even if it would be unsatisfiable (RFC 9110 section 13.1.5).
+ */
+function resolveRange(
+  headers: Headers,
+  size: number,
+  validators: { etag?: string; mtime?: Date },
+): RangeOutcome {
+  const range = headers.get("range");
+  if (range === null) {
+    return { kind: "ignore" };
+  }
+  const outcome = parseRangeValue(range, size);
+  if (outcome.kind === "ignore") {
+    return outcome;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(ifRange, validators)) {
+    return { kind: "ignore" };
+  }
+  return outcome;
+}
+
+/** Parse a single `bytes=` range spec. Multi-range, other units and malformed values are ignored. */
+function parseRangeValue(value: string, size: number): RangeOutcome {
+  const trimmed = value.trim();
+  const eq = trimmed.indexOf("=");
+  if (eq === -1 || trimmed.slice(0, eq).toLowerCase() !== "bytes") {
+    return { kind: "ignore" };
+  }
+  const spec = trimmed.slice(eq + 1).trim();
+  if (spec.includes(",")) {
+    return { kind: "ignore" };
+  }
+  const match = RANGE_SPEC_RE.exec(spec);
+  if (!match) {
+    return { kind: "ignore" };
+  }
+  const first = match[1] || "";
+  const last = match[2] || "";
+  if (first === "" && last === "") {
+    return { kind: "ignore" };
+  }
+
+  // Suffix range: the last `n` bytes. `bytes=-0` selects nothing.
+  if (first === "") {
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return { kind: "unsatisfiable" };
+    }
+    return { kind: "partial", start: Math.max(0, size - suffix), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return { kind: "ignore" };
+  }
+  if (start >= size) {
+    return { kind: "unsatisfiable" };
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { kind: "partial", start, end };
+}
+
+/**
+ * Strong comparison for `If-Range` (RFC 9110 section 13.1.5). A weak etag never
+ * matches; a date matches only by exact equality with `mtime` in whole seconds.
+ */
+function matchesIfRange(ifRange: string, validators: { etag?: string; mtime?: Date }): boolean {
+  if (ifRange.startsWith("W/")) {
+    return false;
+  }
+  if (ifRange.startsWith('"')) {
+    return (
+      validators.etag !== undefined &&
+      !validators.etag.startsWith("W/") &&
+      validators.etag === ifRange
+    );
+  }
+  if (!validators.mtime) {
+    return false;
+  }
+  const date = Date.parse(ifRange);
+  return !Number.isNaN(date) && date === validators.mtime.getTime();
+}
+
+/**
+ * Cut `body` to the bytes in `[start, endExclusive)`. Slicing is by bytes, never by characters.
+ *
+ * Memory: `Blob` is sliced lazily and `ReadableStream` is cut as it is read, but
+ * a stream is still read from its beginning because the source cannot seek.
+ * Every other type (`string`, `ArrayBuffer`, typed arrays, `FormData`, ...) is
+ * read completely into memory before the cut.
+ */
+async function sliceBody(
+  body: BodyInit | null | undefined,
+  start: number,
+  endExclusive: number,
+): Promise<BodyInit | null> {
+  if (body === null || body === undefined) {
+    return null;
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, endExclusive);
+  }
+  if (body instanceof ReadableStream) {
+    return body.pipeThrough(sliceStream(start, endExclusive));
+  }
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).slice(start, endExclusive);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body).slice(start, endExclusive);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).slice(start, endExclusive);
+  }
+  const bytes = new Uint8Array(await new Response(body).arrayBuffer());
+  return bytes.slice(start, endExclusive);
+}
+
+/** Transform that drops bytes before `start`, and terminates (cancelling the source) after `endExclusive`. */
+function sliceStream(start: number, endExclusive: number): TransformStream<Uint8Array, Uint8Array> {
+  let offset = 0;
+  return new TransformStream<Uint8Array, Uint8Array>({
+    transform(chunk, controller) {
+      const chunkStart = offset;
+      const chunkEnd = offset + chunk.byteLength;
+      offset = chunkEnd;
+      const from = Math.max(0, start - chunkStart);
+      const to = Math.min(chunk.byteLength, endExclusive - chunkStart);
+      if (from < to) {
+        controller.enqueue(chunk.subarray(from, to));
+      }
+      if (chunkEnd >= endExclusive) {
+        controller.terminate();
+      }
+    },
+  });
+}
diff --git a/test/static.test.ts b/test/static.test.ts
