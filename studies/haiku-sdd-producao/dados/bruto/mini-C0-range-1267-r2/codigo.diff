+
+describeMatrix("serve static range", (t, { it, expect }) => {
+  const data = Uint8Array.from({ length: 1000 }, (_, i) => i % 251);
+  const mtime = 1_700_000_000_000;
+  const enc = (s: string) => new TextEncoder().encode(s);
+  let getContents: ServeStaticOptions["getContents"] & ReturnType<typeof vi.fn>;
+  let body: () => any;
+  let metaOverride: Record<string, unknown>;
+  let extra: Partial<ServeStaticOptions>;
+
+  beforeEach(() => {
+    metaOverride = {};
+    extra = {};
+    body = () => data;
+    getContents = vi.fn(() => body());
+    t.app.all("/**", (event) =>
+      serveStatic(event, {
+        getContents,
+        getMeta: (id) =>
+          id.includes("404")
+            ? undefined
+            : {
+                etag: '"v1"',
+                mtime,
+                size: id.endsWith(".gz") ? 500 : 1000,
+                ...metaOverride,
+              },
+        ...extra,
+      }),
+    );
+  });
+
+  const get = (range?: string, headers: Record<string, string> = {}, method = "GET") =>
+    t.fetch("/a.bin", { method, headers: { ...(range ? { range } : {}), ...headers } });
+  const bytesOf = async (res: Response) => new Uint8Array(await res.arrayBuffer());
+
+  it("advertises ranges without Range (GET/HEAD)", async () => {
+    for (const method of ["GET", "HEAD"]) {
+      const res = await get(undefined, {}, method);
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect(res.headers.get("content-length")).toBe("1000");
+    }
+  });
+
+  it("serves partial content", async () => {
+    const table: [string, string][] = [
+      ["bytes=100-199", "bytes 100-199/1000"],
+      ["bytes=900-", "bytes 900-999/1000"],
+      ["bytes=-100", "bytes 900-999/1000"],
+      ["bytes=0-5000", "bytes 0-999/1000"],
+      ["bytes=-5000", "bytes 0-999/1000"],
+      ["Bytes=0-1", "bytes 0-1/1000"],
+    ];
+    for (const [range, cr] of table) {
+      const res = await get(range);
+      expect(res.status).toBe(206);
+      expect(res.headers.get("content-range")).toBe(cr);
+      expect(res.headers.get("etag")).toBe('"v1"');
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      const [a, b] = cr.slice(6).split("/")[0].split("-").map(Number);
+      const out = await bytesOf(res);
+      expect(res.headers.get("content-length")).toBe(String(b - a + 1));
+      expect([...out]).toEqual([...data.subarray(a, b + 1)]);
+    }
+  });
+
+  it("overrides content-length from options.headers on 206", async () => {
+    extra = { headers: { "content-length": "999" } };
+    const res = await get("bytes=0-99");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("100");
+    await res.arrayBuffer();
+  });
+
+  it("HEAD with range doesn't read contents", async () => {
+    const res = await get("bytes=0-99", {}, "HEAD");
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/1000");
+    expect(await res.text()).toBe("");
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("416 for unsatisfiable ranges", async () => {
+    extra = { headers: { "content-length": "999" } };
+    for (const method of ["GET", "HEAD"]) {
+      for (const range of ["bytes=1000-", "bytes=2000-3000", "bytes=-0"]) {
+        const res = await get(range, {}, method);
+        expect(res.status).toBe(416);
+        expect(res.headers.get("content-range")).toBe("bytes */1000");
+        expect(res.headers.get("content-length")).toBe("0");
+        expect(res.headers.get("accept-ranges")).toBe("bytes");
+        expect(await res.text()).toBe("");
+      }
+    }
+    expect(getContents).not.toHaveBeenCalled();
+  });
+
+  it("ignores invalid ranges", async () => {
+    for (const range of ["bytes=0-1,5-9", "bytes=5-2", "items=0-5", "abc", "bytes=", "bytes 0-5"]) {
+      const res = await get(range);
+      expect(res.status).toBe(200);
+      expect(res.headers.get("content-range")).toBeNull();
+      expect(res.headers.get("content-length")).toBe("1000");
+      expect(res.headers.get("accept-ranges")).toBe("bytes");
+      expect((await bytesOf(res)).length).toBe(1000);
+    }
+  });
+
+  it("does not support ranges without a known size", async () => {
+    for (const size of [undefined, 0]) {
+      metaOverride = { size };
+      const res = await get("bytes=0-9");
+      expect(res.status).toBe(200);
+      expect(res.headers.get("accept-ranges")).toBeNull();
+      expect(res.headers.get("content-range")).toBeNull();
+      await res.arrayBuffer();
+    }
+  });
+
+  it("handles If-Range", async () => {
+    const lm = new Date(mtime).toUTCString();
+    const table: [string, number][] = [
+      ['"v1"', 206],
+      ['"v2"', 200],
+      ['W/"v1"', 200],
+      [lm, 206],
+      [new Date(mtime + 5000).toUTCString(), 200],
+      ["garbage", 200],
+    ];
+    for (const [ifRange, status] of table) {
+      const res = await get("bytes=0-9", { "if-range": ifRange });
+      expect(res.status).toBe(status);
+      expect(res.headers.has("content-range")).toBe(status === 206);
+      await res.arrayBuffer();
+    }
+    metaOverride = { etag: undefined, mtime: undefined };
+    const noValidators = await get("bytes=0-9", { "if-range": '"v1"' });
+    expect(noValidators.status).toBe(200);
+    await noValidators.arrayBuffer();
+    metaOverride = {};
+    const res = await get(undefined, { "if-range": '"v1"' });
+    expect(res.status).toBe(200);
+    await res.arrayBuffer();
+    // an invalid If-Range must not turn an unsatisfiable range into 416
+    const res2 = await get("bytes=1000-", { "if-range": '"v2"' });
+    expect(res2.status).toBe(200);
+    await res2.arrayBuffer();
+  });
+
+  it("If-None-Match wins over Range", async () => {
+    const res = await get("bytes=0-9", { "if-none-match": '"v1"' });
+    expect(res.status).toBe(304);
+    expect(res.headers.has("content-range")).toBe(false);
+    expect(res.headers.has("accept-ranges")).toBe(false);
+  });
+
+  it("ranges the encoded variant", async () => {
+    extra = { encodings: { gzip: ".gz" } };
+    body = () => data.subarray(0, 500);
+    const res = await get("bytes=0-99", { "accept-encoding": "gzip" });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/500");
+    expect(res.headers.get("vary")).toBe("accept-encoding");
+    expect(res.headers.get("content-length")).toBe("100");
+    expect(getContents).toHaveBeenCalledWith("/a.bin.gz");
+    await res.arrayBuffer();
+  });
+
+  it("404 and 405 with Range", async () => {
+    expect((await t.fetch("/404", { headers: { range: "bytes=0-1" } })).status).toBe(404);
+    const res = await t.fetch("/a.bin", { method: "POST", headers: { range: "bytes=0-1" } });
+    expect(res.status).toBe(405);
+  });
+
+  const text = "0123456789";
+  const makers: Record<string, () => any> = {
+    string: () => text,
+    uint8: () => enc(text),
+    arraybuffer: () => enc(text).buffer,
+    blob: () => new Blob([text]),
+    stream: () =>
+      new ReadableStream({
+        start(c) {
+          for (const part of ["012", "34", "5678", "9"]) c.enqueue(enc(part));
+          c.close();
+        },
+      }),
+  };
+  for (const [name, make] of Object.entries(makers)) {
+    it(`slices ${name} bodies`, async () => {
+      metaOverride = { size: 10 };
+      body = make;
+      const res = await get("bytes=2-5");
+      expect(res.status).toBe(206);
+      expect(await res.text()).toBe("2345");
+    });
+  }
+
+  it("slices multibyte strings by bytes", async () => {
+    metaOverride = { size: 6 };
+    body = () => "héllo";
+    const res = await get("bytes=1-2");
+    expect(await res.text()).toBe("é");
+  });
+
+  for (const [name, make] of [
+    ["FormData", () => new FormData()],
+    ["URLSearchParams", () => new URLSearchParams("a=1")],
+  ] as const) {
+    // The node adapter errors on these bodies even without Range (unit tests cover them)
+    it.skipIf(t.target === "node")(`${name} falls back to 200`, async () => {
+      body = make;
+      const res = await get("bytes=2-5");
+      expect(res.status).toBe(200);
+      expect(res.headers.has("content-range")).toBe(false);
+      await res.arrayBuffer();
+    });
+  }
+});
diff --git a/test/unit/static-range.test.ts b/test/unit/static-range.test.ts
