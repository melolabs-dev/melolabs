+++ b/src/utils/internal/range.ts
@@ -0,0 +1,130 @@
+// `meta.size` is assumed to be the byte length of the representation actually
+// served (including any precompressed variant). A wrong size yields a
+// `Content-Range`/`Content-Length` that disagrees with the body.
+
+export type ByteRange = { start: number; end: number };
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Parse a single `byte-range-spec` (RFC 9110 section 14.1.2).
+ * Returns `undefined` when the header must be ignored.
+ */
+export function parseRange(
+  header: string | null,
+  size: number,
+): ByteRange | "unsatisfiable" | undefined {
+  const match = header === null ? null : RANGE_RE.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first, last] = match;
+  if (first === "") {
+    if (last === "") {
+      return undefined;
+    }
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - suffix, 0), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last === "" ? size - 1 : Number(last);
+  if (last !== "" && end < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/** `If-Range` check: strong ETag comparison or exact `Last-Modified` match. */
+export function isIfRangeValid(
+  ifRange: string | null,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  const value = ifRange.trim();
+  if (value.startsWith('"') || /^w\//i.test(value)) {
+    const { etag } = validators;
+    return !!etag && !/^w\//i.test(value) && !/^w\//i.test(etag) && value === etag;
+  }
+  const { lastModified } = validators;
+  return !!lastModified && value === lastModified.toUTCString();
+}
+
+/** Slice a body by bytes. Returns `undefined` when the body type can't be sliced. */
+export function sliceBody(body: BodyInit, range: ByteRange): BodyInit | undefined {
+  const { start, end } = range;
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body, start, Math.max(Math.min(end + 1, body.byteLength) - start, 0));
+  }
+  if (ArrayBuffer.isView(body)) {
+    const bytes = new Uint8Array(body.buffer, body.byteOffset, body.byteLength);
+    return bytes.subarray(start, end + 1);
+  }
+  if (typeof Blob !== "undefined" && body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (typeof ReadableStream !== "undefined" && body instanceof ReadableStream) {
+    return sliceStream(body as ReadableStream<Uint8Array>, start, end + 1);
+  }
+}
+
+function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  start: number,
+  stop: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let offset = 0;
+  let cancelled = false;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        const { done, value } = await reader.read();
+        if (cancelled) {
+          return;
+        }
+        if (done) {
+          return controller.close();
+        }
+        if (!(value instanceof Uint8Array)) {
+          const error = new TypeError("Range: stream chunks must be Uint8Array");
+          await reader.cancel(error).catch(() => {});
+          return controller.error(error);
+        }
+        const chunkStart = offset;
+        offset += value.byteLength;
+        if (offset <= start) {
+          continue;
+        }
+        const chunk = value.subarray(
+          Math.max(start - chunkStart, 0),
+          Math.max(stop - chunkStart, 0),
+        );
+        if (chunk.byteLength > 0) {
+          controller.enqueue(chunk);
+        }
+        if (offset >= stop) {
+          await reader.cancel().catch(() => {});
+          return controller.close();
+        }
+        if (chunk.byteLength > 0) {
+          return;
+        }
+      }
+    },
+    cancel(reason) {
+      cancelled = true;
+      return reader.cancel(reason);
+    },
+  });
+}
