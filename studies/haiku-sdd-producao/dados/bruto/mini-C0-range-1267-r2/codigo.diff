index 0000000..55f94a0
--- /dev/null
+++ b/test/unit/static-range.test.ts
@@ -0,0 +1,102 @@
+import { describe, it, expect, vi } from "vitest";
+import * as h3 from "../../src/index.ts";
+import { isIfRangeValid, parseRange, sliceBody } from "../../src/utils/internal/range.ts";
+
+describe("parseRange", () => {
+  const cases: [string, unknown][] = [
+    ["bytes=100-199", { start: 100, end: 199 }],
+    ["bytes=900-", { start: 900, end: 999 }],
+    ["bytes=-100", { start: 900, end: 999 }],
+    ["bytes=0-5000", { start: 0, end: 999 }],
+    ["bytes=-5000", { start: 0, end: 999 }],
+    ["Bytes=0-1", { start: 0, end: 1 }],
+    ["bytes=1000-", "unsatisfiable"],
+    ["bytes=2000-3000", "unsatisfiable"],
+    ["bytes=-0", "unsatisfiable"],
+    ["bytes=5-2", undefined],
+    ["abc", undefined],
+    ["bytes=", undefined],
+    ["bytes=-", undefined],
+    ["bytes 0-5", undefined],
+    ["bytes=0-1,5-9", undefined],
+    ["items=0-5", undefined],
+  ];
+  it.each(cases)("%s", (header, expected) => {
+    expect(parseRange(header, 1000)).toEqual(expected);
+  });
+});
+
+describe("isIfRangeValid", () => {
+  const lastModified = new Date(1_700_000_000_000);
+  it("validates", () => {
+    const v = { etag: '"v1"', lastModified };
+    expect(isIfRangeValid('"v1"', v)).toBe(true);
+    expect(isIfRangeValid('"v2"', v)).toBe(false);
+    expect(isIfRangeValid('W/"v1"', { etag: 'W/"v1"' })).toBe(false);
+    expect(isIfRangeValid('"w/123"', { etag: "w/123" })).toBe(false);
+    expect(isIfRangeValid('"x"', { etag: 'W/"x"' })).toBe(false);
+    expect(isIfRangeValid(lastModified.toUTCString(), v)).toBe(true);
+    expect(isIfRangeValid(new Date(0).toUTCString(), v)).toBe(false);
+    expect(isIfRangeValid("garbage", v)).toBe(false);
+    expect(isIfRangeValid('"v1"', {})).toBe(false);
+    expect(isIfRangeValid(lastModified.toUTCString(), {})).toBe(false);
+    expect(isIfRangeValid(null, {})).toBe(true);
+  });
+});
+
+describe("sliceBody", () => {
+  const text = async (b: BodyInit | undefined) => await new Response(b).text();
+  const range = { start: 2, end: 5 };
+  const bytes = new TextEncoder().encode("0123456789");
+
+  it("slices supported bodies", async () => {
+    const padded = new Uint8Array(14);
+    padded.set(bytes, 2);
+    const stream = new ReadableStream<Uint8Array>({
+      start(c) {
+        c.enqueue(bytes.slice(0, 3));
+        c.enqueue(bytes.slice(3, 4));
+        c.enqueue(bytes.slice(4, 8));
+        c.enqueue(bytes.slice(8));
+        c.close();
+      },
+    });
+    for (const body of [
+      "0123456789",
+      bytes,
+      padded.subarray(2, 12),
+      bytes.buffer.slice(0) as ArrayBuffer,
+      new Blob(["0123456789"]),
+      stream,
+    ]) {
+      expect(await text(sliceBody(body, range))).toBe("2345");
+    }
+  });
+
+  it("slices by bytes", async () => {
+    expect(await text(sliceBody("héllo", { start: 1, end: 2 }))).toBe("é");
+  });
+
+  it("returns undefined for unsupported bodies", () => {
+    expect(sliceBody(new FormData(), range)).toBeUndefined();
+    expect(sliceBody(new URLSearchParams("a=1"), range)).toBeUndefined();
+  });
+
+  it("cancels the source stream past the end", async () => {
+    const cancel = vi.fn();
+    const source = new ReadableStream<Uint8Array>({
+      pull(c) {
+        c.enqueue(bytes);
+      },
+      cancel,
+    });
+    expect(await text(sliceBody(source, range))).toBe("2345");
+    expect(cancel).toHaveBeenCalled();
+  });
+});
+
+it("does not export range helpers publicly", () => {
+  for (const name of ["parseRange", "isIfRangeValid", "sliceBody"]) {
+    expect(name in h3).toBe(false);
+  }
+});
