+
+/**
+ * Try `password` then `extraUnsealPasswords` with the current seal options, then
+ * (if allowed) the same list with the legacy 1-iteration options. Only a wrong
+ * password ("Bad hmac value") moves on to the next attempt. A session opened
+ * by a legacy attempt or an extra password is marked for resealing.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  const passwords = [config.password, ...(config.extraUnsealPasswords || [])];
+  let lastError: unknown;
+  for (const legacy of [false, true]) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (legacy && (config.legacySealFallback === false || sealOptions.integrity.iterations === 1)) {
+      break;
+    }
+    const options: SealOptions = legacy
+      ? {
+          ...sealOptions,
+          encryption: { ...sealOptions.encryption, iterations: 1 },
+          integrity: { ...sealOptions.integrity, iterations: 1 },
+        }
+      : sealOptions;
+    for (const [index, password] of passwords.entries()) {
+      try {
+        const unsealed = (await unseal(sealed, password, options)) as Partial<Session>;
+        if (unsealed && (legacy || index > 0)) {
+          (unsealed as any)[kLegacySeal] = true;
+        }
+        return unsealed;
+      } catch (error) {
+        if (!(error instanceof Error) || error.message !== "Bad hmac value") {
+          throw error;
+        }
+        lastError = error;
+      }
+    }
+  }
+  throw lastError;
+}
