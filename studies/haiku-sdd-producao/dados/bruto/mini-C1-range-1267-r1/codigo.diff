+/** Outcome of reading a `Range` header against an asset size. Ranges are inclusive. */
+type RangeResult =
+  | { type: "ignore" }
+  | { type: "unsatisfiable" }
+  | { type: "partial"; start: number; end: number };
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Interpret a `Range` header made of a single byte range (RFC 9110 section 14.1.1).
+ *
+ * Anything that is not one of `a-b`, `a-` or `-n` (other unit, several ranges,
+ * invalid syntax, `last < first`) is ignored, which serves the full asset. A
+ * valid range that covers no byte of an asset of `size` bytes is unsatisfiable.
+ */
+function parseRange(header: string, size: number): RangeResult {
+  const match = RANGE_RE.exec(header);
+  if (!match) {
+    return { type: "ignore" };
+  }
+  const [, first = "", last = ""] = match;
+  if (first === "") {
+    if (last === "") {
+      return { type: "ignore" };
+    }
+    // Suffix range: the last `n` bytes, or the whole asset when `n` exceeds it.
+    const suffix = Number(last);
+    if (suffix === 0 || size === 0) {
+      return { type: "unsatisfiable" };
+    }
+    return { type: "partial", start: Math.max(0, size - suffix), end: size - 1 };
+  }
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return { type: "ignore" };
+  }
+  if (start >= size) {
+    return { type: "unsatisfiable" };
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { type: "partial", start, end };
+}
+
+/**
+ * Whether `If-Range` matches the validators the client received (RFC 9110
+ * section 13.1.5). A missing `If-Range` always matches.
+ *
+ * An entity-tag only matches a strong `etag` served byte for byte, so a weak
+ * tag on either side never matches. An HTTP-date matches the served
+ * `last-modified` exactly, both sides at whole-second precision.
+ */
+function ifRangeMatches(ifRange: string | null, headers: Headers): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  if (ifRange.startsWith('"') || ifRange.startsWith('W/"')) {
+    return !ifRange.startsWith("W/") && ifRange === headers.get("etag");
+  }
+  const lastModified = headers.get("last-modified");
+  return lastModified !== null && Date.parse(ifRange) === Date.parse(lastModified);
+}
+
+/**
+ * Slice `[start, end]` (inclusive) out of a body. Blobs are sliced lazily and
+ * streams are read only up to `end`. Other body types are already in memory, so
+ * they go through a `Response` to get their bytes.
+ */
+async function sliceContents(
+  contents: BodyInit,
+  start: number,
+  end: number,
+): Promise<Blob | ReadableStream<Uint8Array>> {
+  if (contents instanceof Blob) {
+    return contents.slice(start, end + 1);
+  }
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, start, end - start + 1);
+  }
+  const blob = await new Response(contents).blob();
+  return blob.slice(start, end + 1);
+}
+
+/** Skip `start` bytes of `stream` and emit `length` bytes, cancelling the source once done. */
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  length: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let skip = start;
+  let remaining = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      let next = await reader.read();
+      while (!next.done && skip >= next.value.byteLength) {
+        skip -= next.value.byteLength;
+        next = await reader.read();
+      }
+      if (next.done) {
+        controller.close();
+        return;
+      }
+      const chunk = next.value.subarray(skip, skip + remaining);
+      skip = 0;
+      remaining -= chunk.byteLength;
+      controller.enqueue(chunk);
+      if (remaining === 0) {
+        controller.close();
+        await reader.cancel();
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
