+
+/** Inclusive byte offsets of a satisfiable range. */
+interface ByteRange {
+  start: number;
+  end: number;
+}
+
+/** `undefined` ignores `Range`, `"unsatisfiable"` answers 416, a `ByteRange` answers 206. */
+type RangeDecision = ByteRange | "unsatisfiable" | undefined;
+
+/** Evaluate `Range` and `If-Range` for an asset with a known, non-zero `size`. */
+function resolveRange(event: H3Event, meta: StaticAssetMeta, mtime?: Date): RangeDecision {
+  const header = event.req.headers.get("range");
+  if (!header || !meta.size) {
+    return undefined;
+  }
+  const ifRange = event.req.headers.get("if-range");
+  if (ifRange !== null && !isIfRangeMatch(ifRange, { etag: meta.etag, mtime })) {
+    return undefined;
+  }
+  return parseByteRange(header.trim(), meta.size);
+}
+
+/** Interpret a single `bytes` range for an asset of `size` bytes. Multiple ranges are ignored. */
+function parseByteRange(header: string, size: number): RangeDecision {
+  const match = /^bytes=(\d*)-(\d*)$/.exec(header);
+  if (!match) {
+    return undefined;
+  }
+  const [, rawStart = "", rawEnd = ""] = match;
+  if (rawStart === "") {
+    if (rawEnd === "") {
+      return undefined;
+    }
+    // A suffix of zero bytes selects nothing, so it can never be satisfied.
+    const suffix = Number(rawEnd);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+  const start = Number(rawStart);
+  if (rawEnd !== "" && Number(rawEnd) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = rawEnd === "" ? size - 1 : Math.min(Number(rawEnd), size - 1);
+  return { start, end };
+}
+
+/**
+ * Strong validator match (RFC 9110 section 13.1.5): an entity tag must equal the
+ * current strong ETag, and an HTTP date must equal the current `Last-Modified`.
+ */
+function isIfRangeMatch(ifRange: string, validators: { etag?: string; mtime?: Date }): boolean {
+  if (ifRange.startsWith('"') || ifRange.startsWith("W/")) {
+    return ifRange === validators.etag && !ifRange.startsWith("W/");
+  }
+  if (!validators.mtime) {
+    return false;
+  }
+  const date = new Date(ifRange).getTime();
+  return !Number.isNaN(date) && date === validators.mtime.getTime();
+}
+
+function partialResponse(
+  event: H3Event,
+  range: ByteRange,
+  size: number,
+  body: BodyInit | null,
+): HTTPResponse {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+  return new HTTPResponse(body, { status: 206, statusText: "Partial Content" });
+}
+
+/** Keep only the bytes of `range`. `Blob` slices lazily; other bodies are read as UTF-8 bytes. */
+async function sliceContents(contents: BodyInit, range: ByteRange): Promise<BodyInit> {
+  const end = range.end + 1;
+  if (contents instanceof Blob) {
+    return contents.slice(range.start, end);
+  }
+  const buffer = await new Response(contents).arrayBuffer();
+  return new Uint8Array(buffer, range.start, end - range.start);
+}
