+describeMatrix("serve static range", (t, { it, expect }) => {
+  const body = "0123456789".repeat(100);
+  const meta = {
+    type: "text/plain",
+    etag: '"abc"',
+    mtime: 1_700_000_000_000,
+    size: 1000,
+  };
+  let getContents = vi.fn(() => body);
+
+  beforeEach(() => {
+    getContents = vi.fn(() => body);
+    t.app.all("/**", (event) => {
+      return serveStatic(event, {
+        getContents: (id) => (id.includes("missing") ? undefined : getContents()),
+        getMeta: (id) => (id.includes("missing") ? undefined : meta),
+      });
+    });
+  });
+
+  it("advertises byte ranges on 200 (GET and HEAD)", async () => {
+    const res = await t.fetch("/file.txt");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("accept-ranges")).toBe("bytes");
+    expect(await res.text()).toBe(body);
+
+    const headRes = await t.fetch("/file.txt", { method: "HEAD" });
+    expect(headRes.status).toBe(200);
+    expect(headRes.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("neither advertises nor honors ranges without a known size", async () => {
+    for (const size of [undefined, 0]) {
+      const app = new H3().all("/**", (event) =>
+        serveStatic(event, { getMeta: () => ({ size }), getContents: () => body }),
+      );
+      const res = await app.request("/file.txt", { headers: { range: "bytes=0-9" } });
+      expect(res.status, `size ${size}`).toBe(200);
+      expect(res.headers.get("accept-ranges"), `size ${size}`).toBeNull();
+      expect(res.headers.get("content-range"), `size ${size}`).toBeNull();
+    }
+  });
+
+  it("answers a closed range with 206", async () => {
