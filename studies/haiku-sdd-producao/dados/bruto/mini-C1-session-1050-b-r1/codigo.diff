@@ -462,3 +445,79 @@ function sessionExpires(session: Session<any>, config: SessionConfig): Date | un
   }
   return times.length > 0 ? new Date(Math.min(...times)) : undefined;
 }
+
+/**
+ * Try `password`, then each of `extraUnsealPasswords`, in order. Only a wrong
+ * password (`Bad hmac value`) moves on to the next one; any other error, such as
+ * an expired seal, is thrown at once.
+ */
+async function unsealWithAnyPassword(
+  sealed: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  const passwords = [config.password, ...(config.extraUnsealPasswords || [])];
+  let lastError: unknown;
+  for (const password of passwords) {
+    try {
+      return await unsealWithPassword(sealed, password, config, sealOptions);
+    } catch (error) {
+      if (!isBadHmac(error)) {
+        throw error;
+      }
+      lastError = error;
+    }
+  }
+  throw lastError;
+}
+
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  config: SessionConfig,
+  sealOptions: SealOptions,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (
+      config.legacySealFallback === false ||
+      sealOptions.integrity.iterations === 1 ||
+      !isBadHmac(error)
+    ) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
+
+function isBadHmac(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+/**
+ * Reject short extra passwords up front, with the same rule and message the seal
+ * applies to `password`, so a bad entry is never silently skipped.
+ */
+function assertUnsealPasswords(passwords: string[], sealOptions: SealOptions): void {
+  const min = sealOptions.integrity.minPasswordlength;
+  for (const password of passwords) {
+    if (password.length < min) {
+      throw new Error(`Password string too short (min ${min} characters required)`);
+    }
+  }
+}
