 // --- Internal Utils ---
 
+type ByteRange = { start: number; end: number };
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/** Parse a single-range `Range` header. `undefined` = ignore, `"unsatisfiable"` = 416. */
+function parseRange(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = RANGE_RE.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return undefined;
+  }
+  // Numbers beyond the safe range are "past the end of the file".
+  const toNum = (s: string) => {
+    const n = Number(s);
+    return Number.isSafeInteger(n) ? n : Number.POSITIVE_INFINITY;
+  };
+  if (!first) {
+    const suffix = toNum(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+  const start = toNum(first);
+  const end = last ? toNum(last) : Number.POSITIVE_INFINITY;
+  if (last && start > end) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/** `If-Range` precondition: strong ETag comparison or exact `Last-Modified` match. */
+function isRangeConditionMet(
+  ifRange: string | null,
+  validators: { etag?: string; lastModified?: Date },
+): boolean {
+  if (ifRange === null) {
+    return true;
+  }
+  const value = ifRange.trim();
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    const { etag } = validators;
+    return !!etag && !value.startsWith("W/") && !etag.startsWith("W/") && value === etag;
+  }
+  const time = Date.parse(value);
+  return (
+    !Number.isNaN(time) && !!validators.lastModified && time === validators.lastModified.getTime()
+  );
+}
+
+/** Slice a `getContents` body to the inclusive byte range `[start, end]`. */
+async function sliceBody(body: BodyInit, start: number, end: number): Promise<BodyInit> {
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body, start, Math.max(0, Math.min(end + 1, body.byteLength) - start));
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).subarray(start, end + 1);
+  }
+  if (typeof Blob !== "undefined" && body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (typeof ReadableStream !== "undefined" && body instanceof ReadableStream) {
+    return sliceStream(body as ReadableStream<Uint8Array>, start, end + 1);
+  }
+  // Rare path (`FormData`, `URLSearchParams`): materialize as a blob, then slice.
+  const blob = await new Response(body).blob();
+  return blob.slice(start, end + 1);
+}
+
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  endExclusive: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let pos = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        if (pos >= endExclusive) {
+          controller.close();
+          await reader.cancel().catch(() => {});
+          return;
+        }
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        const chunkStart = pos;
+        pos += value.byteLength;
+        if (pos <= start) {
+          continue;
+        }
+        const chunk = value.subarray(
+          Math.max(0, start - chunkStart),
+          Math.min(value.byteLength, endExclusive - chunkStart),
+        );
+        controller.enqueue(chunk);
+        if (pos >= endExclusive) {
+          controller.close();
+          await reader.cancel().catch(() => {});
+        }
+        return;
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
+
