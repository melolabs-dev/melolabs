+
+type ByteRange = { start: number; end: number };
+type RawRange = { start: number; end?: number } | { suffix: number };
+
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/** Resolve the request `Range` against the variant size; `undefined` means serve a full 200. */
+function resolveRequestRange(
+  headers: Headers,
+  size: number,
+  lastModified: string | null,
+  etag?: string,
+): ByteRange | "unsatisfiable" | undefined {
+  const header = headers.get("range");
+  if (!header) {
+    return;
+  }
+  const parsed = parseRangeHeader(header);
+  if (!parsed) {
+    return;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !ifRangeMatches(ifRange, etag, lastModified)) {
+    return;
+  }
+  return resolveByteRange(parsed, size);
+}
+
+/** `bytes=a-b | a- | -n`; `undefined` for multi-range, other units, bad syntax or unsafe numbers. */
+function parseRangeHeader(value: string): RawRange | undefined {
+  const match = RANGE_RE.exec(value.trim());
+  if (!match) {
+    return;
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return;
+  }
+  const a = first ? Number(first) : undefined;
+  const b = last ? Number(last) : undefined;
+  if (
+    (a !== undefined && !Number.isSafeInteger(a)) ||
+    (b !== undefined && !Number.isSafeInteger(b))
+  ) {
+    return;
+  }
+  if (a === undefined) {
+    return { suffix: b! };
+  }
+  if (b !== undefined && a > b) {
+    return;
+  }
+  return { start: a, end: b };
+}
+
+function resolveByteRange(parsed: RawRange, size: number): ByteRange | "unsatisfiable" {
+  if ("suffix" in parsed) {
+    if (parsed.suffix === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - parsed.suffix, 0), end: size - 1 };
+  }
+  if (parsed.start >= size) {
+    return "unsatisfiable";
+  }
+  return { start: parsed.start, end: Math.min(parsed.end ?? size - 1, size - 1) };
+}
+
+/** `If-Range` with strong comparison (RFC 9110 section 13.1.5). */
+function ifRangeMatches(value: string, etag: string | undefined, lastModified: string | null) {
+  value = value.trim();
+  if (value.startsWith("W/")) {
+    return false;
+  }
+  if (value.startsWith('"')) {
+    return !!etag && !etag.startsWith("W/") && etag === value;
+  }
+  return !!lastModified && value === lastModified;
+}
+
+/** Slice the inclusive byte range `[start, end]` out of a body. */
+function sliceBody(body: BodyInit, start: number, end: number): BodyInit {
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body, start, end - start + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset + start, end - start + 1);
+  }
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  const stream = body instanceof ReadableStream ? body : new Response(body).body;
+  return sliceStream(stream as ReadableStream<Uint8Array>, start, end - start + 1);
+}
+
+function sliceStream(
+  stream: ReadableStream<Uint8Array>,
+  start: number,
+  length: number,
+): ReadableStream<Uint8Array> {
+  const reader = stream.getReader();
+  let skip = start;
+  let left = length;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      while (true) {
+        if (left <= 0) {
+          await reader.cancel();
+          controller.close();
+          return;
+        }
+        const { done, value } = await reader.read();
+        if (done) {
+          controller.close();
+          return;
+        }
+        let chunk = value;
+        if (skip > 0) {
+          if (skip >= chunk.byteLength) {
+            skip -= chunk.byteLength;
+            continue;
+          }
+          chunk = chunk.subarray(skip);
+          skip = 0;
+        }
+        if (chunk.byteLength > left) {
+          chunk = chunk.subarray(0, left);
+        }
+        left -= chunk.byteLength;
+        controller.enqueue(chunk);
+        return;
+      }
+    },
+    cancel: (reason) => reader.cancel(reason),
+  });
+}
