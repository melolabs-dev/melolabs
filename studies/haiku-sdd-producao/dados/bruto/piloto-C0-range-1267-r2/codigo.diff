+          : (over.meta ?? {
+              size: id.endsWith(".gz") ? 6 : 10,
+              etag: '"v1"',
+              mtime,
+              type: "text/plain",
+              encoding: id.endsWith(".gz") ? "x-test" : undefined,
+            }),
+      ),
+      headers: { "cache-control": "public, max-age=60" },
+      encodings: { gzip: ".gz" },
