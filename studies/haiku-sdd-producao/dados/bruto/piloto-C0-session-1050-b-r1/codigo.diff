diff --git a/test/session-rotation.test.ts b/test/session-rotation.test.ts
new file mode 100644
index 0000000..ed72d7e
--- /dev/null
+++ b/test/session-rotation.test.ts
@@ -0,0 +1,175 @@
+import { describe, it as vit, expect as vexpect, vi } from "vitest";
+import { getSession, useSession, updateSession, sealSession, unsealSession } from "../src/index.ts";
+import type { SessionConfig } from "../src/utils/session.ts";
+import * as iron from "../src/utils/internal/iron-crypto.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+vi.mock("../src/utils/internal/iron-crypto.ts", async (orig) => {
+  const actual = await orig<typeof import("../src/utils/internal/iron-crypto.ts")>();
+  return { ...actual, unseal: vi.fn(actual.unseal) };
+});
+
+const P0 = "p0-0000000000000000000000000000000000000";
+const P1 = "p1-1111111111111111111111111111111111111";
+const P2 = "p2-2222222222222222222222222222222222222";
+const base: SessionConfig = { name: "rot", password: P2, generateId: () => "new-id" };
+const legacyOpts = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+const payload = () => ({ id: "old", createdAt: Date.now(), data: { foo: "bar" } });
+const cookieOf = (res: Response) =>
+  decodeURIComponent(res.headers.getSetCookie()[0].match(/rot=([^;]+)/)![1]);
+
+describeMatrix("session rotation", (t, { it, expect }) => {
+  const config = { ...base, extraUnsealPasswords: [P1, P0] };
+
+  it("opens sessions sealed with any listed password and reseals with password", async () => {
+    t.app.get("/read", async (event) => ({ session: await getSession(event, config) }));
+    for (const p of [P2, P1, P0]) {
+      const res = await t.fetch("/read", {
+        headers: { Cookie: `rot=${await seal(payload(), p, sealDefaults)}` },
+      });
+      expect((await res.json()).session).toMatchObject({ id: "old", data: { foo: "bar" } });
+      if (p === P2) {
+        expect(res.headers.getSetCookie()).toHaveLength(0);
+      } else {
+        expect(res.headers.getSetCookie()).toHaveLength(1);
+        const resealed = cookieOf(res);
+        expect(await unseal(resealed, P2, sealDefaults)).toMatchObject({ id: "old" });
+        await expect(unseal(resealed, p, sealDefaults)).rejects.toThrow("Bad hmac value");
+      }
+    }
+  });
+
+  it("does not reseal sessions from the header", async () => {
+    t.app.get("/read", async (event) => ({ session: await getSession(event, config) }));
+    const res = await t.fetch("/read", {
+      headers: { "x-rot-session": await seal(payload(), P1, sealDefaults) },
+    });
+    expect((await res.json()).session.id).toBe("old");
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("unknown password gives a fresh session", async () => {
+    t.app.get("/read", async (event) => ({ session: await getSession(event, config) }));
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `rot=${await seal(payload(), "x".repeat(40), sealDefaults)}` },
+    });
+    expect((await res.json()).session).toMatchObject({ id: "new-id", data: {} });
+  });
+
+  it("opens and reseals legacy sessions sealed with an extra password", async () => {
+    t.app.get("/read", async (event) => ({ session: await getSession(event, config) }));
+    const res = await t.fetch("/read", {
+      headers: { Cookie: `rot=${await seal(payload(), P1, legacyOpts)}` },
+    });
+    expect((await res.json()).session.id).toBe("old");
+    expect(await unseal(cookieOf(res), P2, sealDefaults)).toMatchObject({ id: "old" });
+  });
+
+  it("legacySealFallback: false rejects legacy sessions", async () => {
+    t.app.get("/strict", async (event) => ({
+      session: await getSession(event, { ...config, legacySealFallback: false }),
+    }));
+    const res = await t.fetch("/strict", {
+      headers: { Cookie: `rot=${await seal(payload(), P1, legacyOpts)}` },
+    });
+    expect((await res.json()).session.id).toBe("new-id");
+  });
+
+  it("rejects expired sessions", async () => {
+    t.app.get("/age", async (event) => ({
+      session: await getSession(event, { ...config, maxAge: 10 }),
+    }));
+    const old = { ...payload(), createdAt: Date.now() - 60_000 };
+    const res = await t.fetch("/age", {
+      headers: { Cookie: `rot=${await seal(old, P1, { ...sealDefaults, ttl: 0 })}` },
+    });
+    expect((await res.json()).session.id).toBe("new-id");
+  });
+
+  it("validates extra passwords when sealing, in any position", async () => {
+    for (const extra of [
+      ["", P1],
+      [P1, "short"],
+      [P1, P0, ""],
+    ]) {
+      const path = `/bad${extra.length}${extra.join("").length}`;
+      t.app.get(path, async (event) => {
+        try {
+          await useSession(event, { ...base, extraUnsealPasswords: extra });
+          return "ok";
+        } catch (error: any) {
+          return error.message;
+        }
+      });
+      expect(await (await t.fetch(path)).text()).toMatch(/password/i);
+    }
+  });
+});
+
+describe("session rotation (direct)", () => {
+  vit("sealSession rejects invalid extras while reads skip them", async () => {
+    const bad = { ...base, extraUnsealPasswords: ["short", P1] };
+    const event: any = {
+      req: new Request("http://localhost/", {
+        headers: { Cookie: `rot=${await seal(payload(), P1, sealDefaults)}` },
+      }),
+      context: {},
+    };
+    vexpect((await getSession(event, bad)).id).toBe("old");
+    await vexpect(sealSession(event, bad)).rejects.toThrow(/password/i);
+    await vexpect(updateSession(event, bad)).resolves.toBeDefined(); // no res: nothing sealed
+  });
+
+  vit("unsealSession accepts extras and never seals with them", async () => {
+    const sealed = await seal(payload(), P0, sealDefaults);
+    const cfg = { ...base, extraUnsealPasswords: [P1, P0] };
+    vexpect(await unsealSession({} as any, cfg, sealed)).toMatchObject({ id: "old" });
+    await vexpect(unsealSession({} as any, base, sealed)).rejects.toThrow("Bad hmac value");
+  });
+});
+
+describe("unseal attempts", () => {
+  const unsealMock = vi.mocked(iron.unseal);
+  const run = async (cfg: SessionConfig, sealed: string) => {
+    unsealMock.mockClear();
+    await unsealSession({} as any, cfg, sealed).catch(() => {});
+    return unsealMock.mock.calls.map((c) => c[1]);
+  };
+
+  vit("tries only password when it opens the session", async () => {
+    const sealed = await seal(payload(), P2, sealDefaults);
+    vexpect(await run({ ...base, extraUnsealPasswords: [P1, P0] }, sealed)).toEqual([P2]);
+  });
+
+  vit("stops at the first extra that opens and never tries later ones", async () => {
+    const sealed = await seal(payload(), P1, sealDefaults);
+    vexpect(await run({ ...base, extraUnsealPasswords: [P1, P0] }, sealed)).toEqual([P2, P2, P1]);
+  });
+
+  vit("tries every candidate once (plus legacy) for unknown passwords", async () => {
+    const sealed = await seal(payload(), "x".repeat(40), sealDefaults);
+    vexpect(await run({ ...base, extraUnsealPasswords: [P1, P0] }, sealed)).toEqual([
+      P2,
+      P2,
+      P1,
+      P1,
+      P0,
+      P0,
+    ]);
+  });
+
+  vit("without extras matches the current sequence", async () => {
+    const sealed = await seal(payload(), P1, sealDefaults);
+    vexpect(await run(base, sealed)).toEqual([P2, P2]);
+    vexpect(await run({ ...base, extraUnsealPasswords: [] }, sealed)).toEqual([P2, P2]);
+  });
+
+  vit("does not advance on non-hmac errors", async () => {
+    vexpect(await run({ ...base, extraUnsealPasswords: [P1] }, "garbage")).toEqual([P2]);
+  });
+});
