+type ByteRange = { start: number; end: number };
+
+/** Digit runs longer than this are ignored rather than losing precision in `Number`. */
+const MAX_RANGE_DIGITS = 15;
+
+/**
+ * Parse a single `bytes` range (RFC 9110 section 14.1.1 and 14.1.2).
+ *
+ * Returns `undefined` to ignore the header (malformed, other unit, multi-range,
+ * or `a > b`), `"unsatisfiable"` for a 416, or the byte range to serve as 206.
+ */
+function parseRangeHeader(header: string, size: number): ByteRange | "unsatisfiable" | undefined {
+  const match = /^bytes=(\d*)-(\d*)$/i.exec(header.trim());
+  if (!match) {
+    return undefined;
+  }
+  const [, rawStart = "", rawEnd = ""] = match;
+  if (rawStart === "" && rawEnd === "") {
+    return undefined;
+  }
+  if (rawStart.length > MAX_RANGE_DIGITS || rawEnd.length > MAX_RANGE_DIGITS) {
+    return undefined;
+  }
+
+  // Suffix range: the last `n` bytes.
+  if (rawStart === "") {
+    const suffix = Number(rawEnd);
+    if (suffix === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+
+  const start = Number(rawStart);
+  const end = rawEnd === "" ? size - 1 : Number(rawEnd);
+  if (rawEnd !== "" && start > end) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/**
+ * Evaluate `If-Range` (RFC 9110 section 13.1.5). Only a strong entity-tag that
+ * matches the current ETag keeps the Range. HTTP-date values do not match.
+ */
+function ifRangeMatches(ifRange: string, etag: string | undefined): boolean {
+  if (!etag || !(ifRange.startsWith('"') || ifRange.startsWith('W/"'))) {
+    return false;
+  }
+  return strongETagMatch(ifRange, etag);
+}
+
+/** Strong comparison (RFC 9110 section 8.8.3.2): false when either side is weak. */
+function strongETagMatch(a: string, b: string): boolean {
+  if (a.startsWith("W/") || b.startsWith("W/")) {
+    return false;
+  }
+  return a === b;
+}
+
+/**
+ * Return only the `[start, end]` bytes of a body. A `Blob` is sliced lazily.
+ * Other bodies are streamed, and the source is terminated after `end`, so the
+ * rest of the asset is not read.
+ */
+function sliceBody(body: BodyInit, start: number, end: number): BodyInit {
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  let position = 0;
+  return new Response(body).body!.pipeThrough(
+    new TransformStream<Uint8Array, Uint8Array>({
+      transform(chunk, controller) {
+        const chunkStart = position;
+        const chunkEnd = position + chunk.byteLength;
+        position = chunkEnd;
+        if (chunkEnd > start) {
+          const from = Math.max(0, start - chunkStart);
+          const to = Math.min(chunk.byteLength, end + 1 - chunkStart);
+          if (from < to) {
+            controller.enqueue(chunk.subarray(from, to));
+          }
+        }
+        if (chunkEnd > end) {
+          controller.terminate();
+        }
+      },
+    }),
+  );
+}
+
+function partialResponse(
+  event: H3Event,
+  body: BodyInit | null,
+  range: ByteRange,
+  size: number,
+): HTTPResponse {
+  event.res.headers.set("content-range", `bytes ${range.start}-${range.end}/${size}`);
+  event.res.headers.set("content-length", String(range.end - range.start + 1));
+  return new HTTPResponse(body, { status: 206, statusText: "Partial Content" });
+}
