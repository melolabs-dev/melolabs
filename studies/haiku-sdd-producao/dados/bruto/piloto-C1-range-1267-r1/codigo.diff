+  });
+
+  it("falls through with a Range header on a missing asset", async () => {
+    const res = await t.fetch("/ft/missing.txt", {
+      headers: { range: "bytes=0-4", "accept-encoding": "identity" },
+    });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toEqual({ fallthroughTest: "passing" });
