+    expect(partial.status).toBe(206);
+    for (const name of ["etag", "cache-control", "vary", "last-modified"]) {
+      expect(partial.headers.get(name), name).toBe(full.headers.get(name));
+    }
+  });
+
+  it("keeps 405 for non-GET methods", async () => {
+    const res = await t.fetch("/file.bin", {
+      method: "POST",
+      headers: { range: "bytes=0-9" },
+    });
+    expect(res.status).toBe(405);
+  });
+
+  it("keeps 404 for a missing asset with a Range", async () => {
+    const res = await t.fetch("/missing.bin", { headers: { range: "bytes=0-9" } });
+    expect(res.status).toBe(404);
+  });
+
+  it("ignores the Range when size is 0 or unknown", async () => {
+    for (const path of ["/empty.bin", "/nosize.bin"]) {
+      const res = await t.fetch(path, { headers: { range: "bytes=0-9" } });
+      expect(res.status, path).toBe(200);
+      expect(res.headers.get("content-range"), path).toBeNull();
+    }
+  });
+});
+
+describe("serve static range (fallthrough)", () => {
+  it("passes a missing asset with a Range to the next handler", async () => {
+    const options: ServeStaticOptions = {
+      getContents: () => undefined,
+      getMeta: () => undefined,
+      fallthrough: true,
+    };
+    const app = new H3().use((event) => serveStatic(event, options)).use(() => "next");
