+  let getContentsCalls = 0;
+
+  beforeEach(() => {
+    getContentsCalls = 0;
+    const options: ServeStaticOptions = {
+      getMeta: (id) => {
+        if (id === "/file.bin.gz") {
+          return {
+            type: "application/octet-stream",
+            etag,
+            mtime,
+            size: 300,
+            encoding: "x-precompressed",
+          };
+        }
+        if (id === "/file.bin") {
+          return { type: "application/octet-stream", etag, mtime, size: 1000 };
+        }
+        if (id === "/empty.bin") {
+          return { type: "application/octet-stream", etag, mtime, size: 0 };
+        }
+        if (id === "/nosize.bin") {
+          return { type: "application/octet-stream", etag, mtime };
+        }
+        return undefined;
+      },
+      getContents: (id) => {
+        getContentsCalls++;
+        return id === "/file.bin.gz" ? gzBody : body;
+      },
+      // A custom coding name: undici decodes gzip/br bodies on the client, and
+      // a partial body is not a valid stream. serveStatic does not depend on
+      // the coding name, only on the variant extension.
+      encodings: { "x-precompressed": ".gz" },
+      headers: { "cache-control": "public, max-age=60" },
+    };
+    t.app.all("/**", (event) => serveStatic(event, options));
+  });
+
+  const bytesOf = async (res: Response) => new Uint8Array(await res.arrayBuffer());
+
+  it("advertises Accept-Ranges on a full GET, a 304 and a HEAD", async () => {
+    const get = await t.fetch("/file.bin");
+    expect(get.status).toBe(200);
+    expect(get.headers.get("accept-ranges")).toBe("bytes");
+
+    const notModified = await t.fetch("/file.bin", { headers: { "if-none-match": etag } });
+    expect(notModified.status).toBe(304);
+    expect(notModified.headers.get("accept-ranges")).toBe("bytes");
+
+    const head = await t.fetch("/file.bin", { method: "HEAD" });
+    expect(head.headers.get("accept-ranges")).toBe("bytes");
+  });
+
+  it("serves byte ranges with exact bytes", async () => {
+    const cases: [string, number, number][] = [
+      ["bytes=100-199", 100, 199],
+      ["bytes=900-", 900, 999],
+      ["bytes=-50", 950, 999],
