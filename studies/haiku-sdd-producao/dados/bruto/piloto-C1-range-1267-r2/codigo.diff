+    for (const [range, start, end] of cases) {
+      const res = await t.fetch("/file.bin", { headers: { range } });
+      expect(res.status, range).toBe(206);
+      expect(await bytesOf(res), range).toEqual(body.slice(start, end + 1));
+    }
+  });
+
+  it("clamps an end past the asset size", async () => {
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=990-2000" } });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 990-999/1000");
+    expect(res.headers.get("content-length")).toBe("10");
+    expect(await bytesOf(res)).toHaveLength(10);
+  });
+
+  it("answers 416 with no body for a start at or past the size", async () => {
+    const res = await t.fetch("/file.bin", { headers: { range: "bytes=1000-1100" } });
+    expect(res.status).toBe(416);
+    expect(res.headers.get("content-range")).toBe("bytes */1000");
+    expect(res.headers.get("content-length")).toBe("0");
+    expect(await res.text()).toBe("");
+  });
+
+  it("ignores multi-range, unknown units and malformed ranges", async () => {
+    for (const range of ["bytes=0-1,5-9", "items=0-1", "bytes=9-3", "bytes=abc"]) {
+      const res = await t.fetch("/file.bin", { headers: { range } });
+      expect(res.status, range).toBe(200);
+      expect(res.headers.get("content-range"), range).toBeNull();
+      expect(await bytesOf(res), range).toHaveLength(1000);
