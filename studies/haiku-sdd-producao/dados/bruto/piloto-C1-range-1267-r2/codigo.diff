+    expect(await bytesOf(mismatch)).toHaveLength(1000);
+
+    const weak = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": `W/${etag}` },
+    });
+    expect(weak.status).toBe(200);
+  });
+
+  it("applies the range when If-Range carries the Last-Modified date", async () => {
+    const lastModified = new Date(mtime).toUTCString();
+    const match = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": lastModified },
+    });
+    expect(match.status).toBe(206);
+
+    const other = new Date(mtime - 1000).toUTCString();
+    const mismatch = await t.fetch("/file.bin", {
+      headers: { range: "bytes=0-9", "if-range": other },
+    });
+    expect(mismatch.status).toBe(200);
+  });
+
+  it("answers 304 for a matching If-None-Match even with a Range", async () => {
