+    });
+    expect(res.status).toBe(206);
+    expect(res.headers.get("content-range")).toBe("bytes 0-99/300");
+    expect(res.headers.get("content-encoding")).toBe("x-precompressed");
+    expect(res.headers.get("content-length")).toBe("100");
