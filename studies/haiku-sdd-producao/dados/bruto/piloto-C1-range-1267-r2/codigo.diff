new file mode 100644
index 0000000..958ad8f
--- /dev/null
+++ b/src/utils/internal/range.ts
@@ -0,0 +1,157 @@
+// HTTP Range helpers for `serveStatic` (RFC 9110, section 14).
+// Internal module: not re-exported from `src/index.ts`, so it adds no public API.
+
+export type RangeResult =
+  | { type: "full" }
+  | { type: "partial"; start: number; end: number; size: number }
+  | { type: "unsatisfiable"; size: number };
+
+interface RangeValidators {
+  size: number | undefined;
+  etag?: string;
+  lastModified?: Date;
+}
+
+/**
+ * Evaluate the request `Range` header against the asset.
+ *
+ * Only a single `bytes` range is honored. Multi-range, other units, malformed
+ * syntax, `start > end`, unsafe integers and an `If-Range` that does not match
+ * all yield `full`, which means the caller serves the whole representation.
+ */
+export function resolveRange(headers: Headers, validators: RangeValidators): RangeResult {
+  const header = headers.get("range");
+  const size = validators.size;
+  if (header === null || size === undefined || !Number.isSafeInteger(size) || size <= 0) {
+    return { type: "full" };
+  }
+  if (!ifRangeMatches(headers.get("if-range"), validators)) {
+    return { type: "full" };
+  }
+  const spec = parseRangeHeader(header);
+  if (!spec) {
+    return { type: "full" };
+  }
+  if ("suffix" in spec) {
+    if (spec.suffix === 0) {
+      return { type: "unsatisfiable", size };
+    }
+    return { type: "partial", start: Math.max(0, size - spec.suffix), end: size - 1, size };
+  }
+  if (spec.start >= size) {
+    return { type: "unsatisfiable", size };
+  }
+  const end = Math.min(spec.end ?? size - 1, size - 1);
+  return { type: "partial", start: spec.start, end, size };
+}
+
+/**
+ * Slice a body to the inclusive byte range `start`-`end`, returning exactly
+ * `end - start + 1` bytes for every supported type. Blobs and streams are not
+ * read into memory in full.
+ */
+export async function sliceBody(
+  body: BodyInit | null | undefined,
+  start: number,
+  end: number,
+): Promise<BodyInit | null> {
+  if (body === null || body === undefined) {
+    return null;
+  }
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).subarray(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return body.slice(start, end + 1);
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset + start, end - start + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ReadableStream) {
+    return body.pipeThrough(sliceStream(start, end));
+  }
+  return (await new Response(body).arrayBuffer()).slice(start, end + 1);
+}
+
+type RangeSpec = { start: number; end?: number } | { suffix: number };
+
+/** Parse `bytes=a-b`, `bytes=a-` or `bytes=-n`. Anything else is `undefined`. */
+function parseRangeHeader(header: string): RangeSpec | undefined {
+  const equals = header.indexOf("=");
+  if (equals === -1 || header.slice(0, equals).toLowerCase() !== "bytes") {
+    return undefined;
+  }
+  const match = /^(\d*)-(\d*)$/.exec(header.slice(equals + 1).trim());
+  if (!match) {
+    return undefined;
+  }
+  const first = match[1] ?? "";
+  const last = match[2] ?? "";
+  if (first === "") {
+    if (last === "") {
+      return undefined;
+    }
+    const suffix = Number(last);
+    return Number.isSafeInteger(suffix) ? { suffix } : undefined;
+  }
+  const start = Number(first);
+  if (!Number.isSafeInteger(start)) {
+    return undefined;
+  }
+  if (last === "") {
+    return { start };
+  }
+  const end = Number(last);
+  if (!Number.isSafeInteger(end) || start > end) {
+    return undefined;
+  }
+  return { start, end };
+}
+
+/**
+ * `If-Range` absent: applies. Entity-tag: strong comparison against the asset
+ * ETag. HTTP-date: applies only when it equals `Last-Modified` exactly.
+ */
+function ifRangeMatches(value: string | null, validators: RangeValidators): boolean {
+  if (value === null) {
+    return true;
+  }
+  if (value.startsWith('"') || value.startsWith('W/"')) {
+    return validators.etag !== undefined && strongETagEquals(value, validators.etag);
+  }
+  if (!validators.lastModified) {
+    return false;
+  }
+  const date = Date.parse(value);
+  return !Number.isNaN(date) && date === validators.lastModified.getTime();
+}
+
+function strongETagEquals(a: string, b: string): boolean {
+  return !a.startsWith("W/") && !b.startsWith("W/") && a === b;
+}
+
+function sliceStream(start: number, end: number): TransformStream<Uint8Array, Uint8Array> {
+  let offset = 0;
+  return new TransformStream<Uint8Array, Uint8Array>({
+    transform(chunk, controller) {
+      const chunkStart = offset;
+      const chunkEnd = offset + chunk.byteLength;
+      offset = chunkEnd;
+      if (chunkEnd <= start) {
+        return;
+      }
+      const from = Math.max(0, start - chunkStart);
+      const to = Math.min(chunk.byteLength, end + 1 - chunkStart);
+      if (to > from) {
+        controller.enqueue(chunk.subarray(from, to));
+      }
+      if (chunkEnd > end) {
+        // Past the range: close the output and cancel the source.
+        controller.terminate();
+      }
+    },
+  });
+}
