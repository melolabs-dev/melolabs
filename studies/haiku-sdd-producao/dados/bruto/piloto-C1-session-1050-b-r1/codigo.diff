+/** Sealed value of a `Set-Cookie` header for the session cookie */
+function sealedFrom(setCookie: string): string {
+  return decodeURIComponent(setCookie.match(/^[^=]+=([^;]+)/)![1]!);
+}
+
+/** `name=value` part of a `Set-Cookie` header, for use in a `Cookie` request header */
+function cookieFrom(setCookie: string): string {
+  return setCookie.split(";")[0]!;
+}
+
+/** Cookie request header for a sealed value split into `name.N` chunks */
+function chunkedCookieHeader(name: string, sealed: string, size = 80): string {
+  const parts: string[] = [];
+  for (let i = 0; i < sealed.length; i += size) {
+    parts.push(encodeURIComponent(sealed.slice(i, i + size)));
+  }
+  return [
+    `${name}=__chunked__${parts.length}`,
+    ...parts.map((part, i) => `${name}.${i + 1}=${part}`),
+  ].join("; ");
+}
+
+async function attempt(fn: () => Promise<unknown>): Promise<{ error?: string }> {
+  try {
+    await fn();
+    return {};
