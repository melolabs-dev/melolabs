+
+/** Options shared by sealing and unsealing, so both always agree. */
+function resolveSealOptions(
+  config: Pick<SessionConfig, "maxAge" | "idleTimeout" | "seal">,
+): SealOptions {
+  return {
+    ...sealDefaults,
+    ttl: (config.maxAge || config.idleTimeout || 0) * 1000,
+    ...config.seal,
+  };
+}
+
+function isValidPassword(password: unknown, sealOptions: SealOptions): boolean {
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  return typeof password === "string" && password.length > 0 && password.length >= minLength;
+}
+
+/**
+ * Reject invalid passwords before anything is sealed. The error names the
+ * offending option but never includes its value.
+ */
+function assertSessionPasswords(config: SessionConfig, sealOptions: SealOptions): void {
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  const invalid = (label: string) =>
+    new Error(
+      `Invalid session password: ${label} must be a non-empty string with at least ${minLength} characters.`,
+    );
+  if (!isValidPassword(config.password, sealOptions)) {
+    throw invalid("password");
+  }
+  for (const [index, password] of (config.extraUnsealPasswords ?? []).entries()) {
+    if (!isValidPassword(password, sealOptions)) {
+      throw invalid(`extraUnsealPasswords[${index}]`);
+    }
+  }
+}
+
+function isBadHmacError(error: unknown): boolean {
+  return error instanceof Error && error.message === "Bad hmac value";
+}
+
+/**
+ * Unseal with one password. Falls back to the legacy 1-iteration seal when the
+ * session was sealed that way, and marks the result with `kLegacySeal`.
+ * Throws "Bad hmac value" when this password does not open the session.
+ */
+async function unsealWithPassword(
+  sealed: string,
+  password: string,
+  sealOptions: SealOptions,
+  legacySealFallback: boolean,
+): Promise<Partial<Session>> {
+  try {
+    return (await unseal(sealed, password, sealOptions)) as Partial<Session>;
+  } catch (error) {
+    // TODO: Remove this fallback (and `legacySealFallback`) in v3. Removing it
+    // in a v2 release would invalidate existing sessions sealed with 1 iteration.
+    // Sessions sealed before the default PBKDF2 iterations were raised from 1
+    // to 8192 fail HMAC verification; retry with the legacy count so existing
+    // sessions survive the upgrade (getSession reseals them with the current
+    // options).
+    if (!legacySealFallback || sealOptions.integrity.iterations === 1 || !isBadHmacError(error)) {
+      throw error;
+    }
+    const unsealed = (await unseal(sealed, password, {
+      ...sealOptions,
+      encryption: { ...sealOptions.encryption, iterations: 1 },
+      integrity: { ...sealOptions.integrity, iterations: 1 },
+    })) as Partial<Session>;
+    if (unsealed) {
+      (unsealed as any)[kLegacySeal] = true;
+    }
+    return unsealed;
+  }
+}
