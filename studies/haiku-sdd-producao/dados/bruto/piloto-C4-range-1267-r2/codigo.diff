+
+type ByteRangeResult =
+  | { kind: "none" } // ignore Range: serve the full 200
+  | { kind: "unsatisfiable" } // 416
+  | { kind: "partial"; start: number; end: number }; // 206, inclusive bounds
+
+/**
+ * Resolve the `Range` header against the selected representation (RFC 9110 section 14).
+ *
+ * Only a single `bytes` range is honored. Anything else (multi-range, other units,
+ * malformed syntax, `If-Range` mismatch, unknown size) is ignored.
+ */
+function resolveRange(headers: Headers, meta: { size?: number; etag?: string }): ByteRangeResult {
+  const value = headers.get("range");
+  if (value === null || meta.size === undefined) {
+    return { kind: "none" };
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !matchesIfRange(ifRange, meta.etag)) {
+    return { kind: "none" };
+  }
+  const parsed = parseSingleByteRange(value, meta.size);
+  if (parsed === undefined) {
+    return { kind: "none" };
+  }
+  if (parsed === "unsatisfiable") {
+    return { kind: "unsatisfiable" };
+  }
+  return { kind: "partial", start: parsed.start, end: parsed.end };
+}
+
+// `bytes=a-b`, `bytes=a-` and `bytes=-n`. The unit is a token, so it is case-insensitive.
+const BYTE_RANGE_RE = /^bytes=(?:(\d+)-(\d*)|-(\d+))$/i;
+
+/**
+ * Parse one byte range against a known size.
+ *
+ * Returns `undefined` to ignore the header, `"unsatisfiable"` for a 416, or the
+ * inclusive bounds. `bytes=-0` is treated as unsatisfiable and `bytes=-n` with
+ * `n > size` as the whole file (both assumed, see sdd/prd.md section 5).
+ */
+function parseSingleByteRange(
+  value: string,
+  size: number,
+): { start: number; end: number } | "unsatisfiable" | undefined {
+  const match = BYTE_RANGE_RE.exec(value);
+  if (!match) {
+    return undefined;
+  }
+  const [, first, last, suffix] = match;
+
+  if (suffix !== undefined) {
+    const length = Number(suffix);
+    if (length === 0 || size === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(size - length, 0), end: size - 1 };
+  }
+
+  const start = Number(first);
+  if (last !== "" && Number(last) < start) {
+    return undefined;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  return { start, end };
+}
+
+/**
+ * Strong entity-tag comparison (RFC 9110 section 13.1.5). Dates and weak tags never match.
+ */
+function matchesIfRange(ifRange: string, etag: string | undefined): boolean {
+  return etag !== undefined && ifRange.startsWith('"') && etag.startsWith('"') && ifRange === etag;
+}
+
+const encoder = new TextEncoder();
+
+/**
+ * Slice `contents` to the inclusive byte range `[start, end]`.
+ *
+ * Streams are sliced lazily so large media does not get buffered. Other
+ * unsupported body types fall back to a full buffer.
+ */
+async function sliceContents(
+  contents: BodyInit | null | undefined,
+  start: number,
+  end: number,
+): Promise<BodyInit | null> {
+  if (contents === null || contents === undefined) {
+    return null;
+  }
+  const endExclusive = end + 1;
+  if (typeof contents === "string") {
+    return encoder.encode(contents).slice(start, endExclusive);
+  }
+  if (contents instanceof ArrayBuffer) {
+    return contents.slice(start, endExclusive);
+  }
+  if (ArrayBuffer.isView(contents)) {
+    const bytes = new Uint8Array(contents.buffer, contents.byteOffset, contents.byteLength);
+    return bytes.slice(start, endExclusive);
+  }
+  if (contents instanceof Blob) {
+    return contents.slice(start, endExclusive);
+  }
+  if (contents instanceof ReadableStream) {
+    return sliceStream(contents, start, endExclusive);
+  }
+  return sliceContents(await new Response(contents).arrayBuffer(), start, end);
+}
+
+/**
+ * Emit only bytes `[start, endExclusive)` of a byte stream. The source is cancelled
+ * once the slice is complete or the consumer cancels, so no read is left open.
+ */
+function sliceStream(
+  source: ReadableStream<Uint8Array>,
+  start: number,
+  endExclusive: number,
+): ReadableStream<Uint8Array> {
+  const reader = source.getReader();
+  let position = 0;
+  return new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      try {
+        while (true) {
+          const { done, value } = await reader.read();
+          if (done) {
+            controller.close();
+            return;
+          }
+          const chunkStart = position;
+          const chunkEnd = position + value.byteLength;
+          position = chunkEnd;
+          const from = Math.max(start - chunkStart, 0);
+          const to = Math.min(endExclusive - chunkStart, value.byteLength);
+          const hasBytes = from < to;
+          if (hasBytes) {
+            controller.enqueue(value.subarray(from, to));
+          }
+          if (chunkEnd >= endExclusive) {
+            controller.close();
+            reader.cancel().catch(() => {});
+            return;
+          }
+          if (hasBytes) {
+            return;
+          }
+        }
+      } catch (error) {
+        controller.error(error);
+      }
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+}
diff --git a/test/sdd-range.test.ts b/test/sdd-range.test.ts
