+    cases.forEach(([, config], i) => sealRoutes(`/invalid-${i}`, config));
+
+    for (let i = 0; i < cases.length; i++) {
+      for (const op of ["update", "seal", "use"]) {
+        const res = await t.fetch(`/invalid-${i}/${op}`);
+        const body = await res.json();
+        expect(body.ok, `${cases[i][0]} / ${op}`).toBeUndefined();
+        expect(body.error, `${cases[i][0]} / ${op}`).toMatch(/password/);
+        expect(body.error).not.toContain(P0);
+      }
+    }
+  });
+
+  it("RF-06: minPasswordlength comes from the resolved seal options", async () => {
