+import { vi } from "vitest";
+import {
+  useSession,
+  getSession,
+  updateSession,
+  sealSession,
+  unsealSession,
+  clearSession,
+  type SessionConfig,
+} from "../src/index.ts";
+import {
+  seal,
+  unseal,
+  defaults as sealDefaults,
+  type SealOptions,
+} from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for `extraUnsealPasswords` (h3js/h3#1050, variant b).
+// Derived from sdd/pedido.md, sdd/prd.md (RF-01 to RF-09) and sdd/techspec.md.
+
+const CONFIG_NAME = "h3-sdd";
+// Each password is >= 32 chars (the default `minPasswordlength`)
+const P0 = "legacy-secret-P0-0123456789abcdefABCD"; // old password, only in extras
+const P1 = "current-secret-P1-0123456789abcdefABCD"; // current `password`
+const P9 = "rotated-secret-P9-0123456789abcdefABCD"; // older extra
+const PX = "unknown-secret-PX-0123456789abcdefABCD"; // never configured
+const MARKER = Symbol.for("h3.internal.session.unsealed-with-extra");
+const T0 = Date.parse("2030-01-01T00:00:00Z");
+
+const legacyOpts: SealOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const sealAs = (password: string, session: object, opts: SealOptions = sealDefaults) =>
+  seal(session, password, opts);
+
+const cookieFor = (sealed: string) => `${CONFIG_NAME}=${encodeURIComponent(sealed)}`;
+
+/** Value of the head session cookie in a response, decoded */
+const sealedFromResponse = (res: Response): string | undefined => {
+  const cookie = res.headers.getSetCookie().find((c) => c.startsWith(`${CONFIG_NAME}=`));
+  if (!cookie) {
+    return undefined;
+  }
+  return decodeURIComponent(cookie.slice(CONFIG_NAME.length + 1).split(";")[0]);
+};
+
+/** Number of PBKDF2 derivations (`deriveBits`) performed while `run` executes */
+const derivations = async (run: () => Promise<unknown>): Promise<number> => {
+  const spy = vi.spyOn(crypto.subtle, "deriveBits");
+  try {
+    await run();
+    return spy.mock.calls.length;
+  } finally {
+    spy.mockRestore();
+  }
+};
+
+const cfg = (extra: Partial<SessionConfig> = {}): SessionConfig => ({
+  name: CONFIG_NAME,
+  password: P1,
+  generateId: () => "new-id",
+  ...extra,
+});
+
+describeMatrix("sdd: extraUnsealPasswords", (t, { it, expect }) => {
+  /** Route that only reads the session with `getSession` */
+  const readRoute = (path: string, config: SessionConfig) =>
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, config);
+      return {
+        id: session.id,
+        createdAt: session.createdAt,
+        data: session.data,
+        hasMarker: Object.getOwnPropertySymbols(session).includes(MARKER),
+      };
+    });
+
+  /** Routes that try each sealing operation and report the error, if any */
+  const sealRoutes = (prefix: string, config: SessionConfig) => {
+    t.app.get(`${prefix}/update`, async (event) => {
+      try {
+        await updateSession(event, config, { a: 1 });
+        return { ok: true };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get(`${prefix}/seal`, async (event) => {
+      try {
+        await sealSession(event, config);
+        return { ok: true };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get(`${prefix}/use`, async (event) => {
+      try {
+        await useSession(event, config);
+        return { ok: true };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+  };
+
+  it("RF-01: no extras field and an empty list behave the same", async () => {
+    readRoute("/same", cfg());
+    readRoute("/same-empty", cfg({ extraUnsealPasswords: [] }));
+    const sealed = await sealAs(P1, { id: "same-1", createdAt: Date.now(), data: { user: "ana" } });
+
+    const run = async (path: string) => {
+      const res = await t.fetch(path, { headers: { Cookie: cookieFor(sealed) } });
+      return { body: await res.json(), setCookies: res.headers.getSetCookie().length };
+    };
+    const withoutField = await run("/same");
+    const withEmpty = await run("/same-empty");
+    expect(withoutField).toEqual(withEmpty);
+    expect(withoutField.body).toMatchObject({ id: "same-1", data: { user: "ana" } });
+    expect(withoutField.setCookies).toBe(0);
+  });
+
+  it("RF-02: useSession, updateSession and sealSession always seal with password", async () => {
+    const config = cfg({ extraUnsealPasswords: [P0] });
+    t.app.get("/seal-use", async (event) => {
+      const session = await useSession(event, config);
+      return { id: session.id };
+    });
+    t.app.get("/seal-update", async (event) => {
+      await updateSession(event, config, { a: 1 });
+      return "ok";
+    });
+    t.app.get("/seal-direct", async (event) => ({ sealed: await sealSession(event, config) }));
+
+    const expectSealedWithCurrentOnly = async (sealed: string | undefined) => {
+      expect(sealed).toBeDefined();
+      await expect(unseal(sealed!, P1, sealDefaults)).resolves.toBeDefined();
+      await expect(unseal(sealed!, P0, sealDefaults)).rejects.toThrow();
+    };
+
+    const useRes = await t.fetch("/seal-use");
+    await expectSealedWithCurrentOnly(sealedFromResponse(useRes));
+
+    const updateRes = await t.fetch("/seal-update");
+    await expectSealedWithCurrentOnly(sealedFromResponse(updateRes));
+
+    const directRes = await t.fetch("/seal-direct");
+    await expectSealedWithCurrentOnly((await directRes.json()).sealed);
+  });
+
+  it("RF-03: opens with a later extra and keeps id, createdAt and data", async () => {
+    const createdAt = Date.now();
+    readRoute("/order", cfg({ extraUnsealPasswords: [P9, P0], legacySealFallback: false }));
+    const sealed = await sealAs(P0, { id: "order-1", createdAt, data: { user: "bia" } });
+
+    let body: any;
+    const calls = await derivations(async () => {
+      const res = await t.fetch("/order", { headers: { Cookie: cookieFor(sealed) } });
+      body = await res.json();
+    });
+    expect(body).toMatchObject({ id: "order-1", createdAt, data: { user: "bia" } });
+    // Attempts: P1 fails (1 derivation), P9 fails (1), P0 opens (2), then the
+    // reseal with P1 (2). A wrong order or an extra attempt changes this count.
+    expect(calls).toBe(6);
+  });
+
+  it("RF-03: a session sealed with password tries no extra password", async () => {
+    readRoute("/no-extra-try", cfg({ legacySealFallback: false }));
+    readRoute("/extra-try", cfg({ extraUnsealPasswords: [P0, P9], legacySealFallback: false }));
+    const sealed = await sealAs(P1, { id: "p1-1", createdAt: Date.now(), data: {} });
+
+    const baseline = await derivations(() =>
+      t.fetch("/no-extra-try", { headers: { Cookie: cookieFor(sealed) } }),
+    );
+    const withExtras = await derivations(async () => {
+      const res = await t.fetch("/extra-try", { headers: { Cookie: cookieFor(sealed) } });
+      expect(await res.json()).toMatchObject({ id: "p1-1" });
+    });
+    expect(withExtras).toBe(baseline);
+  });
+
+  it("RF-04: a session sealed with an unknown password is treated as missing", async () => {
+    readRoute("/unknown", cfg({ extraUnsealPasswords: [P0] }));
+    const sealed = await sealAs(PX, { id: "unk-1", createdAt: Date.now(), data: { x: 1 } });
+
+    const res = await t.fetch("/unknown", { headers: { Cookie: cookieFor(sealed) } });
+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(body.id).not.toBe("unk-1");
+    expect(body.data).toEqual({});
+  });
+
+  it("RF-05: reading with an extra password reseals with password in the same response", async () => {
+    readRoute("/reseal", cfg({ extraUnsealPasswords: [P0] }));
+    const createdAt = Date.now();
+    const sealed = await sealAs(P0, { id: "rs-1", createdAt, data: { user: "eva" } });
+
+    const res = await t.fetch("/reseal", { headers: { Cookie: cookieFor(sealed) } });
+    const body = await res.json();
+    expect(body).toMatchObject({ id: "rs-1", createdAt, data: { user: "eva" } });
+    // The marker is removed before the session object is returned
+    expect(body.hasMarker).toBe(false);
+
+    const resealed = sealedFromResponse(res);
+    expect(resealed).toBeDefined();
+    expect(await unseal(resealed!, P1, sealDefaults)).toMatchObject({
+      id: "rs-1",
+      createdAt,
+      data: { user: "eva" },
+    });
+    await expect(unseal(resealed!, P0, sealDefaults)).rejects.toThrow();
+  });
+
+  it("RF-05: reading a session sealed with password does not reseal it", async () => {
+    readRoute("/no-reseal", cfg({ extraUnsealPasswords: [P0] }));
+    const sealed = await sealAs(P1, { id: "np-1", createdAt: Date.now(), data: {} });
+
+    const res = await t.fetch("/no-reseal", { headers: { Cookie: cookieFor(sealed) } });
+    expect((await res.json()).id).toBe("np-1");
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("RF-05: a session from the session header opened with an extra is not resealed", async () => {
+    readRoute("/header-reseal", cfg({ extraUnsealPasswords: [P0] }));
+    const sealed = await sealAs(P0, { id: "hdr-1", createdAt: Date.now(), data: { user: "cy" } });
+
+    const res = await t.fetch("/header-reseal", {
+      headers: { "x-h3-sdd-session": sealed },
+    });
+    const body = await res.json();
+    expect(body).toMatchObject({ id: "hdr-1", data: { user: "cy" } });
+    expect(res.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("RF-06: invalid extras reject every sealing operation, even without a cookie", async () => {
+    const cases: Array<[string, SessionConfig]> = [
+      ["empty extra at the end", cfg({ extraUnsealPasswords: [P0, ""] })],
+      ["10-char extra", cfg({ extraUnsealPasswords: [P0, "0123456789"] })],
+      ["empty extra at the start", cfg({ extraUnsealPasswords: ["", P0] })],
