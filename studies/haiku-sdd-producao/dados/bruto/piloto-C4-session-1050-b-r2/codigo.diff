@@ -0,0 +1,315 @@
+import type { SessionConfig } from "../src/utils/session.ts";
+import {
+  clearSession,
+  getSession,
+  sealSession,
+  unsealSession,
+  updateSession,
+  useSession,
+} from "../src/index.ts";
+import { seal, unseal, defaults as sealDefaults } from "../src/utils/internal/iron-crypto.ts";
+import { describeMatrix } from "./_setup.ts";
+
+// Acceptance tests for extraUnsealPasswords (sdd/prd.md RF-01 to RF-09, sdd/techspec.md)
+
+const CURRENT = "current-password-0123456789-abcdefghijklmnop";
+const EXTRA_1 = "extra-one-0123456789-ABCDEFGHIJKLMNOP";
+const EXTRA_2 = "extra-two-0123456789-qrstuvwxyzABCDEF";
+const UNKNOWN = "unknown-password-0123456789-zzzzzzzzzzzzzzz";
+const SHORT = "too-short-password";
+const BAD_EXTRA = "s3cr3t-val"; // 10 characters, below the 32 minimum
+const NAME = "h3-sdd";
+const CREATED_AT = 1_700_000_000_000;
+
+const legacyOptions = {
+  ...sealDefaults,
+  encryption: { ...sealDefaults.encryption, iterations: 1 },
+  integrity: { ...sealDefaults.integrity, iterations: 1 },
+};
+
+const configWith = (extraUnsealPasswords?: string[]): SessionConfig => ({
+  name: NAME,
+  password: CURRENT,
+  ...(extraUnsealPasswords ? { extraUnsealPasswords } : {}),
+});
+
+const sealAs = (password: string, data: Record<string, unknown> = {}, id = "keep-1") =>
+  seal({ id, createdAt: CREATED_AT, data }, password, sealDefaults);
+
+const cookieFor = (sealed: string) => `${NAME}=${encodeURIComponent(sealed)}`;
+
+const sealedOf = (res: Response): string | undefined => {
+  const cookie = res.headers.getSetCookie().find((c) => c.startsWith(`${NAME}=`));
+  return cookie ? decodeURIComponent(cookie.slice(NAME.length + 1).split(";")[0]) : undefined;
+};
+
+const openable = (sealed: string, password: string) =>
+  unseal(sealed, password, sealDefaults).then(
+    () => true,
+    () => false,
+  );
+
+describeMatrix("sdd: extraUnsealPasswords", (t, { it, expect }) => {
+  const readRoute = (path: string, cfg: SessionConfig) =>
+    t.app.get(path, async (event) => {
+      const session = await getSession(event, cfg);
+      return { id: session.id, createdAt: session.createdAt, data: session.data };
+    });
+
+  const useRoute = (path: string, cfg: SessionConfig) =>
+    t.app.get(path, async (event) => {
+      const session = await useSession(event, cfg);
+      return { id: session.id, data: session.data };
+    });
+
+  it("RF-01/RF-09: absent or empty extraUnsealPasswords keep today's behavior", async () => {
+    const sealed = await sealAs(CURRENT, { user: "alice" });
+    const foreign = await sealAs(EXTRA_1, { user: "mallory" });
+    readRoute("/rf01-absent", configWith());
+    readRoute("/rf01-empty", configWith([]));
+
+    for (const path of ["/rf01-absent", "/rf01-empty"]) {
+      const ok = await t.fetch(path, { headers: { Cookie: cookieFor(sealed) } });
+      expect(await ok.json()).toMatchObject({
+        id: "keep-1",
+        createdAt: CREATED_AT,
+        data: { user: "alice" },
+      });
+      expect(ok.headers.getSetCookie()).toHaveLength(0);
+
+      const other = await t.fetch(path, { headers: { Cookie: cookieFor(foreign) } });
+      expect(await other.json()).toMatchObject({ data: {} });
+      expect(other.headers.getSetCookie()).toHaveLength(0);
+    }
+  });
+
+  it("RF-02: seals created and updated sessions only with password", async () => {
+    const cfg = configWith([EXTRA_1]);
+    t.app.get("/rf02-create", async (event) => {
+      const session = await useSession(event, cfg);
+      return { id: session.id };
+    });
+    t.app.get("/rf02-seal", async (event) => ({ sealed: await sealSession(event, cfg) }));
+    t.app.get("/rf02-update", async (event) => {
+      const session = await updateSession(event, cfg, { user: "bob" });
+      return { id: session.id };
+    });
+
+    const created = sealedOf(await t.fetch("/rf02-create"))!;
+    expect(created).toBeDefined();
+    expect(await openable(created, CURRENT)).toBe(true);
+    expect(await openable(created, EXTRA_1)).toBe(false);
+
+    const { sealed } = await (await t.fetch("/rf02-seal")).json();
+    expect(await openable(sealed, CURRENT)).toBe(true);
+    expect(await openable(sealed, EXTRA_1)).toBe(false);
+
+    // Reading a session sealed with the extra and writing it back reseals with password
+    const updated = await t.fetch("/rf02-update", {
+      headers: { Cookie: cookieFor(await sealAs(EXTRA_1)) },
+    });
+    const resealed = sealedOf(updated)!;
+    expect(resealed).toBeDefined();
+    expect(await openable(resealed, CURRENT)).toBe(true);
+    expect(await openable(resealed, EXTRA_1)).toBe(false);
+  });
+
+  it("RF-03: opens with the extra password that matches and keeps id, createdAt and data", async () => {
+    readRoute("/rf03", configWith([EXTRA_1, EXTRA_2]));
+    const res = await t.fetch("/rf03", {
+      headers: { Cookie: cookieFor(await sealAs(EXTRA_2, { user: "alice" })) },
+    });
+    expect(await res.json()).toMatchObject({
+      id: "keep-1",
+      createdAt: CREATED_AT,
+      data: { user: "alice" },
+    });
+  });
+
+  it("RF-03: stops at the first password that opens the session", async () => {
+    // SHORT is invalid and would throw if tried, so a successful read proves it was never tried
+    readRoute("/rf03-stop", configWith([EXTRA_1, EXTRA_2, SHORT]));
+    const res = await t.fetch("/rf03-stop", {
+      headers: { Cookie: cookieFor(await sealAs(EXTRA_2, { user: "alice" })) },
+    });
+    expect(await res.json()).toMatchObject({ id: "keep-1", data: { user: "alice" } });
+  });
+
+  it("RF-03: a session sealed with password does not try the extra passwords", async () => {
+    readRoute("/rf03-password", configWith([SHORT]));
+    const res = await t.fetch("/rf03-password", {
+      headers: { Cookie: cookieFor(await sealAs(CURRENT, { user: "alice" })) },
+    });
+    expect(await res.json()).toMatchObject({ id: "keep-1", data: { user: "alice" } });
+  });
+
+  it("RF-04: a session sealed with an unknown password reads as empty, without error", async () => {
+    const cfg = configWith([EXTRA_1]);
+    readRoute("/rf04-get", cfg);
+    useRoute("/rf04-use", cfg);
+
+    for (const path of ["/rf04-get", "/rf04-use"]) {
+      const res = await t.fetch(path, {
+        headers: { Cookie: cookieFor(await sealAs(UNKNOWN, { user: "eve" })) },
+      });
+      expect(res.status).toBe(200);
+      const body = await res.json();
+      expect(body.id).not.toBe("keep-1");
+      expect(body.data).toEqual({});
+      expect(JSON.stringify(body)).not.toContain("eve");
+    }
+  });
+
+  it("RF-05: reseals on read a session opened by an extra password, from the cookie", async () => {
+    useRoute("/rf05", configWith([EXTRA_1]));
+
+    const res = await t.fetch("/rf05", {
+      headers: { Cookie: cookieFor(await sealAs(EXTRA_1, { user: "alice" })) },
+    });
+    expect(await res.json()).toMatchObject({ id: "keep-1", data: { user: "alice" } });
+    const resealed = sealedOf(res);
+    expect(resealed).toBeDefined();
+    expect(await openable(resealed!, CURRENT)).toBe(true);
+    expect(await openable(resealed!, EXTRA_1)).toBe(false);
+    expect(await unseal(resealed!, CURRENT, sealDefaults)).toMatchObject({
+      id: "keep-1",
+      createdAt: CREATED_AT,
+      data: { user: "alice" },
+    });
+  });
+
+  it("RF-05: does not reseal sessions opened by password, or sessions from the header", async () => {
+    useRoute("/rf05-nr", configWith([EXTRA_1]));
+
+    const byPassword = await t.fetch("/rf05-nr", {
+      headers: { Cookie: cookieFor(await sealAs(CURRENT, { user: "alice" })) },
+    });
+    expect(byPassword.headers.getSetCookie()).toHaveLength(0);
+
+    const byHeader = await t.fetch("/rf05-nr", {
+      headers: { [`x-${NAME}-session`]: await sealAs(EXTRA_1, { user: "alice" }) },
+    });
+    expect(await byHeader.json()).toMatchObject({ id: "keep-1", data: { user: "alice" } });
+    expect(byHeader.headers.getSetCookie()).toHaveLength(0);
+  });
+
+  it("RF-06: rejects invalid extra passwords on sealing paths, without leaking the value", async () => {
+    const badCfg = configWith([EXTRA_1, EXTRA_2, BAD_EXTRA]);
+    t.app.get("/rf06-seal", async (event) => {
+      try {
+        await sealSession(event, badCfg);
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/rf06-update", async (event) => {
+      try {
+        await updateSession(event, badCfg, { user: "x" });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/rf06-use-empty", async (event) => {
+      try {
+        await useSession(event, configWith([""]));
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+    t.app.get("/rf06-bad-password", async (event) => {
+      try {
+        await sealSession(event, { name: NAME, password: SHORT });
+        return { error: null };
+      } catch (error) {
+        return { error: (error as Error).message };
+      }
+    });
+
+    // No cookie in these requests: validation must not depend on a session being present
+    for (const path of ["/rf06-seal", "/rf06-update"]) {
+      const body = await (await t.fetch(path)).json();
+      expect(body.error).toMatch(/password/i);
+      expect(body.error).not.toContain(BAD_EXTRA);
+    }
+    const empty = await (await t.fetch("/rf06-use-empty")).json();
+    expect(empty.error).toMatch(/password/i);
+
+    // An invalid password itself keeps failing as before
+    const bad = await (await t.fetch("/rf06-bad-password")).json();
+    expect(bad.error).toMatch(/password/i);
+  });
+
+  it("RF-07: reads chunked cookies sealed with an extra password", async () => {
+    const big = "x".repeat(5000);
+    const extraCfg = { name: NAME, password: EXTRA_1 };
+    t.app.get("/rf07-seed", async (event) => {
+      await updateSession(event, extraCfg, { big });
+      return "ok";
+    });
+    const seed = await t.fetch("/rf07-seed");
+    const setCookies = seed.headers.getSetCookie();
+    expect(setCookies.length).toBeGreaterThan(1);
+    const chunked = setCookies.map((c) => c.split(";")[0]).join("; ");
+
+    t.app.get("/rf07-read", async (event) => {
+      const cfg = configWith([EXTRA_1]);
+      const session = await getSession(event, cfg);
+      const manager = await useSession(event, cfg);
+      return { id: session.id, big: session.data.big, managerBig: manager.data.big };
+    });
+    const res = await t.fetch("/rf07-read", { headers: { Cookie: chunked } });
+    expect(await res.json()).toMatchObject({ big, managerBig: big });
+  });
+
+  it("RF-07: unsealSession opens a session sealed with an extra password", async () => {
+    const sealed = await sealAs(EXTRA_2, { user: "alice" });
+    t.app.get("/rf07-unseal", async (event) => {
+      const unsealed = await unsealSession(event, configWith([EXTRA_1, EXTRA_2]), sealed);
+      return { id: unsealed.id, data: unsealed.data };
+    });
+    const res = await t.fetch("/rf07-unseal");
+    expect(await res.json()).toMatchObject({ id: "keep-1", data: { user: "alice" } });
+  });
+
+  it("RF-07: clearSession with an extra-sealed session does not throw and clears the cookie", async () => {
+    t.app.get("/rf07-clear", async (event) => {
+      await clearSession(event, configWith([EXTRA_1]));
+      return "ok";
+    });
+    const res = await t.fetch("/rf07-clear", {
+      headers: { Cookie: cookieFor(await sealAs(EXTRA_1)) },
+    });
