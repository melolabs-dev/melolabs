+    const cleared = res.headers.getSetCookie().find((c) => c.startsWith(`${NAME}=`));
+    expect(cleared).toContain("Max-Age=0");
+  });
+
+  it("RF-08: reseals legacy sessions sealed with an extra password", async () => {
+    const legacy = await seal(
