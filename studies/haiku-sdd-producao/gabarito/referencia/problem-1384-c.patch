diff --git a/src/utils/internal/problem.ts b/src/utils/internal/problem.ts
new file mode 100644
index 0000000..3dff7a0
--- /dev/null
+++ b/src/utils/internal/problem.ts
@@ -0,0 +1,129 @@
+import { FastResponse } from "srvx";
+import type { HTTPError } from "../../error.ts";
+
+/**
+ * Members defined by RFC 9457 (section 3.1). Extension members never override them.
+ */
+const standardMembers = new Set(["type", "title", "status", "detail", "instance"]);
+
+/**
+ * Optional RFC 9457 members carried by an error.
+ */
+export interface ProblemMembers {
+  type?: string;
+  instance?: string;
+}
+
+/**
+ * Render an error as an RFC 9457 `application/problem+json` response.
+ */
+export function problemResponse(
+  error: HTTPError,
+  members: ProblemMembers,
+  debug?: boolean,
+  errHeaders?: Headers,
+): Response {
+  const headers = new Headers({ "content-type": "application/problem+json" });
+  if (error.headers) {
+    mergeErrorHeaders(headers, error.headers);
+  }
+  if (errHeaders) {
+    mergeErrorHeaders(headers, errHeaders);
+  }
+  return new FastResponse(
+    JSON.stringify(problemBody(error, members, debug), undefined, debug ? 2 : undefined),
+    {
+      status: error.status,
+      statusText: error.statusText,
+      headers,
+    },
+  );
+}
+
+function problemBody(
+  error: HTTPError,
+  members: ProblemMembers,
+  debug?: boolean,
+): Record<string, unknown> {
+  const unhandled = error.unhandled;
+  const title = error.statusText || statusPhrases[error.status] || "Unknown Error";
+  const genericMessage = ["HTTPError", error.status, error.statusText].filter(Boolean).join(" ");
+  const detail =
+    unhandled || error.message === title || error.message === genericMessage
+      ? undefined
+      : error.message;
+
+  const extensions: Record<string, unknown> = {};
+  if (!unhandled) {
+    const data = error.data as unknown;
+    if (data && typeof data === "object" && !Array.isArray(data)) {
+      Object.assign(extensions, data);
+    } else if (data !== undefined) {
+      extensions.data = data;
+    }
+    if (error.body) {
+      Object.assign(extensions, error.body);
+    }
+  }
+  for (const name of standardMembers) {
+    delete extensions[name];
+  }
+  if (debug && error.stack) {
+    extensions.stack = error.stack.split("\n").map((l) => l.trim());
+  }
+
+  return {
+    type: members.type || "about:blank",
+    title,
+    status: error.status,
+    detail,
+    instance: members.instance,
+    ...extensions,
+  };
+}
+
+function mergeErrorHeaders(target: Headers, overrides: Headers): void {
+  for (const [name, value] of overrides) {
+    if (name === "set-cookie") {
+      target.append(name, value);
+    } else {
+      target.set(name, value);
+    }
+  }
+}
+
+// https://www.rfc-editor.org/rfc/rfc9110#section-15
+const statusPhrases: Record<number, string> = {
+  400: "Bad Request",
+  401: "Unauthorized",
+  402: "Payment Required",
+  403: "Forbidden",
+  404: "Not Found",
+  405: "Method Not Allowed",
+  406: "Not Acceptable",
+  407: "Proxy Authentication Required",
+  408: "Request Timeout",
+  409: "Conflict",
+  410: "Gone",
+  411: "Length Required",
+  412: "Precondition Failed",
+  413: "Content Too Large",
+  414: "URI Too Long",
+  415: "Unsupported Media Type",
+  416: "Range Not Satisfiable",
+  417: "Expectation Failed",
+  418: "I'm a teapot",
+  421: "Misdirected Request",
+  422: "Unprocessable Content",
+  426: "Upgrade Required",
+  428: "Precondition Required",
+  429: "Too Many Requests",
+  431: "Request Header Fields Too Large",
+  451: "Unavailable For Legal Reasons",
+  500: "Internal Server Error",
+  501: "Not Implemented",
+  502: "Bad Gateway",
+  503: "Service Unavailable",
+  504: "Gateway Timeout",
+  505: "HTTP Version Not Supported",
+};
diff --git a/src/utils/problem.ts b/src/utils/problem.ts
new file mode 100644
index 0000000..d3dab4e
--- /dev/null
+++ b/src/utils/problem.ts
@@ -0,0 +1,50 @@
+import { HTTPError, type ErrorInput } from "../error.ts";
+import { kProblemRender } from "../response.ts";
+import { problemResponse } from "./internal/problem.ts";
+
+/**
+ * Input of {@link problem}: the same fields as `HTTPError`, plus the RFC 9457 `type` and `instance` members.
+ */
+export interface ProblemInput extends ErrorInput {
+  /**
+   * Problem type URI. Defaults to `"about:blank"` when omitted.
+   */
+  type?: string;
+
+  /**
+   * URI reference that identifies this specific occurrence of the problem.
+   */
+  instance?: string;
+}
+
+/**
+ * Create an error that is rendered as an RFC 9457 problem details response
+ * (`application/problem+json`) when thrown or returned from a handler.
+ *
+ * Other errors keep the default JSON error format.
+ *
+ * @example
+ *
+ * app.get("/orders/:id", () => {
+ *   throw problem({
+ *     status: 409,
+ *     statusText: "Order locked",
+ *     message: "The order is being processed and cannot be changed.",
+ *     type: "https://example.com/probs/order-locked",
+ *     instance: "/orders/123",
+ *   });
+ * });
+ */
+export function problem(input: ProblemInput = {}): HTTPError {
+  const error = new HTTPError(input);
+  const members = {
+    type: typeof input.type === "string" ? input.type : undefined,
+    instance: typeof input.instance === "string" ? input.instance : undefined,
+  };
+  Object.defineProperty(error, kProblemRender, {
+    enumerable: false,
+    value: (debug: boolean | undefined, errHeaders: Headers | undefined) =>
+      problemResponse(error, members, debug, errHeaders),
+  });
+  return error;
+}
