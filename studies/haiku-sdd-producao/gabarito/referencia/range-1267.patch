+
+// `bytes=<first>-<last>` or `bytes=-<suffix>`: a single range only (RFC 9110 section 14.1.1).
+const RANGE_RE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * Resolve the single byte range a request asks for.
+ *
+ * Returns `undefined` when the full representation must be served: no `range`
+ * header, a malformed or multi-range value, or an `if-range` validator that
+ * does not match the current asset (RFC 9110 section 13.1.5).
+ */
+function resolveRange(
+  headers: Headers,
+  size: number,
+  etag: string | undefined,
+  lastModified: Date | undefined,
+): { start: number; end: number } | "unsatisfiable" | undefined {
+  const header = headers.get("range");
+  if (!header) {
+    return;
+  }
+  const match = RANGE_RE.exec(header.trim());
+  if (!match) {
+    return;
+  }
+  const [, first = "", last = ""] = match;
+  if (!first && !last) {
+    return;
+  }
+  const ifRange = headers.get("if-range");
+  if (ifRange !== null && !isIfRangeMatch(ifRange.trim(), etag, lastModified)) {
+    return;
+  }
+  if (!first) {
+    // Suffix range: the last N bytes.
+    const suffix = Number(last);
+    if (suffix === 0) {
+      return "unsatisfiable";
+    }
+    return { start: Math.max(0, size - suffix), end: size - 1 };
+  }
+  const start = Number(first);
+  const end = last ? Number(last) : size - 1;
+  if (last && end < start) {
+    // Invalid `byte-range-spec`: ignore the header.
+    return;
+  }
+  if (start >= size) {
+    return "unsatisfiable";
+  }
+  return { start, end: Math.min(end, size - 1) };
+}
+
+/** `if-range` needs a strong entity-tag match or an exact `last-modified` date. */
+function isIfRangeMatch(value: string, etag: string | undefined, lastModified?: Date): boolean {
+  if (value.startsWith('"') || value.startsWith("W/")) {
+    return !!etag && value === etag && etag.startsWith('"');
+  }
+  const date = Date.parse(value);
+  return !!lastModified && !Number.isNaN(date) && date === lastModified.getTime();
+}
+
+/** Slice `[start, end]` (inclusive) out of an asset body. */
+async function sliceBody(
+  body: BodyInit | null | undefined,
+  start: number,
+  end: number,
+): Promise<BodyInit | null> {
+  if (body === null || body === undefined) {
+    return null;
+  }
+  if (typeof body === "string") {
+    return new TextEncoder().encode(body).slice(start, end + 1);
+  }
+  if (body instanceof Blob) {
+    return body.slice(start, end + 1);
+  }
+  if (body instanceof ArrayBuffer) {
+    return new Uint8Array(body.slice(start, end + 1));
+  }
+  if (ArrayBuffer.isView(body)) {
+    return new Uint8Array(body.buffer, body.byteOffset, body.byteLength).slice(start, end + 1);
+  }
+  const stream = body instanceof ReadableStream ? body : new Response(body).body;
+  return stream ? stream.pipeThrough(byteRangeStream(start, end)) : null;
+}
+
+function byteRangeStream(start: number, end: number): TransformStream<Uint8Array, Uint8Array> {
+  let offset = 0;
+  return new TransformStream({
+    transform(chunk, controller) {
+      const chunkStart = offset;
+      offset += chunk.byteLength;
+      if (offset <= start || chunkStart > end) {
+        return;
+      }
+      controller.enqueue(
+        chunk.subarray(
+          Math.max(0, start - chunkStart),
+          Math.min(chunk.byteLength, end + 1 - chunkStart),
+        ),
+      );
+      if (offset > end) {
+        controller.terminate();
+      }
+    },
+  });
+}
