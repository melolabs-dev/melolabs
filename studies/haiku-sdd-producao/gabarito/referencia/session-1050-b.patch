+function getSealOptions(config: SessionConfig): SealOptions {
+  return {
+    ...sealDefaults,
+    ttl: (config.maxAge || config.idleTimeout || 0) * 1000,
+    ...config.seal,
+  };
+}
+
+/**
+ * Sealing password first, then the ones only accepted for unsealing. Every one
+ * is validated up front (as the seal validates the sealing password), so a
+ * misconfigured rotation fails loudly instead of silently rejecting sessions.
+ */
+function getSessionPasswords(config: SessionConfig, sealOptions: SealOptions): string[] {
+  const passwords = [config.password, ...(config.extraUnsealPasswords || [])];
+  const minLength = Math.max(
+    sealOptions.encryption.minPasswordlength,
+    sealOptions.integrity.minPasswordlength,
+  );
+  for (const password of passwords) {
+    if (!password) {
+      throw new Error("Empty password");
+    }
+    if (typeof password === "string" && password.length < minLength) {
+      throw new Error(`Password string too short (min ${minLength} characters required)`);
+    }
+  }
+  return passwords;
+}
+
+type UnsealResult = { ok: true; value: unknown; index: number } | { ok: false; error: unknown };
+
+/**
+ * Unseal trying each password in order. Only an HMAC mismatch (wrong password)
+ * moves on to the next one; any other failure is independent of the password.
+ */
+async function unsealWithPasswords(
+  sealed: string,
+  passwords: string[],
+  sealOptions: SealOptions,
+): Promise<UnsealResult> {
+  let error: unknown;
+  for (const [index, password] of passwords.entries()) {
+    try {
+      return { ok: true, value: await unseal(sealed, password, sealOptions), index };
+    } catch (error_) {
+      if (!(error_ instanceof Error) || error_.message !== "Bad hmac value") {
+        throw error_;
+      }
+      error = error_;
+    }
+  }
+  return { ok: false, error };
+}
