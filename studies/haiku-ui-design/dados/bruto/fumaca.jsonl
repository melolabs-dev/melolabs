{"html_final": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Entrar</title>\n  <style>\n  :root { --texto:#1f2937; --acento:#1d4ed8; }\n  body { margin:0; font-family: system-ui, sans-serif; font-size:16px; line-height:1.5; color:var(--texto); background:#f3f4f6; display:flex; justify-content:center; padding:32px 16px; }\n  .card-a { background:#ffffff; width:100%; max-width:360px; padding:32px 24px; border-radius:12px; box-shadow:0 1px 3px rgba(0,0,0,.15); }\n  h1 { font-size:28px; margin:0 0 8px; letter-spacing:0; }\n  .boas-vindas { margin:0 0 24px; color:#4b5563; }\n  .campo-a { margin-bottom:16px; }\n  label { display:block; margin-bottom:8px; font-weight:500; color:#1f2937; }\n  input { width:100%; box-sizing:border-box; padding:12px; font-size:16px; border:1px solid #6b7280; border-radius:8px;  }\n  input:focus, button:focus { outline:2px solid var(--acento); outline-offset:2px; }\n  .mostrar-a { margin-top:8px; background:transparent; border:0; color:var(--acento); font-size:16px; padding:4px 0; }\n  .entrar-a { width:100%; padding:16px 16px; font-size:16px; background:var(--acento); color:#ffffff; border:0; border-radius:8px;  cursor:pointer;  }\n  .links-a { margin-top:16px; text-align:center; }\n  a { color:var(--acento); text-decoration:underline; }\n  .erro-a { color:#b91c1c; margin:0 0 16px; }\n  </style>\n</head>\n<body>\n  <main class=\"card-a\">\n    <img src=\"/logo.svg\" width=\"48\" height=\"48\" alt=\"Melo Labs\">\n    <h1>Entrar</h1>\n    <p class=\"boas-vindas\">Bem-vindo</p>\n    <p class=\"erro-a\" id=\"erro-login\" role=\"alert\" hidden>E-mail ou senha incorretos.</p>\n    <form action=\"/login\" method=\"post\">\n    <div class=\"campo-a\"><label for=\"email\">E-mail</label><input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"username\" placeholder=\"voce@exemplo.com\" required></div>\n    <div class=\"campo-a\"><