[
 {
  "id": "AM01",
  "dominio": "acessibilidade",
  "regra": "Declare o idioma da página com lang válido no elemento html.",
  "fonte": "WCAG 2.2 Understanding 3.1.1 Language of Page (H57)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/language-of-page.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Ler html[lang]; falhar se ausente, vazio ou fora de BCP 47.",
  "checavel_por_codigo": true,
  "bom": "<html lang='pt-BR'>",
  "mau": "<html>",
  "severidade": "alta",
  "forca_evidencia": "norma",
  "axe_rule": "html-has-lang"
 },
 {
  "id": "AM02",
  "dominio": "acessibilidade",
  "regra": "Dê a cada página um title não vazio que descreva seu assunto ou finalidade.",
  "fonte": "WCAG 2.2 Understanding 2.4.2 Page Titled",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/page-titled.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Verificar head > title com texto não vazio.",
  "checavel_por_codigo": true,
  "bom": "<title>Pedidos em aberto</title>",
  "mau": "<head></head>",
  "severidade": "alta",
  "forca_evidencia": "norma",
  "axe_rule": "document-title"
 },
 {
  "id": "AM03",
  "dominio": "acessibilidade",
  "regra": "Ofereça um meio de pular blocos repetidos: link de salto no início apontando ao conteúdo principal, ou landmarks.",
  "fonte": "WCAG 2.2 Understanding 2.4.1 Bypass Blocks (G1, ARIA11)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/bypass-blocks.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Primeiro link focável com href='#id' existente apontando ao main, ou presença de main/nav landmarks.",
  "checavel_por_codigo": true,
  "bom": "<a href='#conteudo'>Ir ao conteúdo</a><main id='conteudo'>",
  "mau": "<nav>...30 links...</nav><div>conteúdo</div>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": "bypass"
 },
 {
  "id": "AM04",
  "dominio": "acessibilidade",
  "regra": "Marque títulos com h1 a h6 e não com div ou span estilizados.",
  "fonte": "WCAG 2.2 Understanding 1.3.1 Info and Relationships (H42)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/info-and-relationships.html",
  "url_verificada": true,
  "tipo": "semi-objetiva",
  "como_checar": "nao_checavel_por_codigo",
  "checavel_por_codigo": false,
  "bom": "<h2>Resumo</h2>",
  "mau": "<div class='titulo-grande'>Resumo</div>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": null
 },
 {
  "id": "AM05",
  "dominio": "acessibilidade",
  "regra": "Não pule níveis de título (h2 seguido de h4).",
  "fonte": "WAI Web Accessibility Tutorials, Page Structure: Headings",
  "url": "https://www.w3.org/WAI/tutorials/page-structure/headings/",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Percorrer h1-h6 em ordem de documento; falhar se o nível sobe mais de 1 em relação ao anterior.",
  "checavel_por_codigo": true,
  "bom": "<h2>A</h2><h3>B</h3>",
  "mau": "<h2>A</h2><h4>B</h4>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "heading-order"
 },
 {
  "id": "AM06",
  "dominio": "acessibilidade",
  "regra": "Use um único h1 que descreva o conteúdo da página.",
  "fonte": "MDN, Heading Elements (Accessibility)",
  "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/Heading_Elements",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Contar h1 no documento; esperar exatamente 1.",
  "checavel_por_codigo": true,
  "bom": "<h1>Pedidos</h1>",
  "mau": "<h1>A</h1><h1>B</h1>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "page-has-heading-one"
 },
 {
  "id": "AM07",
  "dominio": "acessibilidade",
  "regra": "Títulos e rótulos presentes devem ter texto, nunca vazios.",
  "fonte": "WCAG 2.2 Understanding 2.4.6 Headings and Labels",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/headings-and-labels.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Falhar em h1-h6 sem texto nem nome acessível.",
  "checavel_por_codigo": true,
  "bom": "<h2>Entregas</h2>",
  "mau": "<h2></h2>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": "empty-heading"
 },
 {
  "id": "AM08",
  "dominio": "acessibilidade",
  "regra": "Use ul, ol ou dl para listas e grupos de links, em vez de texto com br.",
  "fonte": "WCAG 2.2 Understanding 1.3.1 Info and Relationships (H48)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/info-and-relationships.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Detectar sequências de links/itens separadas por br ou bullet fora de ul/ol; e li fora de ul/ol/menu.",
  "checavel_por_codigo": true,
  "bom": "<ul><li><a href='/a'>A</a></li></ul>",
  "mau": "<a href='/a'>A</a><br><a href='/b'>B</a>",
  "severidade": "baixa",
  "forca_evidencia": "norma",
  "axe_rule": "list"
 },
 {
  "id": "AM09",
  "dominio": "acessibilidade",
  "regra": "Dê a toda tabela de dados um caption que descreva seu propósito.",
  "fonte": "MDN, table element (Accessibility)",
  "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/table",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "table sem role=presentation deve ter caption como primeiro filho (ou aria-label/labelledby).",
  "checavel_por_codigo": true,
  "bom": "<table><caption>Pedidos 2026</caption>...",
  "mau": "<table><tr><td>...</td></tr></table>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "table-duplicate-name"
 },
 {
  "id": "AM10",
  "dominio": "acessibilidade",
  "regra": "Marque células de cabeçalho com th e scope col ou row.",
  "fonte": "MDN, table element (Accessibility)",
  "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/table",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Toda tabela de dados deve ter th; th com scope válido (col, row, colgroup, rowgroup).",
  "checavel_por_codigo": true,
  "bom": "<th scope='col'>Nome</th>",
  "mau": "<tr><td><b>Nome</b></td></tr>",
  "severidade": "alta",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "scope-attr-valid"
 },
 {
  "id": "AM11",
  "dominio": "acessibilidade",
  "regra": "Em tabelas com cabeçalhos multinível ou colspan/rowspan, associe células com id e headers.",
  "fonte": "MDN, table element (Accessibility)",
  "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/table",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Se a tabela tem colspan/rowspan em th, cada td deve ter headers cujos ids existam em th.",
  "checavel_por_codigo": true,
  "bom": "<td headers='nome jun'>3</td>",
  "mau": "<td>3</td> (sob th com colspan)",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "td-headers-attr"
 },
 {
  "id": "AM12",
  "dominio": "acessibilidade",
  "regra": "Agrupe controles de formulário relacionados em fieldset com legend.",
  "fonte": "WCAG 2.2 Understanding 1.3.1 (H71)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/info-and-relationships.html",
  "url_verificada": true,
  "tipo": "semi-objetiva",
  "como_checar": "Grupos de input radio/checkbox com mesmo name devem estar dentro de fieldset com legend.",
  "checavel_por_codigo": true,
  "bom": "<fieldset><legend>Frete</legend><input type='radio' name='f'>..</fieldset>",
  "mau": "<input type='radio' name='f'><input type='radio' name='f'>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": null
 },
 {
  "id": "AM13",
  "dominio": "acessibilidade",
  "regra": "Tenha exatamente um landmark main de nível superior.",
  "fonte": "ARIA Authoring Practices, Landmark Regions",
  "url": "https://www.w3.org/WAI/ARIA/apg/practices/landmark-regions/",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Contar main (ou role=main) no documento; esperar 1.",
  "checavel_por_codigo": true,
  "bom": "<main>...</main>",
  "mau": "<div id='main'>...</div>",
  "severidade": "alta",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "landmark-one-main"
 },
 {
  "id": "AM14",
  "dominio": "acessibilidade",
  "regra": "Coloque todo o conteúdo perceptível dentro de landmarks.",
  "fonte": "ARIA Authoring Practices, Landmark Regions",
  "url": "https://www.w3.org/WAI/ARIA/apg/practices/landmark-regions/",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Filhos de body com texto/controles devem estar em header, nav, main, aside, footer ou role equivalente.",
  "checavel_por_codigo": true,
  "bom": "<body><header/><main/><footer/></body>",
  "mau": "<body><div>texto solto</div></body>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "region"
 },
 {
  "id": "AM15",
  "dominio": "acessibilidade",
  "regra": "Dê rótulo único a landmarks do mesmo tipo repetidos (vários nav).",
  "fonte": "ARIA Authoring Practices, Landmark Regions",
  "url": "https://www.w3.org/WAI/ARIA/apg/practices/landmark-regions/",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Agrupar nav/aside/section por tipo; se mais de 1, cada um com aria-label ou aria-labelledby distinto.",
  "checavel_por_codigo": true,
  "bom": "<nav aria-label='Principal'></nav><nav aria-label='Rodapé'></nav>",
  "mau": "<nav></nav><nav></nav>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "landmark-unique"
 },
 {
  "id": "AM16",
  "dominio": "acessibilidade",
  "regra": "Não use valores positivos em tabindex; só 0 ou -1.",
  "fonte": "MDN, tabindex global attribute (Accessibility)",
  "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/tabindex",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Falhar em qualquer [tabindex] com inteiro > 0.",
  "checavel_por_codigo": true,
  "bom": "<div tabindex='0'>",
  "mau": "<button tabindex='3'>",
  "severidade": "alta",
  "forca_evidencia": "guia_oficial",
  "axe_rule": "tabindex"
 },
 {
  "id": "AM17",
  "dominio": "acessibilidade",
  "regra": "Não reordene visualmente elementos focáveis com CSS order, de modo que a ordem de foco difira da visual.",
  "fonte": "MDN, tabindex (Accessibility)",
  "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/tabindex",
  "url_verificada": true,
  "tipo": "semi-objetiva",
  "como_checar": "css-tree: regra com order != 0 aplicada a filhos focáveis de flex/grid; sinalizar para revisão.",
  "checavel_por_codigo": true,
  "bom": "<nav><a>1</a><a>2</a></nav>",
  "mau": "<nav style='display:flex'><a style='order:2'>1</a><a style='order:1'>2</a></nav>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": null
 },
 {
  "id": "AM18",
  "dominio": "acessibilidade",
  "regra": "A ordem de leitura (DOM) deve preservar o significado mesmo com posicionamento CSS.",
  "fonte": "WCAG 2.2 Understanding 1.3.2 Meaningful Sequence (F1, C27)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/meaningful-sequence.html",
  "url_verificada": true,
  "tipo": "semi-objetiva",
  "como_checar": "nao_checavel_por_codigo",
  "checavel_por_codigo": false,
  "bom": "<h2>Passo 1</h2><p>..</p><h2>Passo 2</h2>",
  "mau": "DOM com Passo 2 antes do Passo 1 e CSS invertendo",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": null
 },
 {
  "id": "AM19",
  "dominio": "acessibilidade",
  "regra": "Use button nativo, não div/span com onclick; se usar role=button, adicione tabindex=0.",
  "fonte": "MDN, Learn: Accessible HTML (Buttons vs div)",
  "url": "https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Accessibility/HTML",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Elementos não nativos com onclick devem ter role e tabindex; preferir button.",
  "checavel_por_codigo": true,
  "bom": "<button type='button'>Salvar</button>",
  "mau": "<div onclick='salvar()'>Salvar</div>",
  "severidade": "alta",
  "forca_evidencia": "guia_oficial",
  "axe_rule": null
 },
 {
  "id": "AM20",
  "dominio": "acessibilidade",
  "regra": "Botões só com ícone precisam de nome acessível.",
  "fonte": "WCAG 2.2 Understanding 1.1.1 Non-text Content (G82, ARIA6)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/non-text-content.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "button sem texto: exigir aria-label, aria-labelledby ou texto oculto visualmente; svg filho aria-hidden.",
  "checavel_por_codigo": true,
  "bom": "<button aria-label='Fechar'><svg aria-hidden='true'/></button>",
  "mau": "<button><svg/></button>",
  "severidade": "alta",
  "forca_evidencia": "norma",
  "axe_rule": "button-name"
 },
 {
  "id": "AM21",
  "dominio": "acessibilidade",
  "regra": "Todo link precisa de nome acessível não vazio (inclusive links só com imagem).",
  "fonte": "WCAG 2.2 Understanding 2.4.4 Link Purpose (F89)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/link-purpose-in-context.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "a[href] com texto vazio e sem aria-label ou img[alt] não vazio.",
  "checavel_por_codigo": true,
  "bom": "<a href='/p'><img src='p.png' alt='Perfil'></a>",
  "mau": "<a href='/p'><img src='p.png' alt=''></a>",
  "severidade": "alta",
  "forca_evidencia": "norma",
  "axe_rule": "link-name"
 },
 {
  "id": "AM22",
  "dominio": "acessibilidade",
  "regra": "Evite texto de link genérico como 'clique aqui' ou 'saiba mais'; descreva o destino.",
  "fonte": "MDN, Learn: Accessible HTML (Links)",
  "url": "https://developer.mozilla.org/en-US/docs/Learn_web_development/Core/Accessibility/HTML",
  "url_verificada": true,
  "tipo": "semi-objetiva",
  "como_checar": "Lista de textos genéricos (clique aqui, saiba mais, aqui, leia mais) em a sem aria-label descritivo.",
  "checavel_por_codigo": true,
  "bom": "<a href='/baleias'>Saiba mais sobre baleias</a>",
  "mau": "<a href='/baleias'>clique aqui</a>",
  "severidade": "media",
  "forca_evidencia": "guia_oficial",
  "axe_rule": null
 },
 {
  "id": "AM23",
  "dominio": "acessibilidade",
  "regra": "Toda img informativa precisa de alt; sem alt ou com alt só de nome de arquivo é falha.",
  "fonte": "WCAG 2.2 Understanding 1.1.1 Non-text Content (H37, F30)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/non-text-content.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "img sem atributo alt; ou alt casando extensão de arquivo de imagem.",
  "checavel_por_codigo": true,
  "bom": "<img src='g.png' alt='Vendas por mês'>",
  "mau": "<img src='g.png'>",
  "severidade": "alta",
  "forca_evidencia": "norma",
  "axe_rule": "image-alt"
 },
 {
  "id": "AM24",
  "dominio": "acessibilidade",
  "regra": "SVG com role=img precisa de nome acessível.",
  "fonte": "WCAG 2.2 Understanding 1.1.1 Non-text Content (SVG test rule)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/non-text-content.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "svg[role=img] com aria-label, aria-labelledby ou filho title.",
  "checavel_por_codigo": true,
  "bom": "<svg role='img' aria-label='Alta de 5%'></svg>",
  "mau": "<svg role='img'></svg>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": "svg-img-alt"
 },
 {
  "id": "AM25",
  "dominio": "acessibilidade",
  "regra": "O nome acessível deve conter o texto visível do rótulo.",
  "fonte": "WCAG 2.2 Understanding 2.5.3 Label in Name",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/label-in-name.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "Controle com texto visível e aria-label: aria-label deve conter o texto visível (sem caixa/pontuação).",
  "checavel_por_codigo": true,
  "bom": "<button aria-label='Buscar produtos'>Buscar</button>",
  "mau": "<button aria-label='Procurar'>Buscar</button>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": "label-content-name-mismatch"
 },
 {
  "id": "AM26",
  "dominio": "acessibilidade",
  "regra": "Campos de dados do usuário devem usar autocomplete com valor válido.",
  "fonte": "WCAG 2.2 Understanding 1.3.5 Identify Input Purpose (H98)",
  "url": "https://www.w3.org/WAI/WCAG22/Understanding/identify-input-purpose.html",
  "url_verificada": true,
  "tipo": "objetiva",
  "como_checar": "input de nome, e-mail, telefone, endereço com autocomplete na lista de tokens HTML.",
  "checavel_por_codigo": true,
  "bom": "<input type='email' autocomplete='email'>",
  "mau": "<input type='email' autocomplete='mail'>",
  "severidade": "media",
  "forca_evidencia": "norma",
  "axe_rule": "autocomplete-valid"
 },
 {
  "id": "AM27",
  "dominio": "acessibilidade",
  "regra": "Não aplique aria-hidden=true em elemento focável nem em seus ancestrais.",
  "fonte": "MDN, aria-hidden",
  "url": "https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Reference/Attributes/aria-hidden",
  "url_verificada": true,
  "tipo": "objetiva",
