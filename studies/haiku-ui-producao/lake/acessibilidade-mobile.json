  "forca_evidencia": "guia_oficial",
  "axe_rule": "aria-hidden-focus"
 },
 {
  "id": "AM28",
  "dominio": "acessibilidade",
  "regra": "Em botão que abre/fecha painel, use aria-expanded true/false e aria-controls apontando ao painel.",
  "fonte": "MDN, aria-expanded",
  "url": "https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Reference/Attributes/aria-expanded",
  "url_verificada": true,
  "tipo": "objetiva",
