  "forca_evidencia": "guia_oficial",
  "axe_rule": null
 },
 {
  "id": "AM30",
  "dominio": "acessibilidade",
  "regra": "Abas: tablist contém tabs com aria-selected e cada tabpanel aponta a sua aba por aria-labelledby.",
  "fonte": "ARIA Authoring Practices, Tabs Pattern",
  "url": "https://www.w3.org/WAI/ARIA/apg/patterns/tabs/",
